-- ================================================================
-- CYBER WINGS
-- ================================================================


local function CreateCyberWings(
	root:BasePart
)


	for side = -1,1,2 do



		local wing =
			Instance.new("Part")



		wing.Name =
			"IchikaEnergyWing"



		wing.Anchored =
			false



		wing.CanCollide =
			false



		wing.Material =
			Enum.Material.Neon



		wing.Color =
			GOLD



		wing.Transparency =
			0.25



		wing.Size =
			Vector3.new(
				0.3,
				7,
				18
			)



		wing.CFrame =
			root.CFrame
			*
			CFrame.new(
				side * 4,
				2,
				3
			)
			*
			CFrame.Angles(
				0,
				side * math.rad(25),
				side * math.rad(15)
			)



		local weld =
			Instance.new("WeldConstraint")



		weld.Part0 =
			wing



		weld.Part1 =
			root



		weld.Parent =
			wing



		wing.Parent =
			GetVFXFolder()



		table.insert(
			SESSION.AuraObjects,
			wing
		)



		TweenService:Create(
			wing,
			TweenInfo.new(
				0.5,
				Enum.EasingStyle.Back
			),
			{

				Transparency =
					0.05

			}
		):Play()



	end


end



-- ================================================================
-- ULTIMATE IMPACT
-- ================================================================


local function UltimateExplosion(
	root:BasePart,
	size:number
)


	CyberBurst(
		root.CFrame,
		size,
		"ultimate_explosion"
	)



	CyberRing(
		root.CFrame,
		size * 2
	)



	CyberParticles(
		root,
		250
	)



	local light =
		Instance.new("PointLight")



	light.Color =
		YELLOW



	light.Brightness =
		20



	light.Range =
		80



	light.Parent =
		root



	TweenService:Create(
		light,
		TweenInfo.new(
			1
		),
		{

			Brightness =
				0,


			Range =
				0

		}
	):Play()



	Debris:AddItem(
		light,
		1.2
	)


end



-- ================================================================
-- ULTIMATE 1
-- ZERO SYSTEM
-- ================================================================


local function ZeroSystem()


	local character =
		Player.Character



	if not character then
		return
	end



	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)



	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)



	if not humanoid
	or not root then
		return
	end



	SESSION.UltActive =
		true



	PlayAnimation(
		humanoid,
		ULT_ZERO_ANIMATION,
		Enum.AnimationPriority.Action4
	)



	CreateUltimateAura(
		root
	)



	CreateCyberWings(
		root
	)



	UltimateExplosion(
		root,
		50
	)



	-- assassin teleport sequence


	for i = 1,10 do


		task.delay(
			i * 0.12,
			function()


				local target =
					TeleportBehindTarget()



				if target then


					CyberBurst(
						root.CFrame,
						15,
						"zero_hit_"..i
					)



					CreateAfterImage()


				end


			end
		)


	end


end



