-- ================================================================
-- CLEAR EFFECTS
-- ================================================================


local function clearEffects()


	for _, object in ipairs(
		SESSION.AuraObjects
	) do


		if object
			and object.Parent
		then


			pcall(function()

				object:Destroy()

			end)

		end


	end



	table.clear(
		SESSION.AuraObjects
	)



	local character =
		Player.Character



	if character then


		for _, object in ipairs(
			character:GetDescendants()
		) do


			if object.Name ==
				"ItsukiLeaderGlow"
				or object.Name ==
				"ItsukiStarTrail"
				or object.Name ==
				"ItsukiLeaderAura"
			then


				pcall(function()

					object:Destroy()

				end)


			end


		end


	end

end



