-- ================================================================
-- COOLDOWN
-- ================================================================


local function Allowed(
	key:string,
	time:number
)


	local now =
		os.clock()


	local last =
		SESSION.LastEffect[key]
		or
		0



	if now-last < time then

		return false

	end



	SESSION.LastEffect[key] =
		now


	return true

end



-- ================================================================
-- TARGET SYSTEM
-- ================================================================


local function GetClosestPlayer()


	local Character =
		Player.Character


	if not Character then
		return nil
	end



	local Root =
		Character:FindFirstChild(
			"HumanoidRootPart"
		)



	if not Root then
		return nil
	end



	local closest
	local distance =
		math.huge



	for _,plr in ipairs(
		Players:GetPlayers()
	) do



		if plr ~= Player
		and plr.Character then


			local enemyRoot =
				plr.Character:FindFirstChild(
					"HumanoidRootPart"
				)


			local humanoid =
				plr.Character:FindFirstChildOfClass(
					"Humanoid"
				)



			if enemyRoot
			and humanoid
			and humanoid.Health > 0 then



				local dist =
					(
					Root.Position
					-
					enemyRoot.Position
					).Magnitude



				if dist < distance then


					distance =
						dist


					closest =
						plr.Character


				end

			end


		end


	end



	return closest

end
-- ================================================================
-- ANIMATION SYSTEM
-- ================================================================


local function GetAnimator(humanoid: Humanoid)

	local animator =
		humanoid:FindFirstChildOfClass(
			"Animator"
		)

	if not animator then

		animator =
			Instance.new("Animator")

		animator.Parent =
			humanoid

	end


	return animator

end



local function PlayAnimation(
	humanoid: Humanoid,
	id:string,
	priority:Enum.AnimationPriority?,
	speed:number?
)


	if not humanoid then
		return
	end


	local animation =
		Instance.new("Animation")


	animation.AnimationId =
		id



	local animator =
		GetAnimator(
			humanoid
		)



	local success,track =
		pcall(function()

			return animator:LoadAnimation(
				animation
			)

		end)



	animation:Destroy()



	if success and track then


		track.Priority =
			priority
			or
			Enum.AnimationPriority.Action



		track.Looped =
			false



		track:Play(
			0.05,
			1,
			speed or 1
		)



		return track

	end


end



