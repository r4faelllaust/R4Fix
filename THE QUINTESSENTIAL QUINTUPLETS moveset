-- ================================================================
-- CLEANUP
-- ================================================================


local function disconnect(list)

	for _, connection in ipairs(list) do

		pcall(function()

			connection:Disconnect()

		end)

	end


	table.clear(list)

end



local function track(connection)

	if connection then

		table.insert(
			SESSION.CharacterConnections,
			connection
		)

	end


	return connection

end



-- ================================================================
-- ANIMATION SYSTEM
-- ================================================================


local function getAnimator(
	humanoid: Humanoid
)


	local animator =
		humanoid:FindFirstChildOfClass(
			"Animator"
		)


	if not animator then

		animator =
			Instance.new(
				"Animator"
			)

		animator.Parent =
			humanoid

	end


	return animator

end



local function playAnimation(
	humanoid,
	id,
	priority
)


	if not humanoid then
		return
	end


	local animation =
		Instance.new(
			"Animation"
		)


	animation.AnimationId =
		id



	local animator =
		getAnimator(
			humanoid
		)



	local success, result =
		pcall(function()

			return animator:LoadAnimation(
				animation
			)

		end)



	animation:Destroy()



	if not success then
		return
	end



	result.Priority =
		priority
		or Enum.AnimationPriority.Action



	result.Looped =
		false



	result:Play(
		0.05
	)



	return result

end



