local function updateTopbar()
	local topbar = PlayerGui:FindFirstChild("TopbarPlus")
	if not topbar then return end

	local sister = getCurrentSister()

	for _, desc in ipairs(topbar:GetDescendants()) do
		if desc.Name == "IconButton" then
			local label = desc:FindFirstChild("IconLabel")
			local image = desc:FindFirstChild("IconImage")

			if label and label:IsA("TextLabel") then
				local text = label.Text
				if text == "Hero Hunter" or text == "Garou" or text == "Dark Garou" 
					or text == "Ichika" or text == "Nino" or text == "Miku" 
					or text == "Yotsuba" or text == "Itsuki" or text == sister.Name then

					label.Text = sister.Name
					if image then
						image.Image = sister.Decal
					end
				end
			end
		end
	end
end

local function cycleSister()
	SESSION.CurrentSister = SESSION.CurrentSister % 5 + 1
	local sister = getCurrentSister()

	-- Notify
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = sister.Name .. " selected!",
			Text = sister.FullName .. " • " .. sister.Theme,
			Icon = sister.Decal,
			Duration = 2.5
		})
	end)

	-- Force UI refresh
	updateTopbar()
	-- We will call full character restyle later
end

-- Detect clicks on Topbar icon (simple but effective)
