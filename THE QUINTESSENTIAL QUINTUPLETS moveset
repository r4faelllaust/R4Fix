-- ================================================================

local function burst(root: BasePart, size: number, duration: number, colorOverride: Color3?)
	if not root.Parent then return end
	local theme = currentTheme()

	local part = Instance.new("Part")
	part.Name = "SisBurst"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = colorOverride or theme.Color1
	part.Transparency = 0.15
	part.Size = Vector3.one
	part.CFrame = root.CFrame
	part.Parent = getFXFolder()

	TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = Vector3.new(size, size, size),
		Transparency = 1,
	}):Play()

	Debris:AddItem(part, duration + 0.05)
end

local function ring(root: BasePart, startSize: number, endSize: number, duration: number)
	if not root.Parent then return end
	local theme = currentTheme()

	local part = Instance.new("Part")
	part.Name = "SisRing"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Shape = Enum.PartType.Cylinder
	part.Material = Enum.Material.Neon
	part.Color = theme.Color2
	part.Transparency = 0.25
	part.Size = Vector3.new(0.08, startSize, startSize)
	part.CFrame = root.CFrame * CFrame.Angles(0, 0, math.rad(90))
	part.Parent = getFXFolder()

	TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.08, endSize, endSize),
		Transparency = 1,
	}):Play()

	Debris:AddItem(part, duration + 0.05)
end

local function particlePop(root: BasePart, amount: number)
	if not root.Parent then return end
	local theme = currentTheme()

	local attachment = Instance.new("Attachment")
	attachment.Parent = root

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(theme.Color1, theme.Color2)
	emitter.LightEmission = 1
	emitter.Lifetime = NumberRange.new(0.2, 0.45)
	emitter.Speed = NumberRange.new(4, 12)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Rate = 0
	emitter.Parent = attachment

	emitter:Emit(amount)
	Debris:AddItem(attachment, 0.6)
end

local function playSound(parent: Instance?, id: string, volume: number?, speed: number?)
	if not parent or not parent.Parent then return end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 1
	sound.PlaybackSpeed = speed or 1
	sound.Parent = parent
	pcall(function() sound:Play() end)
	Debris:AddItem(sound, 4)
end

-- ================================================================
-- TARGETING (for dash moves only — never used to teleport onto a player)
-- ================================================================

local function findClosestTarget(origin: Vector3, maxRange: number)
	local ownCharacter = LocalPlayer.Character
	if not ownCharacter then return nil end

	local best, bestDist = nil, maxRange

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character and plr.Character ~= ownCharacter then
			local root = plr.Character:FindFirstChild("HumanoidRootPart")
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				local dist = (root.Position - origin).Magnitude
				if dist < bestDist then
					bestDist = dist
					best = root
				end
			end
		end
	end

	return best
end

-- ================================================================
-- DASH (gap-closer, NOT a teleport)
-- Moves the player toward a target using velocity, stops short,
-- and whiffs if the target gets out of range mid-dash.
-- ================================================================

local function engineDash(targetRoot: BasePart, speed: number, duration: number, stopDistance: number)
	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then return false end
	if humanoid.Health <= 0 then return false end

	local attachment = Instance.new("Attachment")
	attachment.Parent = root

	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.Parent = root

	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position = Vector3.new(-1, 0, 0)
	a1.Position = Vector3.new(1, 0, 0)
	a0.Parent = root
	a1.Parent = root

	local theme = currentTheme()
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.15
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(theme.Color1, theme.Color2)
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.Parent = root

	local started = os.clock()
	local reached = false

	while os.clock() - started < duration do
		if humanoid.Health <= 0 or not root.Parent or not targetRoot.Parent then break end

		local toTarget = targetRoot.Position - root.Position
		local dist = toTarget.Magnitude

		if dist <= stopDistance then
			reached = true
			break
		end

		local dir = toTarget.Unit
		velocity.VectorVelocity = Vector3.new(dir.X * speed, 0, dir.Z * speed)
		root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(dir.X, 0, dir.Z))

		RunService.Heartbeat:Wait()
	end

	pcall(function() velocity:Destroy() end)
	pcall(function() attachment:Destroy() end)
	pcall(function() a0:Destroy() end)
	pcall(function() a1:Destroy() end)
	pcall(function() trail:Destroy() end)

	if root.Parent then
		root.AssemblyLinearVelocity = Vector3.zero
	end

	return reached
end

-- ================================================================
-- M1
-- ================================================================

local lastM1 = 0
local m1Index = 0

local function creatorM1()
	local now = os.clock()
	if now - lastM1 < CFG.M1Cooldown then return end
	lastM1 = now

	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then return end
	if humanoid.Health <= 0 then return end

	local theme = currentTheme()
	local target = findClosestTarget(root.Position, CFG.M1DashRange)

	m1Index = (m1Index % 4) + 1
	local animId = theme.Anim.M1[m1Index]

	if target then
		engineDash(target, CFG.M1DashSpeed, 0.22, 3.2)
	end

	playAnimation(humanoid, tostring(animId), 1.1, 0.35)
	burst(root, 3, 0.12)
	particlePop(root, 6)
end

-- ================================================================
-- MOVES 1–4 (data-driven, themed per sister)
-- ================================================================

local function runMove(index: number)
	if S.Busy["Move" .. index] then return end
	S.Busy["Move" .. index] = true

	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then
		S.Busy["Move" .. index] = nil
		return
	end

	local theme = currentTheme()
	local moveName = theme.MoveNames[index]
	local animId = theme.Anim.Move[index]

	local target = findClosestTarget(root.Position, CFG.DashRange)

	if target and index <= 3 then
		engineDash(target, CFG.DashSpeed, CFG.DashDuration, CFG.DashStop)
	end

	playAnimation(humanoid, tostring(animId), 1, 0.6)

	burst(root, 4 + index * 1.5, 0.15)
	ring(root, 2, 10 + index * 4, 0.22)
	particlePop(root, 6 + index * 2)

	print("[5SIS] " .. S.Active .. " used " .. moveName)

	task.delay(CFG.MoveCooldown[index], function()
		S.Busy["Move" .. index] = nil
	end)
end

-- ================================================================
-- ULTIMATE (multi-pulse cinematic, per framework doc)
-- ================================================================

local lastUlt = 0

local function runUltimate()
	local now = os.clock()
	if now - lastUlt < CFG.UltCooldown then return end
	if S.UltActive then return end
	lastUlt = now

	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then return end

	local theme = currentTheme()
	S.UltActive = true

	playAnimation(humanoid, tostring(theme.Anim.Ult), 1, 1.2)

	-- multi pulse
	local pulses = {
		{delay = 0.00, burstSize = 8,  ringSize = 14},
		{delay = 0.07, burstSize = 12, ringSize = 23},
		{delay = 0.14, burstSize = 16, ringSize = 32},
		{delay = 0.21, burstSize = 20, ringSize = 41},
	}

	for _, p in ipairs(pulses) do
		task.delay(p.delay, function()
			if root.Parent then
				burst(root, p.burstSize, 0.3)
				ring(root, 2, p.ringSize, 0.4)
				particlePop(root, 14)
			end
		end)
	end

	-- flash light
	local light = Instance.new("PointLight")
	light.Brightness = 12
	light.Range = 28
	light.Color = theme.Color1
	light.Parent = root
	TweenService:Create(light, TweenInfo.new(CFG.UltDuration), {Brightness = 0, Range = 0}):Play()
	Debris:AddItem(light, CFG.UltDuration + 0.2)

	-- persistent aura for duration
	local auraAttachment = Instance.new("Attachment")
	auraAttachment.Name = "SisUltAura"
	auraAttachment.Parent = root
	local aura = Instance.new("ParticleEmitter")
	aura.Color = ColorSequence.new(theme.Color1, theme.Color2)
	aura.LightEmission = 1
	aura.Rate = 18
	aura.Lifetime = NumberRange.new(0.3, 0.6)
	aura.Speed = NumberRange.new(1, 3)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 0),
	})
	aura.Parent = auraAttachment

	print("[5SIS] " .. S.Active .. " ULTIMATE: " .. theme.UltName)

	task.delay(CFG.UltDuration, function()
		pcall(function() aura:Destroy() end)
		pcall(function() auraAttachment:Destroy() end)
		S.UltActive = false
		print("[5SIS] Ultimate ended.")
	end)
end

