-- ================================================================
-- ANIMATION REPLACER
-- ================================================================


local function PlayAnimation(id,speed)


	local anim =
		Instance.new(
			"Animation"
		)


	anim.AnimationId =
		"rbxassetid://"..id



	local track =
		Humanoid:LoadAnimation(
			anim
		)


	track.Priority =
		Enum.AnimationPriority.Action4


	track:Play()



	track:AdjustSpeed(
		speed or 1
	)


	return track

end




