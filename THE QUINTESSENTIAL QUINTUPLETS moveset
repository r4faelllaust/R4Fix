local function AtomicSlashEffect(color)

	local Character = Player.Character

	if not Character then
		return
	end


	local HRP = Character:FindFirstChild(
		"HumanoidRootPart"
	)

	if not HRP then
		return
	end


	local Slash = Instance.new("Part")

	Slash.Name = "AtomicLoveSlash"

	Slash.Anchored = true

	Slash.CanCollide = false

	Slash.Material = Enum.Material.Neon

	Slash.Shape = Enum.PartType.Block

	Slash.Color = color


	Slash.Size = Vector3.new(
		1,
		8,
		1
	)


	Slash.CFrame =
		HRP.CFrame *
		CFrame.new(
			0,
			0,
			-3
		)
