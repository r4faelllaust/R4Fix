-- ==========================================================
-- ANIMATION SYSTEM
-- ==========================================================


local ActiveTracks = {}



local function PlayAnimation(
	id,
	speed
)


	if not Humanoid then
		return
	end



	for _,track in ipairs(
		Humanoid:GetPlayingAnimationTracks()
	) do

		if track.Priority ==
			Enum.AnimationPriority.Action4
		then

			track:Stop(
				0.1
			)

		end

	end



	local Animation =
		Instance.new("Animation")


	Animation.AnimationId =
		"rbxassetid://"..id



	local Track =
		Humanoid:LoadAnimation(
			Animation
		)



	Track.Priority =
		Enum.AnimationPriority.Action



	Track:Play(
		0.1
	)



	Track:AdjustSpeed(
		speed or 1
	)



	table.insert(
		ActiveTracks,
		Track
	)



	Debris:AddItem(
		Animation,
		2
	)


	return Track

end



