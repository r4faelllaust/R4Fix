local UIS =
	game:GetService(
		"UserInputService"
	)



track(
	UIS.InputBegan:Connect(
		function(input, processed)

			if processed then
				return
			end


			if input.KeyCode ==
				Enum.KeyCode.One
			then

				executeMove(1)


			elseif input.KeyCode ==
				Enum.KeyCode.Two
			then

				executeMove(2)


			elseif input.KeyCode ==
				Enum.KeyCode.Three
			then

				executeMove(3)


			elseif input.KeyCode ==
				Enum.KeyCode.Four
			then

				executeMove(4)


			elseif input.KeyCode ==
				Enum.KeyCode.G
			then

				executeUltimate()

			end

		end
	)
)



