local function refreshHotbar()
	local sister = getCurrentSister()
	local set = MOVE_SETS[SESSION.CurrentSister]
	if not set then return end

	local hb = PlayerGui:FindFirstChild("Hotbar")
	if not hb then return end
	local backpack = hb:FindFirstChild("Backpack")
	if not backpack then return end
	local frame = backpack:FindFirstChild("Hotbar")
	if not frame then return end

	local moves = SESSION.IsUlted and set.Ult or set.Base

	for i = 1, 4 do
		local slot = frame:FindFirstChild(tostring(i))
		local base = slot and slot:FindFirstChild("Base")
		if base then
			local toolName = base:FindFirstChild("ToolName")
			if toolName then
				if SESSION.IsUlted then
					toolName.Text = moves[i] or "Ultimate"
				else
					toolName.Text = moves[i].name
					local reuse = base:FindFirstChild("Reuse")
					if reuse and moves[i].variant then
						reuse.Visible = true
						reuse.Text = moves[i].variant
					end
				end
			end
		end
	end
end

local function styleUltimateBar()
	local sister = getCurrentSister()
	local bar = PlayerGui:FindFirstChild("Bar")
	if not bar then return end
	local magic = bar:FindFirstChild("MagicHealth")
	if not magic then return end

	local text = magic:FindFirstChild("TextLabel")
	if text and text:IsA("TextLabel") then
		text.Text = sister.UltimateName
		text.TextColor3 = sister.ColorMain
	end
end

