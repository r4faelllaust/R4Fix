function ChangeSister(name)

	local Data =
		Characters[name]


	if not Data then
		return
	end


	CurrentCharacter =
		Data


	LoveEngine.Character =
		Data



	local Character =
		Player.Character


	if Character then

		CreateAura(
			Character,
			Data
		)

	end


	print(
		"Selected "..name
	)

end



