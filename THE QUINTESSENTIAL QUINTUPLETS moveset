-- ==========================================================
-- TARGET SYSTEM
-- ==========================================================

local function GetClosestPlayer()


	local Target
	local Distance = math.huge


	for _,plr in ipairs(
		Players:GetPlayers()
	) do


		if plr ~= Player
		and plr.Character
		then


			local EnemyRoot =
				plr.Character:FindFirstChild(
					"HumanoidRootPart"
				)


			local EnemyHum =
				plr.Character:FindFirstChildOfClass(
					"Humanoid"
				)



			if EnemyRoot
			and EnemyHum
			and EnemyHum.Health > 0
			then


				local Dist =
					(Root.Position -
					EnemyRoot.Position).Magnitude



				if Dist < Distance then

					Distance = Dist
					Target = plr.Character

				end

			end

		end

	end


	return Target

end



-- ==========================================================
-- AFTERIMAGE
-- ==========================================================

local function CreatePhantomClone()


	local Clone =
		Character:Clone()



	for _,obj in ipairs(
		Clone:GetDescendants()
	) do


		if obj:IsA("BasePart") then


			obj.Material =
				Enum.Material.Neon


			obj.Color =
				Color3.fromRGB(
					255,
					220,
					40
				)


			obj.Transparency =
				0.45


			obj.CanCollide =
				false


		elseif obj:IsA("Humanoid") then


			obj:Destroy()


		end


	end



	Clone.Parent =
		workspace:FindFirstChild(
			"Ichika_Cyber_VFX"
		)


	Debris:AddItem(
		Clone,
		0.4
	)


end



-- ==========================================================
-- ANIMATION SYSTEM
-- ==========================================================


local ActiveTracks = {}



local function PlayAnimation(
	id,
	speed
)


	if not Humanoid then
		return
	end



	for _,track in ipairs(
		Humanoid:GetPlayingAnimationTracks()
	) do

		if track.Priority ==
			Enum.AnimationPriority.Action4
		then

			track:Stop(
				0.1
			)

		end

	end



	local Animation =
		Instance.new("Animation")


	Animation.AnimationId =
		"rbxassetid://"..id



	local Track =
		Humanoid:LoadAnimation(
			Animation
		)



	Track.Priority =
		Enum.AnimationPriority.Action



	Track:Play(
		0.1
	)



	Track:AdjustSpeed(
		speed or 1
	)



	table.insert(
		ActiveTracks,
		Track
	)



	Debris:AddItem(
		Animation,
		2
	)



	return Track

end



