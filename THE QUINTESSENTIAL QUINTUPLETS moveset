local function setupCharacter(character)
	cleanupCharacterConnections()
	clearVisuals()

	local humanoid = character:WaitForChild("Humanoid", 8)
	local hrp = character:WaitForChild("HumanoidRootPart", 8)
	if not humanoid or not hrp then return end

	-- Force Hunter
	pcall(function()
		if LocalPlayer:GetAttribute("Character") \~= "Hunter" then
			character:WaitForChild("Communicate"):FireServer({
				Goal = "Change Character",
				Character = "Hunter"
			})
		end
	end)

	task.wait(0.4)

	applySisterVisuals(character)
	setupMoves(character, humanoid, hrp)

	-- UI Loops
	track(task.spawn(function()
		while humanoid.Health > 0 do
			updateTopbar()
			refreshHotbar()
			styleUltimateBar()
			task.wait(0.2)
		end
	end))

	-- Death save
	humanoid.Died:Once(function()
		SESSION.LastDeathCFrame = hrp.CFrame
		SESSION.IsUlted = false
	end)

	-- Spawn effect
	local sister = getCurrentSister()
	spawnBurst(hrp.CFrame, 12, sister.ColorMain, 0.4)
	spawnShockwave(hrp.CFrame, 3, 20, sister.ColorSecond)
end

