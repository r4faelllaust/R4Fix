local function getFXFolder()
	local folder = Workspace:FindFirstChild("Quintuplets_FX")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Quintuplets_FX"
		folder.Parent = Workspace
	end
	return folder
end

local function canVFX(key)
	local now = os.clock()
	if (S.LastVFX[key] or 0) + CFG.VFXCooldown > now then return false end
	S.LastVFX[key] = now
	return true
end

local function colorVFX(obj, color, light, dark)
	pcall(function()
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("ParticleEmitter") then
				d.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, light),
					ColorSequenceKeypoint.new(0.5, color),
					ColorSequenceKeypoint.new(1, dark),
				})
				d.LightEmission = 1
			elseif d:IsA("Beam") or d:IsA("Trail") then
				d.Color = ColorSequence.new(color, light)
			elseif d:IsA("PointLight") or d:IsA("SpotLight") then
				d.Color = color
			end
		end
	end)
end

local function cloneVFX(name, parent, amount)
	if not parent then return nil end
	local template = nil
	pcall(function() template = ReplicatedStorage:FindFirstChild(name, true) end)
	if not template then return nil end
	
	local clone = nil
	pcall(function() clone = template:Clone() end)
	if not clone then return nil end
	
	local sister = SISTERS[S.CurrentSister]
	colorVFX(clone, sister.Color, sister.LightColor, sister.DarkColor)
	clone.Parent = parent
	
	for _, c in ipairs(clone:GetDescendants()) do
		if c:IsA("ParticleEmitter") then
			pcall(function() c:Emit(amount or 8) end)
		end
	end
	
	Debris:AddItem(clone, CFG.MaxVFXLife)
	return clone
end

