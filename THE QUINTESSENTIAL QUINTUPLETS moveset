local function setupCharacter(character:Model)
S.Token+=1
local token=S.Token

cleanup()

local hum=character:WaitForChild("Humanoid",10)
local r=character:WaitForChild("HumanoidRootPart",10)

if not hum or not r or not r:IsA("BasePart") then return end

S.Ulted=false
aura(character)

track(
	hum.AnimationPlayed:Connect(function(t)
		if token~=S.Token then return end
		if not t.Animation then return end

		local id=t.Animation.AnimationId

		if id==SLOT1
			or id==SLOT2
			or id==SLOT3
			or id==SLOT4
		then
			moves(id)
		elseif id==ULT1
			or id==ULT2
			or id==ULT3
		then
			ult(id)
		end
	end)
)

notify("CYBORG MODE ONLINE ⚡")

end

if not S.Initialized then
S.Initialized=true

track(
	Player.CharacterAdded:Connect(function(c)
		task.wait(.3)
		setupCharacter(c)
	end)
)

track(
	RunService.Heartbeat:Connect(function()
		pcall(tab)
		pcall(hotbar)
		pcall(styleBar)
	end)
)

task.spawn(function()
	music()
end)

end

if Player.Character then
setupCharacter(Player.Character)
end

