-- ================================================================
-- BASIC HELPERS
-- ================================================================

local function getCharacter()
	local character = LocalPlayer.Character
	if not character then return nil, nil, nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then return nil, nil, nil end
	return character, humanoid, root
end

local function getAnimator(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	return animator
end

local function playAnimation(humanoid: Humanoid, id: string, speed: number?, duration: number?)
	if id == "0" or id == "rbxassetid://0" then return nil end
	if humanoid.Health <= 0 then return nil end

	local animator = getAnimator(humanoid)
	local animation = Instance.new("Animation")
	animation.AnimationId = id

	local success, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	animation:Destroy()
	if not success or not track then return nil end

	track.Priority = Enum.AnimationPriority.Action4
	table.insert(S.Tracks, track)

	pcall(function() track:Play(0.04, 1, speed or 1) end)

	if duration then
		task.delay(duration, function()
			pcall(function()
				if track.IsPlaying then track:Stop(0.06) end
			end)
		end)
	end

	return track
end

local function disconnectList(list)
	for i = #list, 1, -1 do
		pcall(function() list[i]:Disconnect() end)
		list[i] = nil
	end
end

local function cleanupTracks()
	for i = #S.Tracks, 1, -1 do
		pcall(function()
			if S.Tracks[i].IsPlaying then S.Tracks[i]:Stop(0.05) end
			S.Tracks[i]:Destroy()
		end)
		S.Tracks[i] = nil
	end
end

local function allowedFX(key: string, cooldown: number?)
	local now = os.clock()
	local prev = S.LastFX[key] or 0
	if now - prev < (cooldown or CFG.VFXCooldown) then return false end
	S.LastFX[key] = now
	return true
end

local function getFXFolder()
