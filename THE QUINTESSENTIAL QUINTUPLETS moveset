function ActivateUltimate(name)

	local Data =
		UltimateForms[name]


	if not Data then
		return
	end


	local Character =
		Player.Character


	if not Character then
		return
	end



	local OldAura =
		Character:FindFirstChild(
			"UltimateAura"
		)


	if OldAura then
		OldAura:Destroy()
	end



	local Aura =
		Instance.new("Highlight")


	Aura.Name =
		"UltimateAura"


	Aura.FillColor =
		Data.Color


	Aura.OutlineColor =
		Color3.new(
			1,
			1,
			1
		)


	Aura.FillTransparency =
		0.3


	Aura.Parent =
		Character



	Burst(
		Character.HumanoidRootPart.Position,
		Data.Color,
		25
	)



	task.delay(
		10,
		function()

			if Aura then
				Aura:Destroy()
			end

		end
	)



	print(
		Data.Name.." Activated"
	)

end



