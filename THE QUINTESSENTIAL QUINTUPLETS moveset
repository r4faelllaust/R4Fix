-- CHARACTER VISUALS (Aura + Trails)
----------------------------------------------------------------
local function clearVisuals()
	for _, obj in ipairs(SESSION.AuraObjects) do
		pcall(function() obj:Destroy() end)
	end
	SESSION.AuraObjects = {}
end

local function applySisterVisuals(character)
	clearVisuals()
	local sister = getCurrentSister()
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	-- Aura
	local att = Instance.new("Attachment")
	att.Parent = hrp
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, sister.ColorMain),
		ColorSequenceKeypoint.new(0.5, sister.ColorSecond),
		ColorSequenceKeypoint.new(1, sister.ColorDark)
	})
	emitter.LightEmission = 0.75
	emitter.Rate = 45
	emitter.Lifetime = NumberRange.new(0.3, 0.6)
	emitter.Speed = NumberRange.new(0.8, 2.5)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.8),
		NumberSequenceKeypoint.new(0.4, 1.8),
		NumberSequenceKeypoint.new(1, 0)
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 1)
	})
	emitter.Parent = att
	table.insert(SESSION.AuraObjects, att)

	-- Limb trails
	for _, limbName in ipairs({"Left Arm", "Right Arm", "Left Leg", "Right Leg"}) do
		local limb = character:FindFirstChild(limbName)
		if limb then
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(0, -0.1, 0)
			a0.Parent = limb
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(0, -1.1, 0)
			a1.Parent = limb

			local trail = Instance.new("Trail")
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Lifetime = 0.35
			trail.LightEmission = 0.8
			trail.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, sister.ColorMain),
				ColorSequenceKeypoint.new(0.6, sister.ColorSecond),
				ColorSequenceKeypoint.new(1, sister.ColorDark)
			})
			trail.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.15),
				NumberSequenceKeypoint.new(1, 1)
			})
			trail.WidthScale = NumberSequence.new(1.1, 0)
			trail.Parent = limb

			table.insert(SESSION.AuraObjects, trail)
			table.insert(SESSION.AuraObjects, a0)
			table.insert(SESSION.AuraObjects, a1)
		end
	end
end

----------------------------------------------------------------
-- MOVE HANDLER (Animation Triggers)
----------------------------------------------------------------
local SLOT1 = "rbxassetid://12273188754"
local SLOT2 = "rbxassetid://12296113986"
local SLOT3 = "rbxassetid://12309835105"
local SLOT4 = "rbxassetid://12351854556"

local function setupMoves(character, humanoid, hrp)
	track(humanoid.AnimationPlayed:Connect(function(track)
		local id = track.Animation.AnimationId
		local sister = getCurrentSister()

		-- MOVE 1
		if id == SLOT1 then
			track:Stop()
			local target = getClosestEnemy()
			if target then
				-- Snap behind target
				local pos = target.Position - target.CFrame.LookVector * 3.5
				hrp.CFrame = CFrame.lookAt(pos, target.Position)
			end
			activateEngine(0.55, 210)
			spawnBurst(hrp.CFrame, 11, sister.ColorMain, 0.3)
			spawnShockwave(hrp.CFrame, 2, 22, sister.ColorSecond)
		end

		-- MOVE 2 (Engine Move)
		if id == SLOT2 then
			track:Stop()
			activateEngine(0.85, 265)
			spawnBurst(hrp.CFrame, 13, sister.ColorSecond, 0.35)
			spawnShockwave(hrp.CFrame, 3, 28, sister.ColorMain)
		end

		-- MOVE 3
		if id == SLOT3 then
			track:Stop()
			activateEngine(1.1, 240)
			spawnBurst(hrp.CFrame, 15, sister.ColorMain, 0.4)
			spawnShockwave(hrp.CFrame, 4, 32, sister.ColorSecond)
		end

		-- MOVE 4
		if id == SLOT4 then
			track:Stop()
			spawnBurst(hrp.CFrame, 16, sister.ColorDark, 0.45)
			spawnShockwave(hrp.CFrame, 5, 36, sister.ColorMain)
			spawnBurst(hrp.CFrame * CFrame.new(0, 0, -6), 10, sister.ColorSecond, 0.3)
		end
	end))
end

