local function disconnect(list)


	for _,connection in ipairs(list) do

		pcall(function()

			connection:Disconnect()

		end)

	end


	table.clear(list)

end



local function track(connection)


	if connection then

		table.insert(
			SESSION.CharacterConnections,
			connection
		)

	end


	return connection

end



-- ================================================================
-- ANIMATION ENGINE
-- ================================================================


local function getAnimator(humanoid)


	local animator =
		humanoid:FindFirstChildOfClass(
			"Animator"
		)


	if not animator then


		animator =
			Instance.new(
				"Animator"
			)


		animator.Parent =
			humanoid


	end


	return animator

end




local function playAnimation(
	humanoid,
	id,
	priority
)


	if not humanoid then
		return
	end



	local animation =
		Instance.new(
			"Animation"
		)


	animation.AnimationId =
		id



	local success,trackResult =
		pcall(function()


			return getAnimator(
				humanoid
			):LoadAnimation(
				animation
			)


		end)



	animation:Destroy()



	if success and trackResult then


		trackResult.Priority =
			priority
			or Enum.AnimationPriority.Action


		trackResult.Looped =
			false


		trackResult:Play(
			0.05,
			1,
			1
		)



		return trackResult

	end


end



