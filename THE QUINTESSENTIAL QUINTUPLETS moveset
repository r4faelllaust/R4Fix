			Size = Vector3.new(
				18,
				1,
				1
			),

			Transparency = 1,

			CFrame =
				Slash.CFrame *
				CFrame.new(
					0,
					0,
					-10
				)

		}

	)


	Tween:Play()


	Debris:AddItem(
		Slash,
		0.5
	)

end



