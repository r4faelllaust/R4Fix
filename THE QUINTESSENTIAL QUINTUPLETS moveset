		"RightHand",
		"LeftLowerArm",
		"RightLowerArm",

	}) do


		local limb =
			character:FindFirstChild(
				name
			)



		if limb and limb:IsA(
			"BasePart"
		) then


			local highlight =
				Instance.new(
