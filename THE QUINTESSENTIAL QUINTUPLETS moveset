-- ==========================================================
-- CLOSEST TARGET
-- ==========================================================

local function Closest()

	local Target
	local Distance = math.huge


	for _,v in pairs(Players:GetPlayers()) do

		if v ~= Player
		and v.Character
		then

			local HRP =
				v.Character:FindFirstChild(
					"HumanoidRootPart"
				)

			local Hum =
				v.Character:FindFirstChildOfClass(
					"Humanoid"
				)


			if HRP and Hum and Hum.Health > 0 then

				local Mag =
					(Root.Position-HRP.Position).Magnitude


				if Mag < Distance then

					Distance = Mag
					Target = v.Character

				end

			end

		end

	end


	return Target

end



-- ==========================================================
-- CYBER SHOCKWAVE
-- ==========================================================

local function Shockwave(Position,Size)


	local Ring =
		Instance.new("Part")


	Ring.Shape =
		Enum.PartType.Ball


	Ring.Material =
		Enum.Material.Neon


	Ring.Color =
		GOLD


	Ring.Transparency =
		0.3


	Ring.Anchored =
		true


	Ring.CanCollide =
		false


	Ring.Size =
		Vector3.new(
			2,
			2,
			2
		)


	Ring.Position =
		Position


	Ring.Parent =
		workspace



	TweenService:Create(
		Ring,
		TweenInfo.new(
			0.5
		),
		{
			Size =
				Vector3.new(
					Size,
					Size,
					Size
				),

			Transparency = 1
		}

	):Play()



	Debris:AddItem(
		Ring,
		1
	)

end



