function MikuHunter.FindTarget()


	local Target = nil

	local Distance = math.huge



	for _,PlayerObject in pairs(Players:GetPlayers()) do


		if PlayerObject ~= Player
		and PlayerObject.Character
		and PlayerObject.Character:FindFirstChild("HumanoidRootPart")
		then


			local EnemyRoot =
			PlayerObject.Character.HumanoidRootPart



			local Dist =
			(Root.Position - EnemyRoot.Position).Magnitude



			if Dist < Distance then

				Distance = Dist

				Target =
