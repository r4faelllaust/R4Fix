-- ================================================================
-- COMBO SYSTEM
-- ================================================================


local function registerCombo()


	local now =
		os.clock()



	if now - SESSION.LastHit
		<= CONFIG.ComboWindow
	then

		SESSION.Combo =
			math.min(
				SESSION.Combo + 1,
				10
			)

	else

		SESSION.Combo =
			1

	end



	SESSION.LastHit =
		now



	return SESSION.Combo

end




-- ================================================================
-- MOVE EXECUTION
-- ================================================================


local function playMove(
	humanoid,
	animationId,
	duration
)


	local trackResult =
		playAnimation(
			humanoid,
			animationId,
			Enum.AnimationPriority.Action
		)



	if trackResult and duration then


		task.delay(
			duration,
			function()


				pcall(function()

					if trackResult.IsPlaying then

						trackResult:Stop(
							0.1
						)

					end

				end)


			end
		)

	end



	return trackResult

end




