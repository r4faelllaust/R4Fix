-- ENGINE
----------------------------------------------------------------
local function activateEngine(duration, speed)
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local sister = getCurrentSister()

	spawnBurst(hrp.CFrame, 9, sister.ColorMain, 0.3)
	spawnShockwave(hrp.CFrame, 3, 18, sister.ColorSecond)

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(4e5, 4e5, 4e5)
	bv.Velocity = hrp.CFrame.LookVector * speed
	bv.Parent = hrp

	task.delay(duration, function()
		if bv then bv:Destroy() end
		if hrp then
			spawnBurst(hrp.CFrame, 11, sister.ColorSecond, 0.3)
		end
	end)
end

----------------------------------------------------------------
-- SWITCH TOOL (Mobile friendly)
----------------------------------------------------------------
local function createSwitchTool()
	-- Remove old
	for _, obj in ipairs(LocalPlayer.Backpack:GetChildren()) do
		if obj:IsA("Tool") and obj.Name == "Switch Sister" then
			obj:Destroy()
		end
	end
	if LocalPlayer.Character then
		for _, obj in ipairs(LocalPlayer.Character:GetChildren()) do
			if obj:IsA("Tool") and obj.Name == "Switch Sister" then
				obj:Destroy()
			end
		end
	end

	local tool = Instance.new("Tool")
	tool.Name = "Switch Sister"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Parent = LocalPlayer.Backpack

	tool.Activated:Connect(function()
		SESSION.CurrentSister = SESSION.CurrentSister % 5 + 1
		local sister = getCurrentSister()

		notify(sister.Name, sister.FullName)

		-- Re-apply visuals if character exists
		if LocalPlayer.Character then
			clearVisuals()
			applySisterVisuals(LocalPlayer.Character)
		end
	end)
end

----------------------------------------------------------------
-- VISUALS
----------------------------------------------------------------
function clearVisuals()
	for _, obj in ipairs(SESSION.AuraObjects) do
		pcall(function() obj:Destroy() end)
	end
	SESSION.AuraObjects = {}
end

function applySisterVisuals(character)
	clearVisuals()
	local sister = getCurrentSister()
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local att = Instance.new("Attachment")
	att.Parent = hrp
	local em = Instance.new("ParticleEmitter")
	em.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, sister.ColorMain),
		ColorSequenceKeypoint.new(1, sister.ColorDark)
	})
	em.LightEmission = 0.7
	em.Rate = 40
	em.Lifetime = NumberRange.new(0.3, 0.55)
	em.Speed = NumberRange.new(0.6, 2)
	em.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(1, 0)
	})
	em.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 1)
	})
	em.Parent = att
	table.insert(SESSION.AuraObjects, att)

	-- Simple trails on arms
	for _, name in ipairs({"Left Arm", "Right Arm"}) do
		local limb = character:FindFirstChild(name)
		if limb then
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(0, -0.1, 0)
			a0.Parent = limb
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(0, -1, 0)
			a1.Parent = limb

			local trail = Instance.new("Trail")
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Lifetime = 0.3
			trail.LightEmission = 0.7
			trail.Color = ColorSequence.new(sister.ColorMain, sister.ColorDark)
			trail.Transparency = NumberSequence.new(0.2, 1)
			trail.WidthScale = NumberSequence.new(1, 0)
			trail.Parent = limb

			table.insert(SESSION.AuraObjects, trail)
			table.insert(SESSION.AuraObjects, a0)
			table.insert(SESSION.AuraObjects, a1)
		end
	end
end

