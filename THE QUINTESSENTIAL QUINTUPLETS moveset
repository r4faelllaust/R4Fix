-- ==========================================================
-- MUSIC SYSTEM
-- ==========================================================

local function StartMusic()

	local Character = Player.Character
	if not Character then
		return
	end


	local Existing = Character:FindFirstChild("LoveEngineMusic")

	if Existing then
		Existing:Destroy()
	end


	local Sound = Instance.new("Sound")

	Sound.Name = "LoveEngineMusic"

	Sound.SoundId =
		"rbxassetid://"

	Sound.Looped = true

	Sound.Volume = 0.5

	Sound.Parent = Character


	-- Put uploaded audio id here
	-- Roblox requires the audio asset to be owned/usable
	-- Sound.SoundId = "rbxassetid://YOUR_AUDIO_ID"


	Sound:Play()

end



-- ==========================================================
-- CHARACTER AURA SYSTEM
-- ==========================================================


local AuraFolder = Instance.new("Folder")

AuraFolder.Name = "LoveEngineVFX"

AuraFolder.Parent = workspace



local function CreateAura(character,data)

	if not character then
		return
	end


	local Highlight =
		character:FindFirstChild("LoveAura")


	if Highlight then
		Highlight:Destroy()
	end



	Highlight = Instance.new("Highlight")

	Highlight.Name = "LoveAura"

	Highlight.FillColor = data.Color

	Highlight.OutlineColor = Color3.new(1,1,1)

	Highlight.FillTransparency = 0.65

	Highlight.OutlineTransparency = 0

	Highlight.Parent = character



	return Highlight

end




-- ==========================================================
-- VFX BURST SYSTEM
-- ==========================================================


local function Burst(position,color,size)

	local Part = Instance.new("Part")

	Part.Anchored = true

	Part.CanCollide = false

	Part.Shape = Enum.PartType.Ball

	Part.Material = Enum.Material.Neon

	Part.Color = color

	Part.Size =
		Vector3.new(1,1,1)

	Part.CFrame =
		CFrame.new(position)


	Part.Parent = AuraFolder



	local Tween =
		TweenService:Create(

			Part,

			TweenInfo.new(
				0.4,
				Enum.EasingStyle.Quint
			),

			{

				Size =
				Vector3.new(
					size,
					size,
					size
				),

				Transparency = 1

			}

		)


	Tween:Play()


	Debris:AddItem(
		Part,
		0.5
	)

end




-- ==========================================================
-- ANIMATION LOADER
-- ==========================================================


local function PlayAnimation(id)

	local Character =
		Player.Character

	if not Character then
		return
	end


	local Humanoid =
		Character:FindFirstChildOfClass(
			"Humanoid"
		)


	if not Humanoid then
		return
	end


	local Animator =
		Humanoid:FindFirstChildOfClass(
			"Animator"
		)


	if not Animator then

		Animator =
			Instance.new("Animator")

		Animator.Parent =
			Humanoid

	end



	local Animation =
		Instance.new("Animation")


	Animation.AnimationId =
		"rbxassetid://"..id



	local Track =
		Animator:LoadAnimation(
			Animation
		)


	Track.Priority =
		Enum.AnimationPriority.Action


	Track:Play()


	return Track

end





-- ==========================================================
-- ULTIMATE SYSTEM
-- ==========================================================


local function AddUltimate(amount)

	LoveEngine.Energy =
		math.clamp(
			LoveEngine.Energy + amount,
			0,
			LoveEngine.MaxEnergy
		)

end




local function UseUltimate()

	if LoveEngine.Energy
		< LoveEngine.MaxEnergy then

		return false

	end



	LoveEngine.Energy = 0


	local Character =
		Player.Character


	if Character then

		local HRP =
			Character:FindFirstChild(
				"HumanoidRootPart"
			)


		if HRP then

			Burst(
				HRP.Position,
				CurrentCharacter.Color,
				20
			)

		end

	end


	return true

end





-- ==========================================================
-- COOLDOWN SYSTEM
-- ==========================================================


local function Cooldown(name,time)

	if LoveEngine.Cooldowns[name] then
		return false
	end


	LoveEngine.Cooldowns[name] = true


	task.delay(
		time,
		function()

			LoveEngine.Cooldowns[name] = nil

		end
	)


	return true

end




-- ==========================================================
-- CHARACTER APPLY
-- ==========================================================


local function SelectCharacter(name)

	local Data =
		Characters[name]


	if not Data then
		return
	end


	CurrentCharacter =
		Data


	LoveEngine.Character =
		Data



	local Character =
		Player.Character


	if Character then

		CreateAura(
			Character,
			Data
		)

	end



end




