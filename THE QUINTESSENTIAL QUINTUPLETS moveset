-- ==========================================================
-- AURA SYSTEM
-- ==========================================================

local function ApplyAura(character,data)

	if not character then
		return
	end


	local old = character:FindFirstChild("LoveAura")

	if old then
		old:Destroy()
	end


	local highlight = Instance.new("Highlight")

	highlight.Name = "LoveAura"

	highlight.FillColor = data.Color

	highlight.OutlineColor = Color3.new(1,1,1)

	highlight.FillTransparency = 0.55

	highlight.OutlineTransparency = 0

	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

	highlight.Parent = character

end



-- ==========================================================
-- ENERGY SYSTEM
-- ==========================================================

local function AddEnergy(amount)

	LoveEngine.Energy =
		math.clamp(
			LoveEngine.Energy + amount,
			0,
			LoveEngine.MaxEnergy
		)

end



-- ==========================================================
-- BURST EFFECT
-- ==========================================================

local function Burst(position,color,size)

	local part = Instance.new("Part")

	part.Anchored = true
	part.CanCollide = false
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon

	part.Color = color

	part.Size = Vector3.new(1,1,1)

	part.Position = position

	part.Parent = VFXFolder



	local tween =
		TweenService:Create(

			part,

			TweenInfo.new(
				0.45,
				Enum.EasingStyle.Quint
			),

			{

				Size = Vector3.new(
					size,
					size,
					size
				),

				Transparency = 1

			}

		)


	tween:Play()


	Debris:AddItem(part,0.5)

end



-- ==========================================================
-- ANIMATION SYSTEM
-- ==========================================================

local function PlayAnimation(id)

	local character = Player.Character

	if not character then
		return
	end


	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)


	if not humanoid then
		return
	end


	local animator =
		humanoid:FindFirstChildOfClass(
			"Animator"
		)


	if not animator then

		animator =
			Instance.new("Animator")

		animator.Parent =
			humanoid

	end



	local animation =
		Instance.new("Animation")


	animation.AnimationId =
		"rbxassetid://"..id



	local track =
		animator:LoadAnimation(
			animation
		)


	track.Priority =
		Enum.AnimationPriority.Action4


	track:Play()


	return track

end



-- ==========================================================
-- COOLDOWN SYSTEM
-- ==========================================================

local function Cooldown(name,time)

	if LoveEngine.Cooldowns[name] then
		return false
	end


	LoveEngine.Cooldowns[name] = true


	task.delay(
		time,
		function()

			LoveEngine.Cooldowns[name] = nil

		end
	)


	return true

end



