local lastWallCombo = 0

local function wallCombo()
	if os.clock() - lastWallCombo < 4 then return end
	lastWallCombo = os.clock()

	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then return end

	local theme = currentTheme()
	playAnimation(humanoid, theme.Anim.WallCombo, 1, 1.0)
	burst(root, 5, 0.18)
	ring(root, 2, 14, 0.25)
	particlePop(root, 10)
end

-- ================================================================
-- MOVES 1–4
-- ================================================================

local function runMove(index: number)
	if S.Busy["Move" .. index] then return end
	S.Busy["Move" .. index] = true

	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then
		S.Busy["Move" .. index] = nil
		return
	end

	local theme = currentTheme()
	local target = findClosestTarget(root.Position, CFG.DashRange)

	if target and index <= 3 then
		engineDash(target, CFG.DashSpeed, CFG.DashDuration, CFG.DashStop)
	end

	playAnimation(humanoid, theme.Anim.Move[index], 1, 0.7)
	burst(root, 4 + index * 1.5, 0.16)
	ring(root, 2, 10 + index * 4, 0.24)
	particlePop(root, 6 + index * 2)

	print("[5SIS] " .. S.Active .. " used " .. theme.Anim.MoveNames[index])

	task.delay(CFG.MoveCooldown[index], function()
		S.Busy["Move" .. index] = nil
	end)
end

-- ================================================================
-- ULTIMATE
-- ================================================================

local lastUlt = 0

local function runUltimate()
	local now = os.clock()
	if now - lastUlt < CFG.UltCooldown then return end
	if S.UltActive then return end
	lastUlt = now

	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then return end

	local theme = currentTheme()
	S.UltActive = true

	playAnimation(humanoid, theme.Anim.Ult, 1, 1.3)

	local pulses = {
		{delay = 0.00, burstSize = 8,  ringSize = 14},
		{delay = 0.08, burstSize = 12, ringSize = 23},
		{delay = 0.16, burstSize = 16, ringSize = 32},
		{delay = 0.24, burstSize = 20, ringSize = 41},
	}

	for _, p in ipairs(pulses) do
		task.delay(p.delay, function()
			if root.Parent then
				burst(root, p.burstSize, 0.32)
				ring(root, 2, p.ringSize, 0.42)
				particlePop(root, 14)
			end
		end)
	end

	local light = Instance.new("PointLight")
	light.Brightness = 12
	light.Range = 28
	light.Color = theme.Color1
	light.Parent = root
	TweenService:Create(light, TweenInfo.new(CFG.UltDuration), {Brightness = 0, Range = 0}):Play()
	Debris:AddItem(light, CFG.UltDuration + 0.2)

	local auraAttachment = Instance.new("Attachment")
	auraAttachment.Parent = root
	local aura = Instance.new("ParticleEmitter")
	aura.Color = ColorSequence.new(theme.Color1, theme.Color2)
	aura.LightEmission = 1
	aura.Rate = 18
	aura.Lifetime = NumberRange.new(0.3, 0.6)
	aura.Speed = NumberRange.new(1, 3)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 0),
	})
	aura.Parent = auraAttachment

	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = S.Active:upper(),
			Text = theme.Anim.UltName,
			Icon = theme.Decal,
			Duration = 4,
		})
	end)

	task.delay(CFG.UltDuration, function()
		pcall(function() aura:Destroy() end)
		pcall(function() auraAttachment:Destroy() end)
		S.UltActive = false
	end)
end

