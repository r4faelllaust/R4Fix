local function switchSister(name: string)
	if not SISTERS[name] then return end
	S.Active = name

	local character, humanoid, root = getCharacter()
	if root then
		burst(root, 6, 0.2)
		ring(root, 2, 16, 0.25)
	end

	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "MOVESET SWITCHED",
			Text = name .. " — " .. SISTERS[name].EngineName,
			Icon = SISTERS[name].Decal,
			Duration = 3,
		})
	end)

	print("[5SIS] Active sister: " .. name)
end

