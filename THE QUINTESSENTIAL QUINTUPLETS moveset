-- R4FIX // GAROU TRAIL -> CREATOR YELLOW OVERRIDE (LOCAL PLAYER ONLY)
-- Applied only to the local player's Character and the Ichika_Cyber_VFX folder
-- ================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- ================================================================
-- YELLOW PALETTE (Ichika themed)
-- ================================================================

local CYBER_YELLOW =
Color3.fromRGB(255, 220, 40)

local LIGHT_YELLOW =
Color3.fromRGB(255, 245, 150)

local GOLD =
Color3.fromRGB(255, 170, 20)

-- ================================================================
-- YELLOW TRAIL COLOR
-- ================================================================

local YELLOW_TRAIL_COLOR =
ColorSequence.new({
	ColorSequenceKeypoint.new(0, LIGHT_YELLOW),
	ColorSequenceKeypoint.new(0.5, CYBER_YELLOW),
	ColorSequenceKeypoint.new(1, GOLD),
})

-- ================================================================
-- Helper: only target local player's VFX (Character or Ichika_Cyber_VFX)
-- ================================================================

local function isLocalVFX(object)
	if not object then return false end

	local char = LocalPlayer and LocalPlayer.Character
	if char and object:IsDescendantOf(char) then return true end

	local vfxFolder = Workspace:FindFirstChild("Ichika_Cyber_VFX")
	if vfxFolder and object:IsDescendantOf(vfxFolder) then return true end

	return false
end

-- ================================================================
-- APPLY YELLOW TO ONE OBJECT
-- ================================================================

local function makeYellow(object)
	if not object then return end
	pcall(function()

		if object:IsA("Trail") then

			object.Color = YELLOW_TRAIL_COLOR
			object.LightEmission = 1

			object.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.75, 0.15),
				NumberSequenceKeypoint.new(1, 1),
			})

		elseif object:IsA("ParticleEmitter") then

			object.Color = YELLOW_TRAIL_COLOR
			object.LightEmission = 1

		elseif object:IsA("Beam") then

			object.Color = YELLOW_TRAIL_COLOR
			object.LightEmission = 1

		elseif object:IsA("PointLight")
			or object:IsA("SpotLight")
			or object:IsA("SurfaceLight")
		then

			object.Color = CYBER_YELLOW

		elseif object:IsA("Highlight") then

			object.FillColor = CYBER_YELLOW
			object.OutlineColor = LIGHT_YELLOW

		end

	end)
end

-- ================================================================
-- SCAN AN OBJECT AND EVERYTHING INSIDE IT (LOCAL ONLY)
-- ================================================================

local function scan(object)
	if not object then return end
	pcall(function()
		-- Only scan objects that belong to the local player (Character) or the Ichika VFX folder
		if not isLocalVFX(object) then return end

		-- If the object is a visual component, apply recolor directly
		if object:IsA("Trail") or object:IsA("ParticleEmitter") or object:IsA("Beam") then
			makeYellow(object)

		else
			-- Otherwise scan descendants and apply where appropriate
			for _, child in ipairs(object:GetDescendants()) do
				if child:IsA("Trail") or child:IsA("ParticleEmitter") or child:IsA("Beam") or child:IsA("PointLight") or child:IsA("Highlight") then
					makeYellow(child)
				end
			end
		end

	end)
end

