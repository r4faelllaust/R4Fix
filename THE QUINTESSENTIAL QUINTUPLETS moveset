local function burstVFX(root, size, duration)
	if not root.Parent then return end
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = getSisterColor()
	part.Transparency = 0.2
	part.Size = Vector3.one
	part.CFrame = root.CFrame
	part.Parent = getFXFolder()
	
	TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = Vector3.new(size, size, size),
		Transparency = 1,
	}):Play()
	
	Debris:AddItem(part, duration + 0.05)
end

local function ringVFX(root, startSize, endSize, duration)
	if not root.Parent then return end
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.Shape = Enum.PartType.Cylinder
	part.Material = Enum.Material.Neon
	part.Color = getSisterColor()
	part.Transparency = 0.25
	part.Size = Vector3.new(0.1, startSize, startSize)
	part.CFrame = root.CFrame * CFrame.Angles(0, 0, math.rad(90))
	part.Parent = getFXFolder()
	
	TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.1, endSize, endSize),
		Transparency = 1,
	}):Play()
	
	Debris:AddItem(part, duration + 0.05)
end

local function slashVFX(root)
	if not root.Parent then return end
	local slash = Instance.new("Part")
	slash.Anchored = true
	slash.CanCollide = false
	slash.Material = Enum.Material.Neon
	slash.Color = getSisterColor()
	slash.Transparency = 0.1
	slash.Size = Vector3.new(0.15, 4, 8)
	slash.CFrame = root.CFrame * CFrame.new(0, 0, -3.5) * CFrame.Angles(
		math.rad(math.random(-15, 15)), 0, math.rad(math.random(-25, 25))
	)
	slash.Parent = getFXFolder()
	
	TweenService:Create(slash, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.05, 0.5, 14),
		Transparency = 1,
	}):Play()
	
	Debris:AddItem(slash, 0.22)
end

-- ================================================================
-- QUINTUPLETS RUSH (Love Engine Improved)
-- ================================================================

local function quintupletsRush(duration, speed, token)
	local char, hum, root = getChar()
	if not char or not hum or not root then return false end
	if token ~= S.Token or hum.Health <= 0 then return false end
	
	local sister = SISTERS[S.CurrentSister]
	
	-- Create 5 trail attachments (one for each sister)
	local attachments = {}
	local trails = {}
	
	for i = 1, 5 do
		local att = Instance.new("Attachment")
		att.Position = Vector3.new((i-3) * 0.8, 0, 0)
		att.Parent = root
		table.insert(attachments, att)
		
		if i < 5 then
			local trail = Instance.new("Trail")
			trail.Attachment0 = att
			trail.Attachment1 = attachments[i]
			trail.Lifetime = 0.2
			trail.LightEmission = 1
			trail.Color = ColorSequence.new(sister.Color, sister.LightColor)
			trail.Transparency = NumberSequence.new(0.05, 1)
			trail.Parent = root
			table.insert(trails, trail)
		end
	end
	
	-- Velocity engine
	local att0 = Instance.new("Attachment")
	att0.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.MaxForce = math.huge
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.Attachment0 = att0
	velocity.Parent = root
	
	burstVFX(root, 6, 0.15)
	ringVFX(root, 3, 20, 0.3)
	
	local start = os.clock()
	while os.clock() - start < duration do
		if token ~= S.Token or hum.Health <= 0 or not root.Parent then break end
		
		local dir = root.CFrame.LookVector
		velocity.VectorVelocity = Vector3.new(dir.X * speed, 0, dir.Z * speed)
		
		-- Sister aura effect
		if math.random() < 0.3 then
			burstVFX(root, math.random(3, 6), 0.1)
		end
		
		RunService.Heartbeat:Wait()
	end
	
	for _, a in ipairs(attachments) do pcall(function() a:Destroy() end) end
	for _, t in ipairs(trails) do pcall(function() t:Destroy() end) end
	pcall(function() velocity:Destroy() end)
	pcall(function() att0:Destroy() end)
	
	if root.Parent then
		burstVFX(root, 8, 0.2)
		ringVFX(root, 5, 25, 0.35)
	end
	return true
end

