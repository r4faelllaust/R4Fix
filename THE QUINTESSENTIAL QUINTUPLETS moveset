local function activateEngine(duration, speed)
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	local sister = getCurrentSister()

	spawnBurst(hrp.CFrame, 9, sister.ColorMain, 0.3)
	spawnShockwave(hrp.CFrame, 3, 18, sister.ColorSecond)

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(4e5, 4e5, 4e5)
	bv.Velocity = hrp.CFrame.LookVector * speed
	bv.Parent = hrp

	local bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
	bg.P = 30000
	bg.CFrame = hrp.CFrame
	bg.Parent = hrp

	-- Afterimages
	task.spawn(function()
		for i = 1, 6 do
			if not hrp or not hrp.Parent then break end
			local clone = char:Clone()
			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("BasePart") then
					v.Anchored = true
					v.CanCollide = false
					v.Material = Enum.Material.Neon
					v.Color = sister.ColorMain
					v.Transparency = 0.55
				elseif v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Humanoid") then
					v:Destroy()
				end
			end
			clone.Parent = workspace
			Debris:AddItem(clone, 0.45)
			task.wait(0.04)
		end
	end)

	task.delay(duration, function()
		if bv then bv:Destroy() end
		if bg then bg:Destroy() end
		if hrp then
			spawnBurst(hrp.CFrame, 12, sister.ColorSecond, 0.3)
		end
	end)
end

