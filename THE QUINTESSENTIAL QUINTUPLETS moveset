getgenv().R4FIX_Yotsuba=getgenv().R4FIX_Yotsuba or {
Initialized=false,
Ulted=false,
Token=0,
Connections={},
VFX={}
}

local S=getgenv().R4FIX_Yotsuba

local function track(c)
table.insert(S.Connections,c)
return c
end

local function clean()
for _,c in ipairs(S.Connections) do
pcall(function() c:Disconnect() end)
end
table.clear(S.Connections)

for _,v in ipairs(S.VFX) do
	pcall(function()
		if v and v.Parent then v:Destroy() end
	end)
end
table.clear(S.VFX)

end

local function folder()
local x=workspace:FindFirstChild("R4FIX_Yotsuba_VFX")
if not x then
x=Instance.new("Folder")
x.Name="R4FIX_Yotsuba_VFX"
x.Parent=workspace
end
return x
end

local function root()
local c=Player.Character
return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function closest()
local rr=root()
if not rr then return nil end

local best,bestD=nil,math.huge

for _,p in ipairs(Players:GetPlayers()) do
	if p~=Player and p.Character then
		local h=p.Character:FindFirstChild("HumanoidRootPart")
		local hum=p.Character:FindFirstChildOfClass("Humanoid")

		if h and hum and hum.Health>0 then
			local d=(h.Position-rr.Position).Magnitude
			if d<bestD then
				best=p
				bestD=d
			end
		end
	end
end

return best

end

local function burst(cf:CFrame,size:number,color:Color3)
local p=Instance.new("Part")
p.Anchored=true
p.CanCollide=false
p.CanTouch=false
p.CanQuery=false
p.CastShadow=false
p.Shape=Enum.PartType.Ball
p.Material=Enum.Material.Neon
p.Color=color
p.Transparency=.08
p.Size=Vector3.one
p.CFrame=cf
p.Parent=folder()
table.insert(S.VFX,p)

local l=Instance.new("PointLight")
l.Color=color
l.Brightness=12
l.Range=25
l.Parent=p

TweenService:Create(
	p,
	TweenInfo.new(.28,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
	{
		Size=Vector3.new(size,size,size),
		Transparency=1
	}
):Play()

TweenService:Create(
	l,
	TweenInfo.new(.25),
	{
		Brightness=0,
		Range=0
	}
):Play()

Debris:AddItem(p,.35)

end

local function shock(cf:CFrame,size:number)
local p=Instance.new("Part")
p.Anchored=true
p.CanCollide=false
p.CanTouch=false
p.CanQuery=false
p.CastShadow=false
p.Shape=Enum.PartType.Cylinder
p.Material=Enum.Material.Neon
p.Color=FIRE
p.Transparency=.15
p.Size=Vector3.new(.15,2,2)
p.CFrame=cf*CFrame.Angles(0,0,math.rad(90))
p.Parent=folder()
table.insert(S.VFX,p)

TweenService:Create(
	p,
	TweenInfo.new(.35,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
	{
		Size=Vector3.new(.15,size,size),
		Transparency=1
	}
):Play()

Debris:AddItem(p,.45)

end

local function fire(part:BasePart,n:number)
local a=Instance.new("Attachment")
a.Parent=part
table.insert(S.VFX,a)

local e=Instance.new("ParticleEmitter")
e.Texture="rbxasset://textures/particles/fire_main.dds"
e.Color=ColorSequence.new(WHITE,ORANGE,RED)
e.LightEmission=1
e.Rate=0
e.Lifetime=NumberRange.new(.25,.65)
e.Speed=NumberRange.new(5,14)
e.SpreadAngle=Vector2.new(360,360)
e.Size=NumberSequence.new({
	NumberSequenceKeypoint.new(0,.2),
	NumberSequenceKeypoint.new(.4,.65),
	NumberSequenceKeypoint.new(1,0)
})
e.Parent=a

pcall(function() e:Emit(n) end)

Debris:AddItem(a,1)

end

local function aura()
local rr=root()
if not rr then return end

local a=Instance.new("Attachment")
a.Name="YotsubaFlameAura"
a.Parent=rr
table.insert(S.VFX,a)

local e=Instance.new("ParticleEmitter")
e.Texture="rbxasset://textures/particles/fire_main.dds"
e.Color=ColorSequence.new(WHITE,ORANGE,RED)
e.LightEmission=1
e.Rate=20
e.Lifetime=NumberRange.new(.25,.7)
e.Speed=NumberRange.new(1,4)
e.SpreadAngle=Vector2.new(360,360)
e.Size=NumberSequence.new({
	NumberSequenceKeypoint.new(0,.18),
	NumberSequenceKeypoint.new(.5,.55),
	NumberSequenceKeypoint.new(1,0)
})
e.Parent=a

end

local function seriousDash()
local rr=root()
local t=closest()

if not rr or not t or not t.Character then return end

local tr=t.Character:FindFirstChild("HumanoidRootPart")
if not tr or not tr:IsA("BasePart") then return end

rr.CFrame=tr.CFrame*CFrame.new(0,0,7)

burst(rr.CFrame,12,FIRE)
fire(rr,50)

task.delay(.1,function()
	if rr.Parent then
		rr.CFrame=tr.CFrame*CFrame.new(0,0,-3)
		burst(rr.CFrame,20,RED)
		shock(rr.CFrame,40)
		fire(rr,80)
	end
end)

end

local function punchBarrage()
local rr=root()
if not rr then return end

for i=1,12 do
	task.delay(i*.045,function()
		if rr.Parent then
			burst(
				rr.CFrame*CFrame.new(
					math.random(-3,3),
					math.random(-2,3),
					-2
				),
				5+i*.5,
				i%2==0 and FIRE or RED
			)

			fire(rr,12)
		end
	end)
end

end

local function flash()
local g=Instance.new("ScreenGui")
g.IgnoreGuiInset=true
g.ResetOnSpawn=false
g.Parent=Gui
table.insert(S.VFX,g)

local frame=Instance.new("Frame")
frame.Size=UDim2.fromScale(1,1)
frame.BackgroundColor3=WHITE
frame.BackgroundTransparency=.05
frame.BorderSizePixel=0
frame.Parent=g

TweenService:Create(
	frame,
	TweenInfo.new(.45),
	{BackgroundTransparency=1}
):Play()

Debris:AddItem(g,.5)

end

local function bar()
local b=Gui:FindFirstChild("Bar")
local m=b and b:FindFirstChild("MagicHealth")
if not m then return end

local l=m:FindFirstChild("TextLabel")

if l and l:IsA("TextLabel") then
	l.Text=S.Ulted
		and "🔥 YOTSUBA // SERIOUS MODE 🔥"
		or "🔥 YOTSUBA'S SERIOUS ENERGY 🔥"
	l.TextColor3=ORANGE
end

end

local function slot(n:number,text:string)
local h=Gui:FindFirstChild("Hotbar")
local b=h and h:FindFirstChild("Backpack")
local hb=b and b:FindFirstChild("Hotbar")
local s=hb and hb:FindFirstChild(tostring(n))

if not s then return end

local base=s:FindFirstChild("Base") or s
local l=base:FindFirstChild("ToolName")

if l and l:IsA("TextLabel") then
	l.Text=text
end
end

local function hot()
if S.Ulted then
slot(1,"Serious Series")
slot(2,"Meteoric Barrage")
slot(3,"Omni Punch")
slot(4,"Serious Final Smash")
else
slot(1,"Serious Dash")
slot(2,"Consecutive Punches")
slot(3,"Table Flip")
slot(4,"Serious Step")
end
end

local function tab()
local top=Gui:FindFirstChild("TopbarPlus")
if not top then return end

for _,x in ipairs(top:GetDescendants()) do
	if x.Name=="IconButton" then
		local l=x:FindFirstChild("IconLabel")
		local i=x:FindFirstChild("IconImage")

		if l and l:IsA("TextLabel") then
			if l.Text=="Hero Hunter"
				or l.Text=="Garou"
				or l.Text=="Dark Garou"
				or l.Text=="Marin"
				or l.Text=="Ichika"
				or l.Text=="Nino"
				or l.Text=="Miku"
			then
				l.Text=NAME

				-- FIX: match ImageButton too, not just ImageLabel
				if i and (i:IsA("ImageLabel") or i:IsA("ImageButton")) then
					i.Image=DECAL
				end
			end
		end
	end
end

end

local function music()
if not isfile or not writefile or not getcustomasset then return end

if not isfile(MUSIC_FILE) then
	local ok,data=pcall(function()
		return game:HttpGet(MUSIC_URL)
	end)

	if ok and data then
		pcall(function()
			writefile(MUSIC_FILE,data)
		end)
	end
end

if not isfile(MUSIC_FILE) then return end

local old=SoundService:FindFirstChild("R4FIX_TQQ_Music")
if old then old:Destroy() end

local s=Instance.new("Sound")
s.Name="R4FIX_TQQ_Music"
s.SoundId=getcustomasset(MUSIC_FILE)
s.Volume=.9
s.Looped=true
s.Parent=SoundService
s:Play()

end

local function notify(text)
pcall(function()
StarterGui:SetCore("SendNotification",{
Title="YOTSUBA 🔥",
Text=text,
Icon=DECAL,
Duration=3
})
end)
end

local function move(id:string)
local rr=root()
if not rr then return end

if id==SLOT1 then
	seriousDash()

elseif id==SLOT2 then
	punchBarrage()

elseif id==SLOT3 then
	burst(rr.CFrame,18,FIRE)
	shock(rr.CFrame,35)
	fire(rr,90)

elseif id==SLOT4 then
	for i=1,6 do
		task.delay(i*.07,function()
			if rr.Parent then
				burst(rr.CFrame,7+i,RED)
				fire(rr,20)
			end
		end)
	end
end

end

local function ult(id:string)
S.Ulted=true

local rr=root()
if not rr then return end

flash()
aura()

burst(rr.CFrame,35,WHITE)
shock(rr.CFrame,70)
fire(rr,180)

if id==ULT1 then
	for i=1,15 do
		task.delay(i*.05,function()
			burst(rr.CFrame,5+i,FIRE)
			fire(rr,15)
		end)
	end

elseif id==ULT2 then
	for i=1,20 do
		task.delay(i*.045,punchBarrage)
	end

elseif id==ULT3 then
	seriousDash()

	task.delay(.35,function()
		seriousDash()
	end)

	task.delay(.7,function()
		seriousDash()
	end)

	task.delay(1.05,function()
		if rr.Parent then
			burst(rr.CFrame,55,WHITE)
			shock(rr.CFrame,100)
			fire(rr,250)
		end
	end)
end

hot()

end

local function setup(c:Model)
S.Token+=1
local token=S.Token

clean()
S.Ulted=false

local hum=c:WaitForChild("Humanoid",10)
local rr=c:WaitForChild("HumanoidRootPart",10)

if not hum or not rr or not rr:IsA("BasePart") then return end

aura()

track(hum.AnimationPlayed:Connect(function(t)
	if token~=S.Token then return end
	if not t.Animation then return end

	local id=t.Animation.AnimationId

	if id==SLOT1
		or id==SLOT2
		or id==SLOT3
		or id==SLOT4
	then
		move(id)
	elseif id==ULT1
		or id==ULT2
		or id==ULT3
	then
		ult(id)
	end
end))

notify("SERIOUS MODE READY 🔥")

end

if not S.Initialized then
S.Initialized=true

track(Player.CharacterAdded:Connect(function(c)
	task.wait(.3)
	setup(c)
end))

track(RunService.Heartbeat:Connect(function()
	pcall(tab)
	pcall(hot)
	pcall(bar)
end))

task.spawn(music)

end

if Player.Character then
setup(Player.Character)
end

print("[R4FIX] Yotsuba Saitama moveset loaded. (FIXED)")
