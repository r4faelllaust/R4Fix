local function allowed(
	key,
	cooldown
)

	local now =
		os.clock()


	local last =
		SESSION.LastVFX[key]
		or 0


	if now - last < cooldown then

		return false

	end


	SESSION.LastVFX[key] =
		now


	return true

end



