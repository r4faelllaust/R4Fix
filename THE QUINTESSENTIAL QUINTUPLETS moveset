Humanoid.AnimationPlayed:Connect(function(track)


	local id =
		tonumber(
			string.match(
				track.Animation.AnimationId,
				"%d+"
			)
		)



	for _,move in pairs(Moves) do


		if id == move.Trigger then



			track:Stop()



			PlayAnimation(
				move.Animation,
				1
			)



			MoveEffect(
				20
			)



			if move.Trigger ==
				Moves[1].Trigger
			then

				CinematicTeleport()

			end



		end


	end


end)



