local function setupCharacter(character)
	cleanup()
	clearVisuals()

	local humanoid = character:WaitForChild("Humanoid", 10)
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not hrp then return end

	-- Force Hunter
	pcall(function()
		character:WaitForChild("Communicate", 3):FireServer({
			Goal = "Change Character",
			Character = "Hunter"
		})
	end)

	task.wait(0.6)

	applySisterVisuals(character)
	setupMoves(character, humanoid, hrp)
	createSwitchTool()

	local sister = getCurrentSister()
	spawnBurst(hrp.CFrame, 11, sister.ColorMain, 0.4)
	notify("Quintuplets", "Loaded • " .. sister.Name)
end

