local KEY_TO_MOVE = {
	[Enum.KeyCode.Q] = 1,
	[Enum.KeyCode.E] = 2,
	[Enum.KeyCode.R] = 3,
	[Enum.KeyCode.F] = 4,
}

local KEY_TO_SISTER = {
	[Enum.KeyCode.One] = "Ichika",
	[Enum.KeyCode.Two] = "Nino",
	[Enum.KeyCode.Three] = "Miku",
	[Enum.KeyCode.Four] = "Yotsuba",
	[Enum.KeyCode.Five] = "Itsuki",
}

local function setupInput()
	table.insert(S.Connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			creatorM1()
			return
		end

		if input.UserInputType == Enum.UserInputType.Touch then
			-- optional: hook to a custom mobile button if you add one
			return
		end

		if input.KeyCode == Enum.KeyCode.T then
			runUltimate()
			return
		end

		local moveIndex = KEY_TO_MOVE[input.KeyCode]
		if moveIndex then
			runMove(moveIndex)
			return
		end

		local sisterName = KEY_TO_SISTER[input.KeyCode]
		if sisterName then
			switchSister(sisterName)
		end
	end))
end

