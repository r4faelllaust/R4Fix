-- ================================================================


local function setupCharacter(
	character
)


	SESSION.CharacterToken += 1


	local token =
		SESSION.CharacterToken



	SESSION.IsUlted =
		false



	disconnect(
		SESSION.CharacterConnections
	)



	clearAura()



	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)



	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)



	if not humanoid
		or not root
	then

		return

	end




	createItsukiAura(
		root
	)



	spawnEffect(
		character,
		root
	)



	setupIdle(
		character,
		humanoid,
		token
	)



	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)



	task.spawn(

		function()


			for i = 1,40 do


				updateHotbar()

				updateCharacterTab()

				updateUltimateBar()


				task.wait(
					0.15
				)


			end


		end

	)



	humanoid.Died:Connect(

		function()


			SESSION.IsUlted =
				false



		end

	)


end




