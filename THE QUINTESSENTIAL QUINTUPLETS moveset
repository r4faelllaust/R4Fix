-- ==========================================================
-- ANIMATION REPLACEMENT HOOKS
-- ==========================================================


local function ReplaceAnimation(
	Original,
	New
)


	Humanoid.AnimationPlayed:Connect(
	function(track)


		if track.Animation.AnimationId
			==
			"rbxassetid://"..Original
		then


			track:Stop()


			local Animation =
				Instance.new(
					"Animation"
				)


			Animation.AnimationId =
				"rbxassetid://"..New


			local Loaded =
				Humanoid:LoadAnimation(
					Animation
				)


			Loaded:Play()


		end


	end)

end



