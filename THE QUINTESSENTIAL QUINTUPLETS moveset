-- ================================================================
-- MOVE EXECUTION
-- ================================================================


local function executeMove(
	number
)


	local character =
		Player.Character


	if not character then
		return
	end


	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)


	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)


	if not humanoid
		or not root
	then
		return
	end



	if number == 1 then


		playAnimation(
			humanoid,
			MOVES.Move1
		)


		starBurst(
			root.CFrame *
			CFrame.new(
				0,
				0,
				-4
			),
			15,
			"move1"
		)


		impactRing(
			root.CFrame,
			25,
			"move1ring"
		)



	elseif number == 2 then


		playAnimation(
			humanoid,
			MOVES.Move2
		)


		starParticles(
			root,
			70,
			"move2"
		)


		starBurst(
			root.CFrame,
			20,
			"move2burst"
		)



	elseif number == 3 then


		playAnimation(
			humanoid,
			MOVES.Move3
		)


		createItsukiAura(
			root
		)


		impactRing(
			root.CFrame,
			40,
			"move3ring"
		)



	elseif number == 4 then


		playAnimation(
			humanoid,
			MOVES.Move4
		)


		starBurst(
			root.CFrame,
			35,
			"move4"
		)


		starParticles(
			root,
			150,
			"move4particles"
		)

	end

end



local function executeUltimate()


	local character =
		Player.Character


	if not character then
		return
	end


	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)


	if root then

		playAnimation(
			character:FindFirstChildOfClass(
				"Humanoid"
			),
			MOVES.Ult
		)


		ultimateTransformation(
			character,
			root
		)

	end


	refreshHotbar()

end



