	Root.CFrame =
		EnemyRoot.CFrame *
		CFrame.new(
			0,
			0,
			5
		)



	CyberBurst(
		EnemyRoot.Position,
		25
	)



	CyberRing(
		EnemyRoot.Position,
		45
	)



	Debris:AddItem(
		Platform,
		1
	)


