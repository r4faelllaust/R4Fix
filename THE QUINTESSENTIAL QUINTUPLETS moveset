local function cleanupCharacter()
	disconnectList(S.CharConnections)
	cleanupTracks()
	S.Busy = {}
	table.clear(S.LastFX)
	local fx = Workspace:FindFirstChild("R4Fix_5SisFX")
	if fx then pcall(function() fx:Destroy() end) end
end

local function setupCharacter(character: Model)
	S.Token += 1
	cleanupCharacter()

	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then return end

	local theme = currentTheme()
	playAnimation(humanoid, theme.Anim.Spawn, 1, 1.1)
	burst(root, 7, 0.2)
	ring(root, 2, 18, 0.3)

	table.insert(S.CharConnections, humanoid.Died:Connect(function()
		S.Busy = {}
		cleanupTracks()
	end))
end

