local function moveImpact(
	root,
	name,
	size
)

	if not root then
		return
	end


	starBurst(
		root.CFrame,
		size,
		name .. "_burst"
	)


	impactRing(
		root.CFrame,
		size * 2,
		name .. "_ring"
	)


	starParticles(
		root,
		50,
		name .. "_particles"
	)

end



-- ================================================================
-- ANIMATION MOVE DETECTOR
-- ================================================================


local function setupMoveSystem(
	character,
	humanoid,
	root
)


	track(
		humanoid.AnimationPlayed:Connect(
			function(animationTrack)


				if not animationTrack
					or not animationTrack.Animation
				then
					return
				end


				local id =
					animationTrack.Animation.AnimationId



				-- ====================================================
				-- M1 REPLACEMENT
				-- ====================================================


				local replacement =
					M1_REPLACEMENTS[id]


				if replacement then


					pcall(function()

						animationTrack:Stop()

					end)



					playAnimation(
						humanoid,
						replacement,
						Enum.AnimationPriority.Action
					)



					moveImpact(
						root,
						"Star_M1",
						7
					)


					return

				end



				-- ====================================================
				-- MOVE 1
				-- ====================================================


				if id == MOVES.Move1 then


					pcall(function()

						animationTrack:Stop()

					end)



					playAnimation(
						humanoid,
						MOVES.Move1,
						Enum.AnimationPriority.Action
					)



					moveImpact(
						root,
						"Star_Impact",
						16
					)



					return

				end



				-- ====================================================
				-- MOVE 2
				-- ====================================================


				if id == MOVES.Move2 then


					pcall(function()

						animationTrack:Stop()

					end)



					playAnimation(
						humanoid,
						MOVES.Move2,
						Enum.AnimationPriority.Action
					)



					for i = 1,3 do

						task.delay(
							i * 0.08,
							function()

								if root.Parent then

									starBurst(
										root.CFrame *
										CFrame.new(
											0,
											0,
											-i * 3
										),
										10,
										"Rush_"..i
									)

								end

							end
						)

					end


					impactRing(
						root.CFrame,
						35,
						"RushRing"
					)


					return

				end



				-- ====================================================
				-- MOVE 3
				-- ====================================================


				if id == MOVES.Move3 then


					pcall(function()

						animationTrack:Stop()

					end)



					playAnimation(
						humanoid,
						MOVES.Move3,
						Enum.AnimationPriority.Action
					)



					createItsukiAura(
						root
					)



					moveImpact(
						root,
						"NakanoSpirit",
						24
					)



					return

				end



				-- ====================================================
				-- MOVE 4
				-- ====================================================


				if id == MOVES.Move4 then


					pcall(function()

						animationTrack:Stop()

					end)



					playAnimation(
						humanoid,
						MOVES.Move4,
						Enum.AnimationPriority.Action
					)



					moveImpact(
						root,
						"LeaderCommand",
						30
					)



					return

				end



				-- ====================================================
				-- ULTIMATE
				-- ====================================================


				if id == MOVES.Ult then


					pcall(function()

						animationTrack:Stop()

					end)



					playAnimation(
						humanoid,
						MOVES.Ult,
						Enum.AnimationPriority.Action4
					)



					ultimateTransformation(
						character,
						root
					)



					return

				end


			end
		)
	)

end



