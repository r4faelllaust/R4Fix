local MUSIC_URL = "https://github.com/r4faelllaust/R4Fix/raw/refs/heads/main/TQQ5sisOPE.mp3"
local MUSIC_FILE = "TQQ5sisOPE.mp3"

local function setupMusic()
	local sound = SoundService:FindFirstChild("QuintupletsBGM")
	if sound then sound:Destroy() end

	sound = Instance.new("Sound")
	sound.Name = "QuintupletsBGM"
	sound.Looped = true
	sound.Volume = 0.7
	sound.Parent = SoundService

	task.spawn(function()
		if not isfile(MUSIC_FILE) then
			local success, data = pcall(function()
				return game:HttpGet(MUSIC_URL)
			end)
			if success and data then
				writefile(MUSIC_FILE, data)
			end
		end

		if isfile(MUSIC_FILE) and getcustomasset then
			sound.SoundId = getcustomasset(MUSIC_FILE)
			sound:Play()
		end
	end)

	-- Keep alive
	sound.Ended:Connect(function()
		if sound.Looped then
			sound:Play()
		end
	end)
end

