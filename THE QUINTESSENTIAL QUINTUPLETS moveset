-- ================================================================
-- TELEPORT BEHIND TARGET
-- ================================================================


local function TeleportBehindTarget()


	local target =
		GetClosestPlayer()



	if not target then
		return nil
	end



	local character =
		Player.Character



	if not character then
		return nil
	end



	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)



	local enemyRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)



	if not root
	or not enemyRoot then
		return nil
	end



	local position =
		enemyRoot.Position
		-
		enemyRoot.CFrame.LookVector * 3



	root.CFrame =
		CFrame.lookAt(
			position,
			enemyRoot.Position
		)



	CyberBurst(
		root.CFrame,
		8,
		"teleport"
	)



	CyberParticles(
		root,
		20
	)



	return target

end



-- ================================================================
-- AFTERIMAGE EFFECT
-- ================================================================


local function CreateAfterImage()


	local character =
		Player.Character



	if not character then
		return
	end



	local clone



	pcall(function()

		clone =
			character:Clone()

	end)



	if not clone then
		return
	end



	for _,obj in ipairs(
		clone:GetDescendants()
	) do



		if obj:IsA("BasePart") then


			obj.Anchored =
				true


			obj.CanCollide =
				false


			obj.Material =
				Enum.Material.Neon


			obj.Color =
				YELLOW


			obj.Transparency =
				0.55



		elseif obj:IsA("Script")
		or obj:IsA("LocalScript")
		then


			obj:Destroy()

		end


	end



	clone.Name =
		"IchikaCyberAfterImage"



	clone.Parent =
		GetVFXFolder()



	local fadeTime =
		0.45



	for _,part in ipairs(
		clone:GetDescendants()
	) do


		if part:IsA("BasePart") then


			TweenService:Create(
				part,
				TweenInfo.new(
					fadeTime
				),
				{

					Transparency =
						1

				}
			):Play()


		end


	end



	Debris:AddItem(
		clone,
		0.6
	)

end



