local activeIndex = 1

local function ApplyCharacter(index)
	local c = CHARACTERS[index]
	if not c then return end

	-- set global labels and colors used by existing functions
	MOVESET_NAME = c.name .. " Nakano"
	DECAL_ID = c.decal

	-- set theme colors (fallback to previous values)
	CYBER_YELLOW = c.color.main or CYBER_YELLOW
	LIGHT_YELLOW = c.color.light or LIGHT_YELLOW
	GOLD = c.color.alt or GOLD

	-- animation mapping
	MirageAnimation = c.mirageAnim or MirageAnimation
	ULT1_ANIMATION = tostring(c.ultAnim) and ("rbxassetid://"..tostring(c.ultAnim)) or ULT1_ANIMATION

	BASE_HOTBAR = c.baseHotbar
	ULT_HOTBAR = c.ultHotbar

	-- update topbar immediately
	pcall(function()
		local topbar = Player:FindFirstChild("PlayerGui") and Player.PlayerGui:FindFirstChild("TopbarPlus")
		if topbar then
			for _,obj in ipairs(topbar:GetDescendants()) do
				if obj.Name == "IconButton" then
					local label = obj:FindFirstChild("IconLabel")
					local image = obj:FindFirstChild("IconImage")
					if label then label.Text = MOVESET_NAME; label.TextColor3 = CYBER_YELLOW end
					if image then image.Image = DECAL_ID end
				end
			end
		end
	end)

	if DEBUG then print("Applied character:", c.name) end
end

-- initial apply
ApplyCharacter(activeIndex)

-- Switch character helper
local function NextCharacter()
	activeIndex = activeIndex % #CHARACTERS + 1
	ApplyCharacter(activeIndex)
end
local function PrevCharacter()
	activeIndex = (activeIndex - 2) % #CHARACTERS + 1
	ApplyCharacter(activeIndex)
end

-- Improved hotbar refresh: try multiple paths including the exact structure you posted
local function refreshHotbarEnhanced()
	local ok, gui = pcall(function() return Player.PlayerGui end)
	if not ok or not gui then return end

	local slots = {}

	-- method 1: TextLabels named ToolName
	for _,obj in ipairs(gui:GetDescendants()) do
		if obj.Name == "ToolName" and obj:IsA("TextLabel") then table.insert(slots, obj) end
	end

	-- method 2: structured Hotbar.Backpack.Hotbar.N.Base.ToolName
	for _,pathRoot in ipairs({"Hotbar","Backpack"}) do
		local hb = gui:FindFirstChild(pathRoot, true)
		if hb then
			for i=1,4 do
				local slot = hb:FindFirstChild(tostring(i), true) -- try numeric
				if slot and slot:FindFirstChild("Base") and slot.Base:FindFirstChild("ToolName") then
					table.insert(slots, slot.Base.ToolName)
				end
			end
		end
	end

	-- fallback: find by common node names
	if #slots < 4 then
		for _,obj in ipairs(gui:GetDescendants()) do
			if obj.Name == "Base" and obj:FindFirstChild("ToolName") then table.insert(slots, obj.ToolName) end
		end
	end

	-- assign
	for i=1,4 do
		local name = SESSION.IsUlted and (ULT_HOTBAR and ULT_HOTBAR[i] or "") or (BASE_HOTBAR and BASE_HOTBAR[i] or "")
		if slots[i] and slots[i].IsA and slots[i]:IsA("TextLabel") then
			slots[i].Text = name
		end
	end
end

