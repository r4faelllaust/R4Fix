-- VFX
----------------------------------------------------------------
local function spawnBurst(cf, size, color, dur)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Shape = Enum.PartType.Ball
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.15
	p.Size = Vector3.one
	p.CFrame = cf
	p.Parent = workspace

	TweenService:Create(p, TweenInfo.new(dur or 0.35, Enum.EasingStyle.Quint), {
		Size = Vector3.new(size, size, size),
		Transparency = 1
	}):Play()
	Debris:AddItem(p, (dur or 0.35) + 0.1)
end

local function spawnShockwave(cf, startS, endS, color)
	local r = Instance.new("Part")
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.Shape = Enum.PartType.Cylinder
	r.Material = Enum.Material.Neon
	r.Color = color
	r.Transparency = 0.2
	r.Size = Vector3.new(0.12, startS, startS)
	r.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
	r.Parent = workspace

	TweenService:Create(r, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {
		Size = Vector3.new(0.12, endS, endS),
		Transparency = 1
	}):Play()
	Debris:AddItem(r, 0.55)
end

