local SLOT1 = "rbxassetid://12273188754"
local SLOT2 = "rbxassetid://12296113986"
local SLOT3 = "rbxassetid://12309835105"
local SLOT4 = "rbxassetid://12351854556"

local function setupMoves(character, humanoid, hrp)
	track(humanoid.AnimationPlayed:Connect(function(track)
		local id = track.Animation.AnimationId
		local sister = getCurrentSister()

		if id == SLOT1 then
			track:Stop()
			local target = getClosestEnemy()
			if target then
				local pos = target.Position - target.CFrame.LookVector * 3.2
				hrp.CFrame = CFrame.lookAt(pos, target.Position)
			end
			activateEngine(0.5, 200)
			spawnBurst(hrp.CFrame, 10, sister.ColorMain, 0.3)
		elseif id == SLOT2 then
			track:Stop()
			activateEngine(0.8, 250)
			spawnBurst(hrp.CFrame, 12, sister.ColorSecond, 0.35)
		elseif id == SLOT3 then
			track:Stop()
			activateEngine(1.0, 230)
			spawnBurst(hrp.CFrame, 14, sister.ColorMain, 0.4)
		elseif id == SLOT4 then
			track:Stop()
			spawnBurst(hrp.CFrame, 15, sister.ColorDark, 0.4)
			spawnShockwave(hrp.CFrame, 4, 30, sister.ColorMain)
		end
	end))
end

