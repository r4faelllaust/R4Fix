-- ================================================================
-- COOLDOWN
-- ================================================================


local function allowed(
	key,
	time
)


	local now =
		os.clock()



	local last =
		SESSION.LastVFX[key]
		or 0



	if now-last < time then

		return false

	end



	SESSION.LastVFX[key] =
		now



	return true

end



