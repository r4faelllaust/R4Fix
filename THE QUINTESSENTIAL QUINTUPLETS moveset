-- ================================================================
-- HELPERS
-- ================================================================

local function getCharacter()
	local character = LocalPlayer.Character
	if not character then return nil, nil, nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then return nil, nil, nil end
	return character, humanoid, root
end

local function getAnimator(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	return animator
end

local function playAnimation(humanoid: Humanoid, id: string, speed: number?, duration: number?)
	if humanoid.Health <= 0 then return nil end
	local animator = getAnimator(humanoid)
	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local success, track = pcall(function() return animator:LoadAnimation(animation) end)
	animation:Destroy()
	if not success or not track then return nil end

	track.Priority = Enum.AnimationPriority.Action4
	table.insert(S.Tracks, track)
	pcall(function() track:Play(0.04, 1, speed or 1) end)

	if duration then
		task.delay(duration, function()
			pcall(function()
				if track.IsPlaying then track:Stop(0.06) end
			end)
		end)
	end
	return track
end

local function disconnectList(list)
	for i = #list, 1, -1 do
		pcall(function() list[i]:Disconnect() end)
		list[i] = nil
	end
end

local function cleanupTracks()
	for i = #S.Tracks, 1, -1 do
		pcall(function()
			if S.Tracks[i].IsPlaying then S.Tracks[i]:Stop(0.05) end
			S.Tracks[i]:Destroy()
		end)
		S.Tracks[i] = nil
	end
end

local function getFXFolder()
	local folder = Workspace:FindFirstChild("R4Fix_5SisFX")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "R4Fix_5SisFX"
		folder.Parent = Workspace
	end
	return folder
end

local function currentTheme()
	return SISTERS[S.Active]
end

-- ================================================================
-- VFX
-- ================================================================

local function burst(root: BasePart, size: number, duration: number)
	if not root.Parent then return end
	local theme = currentTheme()
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = theme.Color1
	part.Transparency = 0.15
	part.Size = Vector3.one
	part.CFrame = root.CFrame
	part.Parent = getFXFolder()

	TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = Vector3.new(size, size, size),
		Transparency = 1,
	}):Play()
	Debris:AddItem(part, duration + 0.05)
end

local function ring(root: BasePart, startSize: number, endSize: number, duration: number)
	if not root.Parent then return end
	local theme = currentTheme()
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Shape = Enum.PartType.Cylinder
	part.Material = Enum.Material.Neon
	part.Color = theme.Color2
	part.Transparency = 0.25
	part.Size = Vector3.new(0.08, startSize, startSize)
	part.CFrame = root.CFrame * CFrame.Angles(0, 0, math.rad(90))
	part.Parent = getFXFolder()

	TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.08, endSize, endSize),
		Transparency = 1,
	}):Play()
	Debris:AddItem(part, duration + 0.05)
end

local function particlePop(root: BasePart, amount: number)
	if not root.Parent then return end
	local theme = currentTheme()
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(theme.Color1, theme.Color2)
	emitter.LightEmission = 1
	emitter.Lifetime = NumberRange.new(0.2, 0.45)
	emitter.Speed = NumberRange.new(4, 12)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Rate = 0
	emitter.Parent = attachment
	emitter:Emit(amount)
	Debris:AddItem(attachment, 0.6)
end

-- ================================================================
-- TARGETING & DASH (no teleport — velocity dash, stops short, can whiff)
-- ================================================================

local function findClosestTarget(origin: Vector3, maxRange: number)
	local ownCharacter = LocalPlayer.Character
	if not ownCharacter then return nil end
	local best, bestDist = nil, maxRange
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character and plr.Character ~= ownCharacter then
			local root = plr.Character:FindFirstChild("HumanoidRootPart")
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				local dist = (root.Position - origin).Magnitude
				if dist < bestDist then
					bestDist = dist
					best = root
				end
			end
		end
	end
	return best
end

local function engineDash(targetRoot: BasePart, speed: number, duration: number, stopDistance: number)
	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then return false end
	if humanoid.Health <= 0 then return false end

	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.Parent = root

	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position = Vector3.new(-1, 0, 0)
	a1.Position = Vector3.new(1, 0, 0)
	a0.Parent = root
	a1.Parent = root

	local theme = currentTheme()
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.15
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(theme.Color1, theme.Color2)
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.Parent = root

	local started = os.clock()
	local reached = false

	while os.clock() - started < duration do
		if humanoid.Health <= 0 or not root.Parent or not targetRoot.Parent then break end
		local toTarget = targetRoot.Position - root.Position
		local dist = toTarget.Magnitude
		if dist <= stopDistance then
			reached = true
			break
		end
		local dir = toTarget.Unit
		velocity.VectorVelocity = Vector3.new(dir.X * speed, 0, dir.Z * speed)
		root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(dir.X, 0, dir.Z))
		RunService.Heartbeat:Wait()
	end

	pcall(function() velocity:Destroy() end)
	pcall(function() attachment:Destroy() end)
	pcall(function() a0:Destroy() end)
	pcall(function() a1:Destroy() end)
	pcall(function() trail:Destroy() end)
	if root.Parent then root.AssemblyLinearVelocity = Vector3.zero end

	return reached
end

-- ================================================================
-- M1
-- ================================================================

local lastM1 = 0
local m1Index = 0

local function creatorM1()
	local now = os.clock()
	if now - lastM1 < CFG.M1Cooldown then return end
	lastM1 = now

	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then return end
	if humanoid.Health <= 0 then return end

	local theme = currentTheme()
	local target = findClosestTarget(root.Position, CFG.M1DashRange)

	m1Index = (m1Index % 4) + 1

	if target then
		engineDash(target, CFG.M1DashSpeed, 0.22, 3.2)
	end

	playAnimation(humanoid, theme.Anim.M1[m1Index], 1.1, 0.35)
	burst(root, 3, 0.12)
	particlePop(root, 6)
end

