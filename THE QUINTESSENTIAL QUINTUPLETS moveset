-- Exploit-friendly music downloader + loop player
local musicUrl = "https://github.com/r4faelllaust/R4Fix/raw/refs/heads/main/5sis.mp3"
local localName = "5sis.mp3"

local function setupExploitAudio()
	local success = false
	-- try syn.request
	if syn and syn.request then
		pcall(function()
			local res = syn.request{Url=musicUrl, Method="GET"}
			if res and res.Body and res.StatusCode == 200 then
				writefile(localName, res.Body)
				success = true
			end
		end)
	end

	-- try http.request
	if not success and http and http.request then
		pcall(function()
			local res = http.request({Url = musicUrl, Method = "GET"})
			if res and res.Body then
				writefile(localName, res.Body)
				success = true
			end
		end)
	end

	-- fallback: write url literal (some runners accept this pattern)
	if not success then
		pcall(function() writefile(localName, musicUrl); success = true end)
	end

	-- create Sound and play via getcustomasset
	pcall(function()
		local char = Player.Character or Player.CharacterAdded:Wait()
		local s = Instance.new("Sound")
		s.Name = "R4Fix_Background"
		s.Looped = true
		s.Volume = 0.75
		if success and getcustomasset then
			s.SoundId = getcustomasset(localName)
		else
			-- fallback: if the file couldn't be downloaded, try to use the repo raw url (may not work in Roblox)
			s.SoundId = musicUrl
		end
		s.Parent = char
		s:Play()
	end)
end

-- run the exploit audio setup in spawn so it doesn't block
task.spawn(setupExploitAudio)

-- Tagging helper: mark created VFX so recolor only affects them
local function TagVFX(inst)
	pcall(function()
		if inst and typeof(inst.SetAttribute) == "function" then
			inst:SetAttribute("R4FixVFX", true)
		end
	end)
end

-- Patch existing VFX creation helpers to tag
local OldCyberBurst = CyberBurst
CyberBurst = function(position, size, color)
	local part = OldCyberBurst(position, size, color)
	-- OldCyberBurst didn't return the part; try to create new if needed
	-- We'll create our own burst to ensure tagging and return
	if part == nil then
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Material = Enum.Material.Neon
		p.Color = color or CYBER_YELLOW
		p.Transparency = 0.15
		p.Anchored = true
		p.CanCollide = false
		p.Size = Vector3.new(2,2,2)
		p.CFrame = CFrame.new(position)
		p.Parent = VFX_FOLDER
		local light = Instance.new("PointLight")
		light.Color = p.Color; light.Brightness = 4; light.Range = 15; light.Parent = p
		TweenService:Create(p, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = Vector3.new(size,size,size), Transparency = 1}):Play()
		Debris:AddItem(p, 1)
		TagVFX(p)
		return p
	else
		-- If original returned something, try to tag
		pcall(function() TagVFX(part) end)
		return part
	end
end

local OldCyberRing = CyberRing
CyberRing = function(position, size, color)
	local ring = OldCyberRing(position, size, color)
	if not ring then
		local r = Instance.new("Part")
		r.Shape = Enum.PartType.Cylinder
		r.Material = Enum.Material.Neon
		r.Color = color or GOLD
		r.Transparency = 0.25
		r.Anchored = true
		r.CanCollide = false
		r.Size = Vector3.new(0.2,5,5)
		r.CFrame = CFrame.new(position) * CFrame.Angles(0,0,math.rad(90))
		r.Parent = VFX_FOLDER
		TweenService:Create(r, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = Vector3.new(0.2, size, size), Transparency = 1}):Play()
		Debris:AddItem(r, 0.9)
		TagVFX(r)
		return r
	else
		pcall(function() TagVFX(ring) end)
		return ring
	end
end

-- Make recolor watcher only recolor tagged objects or local character/VFX folder descendants
-- override existing scan/makeYellow by checking the attribute
local OrigScan = scan
local function TaggedScan(object)
	if not object then return end
	pcall(function()
		if object:GetAttribute and object:GetAttribute("R4FixVFX") then
			makeYellow(object)
		elseif isLocalVFX(object) then
			makeYellow(object)
		else
			for _,child in ipairs(object:GetDescendants()) do
				if child:GetAttribute and child:GetAttribute("R4FixVFX") then makeYellow(child) end
				if isLocalVFX(child) then makeYellow(child) end
			end
		end
	end)
end

-- Replace watchers
Workspace.DescendantAdded:Connect(function(obj)
	task.defer(function()
		TaggedScan(obj)
		task.wait()
		if obj and obj.Parent then TaggedScan(obj.Parent) end
	end)
end)

