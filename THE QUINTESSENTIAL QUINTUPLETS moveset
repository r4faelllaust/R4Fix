-- ================================================================
-- ANIMATION REPLACEMENT
-- ================================================================


local function PlayAnimation(id)

    if not id then
        return
    end


    local anim = Instance.new("Animation")

    anim.AnimationId = "rbxassetid://" .. id


    local animator =
        humanoid:FindFirstChildOfClass("Animator")
        or humanoid:WaitForChild("Animator")


    local track =
        animator:LoadAnimation(anim)


    track:Play()


    return track

end



local function ReplaceAnimation(track)

    local current =
        track.Animation.AnimationId


    for _,move in pairs(Itsuki.Moves) do


        if current ==
        "rbxassetid://" .. move.Original then


            track:Stop()

            PlayAnimation(move.Animation)

        end

    end

end



humanoid.AnimationPlayed:Connect(function(track)

    ReplaceAnimation(track)

end)



