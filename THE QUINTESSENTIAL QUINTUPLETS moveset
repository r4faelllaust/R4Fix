-- ================================================================


local function findSlot(number)


	local hotbar =
		PlayerGui:FindFirstChild(
			"Hotbar"
		)



	if not hotbar then
		return
	end



	local backpack =
		hotbar:FindFirstChild(
			"Backpack"
		)



	if not backpack then
		return
	end



	local frame =
		backpack:FindFirstChild(
			"Hotbar"
		)



	if not frame then
		return
	end



	return frame:FindFirstChild(
		tostring(number)
	)


end





local function setMoveName(
	number,
	name
)


	local slot =
		findSlot(
			number
		)



	if not slot then
		return
	end



	local label =
		slot:FindFirstChild(
			"ToolName",
			true
		)



	if label
		and label:IsA("TextLabel")
	then


		label.Text =
			name


	end


end




