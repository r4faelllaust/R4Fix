local function updateCharacterTab()


	local topbar =
		PlayerGui:FindFirstChild(
			"TopbarPlus"
		)



	if not topbar then
		return
	end




	for _,obj in ipairs(
		topbar:GetDescendants()
	) do



		if obj:IsA("TextLabel") then


			if obj.Text == "Hero Hunter"
				or obj.Text == "Garou"
				or obj.Text == "Character"
			then


				obj.Text =
					MOVESET_NAME



			end

		end


	end


end




-- ================================================================
-- ULTIMATE BAR
-- ================================================================


local function updateUltimateBar()


	local bar =
		PlayerGui:FindFirstChild(
			"Bar"
		)



	if not bar then
		return
	end



	local magic =
		bar:FindFirstChild(
			"MagicHealth",
			true
		)



	if not magic then
		return
	end



	local label =
		magic:FindFirstChild(
			"TextLabel"
		)



	if label
		and label:IsA("TextLabel")
	then


		label.Text =
			"❤️ ITSUKI POWER ❤️"



		label.TextColor3 =
			RED


	end


end





