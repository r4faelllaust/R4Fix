-- ================================================================
-- LOCAL CHARACTER ONLY VFX COLOR OVERRIDE
-- ================================================================


local function ApplyGold(object)

	if not object then
		return
	end


	pcall(function()


		if object:IsA("Trail") then


			object.Color =
				GOLD_SEQUENCE

			object.LightEmission =
				1



		elseif object:IsA("ParticleEmitter") then


			object.Color =
				GOLD_SEQUENCE

			object.LightEmission =
				1



		elseif object:IsA("Beam") then


			object.Color =
				GOLD_SEQUENCE

			object.LightEmission =
				1



		elseif object:IsA("PointLight")
			or object:IsA("SpotLight")
			or object:IsA("SurfaceLight")
		then


			object.Color =
				GOLD



		elseif object:IsA("Highlight") then


			object.FillColor =
				GOLD

			object.OutlineColor =
				LIGHT_GOLD



		end


	end)

end




local function ScanCharacter()


	if not Character then
		return
	end


	for _,v in ipairs(
		Character:GetDescendants()
	) do

		ApplyGold(v)

	end


end




Character.DescendantAdded:Connect(function(object)


	task.wait()


	ApplyGold(object)


end)



