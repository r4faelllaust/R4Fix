-- ================================================================


local function findHotbarSlot(
	number
)


	local hotbar =
		PlayerGui:FindFirstChild(
			"Hotbar"
		)



	if not hotbar then
		return
	end



	local backpack =
		hotbar:FindFirstChild(
			"Backpack"
		)



	if not backpack then
		return
	end



	local frame =
		backpack:FindFirstChild(
			"Hotbar"
		)



	if not frame then
		return
	end



	local slot =
		frame:FindFirstChild(
			tostring(number)
		)



	if not slot then
		return
	end



	return slot:FindFirstChild(
		"Base"
	)
	or slot

end



local function styleSlot(
	number,
	name
)


	local slot =
		findHotbarSlot(
			number
		)



	if not slot then
		return
	end



	local text =
		slot:FindFirstChild(
			"ToolName"
		)



	if text
		and text:IsA(
			"TextLabel"
		)
	then


		text.Text =
			name



		text.TextColor3 =
			CONFIG.LightColor



		text.TextStrokeColor3 =
			CONFIG.MainColor



		text.TextStrokeTransparency =
			0

	end



	local stroke =
		slot:FindFirstChild(
			"ItsukiStroke"
		)



	if not stroke then


		stroke =
			Instance.new(
				"UIStroke"
			)


		stroke.Name =
			"ItsukiStroke"


		stroke.Thickness =
			2


		stroke.Color =
			CONFIG.MainColor


		stroke.Parent =
			slot


	end

end



local function refreshHotbar()


	if SESSION.IsUlted then


		styleSlot(
			1,
			"⭐ STARFALL JUDGMENT"
		)


		styleSlot(
			2,
