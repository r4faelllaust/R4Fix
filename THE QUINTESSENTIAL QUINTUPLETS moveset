-- ==========================================================
-- VFX COOLDOWN
-- ==========================================================

local function Allowed(
	key,
	cooldown
)


	local now =
		os.clock()


	if SESSION.LastVFX[key]
	and now - SESSION.LastVFX[key] < cooldown
	then

		return false

	end



	SESSION.LastVFX[key] =
		now


	return true

end



