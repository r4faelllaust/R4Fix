local function moves(id:string)
local r=root()
local c=Player.Character
if not r or not c then return end

if id==SLOT1 then
	burst(r.CFrame,14,YELLOW)
	ring(r.CFrame,30)
	sparks(r,45)

elseif id==SLOT2 then
	teleportStrike()

elseif id==SLOT3 then
	local target=nearest(100)
	if target and target.Character then
		local tr=target.Character:FindFirstChild("HumanoidRootPart")
		if tr and tr:IsA("BasePart") then
			for i=1,5 do
				task.delay(i*.07,function()
					if r.Parent then
						r.CFrame=tr.CFrame*CFrame.new(0,0,5)
						burst(r.CFrame,5+i*2,YELLOW)
						sparks(r,12)
					end
				end)
			end
		end
	end

elseif id==SLOT4 then
	overclock()
end

end

