-- R4Fix Persistent Loop Music

local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")

local Player = Players.LocalPlayer

local FileName = "R4Fix_5sis.mp3"
local URL = "https://github.com/r4faelllaust/R4Fix/raw/refs/heads/main/5sis.mp3"

-- Download/save the asset (executor environments only)
if not isfile(FileName) then
	writefile(FileName, game:HttpGet(URL))
end

-- Remove old copy if script runs again
local OldSound = SoundService:FindFirstChild("R4FixMusic")
if OldSound then
	OldSound:Destroy()
end

local Sound = Instance.new("Sound")
Sound.Name = "R4FixMusic"
Sound.Parent = SoundService
Sound.SoundId = getcustomasset(FileName)
Sound.Volume = 1
Sound.Looped = true
Sound.PlayOnRemove = false

-- Keep playing
Sound:Play()

-- Safety check if Roblox stops it
Sound.Ended:Connect(function()
	if Sound.Looped then
		Sound:Play()
	end
end)

-- Restart after character death
Player.CharacterAdded:Connect(function()
	task.wait(1)

	if not Sound.IsPlaying then
		Sound:Play()
	end
end)

print("R4Fix Music System Loaded")
