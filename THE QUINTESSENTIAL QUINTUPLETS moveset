local function cleanupCharacterConnections()
	for _, conn in ipairs(SESSION.CharacterConnections) do
		pcall(function() conn:Disconnect() end)
	end
	SESSION.CharacterConnections = {}
end

local function track(conn)
	if conn then
		table.insert(SESSION.CharacterConnections, conn)
	end
	return conn
end

local function getCurrentSister()
	return SISTERS[SESSION.CurrentSister]
end

local function getClosestEnemy()
	local char = LocalPlayer.Character
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end

	local closest, dist = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr \~= LocalPlayer and plr.Character then
			local enemyHRP = plr.Character:FindFirstChild("HumanoidRootPart")
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if enemyHRP and hum and hum.Health > 0 then
				local d = (hrp.Position - enemyHRP.Position).Magnitude
				if d < dist and d < 80 then
					dist = d
					closest = enemyHRP
				end
			end
		end
	end
	return closest
end

