-- ================================================================
-- IDLE SYSTEM
-- ================================================================


local function setupIdle(
	character,
	humanoid,
	token
)


	local animation =
		Instance.new(
			"Animation"
		)


	animation.AnimationId =
		IDLE_ANIMATION



	local idleTrack


	pcall(function()

		idleTrack =
			getAnimator(
				humanoid
			):LoadAnimation(
				animation
			)

	end)



	animation:Destroy()



	if idleTrack then


		idleTrack.Priority =
			Enum.AnimationPriority.Idle



		idleTrack.Looped =
			true


	end





	track(

		RunService.RenderStepped:Connect(

			function()


				if token
					~= SESSION.CharacterToken
				then

					return

				end



				if not character.Parent then
					return
				end



				local moving =
					humanoid.MoveDirection.Magnitude
					> 0.05



				if idleTrack then


					if moving then


						if idleTrack.IsPlaying then

							idleTrack:Stop(
								0.2
							)

						end



					else


						if not idleTrack.IsPlaying then

							idleTrack:Play(
								0.2
							)

						end


					end


				end



			end

		)

	)


end





-- ================================================================
