local function playAnim(hum, id, priority, speed, duration)
	if hum.Health <= 0 then return nil end
	local animator = getAnimator(hum)
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local success, track = pcall(function() return animator:LoadAnimation(anim) end)
	anim:Destroy()
	if not success or not track then return nil end
	
	track.Priority = priority or Enum.AnimationPriority.Action4
	track.Looped = false
	table.insert(S.Tracks, track)
	pcall(function() track:Play(0.05, 1, speed or 1) end)
	
	if duration then
		task.delay(duration, function()
			pcall(function() if track.IsPlaying then track:Stop(0.05) end end)
		end)
	end
	return track
end

-- ================================================================
-- TARGETING
-- ================================================================

local function findTarget(pos)
	local char = LocalPlayer.Character
	if not char then return nil end
	local live = Workspace:FindFirstChild("Live") or Workspace
	local best, bestDist = nil, CFG.TargetRange
	
	for _, obj in ipairs(live:GetChildren()) do
		if obj:IsA("Model") and obj ~= char then
			local hum = obj:FindFirstChildOfClass("Humanoid")
			local root = obj:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				local dist = (root.Position - pos).Magnitude
				if dist < bestDist then
					bestDist = dist
					best = obj
				end
			end
		end
	end
	return best
end

local function tpBehind(target)
	local char, hum, root = getChar()
	if not char or not hum or not root or hum.Health <= 0 then return false end
	
	local tRoot = target:FindFirstChild("HumanoidRootPart")
	local tHum = target:FindFirstChildOfClass("Humanoid")
	if not tRoot or not tHum or tHum.Health <= 0 then return false end
	
	if (root.Position - tRoot.Position).Magnitude > CFG.TargetRange then return false end
	
	local behind = tRoot.Position - tRoot.CFrame.LookVector * CFG.M1BehindDist
	behind = Vector3.new(behind.X, tRoot.Position.Y + 0.2, behind.Z)
	
	root.CFrame = CFrame.lookAt(behind, tRoot.Position)
	root.AssemblyLinearVelocity = Vector3.zero
	return true
end

-- ================================================================
-- VFX SYSTEM
