--============================================================

local function removeUltimateGui()
    if State.UltimateGui then
        safe(function()
            State.UltimateGui:Destroy()
        end)

        State.UltimateGui = nil
    end
end

local function createUltimateGui()
    removeUltimateGui()

    local gui = Instance.new("ScreenGui")

    gui.Name = "KJUltimatePresentation"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 10000

    local frame = Instance.new("Frame")

    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundColor3 = Color3.new(0, 0, 0)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.Parent = gui

    gui.Parent = player:WaitForChild("PlayerGui")

    State.UltimateGui = gui

    TweenService:Create(
        frame,
        TweenInfo.new(0.25),
        {
            BackgroundTransparency = 0.2
        }
    ):Play()

    task.delay(0.55, function()

        if not frame.Parent then
            return
        end

        TweenService:Create(
            frame,
            TweenInfo.new(0.4),
            {
                BackgroundTransparency = 1
            }
        ):Play()

    end)
end

local function ultimate()
    if not State.Enabled then
        return
    end

    if State.UltimateActive then
        return
    end

    if isCooldown("Ultimate") then
        return
    end

    startCooldown("Ultimate")

    State.UltimateActive = true
    State.Busy = true

    log("================================================")
    log("KJ ULTIMATE")
    log("================================================")

    local humanoid = getHumanoid()

    if humanoid then
        State.OriginalWalkSpeed = humanoid.WalkSpeed
        State.OriginalJumpPower = humanoid.JumpPower

        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
    end

    createUltimateGui()

    cameraFOV(55, 0.25)
    cameraShake(0.5, 4)

    tryDialogue("THIS WILL BE THE END.")

    playSound(CONFIG.CharacterSound, 1.3)

    local auraResource = getEverythingKJ()

    if auraResource then
        createAura()
    else
        warnKJ("Everything.KJ missing")
    end

    local wallCombo = getWallCombo()

    if wallCombo then

        local aura =
            findRecursive(wallCombo, "UserAura")

        if aura then
            cloneVFX(aura, 4)
        end

        local impact =
            findRecursive(wallCombo, "FinalImpact")

        if impact then
            cloneVFX(impact, 4)
        end

    end

    local ultimateAnimation =
        findAnimationByKeywords({
            "Awakening",
            "Ultimate",
            "KJ",
        })

    if ultimateAnimation then
        playResourceAnimation(ultimateAnimation)
    else
        log(
            "No accessible KJ Ultimate Animation instance found."
        )
    end

    task.delay(1.2, function()

        if not State.UltimateActive then
            return
        end

        cameraFOV(85, 0.3)
        cameraShake(0.3, 3)

        tryDialogue("KJ.")

        log("KJ ULTIMATE STATE ACTIVE")

    end)

    task.delay(CONFIG.UltimateDuration, function()

        if not State.UltimateActive then
            return
        end

        State.UltimateActive = false

        removeAura()
        removeUltimateGui()

        local currentHumanoid = getHumanoid()

        if currentHumanoid then

            currentHumanoid.WalkSpeed =
                State.OriginalWalkSpeed or 16

            currentHumanoid.JumpPower =
                State.OriginalJumpPower or 50

        end

        cameraFOV(70, 0.5)

        State.Busy = false

        log("KJ ULTIMATE ENDED")

    end)
end

