--============================================================
-- KJ RESOURCE PATHS
--============================================================

local function checkPath(path)
    local current = ReplicatedStorage

    for part in string.gmatch(path, "[^%.]+") do

        current = current and current:FindFirstChild(part)

        if not current then
            return nil
        end

    end

    return current
end

local function captureKnownResources()
    section("KNOWN KJ RESOURCE PATHS")

    local paths = {
        "Resources",
        "Resources.KJEffects",
        "Resources.KJThrow",
        "Resources.KJEffects.KJWallCombo",
        "Resources.UFW",
        "Resources.UFW.vfx",
        "Resources.UFW.vfx.Everything",
        "Resources.UFW.vfx.Everything.KJ",
        "Resources.UFW.vfx.PunchFX",
        "Resources.UFW.vfx.PunchFX.KJ",
        "Resources.UFW.BG",
        "Resources.UFW.BG.KJWallBreak",
        "Cutscenes",
        "Cutscenes.KJ",
        "Info",
        "Info.Walls",
        "Info.Walls.KJ Wall",
    }

    for _, path in ipairs(paths) do

        local obj = checkPath(path)

        if obj then
            line("FOUND: " .. path)
            line("CLASS: " .. getClass(obj))
            line("FULL PATH: " .. getFullName(obj))
        else
            line("NOT FOUND: " .. path)
        end

    end
end

