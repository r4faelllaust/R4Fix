--============================================================
-- ULTIMATE ACTIVATION
--============================================================

local function activateUltimate()
    if not state.Enabled then
        return
    end

    if state.Busy then
        return
    end

    if state.UltimateActive then
        return
    end

    if isOnCooldown("Ultimate") then
        return
    end

    state.Busy = true

    startCooldown(
        "Ultimate",
        CONFIG.Cooldowns.Ultimate
    )

    state.UltimateToken += 1

    local token =
        state.UltimateToken

    local character =
        state.Character

    local root =
        getRoot(character)

    if not root then
        state.Busy = false
        return
    end

    --========================================================
    -- CAMERA
    --========================================================

    local camera =
        getCamera()

    if camera then
        state.CameraOriginal =
            camera.FieldOfView
    end

    setFOV(
        55,
        0.45
    )

    flashScreen(
        0.5
    )

    cameraShake(
        0.75,
        2.5
    )

    --========================================================
    -- DIALOGUE
    --========================================================

    showKJDialogue(
        "THIS WILL BE THE LAST TIME."
    )

    task.delay(
        0.8,
        function()

            if token ~= state.UltimateToken then
                return
            end

            showKJDialogue(
                "KJ."
            )

        end
    )

    --========================================================
    -- ACTIVATION ANIMATION
    --========================================================

    playAnimation(
        CONFIG.Animations.UltimateActivate,
        Enum.AnimationPriority.Action4,
        1,
        0.05
    )

    playSound(
        CONFIG.Sounds.Character,
        2
    )

    --========================================================
    -- AURA
    --========================================================

    task.delay(
        0.4,
        function()

            if token ~= state.UltimateToken then
                return
            end

            createAura()

            local wallCombo =
                getWallCombo()

            if wallCombo then

                local userAura =
                    wallCombo:FindFirstChild(
                        "UserAura"
                    )

                if userAura then

                    for _, bodyPart in ipairs(
                        character:GetChildren()
                    ) do

                        if bodyPart:IsA("BasePart") then

                            for _, auraObject in ipairs(
                                userAura:GetChildren()
                            ) do

                                if
                                    auraObject:IsA(
                                        "ParticleEmitter"
                                    )
                                then

                                    local clone =
                                        auraObject:Clone()

                                    clone.Parent =
                                        bodyPart

                                    clone.Enabled = true

                                    clone:Emit(
                                        math.max(
                                            1,
                                            math.floor(
                                                clone.Rate
                                                * 0.15
                                            )
                                        )
                                    )

                                    table.insert(
                                        state.Effects,
                                        clone
                                    )

                                end

                            end

                        end

                    end

                end

            end

        end
    )

    --========================================================
    -- ULTIMATE STATE
    --========================================================

    task.delay(
        1.8,
        function()

            if token ~= state.UltimateToken then
                return
            end

            if not state.Enabled then
                return
            end

            state.Busy = false
            state.UltimateActive = true

            setFOV(
                78,
                0.5
            )

            showKJDialogue(
                "YOU'RE FINISHED."
            )

            cameraShake(
                0.8,
                3
            )

        end
    )

    --========================================================
    -- AUTOMATIC END
    --========================================================

    task.delay(
        CONFIG.UltimateDuration + 1.8,
        function()

            if token ~= state.UltimateToken then
                return
            end

            if state.UltimateActive then
                state.UltimateActive = false
            end

            setFOV(
                state.CameraOriginal
                    or 70,
                0.5
            )

            clearAura()

        end
    )
end

