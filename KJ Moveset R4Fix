function enableKJ()

    if state.Enabled then
        return
    end

    local now =
        tick()

    if now - state.LastSwitch
        < CONFIG.SwitchCooldown then

        notify(
            "BENACHRICHTIGUNG",
            "Du änderst deinen Charakter zu schnell.",
            2
        )

        return
    end

    state.LastSwitch =
        now

    state.Enabled =
        true

    state.UltimateActive =
        false

    state.Busy =
        false

    state.CurrentAction =
        nil

    notify(
        "KJ",
        "KJ equipped.",
        2
    )

    refreshCharacter()

    updateHotbar()

    if state.Character then
        setupCharacter(
            state.Character
        )
    end

    task.delay(
        0.1,
        function()

            if not state.Enabled then
                return
            end

            keepKJVisible()
            connectKJTopbar()

        end
    )

end

--============================================================
-- DISABLE KJ
--============================================================

local function disableKJ()

    if not state.Enabled then
        return
    end

    state.Enabled =
        false

    state.UltimateActive =
        false

    state.Busy =
        false

    state.CurrentAction =
        nil

    clearDelayedTasks()

    disconnectCharacter()

    disableAura()

    restoreFOV()

    for _, track in ipairs(
        state.Tracks
    ) do

        stopTrack(track)

    end

    table.clear(
        state.Tracks
    )

    for _, sound in ipairs(
        state.Sounds
    ) do

        pcall(function()
            sound:Stop()
            sound:Destroy()
        end)

    end

    table.clear(
        state.Sounds
    )

    for _, effect in ipairs(
        state.Effects
    ) do

        pcall(function()

            if effect
                and effect.Parent then

                effect:Destroy()

            end

        end)

    end

    table.clear(
        state.Effects
    )

    restoreHotbar()

    notify(
        "KJ",
        "KJ disabled.",
        2
    )

end

