local function getCamera()

    return workspace.CurrentCamera

end

local function setFOV(
    value,
    duration
)

    local camera =
        getCamera()

    if not camera then
        return
    end

    if State.CameraFOV == nil then
        State.CameraFOV =
            camera.FieldOfView
    end

    TweenService:Create(
        camera,
        TweenInfo.new(
            duration or 0.2,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            FieldOfView = value
        }
    ):Play()

end

local function restoreFOV()

    local camera =
        getCamera()

    if not camera then
        return
    end

    local target =
        State.CameraFOV
        or CONFIG.NormalFOV

    TweenService:Create(
        camera,
        TweenInfo.new(
            0.35,
            Enum.EasingStyle.Quad
        ),
        {
            FieldOfView = target
        }
    ):Play()

    State.CameraFOV = nil

end

--============================================================
-- CAMERA SHAKE
--============================================================

local Shake = {
    Connection = nil,
    EndTime = 0,
    Power = 0,
}

local function cameraShake(
    power,
    duration
)

    Shake.Power =
        math.max(
            Shake.Power,
            power
        )

    Shake.EndTime =
        math.max(
            Shake.EndTime,
            os.clock() + duration
        )

    if Shake.Connection then
        return
    end

    Shake.Connection =
        RunService.RenderStepped:Connect(
            function()

                if os.clock()
                    >= Shake.EndTime then

                    disconnect(
                        Shake.Connection
                    )

                    Shake.Connection =
                        nil

                    Shake.Power = 0

                    return

                end

                local camera =
                    getCamera()

                if not camera then
                    return
                end

                local power =
                    Shake.Power

                local x =
                    (math.random() - 0.5)
                    * power

                local y =
                    (math.random() - 0.5)
                    * power

                local z =
                    (math.random() - 0.5)
                    * power

                camera.CFrame =
                    camera.CFrame
                    * CFrame.Angles(
                        math.rad(x),
                        math.rad(y),
                        math.rad(z)
                    )

            end
        )

end

