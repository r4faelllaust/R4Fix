local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local results = {}
local seen = {}

local keywords = {
    "KJ",
    "onActivated",
    "Character",
    "Selection",
    "SelectCharacter",
    "CharacterSelect",
    "Moveset",
    "Dropdown",
    "Topbar",
    "Switch",
    "Equip"
}

local function matches(text)
    text = string.lower(tostring(text))

    for _, keyword in ipairs(keywords) do
        if string.find(text, string.lower(keyword), 1, true) then
            return true
        end
    end

    return false
end

local function add(text)
    if not text or text == "" then
        return
    end

    if seen[text] then
        return
    end

    seen[text] = true
    table.insert(results, text)
end

local function scan(obj)
    local fullName

    pcall(function()
        fullName = obj:GetFullName()
    end)

    if not fullName then
        return
    end

    if matches(fullName) then
        add(
            "[OBJECT]\n" ..
            fullName ..
            "\nClass: " ..
            obj.ClassName
        )
    end

    pcall(function()
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if matches(obj.Text) then
                add(
                    "[TEXT]\n" ..
                    fullName ..
                    "\nClass: " ..
                    obj.ClassName ..
                    "\nText: " ..
                    tostring(obj.Text)
                )
            end
        elseif obj:IsA("StringValue") then
            if matches(obj.Value) then
                add(
                    "[STRING]\n" ..
                    fullName ..
                    "\nValue: " ..
                    tostring(obj.Value)
                )
            end
        end
    end)
end

print("KJ scanner started...")

local roots = {
    game:GetService("ReplicatedStorage"),
    playerGui,
    player:WaitForChild("PlayerScripts")
}

for _, root in ipairs(roots) do
    scan(root)

    for _, obj in ipairs(root:GetDescendants()) do
        scan(obj)
    end
end

local output = {}

table.insert(output, "============================================================")
table.insert(output, "KJ CHARACTER SYSTEM SCAN")
table.insert(output, "============================================================")
table.insert(output, "Player: " .. player.Name)
table.insert(output, "Results: " .. #results)
table.insert(output, "")

for _, result in ipairs(results) do
    table.insert(output, result)
    table.insert(output, "\n------------------------------------------------------------")
end

table.insert(output, "")
table.insert(output, "============================================================")
table.insert(output, "END SCAN")
table.insert(output, "============================================================")

local final = table.concat(output, "\n")

print(final)

--------------------------------------------------
-- TRY MULTIPLE CLIPBOARD METHODS
--------------------------------------------------

local copied = false

local clipboardFunctions = {
    function()
        if setclipboard then
            setclipboard(final)
            return true
        end
    end,

    function()
        if toclipboard then
            toclipboard(final)
            return true
        end
    end,

    function()
        if set_clipboard then
            set_clipboard(final)
            return true
        end
    end,

    function()
        if writeclipboard then
            writeclipboard(final)
            return true
        end
    end
}

for _, method in ipairs(clipboardFunctions) do
    local success, result = pcall(method)

    if success and result then
        copied = true
        break
    end
end

--------------------------------------------------
-- FALLBACK: VISIBLE COPY BOX
--------------------------------------------------

local old = playerGui:FindFirstChild("KJScanResult")

if old then
    old:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "KJScanResult"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0.9, 0, 0.75, 0)
frame.Position = UDim2.new(0.05, 0, 0.12, 0)
frame.BackgroundTransparency = 0.05
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 45)
title.BackgroundTransparency = 1
title.Text = copied and "KJ SCAN, COPIED" or "KJ SCAN, SELECT ALL + COPY"
title.TextScaled = true
title.Parent = frame

local box = Instance.new("TextBox")
box.Size = UDim2.new(0.95, 0, 0.82, 0)
box.Position = UDim2.new(0.025, 0, 0.1, 0)
box.MultiLine = true
box.ClearTextOnFocus = false
box.TextXAlignment = Enum.TextXAlignment.Left
box.TextYAlignment = Enum.TextYAlignment.Top
box.TextWrapped = false
box.TextEditable = true
box.Text = final
box.Parent = frame

--------------------------------------------------
-- NOTIFICATION
--------------------------------------------------

pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "KJ Scanner",
        Text = copied
            and "Scan copied to clipboard."
            or "Clipboard API unavailable. Use the text box.",
        Duration = 5
    })
end)

print("========================================")
if copied then
    print("CLIPBOARD COPY SUCCESSFUL")
else
    print("CLIPBOARD API NOT AVAILABLE")
    print("USE THE VISIBLE TEXT BOX INSTEAD")
end
print("========================================")
