------------------------------------------------------------
-- ANIMATOR
------------------------------------------------------------

local function getAnimator()

    if not State.Humanoid then
        return nil
    end

    local animator =
        State.Humanoid:FindFirstChildOfClass(
            "Animator"
        )

    if not animator then

        animator =
            Instance.new("Animator")

        animator.Parent =
            State.Humanoid

    end

    return animator

end

------------------------------------------------------------
-- PLAY ANIMATION
------------------------------------------------------------

local function playAnimation(
    animationId,
    speed,
    fade
)

    if not State.Active then
        return nil
    end

    local animator =
        getAnimator()

    if not animator then
        return nil
    end

    local animation =
        Instance.new("Animation")

    animation.AnimationId =
        animationId

    local success, track =
        pcall(function()

            return animator:LoadAnimation(
                animation
            )

        end)

    safeDestroy(animation)

    if not success or not track then

        warn(
            "[KJ] Could not load animation:",
            animationId
        )

        return nil
    end

    track.Priority =
        Enum.AnimationPriority.Action

    track.Looped = false

    pcall(function()
        track:Play(fade or 0.1)
    end)

    if speed then

        pcall(function()
            track:AdjustSpeed(speed)
        end)

    end

    table.insert(
        State.Tracks,
        track
    )

    return track

end

------------------------------------------------------------
-- STOP ANIMATIONS
------------------------------------------------------------

local function stopAnimations()

    for _, track in ipairs(State.Tracks) do

        pcall(function()
            track:Stop(0.1)
            track:Destroy()
        end)

    end

    table.clear(State.Tracks)

end

------------------------------------------------------------
-- SOUND
------------------------------------------------------------

local function playSound(
    soundId,
    volume,
    speed
)

    if not State.Root then
        return
    end

    local sound =
        Instance.new("Sound")

    sound.SoundId = soundId

    sound.Volume =
        volume or 1

    sound.PlaybackSpeed =
        speed or 1

    sound.RollOffMaxDistance =
        120

    sound.Parent =
        State.Root

    sound:Play()

    table.insert(
        State.Temporary,
        sound
    )

    sound.Ended:Connect(function()

        safeDestroy(sound)

    end)

    return sound

end

------------------------------------------------------------
-- RESOURCE FINDER
------------------------------------------------------------

local function findPath(
    root,
    path
)

    local current = root

    for _, name in ipairs(path) do

        if not current then
            return nil
        end

        current =
            current:FindFirstChild(name)

    end

    return current

end

