local function updateUltimateBar()

    if not State.UltimateGui
        or not State.UltimateGui.Parent then

        if State.Enabled then
            createUltimateBar()
        else
            return
        end

    end

    local holder =
        State.UltimateGui
        :FindFirstChild(
            "Holder"
        )

    if not holder then
        return
    end

    local back =
        holder:FindFirstChild(
            "Back"
        )

    if not back then
        return
    end

    local fill =
        back:FindFirstChild(
            "Fill"
        )

    local value =
        back:FindFirstChild(
            "Value"
        )

    if not fill or not value then
        return
    end

    local percent =
        math.clamp(
            State.UltimateValue
            / CONFIG.UltimateMax,
            0,
            1
        )

    TweenService:Create(
        fill,
        TweenInfo.new(
            0.12,
            Enum.EasingStyle.Quad
        ),
        {
            Size =
                UDim2.fromScale(
                    percent,
                    1
                )
        }
    ):Play()

    value.Text =
        tostring(
            math.floor(
                State.UltimateValue
            )
        ) .. "%"

    if State.UltimateActive then

        value.Text =
            "KJ AWAKENED"

    end

end

local function addUltimate(value)

    if State.UltimateActive then
        return
    end

    State.UltimateValue =
        math.clamp(
            State.UltimateValue
            + value,
            0,
            CONFIG.UltimateMax
        )

    updateUltimateBar()

end

