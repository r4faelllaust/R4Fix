--============================================================
-- BASE GAME ANIMATION INTERCEPTION
--============================================================

-- These are the base animation IDs from the previous
-- implementation.
--
-- They are ONLY used as input signals.
-- The script stops the base animation locally and substitutes
-- the KJ presentation.
--============================================================

local BASE_ANIMATIONS = {

    ["10468665991"] = move1,
    ["10466974800"] = move2,
    ["10471336737"] = move3,
    ["12510170988"] = move4,

    ["15955393872"] = wallCombo,

    ["11343318134"] = ultimateMove1,
    ["11365563255"] = ultimateMove2,
    ["13927612951"] = ultimateMove3,

    ["12447707844"] = startUltimate,

    ["10469493270"] = performM1,
    ["10469630950"] = performM1,
    ["10469639222"] = performM1,
    ["10469643643"] = performM1,

    ["17859015788"] = performM1,
}

local function onAnimationPlayed(track)

    if not state.Enabled then
        return
    end

    local id =
        getAnimationId(track)

    if not id then
        return
    end

    local key =
        tostring(id)

    local callback =
        BASE_ANIMATIONS[key]

    if not callback then
        return
    end

    -- Prevent the same animation event from being
    -- intercepted repeatedly.
    local now =
        tick()

    if state.LastAnimationId == key
        and now - state.LastAnimationTime < 0.08 then

        return
    end

    state.LastAnimationId =
        key

    state.LastAnimationTime =
        now

    pcall(function()
        track:Stop(0.02)
    end)

    task.defer(function()

        if state.Enabled then
            pcall(callback)
        end

    end)

end

