--============================================================
-- UTILITIES
--============================================================

local function disconnect(connection)
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
	end
end

local function disconnectList(list)
	for i, connection in ipairs(list) do
		disconnect(connection)
		list[i] = nil
	end
end

local function destroyObject(object)
	if object then
		pcall(function()
			object:Destroy()
		end)
	end
end

local function trackConnection(connection, list)
	table.insert(list or State.Connections, connection)
	return connection
end

local function trackEffect(object)
	if object then
		table.insert(State.Effects, object)
	end

	return object
end

local function trackAnimation(track)
	if track then
		table.insert(State.Animations, track)
	end

	return track
end

local function trackSound(sound)
	if sound then
		table.insert(State.Sounds, sound)
	end

	return sound
end

--============================================================
-- RECURSIVE RESOURCE SEARCH
--============================================================

local function findRecursive(root, name)
	if not root then
		return nil
	end

	local direct = root:FindFirstChild(name, true)

	return direct
end

local function findAllRecursive(root, name)
	local results = {}

	if not root then
		return results
	end

	for _, object in ipairs(root:GetDescendants()) do
		if object.Name == name then
			table.insert(results, object)
		end
	end

	return results
end

--============================================================
-- CHARACTER
--============================================================

local function getCharacter()
	local character = player.Character

	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return nil
	end

	return character, humanoid, root
end

local function refreshCharacterReferences()
	local character, humanoid, root = getCharacter()

	State.Character = character
	State.Humanoid = humanoid
	State.RootPart = root

	return character, humanoid, root
end

