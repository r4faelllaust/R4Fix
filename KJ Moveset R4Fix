-- TOPBAR CONNECTION
--============================================================

local connectedTopbarObject

local function connectKJTopbar()

    local kj =
        findKJTopbarObject()

    if not kj then
        return
    end

    if connectedTopbarObject == kj
        and state.TopbarConnection then

        return

    end

    disconnect(
        state.TopbarConnection
    )

    state.TopbarConnection = nil

    local button =
        getClickableGui(kj)

    if not button then
        return
    end

    connectedTopbarObject =
        kj

    state.TopbarConnection =
        button.Activated:Connect(
            function()

                if state.Enabled then
                    notify(
                        "KJ",
                        "KJ is already equipped.",
                        2
                    )

                    return
                end

                enableKJ()

            end
        )

end

