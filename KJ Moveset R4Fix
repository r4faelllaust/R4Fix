local function getDialogueModule()
    local ufw = getUFW()

    if not ufw then
        return nil
    end

    return ufw:FindFirstChild("TekrinnDialogue")
end

local function tryNativeDialogue(text)
    local module = getDialogueModule()

    if not module then
        return false
    end

    local loaded = safe(function()
        return require(module)
    end, nil)

    if not loaded then
        return false
    end

    if type(loaded) ~= "table" then
        return false
    end

    if type(loaded.Speak) ~= "function" then
        return false
    end

    local color =
        ColorSequence.new({
            ColorSequenceKeypoint.new(
                0,
                Color3.fromRGB(0, 0, 0)
            ),

            ColorSequenceKeypoint.new(
                0.5,
                Color3.fromRGB(255, 17, 17)
            ),

            ColorSequenceKeypoint.new(
                1,
                Color3.fromRGB(255, 255, 255)
            ),
        })

    local success = safe(function()

        loaded.Speak({

            {
                Text = text,

                Bold = true,

                Italic = false,

                TypeSpeed = 0.025,

                Color = color,

                TextStrokeColor =
                    Color3.new(0, 0, 0),

                Shake = {
                    Enabled = true,
                    Intensity = 1,
                    Lifetime = 1.2,
                },
            },

        })

        return true

    end, false)

    return success
end

--============================================================
-- DIALOGUE FALLBACK
--============================================================

local function findTextLabel(root)
    if not root then
        return nil
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("TextLabel") then

            local lower =
                string.lower(object.Name)

            if
                lower == "text"
                or lower == "dialogue"
                or lower == "message"
                or lower == "content"
            then
                return object
            end

        end

    end

    return nil
end

local function showKJDialogue(text)
    if tryNativeDialogue(text) then
        return
    end

    local ufw = getUFW()

    if not ufw then
        return
    end

    local template =
        ufw:FindFirstChild("KJDialogue", true)

    if not template or not template:IsA("ScreenGui") then
        return
    end

    local playerGui =
        player:FindFirstChild("PlayerGui")

    if not playerGui then
        return
    end

    local gui = template:Clone()

    gui.Name = player.Name .. "KJUI"

    gui.ResetOnSpawn = false
    gui.Enabled = true

    gui.Parent = playerGui

    state.DialogueGui = gui

    local label = findTextLabel(gui)

    if not label then
        task.delay(
            4,
            function()
                destroyInstance(gui)
            end
        )

        return
    end

    label.Text = ""

    task.spawn(function()

        for i = 1, #text do

            if not gui.Parent then
                return
            end

            label.Text =
                string.sub(text, 1, i)

            task.wait(0.025)

        end

        task.wait(2)

        destroyInstance(gui)

        if state.DialogueGui == gui then
            state.DialogueGui = nil
        end

    end)
end

