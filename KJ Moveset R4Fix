------------------------------------------------------------
-- ULTIMATE
------------------------------------------------------------

local function ultimate()
    if not KJ.Active then
        return
    end

    if KJ.Busy then
        return
    end

    if onCooldown("Ultimate") then
        return
    end

    KJ.Busy = true
    KJ.CurrentMove = "Ultimate"

    setCooldown("Ultimate", 15)

    task.spawn(function()

        ----------------------------------------------------
        -- START
        ----------------------------------------------------

        playSound(CONFIG.Sounds.Character, 1.5)

        local oldSpeed = KJ.Humanoid and KJ.Humanoid.WalkSpeed

        if KJ.Humanoid then
            KJ.Humanoid.WalkSpeed = 0
        end

        playResource("hold", 2)

        fovPunch(20, 0.5)

        cameraShake(1.5, 0.5)

        ----------------------------------------------------
        -- CHARGE
        ----------------------------------------------------

        task.wait(1)

        playResource("UserAura", 2)

        if KJ.Aura then
            enableParticles(KJ.Aura, true)
        end

        playSound(
            CONFIG.Sounds.Character,
            1.8,
            0.8
        )

        task.wait(1)

        ----------------------------------------------------
        -- IMPACT
        ----------------------------------------------------

        playSound(
            CONFIG.Sounds.Hit,
            2,
            0.7
        )

        playResource("FinalImpact", 3)
        playResource("FinalImpactHUGEignore", 3)

        playResource("SPINNNN", 2)
        playResource("tpthing", 2)

        fovPunch(30, 0.7)
        cameraShake(8, 0.7)

        ----------------------------------------------------
        -- SLAM
        ----------------------------------------------------

        task.wait(0.65)

        playResource("slam", 2)
        playResource("feet", 1)
        playResource("speedlines", 1)

        cameraShake(6, 0.5)

        ----------------------------------------------------
        -- FINISH
        ----------------------------------------------------

        task.wait(1)

        playResource("FinalImpact", 2)

        fovPunch(12, 0.4)
        cameraShake(4, 0.4)

        task.wait(0.8)

        if KJ.Humanoid and KJ.Humanoid.Parent then
            KJ.Humanoid.WalkSpeed = oldSpeed or CONFIG.WalkSpeed
        end

        KJ.CurrentMove = nil
        KJ.Busy = false
    end)
end

------------------------------------------------------------
-- KJ ACTIVATION
------------------------------------------------------------

local function deactivateKJ()
    if not KJ.Active then
        return
    end

    KJ.Active = false
    KJ.Busy = false
    KJ.CurrentMove = nil

    stopTracks()
    removeAura()

    for _, object in ipairs(KJ.Temporary) do
        safeDestroy(object)
    end

    table.clear(KJ.Temporary)

    if KJ.Humanoid and KJ.Humanoid.Parent then
        if KJ.OriginalWalkSpeed then
            KJ.Humanoid.WalkSpeed = KJ.OriginalWalkSpeed
        end

        if KJ.OriginalJumpPower then
            KJ.Humanoid.JumpPower = KJ.OriginalJumpPower
        end
    end

    print("[KJ] Deactivated")
end

local function activateKJ()
    if KJ.Active then
        return
    end

    if not setupCharacter() then
        return
    end

    KJ.Active = true

    KJ.OriginalWalkSpeed = KJ.Humanoid.WalkSpeed
    KJ.OriginalJumpPower = KJ.Humanoid.JumpPower

    KJ.Humanoid.WalkSpeed = CONFIG.WalkSpeed
    KJ.Humanoid.JumpPower = CONFIG.JumpPower

    createAura()

    playSound(CONFIG.Sounds.Character, 1)

    print("[KJ] Activated")
    print("[KJ] 1 = Wall Combo")
    print("[KJ] 2 = Barrage")
    print("[KJ] 3 = Uppercut")
    print("[KJ] 4 = Finisher")
    print("[KJ] G = Ultimate")
end

local function toggleKJ()
    if KJ.Active then
        deactivateKJ()
    else
        activateKJ()
    end
end

------------------------------------------------------------
-- INPUT
------------------------------------------------------------

addConnection(
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if input.KeyCode == CONFIG.Keybinds.Toggle then
            toggleKJ()
            return
        end

        if not KJ.Active then
            return
        end

        if input.KeyCode == CONFIG.Keybinds.Move1 then
            move1WallCombo()

        elseif input.KeyCode == CONFIG.Keybinds.Move2 then
            move2Barrage()

        elseif input.KeyCode == CONFIG.Keybinds.Move3 then
            move3Uppercut()

        elseif input.KeyCode == CONFIG.Keybinds.Move4 then
            move4Finisher()

        elseif input.KeyCode == CONFIG.Keybinds.Ultimate then
            ultimate()
        end
    end)
)

