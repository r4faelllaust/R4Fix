local function isOnCooldown(name)
    local expires = state.Cooldowns[name]

    if not expires then
        return false
    end

    if os.clock() >= expires then
        state.Cooldowns[name] = nil
        return false
    end

    return true
end

local function startCooldown(name, duration)
    state.Cooldowns[name] =
        os.clock() + duration
end

