------------------------------------------------------------
-- CAMERA EFFECT
------------------------------------------------------------

local function cameraImpact(strength, duration)

    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    strength = strength or 1

    duration = duration or 0.25

    local start = os.clock()

    local connection

    connection = RunService.RenderStepped:Connect(function()

        if os.clock() - start >= duration then

            disconnect(connection)

            return

        end

        if not camera then
            return
        end

        local remaining =
            1 - ((os.clock() - start) / duration)

        local x =
            (math.random() - 0.5)
            * strength
            * remaining

        local y =
            (math.random() - 0.5)
            * strength
            * remaining

        local z =
            (math.random() - 0.5)
            * strength
            * remaining

        camera.CFrame =
            camera.CFrame
            * CFrame.new(x, y, z)

    end)

end


------------------------------------------------------------
-- FOV EFFECT
------------------------------------------------------------

local function tweenFOV(target, time)

    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local tween = TweenService:Create(
        camera,
        TweenInfo.new(
            time or 0.3,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {
            FieldOfView = target
        }
    )

    tween:Play()

end


