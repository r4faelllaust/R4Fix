local NormalNames = {
    [1] = "Ravage",
    [2] = "Swift Sweep",
    [3] = "Collateral Ruin",
    [4] = "20-20-20 Dropkick",
}

local UltimateNames = {
    [1] = "20 Series",
    [2] = "Stoic Bomb",
    [3] = "Five Seasons",
    [4] = "Unlimited Flexworks",
}

local function getHotbar()

    local hotbar =
        playerGui:FindFirstChild("Hotbar")

    if not hotbar then
        return nil
    end

    local backpack =
        hotbar:FindFirstChild("Backpack")

    if not backpack then
        return nil
    end

    return backpack:FindFirstChild("Hotbar")
end

local function getHotbarBase(index)

    local hotbar =
        getHotbar()

    if not hotbar then
        return nil
    end

    local slot =
        hotbar:FindFirstChild(
            tostring(index)
        )

    if not slot then
        return nil
    end

    return slot:FindFirstChild("Base")
end

local function updateHotbar()

    for i = 1, 4 do

        local base =
            getHotbarBase(i)

        if not base then
            continue
        end

        local label =
            base:FindFirstChild("ToolName")

        if not label
            or not label:IsA("TextLabel") then
            continue
        end

        if state.OriginalHotbarNames[i] == nil then

            state.OriginalHotbarNames[i] =
                label.Text

        end

        local names =
            state.UltimateActive
            and UltimateNames
            or NormalNames

        label.Text =
            names[i]

    end

end

