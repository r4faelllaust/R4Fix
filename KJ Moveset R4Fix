--!strict
--[[
	KJ Moveset - Improved
	Forces KJ button visible + activates real KJ resources when selected
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local State = {
	KJActive = false,
	Connections = {},
	CharConnections = {},
	Effects = {},
	Aura = nil,
	LastCharacter = nil,
}

local function track(conn, list)
	list = list or State.Connections
	table.insert(list, conn)
	return conn
end

local function cleanup(list)
	for _, c in ipairs(list) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(list)
end

local function clearEffects()
	for _, obj in ipairs(State.Effects) do
		pcall(function() obj:Destroy() end)
	end
	table.clear(State.Effects)
	if State.Aura then
		pcall(function() State.Aura:Destroy() end)
		State.Aura = nil
	end
end

----------------------------------------------------------------
-- RESOURCE HELPERS
----------------------------------------------------------------
local function getKJEffects()
	local res = ReplicatedStorage:FindFirstChild("Resources")
	return res and res:FindFirstChild("KJEffects")
end

local function getEverythingKJ()
	local res = ReplicatedStorage:FindFirstChild("Resources")
	local ufw = res and res:FindFirstChild("UFW")
	local vfx = ufw and ufw:FindFirstChild("vfx")
	local everything = vfx and vfx:FindFirstChild("Everything")
	return everything and everything:FindFirstChild("KJ")
end

local function cloneFX(source, parent, lifetime)
	if not source then return nil end
	local c = source:Clone()
	c.Parent = parent
	table.insert(State.Effects, c)
	if lifetime then
		Debris:AddItem(c, lifetime)
	end
	return c
end

local function emitAll(root)
	if not root then return end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("ParticleEmitter") then
			pcall(function()
				d.Enabled = true
				d:Emit(12)
			end)
		end
	end
end

----------------------------------------------------------------
-- KEEP KJ BUTTON VISIBLE (dein Code verbessert)
----------------------------------------------------------------
local function keepKJVisible()
	local topbar = PlayerGui:FindFirstChild("TopbarPlus")
	if not topbar then return end

	local container = topbar:FindFirstChild("TopbarContainer")
	if not container then return end

	local unnamedIcon = container:FindFirstChild("UnnamedIcon")
	if not unnamedIcon then return end

	local dropdown = unnamedIcon:FindFirstChild("DropdownContainer")
	if not dropdown then return end

	local frame = dropdown:FindFirstChild("DropdownFrame")
	if not frame then return end

	local kj = frame:FindFirstChild("KJ")
	if not kj then return end

	kj.Visible = true
	if kj:IsA("GuiButton") or kj:IsA("TextButton") or kj:IsA("ImageButton") then
		kj.Active = true
		kj.Selectable = true
	end

	-- Also force any child labels
	for _, child in ipairs(kj:GetDescendants()) do
		if child:IsA("GuiObject") then
			child.Visible = true
		end
	end
end

----------------------------------------------------------------
-- DETECT KJ SELECTION
----------------------------------------------------------------
local function isKJSelected()
	-- Method 1: Check Topbar label
	local topbar = PlayerGui:FindFirstChild("TopbarPlus")
	if topbar then
		for _, desc in ipairs(topbar:GetDescendants()) do
			if desc.Name == "IconLabel" and desc:IsA("TextLabel") then
				local text = desc.Text:lower()
				if text == "kj" then
					return true
				end
			end
		end
	end
	return false
end

----------------------------------------------------------------
-- AURA
----------------------------------------------------------------
local function applyKJAura(character)
	clearEffects()
	local source = getEverythingKJ()
	if not source then
		warn("[KJ] Everything.KJ not found")
		return
	end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local aura = source:Clone()
	aura.Name = "KJ_ClientAura"
	aura.Parent = character

	local surface = aura:FindFirstChild("Surface")
	if surface and surface:IsA("BasePart") then
		surface.Anchored = false
		surface.CanCollide = false
		surface.Massless = true

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hrp
		weld.Part1 = surface
		weld.Parent = surface

		-- Enable particles
		for _, d in ipairs(aura:GetDescendants()) do
			if d:IsA("ParticleEmitter") then
				d.Enabled = true
			end
		end
	end

	State.Aura = aura
	table.insert(State.Effects, aura)
end

----------------------------------------------------------------
-- VFX PLAYERS
----------------------------------------------------------------
local function playFromWallCombo(name, hrp, lifetime)
	local effects = getKJEffects()
	if not effects then return end
	local wall = effects:FindFirstChild("KJWallCombo")
	if not wall then return end
	local part = wall:FindFirstChild(name)
	if not part then return end

	local clone = cloneFX(part, workspace, lifetime or 2)
	if clone and clone:IsA("BasePart") then
		clone.CFrame = hrp.CFrame
		clone.Anchored = true
		emitAll(clone)
	elseif clone then
		emitAll(clone)
	end
end

----------------------------------------------------------------
-- MOVES (Saitama animation intercept)
----------------------------------------------------------------
local function setupMoves(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then return end

	track(humanoid.AnimationPlayed:Connect(function(track)
		if not State.KJActive then return end
		if not track.Animation then return end

		local id = track.Animation.AnimationId

		-- Very broad detection for now (Saitama moves)
		-- We will refine IDs later
		if id:find("12273") or id:find("12296") or id:find("12309") or id:find("12351") or id:find("184479") then
			-- Play KJ VFX on any major move
			playFromWallCombo("hold", hrp, 1.5)
			task.delay(0.25, function()
				if hrp and hrp.Parent then
					playFromWallCombo("slam", hrp, 1.8)
				end
			end)
			task.delay(0.55, function()
				if hrp and hrp.Parent then
					playFromWallCombo("FinalImpact", hrp, 2.2)
				end
			end)
		end
	end), State.CharConnections)
end

----------------------------------------------------------------
-- ACTIVATE / DEACTIVATE
----------------------------------------------------------------
local function activateKJ(character)
	if State.KJActive and State.LastCharacter == character then return end

	State.KJActive = true
	State.LastCharacter = character
	cleanup(State.CharConnections)
	clearEffects()

	applyKJAura(character)
	setupMoves(character)

	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "KJ",
			Text = "KJ Moveset activated",
			Duration = 3
		})
	end)

	print("[KJ] Activated")
end

local function deactivateKJ()
	if not State.KJActive then return end
	State.KJActive = false
	cleanup(State.CharConnections)
	clearEffects()
	print("[KJ] Deactivated")
end

----------------------------------------------------------------
-- MAIN LOOP
----------------------------------------------------------------
-- Keep KJ button visible forever
task.spawn(function()
	while true do
		pcall(keepKJVisible)
		task.wait(0.15)
	end
end)

PlayerGui.DescendantAdded:Connect(function()
	task.defer(keepKJVisible)
end)

-- Watch for selection changes + character
task.spawn(function()
	while true do
		task.wait(0.25)

		local selected = isKJSelected()
		local char = LocalPlayer.Character

		if selected and char then
			if not State.KJActive or State.LastCharacter \~= char then
				activateKJ(char)
			end
		elseif not selected and State.KJActive then
			deactivateKJ()
		end
	end
end)

-- Character added
LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(0.6)
	if isKJSelected() then
		activateKJ(char)
	end
end)

-- Initial
task.defer(function()
	task.wait(1)
	keepKJVisible()
	if isKJSelected() and LocalPlayer.Character then
		activateKJ(LocalPlayer.Character)
	end
end)

print("[KJ] Improved script loaded - KJ button forced visible")
