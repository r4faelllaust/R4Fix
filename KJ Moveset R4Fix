local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local output = {}

local function add(text)
	table.insert(output, text)
	print(text)
end

local function safeGetFullName(obj)
	local success, result = pcall(function()
		return obj:GetFullName()
	end)

	if success then
		return result
	end

	return obj.Name
end

local function deepInfo(obj, depth)
	depth = depth or 0

	if depth > 6 then
		return
	end

	local indent = string.rep("  ", depth)

	add(
		indent ..
		obj.Name ..
		" [" ..
		obj.ClassName ..
		"]"
	)

	for _, child in ipairs(obj:GetChildren()) do
		deepInfo(child, depth + 1)
	end
end

local function findByName(name)
	local found = {}

	for _, obj in ipairs(game:GetDescendants()) do
		if obj.Name == name then
			table.insert(found, obj)
		end
	end

	return found
end

local function scanTextObjects(root, searchTerms)
	if not root then
		return
	end

	for _, obj in ipairs(root:GetDescendants()) do
		local text = nil

		pcall(function()
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				text = obj.Text
			elseif obj:IsA("StringValue") then
				text = obj.Value
			end
		end)

		if text then
			local lowerText = string.lower(tostring(text))

			for _, term in ipairs(searchTerms) do
				if string.find(lowerText, string.lower(term), 1, true) then
					add(
						"[TEXT MATCH] " ..
						safeGetFullName(obj) ..
						" [" ..
						obj.ClassName ..
						"]" ..
						"\n  Text: " ..
						tostring(text)
					)

					break
				end
			end
		end
	end
end

