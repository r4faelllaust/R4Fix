-- TOPBAR
--============================================================

local function findKJButtons()

    local result = {}

    local topbar =
        PlayerGui:FindFirstChild(
            "TopbarPlus"
        )

    if not topbar then
        return result
    end

    for _, object in ipairs(
        topbar:GetDescendants()
    ) do

        if object.Name == "KJ" then

            table.insert(
                result,
                object
            )

        end

    end

    return result

end

local function makeKJVisible()

    for _, kj in ipairs(
        findKJButtons()
    ) do

        if kj:IsA("GuiObject") then
            kj.Visible = true
        end

        if kj:IsA("GuiButton") then

            kj.Active = true
            kj.Selectable = true

        end

        for _, child in ipairs(
            kj:GetDescendants()
        ) do

            if child:IsA("GuiButton") then

                child.Visible = true
                child.Active = true
                child.Selectable = true

            end

        end

    end

end

local function connectKJButton(kj)

    if not kj then
        return
    end

    local candidates = {}

    if kj:IsA("GuiButton") then

        table.insert(
            candidates,
            kj
        )

    end

    for _, child in ipairs(
        kj:GetDescendants()
    ) do

        if child:IsA("GuiButton") then

            table.insert(
                candidates,
                child
            )

        end

    end

    for _, button in ipairs(
        candidates
    ) do

        if button:GetAttribute(
            "KJClientConnected"
        ) then

            continue

        end

        button:SetAttribute(
            "KJClientConnected",
            true
        )

        local connection =
            button.Activated:Connect(
                function()

                    if State.Enabled then
                        return
                    end

                    activateKJ()

                end
            )

        table.insert(
            State.TopbarConnections,
            connection
        )

    end

end

local function connectKJTopbar()

    for _, kj in ipairs(
        findKJButtons()
    ) do

        connectKJButton(kj)

    end

end

