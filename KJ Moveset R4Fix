--============================================================
-- UTILITY
--============================================================

local function safe(callback, fallback)

    local ok, result = pcall(callback)

    if ok then
        return result
    end

    return fallback

end


local function trackObject(object)

    if object then
        table.insert(State.TemporaryObjects, object)
    end

    return object
end


local function cleanupObject(object)

    if not object then
        return
    end

    pcall(function()
        object:Destroy()
    end)

end


local function cleanupAllObjects()

    for _, object in ipairs(State.TemporaryObjects) do
        cleanupObject(object)
    end

    table.clear(State.TemporaryObjects)

end


local function disconnectAll()

    for _, connection in ipairs(State.Connections) do

        pcall(function()
            connection:Disconnect()
        end)

    end

    table.clear(State.Connections)

end


local function addConnection(connection)

    if connection then
        table.insert(State.Connections, connection)
    end

    return connection

end


--============================================================
-- RECURSIVE SEARCH
--============================================================

local function findRecursive(root, name)

    if not root then
        return nil
    end

    return root:FindFirstChild(name, true)

end


local function findAllRecursive(root, name)

    local results = {}

    if not root then
        return results
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object.Name == name then
            table.insert(results, object)
        end

    end

    return results

end


--============================================================
-- FIND KJ ANIMATION
--============================================================

local function findKJAnimation(keywords)

    local roots = {
        KJEffects,
        KJThrow,
        UFW,
        Cutscenes,
        Resources,
    }

    for _, root in ipairs(roots) do

        if root then

            for _, object in ipairs(root:GetDescendants()) do

                if object:IsA("Animation") then

                    local text =
                        string.lower(
                            object.Name
                            .. " "
                            .. object:GetFullName()
                        )

                    for _, keyword in ipairs(keywords) do

                        if string.find(
                            text,
                            string.lower(keyword),
                            1,
                            true
                        ) then

                            return object

                        end

                    end

                end

            end

        end

    end

    return nil

end


--============================================================
-- ANIMATION LOADING
--============================================================

local function loadAnimationId(id)

    if not State.Animator then
        return nil
    end

    local animation =
        Instance.new("Animation")

    animation.AnimationId = id

    local track =
        safe(function()
            return State.Animator:LoadAnimation(animation)
        end)

    if not track then
        animation:Destroy()
        return nil
    end

    trackObject(animation)

    return track

end


local function loadAnimationObject(animation)

    if not animation or not State.Animator then
        return nil
    end

    return safe(function()
        return State.Animator:LoadAnimation(animation)
    end)

end


local function playTrack(track, fadeTime, speed)

    if not track then
        return false
    end

    safe(function()

        track.Priority =
            Enum.AnimationPriority.Action

        track:Play(
            fadeTime or 0.1,
            1,
            speed or 1
        )

    end)

    table.insert(State.Tracks, track)

    return true

end


local function stopAllTracks()

    for _, track in ipairs(State.Tracks) do

        safe(function()
            track:Stop(0.1)
        end)

    end

    table.clear(State.Tracks)

end


--============================================================
-- CHARACTER
--============================================================

local function setupCharacter(character)

    State.Character = character

    State.Humanoid =
        character:WaitForChild("Humanoid")

    State.Root =
        character:WaitForChild("HumanoidRootPart")

    State.Animator =
        State.Humanoid:FindFirstChildOfClass("Animator")

    if not State.Animator then

        State.Animator =
            Instance.new("Animator")

        State.Animator.Parent =
            State.Humanoid

    end

    State.OriginalFOV = nil

end


local function getCharacter()

    if State.Character
        and State.Character.Parent
        and State.Humanoid
        and State.Root
    then

        return true

    end

    local character =
        player.Character

    if not character then
        return false
    end

    setupCharacter(character)

    return true

end


--============================================================
-- CAMERA
--============================================================

local function getCamera()

    return workspace.CurrentCamera

end


local function cameraShake(duration, magnitude)

    local camera =
        getCamera()

    if not camera then
        return
    end

    local start =
        os.clock()

    local connection

    connection =
        RunService.RenderStepped:Connect(function()

            local elapsed =
                os.clock() - start

            if elapsed >= duration then

                connection:Disconnect()
                return

            end

            local remaining =
                1 - elapsed / duration

            local x =
                (math.random() - 0.5)
                * magnitude
                * remaining

            local y =
                (math.random() - 0.5)
                * magnitude
                * remaining

            local z =
                (math.random() - 0.5)
                * magnitude
                * remaining

            camera.CFrame =
                camera.CFrame
                * CFrame.new(x, y, z)

        end)

end


local function changeFOV(target, duration)

    local camera =
        getCamera()

    if not camera then
        return
    end

    if State.OriginalFOV == nil then
        State.OriginalFOV = camera.FieldOfView
    end

    TweenService:Create(
        camera,
        TweenInfo.new(
            duration or 0.25,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            FieldOfView = target
        }
    ):Play()

end


local function restoreFOV()

    local camera =
        getCamera()

    if not camera then
        return
    end

    local target =
        State.OriginalFOV or 70

    TweenService:Create(
        camera,
        TweenInfo.new(
            0.3,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            FieldOfView = target
        }
    ):Play()

    State.OriginalFOV = nil

end


--============================================================
-- SOUND
--============================================================

local function playSound(id, volume, speed)

    if not State.Root then
        return nil
    end

    local sound =
        Instance.new("Sound")

    sound.SoundId = id
    sound.Volume = volume or 1
    sound.PlaybackSpeed = speed or 1
    sound.RollOffMaxDistance = 100

    sound.Parent =
        State.Root

    trackObject(sound)

    sound:Play()

    Debris:AddItem(sound, 10)

    return sound

end


--============================================================
-- EFFECT CLONING
--============================================================

local function cloneEffect(source, parent, cframe)

    if not source then
        return nil
    end

    local clone =
        safe(function()
            return source:Clone()
        end)

    if not clone then
        return nil
    end

    clone.Parent =
        parent or workspace

    if cframe then

        if clone:IsA("Model") then

            safe(function()
                clone:PivotTo(cframe)
            end)

        elseif clone:IsA("BasePart") then

            clone.CFrame = cframe

        end

    end

    trackObject(clone)

    return clone

end


--============================================================
-- ENABLE PARTICLES
--============================================================

local function enableParticles(root)

    if not root then
        return
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter") then

            object.Enabled = true

        elseif object:IsA("Trail") then

            object.Enabled = true

        elseif object:IsA("Beam") then

            object.Enabled = true

        elseif object:IsA("PointLight")
            or object:IsA("SpotLight")
            or object:IsA("SurfaceLight")
        then

            object.Enabled = true

        end

    end

end


--============================================================
-- EMIT PARTICLES
--============================================================

local function emitParticles(root, amount)

    if not root then
        return
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter") then

            safe(function()
                object:Emit(amount or 10)
            end)

        end

    end

end


