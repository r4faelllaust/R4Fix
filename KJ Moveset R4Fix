local function connectMobile()

	local punch = getPunchButton()

	if not punch then
		return
	end

	if connectedPunchButtons[punch] then
		return
	end

	connectedPunchButtons[punch] = true

	if punch:IsA("GuiButton") then

		trackConnection(
			punch.Activated:Connect(function()

				if not State.Enabled then
					return
				end

				m1()

			end)
		)

	end
end

--============================================================
-- CHARACTER SETUP
--============================================================

local function setupCharacter(character)

	disconnectList(State.CharacterConnections)

	stopAnimations()
	cleanupEffects()

	State.Character = character
	State.Humanoid =
		character:WaitForChild("Humanoid", 10)

	State.RootPart =
		character:WaitForChild("HumanoidRootPart", 10)

	State.UltimateActive = false
	State.Busy = false
	State.M1Index = 0

	if not State.Enabled then
		return
	end

	task.wait(0.5)

	if State.Enabled then
		createKJAura()
	end

	----------------------------------------------------------
	-- Death
	----------------------------------------------------------

	if State.Humanoid then

		table.insert(
			State.CharacterConnections,

			State.Humanoid.Died:Connect(function()

				if State.Enabled then
					cleanup()
				end

			end)
		)

	end

end

--============================================================
-- INPUT
--============================================================

trackConnection(
	UserInputService.InputBegan:Connect(function(input, processed)

		if processed then
			return
		end

		if not State.Enabled then
			return
		end

		------------------------------------------------------
		-- M1
		------------------------------------------------------

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			m1()
			return
		end

		------------------------------------------------------
		-- Keyboard
		------------------------------------------------------

		if input.KeyCode == Enum.KeyCode.One then
			move1()

		elseif input.KeyCode == Enum.KeyCode.Two then
			move2()

		elseif input.KeyCode == Enum.KeyCode.Three then
			move3()

		elseif input.KeyCode == Enum.KeyCode.Four then
			wallCombo()

		elseif input.KeyCode == Enum.KeyCode.G then
			ultimate()
		end

	end)
)

