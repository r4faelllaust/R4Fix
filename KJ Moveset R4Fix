--============================================================
-- STOP OLD KJ ANIMATIONS
--============================================================

local function stopKJAnimations()

    for _, track in ipairs(State.Animations) do

        if track then

            pcall(function()
                track:Stop(0)
            end)

        end

    end

    table.clear(State.Animations)

end

--============================================================
-- STOP ALL CHARACTER ANIMATIONS
--============================================================

local function stopAllAnimations()

    if not State.Humanoid then
        return
    end

    for _, track in ipairs(
        State.Humanoid:GetPlayingAnimationTracks()
    ) do

        pcall(function()
            track:Stop(0)
        end)

    end

end

--============================================================
-- PLAY ANIMATION
--============================================================

local function playAnimation(id, speed, looped)

    if not State.Humanoid then
        return nil
    end

    local animator =
        State.Animator

    if not animator then
        animator =
            State.Humanoid:FindFirstChildOfClass("Animator")
    end

    if not animator then

        animator =
            Instance.new("Animator")

        animator.Parent =
            State.Humanoid

        State.Animator =
            animator

    end

    local animation =
        Instance.new("Animation")

    animation.AnimationId =
        "rbxassetid://" .. tostring(id)

    local success, track =
        pcall(function()

            return animator:LoadAnimation(animation)

        end)

    animation:Destroy()

    if not success or not track then

        warn(
            "[KJ] Failed to load animation:",
            id
        )

        return nil
    end

    track.Looped =
        looped == true

    track:Play(
        0.08,
        1,
        speed or 1
    )

    table.insert(
        State.Animations,
        track
    )

    return track

end

