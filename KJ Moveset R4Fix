------------------------------------------------------------
-- STATE
------------------------------------------------------------

local KJ = {
    Active = false,
    Character = nil,
    Humanoid = nil,
    Root = nil,

    Connections = {},
    Temporary = {},
    Tracks = {},

    Aura = nil,
    CurrentMove = nil,

    Cooldowns = {},
    Busy = false,

    OriginalWalkSpeed = nil,
    OriginalJumpPower = nil,
}

------------------------------------------------------------
-- UTILITY
------------------------------------------------------------

local function safeDestroy(object)
    if object then
        pcall(function()
            object:Destroy()
        end)
    end
end

local function disconnectAll()
    for _, connection in ipairs(KJ.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(KJ.Connections)
end

local function addConnection(connection)
    table.insert(KJ.Connections, connection)
    return connection
end

local function getCharacter()
    local character = player.Character

    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        return nil
    end

    return character, humanoid, root
end

local function getAnimator()
    if not KJ.Humanoid then
        return nil
    end

    local animator = KJ.Humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = KJ.Humanoid
    end

    return animator
end

------------------------------------------------------------
-- TOPBAR
------------------------------------------------------------

local function findKJButton()
    local topbar = playerGui:FindFirstChild("TopbarPlus")

    if not topbar then
        return nil
    end

    local container = topbar:FindFirstChild("TopbarContainer")

    if not container then
        return nil
    end

    local unnamedIcon = container:FindFirstChild("UnnamedIcon")

    if not unnamedIcon then
        return nil
    end

    local dropdown = unnamedIcon:FindFirstChild("DropdownContainer")

    if not dropdown then
        return nil
    end

    local frame = dropdown:FindFirstChild("DropdownFrame")

    if not frame then
        return nil
    end

    return frame:FindFirstChild("KJ")
end

local function keepKJVisible()
    local kj = findKJButton()

    if not kj then
        return
    end

    pcall(function()
        kj.Visible = true

        if kj:IsA("GuiButton") then
            kj.Active = true
            kj.Selectable = true
        end
    end)
end

------------------------------------------------------------
-- TOPBAR CLICK
------------------------------------------------------------

local connectedTopbarButtons = {}

local function connectTopbar()
    local kjButton = findKJButton()

    if not kjButton then
        return
    end

    if connectedTopbarButtons[kjButton] then
        return
    end

    connectedTopbarButtons[kjButton] = true

    if kjButton:IsA("GuiButton") then
        addConnection(kjButton.MouseButton1Click:Connect(function()
            if KJ.Active then
                getCharacter()

                if KJ.Active then
                    -- The actual state change is handled below.
                end
            end
        end))
    end
end

------------------------------------------------------------
-- CHARACTER SETUP
------------------------------------------------------------

local function setupCharacter()
    local character, humanoid, root = getCharacter()

    if not character then
        return false
    end

    KJ.Character = character
    KJ.Humanoid = humanoid
    KJ.Root = root

    if KJ.OriginalWalkSpeed == nil then
        KJ.OriginalWalkSpeed = humanoid.WalkSpeed
    end

    if KJ.OriginalJumpPower == nil then
        KJ.OriginalJumpPower = humanoid.JumpPower
    end

    return true
end

------------------------------------------------------------
-- ANIMATION
------------------------------------------------------------

local function stopTracks()
    for _, track in ipairs(KJ.Tracks) do
        pcall(function()
            track:Stop(0.1)
            track:Destroy()
        end)
    end

    table.clear(KJ.Tracks)
end

local function playAnimation(animationId, speed, fadeTime)
    if not KJ.Active then
        return nil
    end

    local animator = getAnimator()

    if not animator then
        return nil
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = animationId

    local success, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    animation:Destroy()

    if not success or not track then
        return nil
    end

    track.Priority = Enum.AnimationPriority.Action
    track.Looped = false

    if speed then
        track:AdjustSpeed(speed)
    end

    track:Play(fadeTime or 0.1)

    table.insert(KJ.Tracks, track)

    return track
end

------------------------------------------------------------
-- SOUND
------------------------------------------------------------

local function playSound(soundId, volume, speed)
    if not KJ.Root then
        return nil
    end

    local sound = Instance.new("Sound")

    sound.SoundId = soundId
    sound.Volume = volume or 1
    sound.PlaybackSpeed = speed or 1
    sound.RollOffMaxDistance = 100
    sound.RollOffMinDistance = 5

    sound.Parent = KJ.Root

    sound:Play()

    table.insert(KJ.Temporary, sound)

    sound.Ended:Connect(function()
        safeDestroy(sound)
    end)

    return sound
end

------------------------------------------------------------
-- RESOURCE SEARCH
------------------------------------------------------------

local function findPath(root, path)
    local current = root

    for _, name in ipairs(path) do
        if not current then
            return nil
        end

        current = current:FindFirstChild(name)
    end

    return current
end

local function getKJEverything()
    return findPath(
        ReplicatedStorage,
        {
            "Resources",
            "UFW",
            "vfx",
            "Everything",
            "KJ"
        }
    )
end

local function getKJWallCombo()
    return findPath(
        ReplicatedStorage,
        {
            "Resources",
            "KJEffects",
            "KJWallCombo"
        }
    )
end

------------------------------------------------------------
-- PARTICLE ENABLE
------------------------------------------------------------

local function enableParticles(root, enabled)
    if not root then
        return
    end

    for _, object in ipairs(root:GetDescendants()) do
        if object:IsA("ParticleEmitter") then
            pcall(function()
                object.Enabled = enabled
            end)
        elseif object:IsA("Trail") then
            pcall(function()
                object.Enabled = enabled
            end)
        elseif object:IsA("Beam") then
            pcall(function()
                object.Enabled = enabled
            end)
        end
    end
end

------------------------------------------------------------
-- AURA
------------------------------------------------------------

local function removeAura()
    if KJ.Aura then
        safeDestroy(KJ.Aura)
        KJ.Aura = nil
    end
end

local function createAura()
    if not KJ.Active or not CONFIG.AuraEnabled then
        return
    end

    if not KJ.Character then
        return
    end

    removeAura()

    local source = getKJEverything()

    if not source then
        warn("[KJ] Everything.KJ was not found")
        return
    end

    local clone = source:Clone()
    clone.Name = "KJ_ClientAura"

    KJ.Aura = clone
    clone.Parent = KJ.Character

    local surface = clone:FindFirstChild("Surface", true)

    if surface then
        local attachment = surface:FindFirstChild("Attachment", true)

        if attachment then
            enableParticles(attachment, true)
        end
    end

    for _, object in ipairs(clone:GetDescendants()) do
        if object:IsA("BasePart") then
            pcall(function()
                object.CanCollide = false
                object.CanTouch = false
                object.CanQuery = false
                object.Massless = true
            end)
        end
    end
end

------------------------------------------------------------
-- POSITION VFX
------------------------------------------------------------

local function positionInstance(instance)
    if not instance or not KJ.Root then
        return
    end

    if instance:IsA("Model") then
        pcall(function()
            instance:PivotTo(KJ.Root.CFrame)
        end)
    elseif instance:IsA("BasePart") then
        pcall(function()
            instance.CFrame = KJ.Root.CFrame
        end)
    end
end

------------------------------------------------------------
-- PLAY KJ RESOURCE
------------------------------------------------------------

local function playResource(name, lifetime)
    if not KJ.Active then
        return nil
    end

    local source = getKJWallCombo()

    if not source then
        warn("[KJ] KJWallCombo resource not found")
        return nil
    end

    local object = source:FindFirstChild(name, true)

    if not object then
        warn("[KJ] Resource not found:", name)
        return nil
    end

    local clone = object:Clone()
    clone.Name = "KJ_Local_" .. name

    clone.Parent = workspace

    positionInstance(clone)

    if clone:IsA("BasePart") then
        clone.Anchored = true
        clone.CanCollide = false
        clone.CanTouch = false
        clone.CanQuery = false
    end

    enableParticles(clone, true)

    table.insert(KJ.Temporary, clone)

    if lifetime then
        Debris:AddItem(clone, lifetime)
    end

    return clone
end

------------------------------------------------------------
-- CAMERA EFFECT
------------------------------------------------------------

local function cameraShake(power, duration)
    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local start = tick()

    local connection

    connection = RunService.RenderStepped:Connect(function()
        if not camera or not camera.Parent then
            connection:Disconnect()
            return
        end

        local elapsed = tick() - start

        if elapsed >= duration then
            connection:Disconnect()
            return
        end

        local fade = 1 - (elapsed / duration)

        local x = (math.random() - 0.5) * power * fade
        local y = (math.random() - 0.5) * power * fade
        local z = (math.random() - 0.5) * power * fade

        camera.CFrame =
            camera.CFrame *
            CFrame.Angles(
                math.rad(x),
                math.rad(y),
                math.rad(z)
            )
    end)

    table.insert(KJ.Connections, connection)
end

------------------------------------------------------------
-- FOV EFFECT
------------------------------------------------------------

local function fovPunch(amount, duration)
    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local original = camera.FieldOfView

    local up = TweenService:Create(
        camera,
        TweenInfo.new(
            duration * 0.35,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            FieldOfView = original + amount
        }
    )

    local down = TweenService:Create(
        camera,
        TweenInfo.new(
            duration * 0.65,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            FieldOfView = original
        }
    )

    up:Play()

    up.Completed:Connect(function()
        if camera and camera.Parent then
            down:Play()
        end
    end)
end

------------------------------------------------------------
-- COOLDOWN
------------------------------------------------------------

local function onCooldown(name)
    local expires = KJ.Cooldowns[name]

    if not expires then
        return false
    end

    return tick() < expires
end

local function setCooldown(name, duration)
    KJ.Cooldowns[name] = tick() + duration
end

------------------------------------------------------------
-- MOVE LOCK
------------------------------------------------------------

local function beginMove(name)
    if not KJ.Active then
        return false
    end

    if KJ.Busy then
        return false
    end

    if onCooldown(name) then
        return false
    end

    KJ.Busy = true
    KJ.CurrentMove = name

    return true
end

local function endMove(name, cooldown)
    if KJ.CurrentMove == name then
        KJ.CurrentMove = nil
    end

    KJ.Busy = false

    if cooldown then
        setCooldown(name, cooldown)
    end
end

------------------------------------------------------------
-- MOVE 1
-- WALL COMBO
------------------------------------------------------------

local function move1WallCombo()
    if not beginMove("WallCombo") then
        return
    end

    task.spawn(function()
        playSound(CONFIG.Sounds.Character, 1)

        local track = playAnimation(
            CONFIG.Animations.WallCombo,
            1,
            0.05
        )

        playResource("hold", 1.4)

        fovPunch(8, 0.25)

        task.wait(0.35)

        playSound(CONFIG.Sounds.Hit, 1.2)

        playResource("ImpactEffect", 1)
        playResource("HitParticles", 1)

        cameraShake(1.2, 0.12)

        task.wait(0.35)

        playSound(CONFIG.Sounds.Hit, 1.2)

        playResource("ImpactEffect2", 1)
        playResource("CollateralWind", 1)

        cameraShake(1.8, 0.15)

        task.wait(0.35)

        playSound(CONFIG.Sounds.Hit, 1.5)

        playResource("FinalImpact", 2)
        playResource("FinalImpactHUGEignore", 2)
        playResource("slam", 1.5)

        fovPunch(15, 0.35)
        cameraShake(4, 0.35)

        task.wait(1)

        endMove("WallCombo", 5)
    end)
end

------------------------------------------------------------
-- MOVE 2
-- BARRAGE
------------------------------------------------------------

local function move2Barrage()
    if not beginMove("Barrage") then
        return
    end

    task.spawn(function()
        playSound(CONFIG.Sounds.Character, 0.8)

        local duration = 1.8
        local start = tick()

        local barrageAnimation =
            CONFIG.Animations.WallCombo

        local track = playAnimation(
            barrageAnimation,
            1.4,
            0.05
        )

        while tick() - start < duration do
            if not KJ.Active then
                break
            end

            playSound(
                CONFIG.Sounds.Hit,
                0.35,
                1 + math.random(-10, 10) / 100
            )

            playResource("HitParticles", 0.35)

            if math.random() > 0.45 then
                playResource("PunchFX", 0.35)
            end

            cameraShake(0.35, 0.06)

            task.wait(0.13)
        end

        if track then
            pcall(function()
                track:Stop(0.1)
            end)
        end

        endMove("Barrage", 4)
    end)
end

