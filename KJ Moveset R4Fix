--============================================================
-- COOLDOWN
--============================================================

local function ready(name, cooldown)

    local now =
        os.clock()

    local last =
        State.Cooldowns[name] or 0

    if now - last < cooldown then
        return false
    end

    State.Cooldowns[name] = now

    return true

end


