--============================================================
-- KJ CLIENT BOOTSTRAP / TOPBAR DIAGNOSTIC
-- LocalScript
-- StarterPlayerScripts
--
-- PURPOSE:
-- 1. Wait for the game's UI to actually load.
-- 2. Find KJ anywhere under PlayerGui.
-- 3. Print exactly what was found.
-- 4. Keep watching for Topbar/UI recreation.
-- 5. Prepare the KJ client state.
--
-- This version intentionally does NOT silently fail.
--============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

print("============================================================")
print("[KJ] CLIENT BOOT STARTED")
print("[KJ] Player:", player.Name)
print("[KJ] PlayerGui:", playerGui:GetFullName())
print("============================================================")


--============================================================
-- STATE
--============================================================

local State = {
    KJActive = false,
    KJObject = nil,
    KJRoot = nil,
    Character = nil,

    Connections = {},
    Effects = {},
}

_G.KJClientState = State


--============================================================
-- SAFE HELPERS
--============================================================

local function safe(callback)
    local ok, result = pcall(callback)

    if ok then
        return result
    end

    return nil
end


local function describe(obj)
    if not obj then
        return "nil"
    end

    local className = safe(function()
        return obj.ClassName
    end) or "?"

    local fullName = safe(function()
        return obj:GetFullName()
    end) or "?"

    return "[" .. className .. "] " .. fullName
end


local function nameMatches(obj, wanted)
    if not obj then
        return false
    end

    local name = safe(function()
        return obj.Name
    end)

    if not name then
        return false
    end

    return string.lower(name) == string.lower(wanted)
end


--============================================================
-- FIND BY EXACT NAME
--============================================================

local function findAllByName(root, wanted)
    local results = {}

    if not root then
        return results
    end

    if nameMatches(root, wanted) then
        table.insert(results, root)
    end

    for _, obj in ipairs(root:GetDescendants()) do
        if nameMatches(obj, wanted) then
            table.insert(results, obj)
        end
    end

    return results
end


--============================================================
-- FIND ANY KJ OBJECT
--============================================================

local function findKJObjects()
    local results = {}

    for _, obj in ipairs(playerGui:GetDescendants()) do

        local name = safe(function()
            return obj.Name
        end)

        if name and string.lower(name) == "kj" then
            table.insert(results, obj)
        end

    end

    return results
end


--============================================================
-- FIND TOPBAR
--============================================================

local function findTopbars()

    local results = {}

    for _, obj in ipairs(playerGui:GetDescendants()) do

        local name = safe(function()
            return obj.Name
        end)

        if name and string.lower(name):find("topbar", 1, true) then
            table.insert(results, obj)
        end

    end

    return results
end


--============================================================
-- PRINT TOPBAR STRUCTURE
--============================================================

local function inspectTopbar(root)

    print("")
    print("------------------------------------------------------------")
    print("[KJ] TOPBAR INSPECTION")
    print("ROOT:", describe(root))
    print("------------------------------------------------------------")

    local count = 0

    for _, obj in ipairs(root:GetDescendants()) do

        count += 1

        local name = safe(function()
            return obj.Name
        end)

        local className = safe(function()
            return obj.ClassName
        end)

        if
            name
            and (
                string.lower(name):find("kj", 1, true)
                or string.lower(name):find("dropdown", 1, true)
                or string.lower(name):find("icon", 1, true)
                or string.lower(name):find("topbar", 1, true)
            )
        then

            print(
                "[KJ][TOPBAR]",
                className,
                obj:GetFullName()
            )

        end

    end

    print("[KJ] Relevant objects:", count)
    print("------------------------------------------------------------")
end


--============================================================
-- INSPECT KJ OBJECT
--============================================================

local function inspectKJ(obj)

    print("")
    print("============================================================")
    print("[KJ] FOUND KJ OBJECT")
    print(describe(obj))
    print("============================================================")

    State.KJObject = obj

    local parent = safe(function()
        return obj.Parent
    end)

    if parent then
        print("[KJ] Parent:", describe(parent))
    end

    local current = obj

    for depth = 1, 8 do

        local p = safe(function()
            return current.Parent
        end)

        if not p then
            break
        end

        print(
            "[KJ] Parent level",
            depth,
            ":",
            describe(p)
        )

        current = p
    end

    print("============================================================")
end


--============================================================
-- FIND KJ NOW
--============================================================

local function scan()

    print("")
    print("============================================================")
    print("[KJ] SCANNING PLAYERGUI")
    print("============================================================")

    local topbars = findTopbars()

    print("[KJ] Topbar-like objects:", #topbars)

    for _, topbar in ipairs(topbars) do
        print("[KJ] TOPBAR:", describe(topbar))
        inspectTopbar(topbar)
    end

    local kjObjects = findKJObjects()

    print("")
    print("[KJ] Exact 'KJ' objects:", #kjObjects)

    if #kjObjects == 0 then

        print("[KJ] WARNING: No object named KJ currently exists.")

    else

        for _, obj in ipairs(kjObjects) do
            inspectKJ(obj)
        end

    end

    print("")
    print("============================================================")
    print("[KJ] SCAN COMPLETE")
    print("============================================================")

    return kjObjects
end


--============================================================
-- VISIBILITY / GUI INSPECTION
--============================================================

local function inspectGuiState(obj)

    if not obj then
        return
    end

    local className = safe(function()
        return obj.ClassName
    end)

    print("[KJ] GUI STATE:", describe(obj))

    if obj:IsA("GuiObject") then

        print(
            "[KJ] Visible:",
            tostring(obj.Visible)
        )

        print(
            "[KJ] Active:",
            tostring(obj.Active)
        )

        print(
            "[KJ] ZIndex:",
            tostring(obj.ZIndex)
        )

    end

    if obj:IsA("GuiButton") then

        print(
            "[KJ] Button:",
            tostring(obj.Text)
        )

        print(
            "[KJ] AutoButtonColor:",
            tostring(obj.AutoButtonColor)
        )

    end

    if className == "TextButton" then

        print(
            "[KJ] Text:",
            tostring(obj.Text)
        )

    end
end


--============================================================
-- TRY TO MAKE KJ VISIBLE
--============================================================

local function makeVisible(obj)

    if not obj then
        return false
    end

    local success = pcall(function()

        if obj:IsA("GuiObject") then
            obj.Visible = true
        end

        if obj:IsA("GuiButton") then
            obj.Active = true
            obj.Selectable = true
        end

    end)

    if success then
        print("[KJ] Made GUI object visible:", describe(obj))
    else
        warn("[KJ] Could not modify:", describe(obj))
    end

    return success
end


--============================================================
-- KJ DISCOVERY LOOP
--============================================================

local lastKJ = nil

task.spawn(function()

    while true do

        task.wait(0.5)

        local found = findKJObjects()

        local first = found[1]

        if first ~= lastKJ then

            lastKJ = first

            if first then

                print("")
                print("############################################################")
                print("[KJ] KJ OBJECT APPEARED / CHANGED")
                print(describe(first))
                print("############################################################")

                State.KJObject = first

                inspectGuiState(first)
                makeVisible(first)

            else

                print("[KJ] KJ object disappeared.")

            end

        elseif first then

            makeVisible(first)

        end

    end

end)


--============================================================
-- PLAYERGUI CHANGE WATCHER
--============================================================

playerGui.DescendantAdded:Connect(function(obj)

    local name = safe(function()
        return obj.Name
    end)

    if name then

        local lower = string.lower(name)

        if
            lower == "kj"
            or lower:find("topbar", 1, true)
            or lower:find("dropdown", 1, true)
        then

            print("")
            print("[KJ] IMPORTANT GUI OBJECT CREATED:")
            print(describe(obj))

            task.defer(function()
                scan()
            end)

        end

    end

end)


--============================================================
-- CHARACTER SETUP
--============================================================

local function setupCharacter(character)

    State.Character = character

    print("")
    print("============================================================")
    print("[KJ] CHARACTER READY")
    print(describe(character))
    print("============================================================")

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        print("[KJ] Humanoid:", humanoid:GetFullName())
    end

    local animator = character:FindFirstChildWhichIsA(
        "Animator",
        true
    )

    if animator then
        print("[KJ] Animator:", animator:GetFullName())
    else
        print("[KJ] Animator not found yet.")
    end
end


player.CharacterAdded:Connect(function(character)

    task.wait(0.2)

    setupCharacter(character)

    task.wait(1)

    scan()

end)


if player.Character then
    setupCharacter(player.Character)
end


