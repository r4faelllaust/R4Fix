--============================================================
-- EXECUTION
--============================================================

local function executeModule(module, name)

    if typeof(module) == "function" then

        local ok, err = pcall(function()
            module()
        end)

        return ok, err
    end

    if typeof(module) ~= "table" then
        return false, "Module returns "..typeof(module)
    end

    -- Prefer common actual cutscene entry names.
    local names = {
        "Play",
        "play",
        "Start",
        "start",
        "Run",
        "run",
        "Execute",
        "execute",
        "PlayCutscene",
        "StartCutscene",
    }

    for _, functionName in ipairs(names) do

        local fn = module[functionName]

        if typeof(fn) == "function" then

            local ok, err = pcall(function()

                fn({
                    Player = player,
                    Character = player.Character,
                })

            end)

            if ok then
                return true,
                    name.."."..functionName.." EXECUTED"
            end

            return false,
                name.."."..functionName.." ERROR:\n"..tostring(err)
        end
    end

    return false,
        "No executable cutscene function found."
end

