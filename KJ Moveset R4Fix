    line(text)
    line("============================================================")
end

local function separator()
    line("------------------------------------------------------------")
end

--============================================================
-- PLAYING TRACKS
--============================================================

local function captureTracks()
    section("CURRENT PLAYING ANIMATION TRACKS")

    local character = player.Character

    if not character then
        line("Character unavailable.")
        return
    end

    local found = false

    for _, obj in ipairs(character:GetDescendants()) do

        if obj:IsA("Animator") then

            found = true

            line("ANIMATOR: " .. getFullName(obj))

            local tracks = safe(function()
                return obj:GetPlayingAnimationTracks()
            end, {})

            line("TRACK COUNT: " .. tostring(#tracks))

            for _, track in ipairs(tracks) do

                separator()

                line("TRACK NAME: " .. tostring(track.Name))
                line("PRIORITY: " .. tostring(track.Priority))
                line("LOOPED: " .. tostring(track.Looped))
                line("PLAYING: " .. tostring(track.IsPlaying))
                line("TIME POSITION: " .. tostring(track.TimePosition))
                line("LENGTH: " .. tostring(track.Length))
                line("SPEED: " .. tostring(track.Speed))

                local animation = safe(function()
                    return track.Animation
                end, nil)

                if animation then
                    line("ANIMATION PATH: " .. getFullName(animation))
                    line("ANIMATION ID: " .. tostring(getAnimationId(animation)))
                else
                    line("ANIMATION: unavailable")
                end

            end
        end
    end

    if not found then
        line("No Animator found.")
    end
end

--============================================================
-- NEW OBJECTS
--============================================================

local function captureNewObjects()
    section("NEWLY OBSERVED OBJECTS")

    local after = snapshot()

    local newObjects = {}

    for obj in pairs(after) do
        if not baseline[obj] then
            table.insert(newObjects, obj)
        end
    end

    table.sort(newObjects, function(a, b)
        return getFullName(a) < getFullName(b)
    end)

    line("NEW OBJECT COUNT: " .. tostring(#newObjects))

    local interestingCount = 0

    for _, obj in ipairs(newObjects) do

        if interesting(obj)
        or obj:IsA("Animation")
        or obj:IsA("Sound")
        or obj:IsA("ParticleEmitter")
        or obj:IsA("Beam")
        or obj:IsA("Trail")
        or obj:IsA("Highlight")
        or obj:IsA("Attachment")
        then

            interestingCount += 1

            separator()

            line(
                "[" ..
                getClass(obj) ..
                "] " ..
                getFullName(obj)
            )

            if obj:IsA("Animation") then
                line(
                    "AnimationId: " ..
                    tostring(getAnimationId(obj))
                )
            end

            if obj:IsA("Sound") then
                line(
                    "SoundId: " ..
                    tostring(getSoundId(obj))
                )
            end

        end
    end

    line("")
    line(
        "INTERESTING NEW OBJECTS: " ..
        tostring(interestingCount)
    )
end

--============================================================
-- ALL ACCESSIBLE KJ ANIMATIONS AFTER MOVE
