--============================================================
-- ANIMATION
--============================================================

local function makeAnimation(animationId)
    local animation = Instance.new("Animation")
    animation.AnimationId = animationId

    return animation
end

local function loadTrack(animationId, priority)
    if not state.Animator then
        return nil
    end

    local animation = makeAnimation(animationId)

    local track = safe(function()
        return state.Animator:LoadAnimation(animation)
    end, nil)

    animation:Destroy()

    if not track then
        return nil
    end

    if priority then
        safe(function()
            track.Priority = priority
        end)
    end

    table.insert(state.Tracks, track)

    return track
end

local function playAnimation(animationId, priority, speed, fadeTime)
    local track = loadTrack(
        animationId,
        priority or Enum.AnimationPriority.Action
    )

    if not track then
        warn("[KJ] Failed to load animation:", animationId)
        return nil
    end

    safe(function()
        track.Looped = false
        track:Play(
            fadeTime or 0.08,
            1,
            speed or 1
        )
    end)

    return track
end

local function stopTrack(track, fadeTime)
    if track then
        safe(function()
            track:Stop(fadeTime or 0.1)
        end)
    end
end

local function stopKJTracks()
    for _, track in ipairs(state.Tracks) do
        stopTrack(track, 0.08)
    end

    table.clear(state.Tracks)
end

