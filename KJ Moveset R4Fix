end


------------------------------------------------------------
-- ANIMATION ID PARSER
------------------------------------------------------------

local function getAnimationId(animation)

    if not animation then
        return nil
    end

    local ok, result = pcall(function()

        local id = animation.AnimationId

        if not id or id == "" then
            return nil
        end

        return tonumber(string.match(id, "%d+"))

    end)

    if ok then
        return result
    end

    return nil
end


