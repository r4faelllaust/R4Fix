                    "] " ..
                    getFullName(obj)
                )

            end
        end
    end

    line("")
    line("MATCHING REMOTES: " .. tostring(count))
end

--============================================================
-- HOTBAR
--============================================================

local function captureHotbar()
    section("CURRENT HOTBAR")

    local gui = player:FindFirstChild("PlayerGui")

    if not gui then
        line("PlayerGui unavailable.")
        return
    end

    local hotbar = gui:FindFirstChild("Hotbar")

    if not hotbar then
        line("Hotbar not found.")
        return
    end

    local backpack = hotbar:FindFirstChild("Backpack")

    if not backpack then
        line("Hotbar.Backpack not found.")
        return
    end

    local frame = backpack:FindFirstChild("Hotbar")

    if not frame then
        line("Hotbar.Backpack.Hotbar not found.")
        return
    end

    for i = 1, 10 do

        local slot = frame:FindFirstChild(tostring(i))

        if slot then

            local toolName = slot:FindFirstChild("ToolName", true)

            if toolName and toolName:IsA("TextLabel") then

                line(
                    "SLOT " ..
                    tostring(i) ..
                    ": " ..
                    tostring(toolName.Text)
                )

            else

                line(
                    "SLOT " ..
                    tostring(i) ..
                    ": ToolName unavailable"
                )

            end
        end
    end
end

