    if not State.KJActive or State.Busy then
        return
    end

    State.Busy = true

    stopKJAnimations()

    playAnimation(
        CONFIG.Ravage.Attempt,
        1,
        false
    )

    task.wait(0.15)

    moveVFX("Ravage")

    playKJSound(
        CONFIG.HitSound
    )

    task.delay(
        0.75,
        function()
            State.Busy = false
        end
    )

end

