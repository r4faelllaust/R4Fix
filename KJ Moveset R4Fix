--============================================================

local function playSound(
    assetId,
    volume,
    speed
)

    if not State.Root then
        return nil
    end

    local sound =
        Instance.new("Sound")

    sound.SoundId =
        "rbxassetid://" ..
        tostring(assetId)

    sound.Volume =
        volume or 1

    sound.PlaybackSpeed =
        speed or 1

    sound.RollOffMaxDistance =
        150

    sound.RollOffMinDistance =
        5

    sound.Parent =
        State.Root

    table.insert(
        State.ActiveSounds,
        sound
    )

    pcall(function()
        sound:Play()
    end)

    sound.Ended:Connect(
        function()

            safeDestroy(sound)

        end
    )

    return sound

end

--============================================================
-- ANIMATION
--============================================================

local function getAnimationId(track)

    if not track
        or not track.Animation then

        return nil

    end

    local animationId =
        track.Animation.AnimationId

    if not animationId then
        return nil
    end

    return tonumber(
        string.match(
            animationId,
            "%d+"
        )
    )

end

local function stopTrack(track)

    if not track then
        return
    end

    pcall(function()
        track:Stop(0.05)
    end)

end

local function stopKJTracks()

    for _, track in ipairs(
        State.ActiveTracks
    ) do

        stopTrack(track)

    end

    table.clear(
        State.ActiveTracks
    )

end

local function playAnimation(
    assetId,
    speed,
    priority,
    fade
)

    if not State.Humanoid then
        return nil
    end

    local animation =
        Instance.new("Animation")

    animation.AnimationId =
        "rbxassetid://" ..
        tostring(assetId)

    local track

    local success =
        pcall(function()

            track =
                State.Humanoid:LoadAnimation(
                    animation
                )

        end)

    animation:Destroy()

    if not success or not track then
        return nil
    end

    track.Priority =
        priority or
        Enum.AnimationPriority.Action4

    track:Play(
        fade or 0.05,
        1,
        speed or 1
    )

    table.insert(
        State.ActiveTracks,
        track
    )

    return track

end

