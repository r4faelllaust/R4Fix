--============================================================
-- GENERAL UTILITIES
--============================================================

local function disconnect(connection)

    if connection then

        pcall(function()
            connection:Disconnect()
        end)

    end

end

local function disconnectList(list)

    for _, connection in ipairs(list) do
        disconnect(connection)
    end

    table.clear(list)

end

local function safeDestroy(object)

    if object then

        pcall(function()
            object:Destroy()
        end)

    end

end

local function notify(title, text, duration)

    pcall(function()

        StarterGui:SetCore(
            "SendNotification",
            {
                Title = title,
                Text = text,
                Duration = duration or 3,
            }
        )

    end)

end

--============================================================
-- RESOURCE SEARCH
--============================================================

local function findRecursive(root, name)

    if not root then
        return nil
    end

    return root:FindFirstChild(name, true)

end

local function findAllRecursive(root, name)

    local result = {}

    if not root then
        return result
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object.Name == name then
            table.insert(result, object)
        end

    end

    return result

end

local function getResources()

    return ReplicatedStorage:FindFirstChild("Resources")

end

local function getKJEffects()

    local resources = getResources()

    if not resources then
        return nil
    end

    return resources:FindFirstChild("KJEffects")

end

--============================================================
-- DISCOVER ACTUAL KJ RESOURCES
--============================================================

local Resources = {}

local function discoverResources()

    table.clear(Resources)

    local resources = getResources()
    local kjEffects = getKJEffects()

    if kjEffects then

        for _, name in ipairs({
            "KJWallCombo",
            "KJThrow",
            "PunchFX",
            "KJ",
            "Everything",
            "KJBlack",
            "KJWhite",
            "RockJump",
            "KJWallBreak",
        }) do

            local found = findRecursive(kjEffects, name)

            if found then
                Resources[name] = found
            end

        end

    end

    if resources then

        for _, name in ipairs({
            "KJWallCombo",
            "KJThrow",
            "PunchFX",
            "KJ",
            "Everything",
            "KJBlack",
            "KJWhite",
            "RockJump",
            "KJWallBreak",
        }) do

            if not Resources[name] then

                local found =
                    findRecursive(resources, name)

                if found then
                    Resources[name] = found
                end

            end

        end

    end

end

discoverResources()

