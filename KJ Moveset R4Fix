--============================================================
-- CHARACTER / MOVESet RELATED OBJECTS
--============================================================

section("CHARACTER / MOVESET RELATED OBJECTS")

local characterSearchRoots = {
    ReplicatedStorage,
    player,
    gui,
    backpack,
}

local characterSeen = {}

for _, root in ipairs(characterSearchRoots) do

    if root then

        for _, obj in ipairs(root:GetDescendants()) do

            local name = getNameSafe(obj)
            local fullName = getFullNameSafe(obj)

            if
                contains(name, "character")
                or contains(name, "moveset")
                or contains(name, "switch")
                or contains(fullName, "character")
                or contains(fullName, "moveset")
            then

                if not characterSeen[obj] then

                    characterSeen[obj] = true

                    line(
                        "[" ..
                        getClassInfo(obj) ..
                        "] " ..
                        fullName
                    )

                end

            end

        end

    end

end

--============================================================
-- KNOWN RESOURCE PATH CONFIRMATION
--============================================================

section("KNOWN KJ RESOURCE PATH CONFIRMATION")

local pathsToCheck = {
    "Resources.KJEffects",
    "Resources.KJThrow",
    "Resources.KJEffects.KJWallCombo",
    "Resources.UFW",
    "Resources.UFW.vfx.Everything.KJ",
    "Resources.UFW.vfx.PunchFX.KJ",
    "Resources.UFW.BG.KJWallBreak",
    "Cutscenes.KJ",
    "Info.Walls.KJ Wall",
}

for _, path in ipairs(pathsToCheck) do

    local current = ReplicatedStorage

    for part in string.gmatch(path, "[^%.]+") do

        current = current and current:FindFirstChild(part)

        if not current then
            break
        end

    end

    if current then
        line("FOUND: " .. path)
        line("CLASS: " .. getClassInfo(current))
        line("FULL PATH: " .. getFullNameSafe(current))
    else
        line("NOT FOUND: " .. path)
    end

end

