--============================================================
-- DIALOGUE
--============================================================

local function speakKJ(text)

    if not UFW then
        return false
    end

    local dialogue =
        UFW:FindFirstChild(
            "TekrinnDialogue"
        )

    if not dialogue
        or not dialogue:IsA("ModuleScript")
    then
        return false
    end

    local module =
        safe(function()
            return require(dialogue)
        end)

    if not module then
        return false
    end

    if type(module.Speak) ~= "function" then
        return false
    end

    local ok =
        pcall(function()

            module.Speak({
                {
                    Text = text,
                    Bold = true,
                    Italic = false,
                    TypeSpeed = 0.035,

                    Color =
                        ColorSequence.new({
                            ColorSequenceKeypoint.new(
                                0,
                                Color3.fromRGB(
                                    0,
                                    0,
                                    0
                                )
                            ),

                            ColorSequenceKeypoint.new(
                                0.5,
                                Color3.fromRGB(
                                    255,
                                    20,
                                    20
                                )
                            ),

                            ColorSequenceKeypoint.new(
                                1,
                                Color3.fromRGB(
                                    255,
                                    255,
                                    255
                                )
                            ),
                        }),

                    TextStrokeColor =
                        Color3.new(
                            0,
                            0,
                            0
                        ),

                    Shake = {
                        Enabled = false,
                        Intensity = 1,
                        Lifetime = 2,
                    },
                }
            })

        end)

    return ok

end


