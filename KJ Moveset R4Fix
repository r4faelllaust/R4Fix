local function captureAnimations()
    section("ACCESSIBLE KJ / ULTIMATE ANIMATIONS")

    local seen = {}
    local count = 0

    for _, root in ipairs(getRoots()) do

        if root then

            for _, obj in ipairs(root:GetDescendants()) do

                if obj:IsA("Animation") and not seen[obj] then

                    local path = getFullName(obj)
                    local name = getName(obj)

                    if
                        contains(path, "kj")
                        or contains(path, "ufw")
                        or contains(path, "ultimate")
                        or contains(name, "kj")
                        or contains(name, "21")
                        or contains(name, "ultimate")
                    then

                        seen[obj] = true
                        count += 1

                        separator()

                        line("NAME: " .. name)
                        line("ID: " .. tostring(getAnimationId(obj)))
                        line("PATH: " .. path)

                    end
                end
            end
        end
    end

    line("")
    line("MATCHING ANIMATIONS: " .. tostring(count))
end

