------------------------------------------------------------
-- CAMERA
------------------------------------------------------------

local function cameraShake(
    strength,
    duration
)

    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local started =
        tick()

    local connection

    connection =
        RunService.RenderStepped:Connect(
            function()

                if not camera.Parent then

                    disconnect(
                        connection
                    )

                    return
                end

                local elapsed =
                    tick() - started

                if elapsed >= duration then

                    disconnect(
                        connection
                    )

                    return
                end

                local fade =
                    1 -
                    (
                        elapsed /
                        duration
                    )

                local x =
                    (
                        math.random() -
                        0.5
                    ) *
                    strength *
                    fade

                local y =
                    (
                        math.random() -
                        0.5
                    ) *
                    strength *
                    fade

                local z =
                    (
                        math.random() -
                        0.5
                    ) *
                    strength *
                    fade

                camera.CFrame =
                    camera.CFrame *
                    CFrame.Angles(
                        math.rad(x),
                        math.rad(y),
                        math.rad(z)
                    )

            end
        )

    table.insert(
        State.Connections,
        connection
    )

end

------------------------------------------------------------
-- FOV
------------------------------------------------------------

local function fovPunch(
    amount
)

    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local original =
        camera.FieldOfView

    local inTween =
        TweenService:Create(
            camera,
            TweenInfo.new(
                0.12,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                FieldOfView =
                    original + amount
            }
        )

    local outTween =
        TweenService:Create(
            camera,
            TweenInfo.new(
                0.35,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                FieldOfView =
                    original
            }
        )

    inTween:Play()

    inTween.Completed:Connect(
        function()

            if camera.Parent then
                outTween:Play()
            end

        end
    )

end

------------------------------------------------------------
-- SPAWN SEQUENCE
------------------------------------------------------------

local function playKJSpawn()

    if not State.Active then
        return
    end

    if not State.Character then
        return
    end

    --------------------------------------------------------
    -- Small initial delay so character is fully replicated
    --------------------------------------------------------

    task.wait(0.2)

    --------------------------------------------------------
    -- Spawn animation
    --------------------------------------------------------

    local track =
        playAnimation(
            CONFIG.SpawnAnimation,
            1,
            0.05
        )

    --------------------------------------------------------
    -- Character sound
    --------------------------------------------------------

    playSound(
        CONFIG.Sounds.Character,
        1.2
    )

    --------------------------------------------------------
    -- Aura
    --------------------------------------------------------

    createAura()

    --------------------------------------------------------
    -- Spawn VFX
    --------------------------------------------------------

    playKJVFX(
        "UserAura",
        3
    )

    playKJVFX(
        "feet",
        2
    )

    --------------------------------------------------------
    -- Camera
    --------------------------------------------------------

    fovPunch(10)

    cameraShake(
        1.5,
        0.35
    )

    --------------------------------------------------------
    -- Finish
    --------------------------------------------------------

    if track then

        track.Ended:Connect(
            function()

                if State.Active then
                    createAura()
                end

            end
        )

    end

end

------------------------------------------------------------
-- CLEANUP
------------------------------------------------------------

local function cleanup()

    stopAnimations()

    removeAura()

    for _, object
        in ipairs(
            State.Temporary
        ) do

        safeDestroy(object)

    end

    table.clear(
        State.Temporary
    )

    State.Busy = false
    State.Loading = false

end

------------------------------------------------------------
-- ACTIVATE KJ AFTER RESPAWN
------------------------------------------------------------

local function finishKJLoad()

    local character,
        humanoid,
        root

    local started =
        tick()

    repeat

        character,
            humanoid,
            root =
            getCharacter()

        if character then
            break
        end

        task.wait(0.1)

    until
        tick() - started >
        CONFIG.RespawnTimeout

    if not character then

        State.Loading = false

        notify(
            "KJ",
            "Character failed to load.",
            4
        )

        warn(
            "[KJ] CharacterAdded timeout"
        )

        return
    end

    State.Character =
        character

    State.Humanoid =
        humanoid

    State.Root =
        root

    State.Active =
        true

    State.OriginalWalkSpeed =
        humanoid.WalkSpeed

    State.OriginalJumpPower =
        humanoid.JumpPower

    humanoid.WalkSpeed =
        CONFIG.WalkSpeed

    humanoid.JumpPower =
        CONFIG.JumpPower

    --------------------------------------------------------
    -- Wait until character is actually ready
    --------------------------------------------------------

    task.wait(0.35)

    --------------------------------------------------------
    -- KJ spawn
    --------------------------------------------------------

    playKJSpawn()

    State.Loading = false

    notify(
        "KJ",
        "Character loaded. KJ is ready.",
        3
    )

    print(
        "[KJ] Character successfully loaded"
    )

end

------------------------------------------------------------
-- SELECT KJ
------------------------------------------------------------

local function selectKJ()

    if State.Loading then
        return
    end

    if State.Active then
        return
    end

    State.Loading = true

    notify(
        "Character switched",
        "Character switched to KJ",
        3
    )

    print(
        "[KJ] KJ selected"
    )

    --------------------------------------------------------
    -- Cleanup old local state
    --------------------------------------------------------

    cleanup()

    --------------------------------------------------------
    -- IMPORTANT
    --
    -- Character reload is requested through the local
    -- Humanoid. We do NOT invent a game-specific remote.
    --------------------------------------------------------

    local oldCharacter =
        player.Character

    local oldHumanoid =
        oldCharacter and
        oldCharacter:FindFirstChildOfClass(
            "Humanoid"
        )

    if oldHumanoid then

        pcall(function()

            oldHumanoid.Health = 0

        end)

    end

    --------------------------------------------------------
    -- Wait for CharacterAdded
    --------------------------------------------------------

    local newCharacter

    local connection

    connection =
        player.CharacterAdded:Connect(
            function(character)

                newCharacter =
                    character

            end
        )

    local started =
        tick()

    while
        not newCharacter
        and
        tick() - started <
        CONFIG.RespawnTimeout
    do

        task.wait(0.1)

        if player.Character
            and
            player.Character ~=
            oldCharacter
        then

            newCharacter =
                player.Character

        end

    end

    disconnect(connection)

    if not newCharacter then

        State.Loading = false

        notify(
            "KJ",
            "Respawn was not available. KJ could not load.",
            5
        )

        return
    end

    --------------------------------------------------------
    -- Wait for Humanoid / Root
    --------------------------------------------------------

    newCharacter:
        WaitForChild(
            "Humanoid",
            10
        )

    newCharacter:
        WaitForChild(
            "HumanoidRootPart",
            10
        )

    task.wait(0.25)

    --------------------------------------------------------
    -- Finish
    --------------------------------------------------------

    finishKJLoad()

end

------------------------------------------------------------
-- DEACTIVATE
------------------------------------------------------------

local function deactivateKJ()

    if not State.Active then
        return
    end

    State.Active = false

    cleanup()

    if State.Humanoid
        and
        State.Humanoid.Parent
    then

        if State.OriginalWalkSpeed then

            State.Humanoid.WalkSpeed =
                State.OriginalWalkSpeed

        end

        if State.OriginalJumpPower then

            State.Humanoid.JumpPower =
                State.OriginalJumpPower

        end

    end

    notify(
        "Character switched",
        "Returned to normal character.",
        3
    )

end

------------------------------------------------------------
-- TOPBAR FINDER
------------------------------------------------------------

local function findKJButton()

    local topbar =
        playerGui:FindFirstChild(
            "TopbarPlus"
        )

    if not topbar then
        return nil
    end

    local container =
        topbar:FindFirstChild(
            "TopbarContainer"
        )

    if not container then
        return nil
    end

    local unnamedIcon =
        container:FindFirstChild(
            "UnnamedIcon"
        )

    if not unnamedIcon then
        return nil
    end

    local dropdown =
        unnamedIcon:FindFirstChild(
            "DropdownContainer"
        )

    if not dropdown then
        return nil
    end

    local frame =
        dropdown:FindFirstChild(
            "DropdownFrame"
        )

    if not frame then
        return nil
    end

    return frame:FindFirstChild(
        "KJ"
    )

end

------------------------------------------------------------
-- KEEP KJ VISIBLE
------------------------------------------------------------

local function keepKJVisible()

    local kj =
        findKJButton()

    if not kj then
        return
    end

    pcall(function()

        kj.Visible = true

        if kj:IsA(
            "GuiButton"
        ) then

            kj.Active = true
            kj.Selectable = true

        end

    end)

end

------------------------------------------------------------
-- CONNECT KJ BUTTON
------------------------------------------------------------

local function connectKJButton()

    local kj =
        findKJButton()

    if not kj then
        return
    end

    if State.ConnectedButtons[kj] then
        return
    end

    State.ConnectedButtons[kj] =
        true

    print(
        "[KJ] Found KJ Topbar button:",
        kj:GetFullName()
    )

    --------------------------------------------------------
    -- GUI BUTTON
    --------------------------------------------------------

    if kj:IsA(
        "GuiButton"
    ) then

        addConnection(
            kj.MouseButton1Click:Connect(
                function()

                    print(
                        "[KJ] TOPBAR CLICK DETECTED"
                    )

                    selectKJ()

                end
            )
        )

        return
    end

    --------------------------------------------------------
    -- If KJ is a Frame containing a button
    --------------------------------------------------------

    local button =
        kj:FindFirstChildWhichIsA(
            "GuiButton",
            true
        )

    if button then

        State.ConnectedButtons[button] =
            true

        addConnection(
            button.MouseButton1Click:Connect(
                function()

                    print(
                        "[KJ] INNER BUTTON CLICK DETECTED"
                    )

                    selectKJ()

                end
            )
        )

    end

end

------------------------------------------------------------
-- INPUT
------------------------------------------------------------

addConnection(
    UserInputService.InputBegan:Connect(
        function(
            input,
            processed
        )

            if processed then
                return
            end

            ------------------------------------------------
            -- K TOGGLE
            ------------------------------------------------

            if input.KeyCode ==
                Enum.KeyCode.K
            then

                if State.Active then
                    deactivateKJ()
                else
                    selectKJ()
                end

                return

            end

            if not State.Active then
                return
            end

            ------------------------------------------------
            -- MOVE 1
            ------------------------------------------------

            if input.KeyCode ==
                Enum.KeyCode.One
            then

                playAnimation(
                    CONFIG.KJAnimations.WallCombo,
                    1,
                    0.05
                )

                playKJVFX(
                    "hold",
                    1
                )

                task.delay(
                    0.35,
                    function()

                        playSound(
                            CONFIG.Sounds.Hit,
                            1.2
                        )

                        playKJVFX(
                            "ImpactEffect",
                            1
                        )

                    end
                )

                task.delay(
                    0.7,
                    function()

                        playSound(
                            CONFIG.Sounds.Hit,
                            1.6
                        )

                        playKJVFX(
                            "FinalImpact",
                            2
                        )

                        playKJVFX(
                            "slam",
                            1.5
                        )

                        cameraShake(
                            5,
                            0.35
                        )

                        fovPunch(15)

                    end
                )

            ------------------------------------------------
            -- MOVE 2
            ------------------------------------------------

            elseif input.KeyCode ==
                Enum.KeyCode.Two
            then

                for i = 1, 10 do

                    if not State.Active then
                        break
                    end

                    playSound(
                        CONFIG.Sounds.Hit,
                        0.35,
                        1 +
                        math.random(
                            -10,
                            10
                        ) / 100
                    )

                    playKJVFX(
                        "HitParticles",
                        0.25
                    )

                    cameraShake(
                        0.3,
                        0.05
                    )

                    task.wait(0.12)

                end

            ------------------------------------------------
            -- MOVE 3
            ------------------------------------------------

            elseif input.KeyCode ==
                Enum.KeyCode.Three
            then

                playAnimation(
                    CONFIG.KJAnimations.WallCombo,
                    1.2,
                    0.05
                )

                task.wait(0.25)

                playSound(
                    CONFIG.Sounds.Hit,
                    1.5
                )

                playKJVFX(
                    "uppercutimpact",
                    1
                )

                playKJVFX(
                    "uppercutmesh",
                    1
                )

                cameraShake(
                    3,
                    0.25
                )

            ------------------------------------------------
            -- MOVE 4
            ------------------------------------------------

            elseif input.KeyCode ==
                Enum.KeyCode.Four
            then

                playAnimation(
                    CONFIG.KJAnimations.WallCombo,
                    0.9,
                    0.05
                )

                playKJVFX(
                    "hold",
                    1
                )

                task.wait(0.5)

                playSound(
                    CONFIG.Sounds.Hit,
                    1.8
                )

                playKJVFX(
                    "lastimpact",
                    1.5
                )

                playKJVFX(
                    "FinalImpact",
                    2
                )

                cameraShake(
                    7,
                    0.45
                )

                fovPunch(20)

            ------------------------------------------------
            -- ULTIMATE
            ------------------------------------------------

            elseif input.KeyCode ==
                Enum.KeyCode.G
            then

                notify(
                    "KJ",
                    "ULTIMATE ACTIVATED",
                    2
                )

                playSound(
                    CONFIG.Sounds.Character,
                    1.7
                )

                playKJVFX(
                    "UserAura",
                    3
                )

                playKJVFX(
                    "SPINNNN",
                    2
                )

                playKJVFX(
                    "tpthing",
                    2
                )

                fovPunch(25)

                cameraShake(
                    8,
                    0.8
                )

                task.wait(0.8)

                playSound(
                    CONFIG.Sounds.Hit,
                    2
                )

                playKJVFX(
                    "FinalImpact",
                    3
                )

                playKJVFX(
                    "FinalImpactHUGEignore",
                    3
                )

                playKJVFX(
                    "slam",
                    2
                )

                cameraShake(
                    10,
                    0.7
                )

                fovPunch(30)

            end

        end
    )
)

------------------------------------------------------------
-- CHARACTER ADDED
------------------------------------------------------------

addConnection(
    player.CharacterAdded:Connect(
        function(character)

            print(
                "[KJ] CharacterAdded:",
                character:GetFullName()
            )

            if State.Loading then

                task.spawn(
                    function()

                        character:
                            WaitForChild(
                                "Humanoid",
                                10
                            )

                        character:
                            WaitForChild(
                                "HumanoidRootPart",
                                10
                            )

                    end
                )

                return
            end

            ------------------------------------------------
            -- If KJ was active and Roblox/game respawned,
            -- restore KJ presentation.
            ------------------------------------------------

            if State.Active then

                task.wait(0.5)

                setupCharacter()

                if State.Humanoid then

                    State.Humanoid.WalkSpeed =
                        CONFIG.WalkSpeed

                    State.Humanoid.JumpPower =
                        CONFIG.JumpPower

                end

                createAura()

                task.spawn(
                    playKJSpawn
                )

            end

        end
    )
)

