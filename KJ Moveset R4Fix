local function inspect(name)
    local cutscenes = ReplicatedStorage:FindFirstChild("Cutscenes")

    if not cutscenes then
        return name .. ": Cutscenes folder missing"
    end

    local module = cutscenes:FindFirstChild(name)

    if not module then
        return name .. ": MODULE NOT FOUND"
    end

    if not module:IsA("ModuleScript") then
        return name .. ": " .. module.ClassName
    end

    local ok, result = pcall(require, module)

    if not ok then
        return name .. ": REQUIRE ERROR\n" .. tostring(result)
    end

    local lines = {}

    table.insert(lines, name .. ":")
    table.insert(lines, "Return type: " .. typeof(result))

    if typeof(result) == "table" then

        local count = 0

        for key, value in pairs(result) do
            count += 1

            local valueType = typeof(value)

            if type(value) == "function" then
                valueType = "FUNCTION"
            elseif typeof(value) == "Instance" then
                valueType = "INSTANCE [" .. value.ClassName .. "]"
            end

            table.insert(
                lines,
                tostring(key) .. " = " .. valueType
            )

            if count >= 20 then
                table.insert(lines, "...more keys...")
                break
            end
        end

        if count == 0 then
            table.insert(lines, "(EMPTY TABLE)")
        end

    elseif typeof(result) == "Instance" then

        table.insert(
            lines,
            "Instance: " .. result:GetFullName()
        )

    else

        table.insert(
            lines,
            "Value: " .. tostring(result)
        )

    end

    return table.concat(lines, "\n")
end

