local function punchEffect(index)
    local character = state.Character

    if not character then
        return
    end

    local targetPart =
        character:FindFirstChild("RightHand")
        or character:FindFirstChild("Right Arm")
        or getRoot(character)

    if not targetPart then
        return
    end

    local punchFX = getPunchFX()

    if not punchFX then
        return
    end

    local effect = attachResource(
        punchFX,
        targetPart
    )

    if effect then
        task.delay(
            0.45,
            function()
                destroyInstance(effect)
            end
        )
    end
end

