        ReplicatedStorage,
        Workspace,
        player,
        player:FindFirstChild("PlayerGui"),
        player:FindFirstChild("Backpack"),
        player.Character,
    }
end

--============================================================
-- OBJECT SNAPSHOT
--============================================================

local function snapshot()
    local result = {}

    for _, root in ipairs(getRoots()) do
        if root then

            result[root] = true

            for _, obj in ipairs(root:GetDescendants()) do
                result[obj] = true
            end

        end
    end

    return result
end

