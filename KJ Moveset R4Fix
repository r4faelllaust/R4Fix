--============================================================
-- INSPECT EXPORTS
--============================================================

local function getExports(module)
    local output = {}

    if typeof(module) == "table" then

        for name, value in pairs(module) do
            table.insert(
                output,
                tostring(name).." = "..typeof(value)
            )
        end

    else
        table.insert(
            output,
            "RETURN TYPE = "..typeof(module)
        )
    end

    table.sort(output)

    return output
end

local attackExports = getExports(attack)
local kjExports = getExports(kj)

local text =
    "ATTACK MODULE: LOADED\n" ..
