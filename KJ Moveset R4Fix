    log("KJ RESOURCE INITIALIZATION")
    log("================================================")

    local resources = getResources()

    if not resources then
        warnKJ("ReplicatedStorage.Resources NOT FOUND")
        return
    end

    log("Resources: FOUND")

    local kjEffects = resources:FindFirstChild("KJEffects")

    if kjEffects then
        log("KJEffects: FOUND")

        for _, name in ipairs({
            "KJWallCombo",
            "KJThrow",
        }) do
            local object = findRecursive(kjEffects, name)

            if object then
                log(name, "FOUND:", object.ClassName, object:GetFullName())
            else
                warnKJ(name, "NOT FOUND")
            end
        end
    else
        warnKJ("KJEffects NOT FOUND")
    end

    local ufw = resources:FindFirstChild("UFW")

    if ufw then
        log("Resources.UFW: FOUND")

        for _, name in ipairs({
            "TekrinnDialogue",
            "PunchFX",
            "Everything",
            "KJWallBreak",
        }) do
            local object = findRecursive(ufw, name)

            if object then
                log(
                    name,
                    "FOUND:",
                    object.ClassName,
                    object:GetFullName()
                )
            else
                log(name, "not directly found")
            end
        end
    else
        warnKJ("Resources.UFW NOT FOUND")
    end

    local cutscenes = ReplicatedStorage:FindFirstChild("Cutscenes")

    if cutscenes then
        local kjCutscene = findRecursive(cutscenes, "KJ")

        if kjCutscene then
            log(
                "Cutscenes.KJ FOUND:",
                kjCutscene.ClassName,
                kjCutscene:GetFullName()
            )
        else
            warnKJ("Cutscenes.KJ NOT FOUND")
        end
    end

    log("================================================")
end

--============================================================
-- FIND REAL KJ ANIMATIONS
--============================================================

local function collectKJAnimations()
    local results = {}

    local resources = getResources()

    if not resources then
        return results
    end

    local function scan(root)
        if not root then
            return
        end

        for _, object in ipairs(root:GetDescendants()) do
            if object:IsA("Animation") then
                table.insert(results, object)
            end
        end
    end

    scan(resources)

    return results
end

local function findAnimationByKeywords(keywords)
    local animations = collectKJAnimations()

    for _, animation in ipairs(animations) do

        local name = string.lower(animation.Name)
        local path = string.lower(animation:GetFullName())

        for _, keyword in ipairs(keywords) do

            local wanted = string.lower(keyword)

            if string.find(name, wanted, 1, true)
                or string.find(path, wanted, 1, true)
            then
                return animation
            end

        end
    end

    return nil
end

local function reportKJAnimations()
    local animations = collectKJAnimations()

    log("Accessible KJ Animation instances:", #animations)

    for _, animation in ipairs(animations) do
        log(
            "ANIMATION:",
            animation.Name,
            "|",
            animation.AnimationId,
            "|",
            animation:GetFullName()
        )
    end
end

--============================================================
-- ANIMATION LOADING
--============================================================

local function setupAnimator()
    local character = getCharacter()

    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return false
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    State.Character = character
    State.Humanoid = humanoid
    State.Animator = animator

    return true
end

local function playAnimation(animationId, priority, speed)
    if not setupAnimator() then
        return nil
    end

    if not animationId or animationId == "" then
        return nil
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = animationId

    table.insert(State.Animations, animation)

    local track = safe(function()
        return State.Animator:LoadAnimation(animation)
    end, nil)

    if not track then
        animation:Destroy()
        return nil
    end

    track.Priority = priority or Enum.AnimationPriority.Action
    track.Looped = false

    safe(function()
        track:Play(0.1, 1, speed or 1)
    end)

    return track
end

local function playResourceAnimation(animationObject)
    if not animationObject then
        return nil
    end

    if not animationObject:IsA("Animation") then
        return nil
    end

    if not setupAnimator() then
        return nil
    end

    local track = safe(function()
        return State.Animator:LoadAnimation(animationObject)
    end, nil)

    if not track then
        return nil
    end

    track.Priority = Enum.AnimationPriority.Action
    track.Looped = false

    safe(function()
        track:Play(0.1, 1, 1)
    end)

    return track
end

--============================================================
-- SOUND
--============================================================

local function playSound(soundId, volume, speed)
    local root = getRoot()

    if not root then
        return nil
    end

    local sound = Instance.new("Sound")

    sound.SoundId = soundId
    sound.Volume = volume or 1
    sound.PlaybackSpeed = speed or 1
    sound.RollOffMaxDistance = 100
    sound.RollOffMinDistance = 5

    sound.Parent = root

    table.insert(State.Sounds, sound)

    safe(function()
        sound:Play()
    end)

    Debris:AddItem(sound, 10)

    return sound
end

--============================================================
-- VFX CLONING
--============================================================

local function enableParticleEmitters(root)
    if not root then
        return
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter") then
            object.Enabled = true

        elseif object:IsA("Beam") then
            object.Enabled = true

        elseif object:IsA("Trail") then
            object.Enabled = true

        elseif object:IsA("PointLight")
            or object:IsA("SpotLight")
            or object:IsA("SurfaceLight")
        then
            object.Enabled = true
        end

    end
end

local function emitParticles(root)
    if not root then
        return
    end

    for _, object in ipairs(root:GetDescendants()) do
        if object:IsA("ParticleEmitter") then

            local count = object:GetAttribute("EmitCount")

            if typeof(count) == "number" then
                object:Emit(count)
            else
                object:Emit(10)
            end

        end
    end
end

local function moveInstanceToRoot(object, root)
    if not object or not root then
        return
    end

    if object:IsA("Model") then

        local pivot = safe(function()
            return object:GetPivot()
        end, nil)

        if pivot then
            safe(function()
                object:PivotTo(root.CFrame)
            end)
        end

    elseif object:IsA("BasePart") then

        object.CFrame = root.CFrame

    elseif object:IsA("Attachment") then

        object.Parent = root

    end
end

local function cloneVFX(resource, lifetime)
    local root = getRoot()

    if not resource or not root then
        return nil
    end

    local clone = safe(function()
        return resource:Clone()
    end, nil)

    if not clone then
        warnKJ("Could not clone:", resource:GetFullName())
        return nil
    end

    clone.Parent = workspace

    moveInstanceToRoot(clone, root)

    enableParticleEmitters(clone)
    emitParticles(clone)

    table.insert(State.Effects, clone)

    if lifetime then
        Debris:AddItem(clone, lifetime)
    end

    return clone
end

--============================================================
-- ATTACH AURA
--============================================================

local function removeAura()
    if State.Aura then
        safe(function()
            State.Aura:Destroy()
        end)

        State.Aura = nil
    end
end

local function createAura()
    removeAura()

    local ufw = getUFW()

    if not ufw then
        warnKJ("Cannot create aura: Resources.UFW missing")
        return
    end

    local everything = findRecursive(ufw, "Everything")

    if not everything then
        warnKJ("Everything resource missing")
        return
    end

    local kj = findRecursive(everything, "KJ")

    if not kj then
        warnKJ("Everything.KJ missing")
        return
    end

    local root = getRoot()

    if not root then
        return
    end

    local aura = safe(function()
        return kj:Clone()
    end, nil)

    if not aura then
        return
    end

    aura.Parent = root

    if aura:IsA("Model") then

        local primary =
            aura.PrimaryPart
            or aura:FindFirstChildWhichIsA("BasePart", true)

        if primary then
            primary.Anchored = false
            primary.CanCollide = false
            primary.CFrame = root.CFrame

            local weld = Instance.new("WeldConstraint")
            weld.Part0 = root
            weld.Part1 = primary
            weld.Parent = primary
        end

    end

    enableParticleEmitters(aura)

    State.Aura = aura

    log("KJ AURA ACTIVE")
end

--============================================================
-- CAMERA
--============================================================

local function getCamera()
    return workspace.CurrentCamera
end

local function cameraFOV(value, duration)
    local camera = getCamera()

    if not camera then
        return
    end

    local tween = TweenService:Create(
        camera,
        TweenInfo.new(
            duration or 0.25,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            FieldOfView = value
        }
    )

    tween:Play()
end

local function cameraShake(duration, intensity)
    local camera = getCamera()

    if not camera then
        return
    end

    local start = os.clock()

    local connection

    connection = RunService.RenderStepped:Connect(function()

        if os.clock() - start >= duration then
            connection:Disconnect()
            return
        end

        local x =
            (math.random() - 0.5)
            * intensity

        local y =
            (math.random() - 0.5)
            * intensity

        local z =
            (math.random() - 0.5)
            * intensity

        camera.CFrame =
            camera.CFrame
            * CFrame.Angles(
                math.rad(x),
                math.rad(y),
                math.rad(z)
            )

    end)

    table.insert(State.Connections, connection)
end

--============================================================
-- DIALOGUE
--============================================================

local function tryDialogue(text)
    local resources = getResources()

    if not resources then
        return
    end

    local ufw = resources:FindFirstChild("UFW")

    if not ufw then
        return
    end

    local dialogueModule =
        ufw:FindFirstChild("TekrinnDialogue")

    if not dialogueModule then
        warnKJ("TekrinnDialogue not found")
        return
    end

    if not dialogueModule:IsA("ModuleScript") then
        warnKJ("TekrinnDialogue is not a ModuleScript")
        return
    end

    local dialogue = safe(function()
        return require(dialogueModule)
    end, nil)

    if not dialogue then
        warnKJ("Could not require TekrinnDialogue")
        return
    end

    if type(dialogue) ~= "table" then
        warnKJ("Dialogue module returned unsupported type")
        return
    end

    if type(dialogue.Speak) ~= "function" then
        warnKJ("TekrinnDialogue.Speak was not exposed")
        return
    end

    safe(function()
        dialogue.Speak({
            {
                Text = text,
                Bold = true,
                Italic = false,
                TypeSpeed = 0.03,
                TextStrokeColor = Color3.new(0, 0, 0),
                Shake = {
                    Enabled = false,
                    Intensity = 1,
                    Lifetime = 1,
                }
            }
        })
    end)
end

--============================================================
-- COOLDOWNS
--============================================================

local function isCooldown(name)
    local untilTime = State.Cooldowns[name]

    if not untilTime then
        return false
    end

    return os.clock() < untilTime
end

local function startCooldown(name)
    local duration = CONFIG.Cooldowns[name]

    if duration then
        State.Cooldowns[name] = os.clock() + duration
    end
end

--============================================================
-- BUSY
--============================================================

local function beginMove(name)
    if not State.Enabled then
        return false
    end

    if State.Busy then
        return false
    end

    if isCooldown(name) then
        return false
    end

    State.Busy = true
    startCooldown(name)

    return true
end

local function finishMove()
    State.Busy = false
end

