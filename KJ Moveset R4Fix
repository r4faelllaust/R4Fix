local function captureRemotes()
    section("KJ / UFW RELATED REMOTES")

    local count = 0

    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do

        if
            obj:IsA("RemoteEvent")
            or obj:IsA("RemoteFunction")
        then

            if interesting(obj) then

                count += 1

                line(
                    "[" ..
