local RS = game:GetService("ReplicatedStorage")

local function deepInfo(obj, depth)
	depth = depth or 0
	if depth > 4 then return end
	local indent = string.rep("  ", depth)
	print(indent .. obj.Name .. " [" .. obj.ClassName .. "]")
	for _, child in ipairs(obj:GetChildren()) do
		deepInfo(child, depth + 1)
	end
end

print("===== KJEffects Structure =====")
local kjEffects = RS:FindFirstChild("Resources") and RS.Resources:FindFirstChild("KJEffects")
if kjEffects then
	deepInfo(kjEffects)
else
	print("KJEffects not found")
end

print("\n===== Everything.KJ =====")
local everything = RS:FindFirstChild("Resources") and RS.Resources:FindFirstChild("UFW") and RS.Resources.UFW:FindFirstChild("vfx") and RS.Resources.UFW.vfx:FindFirstChild("Everything")
if everything and everything:FindFirstChild("KJ") then
	deepInfo(everything.KJ)
end

print("\n===== KJWallCombo =====")
local wallCombo = RS:FindFirstChild("Resources") and RS.Resources:FindFirstChild("KJEffects") and RS.Resources.KJEffects:FindFirstChild("KJWallCombo", true)
if wallCombo then
	print("Found at:", wallCombo:GetFullName())
	deepInfo(wallCombo)
end

print("\n===== Cutscenes.KJ =====")
local cutscene = RS:FindFirstChild("Cutscenes") and RS.Cutscenes:FindFirstChild("KJ")
if cutscene then
	print("Class:", cutscene.ClassName)
	print("FullName:", cutscene:GetFullName())
end

print("\n===== TekrinnDialogue =====")
