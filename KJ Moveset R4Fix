local function screenFlash()

    local gui =
        Instance.new("ScreenGui")

    gui.Name =
        "KJ_Client_Flash"

    gui.ResetOnSpawn =
        false

    gui.IgnoreGuiInset =
        true

    gui.Parent =
        PlayerGui

    local frame =
        Instance.new("Frame")

    frame.Size =
        UDim2.fromScale(1, 1)

    frame.BackgroundColor3 =
        Color3.new(1, 1, 1)

    frame.BackgroundTransparency =
        0

    frame.BorderSizePixel =
        0

    frame.Parent =
        gui

    local tween =
        TweenService:Create(
            frame,
            TweenInfo.new(
                0.35,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundTransparency = 1
            }
        )

    tween:Play()

    table.insert(
        State.Effects,
        gui
    )

    tween.Completed:Connect(function()

        if gui and gui.Parent then
            gui:Destroy()
        end

    end)

end

--============================================================
-- DIALOGUE
--============================================================

local function tryKJDialogue(text)

    local dialogueModule =
        ReplicatedStorage
            :FindFirstChild("UFW")

    dialogueModule =
        dialogueModule
        and dialogueModule:FindFirstChild(
            "TekrinnDialogue"
        )

    if not dialogueModule then
        return false
    end

    if not dialogueModule:IsA("ModuleScript") then
        return false
    end

    local success, dialogue =
        pcall(require, dialogueModule)

    if not success or not dialogue then
        return false
    end

    if type(dialogue) ~= "table" then
        return false
    end

    if type(dialogue.Speak) ~= "function" then
        return false
    end

    local ok =
        pcall(function()

            dialogue.Speak({

                {
                    Text = text,

                    Bold = true,

                    Italic = false,

                    TypeSpeed = 0.035,

                    Color =
                        ColorSequence.new({

                            ColorSequenceKeypoint.new(
                                0,
                                Color3.fromRGB(
                                    0,
                                    0,
                                    0
                                )
                            ),

                            ColorSequenceKeypoint.new(
                                0.5,
                                Color3.fromRGB(
                                    255,
                                    30,
                                    30
                                )
                            ),

                            ColorSequenceKeypoint.new(
                                1,
                                Color3.fromRGB(
                                    255,
                                    255,
                                    255
                                )
                            )
                        }),

                    TextStrokeColor =
                        Color3.new(
                            0,
                            0,
                            0
                        ),

                    Shake = {

                        Enabled = true,

                        Intensity = 1,

                        Lifetime = 1.5
                    }
                }

            })

        end)

    return ok

end

--============================================================
-- MOVE VFX
--============================================================

local function moveVFX(move)

    if not State.KJActive then
        return
    end

    -- Existing KJ assets only.
    --
    -- We intentionally do not create fake particle
    -- emitters here.

    if move == "Ravage" then

        spawnKJResource(
            "KJThrow",
            2
        )

        spawnKJResource(
            "PunchFX",
            1
        )

    elseif move == "Swift Sweep" then

        spawnKJResource(
            "PunchFX",
            1
        )

        spawnKJResource(
            "RockJump",
            2
        )

    elseif move == "Collateral Ruin" then

        spawnKJResource(
            "PunchFX",
            1.5
        )

        spawnKJResource(
            "KJ",
            2
        )

    elseif move == "Spiraling Storm" then

        spawnKJResource(
            "Everything",
            2
        )

        spawnKJResource(
            "PunchFX",
            1.5
        )

    elseif move == "Stoic Bomb" then

        spawnKJResource(
            "KJWallBreak",
            3
        )

    elseif move == "20-20-20 Dropkick" then

        spawnKJResource(
            "PunchFX",
            2
        )

        spawnKJResource(
            "RockJump",
            2
        )

    elseif move == "Five Seasons" then

        spawnKJResource(
            "KJThrow",
            3
        )

        spawnKJResource(
            "Everything",
            2
        )

    elseif move == "Unlimited Flexworks" then

        spawnKJResource(
            "Everything",
            4
        )

    end

end

