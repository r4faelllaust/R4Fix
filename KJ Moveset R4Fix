local function screenFlash(
    transparency,
    duration
)

    local gui =
        Instance.new("ScreenGui")

    gui.Name =
        "KJLocalFlash"

    gui.IgnoreGuiInset =
        true

    gui.ResetOnSpawn =
        false

    gui.DisplayOrder =
        100000

    gui.Parent =
        playerGui

    local frame =
        Instance.new("Frame")

    frame.Size =
        UDim2.fromScale(1, 1)

    frame.Position =
        UDim2.fromScale(0, 0)

    frame.BorderSizePixel =
        0

    frame.BackgroundColor3 =
        Color3.new(1, 1, 1)

    frame.BackgroundTransparency =
        1

    frame.Parent =
        gui

    local appear =
        TweenService:Create(
            frame,
            TweenInfo.new(
                0.06,
                Enum.EasingStyle.Linear
            ),
            {
                BackgroundTransparency =
                    transparency or 0.15
            }
        )

    appear:Play()

    appear.Completed:Connect(
        function()

            local disappear =
                TweenService:Create(
                    frame,
                    TweenInfo.new(
                        duration or 0.25,
                        Enum.EasingStyle.Quad
                    ),
                    {
                        BackgroundTransparency = 1
                    }
                )

            disappear:Play()

            disappear.Completed:Connect(
                function()

                    if gui.Parent then
                        gui:Destroy()
                    end

                end
            )

        end
    )

    table.insert(
        state.Effects,
        gui
    )

end

--============================================================
-- DIALOGUE
--============================================================

local dialogueModule

local function loadDialogue()

    if dialogueModule then
        return dialogueModule
    end

    if not TekrinnDialogue then
        return nil
    end

    if not TekrinnDialogue:IsA("ModuleScript") then
        return nil
    end

    local success, result =
        pcall(require, TekrinnDialogue)

    if not success then

        warn(
            "[KJ] TekrinnDialogue require failed:",
            result
        )

        return nil
    end

    dialogueModule = result

    return dialogueModule
end

local function playDialogue(text)

    local dialogue =
        loadDialogue()

    if not dialogue then
        return false
    end

    if type(dialogue) ~= "table" then
        return false
    end

    if type(dialogue.Speak) ~= "function" then
        warn(
            "[KJ] TekrinnDialogue does not expose Speak()"
        )

        return false
    end

    local success, result =
        pcall(function()

            dialogue.Speak({

                {
                    Text = text,

                    Bold = true,

                    Italic = false,

                    TypeSpeed = 0.025,

                    Color =
                        ColorSequence.new({

                            ColorSequenceKeypoint.new(
                                0,
                                Color3.fromRGB(
                                    255,
                                    255,
                                    255
                                )
                            ),

                            ColorSequenceKeypoint.new(
                                0.45,
                                Color3.fromRGB(
                                    255,
                                    40,
                                    40
                                )
                            ),

                            ColorSequenceKeypoint.new(
                                1,
                                Color3.fromRGB(
                                    255,
                                    255,
                                    255
                                )
                            ),

                        }),

                    TextStrokeColor =
                        Color3.new(0, 0, 0),

                    Shake = {
                        Enabled = false,
                        Intensity = 1,
                        Lifetime = 2,
                    },

                },

            })

        end)

    if not success then

        warn(
            "[KJ] Dialogue error:",
            result
        )

    end

    return success
end

