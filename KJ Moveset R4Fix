--============================================================

local function findRecursive(root, name)

    if not root then
        return nil
    end

    local direct = root:FindFirstChild(name)

    if direct then
        return direct
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object.Name == name then
            return object
        end

    end

    return nil
end

local function findAllRecursive(root, name)

    local results = {}

    if not root then
        return results
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object.Name == name then
            table.insert(results, object)
        end

    end

    return results
end

