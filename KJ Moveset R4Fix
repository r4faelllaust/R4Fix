--============================================================
-- FONT
--============================================================

local function applyFont(label)

    if not label then
        return
    end

    if label:IsA("TextLabel")
        or label:IsA("TextButton") then

        pcall(function()

            label.FontFace =
                Font.new(
                    label.FontFace.Family,
                    Enum.FontWeight.Thin,
                    Enum.FontStyle.Normal
                )

            label.Font = CONFIG.Font

        end)

    end

end

--============================================================
-- SAVE ORIGINAL MOVE NAME
--============================================================

local function saveOriginalName(label)

    if not label then
        return
    end

    if State.OriginalNames[label] == nil then

        State.OriginalNames[label] =
            label.Text

    end

end

--============================================================
-- SET MOVE NAME
--============================================================

local function setMoveName(number, text)

    local base =
        getBaseButton(number)

    if not base then
        return
