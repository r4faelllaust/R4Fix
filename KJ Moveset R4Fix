--============================================================

local function notify(title, text, duration)

    duration = duration or 3

    pcall(function()

        StarterGui:SetCore("SendNotification", {

            Title = title,

            Text = text,

            Icon = "",

            Duration = duration
        })

    end)

end

--============================================================
-- SWITCH COOLDOWN
--============================================================

local function getRemainingCooldown()

    local remaining =
        CONFIG.SwitchCooldown -
        (os.clock() - State.LastSwitch)

    return math.max(0, remaining)

end

local function notifySwitchCooldown()

    local remaining =
        math.ceil(getRemainingCooldown())

    if remaining < 1 then
        remaining = 1
    end

    notify(
        "BENACHRICHTIGUNG",
        "Du änderst deinen Charakter zu schnell.\n(" ..
        tostring(remaining) ..
        ")",
        2
    )

end

local function notifyAlreadyKJ()

    notify(
        "BENACHRICHTIGUNG",
        "Du verwendest diesen Charakter bereits.",
        3
    )

end

