--============================================================
-- CONNECTION MANAGEMENT
--============================================================

local function disconnect(connection)
    if connection then
        pcall(function()
            connection:Disconnect()
        end)
    end
end

local function clearConnectionList(list)
    for _, connection in ipairs(list) do
        disconnect(connection)
    end

    table.clear(list)
end

local function trackConnection(list, connection)
    if connection then
        table.insert(list, connection)
    end

    return connection
end

--============================================================
-- DELAY MANAGEMENT
--============================================================

local function delayed(seconds, callback)
    local cancelled = false

    local token = {
        Cancel = function()
            cancelled = true
        end
    }

    table.insert(state.DelayedTasks, token)

    task.delay(seconds, function()

        if cancelled then
            return
        end

        if not state.Enabled then
            return
        end

        pcall(callback)
    end)

    return token
end

local function clearDelayedTasks()
    for _, token in ipairs(state.DelayedTasks) do
        pcall(function()
            token.Cancel()
        end)
    end

    table.clear(state.DelayedTasks)
end

