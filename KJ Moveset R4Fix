--============================================================
-- TRACK ANIMATION IDS
--============================================================

local function getAnimationId(track)

    if not track then
        return nil
    end

    local animation =
        track.Animation

    if not animation then
        return nil
    end

    local id =
        animation.AnimationId

    if not id then
        return nil
    end

    return id:match("%d+")

end

--============================================================
-- M1 COUNTER
--============================================================

local M1Index = 0

local function nextM1()

    M1Index += 1

    if M1Index > 4 then
        M1Index = 1
    end

    return M1Index

end

--============================================================
-- HANDLE ORIGINAL ANIMATION
--============================================================

local function handleAnimation(track)

    if not State.KJActive then
        return
    end

    if not track then
        return
    end

    local animationId =
        getAnimationId(track)

    if not animationId then
        return
    end

    -- Prevent the KJ animation itself from
    -- recursively triggering the replacement.
    if string.find(
        animationId,
        "^173255"
    ) then

        return

    end

    if animationId == CONFIG.WallCombo then
        return
    end

    local replacement =
        KJAnimationMap[animationId]

    if not replacement then
        return
    end

    -- Stop only the original track.
    pcall(function()
        track:Stop(0)
    end)

    local replacementTrack

    -- M1
    if animationId == "10469493270"
        or animationId == "10469630950"
        or animationId == "10469639222"
        or animationId == "10469643643" then

        local index =
            nextM1()

        replacementTrack =
            playAnimation(
                CONFIG.M1[index],
                1,
                false
            )

        moveVFX(
            "Ravage"
        )

    -- Normal moves
    elseif animationId == "10468665991" then

        replacementTrack =
            playAnimation(
                CONFIG.Ravage.Attempt,
                1,
                false
            )

        moveVFX(
            "Ravage"
        )

    elseif animationId == "10466974800" then

        replacementTrack =
            playAnimation(
                CONFIG.SwiftSweep.Startup,
                1,
                false
            )

        moveVFX(
            "Swift Sweep"
        )

    elseif animationId == "10471336737" then

        replacementTrack =
            playAnimation(
                CONFIG.CollateralRuin.Player,
                1,
                false
            )

        moveVFX(
            "Collateral Ruin"
        )

    elseif animationId == "12510170988" then

        replacementTrack =
            playAnimation(
                CONFIG.SpiralingStorm.Startup,
                1,
                false
            )

        moveVFX(
            "Spiraling Storm"
        )

    -- Wall
    elseif animationId == "15955393872" then

        replacementTrack =
            playAnimation(
                CONFIG.WallCombo,
                1,
                false
            )

        spawnKJResource(
            "KJWallCombo",
            5
        )

    -- Ultimate
    elseif animationId == "12447707844" then

        replacementTrack =
            playAnimation(
                CONFIG.Ultimate.Activation,
                1,
                false
            )

        State.UltimateActive =
            true

        createAura()

    elseif animationId == "11343318134" then

        replacementTrack =
            playAnimation(
                CONFIG.Ultimate.StoicBomb,
                1,
                false
            )

        moveVFX(
            "Stoic Bomb"
        )

    elseif animationId == "11365563255" then

        replacementTrack =
            playAnimation(
                CONFIG.Ultimate.DropkickPlayer,
                1,
                false
            )

        moveVFX(
            "20-20-20 Dropkick"
        )

    elseif animationId == "13927612951" then

        replacementTrack =
            playAnimation(
                CONFIG.Ultimate.FiveSeasonsAttack,
                1,
                false
            )

        moveVFX(
            "Five Seasons"
        )

    end

    if replacementTrack then

        replacementTrack.Stopped:Connect(function()

            for i = #State.Animations, 1, -1 do

                if State.Animations[i]
                    == replacementTrack then

                    table.remove(
                        State.Animations,
                        i
                    )

                    break
                end

            end

        end)

    end

end

--============================================================
-- CHARACTER SETUP
--============================================================

local function setupCharacter(character)

    disconnectList(
        State.CharacterConnections
    )

    stopKJAnimations()

    destroyTrackedEffects()

    State.Character =
        character

    State.Humanoid =
        character:WaitForChild(
            "Humanoid",
            10
        )

    if not State.Humanoid then
        return
    end

    State.Animator =
        State.Humanoid:FindFirstChildOfClass(
            "Animator"
        )

    if not State.Animator then

        State.Animator =
            Instance.new("Animator")

        State.Animator.Parent =
            State.Humanoid

    end

    -- Animation listener
    trackConnection(
        State.Humanoid.AnimationPlayed:Connect(
            handleAnimation
        ),
        true
    )

    -- Death handling
    trackConnection(
        State.Humanoid.Died:Connect(function()

            if State.KJActive then

                -- Keep the state active.
                -- When the new character appears,
                -- KJ is automatically restored.

                State.Busy =
                    false

                State.UltimateActive =
                    false

            end

        end),
        true
    )

    -- Character child protection
    trackConnection(
        character.ChildAdded:Connect(function(child)

            -- Remove the old Saitama barrage arm effect
            -- when it appears while KJ is active.

            if State.KJActive
                and child:IsA("Accessory")
                and child.Name == "BarrageBind" then

                pcall(function()
                    child:SetAttribute(
                        "Times",
                        nil
                    )
                end)

            end

        end),
        true
    )

    if State.KJActive then

        task.delay(
            0.5,
            function()

                if State.KJActive
                    and State.Character == character then

                    createAura()

                    applyNormalMoveNames()

                    playSpawn()

                end

            end
        )

    end

end

