--============================================================
-- INPUT
--============================================================

local ACTION_M1 = "KJ_M1"
local ACTION_MOVE1 = "KJ_Move1"
local ACTION_MOVE2 = "KJ_Move2"
local ACTION_MOVE3 = "KJ_Move3"
local ACTION_MOVE4 = "KJ_Move4"
local ACTION_ULT = "KJ_Ultimate"

local function inputAction(actionName, inputState)

    if inputState ~= Enum.UserInputState.Begin then
        return
    end

    if not state.Enabled then
        return
    end

    if actionName == ACTION_M1 then
        doM1()

    elseif actionName == ACTION_MOVE1 then
        useMove(1)

    elseif actionName == ACTION_MOVE2 then
        useMove(2)

    elseif actionName == ACTION_MOVE3 then
        useMove(3)

    elseif actionName == ACTION_MOVE4 then
        useMove(4)

    elseif actionName == ACTION_ULT then
        activateUltimate()

    end
end

local function bindInputs()

    ContextActionService:UnbindAction(
        ACTION_M1
    )

    ContextActionService:UnbindAction(
        ACTION_MOVE1
    )

    ContextActionService:UnbindAction(
        ACTION_MOVE2
    )

    ContextActionService:UnbindAction(
        ACTION_MOVE3
    )

    ContextActionService:UnbindAction(
        ACTION_MOVE4
    )

    ContextActionService:UnbindAction(
        ACTION_ULT
    )

    ContextActionService:BindAction(
        ACTION_M1,
        function(_, inputState)
            inputAction(
                ACTION_M1,
                inputState
            )
        end,
        CONFIG.Mobile,
        Enum.UserInputType.MouseButton1,
        Enum.KeyCode.ButtonR2
