    local resource = findKJResource("KJ")

    if not resource then

        resource = findKJResource("Everything")

    end

    if not resource then

        warn("[KJ] No Everything/KJ aura resource found.")

        return

    end

    State.Aura = attachKJEffect(
        resource,
        "KJ_Aura"
    )

end


