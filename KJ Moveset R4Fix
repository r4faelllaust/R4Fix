    state.Connections,

    UserInputService.InputBegan:Connect(
        function(input, processed)

            if processed then
                return
            end

            if not state.Enabled then
                return
            end

            if input.UserInputType
                == Enum.UserInputType.Keyboard then

                if input.KeyCode
                    == Enum.KeyCode.One then

                    if state.UltimateActive then
                        ultimateMove1()
                    else
                        move1()
                    end

                elseif input.KeyCode
                    == Enum.KeyCode.Two then

                    if state.UltimateActive then
                        ultimateMove2()
                    else
                        move2()
                    end

                elseif input.KeyCode
                    == Enum.KeyCode.Three then

                    if state.UltimateActive then
                        ultimateMove3()
                    else
                        move3()
                    end

                elseif input.KeyCode
                    == Enum.KeyCode.Four then

                    if state.UltimateActive then
                        ultimateMove4()
                    else
                        move4()
                    end

                elseif input.KeyCode
                    == Enum.KeyCode.G then

                    startUltimate()

                end

            end

        end
    )
)

