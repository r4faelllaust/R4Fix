--============================================================
-- ALL KJ ANIMATIONS
--============================================================

section("KJ-NAMED ANIMATIONS")

local animationResults = {}

for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do

    if obj:IsA("Animation") then

        local lowerName = string.lower(obj.Name)
        local fullName = string.lower(getFullNameSafe(obj))

        if
            string.find(lowerName, "kj", 1, true)
            or string.find(fullName, "kj", 1, true)
        then

            local id = getAnimationId(obj)

            table.insert(animationResults, {
                object = obj,
                id = id
            })

        end
    end

end

if #animationResults == 0 then
    line("No KJ-named Animation instances found.")
else
    for _, data in ipairs(animationResults) do

        line(
            "NAME: " ..
            data.object.Name
        )

        line(
            "ID: " ..
            tostring(data.id)
        )

        line(
            "PATH: " ..
            getFullNameSafe(data.object)
        )

        line("")

    end
end

