        frame,

        TweenInfo.new(
            0.25,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),

        {
            BackgroundTransparency = 1
        }

    )

    tween:Play()

    trackEffect(gui)

    task.delay(0.35, function()

        safeDestroy(gui)

    end)

end


------------------------------------------------------------
-- PLAY MOVE
------------------------------------------------------------

local function playMove(name)

    if not State.Active then
        return
    end

    if State.Busy then
        return
    end

    if not State.Humanoid then
        return
    end

    State.Busy = true

    --------------------------------------------------------
    -- Stop currently playing action animations.
    --------------------------------------------------------

    for _, track in ipairs(
        State.Humanoid:GetPlayingAnimationTracks()
    ) do

        local id =
            getAnimationId(track.Animation)

        if id and Config.Saitama.Moves[id] then

            stopTrack(track)

        end

    end

    --------------------------------------------------------
    -- Select animation.
    --------------------------------------------------------

    local animationId =
        Config.Animations[name]

    if not animationId then

        State.Busy = false

        return

    end

    --------------------------------------------------------
    -- Animation.
    --------------------------------------------------------

    local track =
        playKJAnimation(
            animationId,
            1
        )

    if not track then

        State.Busy = false

        return

    end

    --------------------------------------------------------
    -- Visual timing.
    --------------------------------------------------------

    task.delay(0.08, function()

        if State.Active then

            playCharacterSound()

        end

    end)

    task.delay(0.20, function()

        if State.Active then

            spawnKJImpact()

            cameraImpact(0.35, 0.16)

        end

    end)

    --------------------------------------------------------
    -- Wall combo gets its own presentation.
    --------------------------------------------------------

    if name == "WallCombo" then

        spawnWallComboFX()

        screenFlash()

        cameraImpact(
            1.2,
            0.45
        )

    end

    --------------------------------------------------------
    -- Heavy moves.
    --------------------------------------------------------

    if name == "CollateralRuin"
        or name == "StoicBomb"
        or name == "FiveSeasons" then

        screenFlash()

        cameraImpact(
            1.5,
            0.5
        )

    end

    --------------------------------------------------------
    -- Don't hold Busy forever.
    --------------------------------------------------------

    local length = 1.5

    if name == "Ravage" then
        length = 3.5

    elseif name == "SwiftSweep" then
        length = 1.6

    elseif name == "CollateralRuin" then
        length = 1.7

    elseif name == "SpiralingStorm" then
        length = 2.2

    elseif name == "WallCombo" then
        length = 3.5

    elseif name == "StoicBomb" then
        length = 4

    elseif name == "Dropkick" then
        length = 3

    elseif name == "FiveSeasons" then
        length = 4

    elseif name == "UnlimitedFlexworks" then
        length = 8

    end

    task.delay(length, function()

        if State.Busy then
            State.Busy = false
        end

    end)

end


------------------------------------------------------------
-- PLAY KJ M1
------------------------------------------------------------

local function playM1(index)

    if not State.Active then
        return
    end

    if State.Ultimate then
        return
    end

    local animationId =
        Config.Animations.M1[index]

    if not animationId then
        return
    end

    --------------------------------------------------------
    -- Stop the original Saitama M1.
    --------------------------------------------------------

    if State.Humanoid then

        for _, track in ipairs(
            State.Humanoid:GetPlayingAnimationTracks()
        ) do

            local id =
                getAnimationId(track.Animation)

            if id and Config.Saitama.M1[id] then

                stopTrack(track)

            end

        end

    end

    --------------------------------------------------------
    -- Play KJ M1.
    --------------------------------------------------------

    playKJAnimation(
        animationId,
        1
    )

end


------------------------------------------------------------
-- ULTIMATE ACTIVATION
------------------------------------------------------------

local function activateUltimate()

    if not State.Active then
        return
    end

    if State.Ultimate then
        return
    end

    if State.Busy then
        return
    end

    State.Ultimate = true

    State.Busy = true

    --------------------------------------------------------
    -- Awakening animation.
    --------------------------------------------------------

    playKJAnimation(
        Config.Animations.Awakening,
        1
    )

    --------------------------------------------------------
    -- Presentation.
    --------------------------------------------------------

    createKJAura()

    screenFlash()

    cameraImpact(
        1.4,
        0.6
    )

    tweenFOV(
        55,
        0.45
    )

    playCharacterSound()

    --------------------------------------------------------
    -- Hold the awakening state.
    --------------------------------------------------------

    task.delay(1.8, function()

        if not State.Active then
            return
        end

        State.Busy = false

    end)

end


------------------------------------------------------------
-- ULTIMATE MOVE
------------------------------------------------------------

local function playUltimateMove(name)

    if not State.Active then
        return
    end

    if not State.Ultimate then
        return
    end

    if State.Busy then
        return
    end

    State.Busy = true

    local animationId =
        Config.Animations[name]

    if not animationId then

        State.Busy = false

        return

    end

    local track =
        playKJAnimation(
            animationId,
            1
        )

    if not track then

        State.Busy = false

        return

    end

    --------------------------------------------------------
    -- Different KJ ultimates have different presentation.
    --------------------------------------------------------

    if name == "StoicBomb" then

        tweenFOV(45, 0.25)

        task.delay(0.8, function()

            screenFlash()

            cameraImpact(
                2,
                0.65
            )

            spawnKJImpact()

        end)

        task.delay(3.5, function()

            State.Busy = false

        end)

    elseif name == "Dropkick" then

        tweenFOV(50, 0.2)

        task.delay(0.6, function()

            cameraImpact(
                1.4,
                0.35
            )

            spawnKJImpact()

        end)

        task.delay(2.8, function()

            State.Busy = false

        end)

    elseif name == "FiveSeasons" then

        tweenFOV(42, 0.3)

        task.delay(1.2, function()

            screenFlash()

            cameraImpact(
                2.2,
                0.7
            )

            spawnKJImpact()

        end)

        task.delay(4, function()

            State.Busy = false

        end)

    elseif name == "UnlimitedFlexworks" then

        tweenFOV(38, 0.4)

        task.delay(2, function()

            cameraImpact(
                0.8,
                0.5
            )

        end)

        task.delay(6, function()

            screenFlash()

            cameraImpact(
                2.5,
                0.9
            )

            spawnKJImpact()

        end)

        task.delay(8.5, function()

            State.Busy = false

        end)

    end

end


------------------------------------------------------------
-- ANIMATION INTERCEPTOR
------------------------------------------------------------

local function handleAnimationPlayed(animationTrack)

    if not State.Active then
        return
    end

    if not animationTrack then
        return
    end

    local animation =
        animationTrack.Animation

    if not animation then
        return
    end

    local id =
        getAnimationId(animation)

    if not id then
        return
    end

    --------------------------------------------------------
    -- M1
    --------------------------------------------------------

    local m1Index =
        Config.Saitama.M1[id]

    if m1Index then

        task.defer(function()

            if not State.Active then
                return
            end

            stopTrack(animationTrack)

            playM1(m1Index)

        end)

        return

    end

    --------------------------------------------------------
    -- Moves
    --------------------------------------------------------

    local move =
        Config.Saitama.Moves[id]

    if not move then
        return
    end

    task.defer(function()

        if not State.Active then
            return
        end

        stopTrack(animationTrack)

        ----------------------------------------------------
        -- Awakening.
        ----------------------------------------------------

        if move == "Awakening" then

            activateUltimate()

            return

        end

        ----------------------------------------------------
        -- Normal moves.
        ----------------------------------------------------

        if move == "Ravage"
            or move == "SwiftSweep"
            or move == "CollateralRuin"
            or move == "SpiralingStorm" then

            playMove(move)

            return

        end

        ----------------------------------------------------
        -- Ultimate moves.
        ----------------------------------------------------

        if move == "StoicBomb"
            or move == "Dropkick"
            or move == "FiveSeasons"
            or move == "UnlimitedFlexworks" then

            playUltimateMove(move)

            return

        end

    end)

end


------------------------------------------------------------
-- CHARACTER CONNECTION
------------------------------------------------------------

local function disconnectCharacterConnections()

    for _, connection in ipairs(
        State.CharacterConnections
    ) do

        disconnect(connection)

    end

    table.clear(State.CharacterConnections)

end


------------------------------------------------------------
-- CHARACTER SETUP
------------------------------------------------------------

local function setupCharacter(character)

    disconnectCharacterConnections()

    State.Character = character

    State.Humanoid =
        character:WaitForChild(
            "Humanoid",
            10
        )

    State.Root =
        character:WaitForChild(
            "HumanoidRootPart",
            10
        )

    if not State.Humanoid then
        return
    end

    --------------------------------------------------------
    -- Animation interceptor.
    --------------------------------------------------------

    trackCharacterConnection(
        State.Humanoid.AnimationPlayed:Connect(
            handleAnimationPlayed
        )
    )

    --------------------------------------------------------
    -- Death cleanup.
    --------------------------------------------------------

    trackCharacterConnection(
        State.Humanoid.Died:Connect(function()

            State.Busy = false
            State.Ultimate = false

            stopCustomTracks()

            removeKJAura()

        end)
    )

    --------------------------------------------------------
    -- Remove Saitama visual effects.
    --------------------------------------------------------

    if State.Active then

        task.defer(function()

            removeSaitamaEffects()

            createKJAura()

        end)

    end

end


------------------------------------------------------------
-- CLEANUP EFFECTS
------------------------------------------------------------

local function cleanupEffects()

    for i = #State.Effects, 1, -1 do

        local object =
            State.Effects[i]

        safeDestroy(object)

        table.remove(
            State.Effects,
            i
        )

    end

end


------------------------------------------------------------
-- DISABLE KJ
------------------------------------------------------------

local function disableKJ()

    State.Active = false

    State.Ultimate = false

    State.Busy = false

    stopCustomTracks()

    removeKJAura()

    cleanupEffects()

    restoreHotbar()

    local camera = workspace.CurrentCamera

    if camera then

        tweenFOV(
            70,
            0.35
        )

    end

end


------------------------------------------------------------
-- ENABLE KJ
------------------------------------------------------------

local function enableKJ()

    if State.Destroyed then
        return
    end

    State.Active = true

    State.Ultimate = false

    State.Busy = false

    local character, humanoid, root =
        getCharacter()

    if character then

        State.Character = character

        State.Humanoid = humanoid

        State.Root = root

    end

    --------------------------------------------------------
    -- Remove Saitama visuals first.
    --------------------------------------------------------

    removeSaitamaEffects()

    --------------------------------------------------------
    -- Add actual KJ aura.
    --------------------------------------------------------

    createKJAura()

    --------------------------------------------------------
    -- Update existing hotbar.
    --------------------------------------------------------

    updateHotbar()

    --------------------------------------------------------
    -- Make KJ visible.
    --------------------------------------------------------

    keepKJVisible()

    print("==============================================")
    print("KJ ENABLED")
    print("==============================================")

end


------------------------------------------------------------
-- TOPBAR KJ CLICK
------------------------------------------------------------

local function hookKJButton()

    local button = getKJClickable()

    if not button then
        return false
    end

    --------------------------------------------------------
    -- Avoid reconnecting to the same button.
    --------------------------------------------------------

    if State.KJButtonConnection then

        disconnect(
            State.KJButtonConnection
        )

        State.KJButtonConnection = nil

    end

    State.KJButtonConnection =
        button.Activated:Connect(function()

            task.defer(function()

                enableKJ()

            end)

        end)

    return true

end


