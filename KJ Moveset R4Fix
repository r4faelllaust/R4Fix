-- KEEP KJ VISIBLE
--============================================================

local function keepKJVisible()

    local kj =
        findKJTopbarObject()

    if not kj then
        return false
    end

    if kj:IsA("GuiObject") then
        kj.Visible = true
    end

    if kj:IsA("GuiButton") then

        kj.Active = true
        kj.Selectable = true

    end

    for _, object in ipairs(
        kj:GetDescendants()
    ) do

        if object:IsA("GuiObject") then
            object.Visible = true
        end

        if object:IsA("GuiButton") then
            object.Active = true
            object.Selectable = true
        end

    end

    return true
end

