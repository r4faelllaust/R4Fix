--============================================================
-- INSTANCE POSITIONING
--============================================================

local function getPivot(object)

    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object.CFrame
    end

    if object:IsA("Model") then
        return object:GetPivot()
    end

    if object:IsA("Attachment") then
        return object.WorldCFrame
    end

    return nil
end

local function pivotObject(object, cf)

    if not object then
        return
    end

    if object:IsA("BasePart") then

        object.CFrame = cf

    elseif object:IsA("Model") then

        pcall(function()
            object:PivotTo(cf)
        end)

    elseif object:IsA("Attachment") then

        object.WorldCFrame = cf

    end

end

--============================================================
-- PHYSICS SANITIZATION
--============================================================

local function sanitizeParts(root)

    if root:IsA("BasePart") then

        root.CanCollide = false
        root.CanTouch = false
        root.CanQuery = false

        root.Massless = true

    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("BasePart") then

            object.CanCollide = false
            object.CanTouch = false
            object.CanQuery = false

            object.Massless = true

        end

    end

end

--============================================================
-- VFX ENABLE
--============================================================

local function emitVFX(root)

    if not root then
        return
    end

    local emitters = {}

    if root:IsA("ParticleEmitter") then
        table.insert(emitters, root)
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter") then

            table.insert(
                emitters,
                object
            )

        elseif object:IsA("Trail")
            or object:IsA("Beam") then

            object.Enabled = true

        elseif object:IsA("PointLight")
            or object:IsA("SpotLight")
            or object:IsA("SurfaceLight") then

            object.Enabled = true

        end

    end

    for _, emitter in ipairs(emitters) do

        emitter.Enabled = true

        local emitCount =
            emitter:GetAttribute("EmitCount")

        if typeof(emitCount) ~= "number" then

            local rate = emitter.Rate

            if rate > 0 then
                emitCount =
                    math.clamp(
                        math.floor(rate * 0.2),
                        5,
                        80
                    )
            else
                emitCount = 10
            end

        end

        pcall(function()
            emitter:Emit(emitCount)
        end)

    end

end

local function disableVFX(root)

    if not root then
        return
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam")
            or object:IsA("PointLight")
            or object:IsA("SpotLight")
            or object:IsA("SurfaceLight") then

            pcall(function()
                object.Enabled = false
            end)

        end

    end

end

--============================================================
-- CLONE VFX
--============================================================

local function cloneEffect(name, cf, lifetime)

    if not state.Enabled then
        return nil
    end

    local source =
        ResourcesFound[name]

    if not source then
        warn("[KJ] Missing resource:", name)
        return nil
    end

    local clone

    local success, result =
        pcall(function()
            return source:Clone()
        end)

    if not success or not result then
        warn("[KJ] Failed to clone:", name)
        return nil
    end

    clone = result

    clone.Parent = workspace

    sanitizeParts(clone)

    if cf then
        pivotObject(clone, cf)
    end

    emitVFX(clone)

    table.insert(
        state.Effects,
        clone
    )

    if lifetime then

        delayed(lifetime, function()

            if clone and clone.Parent then

                pcall(function()
                    clone:Destroy()
                end)

            end

        end)

    end

    return clone
end

--============================================================
-- FOLLOWING VFX
--============================================================

local function createFollowingEffect(name)

    if not state.Root then
        return nil
    end

    local source =
        ResourcesFound[name]

    if not source then
        return nil
    end

    local clone

    local success, result =
        pcall(function()
            return source:Clone()
        end)

    if not success or not result then
        return nil
    end

    clone = result

    clone.Parent = state.Character

    sanitizeParts(clone)

    pivotObject(
        clone,
        state.Root.CFrame
    )

    emitVFX(clone)

    local connection

    connection = RunService.RenderStepped:Connect(
        function()

            if not state.Enabled
                or not clone.Parent
                or not state.Root
                or not state.Root.Parent then

                disconnect(connection)

                return

            end

            pivotObject(
                clone,
                state.Root.CFrame
            )

        end
    )

    table.insert(
        state.Connections,
        connection
    )

    table.insert(
        state.Effects,
        clone
    )

    return clone
end

--============================================================
-- AURA
--============================================================

local function disableAura()

    if state.Aura then

        pcall(function()
            state.Aura:Destroy()
        end)

        state.Aura = nil

    end

end

local function enableAura()

    disableAura()

    if not state.Root then
        return
    end

    local source =
        ResourcesFound["KJ"]

    if not source then
        source =
            ResourcesFound["Everything"]
    end

    if not source then
        return
    end

    local clone

    local success, result =
        pcall(function()
            return source:Clone()
        end)

    if not success or not result then
        return
    end

    clone = result

    clone.Name = "KJ_LocalAura"

    clone.Parent = state.Character

    sanitizeParts(clone)

    pivotObject(
        clone,
        state.Root.CFrame
    )

    emitVFX(clone)

    state.Aura = clone

    local connection

    connection =
        RunService.RenderStepped:Connect(
            function()

                if not state.Enabled
                    or not state.Aura
                    or not state.Aura.Parent
                    or not state.Root
                    or not state.Root.Parent then

                    disconnect(connection)

                    return

                end

                pivotObject(
                    state.Aura,
                    state.Root.CFrame
                )

            end
        )

    table.insert(
        state.Connections,
        connection
    )

end

--============================================================
-- SOUND
--============================================================

local function playSound(id, volume, speed)

    if not state.Root then
        return nil
    end

    local sound =
        Instance.new("Sound")

    sound.SoundId =
        "rbxassetid://" ..
        tostring(id)

    sound.Volume =
        volume or 1

    sound.PlaybackSpeed =
        speed or 1

    sound.RollOffMaxDistance =
        100

    sound.Parent =
        state.Root

    table.insert(
        state.Sounds,
        sound
    )

    pcall(function()
        sound:Play()
    end)

    trackConnection(
        state.Connections,
        sound.Ended:Connect(
            function()

                pcall(function()
                    sound:Destroy()
                end)

            end
        )
    )

    return sound
end

--============================================================
-- ANIMATION
--============================================================

local function getAnimationId(track)

    if not track then
        return nil
    end

    local animation =
        track.Animation

    if not animation then
        return nil
    end

    return tonumber(
        string.match(
            animation.AnimationId or "",
            "%d+"
        )
    )
end

local function stopTrack(track)

    if not track then
        return
    end

    pcall(function()
        track:Stop(0.05)
    end)

end

local function stopNonCoreAnimations()

    if not state.Humanoid then
        return
    end

    for _, track in ipairs(
        state.Humanoid:GetPlayingAnimationTracks()
    ) do

        if track.Priority ~= Enum.AnimationPriority.Core then
            stopTrack(track)
        end

    end

end

local function playAnimation(id, speed, priority)

    if not state.Humanoid then
        return nil
    end

    local animation =
        Instance.new("Animation")

    animation.AnimationId =
        "rbxassetid://" ..
        tostring(id)

    local track

    local success, result =
        pcall(function()

            local loaded =
                state.Humanoid:LoadAnimation(
                    animation
                )

            loaded.Priority =
                priority or
                Enum.AnimationPriority.Action

            loaded:Play(
                0.05,
                1,
                speed or 1
            )

            return loaded

        end)

    animation:Destroy()

    if not success then
        warn(
            "[KJ] Animation failed:",
            id,
            result
        )

        return nil
    end

    track = result

    table.insert(
        state.Tracks,
        track
    )

    return track
end

--============================================================
-- CAMERA
--============================================================

local function getCamera()
    return workspace.CurrentCamera
end

local function setFOV(value, duration)

    local camera =
        getCamera()

    if not camera then
        return
    end

    if not state.CameraOriginalFOV then
        state.CameraOriginalFOV =
            camera.FieldOfView
    end

    local tween =
        TweenService:Create(
            camera,
            TweenInfo.new(
                duration or 0.2,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                FieldOfView = value
            }
        )

    tween:Play()

end

local function restoreFOV()

    local camera =
        getCamera()

    if not camera then
        return
    end

    local target =
        state.CameraOriginalFOV or 70

    local tween =
        TweenService:Create(
            camera,
            TweenInfo.new(
                0.35,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                FieldOfView = target
            }
        )

    tween:Play()

    state.CameraOriginalFOV = nil

end

--============================================================
-- CAMERA SHAKE
--============================================================

local shakePower = 0
local shakeUntil = 0

local function cameraShake(power, duration)

    if not state.RenderConnection then

        state.RenderConnection =
            RunService.RenderStepped:Connect(
                function()

                    if tick() >= shakeUntil then
                        return
                    end

                    local camera =
                        getCamera()

                    if not camera then
                        return
                    end

                    local x =
                        (math.random() - 0.5)
                        * shakePower

                    local y =
                        (math.random() - 0.5)
                        * shakePower

                    local z =
                        (math.random() - 0.5)
                        * shakePower

                    camera.CFrame =
                        camera.CFrame
                        * CFrame.Angles(
                            math.rad(x),
                            math.rad(y),
                            math.rad(z)
                        )

                end
            )

        table.insert(
            state.Connections,
            state.RenderConnection
        )

    end

    shakePower =
        math.max(
            shakePower,
            power
        )

    shakeUntil =
        math.max(
            shakeUntil,
            tick() + duration
        )

    delayed(
        duration + 0.05,
        function()

            if tick() >= shakeUntil then
                shakePower = 0
            end

        end
    )

end

