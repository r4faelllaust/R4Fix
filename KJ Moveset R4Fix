local function playVictimAnimation(character, animationId)
    if not character then
        return nil
    end

    local humanoid = getHumanoid(character)

    if not humanoid then
        return nil
    end

    local animator =
        humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        return nil
    end

    local animation = makeAnimation(animationId)

    local track = safe(function()
        return animator:LoadAnimation(animation)
    end, nil)

    animation:Destroy()

    if not track then
        return nil
    end

    safe(function()
        track.Priority = Enum.AnimationPriority.Action4
        track.Looped = false
        track:Play(0.05, 1, 1)
    end)

    Debris:AddItem(
        Instance.new("Folder"),
        0
    )

    task.delay(
        math.max(track.Length, 2) + 0.25,
        function()
            stopTrack(track, 0.1)
        end
    )

    return track
end

