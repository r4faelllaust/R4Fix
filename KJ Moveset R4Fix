local function getClickableGui(object)

    if not object then
        return nil
    end

    if object:IsA("GuiButton") then
        return object
    end

    local button =
        findRecursive(
            object,
            "IconButton"
        )

    if button
        and button:IsA("GuiButton") then

        return button
    end

    for _, descendant in ipairs(
        object:GetDescendants()
    ) do

        if descendant:IsA("GuiButton") then
            return descendant
        end

    end

    return nil
end

