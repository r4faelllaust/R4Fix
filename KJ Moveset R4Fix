--============================================================
-- CLEANUP
--============================================================

local function cleanupEffects()
    for _, object in ipairs(State.Effects) do
        safe(function()
            if object and object.Parent then
                object:Destroy()
            end
        end)
    end

    State.Effects = {}
end

local function cleanupAnimations()
    for _, animation in ipairs(State.Animations) do
        safe(function()
            animation:Destroy()
        end)
    end

    State.Animations = {}
end

local function cleanupSounds()
    for _, sound in ipairs(State.Sounds) do
        safe(function()
            sound:Destroy()
        end)
    end

    State.Sounds = {}
end

local function cleanupConnections()
    for _, connection in ipairs(State.Connections) do
        safe(function()
            connection:Disconnect()
        end)
    end

    State.Connections = {}
end

local function disableKJ()
    if not State.Enabled then
        return
    end

    log("DISABLING KJ")

    State.Enabled = false
    State.UltimateActive = false
    State.Busy = false

    unbindControls()

    removeAura()
    removeUltimateGui()

    cleanupEffects()
    cleanupAnimations()
    cleanupSounds()

    local humanoid = getHumanoid()

    if humanoid then
        humanoid.WalkSpeed =
            State.OriginalWalkSpeed or humanoid.WalkSpeed

        humanoid.JumpPower =
            State.OriginalJumpPower or humanoid.JumpPower
    end

    State.Cooldowns = {}

    log("KJ DISABLED")
end

--============================================================
-- ENABLE KJ
--============================================================

local function enableKJ()
    if State.Enabled then
        return
    end

    log("================================================")
    log("ENABLING KJ")
    log("================================================")

    State.Enabled = true

    setupAnimator()

    bindControls()

    createAura()

    playSound(CONFIG.CharacterSound, 0.75)

    log("KJ ENABLED")
    log("1 = Move 1")
    log("2 = Move 2")
    log("3 = Move 3")
    log("4 = Wall Combo")
    log("G = Ultimate")
end

--============================================================
-- CHARACTER SETUP
--============================================================

local function setupCharacter(character)

    if State.Enabled then
        cleanupEffects()
        cleanupAnimations()
        cleanupSounds()
        removeAura()
    end

    State.Character = character

    local humanoid =
        character:WaitForChild(
            "Humanoid",
            10
        )

    if not humanoid then
        return
    end

    State.Humanoid = humanoid

    local animator =
        humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    State.Animator = animator

    log(
        "Character ready:",
        character:GetFullName()
    )

    if State.Enabled then
        task.wait(0.25)
        createAura()
    end
end

if player.Character then
    task.spawn(setupCharacter, player.Character)
end

table.insert(
    State.Connections,
    player.CharacterAdded:Connect(setupCharacter)
)

--============================================================
-- KJ TOPBAR DETECTION
--============================================================

local function getKJButton()

    local playerGui =
        player:FindFirstChild("PlayerGui")

    if not playerGui then
        return nil
    end

    local topbar =
        playerGui:FindFirstChild(
            "TopbarPlus"
        )

    if not topbar then
        return nil
    end

    local container =
        topbar:FindFirstChild(
            "TopbarContainer"
        )

    if not container then
        return nil
    end

    local icon =
        container:FindFirstChild(
            "UnnamedIcon"
        )

    if not icon then
        return nil
    end

    local dropdown =
        icon:FindFirstChild(
            "DropdownContainer"
        )

    if not dropdown then
        return nil
    end

    local frame =
        dropdown:FindFirstChild(
            "DropdownFrame"
        )

    if not frame then
        return nil
    end

    return frame:FindFirstChild("KJ")
end

local connectedButtons = {}

local function connectKJButton(button)

    if not button then
        return
    end

    if connectedButtons[button] then
        return
    end

    connectedButtons[button] = true

    if button:IsA("GuiButton") then

        button.Visible = true
        button.Active = true
        button.Selectable = true

        button.Activated:Connect(function()

            log("KJ TOPBAR ACTIVATED")

            enableKJ()

        end)

        log("KJ topbar button connected")

    else

        warnKJ(
            "KJ object is not a GuiButton:",
            button.ClassName
        )

    end
end

local function scanTopbar()

    local button = getKJButton()

    if button then
        button.Visible = true
        connectKJButton(button)
    end

end

task.spawn(function()

    while true do

        task.wait(0.25)

        pcall(scanTopbar)

    end

end)

