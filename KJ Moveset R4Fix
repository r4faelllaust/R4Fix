--============================================================

local function connectHotbarButtons()

    for i = 1, 4 do

        local base =
            getBaseButton(i)

        if base then

            local button =
                base:FindFirstChild("Button")
                or base:FindFirstChildOfClass(
                    "GuiButton"
                )

            if button
                and not button:GetAttribute(
                    "KJConnected"
                ) then

                button:SetAttribute(
                    "KJConnected",
                    true
                )

                trackConnection(
                    button.Activated:Connect(
                        function()

                            if not State.KJActive then
                                return
                            end

                            if State.UltimateActive then

                                performUltimateMove(
                                    i
                                )

                            else

                                performNormalMove(
                                    i
                                )

                            end

                        end
                    )
                )

            end

        end

    end

end

