local function createUltimateAura()

    removeAura()

    if not State.Character then
        return
    end

    local everything =
        findKJEffect("Everything")

    if not everything then

        if Resources then

            everything =
                findRecursive(
                    Resources,
                    "Everything"
                )

        end

    end

    if not everything then
        return
    end

    local kj =
        findRecursive(
            everything,
            "KJ"
        )

    if not kj then
        return
    end

    State.Aura =
        cloneEffect(
            kj,
            State.Character
        )

    if State.Aura then

        enableParticles(
            State.Aura
        )

        emitParticles(
            State.Aura,
            50
        )

    end

end


