local function useMove(index)

    if not state.Enabled then
        return
    end

    if state.UltimateActive then

        if index == 1 then
            doStoicBomb()

        elseif index == 2 then
            doDropkick()

        elseif index == 3 then
            doFiveSeasons()

        elseif index == 4 then
            doWallCombo()

        end

        return
    end

    if index == 1 then
        doRavage()

    elseif index == 2 then
        doSwiftSweep()

    elseif index == 3 then
        doCollateralRuin()

    elseif index == 4 then
        doWallCombo()

    end
