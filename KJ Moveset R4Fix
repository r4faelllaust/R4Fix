--============================================================
-- REQUIRE MODULE
--============================================================

local ModuleResult
local ModuleLoaded = false

if AttackModule then

    local success, result = pcall(function()
        return require(AttackModule)
    end)

    if success then
        ModuleResult = result
        ModuleLoaded = true

        print("[KJ FIVE SEASONS TEST] Five Season Attack: MODULE LOADED")

    else

        Output.Text =
            "REQUIRE FAILED:\n\n" ..
            tostring(result)

        Status.Text = "REQUIRE FAILED"
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)

    end

end

--============================================================
-- INSPECT RETURN VALUE
--============================================================

local function inspectModule()

    if not ModuleLoaded then
        Output.Text = "Module is not loaded."
        return
    end

    local result = ModuleResult

    local lines = {}

    table.insert(lines, "RETURN TYPE: " .. typeof(result))
    table.insert(lines, "")

    if typeof(result) == "table" then

        table.insert(lines, "EXPORTED MEMBERS:")

        local count = 0

        for key, value in pairs(result) do

            count += 1

            local valueType = typeof(value)

            table.insert(
                lines,
                tostring(key) .. " = " .. valueType
            )

            if count >= 30 then
                table.insert(lines, "...")
                break
            end

        end

        if count == 0 then
            table.insert(lines, "(EMPTY TABLE)")
        end

    elseif typeof(result) == "function" then

        table.insert(lines, "MODULE RETURNS A FUNCTION")

    elseif typeof(result) == "Instance" then

        table.insert(
            lines,
            "INSTANCE: " ..
            result:GetFullName()
        )

    else

        table.insert(
            lines,
            "VALUE: " ..
            tostring(result)
        )

    end

    Output.Text = table.concat(lines, "\n")

    print("========== FIVE SEASONS MODULE ==========")

    for _, line in ipairs(lines) do
        print(line)
    end

    print("=========================================")

end

InspectButton.Activated:Connect(inspectModule)

--============================================================
-- FIND FIVE SEASONS FX
--============================================================

local function findFiveSeasonsFX()

    local Resources =
        ReplicatedStorage:FindFirstChild("Resources")

    if not Resources then
        return nil
    end

    return Resources:FindFirstChild(
        "FiveSeasonsFX",
        true
    )
end

--============================================================
-- VFX TEST
--============================================================

local function testVFX()

    local Character = Player.Character

    if not Character then
        Output.Text = "Character not loaded."
        return
    end

    local Root =
        Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        Output.Text = "HumanoidRootPart not found."
        return
    end

    local FX = findFiveSeasonsFX()

    if not FX then

        Output.Text =
            "FiveSeasonsFX NOT FOUND."

        return
    end

    Output.Text =
        "FOUND:\n" ..
        FX:GetFullName() ..
        "\n\nClass: " ..
        FX.ClassName

    local Clone

    local success, err = pcall(function()

        Clone = FX:Clone()
        Clone.Parent = workspace

        if Clone:IsA("Model") then

            Clone:PivotTo(
                Root.CFrame
            )

        elseif Clone:IsA("BasePart") then

            Clone.CFrame =
                Root.CFrame

        end

    end)

    if not success then

        Output.Text =
            "VFX CLONE FAILED:\n\n" ..
            tostring(err)

        return
    end

    -- Enable actual emitters.
    for _, object in ipairs(Clone:GetDescendants()) do

        if object:IsA("ParticleEmitter") then

            object.Enabled = true

            local emitCount =
                object:GetAttribute("EmitCount")

            if typeof(emitCount) == "number" then

                pcall(function()
                    object:Emit(emitCount)
                end)

            else

                pcall(function()
                    object:Emit(
                        math.max(
                            10,
                            math.floor(object.Rate * 0.3)
                        )
                    )
                end)

            end

        elseif object:IsA("Beam")
            or object:IsA("Trail") then

            object.Enabled = true

        elseif object:IsA("PointLight")
            or object:IsA("SpotLight")
            or object:IsA("SurfaceLight") then

            object.Enabled = true

        end

    end

    print(
        "[KJ FIVE SEASONS TEST] VFX CLONED:",
        FX:GetFullName()
    )

    task.delay(8, function()

        if Clone and Clone.Parent then
            Clone:Destroy()
        end

    end)

end

VFXButton.Activated:Connect(testVFX)

