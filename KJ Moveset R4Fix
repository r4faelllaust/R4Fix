--============================================================
-- CLIPBOARD
--============================================================

local function copyToClipboard(text)
    if setclipboard then
        local ok = pcall(setclipboard, text)
        if ok then
            return true
        end
    end

    if toclipboard then
        local ok = pcall(toclipboard, text)
        if ok then
            return true
        end
    end

    if syn and syn.write_clipboard then
        local ok = pcall(syn.write_clipboard, text)
        if ok then
            return true
        end
    end

    return false
end

--============================================================
-- SAFE HELPERS
--============================================================

local function safe(fn, fallback)
    local ok, result = pcall(fn)

    if ok then
        return result
    end

    return fallback
end

local function getName(obj)
    return safe(function()
        return obj.Name
    end, "Unknown")
end

local function getClass(obj)
    return safe(function()
        return obj.ClassName
    end, "Unknown")
end

local function getFullName(obj)
    return safe(function()
        return obj:GetFullName()
    end, "Unknown")
end

local function getAnimationId(obj)
    if not obj or not obj:IsA("Animation") then
        return ""
    end

    return safe(function()
        return obj.AnimationId
    end, "")
end

local function getSoundId(obj)
    if not obj or not obj:IsA("Sound") then
        return ""
    end

    return safe(function()
        return obj.SoundId
    end, "")
end

local function contains(text, keyword)
    text = string.lower(tostring(text or ""))
    keyword = string.lower(tostring(keyword or ""))

    return string.find(text, keyword, 1, true) ~= nil
end

--============================================================
-- INTEREST FILTER
--============================================================

local keywords = {
    "kj",
    "ufw",
    "ultimate",
    "cutscene",
    "wall",
    "throw",
    "slam",
    "punch",
    "barrage",
    "21",
    "everything",
    "punchfx",
    "effect",
    "effects",
    "vfx",
    "animation",
    "sound",
    "dialogue",
    "phone",
    "sign",
    "camera",
    "impact",
    "hit",
}

local function interesting(obj)
    local name = getName(obj)
    local path = getFullName(obj)

    for _, keyword in ipairs(keywords) do
        if contains(name, keyword) or contains(path, keyword) then
            return true
        end
    end

    return false
end

--============================================================
