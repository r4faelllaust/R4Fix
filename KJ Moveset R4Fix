    if State.UltimateActive then
        return
    end

    if State.Busy then
        return
    end

    if not ready(
        "Ultimate",
        45
    ) then
        return
    end

    if not getCharacter() then
        return
    end

    State.Busy = true

    --========================================================
    -- INTRO
    --========================================================

    changeFOV(
        35,
        0.4
    )

    cameraShake(
        0.5,
        0.35
    )

    speakKJ(
        "THIS WILL BE THE START OF SOMETHING BEAUTIFUL."
    )

    playSound(
        CONFIRMED.CharacterSound,
        1
    )

    --========================================================
    -- TRANSFORMATION
    --========================================================

    task.wait(1)

    createUltimateAura()

    cameraShake(
        0.8,
        0.8
    )

    local cutscene =
        Cutscenes
        and Cutscenes:FindFirstChild("KJ")

    if cutscene then

        print(
            "[KJ] Cutscenes.KJ found:",
            cutscene.ClassName
        )

    end

    --========================================================
    -- STATE
    --========================================================

    State.UltimateActive = true
    State.UltimateStarted = os.clock()

    State.Busy = false

    changeFOV(
        80,
        0.7
    )

    speakKJ(
        "KJ."
    )

    --========================================================
    -- ULTIMATE TIMER
    --========================================================

    task.spawn(function()

        local started =
            State.UltimateStarted

        while State.UltimateActive do

            if not State.Active then
                break
            end

            if os.clock() - started
                >= State.UltimateDuration
            then
                break
            end

            task.wait(0.1)

        end

        if State.UltimateActive then
            State.UltimateActive = false
        end

        restoreFOV()

        removeAura()

        stopAllTracks()

    end)

end


--============================================================
-- DEACTIVATE
--============================================================

local function deactivate()

    State.Active = false
    State.UltimateActive = false
    State.Busy = false

    stopAllTracks()

    removeAura()

    cleanupAllObjects()

    restoreFOV()

    print("[KJ] Moveset disabled.")

end


--============================================================
-- ACTIVATE
--============================================================

local function activate()

    if State.Active then
        return
    end

    if not getCharacter() then
        return
    end

    State.Active = true

    createAura()

    playSound(
        CONFIRMED.CharacterSound,
        0.7
    )

    speakKJ(
        "KJ."
    )

    print("[KJ] Moveset activated.")

end


--============================================================
-- TOPBAR KJ DETECTION
--============================================================

local function tryFindKJButton()

    local candidates = {}

    for _, object in ipairs(
        playerGui:GetDescendants()
    ) do

        if string.lower(object.Name) == "kj" then

            table.insert(
                candidates,
                object
            )

        end

    end

    return candidates[1]

end


local function hookKJButton(button)

    if not button then
        return
    end

    if not button:IsA("GuiButton") then
        return
    end

    if button:GetAttribute(
        "KJHooked"
    ) then
        return
    end

    button:SetAttribute(
        "KJHooked",
        true
    )

    print(
        "[KJ] Hooking KJ button:",
        button:GetFullName()
    )

    addConnection(
        button.Activated:Connect(function()

            if State.Active then
                deactivate()
            else
                activate()
            end

        end)
    )

end


--============================================================
-- BUTTON WATCHER
--============================================================

task.spawn(function()

    while true do

        task.wait(0.5)

        local button =
            tryFindKJButton()

        if button then

            if button:IsA("GuiObject") then

                pcall(function()
                    button.Visible = true
                end)

            end

            hookKJButton(button)

        end

    end

end)


--============================================================
-- KEYBOARD
--============================================================

addConnection(
    UserInputService.InputBegan:Connect(
        function(input, processed)

            if processed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.Keyboard
            then
                return
            end

            local key =
                input.KeyCode

            if key == Enum.KeyCode.One then

                Move1()

            elseif key == Enum.KeyCode.Two then

                Move2()

            elseif key == Enum.KeyCode.Three then

                Move3()

            elseif key == Enum.KeyCode.Four then

                WallCombo()

            elseif key == Enum.KeyCode.G then

                Ultimate()

            elseif key == Enum.KeyCode.M then

                M1()

            elseif key == Enum.KeyCode.K then

                if State.Active then
                    deactivate()
                else
                    activate()
                end

            end

        end
    )
)


--============================================================
-- CHARACTER RESPAWN
--============================================================

addConnection(
    player.CharacterAdded:Connect(
        function(character)

            local wasActive =
                State.Active

            State.Active = false
            State.UltimateActive = false
            State.Busy = false

            stopAllTracks()
            removeAura()
            cleanupAllObjects()
            restoreFOV()

            task.wait(0.5)

            setupCharacter(character)

            if wasActive then
                task.wait(0.5)
                activate()
            end

        end
    )
)


