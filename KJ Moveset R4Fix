--==================================================
-- CLONE / PLAY VFX
--==================================================

local function activateEffects(object)

	if not object then
		return false
	end

	for _, descendant in ipairs(object:GetDescendants()) do

		if descendant:IsA("ParticleEmitter") then
			descendant.Enabled = true

			local emitCount = descendant:GetAttribute("EmitCount")

			if typeof(emitCount) == "number" then
				pcall(function()
					descendant:Emit(emitCount)
				end)
			else
				pcall(function()
					descendant:Emit(10)
				end)
			end

		elseif descendant:IsA("Trail") then
			descendant.Enabled = true

		elseif descendant:IsA("Beam") then
			descendant.Enabled = true

		elseif descendant:IsA("PointLight")
			or descendant:IsA("SpotLight")
			or descendant:IsA("SurfaceLight") then

			descendant.Enabled = true
		end
	end

	return true
end

local function playFiveSeasonsFX()

	if not fiveFX then
		warn("FiveSeasonsFX was not found.")
		return false
	end

	local character = player.Character

	if not character then
		return false
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local clone

	local success, errorMessage = pcall(function()

		clone = fiveFX:Clone()
		clone.Name = "LOCAL_FiveSeasonsFX_TEST"
		clone.Parent = workspace

		if clone:IsA("Model") then
			clone:PivotTo(root.CFrame)
		elseif clone:IsA("BasePart") then
			clone.CFrame = root.CFrame
		end

	end)

	if not success then
		warn("Failed cloning FiveSeasonsFX:", errorMessage)
		return false
	end

	activateEffects(clone)

	-- Keep it around long enough to see it.
	task.delay(8, function()
		if clone and clone.Parent then
			clone:Destroy()
		end
	end)

	return true
end

--==================================================
-- INSPECT CUTSCENE MODULE
--==================================================

local function inspectCutscene(moduleScript, name)

	if not moduleScript then
		report(name .. ": NOT FOUND")
		return
	end

	if not moduleScript:IsA("ModuleScript") then
		report(name .. ": " .. moduleScript.ClassName)
		return
	end

	local success, result = pcall(function()
		return require(moduleScript)
	end)

	if not success then
		warn(name .. " require failed:", result)
		report(name .. ": REQUIRE FAILED")
		return
	end

	print("========== " .. name .. " ==========")
	print("Returned:", result)
	print("Type:", typeof(result))

	if type(result) == "table" then

		for key, value in pairs(result) do
			print("  ", key, "=", value)
		end

	end

	print("================================")

	report(name .. ": MODULE LOADED")
end

