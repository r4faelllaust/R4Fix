local NormalNames = {

    ["1"] = "Ravage",
    ["2"] = "Swift Sweep",
    ["3"] = "Collateral Ruin",
    ["4"] = "20-20-20 Dropkick",

}

local UltimateNames = {

    ["1"] = "20 Series",
    ["2"] = "Stoic Bomb",
    ["3"] = "Five Seasons",
    ["4"] = "Unlimited Flexworks",

}

local function getHotbar()

    local hotbar =
        PlayerGui:FindFirstChild(
            "Hotbar"
        )

    if not hotbar then
        return nil
    end

    local backpack =
        hotbar:FindFirstChild(
            "Backpack"
        )

    if not backpack then
        return nil
    end

    return backpack:FindFirstChild(
        "Hotbar"
    )

end

local function findSlot(index)

    local hotbar =
        getHotbar()

    if not hotbar then
        return nil
    end

    local slot =
        hotbar:FindFirstChild(
            tostring(index)
        )

    if not slot then
        return nil
    end

    return slot:FindFirstChild(
        "Base"
    )

end

local function saveHotbarNames()

    for i = 1, 4 do

        local base =
            findSlot(i)

        if base then

            local label =
                base:FindFirstChild(
                    "ToolName"
                )

            if label
                and label:IsA("TextLabel")
                and State.OriginalHotbarNames[i]
                    == nil then

                State.OriginalHotbarNames[i] =
                    label.Text

            end

        end

    end

end

local function updateHotbar()

    saveHotbarNames()

    local names =
        State.UltimateActive
        and UltimateNames
        or NormalNames

    for i = 1, 4 do

        local base =
            findSlot(i)

        if base then

            local label =
                base:FindFirstChild(
                    "ToolName"
                )

            if label
                and label:IsA("TextLabel") then

                label.Text =
                    names[tostring(i)]

            end

        end

    end

end

local function restoreHotbar()

    for i = 1, 4 do

        local base =
            findSlot(i)

        if base then

            local label =
                base:FindFirstChild(
                    "ToolName"
                )

            if label
                and label:IsA("TextLabel") then

                if State.OriginalHotbarNames[i] then

                    label.Text =
                        State.OriginalHotbarNames[i]

                end

            end

        end

    end

end

