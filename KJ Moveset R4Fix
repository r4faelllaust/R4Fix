--============================================================
-- KJ RESOURCE / ANIMATION DISCOVERY SCANNER V2
-- Read-only runtime discovery scanner
--
-- PURPOSE:
-- V1 found the KJ resources.
-- V2 searches for the runtime wiring around those resources:
--   * Animation instances / IDs
--   * Animator objects
--   * AnimationTracks currently visible to the client
--   * KJ/UFW/Cutscene references exposed through instances
--   * Attributes and values containing KJ/UFW/Ultimate references
--   * Hotbar / skill information
--   * Character information
--   * KJ-related remotes
--
-- IMPORTANT:
-- This does NOT pretend to decompile inaccessible scripts.
-- It only reports information actually exposed to the client.
--============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer

--============================================================
-- CLIPBOARD
--============================================================

local function copyToClipboard(text)
    if setclipboard then
        local ok = pcall(setclipboard, text)
        if ok then
            return true
        end
    end

    if toclipboard then
        local ok = pcall(toclipboard, text)
        if ok then
            return true
        end
    end

    if syn and syn.write_clipboard then
        local ok = pcall(syn.write_clipboard, text)
        if ok then
            return true
        end
    end

    return false
end

--============================================================
-- HELPERS
--============================================================

local function safeCall(callback, fallback)
    local ok, result = pcall(callback)

    if ok then
        return result
    end

    return fallback
end

local function getClassInfo(obj)
    return safeCall(function()
        return obj.ClassName
    end, "Unknown")
end

local function getFullNameSafe(obj)
    return safeCall(function()
        return obj:GetFullName()
    end, "Unknown")
end

local function getNameSafe(obj)
    return safeCall(function()
        return obj.Name
    end, "Unknown")
end

local function getAnimationId(obj)
    if not obj or not obj:IsA("Animation") then
        return nil
    end

    return safeCall(function()
        return obj.AnimationId
    end, nil)
end

local function getSoundId(obj)
    if not obj or not obj:IsA("Sound") then
        return nil
    end

    return safeCall(function()
        return obj.SoundId
    end, nil)
end

local function contains(text, search)
    text = string.lower(tostring(text or ""))
    search = string.lower(tostring(search or ""))

    return string.find(text, search, 1, true) ~= nil
end

local function interestingText(text)
    text = string.lower(tostring(text or ""))

    local keywords = {
        "kj",
        "ufw",
        "ultimate",
        "flex",
        "cutscene",
        "animation",
        "animator",
        "skill",
        "moveset",
        "move",
        "cooldown",
        "hotbar",
        "character",
        "switch",
        "wall",
        "throw",
        "punch",
        "slam",
        "uppercut",
        "barrage",
    }

    for _, keyword in ipairs(keywords) do
        if string.find(text, keyword, 1, true) then
            return true
        end
    end

    return false
end

local function isKJRelated(obj)
    if not obj then
        return false
    end

    local name = getNameSafe(obj)
    local fullName = getFullNameSafe(obj)

    return interestingText(name) or interestingText(fullName)
end

--============================================================
-- REPORT
--============================================================

local report = {}

local function line(text)
    table.insert(report, tostring(text))
end

local function section(name)
    line("")
    line("============================================================")
    line(name)
    line("============================================================")
end

local function separator()
    line("------------------------------------------------------------")
end

--============================================================
-- BASIC INFORMATION
--============================================================

line("KJ RESOURCE DISCOVERY REPORT V2")
line("Player: " .. player.Name)
line("UserId: " .. tostring(player.UserId))
line("Generated: " .. os.date("%Y-%m-%d %H:%M:%S"))

local character = player.Character

if character then
    line("Character: " .. getFullNameSafe(character))

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        line("Humanoid RigType: " .. tostring(humanoid.RigType))
        line("Humanoid Health: " .. tostring(humanoid.Health))
        line("Humanoid MaxHealth: " .. tostring(humanoid.MaxHealth))
    end
else
    line("Character: NONE")
end

--============================================================
-- CHARACTER ANIMATORS
--============================================================

section("CURRENT CHARACTER ANIMATORS")

if character then

    local foundAnimator = false

    for _, obj in ipairs(character:GetDescendants()) do

        if obj:IsA("Animator") then
            foundAnimator = true

            line("Animator: " .. getFullNameSafe(obj))

            local tracks = safeCall(function()
                return obj:GetPlayingAnimationTracks()
            end, {})

            line("Playing tracks: " .. tostring(#tracks))

            for _, track in ipairs(tracks) do

                separator()

                line("TRACK NAME: " .. tostring(track.Name))
                line("TRACK PRIORITY: " .. tostring(track.Priority))
                line("TRACK LOOPED: " .. tostring(track.Looped))
                line("TRACK PLAYING: " .. tostring(track.IsPlaying))
                line("TRACK LENGTH: " .. tostring(track.Length))
                line("TRACK TIME POSITION: " .. tostring(track.TimePosition))
                line("TRACK SPEED: " .. tostring(track.Speed))

                local animation = safeCall(function()
                    return track.Animation
                end, nil)

                if animation then
                    line("TRACK ANIMATION: " .. getFullNameSafe(animation))
                    line("TRACK ANIMATION ID: " .. tostring(getAnimationId(animation)))
                else
                    line("TRACK ANIMATION: unavailable")
                end
            end
        end

    end

    if not foundAnimator then
        line("No Animator found inside current character.")
    end

else
    line("No current character.")
end

--============================================================
-- ALL ACCESSIBLE ANIMATION INSTANCES
--============================================================

section("ACCESSIBLE ANIMATION INSTANCES")

local animationResults = {}
local animationSeen = {}

local roots = {
    ReplicatedStorage,
    player:FindFirstChild("PlayerGui"),
    player:FindFirstChild("Backpack"),
    player.Character,
    Workspace,
}

for _, root in ipairs(roots) do

    if root then

        for _, obj in ipairs(root:GetDescendants()) do

            if obj:IsA("Animation") and not animationSeen[obj] then

                animationSeen[obj] = true

                local id = getAnimationId(obj)
                local name = getNameSafe(obj)
                local fullName = getFullNameSafe(obj)

                local lowerFull = string.lower(fullName)
                local lowerName = string.lower(name)

                if
                    string.find(lowerFull, "kj", 1, true)
                    or string.find(lowerFull, "ufw", 1, true)
                    or string.find(lowerFull, "ultimate", 1, true)
                    or string.find(lowerName, "kj", 1, true)
                    or string.find(lowerName, "ufw", 1, true)
                    or string.find(lowerName, "ultimate", 1, true)
                then

                    table.insert(animationResults, {
                        object = obj,
                        id = id,
                        path = fullName,
                    })

                end
            end

        end

    end

end

if #animationResults == 0 then
    line("No accessible KJ/UFW/Ultimate Animation instances found.")
else

    for _, data in ipairs(animationResults) do

        separator()

        line("NAME: " .. getNameSafe(data.object))
        line("ID: " .. tostring(data.id))
        line("PATH: " .. data.path)

    end

end

--============================================================
-- KNOWN KJ ANIMATION IDS
--============================================================

section("KNOWN KJ ANIMATION ID SEARCH")

local knownAnimationIds = {
    "18447913645",
    "18447915110",
}

local knownAnimationResults = {}

for _, root in ipairs(roots) do

    if root then

        for _, obj in ipairs(root:GetDescendants()) do

            if obj:IsA("Animation") then

                local id = tostring(getAnimationId(obj) or "")

                for _, wantedId in ipairs(knownAnimationIds) do

                    if string.find(id, wantedId, 1, true) then

                        table.insert(
                            knownAnimationResults,
                            obj
                        )

                        line("FOUND ID: " .. wantedId)
                        line("NAME: " .. getNameSafe(obj))
                        line("PATH: " .. getFullNameSafe(obj))
                        line("FULL ID: " .. id)
                        separator()

                    end

                end

            end

        end

    end

end

if #knownAnimationResults == 0 then
    line("Known KJ animation IDs were not exposed as Animation instances.")
end

--============================================================
-- KJ / UFW / ULTIMATE RESOURCE REFERENCES
--============================================================

section("KJ / UFW / ULTIMATE RESOURCE OBJECTS")

local resourceKeywords = {
    "KJEffects",
    "KJThrow",
    "KJWallCombo",
    "UFW",
    "Ultimate",
    "Cutscenes",
    "KJ",
}

local resourceSeen = {}

for _, root in ipairs({
    ReplicatedStorage,
    player:FindFirstChild("PlayerGui"),
}) do

    if root then

        for _, obj in ipairs(root:GetDescendants()) do

            local fullName = getFullNameSafe(obj)
            local lowerFull = string.lower(fullName)

            local match = false

            for _, keyword in ipairs(resourceKeywords) do

                if string.find(
                    lowerFull,
                    string.lower(keyword),
                    1,
                    true
                ) then

                    match = true
                    break

                end

            end

            if match and not resourceSeen[obj] then

                resourceSeen[obj] = true

                local className = getClassInfo(obj)

                if
                    className == "Folder"
                    or className == "Model"
                    or className == "ModuleScript"
                    or className == "ScreenGui"
                    or className == "Animation"
                    or className == "Sound"
                then

                    line(
                        "[" ..
                        className ..
                        "] " ..
                        fullName
                    )

                end

            end

        end

    end

end

--============================================================
-- ATTRIBUTES
--============================================================

section("KJ / UFW / ULTIMATE ATTRIBUTES")

local attributeRoots = {
    ReplicatedStorage,
    player,
    player:FindFirstChild("PlayerGui"),
    player.Character,
    Workspace,
}

local attributeSeen = {}

for _, root in ipairs(attributeRoots) do

    if root then

        local objects = {root}

        for _, obj in ipairs(root:GetDescendants()) do
            table.insert(objects, obj)
        end

        for _, obj in ipairs(objects) do

            if not attributeSeen[obj] then

                attributeSeen[obj] = true

                local attributes = safeCall(function()
                    return obj:GetAttributes()
                end, {})

                for attributeName, attributeValue in pairs(attributes) do

                    local combined =
                        tostring(attributeName)
                        .. " "
                        .. tostring(attributeValue)

                    if interestingText(combined) then

                        line(
                            "OBJECT: " ..
                            getFullNameSafe(obj)
                        )

                        line(
                            "ATTRIBUTE: " ..
                            tostring(attributeName)
                        )

                        line(
                            "VALUE: " ..
                            tostring(attributeValue)
                        )

                        separator()

                    end

                end

            end

        end

    end

end

--============================================================
-- VALUE OBJECTS
--============================================================

section("KJ / UFW / ULTIMATE VALUE OBJECTS")

local valueClasses = {
    StringValue = true,
    NumberValue = true,
    IntValue = true,
    BoolValue = true,
    ObjectValue = true,
}

local valueSeen = {}

for _, root in ipairs(attributeRoots) do

    if root then

        for _, obj in ipairs(root:GetDescendants()) do

            if valueClasses[obj.ClassName] and not valueSeen[obj] then

                valueSeen[obj] = true

                local name = getNameSafe(obj)
                local fullName = getFullNameSafe(obj)

                if interestingText(name) or interestingText(fullName) then

                    local value = safeCall(function()
                        return obj.Value
                    end, "<unavailable>")

                    line(
                        "[" ..
                        obj.ClassName ..
                        "] " ..
                        fullName
                    )

                    line(
                        "VALUE: " ..
                        tostring(value)
                    )

                    separator()

                end

            end

        end

    end

end

--============================================================
-- KJ SOUNDS
--============================================================

section("KJ / UFW SOUNDS")

local soundSeen = {}
local soundCount = 0

for _, root in ipairs(roots) do

    if root then

        for _, obj in ipairs(root:GetDescendants()) do

            if obj:IsA("Sound") and not soundSeen[obj] then

                local name = getNameSafe(obj)
                local fullName = getFullNameSafe(obj)

                if
                    contains(name, "kj")
                    or contains(fullName, "kj")
                    or contains(fullName, "ufw")
                    or contains(fullName, "ultimate")
                then

                    soundSeen[obj] = true
                    soundCount += 1

                    line("NAME: " .. name)
                    line("ID: " .. tostring(getSoundId(obj)))
                    line("PATH: " .. fullName)
                    separator()

                end

            end

        end

    end

end

if soundCount == 0 then
    line("No accessible KJ/UFW/Ultimate sounds found.")
end

