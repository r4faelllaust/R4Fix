--============================================================
-- WALL COMBO
--============================================================

local function wallCombo()
	if not State.Enabled then
		return
	end

	if State.Busy or State.UltimateActive then
		return
	end

	State.Busy = true

	local root = State.RootPart

	----------------------------------------------------------
	-- Attacker animation
	----------------------------------------------------------

	playAnimation(
		CONFIG.Animations.WallAttacker,
		Enum.AnimationPriority.Action4,
		1
	)

	----------------------------------------------------------
	-- Character sound
	----------------------------------------------------------

	playSound(
		CONFIG.Sounds.Character,
		1
	)

	----------------------------------------------------------
	-- Existing KJWallCombo
	----------------------------------------------------------

	if root then

		local effect = spawnKJResource(
			"KJWallCombo",
			root.Position
		)

		if effect then

			task.delay(0.5, function()

				if not effect or not effect.Parent then
					return
				end

				for _, object in ipairs(effect:GetDescendants()) do

					if object:IsA("ParticleEmitter") then

						pcall(function()
							object:Emit(object:GetAttribute("EmitCount") or 10)
						end)

					elseif object:IsA("Beam") then

						pcall(function()
							object.Enabled = true
						end)

					elseif object:IsA("Light") then

						pcall(function()
							object.Enabled = true
						end)

					end
				end
			end)
		end
	end

	----------------------------------------------------------
	-- Hit 1
	----------------------------------------------------------

	task.delay(0.25, function()

		if not State.Enabled then
			return
		end

		playSound(CONFIG.Sounds.Hit, 1)

		if State.RootPart then
			spawnKJResource(
				"PunchFX",
				State.RootPart.Position + State.RootPart.CFrame.LookVector * 3
			)
		end
	end)

	----------------------------------------------------------
	-- Hit 2
	----------------------------------------------------------

	task.delay(0.7, function()

		if not State.Enabled then
			return
		end

		playSound(CONFIG.Sounds.Hit, 1.05)

		if State.RootPart then
			spawnKJResource(
				"PunchFX",
				State.RootPart.Position + State.RootPart.CFrame.LookVector * 4
			)
		end
	end)

	----------------------------------------------------------
	-- Final
	----------------------------------------------------------

	task.delay(1.15, function()

		if not State.Enabled then
			return
		end

		playSound(CONFIG.Sounds.Hit, 1.25)

		if State.RootPart then

			spawnKJResource(
				"KJWallBreak",
				State.RootPart.Position + State.RootPart.CFrame.LookVector * 5
			)

			spawnKJResource(
				"PunchFX",
				State.RootPart.Position + State.RootPart.CFrame.LookVector * 5
			)

		end
	end)

	task.delay(2.2, function()
		State.Busy = false
	end)
end

--============================================================
-- M1
--============================================================

local function m1()
	if not State.Enabled then
		return
	end

	if State.Busy or State.UltimateActive then
		return
	end

	if State.M1Debounce then
		return
	end

	State.M1Debounce = true

	State.M1Index += 1

	if State.M1Index > #CONFIG.Animations.SaitamaM1 then
		State.M1Index = 1
	end

	local animationId = CONFIG.Animations.SaitamaM1[State.M1Index]

	playAnimation(
		animationId,
		Enum.AnimationPriority.Action,
		1
	)

	playSound(
		CONFIG.Sounds.Hit,
		0.8
	)

	local root = State.RootPart

	if root then
		spawnKJResource(
			"PunchFX",
			root.Position + root.CFrame.LookVector * 3
		)
	end

	task.delay(0.25, function()
		State.M1Debounce = false
	end)
end

--============================================================
-- CAMERA
--============================================================

local function getCamera()
	return workspace.CurrentCamera
end

local function setFOV(value, duration)
	local camera = getCamera()

	if not camera then
		return
	end

	TweenService:Create(
		camera,
		TweenInfo.new(
			duration or 0.3,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			FieldOfView = value
		}
	):Play()
end

local function cameraShake(duration, magnitude)
	local camera = getCamera()

	if not camera then
		return
	end

	local start = tick()

	while tick() - start < duration do

		if not State.Enabled then
			break
		end

		local elapsed = tick() - start
		local alpha = 1 - math.clamp(elapsed / duration, 0, 1)

		local x = (math.random() - 0.5) * 2
		local y = (math.random() - 0.5) * 2
		local z = (math.random() - 0.5) * 2

		camera.CFrame =
			camera.CFrame
			* CFrame.new(
				x * magnitude * alpha,
				y * magnitude * alpha,
				z * magnitude * alpha
			)

		RunService.RenderStepped:Wait()
	end
end

--============================================================
-- ULTIMATE
--============================================================

local function ultimate()
	if not State.Enabled then
		return
	end

	if State.UltimateActive then
		return
	end

	if State.Busy then
		return
	end

	local character = State.Character

	if not character then
		return
	end

	State.Busy = true
	State.UltimateActive = true

	----------------------------------------------------------
	-- Camera
	----------------------------------------------------------

	local camera = getCamera()

	if camera then
		State.OriginalCameraFOV = camera.FieldOfView
	end

	setFOV(CONFIG.UltimateFOV, 0.45)

	----------------------------------------------------------
	-- Ultimate animation
	----------------------------------------------------------

	playAnimation(
		CONFIG.Animations.Awakening,
		Enum.AnimationPriority.Action4,
		1
	)

	----------------------------------------------------------
	-- Aura
	----------------------------------------------------------

	createKJAura()

	----------------------------------------------------------
	-- Sound
	----------------------------------------------------------

	playSound(
		CONFIG.Sounds.Character,
		1.3,
		0.8
	)

	----------------------------------------------------------
	-- Strong initial effect
	----------------------------------------------------------

	if State.RootPart then

		spawnKJResource(
			"KJWallBreak",
			State.RootPart.Position
		)

		spawnKJResource(
			"PunchFX",
			State.RootPart.Position
		)

	end

	----------------------------------------------------------
	-- Camera shake
	----------------------------------------------------------

	task.spawn(function()
		cameraShake(1.2, 0.45)
	end)

	----------------------------------------------------------
	-- Ultimate duration
	----------------------------------------------------------

	task.delay(CONFIG.UltimateDuration, function()

		if not State.UltimateActive then
			return
		end

		State.UltimateActive = false
		State.Busy = false

		stopAnimations()

		local targetFOV =
			State.OriginalCameraFOV
			or CONFIG.CameraFOV

		setFOV(targetFOV, 0.5)

	end)
end

--============================================================
-- CLEANUP EFFECTS
--============================================================

local function cleanupEffects()

	for _, object in ipairs(State.Effects) do

		if object then
			destroyObject(object)
		end

	end

	State.Effects = {}

end

--============================================================
-- COMPLETE CLEANUP
--============================================================

local function cleanup()

	State.Enabled = false
	State.UltimateActive = false
	State.Busy = false
	State.M1Debounce = false
	State.M1Index = 0

	stopAnimations()

	for _, sound in ipairs(State.Sounds) do

		if sound then
			pcall(function()
				sound:Stop()
				sound:Destroy()
			end)
		end

	end

	State.Sounds = {}

	cleanupEffects()

	disconnectList(State.CharacterConnections)

	restoreUI()

	local camera = getCamera()

	if camera and State.OriginalCameraFOV then
		camera.FieldOfView = State.OriginalCameraFOV
	end

	State.OriginalCameraFOV = nil

	refreshCharacterReferences()
end

--============================================================
-- ACTIVATE KJ
--============================================================

local function activateKJ()

	if State.Enabled then
		return
	end

	refreshCharacterReferences()

	if not State.Character then
		return
	end

	State.Enabled = true
	State.UltimateActive = false
	State.Busy = false

	setKJUI()

	----------------------------------------------------------
	-- KJ aura
	----------------------------------------------------------

	createKJAura()

	----------------------------------------------------------
	-- Character sound
	----------------------------------------------------------

	playSound(
		CONFIG.Sounds.Character,
		0.8
	)

	print("[KJ] Enabled")

end

--============================================================
-- TOGGLE
--============================================================

local function toggleKJ()

	if State.Enabled then
		cleanup()
	else
		activateKJ()
	end

end

--============================================================
-- TOPBAR CONNECTION
--============================================================

local connectedKJButtons = {}

local function connectKJButton()

	local kj = getKJButton()

	if not kj then
		return
	end

	keepKJVisible()

	if connectedKJButtons[kj] then
		return
	end

	connectedKJButtons[kj] = true

	if kj:IsA("GuiButton") then

		local connection = kj.Activated:Connect(function()
			toggleKJ()
		end)

		trackConnection(connection)

	end

	----------------------------------------------------------
	-- The actual button is inside the Frame
	----------------------------------------------------------

	local iconButton = kj:FindFirstChild("IconButton")

	if iconButton and iconButton:IsA("GuiButton") then

		if not connectedKJButtons[iconButton] then

			connectedKJButtons[iconButton] = true

			local connection = iconButton.Activated:Connect(function()
				toggleKJ()
			end)

			trackConnection(connection)
		end
	end
end

