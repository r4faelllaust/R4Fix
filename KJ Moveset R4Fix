--============================================================

local function spawnKJEffect(name, cframe)

    local source =
        findKJEffect(name)

    if not source then
        return nil
    end

    return cloneEffect(
        source,
        workspace,
        cframe
    )

end


--============================================================
-- HIT TARGET SEARCH
--============================================================

local function getTargets(range)

    local results = {}

    if not State.Root then
        return results
    end

    local origin =
        State.Root.Position

    for _, other in ipairs(
        Players:GetPlayers()
    ) do

        if other ~= player then

            local character =
                other.Character

            local humanoid =
                character
                and character:FindFirstChildOfClass(
                    "Humanoid"
                )

            local root =
                character
                and character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if humanoid
                and root
                and humanoid.Health > 0
            then

                local distance =
                    (
                        root.Position
                        - origin
                    ).Magnitude

                if distance <= range then

                    table.insert(
                        results,
                        {
                            Player = other,
                            Character = character,
                            Humanoid = humanoid,
                            Root = root,
                            Distance = distance,
                        }
                    )

                end

            end

        end

    end

    table.sort(
        results,
        function(a, b)
            return a.Distance < b.Distance
        end
    )

    return results

end


local function getClosestTarget(range)

    local targets =
        getTargets(range)

    return targets[1]

end


