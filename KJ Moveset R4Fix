local function getKJButton()
	local topbar = playerGui:FindFirstChild("TopbarPlus")

	if not topbar then
		return nil
	end

	local container = topbar:FindFirstChild("TopbarContainer")

	if not container then
		return nil
	end

	local unnamedIcon = container:FindFirstChild("UnnamedIcon")

	if not unnamedIcon then
		return nil
	end

	local dropdown = unnamedIcon:FindFirstChild("DropdownContainer")

	if not dropdown then
		return nil
	end

	local frame = dropdown:FindFirstChild("DropdownFrame")

	if not frame then
		return nil
	end

	return frame:FindFirstChild("KJ")
end

local function keepKJVisible()
	local kj = getKJButton()

	if not kj then
		return
	end

	if kj:IsA("GuiObject") then
		kj.Visible = true
	end

	if kj:IsA("GuiButton") then
		kj.Active = true
		kj.Selectable = true
	end
end

--============================================================
-- TOPBAR VISUALS
--============================================================

local function inspectGuiObject(root)
	if not root then
		return
	end

	for _, object in ipairs(root:GetDescendants()) do

		if object:IsA("TextLabel") or object:IsA("TextButton") then

			local lowerName = string.lower(object.Name)

			if string.find(lowerName, "name", 1, true)
				or string.find(lowerName, "caption", 1, true)
				or string.find(lowerName, "title", 1, true) then

				if State.OriginalUI[object] == nil then
					State.OriginalUI[object] = {
						Text = object.Text
					}
				end

				pcall(function()
					object.Text = "KJ"
				end)
			end
		end
	end
end

local function setKJUI()
	keepKJVisible()

	local kj = getKJButton()

	if not kj then
		return
	end

	inspectGuiObject(kj)
end

local function restoreUI()
	for object, data in pairs(State.OriginalUI) do

		if object and object.Parent then

			pcall(function()
				if data.Text ~= nil then
					object.Text = data.Text
				end
			end)

		end
	end

	State.OriginalUI = {}

	keepKJVisible()
end

--============================================================
-- AURA
--============================================================

local function enableParticle(object)
	if object:IsA("ParticleEmitter") then

		pcall(function()
			object.Enabled = true
		end)

	elseif object:IsA("Trail") then

		pcall(function()
			object.Enabled = true
		end)

	elseif object:IsA("Beam") then

		pcall(function()
			object.Enabled = true
		end)

	elseif object:IsA("Light") then

		pcall(function()
			object.Enabled = true
		end)
	end
end

local function attachObjectToCharacter(object, attachmentPart)
	if not object or not attachmentPart then
		return nil
	end

	local clone

	local success = pcall(function()
		clone = object:Clone()
	end)

	if not success or not clone then
		return nil
	end

	clone.Parent = attachmentPart

	return trackEffect(clone)
end

local function createKJAura()
	local character = State.Character

	if not character then
		return
	end

	local root = State.RootPart

	if not root then
		return
	end

	local resources = ReplicatedStorage:FindFirstChild("Resources")

	if not resources then
		return
	end

	----------------------------------------------------------
	-- Everything.KJ
	----------------------------------------------------------

	local ufw = resources:FindFirstChild("UFW")

	if ufw then

		local vfx = ufw:FindFirstChild("vfx")

		if vfx then

			local everything = vfx:FindFirstChild("Everything")

			if everything then

				local kj = everything:FindFirstChild("KJ")

				if kj then

					local clone = kj:Clone()

					clone.Parent = character

					trackEffect(clone)

					--------------------------------------------------
					-- Try to place the effect around the root.
					--------------------------------------------------

					if clone:IsA("Model") then

						pcall(function()
							clone:PivotTo(root.CFrame)
						end)

						for _, object in ipairs(clone:GetDescendants()) do

							if object:IsA("BasePart") then
								object.CanCollide = false
								object.CanTouch = false
								object.CanQuery = false
								object.Massless = true

								local weld = Instance.new("WeldConstraint")
								weld.Part0 = root
								weld.Part1 = object
								weld.Parent = object
							end

							enableParticle(object)
						end

					elseif clone:IsA("BasePart") then

						clone.CFrame = root.CFrame
						clone.CanCollide = false
						clone.CanTouch = false
						clone.CanQuery = false

						local weld = Instance.new("WeldConstraint")
						weld.Part0 = root
						weld.Part1 = clone
						weld.Parent = clone

					end
				end
			end
		end
	end

	----------------------------------------------------------
	-- KJBlack / KJWhite
	----------------------------------------------------------

	local black = findRecursive(resources, "KJBlack")
	local white = findRecursive(resources, "KJWhite")

	if black then
		attachObjectToCharacter(black, root)
	end

	if white then
		attachObjectToCharacter(white, root)
	end
end

--============================================================
-- GENERIC KJ VFX
--============================================================

local function spawnKJResource(resourceName, position)
	local resources = ReplicatedStorage:FindFirstChild("Resources")

	if not resources then
		return nil
	end

	local object = findRecursive(resources, resourceName)

	if not object then
		return nil
	end

	local clone

	local success = pcall(function()
		clone = object:Clone()
	end)

	if not success or not clone then
		return nil
	end

	clone.Parent = workspace

	if position then

		if clone:IsA("Model") then

			pcall(function()
				clone:PivotTo(CFrame.new(position))
			end)

		elseif clone:IsA("BasePart") then

			clone.CFrame = CFrame.new(position)

		end
	end

	trackEffect(clone)

	for _, child in ipairs(clone:GetDescendants()) do
		enableParticle(child)
	end

	enableParticle(clone)

	return clone
end

--============================================================
-- SOUND
--============================================================

local function playSound(id, volume, speed)
	local character = State.Character
	local root = State.RootPart

	if not character or not root then
		return nil
	end

	local sound = Instance.new("Sound")

	sound.SoundId = id
	sound.Volume = volume or 1
	sound.PlaybackSpeed = speed or 1
	sound.RollOffMaxDistance = 100
	sound.Parent = root

	trackSound(sound)

	sound:Play()

	sound.Ended:Connect(function()
		destroyObject(sound)
	end)

	return sound
end

--============================================================
-- ANIMATION
--============================================================

local function getAnimator()
	local humanoid = State.Humanoid

	if not humanoid then
		return nil
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

local function playAnimation(id, priority, speed)
	local animator = getAnimator()

	if not animator then
		return nil
	end

	local animation = Instance.new("Animation")

	animation.AnimationId = id

	local success, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	destroyObject(animation)

	if not success or not track then
		return nil
	end

	track.Priority = priority or Enum.AnimationPriority.Action
	track:Play(0.08, 1, speed or 1)

	trackAnimation(track)

	return track
end

--============================================================
-- STOP KJ ANIMATIONS
--============================================================

local function stopAnimations()
	for _, track in ipairs(State.Animations) do

		if track then
			pcall(function()
				track:Stop(0.1)
				track:Destroy()
			end)
		end
	end

	State.Animations = {}
end

