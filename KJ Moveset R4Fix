local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

local output = {}

local function add(text)
	table.insert(output, text)
	print(text)
end

local function find(name)
	local results = {}

	for _, obj in ipairs(game:GetDescendants()) do
		if obj.Name == name then
			table.insert(results, obj)
		end
	end

	return results
end

add("===== KJ TARGET SCAN =====")
add("")

--------------------------------------------------
-- KJ TOPBAR
--------------------------------------------------

local topbar = PlayerGui:FindFirstChild("TopbarPlus")

if topbar then
	add("TopbarPlus: FOUND")

	local count = 0

	for _, obj in ipairs(topbar:GetDescendants()) do
		if obj.Name == "KJ" then
			count += 1

			add(
				"KJ BUTTON #" ..
				count ..
				": " ..
				obj:GetFullName() ..
				" [" ..
				obj.ClassName ..
				"]"
			)

			for _, child in ipairs(obj:GetChildren()) do
				add(
					"  " ..
					child.Name ..
					" [" ..
					child.ClassName ..
					"]"
				)
			end
		end
	end

	add("KJ buttons: " .. count)
else
	add("TopbarPlus: MISSING")
end

--------------------------------------------------
-- KJ / CHARACTER OBJECTS
--------------------------------------------------

add("")
add("===== CHARACTER OBJECTS =====")

local names = {
	"KJ",
	"CharacterSelect",
	"CharacterSelection",
	"Moveset",
	"SelectCharacter",
	"Character"
}

for _, name in ipairs(names) do
	local found = find(name)

	if #found > 0 then
		add(name .. ": " .. #found)

		-- Only show first 3 to keep output small
		for i = 1, math.min(#found, 3) do
			add(
				"  " ..
				found[i]:GetFullName() ..
				" [" ..
				found[i].ClassName ..
				"]"
			)
		end
	end
end

--------------------------------------------------
-- POSSIBLE REMOTES
--------------------------------------------------

add("")
add("===== POSSIBLE REMOTES =====")

local remoteCount = 0

for _, obj in ipairs(RS:GetDescendants()) do
	if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then

		local n = string.lower(obj.Name)

		if string.find(n, "character", 1, true)
			or string.find(n, "select", 1, true)
			or string.find(n, "moveset", 1, true)
			or string.find(n, "kj", 1, true) then

			remoteCount += 1

			add(
				obj:GetFullName() ..
				" [" ..
				obj.ClassName ..
				"]"
			)

			if remoteCount >= 15 then
				add("...limited to 15 remotes")
				break
			end
		end
	end
end

add("Remote matches: " .. remoteCount)

--------------------------------------------------
-- MOBILE BUTTON
--------------------------------------------------

add("")
add("===== MOBILE =====")

local touch = PlayerGui:FindFirstChild("TouchGui")

if touch then
	local control = touch:FindFirstChild("TouchControlFrame")

	if control then
		local jump = control:FindFirstChild("JumpButton")

		if jump then
			local punch = jump:FindFirstChild("PunchButton")

			if punch then
				add("PunchButton: FOUND")
				add(punch:GetFullName())
			else
				add("PunchButton: MISSING")
			end
		else
			add("JumpButton: MISSING")
		end
	else
		add("TouchControlFrame: MISSING")
	end
else
	add("TouchGui: MISSING")
end

--------------------------------------------------
-- END
--------------------------------------------------

add("")
add("===== END =====")

local finalText = table.concat(output, "\n")

local success, err = pcall(function()
	setclipboard(finalText)
end)

if success then
	print("✅ COPIED")
else
	print("❌ COPY FAILED: " .. tostring(err))
	print(finalText)
end
