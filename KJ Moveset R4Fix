--============================================================
-- CLIPBOARD
--============================================================

local function copyToClipboard(text)
    if setclipboard then
        setclipboard(text)
        return true
    elseif toclipboard then
        toclipboard(text)
        return true
    elseif syn and syn.write_clipboard then
        syn.write_clipboard(text)
        return true
    end

    return false
end

--============================================================
-- HELPERS
--============================================================

local function getClassInfo(obj)
    local ok, className = pcall(function()
        return obj.ClassName
    end)

    if ok then
        return className
    end

    return "Unknown"
end

local function getFullNameSafe(obj)
    local ok, result = pcall(function()
        return obj:GetFullName()
    end)

    if ok then
        return result
    end

    return "Unknown"
end

local function getAnimationId(obj)
    if not obj:IsA("Animation") then
        return nil
    end

    local ok, id = pcall(function()
        return obj.AnimationId
    end)

    if ok and id and id ~= "" then
        return id
    end

    return nil
end

local function getSoundId(obj)
    if not obj:IsA("Sound") then
        return nil
    end

    local ok, id = pcall(function()
        return obj.SoundId
    end)

    if ok and id and id ~= "" then
        return id
    end

    return nil
end

