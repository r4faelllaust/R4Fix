section("ANIMATIONS INSIDE KJ RESOURCE AREAS")

local animationRoots = {}

for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do

    local fullName = string.lower(getFullNameSafe(obj))

    if
        string.find(fullName, "kj", 1, true)
        and obj:IsA("Animation")
    then

        table.insert(animationRoots, obj)

    end

end

local alreadyPrinted = {}

for _, animation in ipairs(animationRoots) do

    if not alreadyPrinted[animation] then

        alreadyPrinted[animation] = true

        local id = getAnimationId(animation)

        line(
            animation.Name ..
            " | " ..
            tostring(id) ..
            " | " ..
            getFullNameSafe(animation)
        )

    end

end

