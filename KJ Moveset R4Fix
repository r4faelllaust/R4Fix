--============================================================
-- MOVE 4 WALL COMBO
--============================================================

local function move4()
    if not beginMove("Move4") then
        return
    end

    log("================================================")
    log("KJ WALL COMBO")
    log("================================================")

    local track =
        playAnimation(
            CONFIG.WallAttackerAnimation,
            Enum.AnimationPriority.Action4,
            1
        )

    local wallCombo = getWallCombo()

    if not wallCombo then
        warnKJ("KJWallCombo NOT FOUND")
    end

    playSound(CONFIG.CharacterSound, 1)

    if wallCombo then

        local hold = findRecursive(wallCombo, "hold")

        if hold then
            cloneVFX(hold, 1.5)
        end

    end

    -- HIT 1
    task.delay(0.35, function()

        if not State.Enabled then
            return
        end

        log("Wall hit 1 | damage reference = 6")

        playSound(CONFIG.HitSound, 1)

        if wallCombo then

            local hit =
                findRecursive(wallCombo, "ImpactEffect")

            if hit then
                cloneVFX(hit, 2)
            end

            local particles =
                findRecursive(wallCombo, "HitParticles")

            if particles then
                cloneVFX(particles, 2)
            end

        end

        cameraShake(0.08, 2)
    end)

    -- HIT 2
    task.delay(0.72, function()

        if not State.Enabled then
            return
        end

        log("Wall hit 2 | damage reference = 6")

        playSound(CONFIG.HitSound, 1)

        if wallCombo then

            local impact =
                findRecursive(wallCombo, "ImpactEffect2")

            if impact then
                cloneVFX(impact, 2)
            end

        end

        cameraShake(0.1, 2.5)
    end)

    -- FINAL HIT
    task.delay(1.12, function()

        if not State.Enabled then
            return
        end

        log("Wall final hit | damage reference = 10")
        log("Final force reference: sideways -120 / up 25")

        playSound(CONFIG.HitSound, 1.2)

        if wallCombo then

            local finalImpact =
                findRecursive(wallCombo, "FinalImpact")

            if finalImpact then
                cloneVFX(finalImpact, 3)
            end

            local huge =
                findRecursive(
                    wallCombo,
                    "FinalImpactHUGEignore"
                )

            if huge then
                cloneVFX(huge, 3)
            end

            local slam =
                findRecursive(wallCombo, "slam")

            if slam then
                cloneVFX(slam, 2)
            end

        end

        local wallBreak = getWallBreak()

        if wallBreak then
            cloneVFX(wallBreak, 3)
        end

        cameraShake(0.35, 5)
    end)

    task.delay(1.8, function()
        finishMove()
    end)

    return track
end

