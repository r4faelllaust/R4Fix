--============================================================
-- VFX POSITIONING
--============================================================

local function positionObject(object, cframe)

    if not object then
        return
    end

    pcall(function()

        if object:IsA("Model") then

            object:PivotTo(cframe)

        elseif object:IsA("BasePart") then

            object.CFrame = cframe

        elseif object:IsA("Attachment") then

            object.WorldCFrame = cframe

        end

    end)

end

--============================================================
-- ENABLE PARTICLES
--============================================================

local function enableParticles(root)

    if not root then
        return
    end

    if root:IsA("ParticleEmitter") then

        root.Enabled = true

        pcall(function()
            root:Emit(root:GetAttribute("EmitCount") or 1)
        end)

    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter") then

            object.Enabled = true

            local emitCount =
                object:GetAttribute("EmitCount")

            if emitCount then

                pcall(function()
                    object:Emit(emitCount)
                end)

            end

        end

    end

end

--============================================================
-- DISABLE PARTICLES
--============================================================

local function disableParticles(root)

    if not root then
        return
    end

    if root:IsA("ParticleEmitter") then
        root.Enabled = false
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter") then
            object.Enabled = false
        end

    end

end

--============================================================
-- CLONE EXISTING KJ RESOURCE
--============================================================

local function spawnKJResource(name, duration)

    if not State.Character then
        return nil
    end

    local resource =
        ResourceCache[name]

    if not resource then

        resource =
            findRecursive(
                KJEffects,
                name
            )

    end

    if not resource then

        warn(
            "[KJ] Resource missing:",
            name
        )

        return nil
    end

    local clone =
        resource:Clone()

    clone.Parent =
        workspace

    table.insert(
        State.Effects,
        clone
    )

    local root =
        State.Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if root then

        positionObject(
            clone,
            root.CFrame
        )

    end

    enableParticles(clone)

    if duration then

        task.delay(
            duration,
            function()

                if clone and clone.Parent then

                    disableParticles(clone)

                    task.delay(
                        0.25,
                        function()

                            if clone and clone.Parent then
                                clone:Destroy()
                            end

                        end
                    )

                end

            end
        )

    end

    return clone

end

--============================================================
-- KJ AURA
--============================================================

local Aura = nil

local function removeAura()

    if Aura then

        pcall(function()
            Aura:Destroy()
        end)

        Aura = nil

    end

end

local function createAura()

    removeAura()

    if not State.Character then
        return
    end

    local root =
        State.Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    local source =
        ResourceCache["Everything"]

    if not source then
        source =
            ResourceCache["KJ"]
    end

    if not source then
        return
    end

    local clone =
        source:Clone()

    clone.Name =
        "KJ_Client_Aura"

    clone.Parent =
        workspace

    Aura =
        clone

    table.insert(
        State.Effects,
        clone
    )

    positionObject(
        clone,
        root.CFrame
    )

    -- Follow character without creating
    -- an uncontrolled permanent Heartbeat.
    local connection

    connection =
        RunService.RenderStepped:Connect(function()

            if not State.KJActive
                or not Aura
                or not Aura.Parent
                or not root
                or not root.Parent then

                disconnect(connection)

                return
            end

            pcall(function()

                if Aura:IsA("Model") then

                    Aura:PivotTo(
                        root.CFrame
                    )

                elseif Aura:IsA("BasePart") then

                    Aura.CFrame =
                        root.CFrame

                end

            end)

        end)

    table.insert(
        State.CharacterConnections,
        connection
    )

    enableParticles(clone)

end

--============================================================
-- SOUND
--============================================================

local function playKJSound(soundId)

    local root =
        State.Character
        and State.Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    local sound =
        Instance.new("Sound")

    sound.SoundId =
        soundId

    sound.Volume =
        1

    sound.RollOffMaxDistance =
        100

    sound.Parent =
        root

    sound:Play()

    table.insert(
        State.Effects,
        sound
    )

    sound.Ended:Connect(function()

        if sound and sound.Parent then
            sound:Destroy()
        end

    end)

end

--============================================================
-- CAMERA
--============================================================

local function cameraPunch(fovAmount, duration)

    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local original =
        camera.FieldOfView

    local increased =
        original + fovAmount

    local up =
        TweenService:Create(
            camera,
            TweenInfo.new(
                duration * 0.35,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                FieldOfView = increased
            }
        )

    local down =
        TweenService:Create(
            camera,
            TweenInfo.new(
                duration * 0.65,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.In
            ),
            {
                FieldOfView = original
            }
        )

    up:Play()

    up.Completed:Connect(function()

        if camera then
            down:Play()
        end

    end)

end

