--!strict
--[[
	KJ Moveset (Client-Only)
	Saitama Override → looks & feels like KJ
	Uses real game resources from ReplicatedStorage
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local StarterGui = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

----------------------------------------------------------------
-- CONFIG
----------------------------------------------------------------
local CONFIG = {
	CharacterName = "KJ",
	BaseCharacter = "Saitama", -- we override this

	-- Known safe IDs
	WallAttackerAnim = "rbxassetid://18447913645",
	WallVictimAnim   = "rbxassetid://18447915110",
	CharSound        = "rbxassetid://18443048724",
	HitSound         = "rbxassetid://18443049348",
}

----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local State = {
	Active = false,
	Ultimate = false,
	Busy = false,
	Connections = {},
	CharacterConnections = {},
	Effects = {},
	Aura = nil,
}

local function track(conn, list)
	list = list or State.Connections
	table.insert(list, conn)
	return conn
end

local function cleanup(list)
	for _, conn in ipairs(list) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(list)
end

local function destroyEffects()
	for _, obj in ipairs(State.Effects) do
		pcall(function() obj:Destroy() end)
	end
	table.clear(State.Effects)
	if State.Aura then
		pcall(function() State.Aura:Destroy() end)
		State.Aura = nil
	end
end

----------------------------------------------------------------
-- RESOURCE HELPERS
----------------------------------------------------------------
local function getKJEffects()
	local res = ReplicatedStorage:FindFirstChild("Resources")
	return res and res:FindFirstChild("KJEffects")
end

local function getEverythingKJ()
	local res = ReplicatedStorage:FindFirstChild("Resources")
	local ufw = res and res:FindFirstChild("UFW")
	local vfx = ufw and ufw:FindFirstChild("vfx")
	local everything = vfx and vfx:FindFirstChild("Everything")
	return everything and everything:FindFirstChild("KJ")
end

local function cloneAndParent(source, parent, lifetime)
	if not source then return nil end
	local clone = source:Clone()
	clone.Parent = parent
	table.insert(State.Effects, clone)
	if lifetime then
		Debris:AddItem(clone, lifetime)
	end
	return clone
end

local function emitAll(root)
	if not root then return end
	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("ParticleEmitter") then
			pcall(function()
				desc:Emit(desc:GetAttribute("EmitCount") or 8)
			end)
		end
	end
end

----------------------------------------------------------------
-- TOPBAR
----------------------------------------------------------------
local function updateTopbar(isKJ)
	local topbar = PlayerGui:FindFirstChild("TopbarPlus")
	if not topbar then return end

	for _, desc in ipairs(topbar:GetDescendants()) do
		if desc.Name == "IconButton" then
			local label = desc:FindFirstChild("IconLabel")
			if label and label:IsA("TextLabel") then
				local t = label.Text
				if t == "Saitama" or t == "KJ" or t == "Hero Hunter" or t == "Garou" then
					label.Text = isKJ and "KJ" or "Saitama"
				end
			end
		end
	end
end

----------------------------------------------------------------
-- AURA
----------------------------------------------------------------
local function applyAura(character)
	destroyEffects()
	local source = getEverythingKJ()
	if not source then return end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local aura = source:Clone()
	aura.Name = "KJ_Aura"
	aura.Parent = character

	-- Try to weld / position
	local surface = aura:FindFirstChild("Surface")
	if surface and surface:IsA("BasePart") then
		surface.Anchored = false
		surface.CanCollide = false
		local weld = Instance.new("Weld")
		weld.Part0 = hrp
		weld.Part1 = surface
		weld.C0 = CFrame.new()
		weld.Parent = surface
	end

	State.Aura = aura
	table.insert(State.Effects, aura)
end

----------------------------------------------------------------
-- VFX SHORTCUTS
----------------------------------------------------------------
local function playWallImpact(hrp)
	local kjEffects = getKJEffects()
	if not kjEffects then return end
	local wall = kjEffects:FindFirstChild("KJWallCombo")
	if not wall then return end

	local final = wall:FindFirstChild("FinalImpact")
	if final then
		local clone = cloneAndParent(final, workspace, 2.5)
		if clone then
			clone.CFrame = hrp.CFrame
			emitAll(clone)
		end
	end
end

local function playSlam(hrp)
	local kjEffects = getKJEffects()
	if not kjEffects then return end
	local wall = kjEffects:FindFirstChild("KJWallCombo")
	if not wall then return end

	local slam = wall:FindFirstChild("slam")
	if slam then
		local clone = cloneAndParent(slam, workspace, 2)
		if clone then
			clone.CFrame = hrp.CFrame
			emitAll(clone)
		end
	end
end

local function playHold(hrp)
	local kjEffects = getKJEffects()
	if not kjEffects then return end
	local wall = kjEffects:FindFirstChild("KJWallCombo")
	if not wall then return end

	local hold = wall:FindFirstChild("hold")
	if hold then
		local clone = cloneAndParent(hold, workspace, 1.8)
		if clone then
			clone.CFrame = hrp.CFrame
			emitAll(clone)
		end
	end
end

----------------------------------------------------------------
-- ANIMATION HELPER
----------------------------------------------------------------
local function playAnim(humanoid, id, priority, fade)
	if not humanoid or humanoid.Health <= 0 then return nil end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	anim:Destroy()
	if not ok or not track then return nil end

	track.Priority = priority or Enum.AnimationPriority.Action
	track:Play(fade or 0.1)
	return track
end

----------------------------------------------------------------
-- MOVES
----------------------------------------------------------------
local function setupMoves(character)
	local humanoid = character:WaitForChild("Humanoid", 8)
	local hrp = character:WaitForChild("HumanoidRootPart", 8)
	if not humanoid or not hrp then return end

	-- Saitama / common trigger IDs (we intercept them)
	local SLOT1 = "rbxassetid://12273188754" -- example, may need adjustment
	local SLOT2 = "rbxassetid://12296113986"
	local SLOT3 = "rbxassetid://12309835105"
	local SLOT4 = "rbxassetid://12351854556"

	track(humanoid.AnimationPlayed:Connect(function(track)
		if not State.Active then return end
		local id = track.Animation and track.Animation.AnimationId
		if not id then return end

		-- MOVE 1 - Signature
		if id:find("12273188754") or id:find("18447913645") then
			track:Stop(0.05)
			playAnim(humanoid, CONFIG.WallAttackerAnim, Enum.AnimationPriority.Action4)
			playHold(hrp)
			task.delay(0.35, function()
				playSlam(hrp)
			end)
			task.delay(0.7, function()
				playWallImpact(hrp)
			end)
		end

		-- MOVE 2 - Spin / Power
		if id:find("12296113986") then
			track:Stop(0.05)
			playSlam(hrp)
			local kjEffects = getKJEffects()
			if kjEffects then
				local spin = kjEffects:FindFirstChild("SPINNNN")
				if spin then
					local c = cloneAndParent(spin, hrp, 1.5)
				end
			end
		end

		-- MOVE 3 - Throw style
		if id:find("12309835105") then
			track:Stop(0.05)
			playHold(hrp)
			task.delay(0.4, function()
				playWallImpact(hrp)
			end)
		end

		-- MOVE 4 - Wall Combo
		if id:find("12351854556") then
			track:Stop(0.05)
			local t = playAnim(humanoid, CONFIG.WallAttackerAnim, Enum.AnimationPriority.Action4)
			playHold(hrp)
			task.delay(0.3, function() playSlam(hrp) end)
			task.delay(0.65, function() playWallImpact(hrp) end)
			task.delay(1.1, function() playWallImpact(hrp) end)
		end
	end), State.CharacterConnections)
end

----------------------------------------------------------------
-- CHARACTER SETUP
----------------------------------------------------------------
local function setupCharacter(character)
	cleanup(State.CharacterConnections)
	destroyEffects()

	local humanoid = character:WaitForChild("Humanoid", 10)
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not hrp then return end

	State.Active = true
	applyAura(character)
	setupMoves(character)
	updateTopbar(true)

	-- Spawn effect
	playHold(hrp)
	task.delay(0.2, function()
		playSlam(hrp)
	end)

	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "KJ",
			Text = "Moveset active",
			Duration = 3
		})
	end)

	humanoid.Died:Once(function()
		State.Active = false
		State.Ultimate = false
		destroyEffects()
		cleanup(State.CharacterConnections)
	end)
end

----------------------------------------------------------------
-- INIT
----------------------------------------------------------------
if LocalPlayer.Character then
	task.spawn(function()
		setupCharacter(LocalPlayer.Character)
	end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(0.35)
	if State.Active then
		setupCharacter(char)
	end
end)

-- Keep Topbar updated
RunService.Heartbeat:Connect(function()
	if State.Active then
		pcall(updateTopbar, true)
	end
end)

print("[KJ] Client moveset loaded")
