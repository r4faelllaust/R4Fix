------------------------------------------------------------
-- APPLY FONT
------------------------------------------------------------

local function applyFont(label)

    if not Config.Font.Enabled then
        return
    end

    if not label:IsA("TextLabel") then
        return
    end

    pcall(function()

        if not State.OriginalFonts[label] then

            State.OriginalFonts[label] = {
                Font = label.Font,
                FontFace = label.FontFace
            }

        end

        label.FontFace = Font.new(
            label.FontFace.Family,
            Config.Font.Weight,
            Config.Font.Style
        )

        label.Font = Config.Font.Font

    end)

end


------------------------------------------------------------
-- RESTORE FONT
------------------------------------------------------------

local function restoreFonts()

    for label, data in pairs(State.OriginalFonts) do

        if label and label.Parent then

            pcall(function()

                label.Font = data.Font
                label.FontFace = data.FontFace

            end)

        end

    end

    table.clear(State.OriginalFonts)

end


------------------------------------------------------------
