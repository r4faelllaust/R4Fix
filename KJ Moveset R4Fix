local function removeBarrageArm(object)

    if not object then
        return
    end

    if object:IsA("Accessory")
        and object.Name == "BarrageBind" then

        pcall(function()
            object:SetAttribute("Times", nil)
        end)

    end

end

local function connectBarrageProtection(character)

    disconnectList(State.BarrageConnections)

    if not character then
        return
    end

    for _, child in ipairs(character:GetChildren()) do
        removeBarrageArm(child)
    end

    table.insert(
        State.BarrageConnections,
        character.ChildAdded:Connect(
            removeBarrageArm
        )
    )

end

--============================================================
-- EFFECT POSITIONING
--============================================================

local function getWorldPivot(object)

    if object:IsA("BasePart") then
        return object.CFrame
    end

    if object:IsA("Model") then
        return object:GetPivot()
    end

    if object:IsA("Attachment") then
        return object.WorldCFrame
    end

    return nil

end

local function pivotObject(object, cf)

    if not object then
        return
    end

    if object:IsA("BasePart") then

        object.CFrame = cf

    elseif object:IsA("Model") then

        pcall(function()
            object:PivotTo(cf)
        end)

    elseif object:IsA("Attachment") then

        pcall(function()
            object.WorldCFrame = cf
        end)

    end

end

--============================================================
-- PREPARE CLONED EFFECT
--============================================================

local function prepareEffect(object)

    if not object then
        return
    end

    for _, descendant in ipairs(
        object:GetDescendants()
    ) do

        if descendant:IsA("BasePart") then

            descendant.CanCollide = false
            descendant.CanTouch = false
            descendant.CanQuery = false

        elseif descendant:IsA("ParticleEmitter") then

            descendant.Enabled = false

        elseif descendant:IsA("Trail") then

            descendant.Enabled = false

        elseif descendant:IsA("Beam") then

            descendant.Enabled = false

        elseif descendant:IsA("PointLight")
            or descendant:IsA("SpotLight")
            or descendant:IsA("SurfaceLight") then

            descendant.Enabled = false

        end

    end

end

--============================================================
-- EMIT VFX
--============================================================

local function emitEffect(object)

    if not object then
        return
    end

    for _, descendant in ipairs(
        object:GetDescendants()
    ) do

        if descendant:IsA("ParticleEmitter") then

            local count =
                descendant:GetAttribute("EmitCount")

            if typeof(count) ~= "number" then

                local rate = descendant.Rate

                if rate > 0 then
                    count = math.clamp(
                        math.floor(rate * 0.20),
                        4,
                        80
                    )
                else
                    count = 12
                end

            end

            pcall(function()
                descendant:Emit(count)
            end)

        elseif descendant:IsA("Trail")
            or descendant:IsA("Beam") then

            descendant.Enabled = true

        elseif descendant:IsA("PointLight")
            or descendant:IsA("SpotLight")
            or descendant:IsA("SurfaceLight") then

            descendant.Enabled = true

        end

    end

end

--============================================================
-- CLONE EFFECT
--============================================================

local function spawnEffect(
    resourceName,
    cf,
    lifetime
)

    if not State.Enabled then
        return nil
    end

    local source =
        Resources[resourceName]

    if not source then
        return nil
    end

    local clone

    local success = pcall(function()

        clone = source:Clone()

    end)

    if not success or not clone then
        return nil
    end

    clone.Parent = workspace

    prepareEffect(clone)

    pivotObject(clone, cf)

    emitEffect(clone)

    table.insert(
        State.ActiveEffects,
        clone
    )

    if lifetime then

        task.delay(
            lifetime,
            function()

                safeDestroy(clone)

            end
        )

    end

    return clone

end

--============================================================
-- ATTACH EFFECT TO ROOT
--============================================================

local function attachEffect(
    resourceName,
    parentPart
)

    if not State.Enabled then
        return nil
    end

    local source =
        Resources[resourceName]

    if not source or not parentPart then
        return nil
    end

    local clone

    local success = pcall(function()

        clone = source:Clone()

    end)

    if not success or not clone then
        return nil
    end

    clone.Parent = parentPart

    prepareEffect(clone)

    if clone:IsA("BasePart") then

        clone.CFrame =
            parentPart.CFrame

        clone.Anchored = false

        local weld =
            Instance.new("WeldConstraint")

        weld.Part0 = parentPart
        weld.Part1 = clone
        weld.Parent = clone

    elseif clone:IsA("Model") then

        local primary =
            clone.PrimaryPart

        if primary then

            primary.Anchored = false

            primary.CanCollide = false
            primary.CanTouch = false
            primary.CanQuery = false

            local weld =
                Instance.new("WeldConstraint")

            weld.Part0 = parentPart
            weld.Part1 = primary
            weld.Parent = primary

            clone:PivotTo(
                parentPart.CFrame
            )

        else

            clone:PivotTo(
                parentPart.CFrame
            )

        end

    end

    emitEffect(clone)

    table.insert(
        State.ActiveEffects,
        clone
    )

    return clone

end

--============================================================
-- AURA
--============================================================

local function enableAura()

    if State.Aura then
        return
    end

    if not State.Root then
        return
    end

    local source =
        Resources["KJ"]

    if not source then
        source =
            Resources["Everything"]
    end

    if not source then
        return
    end

    State.Aura =
        attachEffect(
            "KJ",
            State.Root
        )

    if not State.Aura
        and Resources["Everything"] then

        State.Aura =
            attachEffect(
                "Everything",
                State.Root
            )

    end

end

local function disableAura()

    if State.Aura then

        safeDestroy(State.Aura)

        State.Aura = nil

    end

end

--============================================================
