end


local function createAura()

    removeAura()

    if not State.Character then
        return
    end

    if not Resources then
        return
    end

    local everything =
        findRecursive(
            Resources,
            "Everything"
        )

    if not everything then
        warn("[KJ] Everything resource not found.")
        return
    end

    local kj =
        findRecursive(
            everything,
            "KJ"
        )

    if not kj then
        warn("[KJ] Everything.KJ not found.")
        return
    end

    local aura =
        cloneEffect(
            kj,
            State.Character
        )

    if not aura then
        return
    end

    State.Aura = aura

    enableParticles(aura)

    emitParticles(aura, 8)

end


--============================================================
-- RESOURCE EFFECT FINDER
--============================================================

local function findKJEffect(name)

    local roots = {
        KJEffects,
        KJThrow,
        UFW,
        Resources,
    }

    for _, root in ipairs(roots) do

        if root then

            local found =
                findRecursive(root, name)

            if found then
                return found
            end

        end

    end

    return nil

end


