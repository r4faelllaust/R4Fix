------------------------------------------------------------

local function setHotbarName(buttonNumber, originalName, newName)

    local hotbar = getHotbar()

    if not hotbar then
        return
    end

    local button = hotbar:FindFirstChild(buttonNumber)

    if not button then
        return
    end

    local base = button:FindFirstChild("Base")

    if not base then
        return
    end

    local toolName = getToolName(base)

    if not toolName then
        return
    end

    if not State.OriginalNames[toolName] then

        State.OriginalNames[toolName] = toolName.Text

    end

    if toolName.Text == originalName
        or toolName.Text == newName then

        toolName.Text = newName

        applyFont(toolName)

    end

end


