--============================================================
-- RECURSIVE INTERESTING OBJECT SCAN
--============================================================

section("INTERESTING KJ OBJECTS")

local interestingResults = {}

for _, root in ipairs({
    ReplicatedStorage,
    player:FindFirstChild("PlayerGui"),
    player:FindFirstChild("Backpack")
}) do

    if root then
        for _, obj in ipairs(root:GetDescendants()) do

            if interestingNames[obj.Name] then
                table.insert(interestingResults, obj)
            end

        end
    end
end

if #interestingResults == 0 then
    line("No exact-name matches found.")
else
    for _, obj in ipairs(interestingResults) do
        line(
            "[" ..
            getClassInfo(obj) ..
            "] " ..
            getFullNameSafe(obj)
        )
    end
end

