------------------------------------------------------------
-- GET BASEPART
------------------------------------------------------------

local function getBasePart(object)

    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then

        if object.PrimaryPart then
            return object.PrimaryPart
        end

        return object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    end

    return object:FindFirstChildWhichIsA(
        "BasePart",
        true
    )

end


------------------------------------------------------------
-- POSITION OBJECT
------------------------------------------------------------

local function positionObject(object, cframe)

    if not object then
        return
    end

    pcall(function()

        if object:IsA("Model") then

            if not object.PrimaryPart then

                local primary =
                    object:FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )

                if primary then
                    object.PrimaryPart = primary
                end

            end

            if object.PrimaryPart then

                object:PivotTo(cframe)

            end

        elseif object:IsA("BasePart") then

            object.CFrame = cframe

        end

    end)

end


------------------------------------------------------------
-- ENABLE PARTICLES
------------------------------------------------------------

local function enableParticles(root)

    if not root then
        return
    end

    pcall(function()

        for _, object in ipairs(root:GetDescendants()) do

            if object:IsA("ParticleEmitter") then

                object.Enabled = true

            elseif object:IsA("Beam") then

                object.Enabled = true

            elseif object:IsA("Trail") then

                object.Enabled = true

            end

        end

    end)

end


------------------------------------------------------------
-- ATTACH KJ EFFECT TO CHARACTER
------------------------------------------------------------

local function attachKJEffect(resource, name)

    if not resource then
        return nil
    end

    local character = State.Character

    local root = State.Root

    if not character or not root then
        return nil
    end

    local clone

    local ok = pcall(function()

        clone = resource:Clone()

    end)

    if not ok or not clone then
        return nil
    end

    clone.Name = name or "KJEffect"

    --------------------------------------------------------
    -- Model / Part
    --------------------------------------------------------

    if clone:IsA("Model") then

        clone.Parent = workspace

        positionObject(
            clone,
            root.CFrame
        )

    elseif clone:IsA("BasePart") then

        clone.Parent = workspace

        clone.CFrame = root.CFrame

    else

        clone.Parent = root

    end

    --------------------------------------------------------
    -- Weld / attach parts when possible.
    --------------------------------------------------------

    local primary = getBasePart(clone)

    if primary then

        pcall(function()

            primary.Anchored = false

            primary.CanCollide = false

            primary.CanTouch = false

            primary.CanQuery = false

        end)

        ----------------------------------------------------
        -- Weld the primary part to HRP.
        ----------------------------------------------------

        if primary ~= root then

            local weld = Instance.new("WeldConstraint")

            weld.Part0 = root

            weld.Part1 = primary

            weld.Parent = primary

        end

    end

    enableParticles(clone)

    trackEffect(clone)

    return clone

end


