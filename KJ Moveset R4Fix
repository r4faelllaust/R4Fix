local function getWallCombo()
    local effects = getKJEffects()

    if not effects then
        return nil
    end

    return effects:FindFirstChild("KJWallCombo")
end

local function wallEffect(name, cframe, lifetime)
    local wallCombo = getWallCombo()

    if not wallCombo then
        warn("[KJ] KJWallCombo missing.")
        return nil
    end

    local resource =
        wallCombo:FindFirstChild(name, true)

    if not resource then
        warn(
            "[KJ] Wall resource missing:",
            name
        )

        return nil
    end

    return placeResource(
        resource,
        cframe,
        lifetime
    )
end

local function createWallAura()
    local wallCombo = getWallCombo()

    if not wallCombo then
        return
    end

    local character = state.Character

    if not character then
        return
    end

    local userAura =
        wallCombo:FindFirstChild("UserAura")

    if not userAura then
        return
    end

    local bodyParts = {

        "Head",
        "Torso",

        "UpperTorso",
        "LowerTorso",

        "Left Arm",
        "Right Arm",

        "LeftHand",
        "RightHand",

        "Left Leg",
        "Right Leg",

        "LeftFoot",
        "RightFoot",
    }

    for _, partName in ipairs(bodyParts) do

        local bodyPart =
            character:FindFirstChild(partName)

        if bodyPart then

            for _, auraObject in ipairs(
                userAura:GetChildren()
            ) do

                if
                    auraObject:IsA("ParticleEmitter")
                    or auraObject:IsA("Attachment")
                then

                    local clone =
                        auraObject:Clone()

                    clone.Parent = bodyPart

                    enableParticles(clone)

