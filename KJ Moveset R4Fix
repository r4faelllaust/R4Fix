end


------------------------------------------------------------
-- FIND RECURSIVE
------------------------------------------------------------

local function findRecursive(root, name)

    if not root then
        return nil
    end

    local ok, result = pcall(function()
        return root:FindFirstChild(name, true)
    end)

    if ok then
        return result
    end

    return nil
end


------------------------------------------------------------
-- FIND ALL
------------------------------------------------------------

local function findAll(root, name)

    local results = {}

    if not root then
        return results
    end

    pcall(function()

        for _, object in ipairs(root:GetDescendants()) do

            if object.Name == name then
                table.insert(results, object)
            end

        end

    end)

    return results
end


------------------------------------------------------------
-- RESOURCE ROOT
------------------------------------------------------------

local Resources = ReplicatedStorage:FindFirstChild("Resources")


------------------------------------------------------------
-- KJ RESOURCE SEARCH
------------------------------------------------------------

local function findKJResource(name)

    --------------------------------------------------------
    -- First try Resources.KJEffects
    --------------------------------------------------------

    if Resources then

        local kjEffects = Resources:FindFirstChild("KJEffects")

        if kjEffects then

            local result = findRecursive(kjEffects, name)

            if result then
                return result
            end

        end

        ----------------------------------------------------
        -- Then search all Resources.
        ----------------------------------------------------

        local result = findRecursive(Resources, name)

        if result then
            return result
        end
    end

    --------------------------------------------------------
    -- Finally search ReplicatedStorage.
    --------------------------------------------------------

    return findRecursive(ReplicatedStorage, name)
end


