local function playSound(soundId, volume, speed)
    local root = getRoot(state.Character)

    if not root then
        return nil
    end

    local sound = Instance.new("Sound")

    sound.SoundId = soundId
    sound.Volume = volume or 1
    sound.PlaybackSpeed = speed or 1
    sound.RollOffMaxDistance = 100
    sound.RollOffMinDistance = 5

    sound.Parent = root

    table.insert(state.Sounds, sound)

    sound:Play()

    Debris:AddItem(sound, 10)

    return sound
end

--============================================================
-- EFFECT HELPERS
--============================================================

local function getMaxParticleLifetime(root)
    local longest = 1

    if not root then
        return longest
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter") then

            local lifetime = object.Lifetime

            longest = math.max(
                longest,
                lifetime.Max
            )

        end

    end

    return longest
end

local function emitParticles(root, multiplier)
    if not root then
        return
    end

    multiplier = multiplier or 1

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter") then

            local count = object:GetAttribute("EmitCount")

            if typeof(count) ~= "number" then
                count = object:GetAttribute("Emit")

            end

            if typeof(count) ~= "number" then
                count = 1
            end

            count = math.max(
                1,
                math.floor(count * multiplier)
            )

            safe(function()
                object:Emit(count)
            end)

        end

    end
end

local function enableParticles(root)
    if not root then
        return
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter") then
            object.Enabled = true
        elseif object:IsA("Trail") then
            object.Enabled = true
        elseif object:IsA("Beam") then
            object.Enabled = true
        elseif object:IsA("Fire") then
            object.Enabled = true
        elseif object:IsA("Smoke") then
            object.Enabled = true
        elseif object:IsA("Sparkles") then
            object.Enabled = true
        end

    end
end

local function disableParticles(root)
    if not root then
        return
    end

    for _, object in ipairs(root:GetDescendants()) do

        if object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam")
            or object:IsA("Fire")
            or object:IsA("Smoke")
            or object:IsA("Sparkles")
        then
            object.Enabled = false
        end

    end
end

--============================================================
-- PLACE EXISTING RESOURCE
--============================================================

local function prepareVisualObject(root)
    if not root then
        return nil
    end

    local clone = root:Clone()

    for _, object in ipairs(clone:GetDescendants()) do

        if object:IsA("BasePart") then
            object.Anchored = true
            object.CanCollide = false
            object.CanTouch = false
            object.CanQuery = false
            object.Massless = true
        end

    end

    return clone
end

local function placeResource(resource, cframe, lifetime)
    if not resource then
        return nil
    end

    local clone = prepareVisualObject(resource)

    if not clone then
        return nil
    end

    local container

    if clone:IsA("Model") then

        container = clone

    elseif clone:IsA("BasePart") then

        container = clone

    else

        container = Instance.new("Model")
        container.Name = "KJEffect"

        for _, child in ipairs(clone:GetChildren()) do
            child.Parent = container
        end

        clone:Destroy()
    end

    container.Parent = Workspace

    if container:IsA("PVInstance") then
        safe(function()
            container:PivotTo(cframe)
        end)
    end

    emitParticles(container, 1)
    enableParticles(container)

    table.insert(state.Effects, container)

    local destroyTime =
        lifetime
        or math.max(
            2,
            getMaxParticleLifetime(container) + 1
        )

    Debris:AddItem(container, destroyTime)

    return container
end

--============================================================
-- ATTACH RESOURCE TO CHARACTER PART
--============================================================

local function attachResource(resource, part)
    if not resource or not part then
        return nil
    end

    local clone = resource:Clone()

    clone.Parent = part

    if clone:IsA("Attachment") then
        clone.CFrame = CFrame.new()
    end

    enableParticles(clone)
    emitParticles(clone, 1)

    table.insert(state.Effects, clone)

    return clone
end

--============================================================
-- KJ AURA
--============================================================

local function clearAura()
    destroyInstance(state.Aura)
    state.Aura = nil
end

local function createAura()
    clearAura()

    local character = state.Character

    if not character then
        return
    end

    local ufw = getUFW()

    if not ufw then
        warn("[KJ] Resources.UFW missing.")
        return
    end

    local vfx = ufw:FindFirstChild("vfx")

    if not vfx then
        warn("[KJ] Resources.UFW.vfx missing.")
        return
    end

    local everything = vfx:FindFirstChild("Everything")

    if not everything then
        warn("[KJ] Resources.UFW.vfx.Everything missing.")
        return
    end

    local kj = everything:FindFirstChild("KJ")

    if not kj then
        warn("[KJ] Resources.UFW.vfx.Everything.KJ missing.")
        return
    end

    local surface = kj:FindFirstChild("Surface", true)
    local attachment = surface
        and surface:FindFirstChild("Attachment", true)

    if attachment then

        local root = getRoot(character)

        if root then

            state.Aura = attachment:Clone()
            state.Aura.Name = "KJClientAura"
            state.Aura.Parent = root

            enableParticles(state.Aura)

        end

    else

        -- Fallback:
        -- clone the entire KJ model if the exact attachment
        -- hierarchy is different in this version of the game.

        local root = getRoot(character)

        if root then

            local aura = kj:Clone()

            aura.Name = "KJClientAura"

            aura.Parent = Workspace

            if aura:IsA("PVInstance") then
                safe(function()
                    aura:PivotTo(root.CFrame)
                end)
            end

            for _, object in ipairs(aura:GetDescendants()) do

                if object:IsA("BasePart") then

                    object.Anchored = false
                    object.CanCollide = false
                    object.CanTouch = false
                    object.CanQuery = false
                    object.Massless = true

                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = root
                    weld.Part1 = object
                    weld.Parent = object

                end

            end

            state.Aura = aura

        end

    end
end

