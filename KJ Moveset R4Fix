local function getKJButton()

    local topbar =
        PlayerGui:FindFirstChild("TopbarPlus")

    if not topbar then
        return nil
    end

    local container =
        topbar:FindFirstChild("TopbarContainer")

    if not container then
        return nil
    end

    local unnamedIcon =
        container:FindFirstChild("UnnamedIcon")

    if not unnamedIcon then
        return nil
    end

    local dropdown =
        unnamedIcon:FindFirstChild("DropdownContainer")

    if not dropdown then
        return nil
    end

    local frame =
        dropdown:FindFirstChild("DropdownFrame")

    if not frame then
        return nil
    end

    return frame:FindFirstChild("KJ")
end

local function keepKJVisible()

    local kj = getKJButton()

    if not kj then
        return
    end

    kj.Visible = true

    if kj:IsA("GuiButton") then

        kj.Active = true
        kj.Selectable = true

    end

end

