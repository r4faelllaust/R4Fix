local function disableKJ()

    State.KJActive =
        false

    State.UltimateActive =
        false

    State.Busy =
        false

    disconnectList(
        State.CharacterConnections
    )

    stopKJAnimations()

    destroyTrackedEffects()

    removeAura()

    restoreMoveNames()

    M1Index = 0

end

--============================================================
-- ENABLE KJ AFTER RESPAWN
--============================================================

local function enableKJ()

    if State.KJActive then

        notifyAlreadyKJ()

        return

    end

    local remaining =
        getRemainingCooldown()

    if remaining > 0 then

        notifySwitchCooldown()

        return

    end

    State.LastSwitch =
        os.clock()

    State.KJActive =
        true

    State.UltimateActive =
        false

    State.Busy =
        true

    notify(
        "BENACHRICHTIGUNG",
        "KJ",
        2
    )

    -- Kill the current character so the game's
    -- normal respawn process creates a fresh character.
    --
    -- This does NOT fake server character selection.
    -- The KJ state is reapplied locally after respawn.

    local character =
        Player.Character

    local humanoid =
        character
        and character:FindFirstChildOfClass(
            "Humanoid"
        )

    if humanoid then

        State.RespawnRequested =
            true

        pcall(function()
            humanoid.Health = 0
        end)

    else

        State.Busy =
            false

    end

end

--============================================================
-- CHARACTER SWITCH BACK TO SAITAMA
--============================================================

local function disableAndRespawn()

    local remaining =
        getRemainingCooldown()

    if remaining > 0 then

        notifySwitchCooldown()

        return

    end

    State.LastSwitch =
        os.clock()

    disableKJ()

    notify(
        "BENACHRICHTIGUNG",
        "Saitama",
        2
    )

    local character =
        Player.Character

    local humanoid =
        character
        and character:FindFirstChildOfClass(
            "Humanoid"
        )

    if humanoid then

        pcall(function()
            humanoid.Health = 0
        end)

    end

end

