local function removeSaitamaEffects()

    local character = State.Character

    if not character then
        return
    end

    pcall(function()

        for _, object in ipairs(character:GetDescendants()) do

            local lowerName =
                string.lower(object.Name)

            ------------------------------------------------
            -- Your original BarrageBind cleanup.
            ------------------------------------------------

            if object:IsA("Accessory")
                and object.Name == "BarrageBind" then

                object:Destroy()

            ------------------------------------------------
            -- Saitama-specific visual objects.
            ------------------------------------------------

            elseif (
                string.find(lowerName, "saitama", 1, true)
                or string.find(lowerName, "normalpunch", 1, true)
                or string.find(lowerName, "seriouspunch", 1, true)
            ) then

                if object:IsA("ParticleEmitter")
                    or object:IsA("Beam")
                    or object:IsA("Trail")
                    or object:IsA("Attachment")
                    or object:IsA("Folder")
                    or object:IsA("Model") then

                    object:Destroy()

                end

            end

        end

    end)

end


