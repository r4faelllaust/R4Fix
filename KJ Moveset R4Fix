local ConnectedKJButton = nil

local function connectKJButton()

    local kj =
        getKJButton()

    if not kj then
        return
    end

    if ConnectedKJButton == kj then
        return
    end

    ConnectedKJButton =
        kj

    local button =
        kj:FindFirstChild("IconButton")

    if not button then
        button =
            kj:FindFirstChildOfClass(
                "GuiButton"
            )
    end

    if not button then
        return
    end

    trackConnection(
        button.Activated:Connect(function()

            keepKJVisible()

            if State.KJActive then

                notifyAlreadyKJ()

                return

            end

            enableKJ()

        end)
    )

end

