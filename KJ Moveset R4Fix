------------------------------------------------------------
-- PLAY KJ ANIMATION
------------------------------------------------------------

local function playKJAnimation(animationId, speed)

    local humanoid = State.Humanoid

    if not humanoid then
        return nil
    end

    if humanoid.Health <= 0 then
        return nil
    end

    local animation = Instance.new("Animation")

    animation.AnimationId = animationId

    local ok, track = pcall(function()
        return humanoid:LoadAnimation(animation)
    end)

    if not ok or not track then

        safeDestroy(animation)

        return nil

    end

    track.Priority = Enum.AnimationPriority.Action

    track:Play(0.05, 1, speed or 1)

    table.insert(State.Tracks, track)

    track.Stopped:Connect(function()

        for i = #State.Tracks, 1, -1 do

            if State.Tracks[i] == track then
                table.remove(State.Tracks, i)
                break
            end

        end

        safeDestroy(animation)

    end)

    return track

end


