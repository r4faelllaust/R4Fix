--============================================================
-- TOPBARPLUS
--============================================================

local function getTopbarModule()
    local candidates = {

        ReplicatedStorage:FindFirstChild(
            "Icon"
        ),

        ReplicatedStorage:FindFirstChild(
            "TopbarPlus"
        ),

    }

    for _, candidate in ipairs(candidates) do

        if candidate
            and candidate:IsA("ModuleScript")
        then
            return candidate
        end

    end

    -- Search a little deeper.

    for _, object in ipairs(
        ReplicatedStorage:GetDescendants()
    ) do

        if object:IsA("ModuleScript")
            and object.Name == "Icon"
        then
            return object
        end

    end

    return nil
end

local function getIconLabel(icon)

    if not icon then
        return nil
    end

    local label = safe(function()
        return icon:getInstance("Label")
    end, nil)

    if label
        and label:IsA("TextLabel")
    then
        return label.Text
    end

    return nil
end

local function isKJIcon(icon)

    if not icon then
        return false
    end

    local name =
        safe(function()
            return icon.name
        end, "")

    if string.lower(
        tostring(name)
    ) == "kj"
    then
        return true
    end

    local label =
        getIconLabel(icon)

    if label
        and string.lower(label) == "kj"
    then
        return true
    end

    return false
end

local function bindTopbarIcon(icon)

    if not icon then
        return false
    end

    if not isKJIcon(icon) then
        return false
    end

    if state.TopbarBound then
        return true
    end

    state.TopbarBound = true

    safe(function()

        icon.selected:Connect(function()

            setKJEnabled(true)

        end)

        icon.deselected:Connect(function()

            setKJEnabled(false)

        end)

    end)

    local selected =
        safe(function()
            return icon.isSelected
        end, false)

    if selected then
        task.defer(function()
            setKJEnabled(true)
        end)
    end

    return true
end

function setKJEnabled(enabled)
    if enabled == state.Enabled then
        return
    end

    state.Enabled = enabled

    if enabled then

        local character =
            player.Character

        if character then

            setupCharacter(
                character
            )

        end

        bindInputs()

        setKJDisplayName(true)

        createAura()

        showKJDialogue(
            "KJ."
        )

        print(
            "[KJ] Moveset enabled."
        )

    else

        state.UltimateToken += 1

        state.UltimateActive = false
        state.Busy = false

        unbindInputs()

        clearAura()

        stopKJTracks()

        for _, effect in ipairs(
            state.Effects
        ) do
            destroyInstance(effect)
        end

        table.clear(
            state.Effects
        )

        for _, sound in ipairs(
            state.Sounds
        ) do
            destroyInstance(sound)
        end

        table.clear(
            state.Sounds
        )

        if state.DialogueGui then
            destroyInstance(
                state.DialogueGui
            )

            state.DialogueGui = nil
        end

        setKJDisplayName(false)

        setFOV(
            state.CameraOriginal
                or 70,
            0.25
        )

        print(
            "[KJ] Moveset disabled."
        )

    end
end

local function scanTopbarIcons()

    local module =
        getTopbarModule()

    if not module then
        return false
    end

    local Icon =
        safe(function()
            return require(module)
        end, nil)

    if not Icon then
        return false
    end

    -- TopbarPlus v3 API.

    if type(Icon.getIcons) == "function" then

        local icons =
            safe(function()
                return Icon.getIcons()
            end, {})

        for _, icon in pairs(icons) do

            if bindTopbarIcon(icon) then
                return true
            end

        end

    end

    -- Older TopbarPlus compatibility.

    if Icon.IconController
        and type(
            Icon.IconController.getIcons
        ) == "function"
    then

        local icons =
            safe(function()
                return Icon.IconController:getIcons()
            end, {})

        for _, icon in pairs(icons) do

            if bindTopbarIcon(icon) then
                return true
            end

        end

    end

    return false
end

--============================================================
-- TOPBAR GUI FALLBACK
--============================================================

local function scanKJGuiButtons()

    local playerGui =
        player:FindFirstChild("PlayerGui")

    if not playerGui then
        return
    end

    for _, object in ipairs(
        playerGui:GetDescendants()
    ) do

        if object:IsA("TextButton")
            or object:IsA("ImageButton")
        then

            local lower =
                string.lower(
                    tostring(object.Name)
                )

            if lower == "kj" then

                if not object:GetAttribute(
                    "KJClientBound"
                ) then

                    object:SetAttribute(
                        "KJClientBound",
                        true
                    )

                    addConnection(
                        object.Activated:Connect(
                            function()
                                setKJEnabled(
                                    true
                                )
                            end
                        )
                    )

                end

            end

        end

    end

end

--============================================================
-- CHARACTER SETUP
--============================================================

function setupCharacter(character)

    state.Character = character

    state.Humanoid =
        getHumanoid(character)

    state.Animator =
        getAnimator(character)

    state.OriginalDisplayName = nil

    if state.Enabled then

        setKJDisplayName(true)

        task.delay(
            0.25,
            function()

                if
                    state.Enabled
                    and state.Character
                    == character
                then

                    createAura()

                end

            end
        )

    end

    local humanoid =
        state.Humanoid

    if humanoid then

        addConnection(
            humanoid.Died:Connect(
                function()

                    stopKJTracks()

                    clearAura()

                    state.Busy = false
                    state.UltimateActive = false

                end
            )
        )

    end
end

--============================================================
-- RESPAWN
--============================================================

addConnection(
    player.CharacterAdded:Connect(
        function(character)

            task.wait()

            setupCharacter(
                character
            )

        end
    )
)

addConnection(
    player.CharacterRemoving:Connect(
        function(character)

            if state.Character
                == character
            then

                stopKJTracks()

                clearAura()

                state.Character = nil
                state.Humanoid = nil
                state.Animator = nil

            end

        end
    )
)

--============================================================
-- INITIAL CHARACTER
--============================================================

if player.Character then

    setupCharacter(
        player.Character
    )

end

--============================================================
-- TOPBAR WATCHER
--============================================================

task.spawn(function()

    while true do

        if not state.TopbarBound then

            local found =
                scanTopbarIcons()

            if not found then
                scanKJGuiButtons()
            end

        end

        task.wait(1)

    end

end)

