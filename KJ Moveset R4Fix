--============================================================
-- ANIMATION INTERCEPTION
--============================================================

local function onAnimationPlayed(track)

    if not State.Enabled then
        return
    end

    local id =
        getAnimationId(track)

    if not id then
        return
    end

    local callback =
        SaitamaAnimations[
            tostring(id)
        ]

    if not callback then
        return
    end

    pcall(function()
        track:Stop(0.025)
    end)

    task.defer(
        function()

            if State.Enabled then
                callback()
            end

        end
    )

end

--============================================================
-- CHARACTER SETUP
--============================================================

local function cleanupCharacter()

    disconnectList(
        State.CharacterConnections
    )

    disconnectList(
        State.BarrageConnections
    )

    State.Character =
        nil

    State.Humanoid =
        nil

    State.Root =
        nil

end

local function setupCharacter(character)

    cleanupCharacter()

    if not character then
        return
    end

    local humanoid =
        character:WaitForChild(
            "Humanoid",
            10
        )

    local root =
        character:WaitForChild(
            "HumanoidRootPart",
            10
        )

    if not humanoid or not root then
        return
    end

    State.Character =
        character

    State.Humanoid =
        humanoid

    State.Root =
        root

    connectBarrageProtection(
        character
    )

    table.insert(
        State.CharacterConnections,
        humanoid.AnimationPlayed:Connect(
            onAnimationPlayed
        )
    )

    table.insert(
        State.CharacterConnections,
        humanoid.Died:Connect(
            function()

                State.Busy =
                    false

                newAction()

                disableAura()

                restoreFOV()

            end
        )
    )

    if State.Enabled then

        task.wait(
            0.15
        )

        if State.Enabled then

            playSpawn()

            enableAura()

            updateHotbar()

            updateUltimateBar()

        end

    end

end

--============================================================
-- ENABLE KJ
--============================================================

function activateKJ()

    if State.Enabled then
        return
    end

    State.Enabled =
        true

    State.UltimateActive =
        false

    State.Busy =
        false

    State.UltimateValue =
        0

    State.M1Index =
        0

    State.LastM1 =
        0

    discoverResources()

    local character =
        LocalPlayer.Character

    if character then

        setupCharacter(
            character
        )

    end

    createUltimateBar()

    updateHotbar()

    updateUltimateBar()

    task.delay(
        0.3,
        function()

            if State.Enabled then

                makeKJVisible()
                connectKJTopbar()

            end

        end
    )

    notify(
        "KJ",
        "KJ equipped.",
        2
    )

end

--============================================================
-- DISABLE KJ
--============================================================

local function disableKJ()

    if not State.Enabled then
        return
    end

    State.Enabled =
        false

    State.UltimateActive =
        false

    State.Busy =
        false

    newAction()

    disableAura()

    stopKJTracks()

    restoreFOV()

    for _, sound in ipairs(
        State.ActiveSounds
    ) do

        pcall(function()
            sound:Stop()
        end)

        safeDestroy(sound)

    end

    table.clear(
        State.ActiveSounds
    )

    for _, effect in ipairs(
        State.ActiveEffects
    ) do

        safeDestroy(effect)

    end

    table.clear(
        State.ActiveEffects
    )

    restoreHotbar()

    destroyUltimateBar()

end

--============================================================
-- INPUT
--============================================================

table.insert(
    State.Connections,
    UserInputService.InputBegan:Connect(
        function(input, processed)

            if processed then
                return
            end

            if not State.Enabled then
                return
            end

            -- M1 is intentionally left to the base game.
            -- The Saitama M1 animation is intercepted.

            if input.KeyCode
                == Enum.KeyCode.One then

                if State.UltimateActive then
                    ultimate20Series()
                else
                    moveRavage()
                end

            elseif input.KeyCode
                == Enum.KeyCode.Two then

                if State.UltimateActive then
                    ultimateStoicBomb()
                else
                    moveSwiftSweep()
                end

            elseif input.KeyCode
                == Enum.KeyCode.Three then

                if State.UltimateActive then
                    ultimateFiveSeasons()
                else
                    moveCollateral()
                end

            elseif input.KeyCode
                == Enum.KeyCode.Four then

                if State.UltimateActive then
                    ultimateFlexworks()
                else
                    moveSpiralingStorm()
                end

            elseif input.KeyCode
                == Enum.KeyCode.G then

                startUltimate()

            end

        end
    )
)

