-- CHARACTER SETUP
--============================================================

local function disconnectCharacter()

    clearConnectionList(
        state.CharacterConnections
    )

    state.AnimationConnection = nil

end

local function setupCharacter(character)

    disconnectCharacter()

    if not character then
        return
    end

    local humanoid =
        character:WaitForChild(
            "Humanoid",
            10
        )

    local root =
        character:WaitForChild(
            "HumanoidRootPart",
            10
        )

    if not humanoid or not root then
        return
    end

    state.Character =
        character

    state.Humanoid =
        humanoid

    state.Root =
        root

    state.M1Index = 0
    state.LastM1 = 0
    state.Busy = false
    state.CurrentAction = nil

    state.AnimationConnection =
        humanoid.AnimationPlayed:Connect(
            onAnimationPlayed
        )

    table.insert(
        state.CharacterConnections,
        state.AnimationConnection
    )

    table.insert(
        state.CharacterConnections,
        humanoid.Died:Connect(
            function()

                state.Busy = false
                state.CurrentAction = nil

                disableAura()
                restoreFOV()

            end
        )
    )

    if state.Enabled then

        task.delay(
            0.2,
            function()

                if not state.Enabled then
                    return
                end

                if state.Character ~= character then
                    return
                end

                enableAura()

                playAnimation(
                    CONFIG.Spawn,
                    1,
                    Enum.AnimationPriority.Action
                )

                if state.Root then

                    cloneEffect(
                        "Everything",
                        state.Root.CFrame,
                        3
                    )

                end

                updateHotbar()

            end
        )

    end

end

