local function connectMarker(
    track,
    markerName,
    callback
)

    if not track then
        return false
    end

    local success, connection =
        pcall(function()

            return track:GetMarkerReachedSignal(
                markerName
            ):Connect(
                callback
            )

        end)

    if success and connection then

        table.insert(
            State.CharacterConnections,
            connection
        )

        return true

    end

    return false

end

