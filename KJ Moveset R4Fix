local p = game:GetService("Players").LocalPlayer
local gui = p:WaitForChild("PlayerGui")

local kj = gui
    :FindFirstChild("TopbarPlus")
    and gui.TopbarPlus:FindFirstChild("TopbarContainer")
    and gui.TopbarPlus.TopbarContainer:FindFirstChild("UnnamedIcon")
    and gui.TopbarPlus.TopbarContainer.UnnamedIcon:FindFirstChild("DropdownContainer")
    and gui.TopbarPlus.TopbarContainer.UnnamedIcon.DropdownContainer:FindFirstChild("DropdownFrame")
    and gui.TopbarPlus.TopbarContainer.UnnamedIcon.DropdownContainer.DropdownFrame:FindFirstChild("KJ")

if kj then
    print("KJ:", kj:GetFullName(), kj.ClassName)

    for _, v in ipairs(kj:GetDescendants()) do
        print(v:GetFullName(), v.ClassName)
    end
end
