--============================================================

local function performM1()

    if not State.Enabled
        or State.UltimateActive
        or State.Busy then

        return

    end

    if not State.Humanoid then
        return
    end

    local now =
        os.clock()

    if now - State.LastM1
        > 0.9 then

        State.M1Index = 1

    else

        State.M1Index += 1

        if State.M1Index > 4 then
            State.M1Index = 1
        end

    end

    State.LastM1 =
        now

    local index =
        State.M1Index

    stopKJTracks()

    local track =
        playAnimation(
            CONFIG.M1[index],
            1,
            Enum.AnimationPriority.Action4,
            0.025
        )

    if not track then
        return
    end

    local hitDone = false

    local function hit()

        if hitDone then
            return
        end

        hitDone = true

        if not State.Enabled then
            return
        end

        if State.Root then

            spawnEffect(
                "PunchFX",
                State.Root.CFrame
                    * CFrame.new(
                        0,
                        0,
                        -2
                    ),
                0.8
            )

            playSound(
                CONFIG.HitSound,
                0.55,
                1
            )

        end

        addUltimate(
            CONFIG.UltimateGainPerM1
        )

    end

    if not connectMarker(
        track,
        "Hit",
        hit
    ) then

        task.delay(
            CONFIG.Timings.M1Hit[index],
            hit
        )

    end

end

