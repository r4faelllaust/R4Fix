local function getDialogueModule()

    local resources =
        ReplicatedStorage:FindFirstChild(
            "Resources"
        )

    if resources then

        local ufw =
            resources:FindFirstChild(
                "UFW"
            )

        if ufw then

            local module =
                ufw:FindFirstChild(
                    "TekrinnDialogue"
                )

            if module
                and module:IsA("ModuleScript") then

                return module

            end

        end

    end

    local ufw =
        ReplicatedStorage:FindFirstChild(
            "UFW"
        )

    if ufw then

        local module =
            ufw:FindFirstChild(
                "TekrinnDialogue"
            )

        if module
            and module:IsA("ModuleScript") then

            return module

        end

    end

    return nil

end

local function speak(text)

    local module =
        getDialogueModule()

    if not module then
        return false
    end

    local success, dialogue =
        pcall(require, module)

    if not success
        or type(dialogue) ~= "table" then

        return false

    end

    if type(dialogue.Speak)
        ~= "function" then

        return false

    end

    local ok =
        pcall(function()

            dialogue.Speak({

                {
                    Text = text,

                    Bold = true,

                    Italic = false,

                    TypeSpeed = 0.025,

                    Color =
                        ColorSequence.new({

                            ColorSequenceKeypoint.new(
                                0,
                                Color3.fromRGB(
                                    255,
                                    255,
                                    255
                                )
                            ),

                            ColorSequenceKeypoint.new(
                                0.5,
                                Color3.fromRGB(
                                    255,
                                    20,
                                    20
                                )
                            ),

                            ColorSequenceKeypoint.new(
                                1,
                                Color3.fromRGB(
                                    255,
                                    255,
                                    255
                                )
                            ),

                        }),

                    TextStrokeColor =
                        Color3.new(
                            0,
                            0,
                            0
                        ),

                    Shake = {
                        Enabled = false,
                        Intensity = 1,
                        Lifetime = 2,
                    },

                }

            })

        end)

    return ok

end

