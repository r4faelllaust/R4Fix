--============================================================

local ResourceCache = {}

local function discoverResources()

    table.clear(ResourceCache)

    if not KJEffects then
        warn("[KJ] Resources.KJEffects not found")
        return
    end

    local names = {

        "KJWallCombo",
        "KJThrow",
        "PunchFX",

        "KJ",
        "Everything",

        "KJBlack",
        "KJWhite",

        "KJWallBreak",
        "RockJump",

        "Walls",

        "FinalImpact",
        "FinalImpactHUGEignore",

        "hold",
        "feet",
        "slam",

        "ImpactEffect",
        "ImpactEffect2",

        "CollateralWind",
        "SpinningWind",

        "KickShockwave",
        "speedlines",

        "spinnerthing",

        "ThrowPart",

        "HitParticles",
        "LeapParticles",

        "barrage",
        "uppercutmesh",
        "uppercutimpact",

        "stoic bomb",
        "stoicarrive"
    }

    for _, name in ipairs(names) do

        local found = findRecursive(KJEffects, name)

        if found then
            ResourceCache[name] = found
        end

    end
end

discoverResources()

