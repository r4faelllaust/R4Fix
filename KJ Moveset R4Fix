------------------------------------------------------------
-- ENABLE VFX
------------------------------------------------------------

local function enableVFX(
    object,
    enabled
)

    if not object then
        return
    end

    for _, descendant
        in ipairs(
            object:GetDescendants()
        ) do

        if descendant:IsA(
            "ParticleEmitter"
        ) then

            pcall(function()
                descendant.Enabled =
                    enabled
            end)

        elseif descendant:IsA(
            "Trail"
        ) then

            pcall(function()
                descendant.Enabled =
                    enabled
            end)

        elseif descendant:IsA(
            "Beam"
        ) then

            pcall(function()
                descendant.Enabled =
                    enabled
            end)

        end

    end

end

------------------------------------------------------------
-- CREATE AURA
------------------------------------------------------------

local function removeAura()

    if State.Aura then

        safeDestroy(
            State.Aura
        )

        State.Aura = nil

    end

end

local function createAura()

    removeAura()

    if not State.Active then
        return
    end

    if not State.Character then
        return
    end

    local source =
        getKJAura()

    if not source then

        warn(
            "[KJ] Resources.UFW.vfx.Everything.KJ not found"
        )

        return
    end

    local aura =
        source:Clone()

    aura.Name =
        "KJ_Local_Aura"

    aura.Parent =
        State.Character

    State.Aura =
        aura

    enableVFX(
        aura,
        true
    )

    --------------------------------------------------------
    -- Make VFX non-physical
    --------------------------------------------------------

    for _, object
        in ipairs(
            aura:GetDescendants()
        ) do

        if object:IsA(
            "BasePart"
        ) then

            pcall(function()

                object.CanCollide =
                    false

                object.CanTouch =
                    false

                object.CanQuery =
                    false

                object.Massless =
                    true

            end)

        end

    end

end

------------------------------------------------------------
-- POSITION RESOURCE
------------------------------------------------------------

local function positionResource(
    object
)

    if not object or not State.Root then
        return
    end

    if object:IsA("Model") then

        pcall(function()

            object:PivotTo(
                State.Root.CFrame
            )

        end)

    elseif object:IsA("BasePart") then

        pcall(function()

            object.CFrame =
                State.Root.CFrame

        end)

    end

end

------------------------------------------------------------
-- PLAY KJ VFX
------------------------------------------------------------

local function playKJVFX(
    name,
    lifetime
)

    if not State.Active then
        return nil
    end

    local folder =
        getWallCombo()

    if not folder then

        warn(
            "[KJ] KJWallCombo folder not found"
        )

        return nil
    end

    local source =
        folder:FindFirstChild(
            name,
            true
        )

    if not source then

        warn(
            "[KJ] VFX not found:",
            name
        )

        return nil
    end

    local clone =
        source:Clone()

    clone.Name =
        "KJ_Local_" .. name

    clone.Parent =
        workspace

    positionResource(
        clone
    )

    enableVFX(
        clone,
        true
    )

    table.insert(
        State.Temporary,
        clone
    )

    if lifetime then

        Debris:AddItem(
            clone,
            lifetime
        )

    end

    return clone

