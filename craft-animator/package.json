{
  "name": "craft-animator",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Craft Animator — open-source Adobe Animate–style 2D animation with FLA/XFL rig import",
  "main": "electron/main.cjs",
  "author": "Craft Animator",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:import": "node scripts/make-sample-fla.mjs && node scripts/smoke-import.mjs",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "desktop": "npm run build && electron .",
    "desktop:install": "bash scripts/install-to-desktop.sh",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage dir --publish never",
    "dist:win": "npm run build && electron-builder --win portable --publish never",
    "dist:mac": "npm run build && electron-builder --mac dir --publish never"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "app.craftanimator.desktop",
    "productName": "Craft Animator",
    "copyright": "MIT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "Craft-Animator-${version}.${ext}"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Craft-Animator-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "artifactName": "Craft-Animator-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Craft-Animator-Portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Craft Animator"
    }
  }
}
