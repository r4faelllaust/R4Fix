@bot.tree.command(
    name="petition",
    description="Erstellt eine politische Petition."
)
@app_commands.describe(
    titel="Titel der Petition.",
    begruendung="Begründung der Petition."
)
async def petition(
    interaction: discord.Interaction,
    titel: str,
    begruendung: str
):

    petition_id = len(data["petitions"]) + 1

    petition_data = {
        "id": petition_id,
        "author": interaction.user.id,
        "title": titel,
        "reason": begruendung,
        "created": datetime.now(timezone.utc).isoformat(),
        "signatures": []
    }

    data["petitions"].append(petition_data)
    save_data()

    embed = austro_embed(
        f"📜 PETITION #{petition_id}",
        f"## {titel}\n\n"
        f"{begruendung}\n\n"
        f"👤 Eingereicht von: {interaction.user.mention}\n\n"
        f"✍️ Unterstützer: **0**"
    )

    message = await interaction.channel.send(embed=embed)

    await message.add_reaction("✍️")

    await interaction.response.send_message(
        f"📜 Petition #{petition_id} wurde erstellt.",
