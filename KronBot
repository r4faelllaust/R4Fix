# ============================================================
# DATABASE
# ============================================================

DATA_FILE = "austrokron_data.json"


def load_data():
    if not os.path.exists(DATA_FILE):
        return {
            "warnings": {},
            "petitions": [],
            "proposals": [],
            "votes": []
        }

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {
            "warnings": {},
            "petitions": [],
            "proposals": [],
            "votes": []
        }


data = load_data()


def save_data():
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)


