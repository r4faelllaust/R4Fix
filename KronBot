@bot.tree.command(
    name="warn",
    description="Verwarnt einen Benutzer."
)
@app_commands.checks.has_permissions(moderate_members=True)
@app_commands.describe(
    user="Der zu verwarnende Benutzer.",
    grund="Grund der Verwarnung."
)
async def warn(
    interaction: discord.Interaction,
    user: discord.Member,
    grund: str
):

    user_id = str(user.id)

    if user_id not in data["warnings"]:
        data["warnings"][user_id] = []

    warning = {
        "reason": grund,
        "moderator": interaction.user.id,
        "time": datetime.now(timezone.utc).isoformat()
    }

    data["warnings"][user_id].append(warning)

    save_data()

    count = len(data["warnings"][user_id])

    await interaction.response.send_message(
        embed=austro_embed(
            "⚠️ Verwarnung",
            f"{user.mention} wurde verwarnt.\n\n"
            f"**Grund:** {grund}\n"
            f"**Verwarnungen:** {count}"
        )
    )


# ============================================================
# CLEAR
# ============================================================

@bot.tree.command(
    name="clear",
    description="Löscht Nachrichten."
)
@app_commands.checks.has_permissions(manage_messages=True)
@app_commands.describe(
    anzahl="Anzahl der zu löschenden Nachrichten."
)
async def clear(
    interaction: discord.Interaction,
    anzahl: app_commands.Range[int, 1, 100]
):

    await interaction.response.defer(ephemeral=True)

    deleted = await interaction.channel.purge(limit=anzahl)

    await interaction.followup.send(
        f"🧹 {len(deleted)} Nachrichten gelöscht.",
        ephemeral=True
    )


