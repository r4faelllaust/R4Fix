# USERINFO
# ============================================================

@bot.tree.command(
    name="userinfo",
    description="Zeigt Informationen über einen Benutzer."
)
async def userinfo(
    interaction: discord.Interaction,
    user: discord.Member
):

    roles = [
        role.mention
        for role in user.roles
        if role != interaction.guild.default_role
    ]

    if roles:
        role_text = ", ".join(roles)
    else:
        role_text = "Keine"

    text = f"""
👤 **Benutzer:** {user.mention}

🆔 **ID:** `{user.id}`

📅 **Account erstellt:**
{discord.utils.format_dt(user.created_at, style="F")}

📥 **Server beigetreten:**
{discord.utils.format_dt(user.joined_at, style="F")}

🎭 **Rollen:**
{role_text}
"""

    await interaction.response.send_message(
        embed=austro_embed("👤 Benutzerinformationen", text)
    )


