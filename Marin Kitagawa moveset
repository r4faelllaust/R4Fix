-- ================================================================
-- COOLDOWN
-- ================================================================

local function allowed(
	key: string,
	cooldown: number
)

	local now =
		os.clock()

	local last =
		SESSION.LastVFX[key]
		or 0

	if now - last < cooldown then
		return false
	end

	SESSION.LastVFX[key] =
		now

	return true
end

-- ================================================================
-- COMBO
-- ================================================================

local function registerCombo()

	local now =
		os.clock()

	if now - SESSION.LastComboTime
		<= CONFIG.ComboWindow then

		SESSION.Combo =
			math.min(
				SESSION.Combo + 1,
				CONFIG.MaxCombo
			)

	else

		SESSION.Combo =
			1

	end

	SESSION.LastComboTime =
		now

	return SESSION.Combo
end

