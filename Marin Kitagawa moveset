-- ================================================================
-- MOVE HANDLER
-- ================================================================

local function setupMoveHandler(
	character,
	humanoid,
	root,
	token
)
	track(
		humanoid.AnimationPlayed:Connect(
			function(animationTrack)

				if token
					~= SESSION.CharacterToken then
					return
				end

				if not animationTrack
					or not animationTrack.Animation then
					return
				end

				local id =
					animationTrack.Animation.AnimationId

				-- M1
				local replacement =
					M1_TRIGGERS[id]

				if replacement then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimation(
						humanoid,
						replacement,
						Enum.AnimationPriority.Action
					)

					heartParticles(
						root,
						5,
						"m1_" .. id,
						4
					)

					return
				end

				-- MOVE 1
				if id == SLOT1_ID then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimationCapped(
						humanoid,
						MOVE1_ANIMATION,
						Enum.AnimationPriority.Action,
						CONFIG.Move1AnimationLength
					)

					heartBurst(
						root.CFrame,
						10,
						"move1",
						0.3
					)

					loveRing(
						root.CFrame,
						2,
						22,
						"move1ring"
					)

					heartParticles(
						root,
						35,
						"move1particles",
						7
					)

					return
				end

				-- MOVE 2
				if id == SLOT2_ID then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimationCapped(
						humanoid,
						MOVE2_ANIMATION,
						Enum.AnimationPriority.Action,
						CONFIG.Move2AnimationLength,
						0.03,
						1
					)

					heartBurst(
						root.CFrame,
						10,
						"move2",
						0.25
					)

					loveRing(
						root.CFrame,
						2,
						26,
						"move2ring"
					)

					heartParticles(
						root,
						40,
						"move2particles",
						8
					)

					return
				end

				-- MOVE 3
				if id == SLOT3_ID then
					pcall(function()
						animationTrack:Stop()
					end)

					local state =
						humanoid:GetState()

					local airborne =
						state
						== Enum.HumanoidStateType.Jumping
						or state
						== Enum.HumanoidStateType.Freefall

					playAnimationCapped(
						humanoid,
						airborne
							and MOVE3_AIR
							or MOVE3_GROUND,
						Enum.AnimationPriority.Action,
						CONFIG.Move3AnimationLength
					)

					heartBurst(
						root.CFrame,
						12,
						"move3",
						0.35
					)

					loveRing(
						root.CFrame,
						3,
						32,
						"move3ring"
					)

					heartParticles(
						root,
						50,
						"move3particles",
						8
					)

					return
				end

				-- MOVE 4
				if id == SLOT4_ID then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimationCapped(
						humanoid,
						MOVE4_ANIMATION,
						Enum.AnimationPriority.Action,
						CONFIG.Move4AnimationLength
					)

					heartBurst(
						root.CFrame,
						15,
						"move4",
						0.4
					)

					loveRing(
						root.CFrame,
						4,
						40,
						"move4ring"
					)

					heartParticles(
						root,
						65,
						"move4particles",
						10
					)

					cuteBurstSeries(
						root.CFrame,
						"move4"
					)

					return
				end

				-- SPECIAL
				if id == SPECIAL_ID then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimationCapped(
						humanoid,
						SPECIAL_ANIMATION,
						Enum.AnimationPriority.Action,
						CONFIG.SpecialAnimationLength
					)

					heartParticles(
						root,
						35,
						"specialParticles",
						7
					)

					heartBurst(
						root.CFrame,
						9,
						"specialBurst",
						0.3
					)

					return
				end

				-- ULT 1
				if id == ULT1_TRIGGER then
					pcall(function()
						animationTrack:Stop()
					end)

					SESSION.IsUlted =
						true

					playAnimationCapped(
						humanoid,
						ULT1_ANIMATION,
						Enum.AnimationPriority.Action4,
						CONFIG.UltAnimationLength
					)

					ultimateEffect(
						root,
						24,
						52,
						"ult1"
					)

					return
				end

				-- ULT 2
				if id == ULT2_TRIGGER then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimationCapped(
						humanoid,
						ULT2_ANIMATION,
						Enum.AnimationPriority.Action4,
						CONFIG.UltAnimationLength
					)

					ultimateEffect(
						root,
						28,
						58,
						"ult2"
					)

					return
				end

				-- ULT 3
				if id == ULT3_TRIGGER then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimationCapped(
						humanoid,
						ULT3_ANIMATION,
						Enum.AnimationPriority.Action4,
						CONFIG.UltAnimationLength
					)

					ultimateEffect(
						root,
						32,
						65,
						"ult3"
					)

					return
				end
			end
		)
	)

	-- Game ult attribute
	track(
		character:GetAttributeChangedSignal(
			"Ulted"
		):Connect(function()
			SESSION.IsUlted =
				character:GetAttribute(
					"Ulted"
				) and true or false
		end)
	)

	-- Death Counter style detection
	track(
		Player.Backpack.ChildAdded:Connect(
			function(tool)
				if tool.Name ==
					"Death Counter" then

					SESSION.IsUlted =
						true
				end
			end
		)
	)
end

-- ================================================================
-- IDLE
-- ================================================================

local function setupIdle(
	character,
	humanoid,
	token
)
	local started =
		os.clock()

	local idleTrack

	local anim =
		Instance.new("Animation")

	anim.AnimationId =
		IDLE_EMOTE

	local ok, loaded =
		pcall(function()
			return getAnimator(
				humanoid
			):LoadAnimation(anim)
		end)

	anim:Destroy()

	if ok and loaded then
		idleTrack =
			loaded

		idleTrack.Priority =
			Enum.AnimationPriority.Idle

		idleTrack.Looped =
			true
	end

	track(
		RunService.RenderStepped:Connect(
			function()

				if token
					~= SESSION.CharacterToken then
					return
				end

				if not character.Parent
					or humanoid.Health <= 0 then
					return
				end

				local root =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if not root then
					return
				end

				local moving =
					humanoid.MoveDirection.Magnitude
					> 0.05

				local state =
					humanoid:GetState()

				local airborne =
					state
					== Enum.HumanoidStateType.Jumping
					or state
					== Enum.HumanoidStateType.Freefall

				if idleTrack then

					if
						(moving or airborne)
						and idleTrack.IsPlaying
					then

						idleTrack:Stop(
							0.2
						)

					elseif
						not moving
						and not airborne
						and not idleTrack.IsPlaying
					then

						idleTrack:Play(
							0.2
						)
					end
				end

				if
					not moving
					and not airborne
					and os.clock() - started
						> 0.55
				then

					heartParticles(
						root,
						1,
						"marinIdleHeart",
						1
					)
				end
			end
		)
	)
end

