local function setupIdle(
	character: Model,
	humanoid: Humanoid,
	token: number
)

	local animation =
		Instance.new("Animation")

	animation.AnimationId =
		IDLE_ANIMATION

	local animator =
		getAnimator(humanoid)

	local ok, idleTrack =
		pcall(function()
			return animator:LoadAnimation(
				animation
			)
		end)

	animation:Destroy()

	if not ok or not idleTrack then
		return
	end

	idleTrack.Priority =
		Enum.AnimationPriority.Idle

	idleTrack.Looped =
		true

	local lastHeart =
		os.clock()

	trackCharacter(

		RunService.RenderStepped:Connect(
			function()

				if token
					~= SESSION.CharacterToken then
					return
				end

				if not character.Parent
					or humanoid.Health <= 0 then

					pcall(function()
						idleTrack:Stop(
							0.1
						)
					end)

					return
				end

				local moving =
					humanoid.MoveDirection.Magnitude
					> 0.05

				local state =
					humanoid:GetState()

				local airborne =
					state
					== Enum.HumanoidStateType.Jumping
					or state
					== Enum.HumanoidStateType.Freefall

				if moving or airborne then

					if idleTrack.IsPlaying then

						pcall(function()
							idleTrack:Stop(
								0.18
							)
						end)

					end

				else

					if not idleTrack.IsPlaying then

						pcall(function()
							idleTrack:Play(
								0.18,
								1,
								1
							)
						end)

					end

					if os.clock() - lastHeart
						> 1.4 then

						local root =
							character:FindFirstChild(
								"HumanoidRootPart"
							)

						if root
							and root:IsA("BasePart") then

							heartParticles(
								root,
								1,
								"IdleHeart_" ..
									tostring(
										math.floor(
											os.clock()
										)
									),
								1.2
							)

						end

						lastHeart =
							os.clock()
					end
				end

			end
		)

	)

end

