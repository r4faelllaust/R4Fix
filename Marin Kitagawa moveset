-- ================================================================
-- IDLE
-- ================================================================

local function setupIdle(
	character,
	humanoid,
	token
)
	local idleTrack

	local anim =
		Instance.new("Animation")

	anim.AnimationId =
		IDLE_EMOTE

	local ok, loaded =
		pcall(function()

			return getAnimator(
				humanoid
			):LoadAnimation(anim)

		end)

	anim:Destroy()

	if ok
		and loaded then

		idleTrack =
			loaded

		idleTrack.Priority =
			Enum.AnimationPriority.Idle

		idleTrack.Looped =
			true
	end

	local lastIdleHeart =
		0

	track(
		RunService.RenderStepped:Connect(
			function()

				if token
					~= SESSION.CharacterToken then
					return
				end

				if not character.Parent
					or humanoid.Health <= 0 then
					return
				end

				local root =
					getRoot(character)

				if not root then
					return
				end

				local moving =
					humanoid.MoveDirection.Magnitude
					> 0.05

				local state =
					humanoid:GetState()

				local airborne =
					state ==
						Enum.HumanoidStateType.Jumping
					or state ==
						Enum.HumanoidStateType.Freefall

				if idleTrack then

					if
						(moving or airborne)
						and idleTrack.IsPlaying
					then

						idleTrack:Stop(
							0.18
						)

					elseif
						not moving
						and not airborne
						and not idleTrack.IsPlaying
					then

						idleTrack:Play(
							0.18
						)
					end
				end

				if
					not moving
					and not airborne
					and os.clock()
						- lastIdleHeart
						> 1.1
				then

					lastIdleHeart =
						os.clock()

					heartParticles(
						root,
						1,
						"marinIdleHeart",
						1.2
					)
				end
			end
		)
	)
end

