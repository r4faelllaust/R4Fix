local function setupCharacter(character)
	SESSION.CharacterToken += 1

	local token =
		SESSION.CharacterToken

	SESSION.IsUlted =
		false

	SESSION.ComboCount =
		0

	disconnect(
		SESSION.CharacterConnections
	)

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not root then
		return
	end

	spawnEffect(
		character,
		root
	)

	createMarinAura(
		root
	)

	createMarinTrail(
		character
	)

	setupHandGlow(
		character
	)

	for _, obj in ipairs(
		character:GetDescendants()
	) do
		neutralizeGarouTrail(obj)
	end

	track(
		character.DescendantAdded:Connect(
			function(obj)
				task.defer(function()
					neutralizeGarouTrail(
						obj
					)
				end)
			end
		)
	)

	setupIdle(
		character,
		humanoid,
		token
	)

	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)

	setupHitSounds()

	humanoid.Died:Connect(
		function()

			SESSION.IsUlted =
				false

			-- Music intentionally does NOT stop.
			-- It lives in PlayerGui and survives respawns.

		end
	)

	task.spawn(function()

		for _ = 1, 30 do

			if token
				~= SESSION.CharacterToken then
				return
			end

			fixCharacterTab()
			refreshHotbar()
			styleUltimateBar()

			task.wait(
				0.15
			)
		end
	end)
end

