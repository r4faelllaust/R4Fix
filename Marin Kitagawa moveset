local function setupCharacter(character)

	SESSION.CharacterToken += 1

	local token =
		SESSION.CharacterToken

	SESSION.IsUlted =
		false

	SESSION.ComboCount =
		0

	SESSION.LastHitTime =
		0

	disconnect(
		SESSION.CharacterConnections
	)

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not root then
		return
	end

	spawnEffect(
		character,
		root
	)

	createMarinAura(
		root
	)

	createMarinTrail(
		character
	)

	setupHandGlow(
		character
	)

	setupIdle(
		character,
		humanoid,
		token
	)

	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)

	setupHitSounds()

	setupCosplayTool()

	track(
		character.DescendantAdded:Connect(
			function(obj)

				task.defer(function()

					if obj:IsA("Trail")
						or obj:IsA("Beam")
						or obj:IsA("ParticleEmitter") then

						pcall(function()

							if not string.find(
								obj.Name,
								"Marin"
							) then

								if obj:IsA("Trail")
									or obj:IsA("Beam") then

									obj.Color =
										ColorSequence.new(
											PINK,
											HOT_PINK
										)

									elseif obj:IsA("ParticleEmitter") then

										obj.Color =
											ColorSequence.new(
												WHITE,
												PINK,
												HOT_PINK
											)

									end
								end
							end
						end)
					end
				end)
			end
		)
	)

	track(
		humanoid.Died:Connect(
			function()

				SESSION.IsUlted =
					false

				SESSION.ComboCount =
					0

				-- BGM remains alive in PlayerGui.

			end
		)
	)

	task.spawn(
		function()

			for _ = 1, 40 do

				if token
					~= SESSION.CharacterToken then
					return
				end

				fixCharacterTab()
				refreshHotbar()
				styleUltimateBar()

				task.wait(
					0.12
				)
			end
		end
	)
end

