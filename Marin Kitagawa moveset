-- ================================================================
-- GAROU BLUE TRAIL -> MARIN PINK
-- ================================================================

local function neutralizeGarouTrail(obj)
	local isOurs =
		string.match(
			obj.Name,
			"^Marin"
		)

	if isOurs then
		return
	end

	local isXd =
		obj.Name == "xd"

	local isEffectType =
		obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("ParticleEmitter")

	if not (
		isXd
		or isEffectType
	) then
		return
	end

	pcall(function()
		local gradient =
			ColorSequence.new(
				PINK,
				HOT_PINK
			)

		if obj:IsA("Trail")
			or obj:IsA("Beam") then

			obj.Color =
				gradient

			if obj:IsA("Trail") then
				obj.LightEmission =
					0.6
			end

		elseif obj:IsA("ParticleEmitter") then

			obj.Color =
				gradient

			obj.LightEmission =
				0.6
		end
	end)
end

