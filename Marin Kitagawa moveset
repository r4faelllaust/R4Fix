-- ================================================================
-- CONNECTION MANAGEMENT
-- ================================================================

local function disconnect(list)
	for _, connection in ipairs(list) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(list)
end

local function track(connection)
	if connection then
		table.insert(
			SESSION.CharacterConnections,
			connection
		)
	end

	return connection
end

-- ================================================================
-- SAFE CHARACTER ACCESS
-- ================================================================

local function getCharacter()
	local character = Player.Character

	if character
		and character.Parent then
		return character
	end

	return nil
end

local function getHumanoid(character)
	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(character)
	if not character then
		return nil
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if root
		and root:IsA("BasePart") then
		return root
	end

	return nil
end

-- ================================================================
-- ANIMATION
-- ================================================================

local function getAnimator(humanoid)
	local animator =
		humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator =
			Instance.new("Animator")

		animator.Parent =
			humanoid
	end

	return animator
end

local function playAnimation(
	humanoid,
	id,
	priority,
	fade,
	speed
)
	if not humanoid
		or humanoid.Health <= 0 then
		return nil
	end

	local animation =
		Instance.new("Animation")

	animation.AnimationId =
		id

	local success, result =
		pcall(function()
			return getAnimator(humanoid)
				:LoadAnimation(animation)
		end)

	animation:Destroy()

	if not success
		or not result then
		return nil
	end

	result.Priority =
		priority
		or Enum.AnimationPriority.Action

	result.Looped = false

	pcall(function()
		result:Play(
			fade or 0.04,
			1,
			speed or 1
		)
	end)

	return result
end

local function playAnimationCapped(
	humanoid,
	id,
	priority,
	duration,
	fade,
	speed
)
	local trackResult =
		playAnimation(
			humanoid,
			id,
			priority,
			fade,
			speed
		)

	if trackResult
		and duration then

		task.delay(
			duration,
			function()
				pcall(function()
					if trackResult.IsPlaying then
						trackResult:Stop(0.07)
					end
				end)
			end
		)
	end

	return trackResult
end

