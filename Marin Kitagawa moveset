			(i - 1) * 0.065,
			function()

				if not root.Parent then
					return
				end

				heartBurst(
					root.CFrame
						* CFrame.new(
							math.sin(i) * 2,
							i * 0.35,
							math.cos(i) * 2
						),
					scale + i * 2,
					key .. "_h" .. i,
					0.28
				)

				loveRing(
					root.CFrame,
					1,
					scale * 2 + i * 6,
					key .. "_r" .. i
				)

			end
		)
	end
end

