	local ok, asset =
		pcall(function()
			return ENV.getcustomasset(filename)
		end)

	if ok and asset then
		return asset
	end

	return nil
end

-- ================================================================
-- DOWNLOAD ASSET
-- ================================================================

local function obtainAsset(
	url: string,
	filename: string
)

	if SESSION.AssetCache[filename] then
		return SESSION.AssetCache[filename]
	end

	local existing =
		customAsset(filename)

	if existing then
		SESSION.AssetCache[filename] =
			existing

		return existing
	end

	local data =
		download(url)

	if not data then
		warn(
			"[R4FIX MARIN] Download failed:",
			url
		)

		return nil
	end

	if not saveFile(filename, data) then
		warn(
			"[R4FIX MARIN] Cannot write:",
			filename
		)

		return nil
	end

	local asset =
		customAsset(filename)

	if asset then

		SESSION.AssetCache[filename] =
			asset

		return asset
	end

	return nil
end

