local function createCosplayTool()

	if SESSION.CosplayTool
		and SESSION.CosplayTool.Parent then

		return SESSION.CosplayTool
	end

	local backpack =
		Player:WaitForChild(
			"Backpack"
		)

	local tool =
		Instance.new("Tool")

	tool.Name =
		"💗 Cosplay Switch"

	tool.ToolTip =
		"Tap to disguise as the nearest player. Tap again to return to Marin."

	tool.RequiresHandle =
		false

	tool.CanBeDropped =
		false

	tool.Parent =
		backpack

	SESSION.CosplayTool =
		tool

	tool.Activated:Connect(

		function()

			if SESSION.Disguised then

				local restored =
					restoreMarinAvatar()

				if restored then

					pcall(function()

						StarterGui:SetCore(
							"SendNotification",
							{
								Title =
									"MARIN 💗",

								Text =
									"Cosplay removed. Welcome back, Marin ✨",

								Icon =
									getDecalAsset(),

								Duration =
									2.5,
							}
						)

					end)

				end

				return
			end

			local target =
				findTargetPlayer()

			if not target then

				pcall(function()

					StarterGui:SetCore(
						"SendNotification",
						{
							Title =
								"COSPLAY SWITCH 💗",

							Text =
								"No nearby player found.",

							Duration =
								2.5,
						}
					)

				end)

				return
			end

			local success =
				disguiseAsPlayer(
					target
				)

			if success then

				pcall(function()

					StarterGui:SetCore(
						"SendNotification",
						{
							Title =
								"COSPLAY SWITCH ✨",

							Text =
								"Now cosplaying as "
								.. target.DisplayName
								.. " 💗",

							Icon =
								getDecalAsset(),

							Duration =
								3,
						}
					)

				end)

			else

				pcall(function()

					StarterGui:SetCore(
						"SendNotification",
						{
							Title =
								"COSPLAY SWITCH",

							Text =
								"Could not copy that player's avatar.",

							Duration =
								2.5,
						}
					)

				end)

			end

		end

	)

	return tool
end

