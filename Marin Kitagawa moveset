		1,
		20,
		"PhantomEngine_StartRing"
	)

	-- Short phantom afterimages

	for i = 1, 5 do

		task.delay(
			i * 0.055,
			function()

				if not root.Parent then
					return
				end

				local ghost =
					Instance.new("Part")

				ghost.Name =
					"MarinPhantomAfterimage"

				ghost.Anchored = true
				ghost.CanCollide = false
				ghost.CanTouch = false
				ghost.CanQuery = false
				ghost.CastShadow = false

				ghost.Material =
					Enum.Material.Neon

				ghost.Color =
					i % 2 == 0
					and PINK
					or LIGHT_PINK

				ghost.Transparency =
					0.78

				ghost.Size =
					Vector3.new(
						3,
						5,
						2
					)

				ghost.CFrame =
					root.CFrame
					* CFrame.new(
						math.sin(i * 2) * 1.5,
						0,
						i * 0.8
					)

				ghost.Parent =
					getVFXFolder()

				TweenService:Create(

					ghost,

					TweenInfo.new(
						0.32,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.Out
					),

					{
						Transparency = 1,
						Size =
							Vector3.new(
								5,
								7,
								4
							),
					}

				):Play()

				Debris:AddItem(
					ghost,
					0.4
				)

			end
		)
	end

	heartParticles(
		root,
		55,
		"PhantomEngine_Particles",
		9
	)

	loveRing(
		root.CFrame,
		3,
		40,
		"PhantomEngine_Ring"
	)

