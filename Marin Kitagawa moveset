local function findSlot(
	number: number
)

	local hotbar =
		PlayerGui:FindFirstChild(
			"Hotbar"
		)

	if not hotbar then
		return nil
	end

	local backpack =
		hotbar:FindFirstChild(
			"Backpack"
		)

	if not backpack then
		return nil
	end

	local frame =
		backpack:FindFirstChild(
			"Hotbar"
		)

	if not frame then
		return nil
	end

	local slot =
		frame:FindFirstChild(
			tostring(number)
		)

	if not slot then
		return nil
	end

	return slot:FindFirstChild(
		"Base"
	) or slot
end

local function setMoveName(
	number: number,
	name: string,
	label: string
)

	local slot =
		findSlot(number)

	if not slot then
		return
	end

	local toolName =
		slot:FindFirstChild(
			"ToolName"
		)

	if toolName
		and toolName:IsA("TextLabel") then

		toolName.Text =
			name

	end

	local reuse =
		slot:FindFirstChild(
			"Reuse"
		)

	if reuse then

		reuse.Visible =
			true

		if reuse:IsA("TextLabel")
			or reuse:IsA("TextButton") then

			reuse.Text =
				label

		end

		local nested =
			reuse:FindFirstChild(
				"Reuse"
			)

		if nested
			and (
				nested:IsA("TextLabel")
				or nested:IsA("TextButton")
			) then

			nested.Text =
				label

		end
	end
end

