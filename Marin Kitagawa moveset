-- ================================================================
-- COSPLAY SWITCH
-- ================================================================
--
-- The tool chooses the nearest other player.
--
-- First activation:
--     Save Marin's current appearance.
--     Attempt to apply the nearest player's appearance.
--
-- Second activation:
--     Restore the original appearance.
--
-- This is deliberately client-side because this script is a
-- client/executor-style moveset. A server-authoritative version
-- would require server code and RemoteEvents.
-- ================================================================

local function getNearestPlayer()
	local character =
		getCharacter()

	local root =
		getRoot(character)

	if not root then
		return nil
	end

	local nearest = nil
	local nearestDistance =
		math.huge

	for _, other in ipairs(
		Players:GetPlayers()
	) do

		if other ~= Player then

			local otherCharacter =
				other.Character

			local otherRoot =
				getRoot(otherCharacter)

			local otherHumanoid =
				getHumanoid(otherCharacter)

			if otherRoot
				and otherHumanoid
				and otherHumanoid.Health > 0 then

				local distance =
					(
						otherRoot.Position
						- root.Position
					).Magnitude

				if distance
					< nearestDistance then

					nearestDistance =
						distance

					nearest =
						other
				end
			end
		end
	end

	return nearest
end

local function getDescriptionFromPlayer(target)
	if not target then
		return nil
	end

	local ok, description =
		pcall(function()

			return Players:GetHumanoidDescriptionFromUserId(
				target.UserId
			)

		end)

	if ok then
		return description
	end

	return nil
end

local function saveOriginalAppearance(humanoid)
	if SESSION.OriginalDescription then
		return
	end

	local ok, description =
		pcall(function()

			return humanoid:GetAppliedDescription()

		end)

	if ok
		and description then

		SESSION.OriginalDescription =
			description
	end
end

local function applyCosplay(target)
	local character =
		getCharacter()

	local humanoid =
		getHumanoid(character)

	if not humanoid
		or humanoid.Health <= 0 then
		return false
	end

	local description =
		getDescriptionFromPlayer(
			target
		)

	if not description then
		return false
	end

	saveOriginalAppearance(
		humanoid
	)

	local ok =
		pcall(function()
			humanoid:ApplyDescription(
				description
			)
		end)

	if not ok then
		return false
	end

	SESSION.CosplayActive =
		true

	SESSION.CosplayTarget =
		target

	return true
end

local function restoreCosplay()
	local character =
		getCharacter()

	local humanoid =
		getHumanoid(character)

	if not humanoid
		or not SESSION.OriginalDescription then
		return false
	end

	local description =
		SESSION.OriginalDescription

	local ok =
		pcall(function()
			humanoid:ApplyDescription(
				description
			)
		end)

	if not ok then
		return false
	end

	SESSION.CosplayActive =
		false

	SESSION.CosplayTarget =
		nil

	return true
end

local function cosplayNotification(text)
	pcall(function()

		StarterGui:SetCore(
			"SendNotification",
			{
				Title = "MARIN'S COSPLAY 💗",

				Text = text,

				Icon = DECAL_ID,

				Duration = 3,
			}
		)

	end)
end

local function setupCosplayTool()
	if SESSION.CosplayTool
		and SESSION.CosplayTool.Parent then
		return
	end

	local tool =
		Instance.new("Tool")

	tool.Name =
		"Cosplay Switch 💗"

	tool.ToolTip =
		"Copy the nearest player's avatar, use again to return to Marin."

	tool.RequiresHandle =
		false

	tool.CanBeDropped =
		false

	tool.Parent =
		Player.Backpack

	SESSION.CosplayTool =
		tool

	local debounce =
		false

	tool.Activated:Connect(
		function()

			if debounce then
				return
			end

			debounce = true

			if SESSION.CosplayActive then

				local restored =
					restoreCosplay()

				if restored then

					cosplayNotification(
						"Back to your original avatar! 💗"
					)

					local character =
						getCharacter()

					local root =
						getRoot(character)

					if root then

						heartBurst(
							root.CFrame,
							12,
							"cosplay_restore",
							0.35
						)

						heartParticles(
							root,
							30,
							"cosplay_restore_particles",
							6
						)
					end

				else

					cosplayNotification(
						"Could not restore the original avatar."
					)
				end

			else

				local target =
					getNearestPlayer()

				if not target then

					cosplayNotification(
						"No nearby player found! 💔"
					)

				else

					local applied =
						applyCosplay(
							target
						)

					if applied then

						cosplayNotification(
							"Cosplaying as "
								.. target.DisplayName
								.. " 💗"
						)

						local character =
							getCharacter()

						local root =
							getRoot(character)

						if root then

							cuteBurstSeries(
								root.CFrame,
								"cosplay_switch"
							)

							heartParticles(
								root,
								45,
								"cosplay_switch_particles",
								7
							)
						end

					else

						cosplayNotification(
							"That player's avatar could not be copied."
						)
					end
				end
			end

			task.wait(0.35)

			debounce = false
		end
	)
end

-- ================================================================
-- MOVE HANDLER
-- ================================================================

local function setupMoveHandler(
	character,
	humanoid,
	root,
	token
)
	track(
		humanoid.AnimationPlayed:Connect(
			function(animationTrack)

				if token
					~= SESSION.CharacterToken then
					return
				end

				if not animationTrack
					or not animationTrack.Animation then
					return
				end

				local id =
					animationTrack.Animation.AnimationId

				-- ====================================================
				-- M1
				-- ====================================================

				local replacement =
					M1_TRIGGERS[id]

				if replacement then

					pcall(function()
						animationTrack:Stop()
					end)

					playAnimation(
						humanoid,
						replacement,
						Enum.AnimationPriority.Action
					)

					heartParticles(
						root,
						6,
						"m1_" .. id,
						4
					)

					return
				end

				-- ====================================================
				-- MOVE 1
				-- COSPLAY CRUSH
				-- ====================================================

				if id == SLOT1_ID then

					pcall(function()
						animationTrack:Stop()
					end)

					playAnimationCapped(
						humanoid,
						MOVE1_ANIMATION,
						Enum.AnimationPriority.Action,
						CONFIG.Move1AnimationLength,
						0.03,
						1.05
					)

					heartBurst(
						root.CFrame,
						12,
						"move1",
						0.3
					)

					doubleLoveRing(
						root.CFrame,
						24,
						"move1ring"
					)

					heartParticles(
						root,
						38,
						"move1particles",
						7
					)

					return
				end

				-- ====================================================
				-- MOVE 2
				-- PHANTOM ENGINE
