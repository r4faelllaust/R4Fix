-- ================================================================
-- PHANTOM AFTERIMAGE
-- ================================================================

local function createPhantomAfterimage(character, cframe, index)
	if not character then
		return
	end

	local clone =
		character:Clone()

	if not clone then
		return
	end

	clone.Name =
		"MarinPhantom_" .. tostring(index)

	for _, obj in ipairs(
		clone:GetDescendants()
	) do
		if obj:IsA("Script")
			or obj:IsA("LocalScript")
			or obj:IsA("ModuleScript") then

			obj:Destroy()

		elseif obj:IsA("Humanoid") then

			obj.DisplayDistanceType =
				Enum.HumanoidDisplayDistanceType.None

		elseif obj:IsA("BasePart") then

			obj.Anchored = true
			obj.CanCollide = false
			obj.CanTouch = false
			obj.CanQuery = false
			obj.CastShadow = false

			obj.Material =
				Enum.Material.Neon

			obj.Color =
				PINK

			obj.Transparency =
				math.max(
					obj.Transparency,
					0.42
				)

		elseif obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam") then

			obj.Enabled = false
		end
	end

	clone:PivotTo(cframe)
	clone.Parent = getVFXFolder()

	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"PhantomGlow"

	highlight.Adornee =
		clone

	highlight.FillColor =
		PINK

	highlight.OutlineColor =
		WHITE

	highlight.FillTransparency =
		0.55

	highlight.OutlineTransparency =
		0.05

	highlight.Parent =
		clone

	for _, obj in ipairs(
		clone:GetDescendants()
	) do
		if obj:IsA("BasePart") then

			TweenService:Create(
				obj,

				TweenInfo.new(
					0.30,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.Out
				),

				{
					Transparency = 1,
				}
			):Play()
		end
	end

	TweenService:Create(
		highlight,

		TweenInfo.new(
			0.30,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			FillTransparency = 1,
			OutlineTransparency = 1,
		}
	):Play()

	Debris:AddItem(
		clone,
		0.36
	)
end

