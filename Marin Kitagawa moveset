-- ================================================================
-- MOVE HANDLER
-- ================================================================

local function setupMoveHandler(
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	token: number
)

	trackCharacter(

		humanoid.AnimationPlayed:Connect(
			function(
				animationTrack
			)

				if token
					~= SESSION.CharacterToken then
					return
				end

				if not animationTrack
					or not animationTrack.Animation then
					return
				end

				local id =
					animationTrack.Animation.AnimationId

				-- =================================================
				-- M1
				-- =================================================

				local replacement =
					M1_TRIGGERS[id]

				if replacement then

					pcall(function()
						animationTrack:Stop(
							0.02
						)
					end)

					playAnimation(
						humanoid,
						replacement,
						Enum.AnimationPriority.Action,
						0.025,
						1.05
					)

					heartParticles(
						root,
						6,
						"M1_" .. id,
						4
					)

					return
				end

				-- =================================================
				-- MOVE 1
				-- =================================================

				if id == SLOT1_ID then

					pcall(function()
						animationTrack:Stop(
							0.025
						)
					end)

					playCapped(
						humanoid,
						MOVE1_ANIMATION,
						Enum.AnimationPriority.Action,
						0.72,
						0.025,
						1.08
					)

					move1Effect(
						root
					)

					return
				end

				-- =================================================
				-- MOVE 2
				-- PHANTOM ENGINE
				-- =================================================

				if id == SLOT2_ID then

					pcall(function()
						animationTrack:Stop(
							0.02
						)
					end)

					playCapped(
						humanoid,
						MOVE2_ANIMATION,
						Enum.AnimationPriority.Action,
						0.82,
						0.02,
						1.12
					)

					phantomEngine(
						character,
						humanoid,
						root
					)

					return
				end

				-- =================================================
				-- MOVE 3
				-- LOVE ENGINE
				-- =================================================

				if id == SLOT3_ID then

					pcall(function()
						animationTrack:Stop(
							0.02
						)
					end)

					local state =
						humanoid:GetState()

					local airborne =
						state
						== Enum.HumanoidStateType.Jumping
						or state
						== Enum.HumanoidStateType.Freefall

					playCapped(
						humanoid,
						airborne
							and MOVE3_AIR
							or MOVE3_GROUND,
						Enum.AnimationPriority.Action,
						0.92,
						0.02,
						1.04
					)

					loveEngine(
						root
					)

					return
				end

				-- =================================================
				-- MOVE 4
				-- =================================================

				if id == SLOT4_ID then

					pcall(function()
						animationTrack:Stop(
							0.02
						)
					end)

					playCapped(
						humanoid,
						MOVE4_ANIMATION,
						Enum.AnimationPriority.Action,
						1,
						0.03,
						1
					)

					heartBurst(
