local function setupCharacter(
	character: Model
)

	SESSION.CharacterToken += 1

	local token =
		SESSION.CharacterToken

	SESSION.IsUlted =
		false

	SESSION.Combo =
		0

	SESSION.LastComboTime =
		0

	disconnectList(
		SESSION.CharacterConnections
	)

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not root
		or not root:IsA("BasePart") then

		warn(
			"[R4FIX MARIN] Character failed to initialize."
		)

		return
	end

	-- =============================================================
	-- CHARACTER VFX
	-- =============================================================

	spawnEffect(
		character,
		root
	)

	createAura(
		root
	)

	createArmTrails(
		character
	)

	setupHandGlow(
		character
	)

	for _, obj in ipairs(
		character:GetDescendants()
	) do

		recolorEffect(
			obj
		)

	end

	trackCharacter(

		character.DescendantAdded:Connect(
			function(obj)

				task.defer(function()

					if obj.Parent then

						recolorEffect(
							obj
						)

					end

				end)

			end
		)

	)

	-- =============================================================
	-- SYSTEMS
	-- =============================================================

	setupIdle(
		character,
		humanoid,
		token
	)

	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)

	setupHitDetection()

	-- =============================================================
	-- DEATH
	-- =============================================================

	trackCharacter(

		humanoid.Died:Connect(
			function()

				SESSION.IsUlted =
					false

				SESSION.Combo =
					0

			end
		)

	)

	-- =============================================================
	-- UI
	-- =============================================================

	task.spawn(function()

		for i = 1, 35 do

			if token
				~= SESSION.CharacterToken then

				return
			end

			pcall(function()

				fixCharacterTab()
				refreshHotbar()
				styleUltimateBar()

			end)

			task.wait(
				0.12
			)

		end

	end)

end

