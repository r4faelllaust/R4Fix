local function getMusic()
	local existing =
		PlayerGui:FindFirstChild(
			"MarinKawaiiBGM"
		)

	if existing
		and existing:IsA("Sound") then

		return existing
	end

	local sound =
		Instance.new("Sound")

	sound.Name =
		"MarinKawaiiBGM"

	sound.Volume =
		MUSIC_VOLUME

	sound.Looped =
		true

	sound.Parent =
		PlayerGui

	return sound
end

local function fetchMusic()
	local requestFn =
		(syn and syn.request)
		or (getgenv and getgenv().request)
		or (getgenv and getgenv().http_request)

	if requestFn then
		local ok, response =
			pcall(function()
				return requestFn({
					Url = MUSIC_URL,
					Method = "GET",
				})
			end)

		if ok
			and response
			and response.Body then

			print(
				"[Marin Music] request succeeded:",
				#response.Body
			)

			return response.Body
		end
	end

	local ok, data =
		pcall(function()
			return game:HttpGet(
				MUSIC_URL
			)
		end)

	if ok then
		print(
			"[Marin Music] HttpGet succeeded:",
			data and #data or 0
		)

		return data
	end

	warn(
		"[Marin Music] Failed to download music"
	)

	return nil
end

local function installMusic()
	local sound =
		getMusic()

	local asset

	if getcustomasset then
		local ok, result =
			pcall(
				getcustomasset,
				MUSIC_FILE
			)

		if ok then
			asset = result
		end
	end

	if not asset then
		local data =
			fetchMusic()

		if data
			and #data > 100 then

			local writeOk =
				pcall(function()
					writefile(
						MUSIC_FILE,
						data
					)
				end)

			if writeOk
				and getcustomasset then

				local assetOk, result =
					pcall(function()
						return getcustomasset(
							MUSIC_FILE
						)
					end)

				if assetOk then
					asset = result
				end
			end
		end
	end

	if not asset then
		warn(
			"[Marin Music] No custom asset available."
		)

		return
	end

	sound.SoundId =
		asset

	sound.Looped =
		true

	sound.Volume =
		MUSIC_VOLUME

	pcall(function()
		if not sound.IsPlaying then
			sound:Play()
		end
	end)

	print(
		"[Marin Music] Kawaii Kaiwai playing 💗"
	)
end

