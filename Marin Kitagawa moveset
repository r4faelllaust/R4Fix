local function heartBurst(
	cframe: CFrame,
	size: number,
	key: string?,
	duration: number?
)

	if key
		and not allowed(
			key,
			CONFIG.VFXCooldown
		) then
		return
	end

	local part =
		Instance.new("Part")

	part.Name =
		"MarinHeartBurst"

	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false

	part.Shape =
		Enum.PartType.Ball

	part.Material =
		Enum.Material.Neon

	part.Color =
		PINK

	part.Transparency =
		0.08

	part.Size =
		Vector3.one

	part.CFrame =
		cframe

	part.Parent =
		getVFXFolder()

	local light =
		Instance.new("PointLight")

	light.Color =
		PINK

	light.Brightness =
		6

	light.Range =
		15

	light.Parent =
		part

	local time =
		duration or 0.35

	TweenService:Create(

		part,

		TweenInfo.new(
			time,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),

		{
			Size =
				Vector3.new(
					size,
					size,
					size
				),

			Transparency = 1,
		}

	):Play()

	TweenService:Create(

		light,

		TweenInfo.new(
			time,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			Brightness = 0,
			Range = 0,
		}

	):Play()

	Debris:AddItem(
		part,
		time + 0.15
	)
end

