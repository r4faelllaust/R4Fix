local function getAnimator(
	humanoid: Humanoid
)

	local animator =
		humanoid:FindFirstChildOfClass(
			"Animator"
		)

	if not animator then

		animator =
			Instance.new("Animator")

		animator.Parent =
			humanoid
	end

	return animator
end

local function playAnimation(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority?,
	fade: number?,
	speed: number?
)

	if humanoid.Health <= 0 then
		return nil
	end

	local animation =
		Instance.new("Animation")

	animation.AnimationId =
		id

	local animator =
		getAnimator(humanoid)

	local ok, result =
		pcall(function()
			return animator:LoadAnimation(
				animation
			)
		end)

	animation:Destroy()

	if not ok or not result then
		return nil
	end

	result.Priority =
		priority
		or Enum.AnimationPriority.Action

	result.Looped = false

	pcall(function()

		result:Play(
			fade or 0.05,
			1,
			speed or 1
		)

	end)

	return result
end

local function playCapped(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority,
	duration: number,
	fade: number?,
	speed: number?
)

	local trackResult =
		playAnimation(
			humanoid,
			id,
			priority,
			fade,
			speed
		)

	if trackResult then

		task.delay(
			duration,
			function()

				pcall(function()

					if trackResult.IsPlaying then
						trackResult:Stop(
							0.08
						)
					end

					trackResult:Destroy()

				end)

			end
		)
	end

	return trackResult
end

