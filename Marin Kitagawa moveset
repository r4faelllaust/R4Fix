				)

			if old then
				old:Destroy()
			end

			local highlight =
				Instance.new("Highlight")

			highlight.Name =
				"MarinHandGlow"

			highlight.Adornee =
				limb

			highlight.FillColor =
				PINK

			highlight.OutlineColor =
				WHITE

			highlight.FillTransparency =
