-- ================================================================
-- COOLDOWN
-- ================================================================

local function allowed(key, cooldown)
	local now =
		os.clock()

	local last =
		SESSION.LastVFX[key]
		or 0

	if now - last < cooldown then
		return false
	end

	SESSION.LastVFX[key] =
		now

	return true
end

-- ================================================================
-- COMBO
-- ================================================================

local function registerCombo()
	local now =
		os.clock()

	if now - SESSION.LastHitTime
		<= CONFIG.ComboWindow then

		SESSION.ComboCount =
			math.min(
				SESSION.ComboCount + 1,
				20
			)
	else
		SESSION.ComboCount = 1
	end

	SESSION.LastHitTime =
		now

	return SESSION.ComboCount
end

