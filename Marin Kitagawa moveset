-- ================================================================

local function setupHitSounds()
	local live =
		workspace:FindFirstChild(
			"Live"
		)

	if not live then
		return
	end

	local function connectTarget(model)

		if not model:IsA("Model")
			or model == Player.Character then
			return
		end

		local humanoid =
			model:FindFirstChildOfClass(
				"Humanoid"
			)

		if not humanoid then
			return
		end

		local lastHealth =
			humanoid.Health

		track(
			humanoid.HealthChanged:Connect(
				function(newHealth)

					if newHealth < lastHealth
						and model:GetAttribute(
							"LastHit"
						) == Player.Name then

						local now =
							os.clock()

						local previous =
							SESSION.LastHit[
								model
							] or 0

						if now - previous
							>= CONFIG.HitSoundCooldown then

							SESSION.LastHit[
								model
							] = now

							local combo =
								registerCombo()

							playHitSound(
								model
							)

							local root =
								getRoot(model)

							if root then

								heartBurst(
									root.CFrame,
									5 + combo * 0.55,
									"hit_" ..
										model.Name,
									0.22
								)

								heartParticles(
									root,
									8 + combo,
									"hitParticles_" ..
										model.Name,
									7
								)
							end
						end
					end

					lastHealth =
						newHealth
				end
			)
		)
	end

	for _, model in ipairs(
		live:GetChildren()
	) do
		connectTarget(model)
	end

	track(
		live.ChildAdded:Connect(
			function(model)
				task.wait(0.05)
				connectTarget(model)
			end
		)
	)
end

