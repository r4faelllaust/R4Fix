-- ================================================================
-- HIT DETECTION
-- ================================================================

local function setupHitDetection()

	local live =
		workspace:FindFirstChild(
			"Live"
		)

	if not live then
		return
	end

	local function connectTarget(
		model: Instance
	)

		if not model:IsA("Model")
			or model == Player.Character then
			return
		end

		local humanoid =
			model:FindFirstChildOfClass(
				"Humanoid"
			)

		if not humanoid then
			return
		end

		local lastHealth =
			humanoid.Health

		trackCharacter(

			humanoid.HealthChanged:Connect(
				function(
					newHealth
				)

					if newHealth
						>= lastHealth then

						lastHealth =
							newHealth

						return
					end

					local attributed =
						model:GetAttribute(
							"LastHit"
						)

					local isMine =
						attributed
						== Player.Name

					if isMine then

						local now =
							os.clock()

						local previous =
							SESSION.LastHit[
								model
							]
							or 0

						if now - previous
							>= CONFIG.HitCooldown then

							SESSION.LastHit[
								model
							] = now

							local combo =
								registerCombo()

							playHitSound(
								model
							)

							local root =
								model:FindFirstChild(
									"HumanoidRootPart"
								)

							if root
								and root:IsA("BasePart") then

								heartBurst(
									root.CFrame,
									4 + combo * 0.4,
									"hit_" ..
										model.Name,
									0.22
								)

								heartParticles(
									root,
									6 + combo,
									"hitParticles_" ..
										model.Name,
									6
								)

							end
						end
					end

					lastHealth =
						newHealth

				end
			)
		)
	end

	for _, child in ipairs(
		live:GetChildren()
	) do

		connectTarget(child)

	end

	trackCharacter(

		live.ChildAdded:Connect(
			function(child)

				task.wait(0.05)

				connectTarget(
					child
				)

			end
		)

	)
end

