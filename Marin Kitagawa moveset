-- ================================================================
-- SAFE HTTP
-- ================================================================

local function download(url: string)
	if ENV.request then

		local ok, response =
			pcall(function()
				return ENV.request({
					Url = url,
					Method = "GET",
				})
			end)

		if ok and response then

			local body =
				response.Body

			if type(body) == "string"
				and #body > 0 then

				return body
			end
		end
	end

	local ok, body =
		pcall(function()
			return game:HttpGet(url)
		end)

	if ok
		and type(body) == "string"
		and #body > 0 then

		return body
	end

	return nil
end

