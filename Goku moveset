-- ================================================================
-- CAMERA SHAKE
-- ================================================================

local function cameraShake(
	strength: number,
	duration: number
)

	if not CONFIG.CameraShake then
		return
	end

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	local original =
		camera.CFrame

	local start =
		os.clock()

	local connection

	connection =
		RunService.RenderStepped:Connect(
			function()

				local elapsed =
					os.clock() - start

				if elapsed >= duration then

					connection:Disconnect()

					return

				end

				local fade =
					1
					- elapsed / duration

				local offset =
					Vector3.new(
						(math.random() - 0.5)
							* strength
							* fade,

						(math.random() - 0.5)
							* strength
							* fade,

						(math.random() - 0.5)
							* strength
							* fade
					)

				camera.CFrame =
					original
					* CFrame.new(offset)

			end
		)

end

