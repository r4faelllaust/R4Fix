-- ============================================================

local function setupCharacter(character: Model)
	S.Token += 1

	local token = S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild("Humanoid", 10)

	local root =
		character:WaitForChild("HumanoidRootPart", 10)

	if not humanoid or not root then
		return
	end

	if CFG.Night then
		Lighting.ClockTime = 0
	end

	setupHands(character)

	spawnEffect(
		character,
		root
	)

	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)

	table.insert(
		S.CharacterConnections,
		humanoid.Died:Connect(function()
			S.Busy = {}
			cleanupTracks()
		end)
	)

	task.spawn(function()

		for _ = 1, 25 do

			if token ~= S.Token then
				return
			end

			pcall(refreshBaseHotbar)
			pcall(styleUltimateBar)
			pcall(fixCharacterTab)

			task.wait(0.15)
		end

	end)

	task.delay(0.5, function()
		if token ~= S.Token then
			return
		end

		setupRunTool()
		setupTeleportTool()
	end)
end

