-- ============================================================
-- TARGETING
-- ============================================================

local function getLiveFolder()
	return workspace:FindFirstChild("Live")
end

local function getRoot(model: Model)
	local root = model:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root
	end

	return nil
end

local function getHumanoid(model: Model)
	return model:FindFirstChildOfClass("Humanoid")
end

local function validTarget(model: Model, origin: Vector3, maxDistance: number)
	if model == Player.Character then
		return false
	end

	local humanoid = getHumanoid(model)
	local root = getRoot(model)

	if not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return (root.Position - origin).Magnitude <= maxDistance
end

local function getClosestTarget(maxDistance: number)
	local character, _, root = getCharacter()

	if not character or not root then
		return nil
	end

	local live = getLiveFolder()

	if not live then
		return nil
	end

	local best = nil
	local bestScore = math.huge

	local look = root.CFrame.LookVector

	for _, object in ipairs(live:GetChildren()) do
		if object:IsA("Model") and validTarget(object, root.Position, maxDistance) then

			local targetRoot = getRoot(object)

			if targetRoot then
				local offset = targetRoot.Position - root.Position
				local distance = offset.Magnitude

				if distance > 0 then
					local direction = offset.Unit

					-- Prefer enemies in front, but still allow nearby targets behind us.
					local facing = look:Dot(direction)

					local score =
						distance
						- math.max(facing, 0) * 22

					if score < bestScore then
						bestScore = score
						best = object
					end
				end
			end
		end
	end

	return best
end

-- ============================================================
-- TARGET POSITIONING
-- ============================================================

local function teleportBehind(
	playerRoot: BasePart,
	targetRoot: BasePart,
	distance: number,
	height: number
)
	local targetCF = targetRoot.CFrame

	local position =
		targetRoot.Position
		- targetCF.LookVector * distance
		+ Vector3.new(0, height, 0)

	playerRoot.CFrame = CFrame.lookAt(
		position,
		targetRoot.Position
	)

	playerRoot.AssemblyLinearVelocity = Vector3.zero
end

local function teleportAbove(
	playerRoot: BasePart,
	targetRoot: BasePart,
	height: number
)
	local position =
		targetRoot.Position
		+ Vector3.new(0, height, 0)

	playerRoot.CFrame = CFrame.lookAt(
		position,
		targetRoot.Position
	)

	playerRoot.AssemblyLinearVelocity = Vector3.zero
end

local function faceTarget(
	playerRoot: BasePart,
	targetRoot: BasePart
)
	local position = playerRoot.Position

	playerRoot.CFrame = CFrame.lookAt(
		position,
		Vector3.new(
			targetRoot.Position.X,
			position.Y,
			targetRoot.Position.Z
		)
	)
end

-- ============================================================
-- PHANTOM STEP
-- ============================================================

local function phantomStep(
	character: Model,
	playerRoot: BasePart,
	targetRoot: BasePart,
	above: number?
)
	afterimage(character, playerRoot.CFrame)

	particles(playerRoot, 12, PURPLE2)

	local height = above or 0

	teleportBehind(
		playerRoot,
		targetRoot,
		CFG.TeleportBehind,
		height
	)

	sphere(
		playerRoot.CFrame,
		2,
		7,
		PURPLE2,
		0.18
	)

	shockwave(
		playerRoot.CFrame,
		2,
		11,
		PURPLE
	)
end

