-- ================================================================
-- FAST MOVEMENT
-- ================================================================

local function setupMovement()
	local humanoid = SESSION.Humanoid

	if not humanoid then
		return
	end

	humanoid.WalkSpeed = CONFIG.WalkSpeed

	connect(
		RunService.RenderStepped,
		function()

			if not SESSION.Running then
				return
			end

			local currentHumanoid = SESSION.Humanoid
			local root = SESSION.Root

			if not currentHumanoid
				or not root
				or currentHumanoid.Health <= 0
			then
				return
			end

			if SESSION.UltraInstinct then
				currentHumanoid.WalkSpeed = 65
			elseif currentHumanoid.MoveDirection.Magnitude > 0.1 then
				currentHumanoid.WalkSpeed = CONFIG.RunSpeed
			else
				currentHumanoid.WalkSpeed = CONFIG.WalkSpeed
			end

			if currentHumanoid.MoveDirection.Magnitude > 0.5 then
				afterimage()
			end
		end
	)
end

-- ================================================================
-- INPUT
-- ================================================================

connect(
	UserInputService.InputBegan,
	function(input, processed)

		if processed then
			return
		end

		if UserInputService:GetFocusedTextBox() then
			return
		end

		if input.KeyCode == Enum.KeyCode.One then
			godFist()

		elseif input.KeyCode == Enum.KeyCode.Two then
			skySuplex()

		elseif input.KeyCode == Enum.KeyCode.Three then
			instantTransmission()

		elseif input.KeyCode == Enum.KeyCode.Four then
			kamehameha()

		elseif input.KeyCode == Enum.KeyCode.G then
			ultraInstinct()

		elseif input.KeyCode == Enum.KeyCode.F then
			godBurst()

		elseif input.KeyCode == Enum.KeyCode.Q then
			instantTransmission()
		end
	end
)

