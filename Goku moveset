local function refreshTopbar()

	local topbar =
		PlayerGui:FindFirstChild(
			"TopbarPlus"
		)

	if not topbar then
		return
	end

	for _, obj in ipairs(
		topbar:GetDescendants()
	) do

		if obj.Name ==
			"IconButton" then

			local label =
				obj:FindFirstChild(
					"IconLabel"
				)

			local image =
				obj:FindFirstChild(
					"IconImage"
				)

			if label
				and label:IsA("TextLabel") then

				if label.Text ==
					"Hero Hunter"
					or label.Text ==
					"Garou"
					or label.Text ==
					"Dark Garou"
					or label.Text ==
					"Marin"
					or label.Text ==
					"Goku Blue" then

					label.Text =
						MOVESET_NAME

					if image
						and image:IsA("ImageLabel") then

						image.Image =
							DECAL

					end

				end

			end

		end

	end

end

-- ================================================================
-- CHARACTER SETUP
-- ================================================================

local function setupCharacter(
	character: Model
)

	SESSION.CharacterToken += 1

	local token =
		SESSION.CharacterToken

	SESSION.IsUlted =
		false

	SESSION.BlueMode =
		false

	SESSION.Combo =
		0

	disconnect(
		SESSION.CharacterConnections
	)

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not root
		or not root:IsA("BasePart") then
		return
	end

	createBlueAura(
		root
	)

	createBlueHighlight(
		character
	)

	createArmTrails(
		character
	)

	spawnEffect(
		character,
		root,
		humanoid
	)

	-- ============================================================
	-- ANIMATION INTERCEPTOR
	-- ============================================================

	trackCharacter(

		humanoid.AnimationPlayed:Connect(
			function(track)

				if token
					~= SESSION.CharacterToken then
					return
				end

				if not track
					or not track.Animation then
					return
				end

				local id =
					track.Animation.AnimationId

				if id == "" then
					return
				end

				-- IMPORTANT:
				-- Do not intercept our replacement animations.
				-- Only intercept the actual TSB trigger IDs.

				local isTrigger =
					M1_TRIGGERS[id]
					or id == SLOT1_ID
					or id == SLOT2_ID
					or id == SLOT3_ID
					or id == SLOT4_ID
					or id == SPECIAL_ID
					or id == ULT1_TRIGGER
					or id == ULT2_TRIGGER
					or id == ULT3_TRIGGER

				if not isTrigger then
					return
				end

				pcall(function()

					track:Stop(
						0.015
					)

				end)

				task.spawn(
					function()

						local ok, err =
							xpcall(
								function()

									dispatchMove(
										id,
										humanoid,
										root
									)

								end,
								debug.traceback
							)

						if not ok then

							warn(
								"[R4FIX GOKU BLUE] Move error:",
								err
							)

						end

					end
				)

			end
		)

	)

	-- ============================================================
	-- DEATH
	-- ============================================================

	trackCharacter(

		humanoid.Died:Connect(
			function()

				SESSION.IsUlted =
					false

				SESSION.BlueMode =
					false

				SESSION.Combo =
					0

			end
		)

	)

end

