-- MOVE 1
-- ABYSSAL HUNT
-- ============================================================

local function move1(token: number)
	if S.Busy.Move1 then
		return
	end

	local character, humanoid, root = getCharacter()

	if not character or not humanoid or not root then
		return
	end

	local target = getClosestTarget(CFG.TargetRange)

	if not target then
		sphere(root.CFrame, 5, 14, PURPLE, 0.2)
		return
	end

	local targetRoot = getRoot(target)

	if not targetRoot then
		return
	end

	S.Busy.Move1 = true

	playAnimation(
		humanoid,
		ANIMS.MOVE1,
		Enum.AnimationPriority.Action4,
		1.05,
		0.72
	)

	sphere(root.CFrame, 4, 10, VOID, 0.18)

	task.wait(0.16)

	if token ~= S.Token then
		S.Busy.Move1 = nil
		return
	end

	phantomStep(
		character,
		root,
		targetRoot
	)

	sound(root, 1.35, 0.8)

	task.wait(0.18)

	if token ~= S.Token or not root.Parent then
		S.Busy.Move1 = nil
		return
	end

	faceTarget(root, targetRoot)

	particles(root, 25, PURPLE2)

	task.wait(0.15)

	-- Second positional strike.
	phantomStep(
		character,
		root,
		targetRoot,
		0
	)

	task.wait(0.18)

	-- Final hit launches visually.
	faceTarget(root, targetRoot)

	sphere(
		targetRoot.CFrame,
		4,
		17,
		PURPLE2,
		0.3
	)

	shockwave(
		targetRoot.CFrame,
		3,
		27,
		PURPLE2
	)

	particles(
		targetRoot,
		45,
		WHITE
	)

	sound(
		targetRoot,
		1.8,
		0.7
	)

	S.Busy.Move1 = nil
end

