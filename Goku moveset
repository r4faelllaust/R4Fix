-- ================================================================
-- COOLDOWN
-- ================================================================

local function allowed(
	key: string,
	cooldown: number
): boolean

	local now =
		os.clock()

	local previous =
		SESSION.LastVFX[key]
		or 0

	if now - previous < cooldown then
		return false
	end

	SESSION.LastVFX[key] =
		now

	return true

end

-- ================================================================
-- ROOT
-- ================================================================

local function getCharacter():
	(Model?, Humanoid?, BasePart?)

	local character =
		Player.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid
		or not root
		or not root:IsA("BasePart") then

		return character, humanoid, nil

	end

	return character, humanoid, root

end

-- ================================================================
-- ANIMATOR
-- ================================================================

local function getAnimator(
	humanoid: Humanoid
): Animator

	local animator =
		humanoid:FindFirstChildOfClass(
			"Animator"
		)

	if not animator then

		animator =
			Instance.new("Animator")

		animator.Parent =
			humanoid

	end

	return animator

end

-- ================================================================
-- PLAY ANIMATION
-- ================================================================

local function playAnimation(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority,
	speed: number?,
	fade: number?
): AnimationTrack?

	if humanoid.Health <= 0 then
		return nil
	end

	local animation =
		Instance.new("Animation")

	animation.AnimationId =
		id

	local animator =
		getAnimator(humanoid)

	local ok, track =
		pcall(function()

			return animator:LoadAnimation(
				animation
			)

		end)

	animation:Destroy()

	if not ok or not track then
		return nil
	end

	track.Priority =
		priority

	track.Looped =
		false

	pcall(function()

		track:Play(
			fade or 0.03,
			1,
			speed or 1
		)

	end)

	return track

end

local function playCapped(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority,
	duration: number,
	speed: number?
)

	local track =
		playAnimation(
			humanoid,
			id,
			priority,
			speed,
			0.025
		)

	if track then

		task.delay(
			duration,
			function()

				pcall(function()

					if track.IsPlaying then
						track:Stop(0.05)
					end

					track:Destroy()

				end)

			end
		)

	end

	return track

end

-- ================================================================
-- TARGET SEARCH
-- ================================================================

local function getRoot(model: Model): BasePart?

	local root =
		model:FindFirstChild(
			"HumanoidRootPart"
		)

	if root
		and root:IsA("BasePart") then

		return root

	end

	return nil

end

local function getHumanoid(
	model: Model
): Humanoid?

	return model:FindFirstChildOfClass(
		"Humanoid"
	)

end

local function findClosestTarget(
	maxDistance: number
): Model?

	local _, _, myRoot =
		getCharacter()

	if not myRoot then
		return nil
	end

	local closest: Model? =
		nil

	local closestDistance =
		maxDistance

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= Player then

			local character =
				player.Character

			if character then

				local humanoid =
					getHumanoid(character)

				local root =
					getRoot(character)

				if humanoid
					and root
					and humanoid.Health > 0 then

					local distance =
						(
							myRoot.Position
							- root.Position
						).Magnitude

					if distance
						< closestDistance then

						closestDistance =
							distance

						closest =
							character

					end

				end

			end

		end

	end

	return closest

end

-- ================================================================
-- TARGETING
-- ================================================================

local function acquireTarget(): Model?

	local target =
		findClosestTarget(
			CONFIG.MaxTargetDistance
		)

	SESSION.Target =
		target

	return target

end

-- ================================================================
-- TELEPORT
-- ================================================================

local function teleportBehind(
	target: Model,
	distance: number?
): boolean

	local _, humanoid, root =
		getCharacter()

	local targetRoot =
		getRoot(target)

	if not humanoid
		or not root
		or not targetRoot
		or humanoid.Health <= 0 then

		return false

	end

	local distanceValue =
		distance
		or CONFIG.TPBehindDistance

	local destination =
		targetRoot.CFrame
		* CFrame.new(
			0,
			0,
			distanceValue
		)

	root.CFrame =
		CFrame.lookAt(
			destination.Position,
			targetRoot.Position
		)

	return true

end

local function teleportAbove(
	target: Model,
	height: number
): boolean

	local _, humanoid, root =
		getCharacter()

	local targetRoot =
		getRoot(target)

	if not humanoid
		or not root
		or not targetRoot then

		return false

	end

	local position =
		targetRoot.Position
		+ Vector3.new(
			0,
			height,
			0
		)

	root.CFrame =
		CFrame.lookAt(
			position,
			targetRoot.Position
		)

	return true

end

