connect(
	Player.CharacterAdded,
	function(character)

		task.wait(0.5)

		SESSION.UltraInstinct = false

		SESSION.Character = character

		SESSION.Humanoid =
			character:WaitForChild(
				"Humanoid",
				10
			) :: Humanoid?

		SESSION.Root =
			character:WaitForChild(
				"HumanoidRootPart",
				10
			) :: BasePart?

		if SESSION.Humanoid then
			SESSION.Humanoid.WalkSpeed = CONFIG.WalkSpeed
		end

		if SESSION.Root then
			createAura(SESSION.Root)
		end

		setupMovement()

		notify(
			"🔵 GOKU",
			"Goku moveset reloaded."
		)
	end
)

