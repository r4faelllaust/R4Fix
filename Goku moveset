local function sphere(
	cf: CFrame,
	startSize: number,
	endSize: number,
	color: Color3,
	lifetime: number
)
	local part = Instance.new("Part")

	part.Name = "DarkGarouSphere"
	part.Shape = Enum.PartType.Ball
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.12
	part.Size = Vector3.one * startSize
	part.CFrame = cf
	part.Parent = getVFX()

	TweenService:Create(
		part,
		TweenInfo.new(lifetime, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{
			Size = Vector3.one * endSize,
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(part, lifetime + 0.05)
end

local function shockwave(
	cf: CFrame,
	startSize: number,
	endSize: number,
	color: Color3
)
	local part = Instance.new("Part")

	part.Name = "DarkGarouShockwave"
	part.Shape = Enum.PartType.Cylinder
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.15
	part.Size = Vector3.new(0.18, startSize, startSize)
	part.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
	part.Parent = getVFX()

	TweenService:Create(
		part,
		TweenInfo.new(0.38, Enum.EasingStyle.Quint),
		{
			Size = Vector3.new(0.18, endSize, endSize),
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(part, 0.45)
end

local function particles(
	parent: BasePart,
	count: number,
	color: Color3
)
	local attachment = Instance.new("Attachment")
	attachment.Parent = parent

	local emitter = Instance.new("ParticleEmitter")

	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.15, 0.5)
	emitter.Speed = NumberRange.new(7, 25)
	emitter.Drag = 4
	emitter.SpreadAngle = Vector2.new(360, 360)

	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.75),
		NumberSequenceKeypoint.new(0.45, 1.5),
		NumberSequenceKeypoint.new(1, 0),
	})

	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(1, 1),
	})

	emitter.Parent = attachment

	pcall(function()
		emitter:Emit(count)
	end)

	Debris:AddItem(attachment, 1)
end

local function afterimage(character: Model, cf: CFrame?)
	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local clone = character:Clone()

	if not clone then
		return
	end

	local targetCF = cf or root.CFrame

	for _, obj in ipairs(clone:GetDescendants()) do
		if obj:IsA("Script")
			or obj:IsA("LocalScript")
			or obj:IsA("ModuleScript")
			or obj:IsA("Tool")
		then
			obj:Destroy()

		elseif obj:IsA("BasePart") then
			obj.Anchored = true
			obj.CanCollide = false
			obj.CanTouch = false
			obj.CanQuery = false
			obj.Material = Enum.Material.Neon
			obj.Color = PURPLE
			obj.Transparency = 0.55
		end
	end

	local cloneRoot = clone:FindFirstChild("HumanoidRootPart")

	if cloneRoot and cloneRoot:IsA("BasePart") then
		cloneRoot.CFrame = targetCF
	end

	clone.Parent = getVFX()

	for _, obj in ipairs(clone:GetDescendants()) do
		if obj:IsA("BasePart") then
			TweenService:Create(
				obj,
				TweenInfo.new(CFG.AfterimageLife),
				{
					Transparency = 1,
				}
			):Play()
		end
	end

	Debris:AddItem(clone, CFG.AfterimageLife + 0.05)
end

