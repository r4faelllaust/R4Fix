-- ============================================================
-- ULTIMATE BAR FIX
-- ============================================================

local function styleUltimateBar()
	local gui = Player:FindFirstChild("PlayerGui")

	if not gui then
		return
	end

	local bar = gui:FindFirstChild("Bar", true)

	if not bar then
		return
	end

	local magicHealth = bar:FindFirstChild("MagicHealth", true)

	if not magicHealth then
		return
	end

	-- Search every text label instead of relying on one exact hierarchy.
	for _, object in ipairs(magicHealth:GetDescendants()) do
		if object:IsA("TextLabel") then

			local text = object.Text

			if text == ""
				or text == "Ultimate"
				or text == "ULTIMATE"
				or text == "Awakening"
				or text == "AWAKENING"
				or text == "Magic"
			then
				object.Text = "DARK GAROU"
			end

			object.TextColor3 = BLUE3
		end
	end

	-- Find actual fill objects regardless of whether the game uses
	-- Frame, ImageLabel or ImageButton.
	for _, object in ipairs(magicHealth:GetDescendants()) do

		if object:IsA("Frame") then
			local n = string.lower(object.Name)

			if n == "bar"
				or n == "fill"
				or n == "health"
				or n == "magic"
			then
				object.BackgroundColor3 = BLUE2
				object.BackgroundTransparency = 0

				local gradient = object:FindFirstChildOfClass("UIGradient")

				if gradient then
					gradient.Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, BLUE3),
						ColorSequenceKeypoint.new(0.45, BLUE2),
						ColorSequenceKeypoint.new(1, BLUE),
					})
				end
			end

		elseif object:IsA("ImageLabel")
			or object:IsA("ImageButton")
		then

			local n = string.lower(object.Name)

			if n == "bar"
				or n == "fill"
				or n == "glow"
			then
				object.ImageColor3 = BLUE2
				object.ImageTransparency = 0
			end
		end
	end
end

