local function move3(token: number)
	if S.Busy.Move3 then
		return
	end

	local character, humanoid, root = getCharacter()

	if not character or not humanoid or not root then
		return
	end

	local target = getClosestTarget(CFG.TargetRange)

	if not target then
		return
	end

	local targetRoot = getRoot(target)

	if not targetRoot then
		return
	end

	S.Busy.Move3 = true

	playAnimation(
		humanoid,
		ANIMS.BULLET_BARRAGE,
		Enum.AnimationPriority.Action4,
		1.1,
		0.5
	)

	for i = 1, 5 do
		if token ~= S.Token then
			break
		end

		if not root.Parent or not targetRoot.Parent then
			break
		end

		local angle = math.rad((i - 1) * 72)

		local offset =
			CFrame.Angles(0, angle, 0)
			* CFrame.new(0, 0, 3.2)

		local position =
			targetRoot.Position
			+ offset.Position

		afterimage(character, root.CFrame)

		root.CFrame = CFrame.lookAt(
			position,
			targetRoot.Position
		)

		sphere(
			root.CFrame,
			1.5,
			5,
			PURPLE2,
			0.11
		)

		particles(
			root,
			9,
			WHITE
		)

		if i % 2 == 0 then
			sound(root, 0.65, 1.1)
		end

		task.wait(0.105)
	end

	if token == S.Token and root.Parent then
		faceTarget(root, targetRoot)

		playAnimation(
			humanoid,
			ANIMS.ROCK_SPLITTING,
			Enum.AnimationPriority.Action4,
			1,
			0.48
		)

		sphere(
			targetRoot.CFrame,
			3,
			16,
			PURPLE2,
			0.28
		)

		shockwave(
			targetRoot.CFrame,
			3,
			28,
			PURPLE2
		)

		particles(
			root,
			50,
			PURPLE2
		)

		sound(root, 1.7, 0.72)
	end

	S.Busy.Move3 = nil
end

