local function disconnect(list: {RBXScriptConnection})

	for _, connection in ipairs(list) do

		pcall(function()
			connection:Disconnect()
		end)

	end

	table.clear(list)

end

local function trackGlobal(connection: RBXScriptConnection)

	table.insert(
		SESSION.Connections,
		connection
	)

	return connection

end

local function trackCharacter(connection: RBXScriptConnection)

	table.insert(
		SESSION.CharacterConnections,
		connection
	)

	return connection

end

