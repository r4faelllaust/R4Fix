-- ============================================================
-- ULT MOVE
-- ============================================================

local function playUlt(index: number, token: number)
	if S.Busy.Ult then
		return
	end

	local data = ULT[index]

	if not data then
		return
	end

	local character, humanoid, root = getCharacter()

	if not character or not humanoid or not root then
		return
	end

	local target = getClosestTarget(CFG.TargetRangeUlt)

	S.Busy.Ult = true

	-- Full-screen-ish local darkness pulse.
	local oldBrightness = Lighting.Brightness
	local oldClock = Lighting.ClockTime

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "DarkGarouUltimate"
	cc.Brightness = -0.25
	cc.Contrast = 0.5
	cc.Saturation = -0.45
	cc.TintColor = Color3.fromRGB(120, 135, 210)
	cc.Parent = Lighting

	TweenService:Create(
		cc,
		TweenInfo.new(0.35),
		{
			Brightness = 0,
			Contrast = 0.2,
		}
	):Play()

	if CFG.Night then
		Lighting.ClockTime = 0
	end

	playAnimation(
		humanoid,
		data.Animation,
		Enum.AnimationPriority.Action4,
		1,
		CFG.UltDuration
	)

	ultExplosion(root, 1.25)

	sound(
		root,
		2.2,
		0.55
	)

	task.wait(0.28)

	if token ~= S.Token then
		cc:Destroy()
		S.Busy.Ult = nil
		return
	end

	if target then
		local targetRoot = getRoot(target)

		if targetRoot then

			if index == 1 then
				-- Death Counter
				teleportBehind(
					root,
					targetRoot,
					2.5,
					0
				)

				afterimage(character, root.CFrame)

				sphere(
					targetRoot.CFrame,
					3,
					20,
					BLUE2,
					0.35
				)

				shockwave(
					targetRoot.CFrame,
					3,
					34,
					BLUE3
				)

			elseif index == 2 then
				-- Blackout Rush
				for i = 1, 4 do
					if token ~= S.Token then
						break
					end

					local angle = math.rad(i * 90)

					local position =
						targetRoot.Position
						+ Vector3.new(
							math.cos(angle) * 4,
							1.5,
							math.sin(angle) * 4
						)

					afterimage(character, root.CFrame)

					root.CFrame = CFrame.lookAt(
						position,
						targetRoot.Position
					)

					sphere(
						root.CFrame,
						1.5,
						7,
						BLUE3,
						0.12
					)

					task.wait(0.12)
				end

				ultExplosion(root, 1.1)

			elseif index == 3 then
				-- Event Horizon
				teleportAbove(
					root,
					targetRoot,
					18
				)

				afterimage(character, root.CFrame)

				task.wait(0.25)

				root.CFrame = CFrame.lookAt(
					targetRoot.Position + Vector3.new(0, 5, 0),
					targetRoot.Position
				)

				ultExplosion(root, 1.55)

			elseif index == 4 then
				-- Final Hunt
				teleportBehind(
					root,
					targetRoot,
					2.4,
					0
				)

				afterimage(character, root.CFrame)

				task.wait(0.14)

				teleportAbove(
					root,
					targetRoot,
					13
				)

				afterimage(character, root.CFrame)

				task.wait(0.2)

				root.CFrame = CFrame.lookAt(
					targetRoot.Position + Vector3.new(0, 5, 0),
					targetRoot.Position
				)

				ultExplosion(root, 2)

				sound(
					root,
					2.5,
					0.48
				)
			end
		end
	end

	task.delay(0.35, function()
		if cc and cc.Parent then
			TweenService:Create(
				cc,
				TweenInfo.new(0.45),
				{
					Brightness = 0,
					Contrast = 0,
					Saturation = 0,
				}
			):Play()

			task.delay(0.46, function()
				pcall(function()
					cc:Destroy()
				end)
			end)
		end

		Lighting.Brightness = oldBrightness

		if CFG.Night then
			Lighting.ClockTime = oldClock
		end
	end)

	S.Busy.Ult = nil
end

