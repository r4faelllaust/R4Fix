	end

	local hotbar = gui:FindFirstChild("Hotbar")

	if not hotbar then
		return
	end

	local backpack = hotbar:FindFirstChild("Backpack")

	if not backpack then
		return
	end

	local container = backpack:FindFirstChild("Hotbar")

	if not container then
		return
	end

	local slot = container:FindFirstChild(tostring(slotNumber))

	if not slot then
		return
	end

	local base = slot:FindFirstChild("Base")

	if not base then
		return
	end

	local toolName = base:FindFirstChild("ToolName")

	if toolName and toolName:IsA("TextLabel") then
		toolName.Text = name
	end

	local reuse = base:FindFirstChild("Reuse")

	if reuse and reuse:IsA("TextLabel") then
		reuse.Visible = true
		reuse.Text = label
	end
