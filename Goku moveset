	for _, object in ipairs(gui:GetDescendants()) do

		if object:IsA("TextLabel") then
			local text = object.Text

			if text == "Garou"
				or text == "Hero Hunter"
				or text == "Dark Garou"
			then
				object.Text = "Dark Garou"
			end

		elseif object:IsA("ImageLabel")
			or object:IsA("ImageButton")
		then

			local n = string.lower(object.Name)

			if n == "iconimage"
				or n == "charactericon"
			then
				-- Only change known character icon objects.
				pcall(function()
					object.Image = DECAL_ID
				end)
			end
		end
	end
end

