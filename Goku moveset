				25,
				0.5
			)

			shockwave(
				CFrame.new(origin),
				50,
				0.45,
				CYAN
			)

			for i = 1, 10 do

				task.delay(
					i * 0.04,
					function()

						local r = getRoot()

						if r then

							energyBall(
								r.Position
									+ r.CFrame.LookVector
									* (i * 12),
								1.5,
								8,
								0.2
							)

						end
					end
				)

			end
