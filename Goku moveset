-- ================================================================
-- ARM TRAILS
-- ================================================================

local function createArmTrails(
	character: Model
)

	local limbNames = {

		"Left Arm",
		"Right Arm",

		"LeftHand",
		"RightHand",

		"LeftLowerArm",
		"RightLowerArm",

	}

	for _, name in ipairs(limbNames) do

		local limb =
			character:FindFirstChild(name)

		if limb
			and limb:IsA("BasePart") then

			local old =
				limb:FindFirstChild(
					"R4FIX_GokuTrail"
				)

			if old then
				old:Destroy()
			end

			local a0 =
				Instance.new("Attachment")

			a0.Position =
				Vector3.new(
					0,
					0.4,
					0
				)

			a0.Parent =
				limb

			local a1 =
				Instance.new("Attachment")

			a1.Position =
				Vector3.new(
					0,
					-0.65,
					0
				)

			a1.Parent =
				limb

			local trail =
				Instance.new("Trail")

			trail.Name =
				"R4FIX_GokuTrail"

			trail.Attachment0 =
				a0

			trail.Attachment1 =
				a1

			trail.Lifetime =
				0.28

			trail.LightEmission =
				1

			trail.MinLength =
				0.05

			trail.Color =
				ColorSequence.new({

					ColorSequenceKeypoint.new(
						0,
						WHITE
					),

					ColorSequenceKeypoint.new(
						0.35,
						CYAN
					),

					ColorSequenceKeypoint.new(
						0.7,
						BLUE
					),

					ColorSequenceKeypoint.new(
						1,
