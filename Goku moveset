-- ================================================================
-- MOVE DISPATCH
-- ================================================================

local function dispatchMove(
	id: string,
	humanoid: Humanoid,
	root: BasePart
)

	if M1_TRIGGERS[id] then

		m1()
		return

	end

	if id == SLOT1_ID then

		dragonFist()
		return

	end

	if id == SLOT2_ID then

		skySuplex()
		return

	end

	if id == SLOT3_ID then

		instantTransmission()
		return

	end

	if id == SLOT4_ID then

		godlyBarrage()
		return

	end

	if id == SPECIAL_ID then

		blueFlashMove()
		return

	end

	if id == ULT1_TRIGGER then

		SESSION.IsUlted =
			true

		finalKamehameha()
		return

	end

	if id == ULT2_TRIGGER then

		meteorBreaker()
		return

	end

	if id == ULT3_TRIGGER then

		perfectedBlue()
		return

	end

end

-- ================================================================
-- HOTBAR
-- ================================================================

local function findSlot(
	number: number
): Instance?

	local hotbar =
		PlayerGui:FindFirstChild(
			"Hotbar"
		)

	if not hotbar then
		return nil
	end

	local backpack =
		hotbar:FindFirstChild(
			"Backpack"
		)

	if not backpack then
		return nil
	end

	local frame =
		backpack:FindFirstChild(
			"Hotbar"
		)

	if not frame then
		return nil
	end

	local slot =
		frame:FindFirstChild(
			tostring(number)
		)

	if not slot then
		return nil
	end

	return slot:FindFirstChild(
		"Base"
	) or slot

end

local function setMoveName(
	number: number,
	name: string
)

	local slot =
		findSlot(number)

	if not slot then
		return
	end

	local toolName =
		slot:FindFirstChild(
			"ToolName"
		)

	if toolName
		and toolName:IsA("TextLabel") then

		toolName.Text =
			name

	end

end

