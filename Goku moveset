local function destroyTool(name: string)
	local backpack = Player:FindFirstChild("Backpack")

	if backpack then
		for _, obj in ipairs(backpack:GetChildren()) do
			if obj:IsA("Tool") and obj.Name == name then
				obj:Destroy()
			end
		end
	end

	local character = Player.Character

	if character then
		for _, obj in ipairs(character:GetChildren()) do
			if obj:IsA("Tool") and obj.Name == name then
				obj:Destroy()
			end
		end
	end
end

local function setupRunTool()
	destroyTool("Dark Garou Run")

	local backpack = Player:FindFirstChild("Backpack")

	if not backpack then
		return
	end

	local tool = Instance.new("Tool")

	tool.Name = "Dark Garou Run"
	tool.ToolTip = "PHANTOM ENGINE"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Parent = backpack

	local running = false
	local track: AnimationTrack? = nil

	tool.Equipped:Connect(function()
		local _, humanoid, root = getCharacter()

		if not humanoid or not root then
			return
		end

		running = true

		track = playAnimation(
			humanoid,
			ANIMS.RUN,
			Enum.AnimationPriority.Movement,
			1.1
		)

		while running
			and tool.Parent
			and humanoid.Health > 0
		do

			local direction = root.CFrame.LookVector

			root.AssemblyLinearVelocity = Vector3.new(
				direction.X * CFG.RunSpeed,
				root.AssemblyLinearVelocity.Y,
				direction.Z * CFG.RunSpeed
			)

			task.wait()
		end
	end)

	local function stop()
		running = false

		if track then
			pcall(function()
				track:Stop(0.1)
			end)

			track = nil
		end
	end

	tool.Unequipped:Connect(stop)

	tool.AncestryChanged:Connect(function(_, parent)
		if not parent then
			stop()
		end
	end)
end

