local function setupTeleportTool()
	destroyTool("Dark Garou Teleport")

	local backpack = Player:FindFirstChild("Backpack")

	if not backpack then
		return
	end

	local tool = Instance.new("Tool")

	tool.Name = "Dark Garou Teleport"
	tool.ToolTip = "VOID STEP"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Parent = backpack

	tool.Activated:Connect(function()
		local _, humanoid, root = getCharacter()

		if not humanoid or not root then
			return
		end

		local mouse = Player:GetMouse()

		if not mouse or not mouse.Hit then
			return
		end

		local old = root.CFrame

		sphere(
			old,
			2,
			8,
			PURPLE,
			0.16
		)

		particles(
			root,
			15,
			PURPLE2
		)

		task.wait(0.045)

		if humanoid.Health <= 0 then
			return
		end

		local destination = mouse.Hit.Position

		root.CFrame =
			CFrame.new(destination + Vector3.new(0, 2.5, 0))
			* CFrame.Angles(
				0,
				select(2, old:ToOrientation()),
				0
			)

		sphere(
			root.CFrame,
			2,
			10,
			PURPLE2,
			0.22
		)

		shockwave(
			root.CFrame,
			2,
			15,
			PURPLE
		)

		particles(
			root,
			20,
			PURPLE2
		)
	end)
end

-- ============================================================
-- MOVE HANDLER
-- ============================================================

local function setupMoveHandler(
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	token: number
)

	table.insert(
		S.CharacterConnections,
		humanoid.AnimationPlayed:Connect(function(track)

			if token ~= S.Token then
				return
			end

			local animation = track.Animation

			if not animation then
				return
			end

			local id = animation.AnimationId

			if id == ANIMS.M1 then
				pcall(function()
					track:Stop()
				end)

				task.spawn(function()
					move1(token)
				end)

			elseif id == ANIMS.MOVE1 then
				pcall(function()
					track:Stop()
				end)

				task.spawn(function()
					move1(token)
				end)

			elseif id == ANIMS.MOVE2 then
				pcall(function()
					track:Stop()
				end)

				task.spawn(function()
					move2(token)
				end)

			elseif id == ANIMS.MOVE3 then
				pcall(function()
					track:Stop()
				end)

				task.spawn(function()
					move3(token)
				end)

			elseif id == ANIMS.MOVE4 then
				pcall(function()
					track:Stop()
				end)

				task.spawn(function()
					move4(token)
				end)
			end
		end)
	)
end

