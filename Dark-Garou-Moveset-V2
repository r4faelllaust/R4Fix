local function burst(
	cframe,
	size,
	color,
	duration,
	key
)
	if key and not vfxAllowed(
		key,
		CONFIG.VFX_GLOBAL_COOLDOWN
	) then
		return
	end

	local part = Instance.new("Part")
	part.Name = "DarkGarouBurst"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.2
	part.Size = Vector3.one
	part.CFrame = cframe
	part.Parent = getVFXFolder()

	TweenService:Create(
		part,
		TweenInfo.new(
			duration or 0.25,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(size, size, size),
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(
		part,
		(duration or 0.25) + 0.1
	)
end

local function shockwave(
	cframe,
	startSize,
	endSize,
	color,
	duration,
	key
)
	if key and not vfxAllowed(
		key,
		CONFIG.VFX_GLOBAL_COOLDOWN
	) then
		return
	end

	local ring = Instance.new("Part")
	ring.Name = "DarkGarouShockwave"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CanQuery = false
	ring.CastShadow = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.15
	ring.Size = Vector3.new(
		0.1,
		startSize,
		startSize
	)

	ring.CFrame =
		cframe
		* CFrame.Angles(
			0,
			0,
			math.rad(90)
		)

	ring.Parent = getVFXFolder()

	TweenService:Create(
		ring,
		TweenInfo.new(
			duration or 0.35,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(
				0.1,
				endSize,
				endSize
			),
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(
		ring,
		(duration or 0.35) + 0.1
	)
end

local function particles(
	parent,
	amount,
	color,
	key
)
	if not parent or not parent.Parent then
		return
	end

	if key and not vfxAllowed(
		key,
		CONFIG.VFX_GLOBAL_COOLDOWN
	) then
		return
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = "DarkGarouParticles"
	attachment.Parent = parent

	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.LightEmission = 0.8
	emitter.Color = ColorSequence.new(
		color,
		PURPLE
	)

	emitter.Lifetime = NumberRange.new(
		0.2,
		0.55
	)

	emitter.Speed = NumberRange.new(
		3,
		13
	)

	emitter.Drag = 4
	emitter.SpreadAngle = Vector2.new(
		360,
		360
	)

	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(0.45, 1.6),
		NumberSequenceKeypoint.new(1, 0),
	})

	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})

	emitter.Parent = attachment

	pcall(function()
		emitter:Emit(amount)
	end)

	Debris:AddItem(
		attachment,
		1
	)
end

-- ================================================================
-- PHANTOM ENGINE
-- ================================================================

local function phantomEngine(
	duration,
	speed,
	token
)
	local character, humanoid, hrp =
		getCharacter()

	if not character
		or not humanoid
		or not hrp
		or humanoid.Health <= 0
	then
		return nil
	end

	if token ~= SESSION.CharacterToken then
		return nil
	end

	local velocity = Instance.new("BodyVelocity")
	velocity.Name = "DarkGarou_PhantomEngine"
	velocity.MaxForce = Vector3.new(
		5000000,
		5000000,
		5000000
	)
	velocity.P = 50000
	velocity.Velocity =
		hrp.CFrame.LookVector * speed
	velocity.Parent = hrp

	local gyro = Instance.new("BodyGyro")
	gyro.Name = "DarkGarou_PhantomGyro"
	gyro.MaxTorque = Vector3.new(
		1000000,
		1000000,
		1000000
	)
	gyro.P = 50000
	gyro.D = 1000
	gyro.CFrame = hrp.CFrame
	gyro.Parent = hrp

	local started = os.clock()
	local active = true

	burst(
		hrp.CFrame,
		7,
		PURPLE,
		0.22,
		"phantom_start"
	)

	shockwave(
		hrp.CFrame,
		2,
		15,
		PURPLE_BRIGHT,
		0.3,
		"phantom_ring"
	)

	playSound(
		hrp,
		1.25,
		0.88
	)

	task.spawn(function()
		while active
			and token == SESSION.CharacterToken
			and hrp.Parent
			and humanoid.Health > 0
		do
			local elapsed = os.clock() - started

			if elapsed >= duration then
				break
			end

			local direction = hrp.CFrame.LookVector

			velocity.Velocity =
				direction
				* (
					speed
					* (
						1
						+ math.sin(
							(elapsed / duration)
							* math.pi
						) * 0.35
					)
				)

			gyro.CFrame =
				CFrame.lookAt(
					hrp.Position,
					hrp.Position + direction
				)

			task.wait()
		end

		active = false

		pcall(function()
			velocity:Destroy()
		end)

		pcall(function()
			gyro:Destroy()
		end)
	end)

	return {
		Velocity = velocity,
		Gyro = gyro,
	}
end

