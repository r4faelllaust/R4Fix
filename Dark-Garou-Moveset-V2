local function createTools()
deleteOurTools()

local backpack =
	LocalPlayer:WaitForChild(
		"Backpack"
	)

-- ============================================================
-- RUN
-- ============================================================

local runTool =
	Instance.new("Tool")

runTool.Name =
	"Dark Garou Run"

runTool.RequiresHandle = false
runTool.CanBeDropped = false
runTool.ToolTip =
	"Phantom Run"

runTool.Parent =
	backpack

local running = false
local runAnimation

local function stopRun()
	running = false

	if runAnimation then
		pcall(function()
			runAnimation:Stop(0.08)
			runAnimation:Destroy()
		end)

		runAnimation = nil
	end
end

runTool.Equipped:Connect(
	function()
		local character,
			humanoid,
			hrp =
			getCharacter()

		if not character
			or not humanoid
			or not hrp
		then
			return
		end

		running = true

		runAnimation =
			playAnimation(
				humanoid,
				"rbxassetid://18897115785",
				Enum.AnimationPriority.Action,
				1
			)

		burst(
			hrp.CFrame,
			6,
			PURPLE,
			0.2,
			"run_start"
		)

		task.spawn(function()
			while running
				and runTool.Parent
				and humanoid.Health > 0
			do
				local direction =
					hrp.CFrame.LookVector

				hrp.AssemblyLinearVelocity =
					Vector3.new(
						direction.X
							* CONFIG.RUN_SPEED,
						hrp.AssemblyLinearVelocity.Y,
						direction.Z
							* CONFIG.RUN_SPEED
					)

				task.wait()
			end
		end)
	end
)

runTool.Unequipped:Connect(
	stopRun
)

table.insert(
	SESSION.Tools,
	runTool
)

-- ============================================================
-- TELEPORT
-- ============================================================

local tpTool =
	Instance.new("Tool")

tpTool.Name =
	"Dark Garou Teleport"

tpTool.RequiresHandle = false
tpTool.CanBeDropped = false
tpTool.ToolTip =
	"Void Step"

tpTool.Parent =
	backpack

tpTool.Activated:Connect(
	function()
		local character,
			humanoid,
			hrp =
			getCharacter()

		if not character
			or not humanoid
			or not hrp
		then
			return
		end

		local mouse =
			LocalPlayer:GetMouse()

		if not mouse
			or not mouse.Hit
		then
			return
		end

		local destination =
			mouse.Hit.Position

		local oldCF =
			hrp.CFrame

		burst(
			oldCF,
			7,
			PURPLE,
			0.2,
			"tp_depart"
		)

		particles(
			hrp,
			18,
			BRIGHT_PURPLE,
			"tp_depart_particles"
		)

		task.wait(0.04)

		local _, newHumanoid, newHRP =
			getCharacter()

		if not newHumanoid
			or not newHRP
			or newHumanoid.Health <= 0
		then
			return
		end

		newHRP.CFrame =
			CFrame.new(
				destination
			)
			* CFrame.Angles(
				0,
				select(
					2,
					oldCF:ToEulerAnglesYXZ()
				),
				0
			)

		burst(
			newHRP.CFrame,
			9,
			BRIGHT_PURPLE,
			0.28,
			"tp_arrive"
		)

		ring(
			newHRP.CFrame,
			2,
			15,
			PURPLE,
			0.35,
			"tp_arrive_ring"
		)

		particles(
			newHRP,
			24,
			BRIGHT_PURPLE,
			"tp_arrive_particles"
		)
	end
)

table.insert(
	SESSION.Tools,
	tpTool
)

end

