local MOVE_NAMES = {
	["1"] = "Abyssal Drag",
	["2"] = "Shadow Strike",
	["3"] = "Phantom Sweep",
	["4"] = "Total Eclipse",
}

local ULT_NAMES = {
	["1"] = "Void Execution",
	["2"] = "Silent Death",
