local function setupMoves(
	character,
	humanoid,
	hrp,
	token
)
	track(
		humanoid.AnimationPlayed:Connect(function(animationTrack)
			if token ~= SESSION.CharacterToken then
				return
			end

			if not animationTrack.Animation then
				return
			end

			local id =
				animationTrack.Animation.AnimationId

			-- M1
			local replacement =
				M1_CHAIN[id] or DOWNSLAM[id]

			if replacement then
				stopTrack(animationTrack)

				playAnim(
					humanoid,
					replacement,
					Enum.AnimationPriority.Action
				)

				return
			end

			-- MOVE 1
			if id == ANIM.Move1 then
				stopTrack(animationTrack)

				if SESSION.Busy.Void then
					return
				end

				PhantomEngine(
					0.8,
					CFG.PhantomSpeed,
					token
				)

				burst(
					hrp.CFrame,
					8,
					COLORS.Purple,
					0.25,
					"move1_start"
				)

				particles(
					hrp,
					25,
					COLORS.BrightPurple,
					"move1_particles"
				)

				voidExecution(
					character,
					humanoid,
					hrp,
					token
				)

				return
			end

			-- MOVE 2
			-- Phantom Engine stays here.
			if id == ANIM.Move2 then
				stopTrack(animationTrack)

				PhantomEngine(
					CFG.Move2Duration,
					CFG.Move2Speed,
					token
				)

				burst(
					hrp.CFrame,
					9,
					COLORS.Purple,
					0.25,
					"move2_start"
				)

				ring(
					hrp.CFrame,
					2,
					20,
					COLORS.BrightPurple,
					0.35,
					"move2_ring"
				)

				particles(
					hrp,
					28,
					COLORS.BrightPurple,
					"move2_particles"
				)

				return
			end

			-- MOVE 3
			-- ABSOLUTELY NO PHANTOM ENGINE HERE.
			if id == ANIM.Move3 then
				stopTrack(animationTrack)

				local state = humanoid:GetState()

				local air =
					state == Enum.HumanoidStateType.Jumping
					or state == Enum.HumanoidStateType.Freefall

				playAnim(
					humanoid,
					air
						and ANIM.Move3Air
						or ANIM.Move3Ground,
					Enum.AnimationPriority.Action,
					0.04,
					1
				)

				burst(
					hrp.CFrame,
					10,
					COLORS.Purple,
					0.3,
					"move3_start"
				)

				ring(
					hrp.CFrame,
					3,
					27,
					COLORS.BrightPurple,
					0.45,
					"move3_ring"
				)

				particles(
					hrp,
					32,
					COLORS.BrightPurple,
					"move3_particles"
				)

				return
			end

			-- MOVE 4
			if id == ANIM.Move4 then
				stopTrack(animationTrack)

				local actionTrack = playAnim(
					humanoid,
					ANIM.Move4Action,
					Enum.AnimationPriority.Action4,
					0.03,
					1
				)

				if actionTrack then
					task.delay(
						CFG.Move4Duration,
						function()
							if actionTrack
								and actionTrack.IsPlaying
							then
								stopTrack(actionTrack)
							end
						end
					)
				end

				burst(
					hrp.CFrame,
					14,
					COLORS.Black,
					0.35,
					"move4_start"
				)

				burst(
					hrp.CFrame,
					8,
					COLORS.BrightPurple,
					0.25,
					"move4_core"
				)

				ring(
					hrp.CFrame,
					4,
					38,
					COLORS.Purple,
					0.55,
					"move4_ring"
				)

				particles(
					hrp,
					45,
					COLORS.BrightPurple,
					"move4_particles"
				)

				return
			end

			-- SPECIAL
			if id == ANIM.Special then
				stopTrack(animationTrack)

				playAnim(
					humanoid,
					ANIM.Special,
					Enum.AnimationPriority.Action4
				)

				return
			end

			-- ULT 1
			if id == ANIM.Ult1Trigger then
				stopTrack(animationTrack)

				playAnim(
					humanoid,
					ANIM.Ult1,
					Enum.AnimationPriority.Action4,
					0.02,
					1
				)

				burst(
					hrp.CFrame,
					20,
					COLORS.Black,
					0.5,
