local function folder()
	local f = workspace:FindFirstChild("DarkGarou_VFX")

	if not f then
		f = Instance.new("Folder")
		f.Name = "DarkGarou_VFX"
		f.Parent = workspace
	end

	return f
end

local function allowed(key, cooldown)
	local now = os.clock()
	local last = SESSION.LastVFX[key] or 0

	if now - last < cooldown then
		return false
	end

	SESSION.LastVFX[key] = now
	return true
end

local function burst(
	cframe,
	size,
	color,
	duration,
	key
)
	if key and not allowed(key, CFG.VFXCooldown) then
		return
	end

	local p = Instance.new("Part")
	p.Name = "Burst"
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Ball
	p.Material = Enum.Material.Neon
	p.Color = color or COLORS.Purple
	p.Transparency = 0.2
	p.Size = Vector3.one
	p.CFrame = cframe
	p.Parent = folder()

	TweenService:Create(
		p,
		TweenInfo.new(
			duration or 0.3,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(size, size, size),
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(p, (duration or 0.3) + 0.1)
end

local function ring(
	cframe,
	startSize,
	endSize,
	color,
	duration,
	key
)
	if key and not allowed(key, CFG.VFXCooldown) then
		return
	end

	local p = Instance.new("Part")
	p.Name = "Ring"
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color or COLORS.Purple
	p.Transparency = 0.2
	p.Size = Vector3.new(0.12, startSize, startSize)
	p.CFrame = cframe * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = folder()

	TweenService:Create(
		p,
		TweenInfo.new(
			duration or 0.4,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(0.12, endSize, endSize),
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(p, (duration or 0.4) + 0.1)
end

local function particles(
	parent,
	amount,
	color,
	key
)
	if not parent or not parent.Parent then
		return
	end

	if key and not allowed(key, CFG.VFXCooldown) then
		return
	end

	local a = Instance.new("Attachment")
	a.Name = "DarkGarouParticles"
	a.Parent = parent

	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.LightEmission = 0.8
	e.Lifetime = NumberRange.new(0.2, 0.55)
	e.Speed = NumberRange.new(3, 12)
	e.Drag = 4
	e.SpreadAngle = Vector2.new(360, 360)

	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, color or COLORS.BrightPurple),
		ColorSequenceKeypoint.new(0.5, COLORS.Purple),
		ColorSequenceKeypoint.new(1, COLORS.Black),
	})

	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(0.45, 1.5),
		NumberSequenceKeypoint.new(1, 0),
	})

	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})

	e.Parent = a

	pcall(function()
		e:Emit(amount or 15)
	end)

	Debris:AddItem(a, 1)
end

