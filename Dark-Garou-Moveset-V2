local function characterTab()
local gui = Player:FindFirstChild("PlayerGui")

if not gui then
	return
end

local topbar = gui:FindFirstChild("TopbarPlus")

if not topbar then
	return
end

for _, object in ipairs(topbar:GetDescendants()) do
	if object.Name == "IconButton" then
		local label = object:FindFirstChild("IconLabel")
		local image = object:FindFirstChild("IconImage")

		if label then
			if label.Text == "Garou"
				or label.Text == "Hero Hunter"
				or label.Text == MOVESET_NAME
			then
				label.Text = MOVESET_NAME

				if image then
					image.Image = DECAL_ID
				end
			end
		end
	end
end

end

-- ================================================================
-- HAND GLOW
-- ================================================================

local function handGlow(character)
for _, limbName in ipairs({
"Left Arm",
"Right Arm",
"LeftHand",
"RightHand",
"LeftLowerArm",
"RightLowerArm",
}) do
local limb = character:FindFirstChild(limbName)

	if limb and limb:IsA("BasePart") then
		if limb:FindFirstChild("DarkGarouHandGlow") then
			continue
		end

		local attachment = Instance.new("Attachment")
		attachment.Name = "DarkGarouHandGlow"
		attachment.Parent = limb

		local emitter = Instance.new("ParticleEmitter")
		emitter.Color = ColorSequence.new(
			COLOR.White,
			COLOR.BrightPurple
		)
		emitter.LightEmission = 1
		emitter.Rate = 2
		emitter.Lifetime = NumberRange.new(0.25, 0.45)
		emitter.Speed = NumberRange.new(0.2, 1)
		emitter.SpreadAngle = Vector2.new(180, 180)

		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(1, 0),
		})

		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})

		emitter.Parent = attachment
	end
end

end

