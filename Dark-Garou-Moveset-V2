local function fixCharacterTab()
	local gui = Player:FindFirstChild("PlayerGui")
	if not gui then
		return
	end

	local topbar = gui:FindFirstChild("TopbarPlus")
	if not topbar then
		return
	end

	for _, obj in ipairs(topbar:GetDescendants()) do
		if obj.Name ~= "IconButton" then
			continue
		end

		local label = obj:FindFirstChild("IconLabel")
		local image = obj:FindFirstChild("IconImage")

		if label and label:IsA("TextLabel") then
			local text = label.Text

			if text == "Garou"
				or text == "Hero Hunter"
				or text == MOVESET_NAME
			then
				label.Text = MOVESET_NAME

				if image and image:IsA("ImageLabel") then
					image.Image = DECAL_ID
				end
			end
		end
	end
end

-- ================================================================
-- HOTBAR HELPERS
-- ================================================================

local function findGuiByNames(root, names)
	for _, name in ipairs(names) do
		local found = root:FindFirstChild(name, true)

		if found then
			return found
		end
	end

	return nil
end

local function setTextSafe(obj, text)
	if obj:IsA("TextLabel")
		or obj:IsA("TextButton")
		or obj:IsA("TextBox")
	then
		obj.Text = text
	end
end

local function getHotbar()
	local gui = Player:FindFirstChild("PlayerGui")
	if not gui then
		return nil
	end

	local hotbar = gui:FindFirstChild("Hotbar")
	if not hotbar then
		return nil
	end

	return hotbar:FindFirstChild("Backpack")
		or hotbar
end

local function getSlot(number)
	local root = getHotbar()
	if not root then
		return nil
	end

	local direct = root:FindFirstChild(tostring(number), true)

	if direct then
		return direct
	end

	for _, obj in ipairs(root:GetDescendants()) do
		if obj.Name == tostring(number) then
			return obj
		end
	end

	return nil
end

local function setMoveName(slotNumber, name, subtext)
	local slot = getSlot(slotNumber)
	if not slot then
		return
	end

	local toolName = findGuiByNames(
		slot,
		{
			"ToolName",
			"MoveName",
			"Name",
		}
	)

	if toolName then
		setTextSafe(toolName, name)
	end

	if subtext then
		local reuse = findGuiByNames(
			slot,
			{
				"Reuse",
				"Cooldown",
				"Subtext",
			}
		)

		if reuse then
			setTextSafe(reuse, subtext)
		end
	end
end

