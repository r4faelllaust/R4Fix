local function getHotbarSlots()
	local gui = Player:FindFirstChild("PlayerGui")

	if not gui then
		return nil
	end

	local hotbar = gui:FindFirstChild("Hotbar")

	if not hotbar then
		return nil
	end

	local backpack = hotbar:FindFirstChild(
		"Backpack"
	)

	if not backpack then
		return nil
	end

	return backpack:FindFirstChild("Hotbar")
end

local function setSlot(
	number,
	name,
	label
)
	local slots = getHotbarSlots()

	if not slots then
		return
	end

	local slot = slots:FindFirstChild(
		tostring(number)
	)

	if not slot then
		return
	end

	local base = slot:FindFirstChild(
		"Base"
	)

	if not base then
		return
	end

	local toolName = base:FindFirstChild(
		"ToolName"
	)

	if toolName then
		setTextIfExists(
			toolName,
			name
		)
	end

	local reuse = base:FindFirstChild(
		"Reuse"
	)

	if reuse and label then
		setTextIfExists(
			reuse,
			label
		)

		local nested =
			reuse:FindFirstChild("Reuse")

		if nested then
			setTextIfExists(
				nested,
				label
			)
		end

		reuse.Visible = true
	end
end

