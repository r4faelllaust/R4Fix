-- IDLE
-- ================================================================

local function setupIdle(character, humanoid, token)
	local motors = {}

	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("Motor6D") then
			local n = string.lower(obj.Name)

			if string.find(n, "waist")
				or string.find(n, "shoulder")
				or string.find(n, "neck")
			then
				table.insert(motors, {
					Motor = obj,
					Base = obj.Transform,
					Name = n,
				})
			end
		end
	end

	table.insert(
		SESSION.CharacterConnections,
		RunService.RenderStepped:Connect(function()
			if token ~= SESSION.CharacterToken
				or not character.Parent
				or humanoid.Health <= 0
			then
				return
			end

			local moving = humanoid.MoveDirection.Magnitude > 0.05
			local state = humanoid:GetState()

			if moving
				or state == Enum.HumanoidStateType.Jumping
				or state == Enum.HumanoidStateType.Freefall
			then
				for _, data in ipairs(motors) do
					pcall(function()
						data.Motor.Transform =
							data.Motor.Transform:Lerp(data.Base, 0.18)
					end)
				end

				return
			end

			local t = os.clock()

			local breathe = math.sin(t * CONFIG.IDLE_SPEED)
			local sway = math.sin(t * CONFIG.IDLE_SPEED * 0.55)

			for _, data in ipairs(motors) do
				pcall(function()
					if string.find(data.Name, "waist") then
						data.Motor.Transform =
							data.Base
							* CFrame.Angles(
								0,
								breathe * CONFIG.IDLE_STRENGTH,
								sway * 0.02
							)

					elseif string.find(data.Name, "shoulder") then
						data.Motor.Transform =
							data.Base
							* CFrame.Angles(
								breathe * 0.02,
								0,
								sway * 0.018
							)

					elseif string.find(data.Name, "neck") then
						data.Motor.Transform =
							data.Base
							* CFrame.Angles(
								breathe * 0.018,
								sway * 0.03,
								0
							)
					end
				end)
			end
		end)
	)
end

