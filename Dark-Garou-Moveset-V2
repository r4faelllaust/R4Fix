local function fixCharacterTab()
	local gui =
		Player:FindFirstChild(
			"PlayerGui"
		)

	if not gui then
		return
	end

	local topbar =
		gui:FindFirstChild(
			"TopbarPlus"
		)

	if not topbar then
		return
	end

	for _, obj in ipairs(
		topbar:GetDescendants()
	) do
		if obj.Name ==
			"IconButton"
		then
			local label =
				obj:FindFirstChild(
					"IconLabel"
				)

			local image =
				obj:FindFirstChild(
					"IconImage"
				)

			if label then
				local current =
					string.lower(
						label.Text
					)

				if current ==
					"garou"
					or current ==
					"hero hunter"
					or current ==
					"dark garou"
				then
					label.Text =
						MOVESET_NAME

					if image
						and image:IsA(
							"ImageLabel"
						)
					then
						image.Image =
							DECAL_ID
					end
				end
			end
		end
	end
end

