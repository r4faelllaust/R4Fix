-- CHARACTER SETUP
-- ================================================================

local function setupCharacter(character)
	SESSION.CharacterToken += 1

	local token = SESSION.CharacterToken

	cleanupCharacter()

	SESSION.Busy.Void = nil

	local humanoid =
		character:WaitForChild("Humanoid", 10)

	local hrp =
		character:WaitForChild("HumanoidRootPart", 10)

	if not humanoid or not hrp then
		return
	end

	applyNight()

	spawnFX(character, hrp)
	handGlow(character)

	setupIdle(
		character,
		humanoid,
		token
	)

	setupMoves(
		character,
		humanoid,
		hrp,
		token
	)

	setupMovement(
		humanoid,
		hrp,
		token
	)

	task.spawn(function()
		for _ = 1, 15 do
			if token ~= SESSION.CharacterToken then
				return
			end

			fixCharacterTab()
			refreshMoves()

			task.wait(0.2)
		end
	end)

	task.delay(0.5, function()
		if token == SESSION.CharacterToken then
			setupTools()
		end
	end)

	track(
		humanoid.Died:Connect(function()
			SESSION.Busy.Void = nil
		end)
	)

	track(
		PlayerGui.DescendantAdded:Connect(function()
			task.defer(function()
				if token == SESSION.CharacterToken then
					fixCharacterTab()
					refreshMoves()
				end
			end)
		end)
	)
end

