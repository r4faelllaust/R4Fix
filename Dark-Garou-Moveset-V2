				"Humanoid"
			)

		if humanoid then
			setupTargetHealth(
				object,
				humanoid
			)
		end
	end
end

track(
	live.ChildAdded:Connect(
		function(object)
			if not object:IsA("Model") then
				return
			end

			local humanoid =
				object:WaitForChild(
					"Humanoid",
					5
				)

			if humanoid then
				setupTargetHealth(
					object,
					humanoid
				)
			end
		end
	)
)

end

-- ================================================================
-- PHANTOM ENGINE
-- ================================================================

local function PhantomEngine(
duration,
speed,
token
)
local character, humanoid, hrp =
getCharacter()

if not character
	or not humanoid
	or not hrp
then
	return
end

if token ~= SESSION.Token then
	return
end

local velocity =
	Instance.new("BodyVelocity")

velocity.Name =
	"DarkGarou_PhantomEngine"

velocity.MaxForce =
	Vector3.new(
		5000000,
		5000000,
		5000000
	)

velocity.P = 50000

velocity.Velocity =
	hrp.CFrame.LookVector
	* speed

velocity.Parent = hrp

local gyro =
	Instance.new("BodyGyro")

gyro.Name =
	"DarkGarou_PhantomGyro"

gyro.MaxTorque =
	Vector3.new(
		1000000,
		1000000,
		1000000
	)

gyro.P = 50000
gyro.D = 1000
gyro.CFrame = hrp.CFrame
gyro.Parent = hrp

local started = os.clock()

task.spawn(function()
	while velocity.Parent
		and gyro.Parent
		and humanoid.Health > 0
		and token == SESSION.Token
		and os.clock() - started <
			duration
	do
		local direction =
			hrp.CFrame.LookVector

		velocity.Velocity =
			direction * speed

		gyro.CFrame =
			CFrame.lookAt(
				hrp.Position,
				hrp.Position + direction
			)

		task.wait()
	end

	pcall(function()
		velocity:Destroy()
	end)

	pcall(function()
		gyro:Destroy()
	end)
end)

burst(
	hrp.CFrame,
	8,
	PURPLE,
	0.22,
	"phantom_start"
)

ring(
	hrp.CFrame,
	2,
	18,
	BRIGHT_PURPLE,
	0.3,
	"phantom_ring"
)

end

-- ================================================================
-- MOVE 1, INSTANT KILL / VOID
-- ================================================================

local function move1(
character,
humanoid,
hrp,
token
)
if SESSION.Busy.Move1 then
return
end

SESSION.Busy.Move1 = true

local original =
	hrp.CFrame

PhantomEngine(
	0.8,
	260,
	token
)

burst(
	hrp.CFrame,
	10,
	PURPLE,
	0.25,
	"m1_start"
)

particles(
	hrp,
	28,
	BRIGHT_PURPLE,
	"m1_particles"
)

task.delay(
	CONFIG.VOID_DELAY,
	function()
		if token ~= SESSION.Token then
			SESSION.Busy.Move1 = nil
			return
		end

		if not hrp.Parent
			or humanoid.Health <= 0
		then
			SESSION.Busy.Move1 = nil
			return
		end

		local direction =
			Vector3.new(
				hrp.CFrame.LookVector.X,
				0,
				hrp.CFrame.LookVector.Z
			)

		if direction.Magnitude <
			0.01
		then
			direction =
				Vector3.new(
					0,
					0,
					-1
				)
		end

		direction =
			direction.Unit

		local destination =
			hrp.Position
			+ direction
			* CONFIG.VOID_DISTANCE

		destination =
			Vector3.new(
				destination.X,
				hrp.Position.Y,
				destination.Z
			)

		hrp.CFrame =
			CFrame.lookAt(
				destination,
				destination + direction
			)

		hrp.AssemblyLinearVelocity =
			Vector3.zero

		burst(
			hrp.CFrame,
			18,
			BLACK,
			0.35,
			"void_arrive"
		)

		ring(
			hrp.CFrame,
			4,
			35,
			BRIGHT_PURPLE,
			0.45,
			"void_ring"
		)

		particles(
			hrp,
			50,
			BRIGHT_PURPLE,
			"void_particles"
		)

		task.delay(
			CONFIG.VOID_STAY,
			function()
				if token ~= SESSION.Token then
					SESSION.Busy.Move1 = nil
					return
				end

				if hrp.Parent then
					burst(
						hrp.CFrame,
						14,
						BLACK,
						0.3,
						"void_return"
					)

					hrp.CFrame =
						original

					hrp.AssemblyLinearVelocity =
						Vector3.zero

					burst(
						original,
						16,
						BRIGHT_PURPLE,
						0.35,
						"void_reappear"
					)

					ring(
						original,
						4,
						30,
						PURPLE,
						0.4,
						"void_reappear_ring"
					)
				end

				SESSION.Busy.Move1 = nil
			end
		)
	end
)

end

