-- ================================================================

local function PhantomEngine(
	duration,
	speed,
	token
)
	local character, humanoid, hrp = getCharacter()

	if not character
		or not humanoid
		or not hrp
		or humanoid.Health <= 0
	then
		return false
	end

	if token ~= SESSION.CharacterToken then
		return false
	end

	local oldVelocity = hrp.AssemblyLinearVelocity

	local attachment = Instance.new("Attachment")
	attachment.Name = "DarkGarouPhantomAttachment"
	attachment.Parent = hrp

	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "DarkGarouPhantomEngine"
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VectorVelocity =
		hrp.CFrame.LookVector * speed
	velocity.Parent = hrp

	local trailA = Instance.new("Attachment")
	trailA.Position = Vector3.new(-1, 0, 0)
	trailA.Parent = hrp

	local trailB = Instance.new("Attachment")
	trailB.Position = Vector3.new(1, 0, 0)
	trailB.Parent = hrp

	local trail = Instance.new("Trail")
	trail.Attachment0 = trailA
	trail.Attachment1 = trailB
	trail.Lifetime = 0.3
	trail.MinLength = 0.05
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(
		COLORS.White,
		COLORS.BrightPurple
	)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Parent = hrp

	burst(
		hrp.CFrame,
		7,
		COLORS.Purple,
		0.22,
		"phantom_start"
	)

	ring(
		hrp.CFrame,
		2,
		18,
		COLORS.BrightPurple,
		0.3,
		"phantom_ring"
	)

	particles(
		hrp,
		18,
		COLORS.BrightPurple,
		"phantom_particles"
	)

	local start = os.clock()

	task.spawn(function()
		while
			velocity.Parent
			and hrp.Parent
			and humanoid.Health > 0
			and token == SESSION.CharacterToken
			and os.clock() - start < duration
		do
			local direction = hrp.CFrame.LookVector

			velocity.VectorVelocity =
				direction * speed

			task.wait()
		end
	end)

	task.delay(duration, function()
		if velocity then
			pcall(function()
				velocity:Destroy()
			end)
		end

		if attachment then
			pcall(function()
				attachment:Destroy()
			end)
		end

		if trail then
			pcall(function()
				trail.Enabled = false
				trail:Destroy()
			end)
		end

		pcall(function()
			trailA:Destroy()
			trailB:Destroy()
		end)

		if token == SESSION.CharacterToken
			and hrp.Parent
			and humanoid.Health > 0
		then
			hrp.AssemblyLinearVelocity =
				Vector3.new(
					hrp.AssemblyLinearVelocity.X * 0.2,
					hrp.AssemblyLinearVelocity.Y,
					hrp.AssemblyLinearVelocity.Z * 0.2
				)

			burst(
				hrp.CFrame,
				9,
				COLORS.BrightPurple,
				0.25,
				"phantom_end"
			)
		end
	end)

	return true
end

