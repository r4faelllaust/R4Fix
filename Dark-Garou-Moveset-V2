}

-- ================================================================
-- HOTBAR SLOT
-- ================================================================

local function findSlot(
	root,
	number
)
	if not root then
		return nil
	end

	local candidates = {
		tostring(number),
		"Slot" .. tostring(number),
		"[" .. tostring(number) .. "]",
	}

	for _, name in ipairs(
		candidates
	) do
		local slot =
			root:FindFirstChild(
				name,
				true
			)

		if slot then
			return slot
		end
	end

	return nil
end

local function setMoveName(
	number,
	name,
	tag
)
	local hotbar =
		getHotbar()

	if not hotbar then
		return
	end

	local slot =
		findSlot(
			hotbar,
			number
		)

	if not slot then
		return
	end

	local toolName =
		slot:FindFirstChild(
			"ToolName",
			true
		)

	if toolName
		and (
			toolName:IsA("TextLabel")
			or toolName:IsA("TextButton")
		)
	then
		toolName.Text =
			name
	end

	if tag then
		local reuse =
			slot:FindFirstChild(
				"Reuse",
				true
			)

		if reuse
			and (
				reuse:IsA("TextLabel")
				or reuse:IsA("TextButton")
			)
		then
			reuse.Text =
				tag

			reuse.Visible =
				true
		end
	end
end

-- ================================================================
-- ULTIMATE BAR DETECTION
-- ================================================================

local function looksLikeUltimate(
	obj
)
	local name =
		string.lower(
			obj.Name
		)

	return
		string.find(
			name,
			"ult"
		) ~= nil
		or string.find(
			name,
			"ultimate"
		) ~= nil
		or string.find(
			name,
			"awak"
		) ~= nil
		or string.find(
			name,
			"meter"
		) ~= nil
		or string.find(
			name,
			"energy"
		) ~= nil
end

-- ================================================================
-- ULTIMATE BAR STYLE
-- ================================================================

local function styleUltimateObject(
	obj
)
	if obj:IsA("Frame")
		or obj:IsA("ScrollingFrame")
		or obj:IsA("ViewportFrame")
	then
		local name =
			string.lower(
				obj.Name
			)

		if looksLikeUltimate(obj)
			or string.find(
				name,
				"bar"
			)
			or string.find(
				name,
				"fill"
			)
		then
			pcall(function()
				obj.BackgroundColor3 =
					DARK_BLUE
			end)
		end
	end

	if obj:IsA("ImageLabel")
		or obj:IsA("ImageButton")
	then
		local name =
			string.lower(
				obj.Name
			)

		if looksLikeUltimate(obj) then
			pcall(function()
				obj.ImageColor3 =
					DARK_BLUE_2
			end)
		end
	end
end

-- ================================================================
-- ULTIMATE BAR TEXT
-- ================================================================

local function styleUltimateBar()
	local gui =
		Player:FindFirstChild(
			"PlayerGui"
		)

	if not gui then
		return
	end

	local foundUltimate =
		false

	for _, obj in ipairs(
		gui:GetDescendants()
	) do
		if looksLikeUltimate(obj) then
			foundUltimate = true

			styleUltimateObject(
				obj
			)

			if obj:IsA("TextLabel")
				or obj:IsA("TextButton")
			then
				local text =
					string.lower(
						obj.Text
					)

				if string.find(
					text,
					"ult"
				)
				or string.find(
					text,
					"awak"
				)
				or string.find(
					text,
					"garou"
				)
				then
					obj.Text =
						CONFIG.ULT_NAME

					obj.TextColor3 =
						WHITE

					obj.TextStrokeColor3 =
						DARK_BLUE

					obj.TextStrokeTransparency =
						0.15
				end
			end
		end
	end

	-- Search common named ultimate containers
	for _, name in ipairs({
		"Ultimate",
		"UltimateBar",
		"Ult",
		"UltBar",
		"Awakening",
		"AwakeningBar",
		"UltimateMeter",
	}) do
		local object =
			gui:FindFirstChild(
				name,
				true
			)

		if object then
			foundUltimate = true

			styleUltimateObject(
				object
			)

			for _, descendant in ipairs(
				object:GetDescendants()
			) do
				styleUltimateObject(
					descendant
				)

				if descendant:IsA(
					"TextLabel"
				)
				or descendant:IsA(
					"TextButton"
				)
				then
					local lower =
						string.lower(
							descendant.Text
						)

					if string.find(
						lower,
						"ult"
					)
					or string.find(
						lower,
						"awak"
					)
					or string.find(
						lower,
						"garou"
					)
					then
						descendant.Text =
							CONFIG.ULT_NAME

						descendant.TextColor3 =
							WHITE

						descendant.TextStrokeColor3 =
							DARK_BLUE
					end
				end
			end
		end
	end

	return foundUltimate
end

