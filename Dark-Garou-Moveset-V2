----------------------------------------------------------------
-- CLEANUP
----------------------------------------------------------------

local function disconnectAll()
	for _, connection in ipairs(session.Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(session.Connections)
end

local function connect(signal, callback)
	local c = signal:Connect(callback)
	table.insert(session.Connections, c)
	return c
end

local function validCharacter(char)
	return char
		and char.Parent
		and char == Player.Character
end

local function getCharacter()
	local char = Player.Character

	if not char then
		return nil
	end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")

	if not hum or not root then
		return nil
	end

	return char, hum, root
end

----------------------------------------------------------------
-- VFX
----------------------------------------------------------------

local function burst(cf, size, color, duration)
	local p = Instance.new("Part")
	p.Name = "DG_Burst"
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Ball
	p.Material = Enum.Material.Neon
	p.Color = color or PURPLE
	p.Transparency = 0.12
	p.Size = Vector3.one
	p.CFrame = cf
	p.Parent = workspace

	TweenService:Create(
		p,
		TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quint),
		{
			Size = Vector3.new(size, size, size),
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(p, (duration or 0.3) + 0.1)
end

local function ring(cf, startSize, endSize, color, duration)
	local p = Instance.new("Part")
	p.Name = "DG_Ring"
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color or PURPLE
	p.Transparency = 0.15
	p.Size = Vector3.new(0.12, startSize, startSize)
	p.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = workspace

	TweenService:Create(
		p,
		TweenInfo.new(duration or 0.4, Enum.EasingStyle.Quint),
		{
			Size = Vector3.new(0.12, endSize, endSize),
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(p, (duration or 0.4) + 0.1)
end

local function particles(parent, amount, color)
	local a = Instance.new("Attachment")
	a.Parent = parent

	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.LightEmission = 0.8
	e.Color = ColorSequence.new(color or PURPLE)
	e.Lifetime = NumberRange.new(0.25, 0.7)
	e.Speed = NumberRange.new(5, 22)
	e.Drag = 4
	e.SpreadAngle = Vector2.new(360, 360)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-250, 250)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.8),
		NumberSequenceKeypoint.new(0.35, 3),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Parent = a

	e:Emit(amount or 20)
	Debris:AddItem(a, 1.2)
end

