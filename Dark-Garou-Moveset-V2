					0.65,
					"ult1_ring"
				)

				particles(
					hrp,
					70,
					COLORS.BrightPurple,
					"ult1_particles"
				)

				return
			end

			-- ULT 4
			if id == ANIM.Ult4Trigger then
				stopTrack(animationTrack)

				playAnim(
					humanoid,
					ANIM.Ult4,
					Enum.AnimationPriority.Action4,
					0.02,
