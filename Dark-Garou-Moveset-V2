local function fixCharacterTab()
	local gui = Player:FindFirstChild("PlayerGui")

	if not gui then
		return
	end

	local topbar = gui:FindFirstChild("TopbarPlus")

	if not topbar then
		return
	end

	for _, object in ipairs(
		topbar:GetDescendants()
	) do
		if object.Name == "IconButton" then
			local label = object:FindFirstChild(
				"IconLabel"
			)

			local image = object:FindFirstChild(
				"IconImage"
			)

			if label then
				local text = label.Text

				if text == "Garou"
					or text == "Hero Hunter"
					or text == "Dark Garou"
				then
					label.Text = MOVESET_NAME

					if image then
						image.Image = DECAL_ID
					end
				end
			end
		end
	end
end

