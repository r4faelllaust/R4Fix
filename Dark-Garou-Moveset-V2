-- PHANTOM ENGINE
----------------------------------------------------------------

local function stopPhantom()
	local p = session.CurrentPhantom

	if not p then
		return
	end

	p.Alive = false

	for _, object in ipairs(p.Objects) do
		pcall(function()
			object:Destroy()
		end)
	end

	session.CurrentPhantom = nil
end

local function PhantomEngine(duration, speed)
	local char, hum, root = getCharacter()

	if not char or hum.Health <= 0 then
		return
	end

	stopPhantom()

	local data = {
		Alive = true,
		Objects = {},
	}

	session.CurrentPhantom = data

	burst(root.CFrame, 8, PURPLE, 0.22)
	ring(root.CFrame, 3, 17, PURPLE2, 0.35)
	particles(root, 35, PURPLE2)

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-1.4, 0, 0)
	a0.Parent = root

	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(1.4, 0, 0)
	a1.Parent = root

	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.5
	trail.LightEmission = 1
	trail.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, WHITE),
		ColorSequenceKeypoint.new(0.3, PURPLE2),
		ColorSequenceKeypoint.new(1, DARK),
	})
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Parent = root

	table.insert(data.Objects, a0)
	table.insert(data.Objects, a1)
	table.insert(data.Objects, trail)

	local bv = Instance.new("BodyVelocity")
	bv.Name = "DarkGarouPhantomEngine"
	bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
	bv.P = 100000
	bv.Velocity = root.CFrame.LookVector * speed
	bv.Parent = root

	table.insert(data.Objects, bv)

	local bg = Instance.new("BodyGyro")
	bg.Name = "DarkGarouPhantomGyro"
	bg.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
	bg.P = 100000
	bg.D = 1000
	bg.CFrame = root.CFrame
	bg.Parent = root

	table.insert(data.Objects, bg)

	local started = os.clock()

	task.spawn(function()
		while data.Alive
			and validCharacter(char)
			and hum.Health > 0
			and os.clock() - started < duration do

			local alpha = math.clamp(
				(os.clock() - started) / duration,
				0,
				1
			)

			local direction = root.CFrame.LookVector

			local boost =
				speed
				* (
					1.1
					+ math.sin(alpha * math.pi) * 0.8
				)

			bv.Velocity = direction * boost

			bg.CFrame = CFrame.lookAt(
				root.Position,
				root.Position + direction
			)

			if math.random() < 0.35 then
				particles(root, math.random(2, 5), PURPLE)
			end

			task.wait()
		end
	end)

	for i = 1, 4 do
		task.delay((i - 1) * 0.1, function()
			if not data.Alive or not validCharacter(char) then
				return
			end

			bv.Velocity =
				root.CFrame.LookVector
				* (speed + i * 100)

			burst(
				root.CFrame * CFrame.new(0, 0, 2),
				5 + i * 2,
				i % 2 == 0 and PURPLE2 or PURPLE,
				0.18
			)

			ring(
				root.CFrame,
				2,
				8 + i * 3,
				PURPLE,
				0.25
			)
		end)
	end

	task.delay(duration, function()
		if session.CurrentPhantom ~= data then
			return
		end

		data.Alive = false

		if validCharacter(char) then
			burst(root.CFrame, 13, PURPLE2, 0.3)
			ring(root.CFrame, 4, 27, PURPLE, 0.4)
			particles(root, 40, PURPLE2)
		end

		for _, object in ipairs(data.Objects) do
			pcall(function()
				object:Destroy()
			end)
		end

		session.CurrentPhantom = nil
	end)
end

