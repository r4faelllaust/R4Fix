-- ================================================================
-- DAMAGE SOUND SYSTEM
-- ================================================================

local function setupTargetHealth(
targetCharacter,
humanoid
)
if not targetCharacter
or not humanoid
then
return
end

if targetCharacter ==
	LocalPlayer.Character
then
	return
end

if SESSION.LastHealth[targetCharacter] == nil then
	SESSION.LastHealth[targetCharacter] =
		humanoid.Health
end

track(
	humanoid.HealthChanged:Connect(
		function(newHealth)
			local oldHealth =
				SESSION.LastHealth[
					targetCharacter
				]
				or humanoid.MaxHealth

			if newHealth < oldHealth then
				local lastHit =
					targetCharacter:GetAttribute(
						"LastHit"
					)

				if lastHit ==
					LocalPlayer.Name
				then
					local now = os.clock()

					local previous =
						SESSION.HitTimes[
							targetCharacter
						]
						or 0

					if now - previous >=
						CONFIG.HIT_SOUND_COOLDOWN
					then
						playHitSound(
							targetCharacter
						)

						SESSION.HitTimes[
							targetCharacter
						] = now
					end
				end
			end

			SESSION.LastHealth[
				targetCharacter
			] = newHealth
		end
	)
)

end

local function setupDamageSounds()
local live =
workspace:FindFirstChild(
"Live"
)

if not live then
