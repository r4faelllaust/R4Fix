local function setupMovementVFX(character, humanoid, hrp, token)
	local last = 0

	table.insert(
		SESSION.CharacterConnections,
		RunService.Heartbeat:Connect(function()
			if token ~= SESSION.CharacterToken then
				return
			end

			if humanoid.Health <= 0 then
				return
			end

			if humanoid.MoveDirection.Magnitude < 0.1 then
				return
			end

			if os.clock() - last < CONFIG.MOVEMENT_VFX_COOLDOWN then
				return
			end

			if hrp.AssemblyLinearVelocity.Magnitude < 80 then
				return
			end

			last = os.clock()

			particles(
				hrp,
				1,
				PURPLE,
				"movement"
			)
		end)
	)
end

-- ================================================================
-- CHARACTER SETUP
-- ================================================================

local function setupCharacter(character)
	SESSION.CharacterToken += 1

	local token = SESSION.CharacterToken

	disconnect(SESSION.CharacterConnections)

	SESSION.Busy = {}

	local humanoid = character:WaitForChild("Humanoid", 10)
	local hrp = character:WaitForChild("HumanoidRootPart", 10)

	if not humanoid or not hrp then
		return
	end

	applyNight()

	spawnEffect(character, hrp)
	setupHandGlow(character)
	setupIdle(character, humanoid, token)
	setupMoveHandler(character, humanoid, hrp, token)
	setupMovementVFX(character, humanoid, hrp, token)

	-- UI refresh after character loads.
	task.spawn(function()
		for _ = 1, 30 do
			if token ~= SESSION.CharacterToken then
				return
			end

			fixCharacterTab()
			refreshMoves()
			refreshUltimate()

			task.wait(0.15)
		end
	end)

	-- Respawn-safe tools.
	task.delay(0.6, function()
		if token == SESSION.CharacterToken then
			setupTools()
		end
	end)

	table.insert(
		SESSION.CharacterConnections,
		humanoid.Died:Connect(function()
			SESSION.Busy = {}
		end)
	)
end

