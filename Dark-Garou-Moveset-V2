local function cleanupCharacter()
	disconnectList(
		SESSION.CharacterConnections
	)

	SESSION.Busy.Void = nil
	SESSION.LastAnimation = {}

	for _, obj in ipairs(
		workspace:GetChildren()
	) do
		if obj.Name ==
			"DarkGarou_VFX"
		then
			pcall(function()
				obj:Destroy()
			end)
		end
	end
end

local function setupCharacter(
	character
)
	SESSION.CharacterToken += 1

	local token =
		SESSION.CharacterToken

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local hrp =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not hrp
	then
		return
	end

	applyNighttime()

	spawnEffect(
		character,
		hrp
	)

	setupHandGlow(
		character
	)

	setupIdle(
		character,
		humanoid,
		token
	)

	setupMoveHandler(
		character,
		humanoid,
		hrp,
		token
	)

	track(
		SESSION.CharacterConnections,
		humanoid.Died:Connect(
			function()
				SESSION.Busy.Void = nil
			end
		)
	)

	task.spawn(function()
		for i = 1, 30 do
			if token ~= SESSION.CharacterToken then
				return
			end

			refreshMovesetUI()

			task.wait(0.15)
		end
	end)

	task.delay(
		0.5,
		function()
			if token ==
				SESSION.CharacterToken
			then
				setupTools()
			end
		end
	)
end

