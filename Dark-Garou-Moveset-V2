local function allowed(key, cooldown)
local now = os.clock()
local previous = S.LastVFX[key] or 0

if now - previous < (cooldown or CFG.VFX_COOLDOWN) then
	return false
end

S.LastVFX[key] = now
return true

end

local function burst(cf, size, color, duration, key)
if key and not allowed(key) then
return
end

local part = Instance.new("Part")
part.Name = "DarkBurst"
part.Anchored = true
part.CanCollide = false
part.CanTouch = false
part.CanQuery = false
part.CastShadow = false
part.Shape = Enum.PartType.Ball
part.Material = Enum.Material.Neon
part.Color = color or PURPLE
part.Transparency = 0.15
part.Size = Vector3.one
part.CFrame = cf
part.Parent = getVFXFolder()

TweenService:Create(
	part,
	TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quint),
	{
		Size = Vector3.new(size, size, size),
		Transparency = 1,
	}
):Play()

Debris:AddItem(part, (duration or 0.3) + 0.1)

end

local function ring(cf, startSize, endSize, color, duration, key)
if key and not allowed(key) then
return
end

local part = Instance.new("Part")
part.Name = "DarkRing"
part.Anchored = true
part.CanCollide = false
part.CanTouch = false
part.CanQuery = false
part.CastShadow = false
part.Shape = Enum.PartType.Cylinder
part.Material = Enum.Material.Neon
part.Color = color or PURPLE
part.Transparency = 0.2
part.Size = Vector3.new(0.12, startSize, startSize)
part.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
part.Parent = getVFXFolder()

TweenService:Create(
	part,
	TweenInfo.new(duration or 0.4, Enum.EasingStyle.Quint),
	{
		Size = Vector3.new(0.12, endSize, endSize),
		Transparency = 1,
	}
):Play()

Debris:AddItem(part, (duration or 0.4) + 0.1)

end

local function particles(parent, amount, color, key)
if not parent or not parent.Parent then
return
end

if key and not allowed(key) then
	return
end

local attachment = Instance.new("Attachment")
attachment.Parent = parent

local emitter = Instance.new("ParticleEmitter")
emitter.Color = ColorSequence.new(color or BRIGHT_PURPLE)
emitter.LightEmission = 0.8
emitter.Rate = 0
emitter.Lifetime = NumberRange.new(0.2, 0.55)
emitter.Speed = NumberRange.new(5, 15)
emitter.Drag = 4
emitter.SpreadAngle = Vector2.new(360, 360)

emitter.Size = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.7),
	NumberSequenceKeypoint.new(0.45, 1.5),
	NumberSequenceKeypoint.new(1, 0),
})

emitter.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.15),
	NumberSequenceKeypoint.new(1, 1),
})

emitter.Parent = attachment

pcall(function()
	emitter:Emit(amount)
end)

Debris:AddItem(attachment, 1)

end

