local function setupIdle(char, hum)
	local animator = hum:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
	end

	local oldTracks = {}

	local function idle()
		if not validCharacter(char) or hum.Health <= 0 then
			return
		end

		if hum.MoveDirection.Magnitude < 0.05
			and hum:GetState() == Enum.HumanoidStateType.Running
		then
			local root = char:FindFirstChild("HumanoidRootPart")

			if root then
				local t = os.clock()
				local pulse = math.sin(t * 2)

				root.CFrame =
					root.CFrame
					* CFrame.new(
						0,
						math.sin(t * 1.5) * 0.012,
						0
					)
					* CFrame.Angles(
						0,
						pulse * 0.003,
						0
					)
			end
		end
	end

	connect(RunService.RenderStepped, idle)
end

