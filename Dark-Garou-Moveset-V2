local function destroyToolEverywhere(name)
local backpack = Player:FindFirstChild("Backpack")

if backpack then
	for _, object in ipairs(backpack:GetChildren()) do
		if object:IsA("Tool") and object.Name == name then
			object:Destroy()
		end
	end
end

local character = Player.Character

if character then
	for _, object in ipairs(character:GetChildren()) do
		if object:IsA("Tool") and object.Name == name then
			object:Destroy()
		end
	end
end

end

local function createRunTool()
destroyToolEverywhere("Dark Garou Run")

local backpack = Player:WaitForChild("Backpack")

local tool = Instance.new("Tool")
tool.Name = "Dark Garou Run"
tool.RequiresHandle = false
tool.CanBeDropped = false
tool.ToolTip = "PHANTOM RUN"
tool.Parent = backpack

local running = false
local animationTrack

tool.Equipped:Connect(function()
	local character, humanoid, hrp = getCharacter()

	if not character or not humanoid or not hrp then
		return
	end

	running = true

	animationTrack = playAnimation(
		humanoid,
		"rbxassetid://18897115785",
		Enum.AnimationPriority.Action,
		1
	)

	while running and tool.Parent and humanoid.Health > 0 do
		local direction = hrp.CFrame.LookVector

		hrp.AssemblyLinearVelocity = Vector3.new(
			direction.X * CFG.RUN_SPEED,
			hrp.AssemblyLinearVelocity.Y,
			direction.Z * CFG.RUN_SPEED
		)

		task.wait()
	end
end)

local function stop()
	running = false

	if animationTrack then
		pcall(function()
			animationTrack:Stop(0.1)
		end)
		animationTrack = nil
	end
end

tool.Unequipped:Connect(stop)
tool.AncestryChanged:Connect(function(_, parent)
	if not parent then
		stop()
	end
end)

end

local function createTeleportTool()
destroyToolEverywhere("Dark Garou Teleport")

local backpack = Player:WaitForChild("Backpack")

local tool = Instance.new("Tool")
tool.Name = "Dark Garou Teleport"
tool.RequiresHandle = false
tool.CanBeDropped = false
tool.ToolTip = "VOID STEP"
tool.Parent = backpack

tool.Activated:Connect(function()
	local character, humanoid, hrp = getCharacter()

	if not character or not humanoid or not hrp then
		return
	end

	local mouse = Player:GetMouse()

	if not mouse or not mouse.Hit then
		return
	end

	local destination = mouse.Hit.Position
	local old = hrp.CFrame

	burst(old, 7, PURPLE, 0.2, "tp_depart")
	particles(hrp, 15, BRIGHT_PURPLE, "tp_depart_particles")

	task.wait(0.04)

	local _, newHumanoid, newHRP = getCharacter()

	if not newHumanoid or not newHRP or newHumanoid.Health <= 0 then
		return
	end

	local _, y, _ = old:ToOrientation()

	newHRP.CFrame =
		CFrame.new(destination)
		* CFrame.Angles(0, y, 0)

	burst(newHRP.CFrame, 9, BRIGHT_PURPLE, 0.3, "tp_arrive")
	ring(newHRP.CFrame, 2, 16, PURPLE, 0.35, "tp_arrive_ring")
	particles(newHRP, 20, BRIGHT_PURPLE, "tp_arrive_particles")
end)

end

local function setupTools()
destroyToolEverywhere("Dark Garou Run")
destroyToolEverywhere("Dark Garou Teleport")

task.wait(0.1)

if not Player:FindFirstChild("Backpack") then
	return
end

createRunTool()
createTeleportTool()

end

-- ============================================================
-- HIT SOUNDS
-- ============================================================

local lastHitTime = {}
local lastHealth = {}
local hitConnections = {}

local function setupTarget(target)
if not target:IsA("Model") then
return
end

local humanoid = target:FindFirstChildOfClass("Humanoid")

if not humanoid then
	return
end

if hitConnections[target] then
	return
end

lastHealth[target] = humanoid.Health

local connection = humanoid.HealthChanged:Connect(function(newHealth)
	local oldHealth = lastHealth[target] or humanoid.MaxHealth

	if newHealth < oldHealth then
		if target:GetAttribute("LastHit") == Player.Name then
			local now = os.clock()
			local previous = lastHitTime[target] or 0

			if now - previous >= CFG.HIT_SOUND_COOLDOWN then
				playSound(
					target:FindFirstChild("HumanoidRootPart"),
					1,
					1
				)

				lastHitTime[target] = now
			end
		end
	end

	lastHealth[target] = newHealth
end)

hitConnections[target] = connection

end

local function setupHitSounds()
local live = workspace:FindFirstChild("Live")

if not live then
	return
end

for _, object in ipairs(live:GetChildren()) do
	setupTarget(object)
end

table.insert(
	S.Connections,
	live.ChildAdded:Connect(function(object)
		task.defer(function()
			setupTarget(object)
		end)
	end)
)

end

-- ============================================================
-- MOVE HANDLER
-- ============================================================

local function setupMoveHandler(character, humanoid, hrp, token)
addConnection(
humanoid.AnimationPlayed:Connect(function(track)
if token ~= S.Token then
return
end

		if not track.Animation then
			return
		end

		local id = track.Animation.AnimationId

		if id == MOVE1_TRIGGER then
			pcall(function()
				track:Stop()
			end)

			instantKillMove(token)
			return
		end

		if id == MOVE2_TRIGGER then
			pcall(function()
				track:Stop()
			end)

			move2(token)
			return
		end

		if id == MOVE3_TRIGGER then
			pcall(function()
				track:Stop()
			end)

			move3()
			return
		end

		if id == MOVE4_TRIGGER then
			pcall(function()
				track:Stop()
			end)

			move4()
			return
		end

		if id == SPECIAL_TRIGGER then
			pcall(function()
				track:Stop()
			end)

			playAnimation(
				humanoid,
				SPECIAL_ANIMATION,
				Enum.AnimationPriority.Action4,
				1,
				0.9
			)

			return
		end

		for index, data in ipairs(ULT_MOVES) do
			if id == data.Trigger then
				pcall(function()
					track:Stop()
				end)

				playUlt(index)
				return
			end
		end
	end)
)

end

