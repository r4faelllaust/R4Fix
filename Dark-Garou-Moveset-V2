local function findUltimateGui()
	local gui = Player:FindFirstChild("PlayerGui")

	if not gui then
		return nil
	end

	-- Search common locations.
	for _, name in ipairs({
		"Bar",
		"ScreenGui",
		"Ultimate",
		"Ult",
	}) do
		local object = gui:FindFirstChild(name)

		if object then
			local magic = object:FindFirstChild(
				"MagicHealth",
				true
			)

			if magic then
				return magic
			end
		end
	end

	local magic =
		findFirstDescendant(
			gui,
			"MagicHealth"
		)

	return magic
end

local function styleImage(
	object,
	imageId,
	color
)
	if not object then
		return
	end

	if object:IsA("ImageLabel")
		or object:IsA("ImageButton")
	then
		if imageId then
			object.Image = imageId
		end

		if color then
			object.ImageColor3 = color
		end
	end
end

local function styleUltimateBar()
	local magic = findUltimateGui()

	if not magic then
		return
	end

	-- Text
	local textLabel =
		magic:FindFirstChild(
			"TextLabel"
		)

	if textLabel
		and textLabel:IsA("TextLabel")
	then
		textLabel.Text =
			"VOID ASCENSION"

		textLabel.TextColor3 =
			WHITE

		textLabel.TextStrokeTransparency =
			0.25

		textLabel.Font =
			Enum.Font.GothamBlack

		textLabel.TextSize = 24
	end

	local nestedText =
		textLabel
		and textLabel:FindFirstChild(
			"TextLabel"
		)

	if nestedText
		and nestedText:IsA("TextLabel")
	then
		nestedText.Text =
			"VOID ASCENSION"

		nestedText.TextColor3 =
			WHITE

		nestedText.Font =
			Enum.Font.GothamBlack

		nestedText.TextSize = 24
	end

	-- Health bar
	local health =
		magic:FindFirstChild(
			"Health"
		)

	if health then
		local bar =
			health:FindFirstChild(
				"Bar"
			)

		if bar then
			local fill =
				bar:FindFirstChild(
					"Bar"
				)

			if fill then
				styleImage(
					fill,
					nil,
					ULT_BLUE
				)

				-- Avoid an infinite tween.
				local oldTween =
					SESSION.UltTween

				if oldTween then
					pcall(function()
						oldTween:Cancel()
					end)
				end

				if fill:IsA("ImageLabel")
					or fill:IsA("ImageButton")
				then
					SESSION.UltTween =
						TweenService:Create(
							fill,
							TweenInfo.new(
								1.8,
								Enum.EasingStyle.Sine,
								Enum.EasingDirection.InOut,
								-1,
								true
							),
							{
								ImageColor3 =
									ULT_BLUE_BRIGHT
							}
						)

					SESSION.UltTween:Play()
				end
			end

			local glow =
				health:FindFirstChild(
					"Glow"
				)

			if glow then
				styleImage(
					glow,
					nil,
					ULT_BLUE_BRIGHT
				)
			end
		end
	end

	-- Any text associated with ultimate.
	for _, object in ipairs(
		magic:GetDescendants()
	) do
		if object:IsA("TextLabel")
			or object:IsA("TextButton")
		then
			local lower =
				string.lower(
					object.Text
				)

			if string.find(lower, "ult")
				or string.find(lower, "awak")
				or string.find(lower, "magic")
				or string.find(lower, "testing")
			then
				object.Text =
					"VOID ASCENSION"

				object.Font =
					Enum.Font.GothamBlack

				object.TextColor3 =
					WHITE
			end
		end
	end
end

