-- ================================================================

local function setupHitSounds()
	local live = workspace:FindFirstChild("Live")

	if not live then
		return
	end

	local function connectTarget(model)
		if not model:IsA("Model") then
			return
		end

		local humanoid =
			model:FindFirstChildOfClass(
				"Humanoid"
			)

		if not humanoid then
			return
		end

		if model == Player.Character then
			return
		end

		local previous =
			humanoid.Health

		trackCharacter(
			humanoid.HealthChanged:Connect(
				function(newHealth)
					if newHealth < previous then
						local last =
							SESSION.LastHitSound[model]
							or 0

						if os.clock() - last
							>= CONFIG.HIT_SOUND_COOLDOWN
						then
							local lastHit =
								model:GetAttribute(
									"LastHit"
								)

							if lastHit
								== Player.Name
							then
								local root =
									model:FindFirstChild(
										"HumanoidRootPart"
									)

								if root then
									playSound(
										root,
										1,
										1
									)

									SESSION.LastHitSound[
										model
									] = os.clock()
								end
							end
						end
					end

					previous = newHealth
				end
			)
		)
	end

	for _, child in ipairs(
		live:GetChildren()
	) do
		connectTarget(child)
	end

	trackCharacter(
		live.ChildAdded:Connect(
			function(child)
				task.defer(function()
					connectTarget(child)
				end)
			end
		)
	)
end

-- ================================================================
-- MOVE HANDLER
-- ================================================================

local function setupMoveHandler(
	character,
	humanoid,
	hrp,
	token
)
	trackCharacter(
		humanoid.AnimationPlayed:Connect(
			function(animationTrack)
				if token ~= SESSION.CharacterToken then
					return
				end

				if not animationTrack
					or not animationTrack.Animation
				then
					return
				end

				local id =
					animationTrack.Animation.AnimationId

				-- M1 chain.
				local replacement =
					M1_CHAIN[id]
					or DOWNSLAM[id]

				if replacement then
					stopTrack(
						animationTrack,
						0.025
					)

					playAnimation(
						humanoid,
						replacement,
						Enum.AnimationPriority.Action
					)

					return
				end

				-- MOVE 1
				if id == SLOT1_ID then
					stopTrack(
						animationTrack,
						0.025
					)

					playAnimation(
						humanoid,
						MOVE1_ANIMATION,
						Enum.AnimationPriority.Action,
						1,
						0.03
					)

					phantomEngine(
						0.8,
						CONFIG.PHANTOM_SPEED,
						token
					)

					burst(
						hrp.CFrame,
						8,
						PURPLE,
						0.25,
						"m1_start"
					)

					particles(
						hrp,
						30,
						PURPLE_BRIGHT,
						"m1_particles"
					)

					executeVoidKill(
						character,
						humanoid,
						hrp,
						token
					)

					return
				end

				-- MOVE 2
				if id == SLOT2_ID then
					stopTrack(
						animationTrack,
						0.025
					)

					executeMove2(
						humanoid,
						hrp,
						token
					)

					return
				end

				-- MOVE 3
				-- NO PHANTOM ENGINE.
				if id == SLOT3_ID then
					stopTrack(
						animationTrack,
						0.025
					)

					local state =
						humanoid:GetState()

					local airborne =
						state
						== Enum.HumanoidStateType.Jumping
						or state
						== Enum.HumanoidStateType.Freefall

					local animation =
						airborne
						and MOVE3_AIR
						or MOVE3_GROUND

					local track =
						playAnimation(
							humanoid,
							animation,
							Enum.AnimationPriority.Action,
							1,
							0.035
						)

					burst(
						hrp.CFrame,
						11,
						PURPLE_DARK,
						0.3,
						"m3"
					)

					shockwave(
						hrp.CFrame,
						3,
						28,
						PURPLE_BRIGHT,
						0.5,
						"m3_ring"
					)

					particles(
						hrp,
						38,
						PURPLE_BRIGHT,
						"m3_particles"
					)

					task.delay(
						CONFIG.MOVE3_DURATION,
						function()
							stopTrack(
								track,
								0.05
							)
						end
					)

					return
				end

				-- MOVE 4
				if id == SLOT4_ID then
					stopTrack(
						animationTrack,
						0.025
					)

					local track =
						playAnimation(
							humanoid,
							MOVE4_ANIMATION,
							Enum.AnimationPriority.Action,
							1,
							0.04
						)

					burst(
						hrp.CFrame,
						14,
						PURPLE_DARK,
						0.35,
						"m4"
					)

					shockwave(
						hrp.CFrame,
						4,
						40,
						PURPLE_BRIGHT,
						0.55,
						"m4_ring"
					)

					particles(
						hrp,
						50,
						PURPLE_BRIGHT,
						"m4_particles"
					)

					playSound(
						hrp,
						1.8,
						0.72
					)

					task.delay(
						CONFIG.MOVE4_DURATION,
						function()
							stopTrack(
								track,
								0.06
							)
						end
					)

					return
				end

				-- SPECIAL
				if id == SPECIAL_ID then
					stopTrack(
						animationTrack,
						0.025
					)

					playAnimation(
						humanoid,
						"rbxassetid://15290930205",
						Enum.AnimationPriority.Action,
						1,
						0.04
					)

					return
				end

				-- ULT 1
				if id == ULT_TRIGGER_1 then
					stopTrack(
						animationTrack,
						0.025
					)

					playUltimate1(
						humanoid,
						hrp
					)

					return
				end

				-- ULT 2
				if id == ULT_TRIGGER_2 then
					stopTrack(
						animationTrack,
						0.025
					)

					playUltimate2(
						humanoid,
						hrp
					)

					return
				end
			end
		)
	)
end

