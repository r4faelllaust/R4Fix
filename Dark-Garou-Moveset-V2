-- ================================================================
-- CLEANUP
-- ================================================================

local function disconnectList(list)
	for _, connection in ipairs(list) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(list)
end

local function cleanupCharacter()
	disconnectList(SESSION.CharacterConnections)

	for _, obj in ipairs(workspace:GetChildren()) do
		if obj.Name == "DarkGarou_VFX" then
			pcall(function()
				obj:Destroy()
			end)
		end
	end
end

local function track(connection)
	if connection then
		table.insert(SESSION.CharacterConnections, connection)
	end

	return connection
end

-- ================================================================
-- CHARACTER HELPERS
-- ================================================================

local function getCharacter()
	local character = Player.Character
	if not character then
		return nil, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not hrp then
		return nil, nil, nil
	end

	return character, humanoid, hrp
end

local function getAnimator(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

local function loadAnimation(humanoid, id, priority)
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	local animator = getAnimator(humanoid)

	local animation = Instance.new("Animation")
	animation.AnimationId = id

	local success, trackResult = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	animation:Destroy()

	if not success or not trackResult then
		return nil
	end

	if priority then
		trackResult.Priority = priority
	end

	return trackResult
end

local function playAnimation(humanoid, id, priority)
	local animationTrack = loadAnimation(humanoid, id, priority)

	if animationTrack then
		pcall(function()
			animationTrack:Play(0.05, 1, 1)
		end)
	end

	return animationTrack
end

-- ================================================================
-- VFX FOLDER
-- ================================================================

local function getVFXFolder()
	local folder = workspace:FindFirstChild("DarkGarou_VFX")

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "DarkGarou_VFX"
		folder.Parent = workspace
	end

	return folder
end

local function vfxAllowed(key, cooldown)
	local now = os.clock()
	local previous = SESSION.LastVFX[key] or 0

	if now - previous < cooldown then
		return false
	end

	SESSION.LastVFX[key] = now

	return true
end

-- ================================================================
-- SOUND
-- ================================================================

local function playSound(parent, ids, volume, playback)
	if not parent or not parent.Parent then
		return
	end

	if not ids or #ids == 0 then
		return
	end

	local sound = Instance.new("Sound")
	sound.Name = "DarkGarou_SFX"
	sound.SoundId = ids[math.random(1, #ids)]
	sound.Volume = volume or 1
	sound.PlaybackSpeed = playback or 1
	sound.RollOffMaxDistance = 100
	sound.RollOffMinDistance = 5
	sound.Parent = parent

	pcall(function()
		sound:Play()
	end)

	Debris:AddItem(sound, 5)
end

-- ================================================================
-- BURST
-- ================================================================

local function spawnBurst(cframe, size, color, duration, key)
	if key and not vfxAllowed(
		key,
		CONFIG.VFX_GLOBAL_COOLDOWN
	) then
		return
	end

	local part = Instance.new("Part")
	part.Name = "Burst"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = color or VOID_PURPLE
	part.Transparency = 0.15
	part.Size = Vector3.one
	part.CFrame = cframe
	part.Parent = getVFXFolder()

	local tween = TweenService:Create(
		part,
		TweenInfo.new(
			duration or 0.3,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(size, size, size),
			Transparency = 1,
		}
	)

	tween:Play()

	Debris:AddItem(
		part,
		(duration or 0.3) + 0.1
	)
end

