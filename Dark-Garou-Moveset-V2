-- ================================================================
-- BURST
-- ================================================================

local function burst(
	cframe,
	size,
	color,
	duration,
	key
)
	if key
		and not vfxAllowed(
			key,
			CONFIG.VFX_COOLDOWN
		)
	then
		return
	end

	local part =
		Instance.new("Part")

	part.Name =
		"DarkBurst"

	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false

	part.Shape =
		Enum.PartType.Ball

	part.Material =
		Enum.Material.Neon

	part.Color =
		color or PURPLE

	part.Transparency = 0.15

	part.Size =
		Vector3.one

	part.CFrame =
		cframe

	part.Parent =
		getVFXFolder()

	TweenService:Create(
		part,
		TweenInfo.new(
			duration or 0.3,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size =
				Vector3.new(
					size,
					size,
					size
				),

			Transparency = 1,
		}
	):Play()

	Debris:AddItem(
		part,
		(duration or 0.3) + 0.1
	)
end

