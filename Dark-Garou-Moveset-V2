-- ================================================================
-- PHANTOM ENGINE
-- ================================================================

local function PhantomEngine(
	duration,
	speed,
	token
)
	local character,
		humanoid,
		hrp =
		getCharacter()

	if not character
		or not humanoid
		or not hrp
		or humanoid.Health <= 0
	then
		return false
	end

	if token
		and token ~= SESSION.CharacterToken
	then
		return false
	end

	local velocity =
		Instance.new("BodyVelocity")

	velocity.Name =
		"DarkGarou_PhantomEngine"

	velocity.MaxForce =
		Vector3.new(
			5000000,
			5000000,
			5000000
		)

	velocity.P =
		50000

	velocity.Velocity =
		hrp.CFrame.LookVector
		* speed

	velocity.Parent =
		hrp

	local gyro =
		Instance.new("BodyGyro")

	gyro.Name =
		"DarkGarou_PhantomGyro"

	gyro.MaxTorque =
		Vector3.new(
			1000000,
			1000000,
			1000000
		)

	gyro.P =
		50000

	gyro.D =
		1000

	gyro.CFrame =
		hrp.CFrame

	gyro.Parent =
		hrp

	burst(
		hrp.CFrame,
		8,
		PURPLE,
		0.22,
		"engine_start"
	)

	ring(
		hrp.CFrame,
		3,
		18,
		PURPLE_2,
		0.32,
		"engine_ring"
	)

	particles(
		hrp,
		22,
		PURPLE_2,
		"engine_particles"
	)

	playSound(
		hrp,
		SOUND.Phantom,
		1.25,
		0.9
	)

	local start =
		os.clock()

	local active = true

	task.spawn(function()
		while active
			and hrp.Parent
			and humanoid.Health > 0
			and os.clock() - start < duration
		do
			if token
				and token ~= SESSION.CharacterToken
			then
				break
			end

			local direction =
				hrp.CFrame.LookVector

			local alpha =
				math.clamp(
					(os.clock() - start)
						/ duration,
					0,
					1
				)

			local multiplier =
				1.05
				+ math.sin(
					alpha * math.pi
				) * 0.65

			velocity.Velocity =
				direction
				* speed
				* multiplier

			gyro.CFrame =
				CFrame.lookAt(
					hrp.Position,
					hrp.Position
						+ direction
				)

			task.wait()
		end
	end)

	task.delay(
		duration,
		function()
			active = false

			pcall(function()
				velocity:Destroy()
			end)

			pcall(function()
				gyro:Destroy()
			end)

			if hrp.Parent then
				burst(
					hrp.CFrame,
					10,
					PURPLE_2,
					0.25,
					"engine_end"
				)
			end
		end
	)

	return true
end

