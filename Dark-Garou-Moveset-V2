-- ================================================================
-- AFTERIMAGE
-- ================================================================

local function afterimage(character)
	if not character or not character.Parent then
		return
	end

	local clone

	pcall(function()
		clone = character:Clone()
	end)

	if not clone then
		return
	end

	for _, obj in ipairs(clone:GetDescendants()) do
		if obj:IsA("Script")
			or obj:IsA("LocalScript")
			or obj:IsA("ModuleScript")
			or obj:IsA("Humanoid")
			or obj:IsA("Tool")
		then
			obj:Destroy()

		elseif obj:IsA("BasePart") then
			obj.Anchored = true
			obj.CanCollide = false
			obj.CanTouch = false
			obj.CanQuery = false
			obj.CastShadow = false
			obj.Material = Enum.Material.Neon
			obj.Color = PURPLE
			obj.Transparency = 0.62

		elseif obj:IsA("Decal") then
			obj.Transparency = 1

		elseif obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam")
		then
			obj.Enabled = false
		end
	end

	clone.Name = "DarkGarou_Afterimage"
	clone.Parent = getVFXFolder()

	task.spawn(function()
		for _ = 1, 8 do
			if not clone.Parent then
				return
			end

			for _, obj in ipairs(clone:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.Transparency = math.clamp(obj.Transparency + 0.045, 0, 1)
				end
			end

			task.wait(0.025)
		end

		if clone.Parent then
			clone:Destroy()
		end
	end)

	Debris:AddItem(clone, 1)
end

-- ================================================================
-- PHANTOM ENGINE
-- ================================================================

local function PhantomEngine(duration, speed, token)
	local character, humanoid, hrp = getCharacter()

	if not character
		or not humanoid
		or not hrp
		or humanoid.Health <= 0
	then
		return false
	end

	if token ~= SESSION.CharacterToken then
		return false
	end

	-- Remove ONLY previous Phantom Engine objects.
	for _, obj in ipairs(hrp:GetChildren()) do
		if obj.Name == "DarkGarou_PhantomVelocity"
			or obj.Name == "DarkGarou_PhantomGyro"
		then
			obj:Destroy()
		end
	end

	local velocity = Instance.new("BodyVelocity")
	velocity.Name = "DarkGarou_PhantomVelocity"
	velocity.MaxForce = Vector3.new(
		CONFIG.PHANTOM_MAX_FORCE,
		CONFIG.PHANTOM_MAX_FORCE,
		CONFIG.PHANTOM_MAX_FORCE
	)
	velocity.P = 60000
	velocity.Velocity = hrp.CFrame.LookVector * speed
	velocity.Parent = hrp

	local gyro = Instance.new("BodyGyro")
	gyro.Name = "DarkGarou_PhantomGyro"
	gyro.MaxTorque = Vector3.new(1000000, 1000000, 1000000)
	gyro.P = 60000
	gyro.D = 1200
	gyro.CFrame = hrp.CFrame
	gyro.Parent = hrp

	burst(hrp.CFrame, 8, PURPLE, 0.22, "engine_start")
	shockwave(hrp.CFrame, 3, 17, BRIGHT_PURPLE, 0.3, "engine_ring")
	particles(hrp, 20, BRIGHT_PURPLE, "engine_particles")
	playSound(hrp, SOUND.Phantom, 1.3, 0.9)

	local start = os.clock()
	local alive = true

	task.spawn(function()
		while alive
			and velocity.Parent
			and gyro.Parent
			and hrp.Parent
			and humanoid.Health > 0
			and token == SESSION.CharacterToken
		do
			local elapsed = os.clock() - start

			if elapsed >= duration then
				break
			end

			local alpha = math.clamp(elapsed / duration, 0, 1)
			local direction = hrp.CFrame.LookVector

			local boost =
				speed
				* (
					1.0
					+ math.sin(alpha * math.pi) * 0.65
				)

			velocity.Velocity = direction * boost
			gyro.CFrame = CFrame.lookAt(
				hrp.Position,
				hrp.Position + direction
			)

			task.wait(0.015)
		end

		alive = false

		if velocity.Parent then
			velocity:Destroy()
		end

		if gyro.Parent then
			gyro:Destroy()
		end
	end)

	task.spawn(function()
		for i = 1, CONFIG.PHANTOM_PULSES do
			if not alive or token ~= SESSION.CharacterToken then
				break
			end

			if not hrp.Parent then
				break
			end

			velocity.Velocity =
				hrp.CFrame.LookVector
				* (speed + i * 70)

			burst(
				hrp.CFrame * CFrame.new(0, 0, 1),
				4 + i,
				i % 2 == 0 and BRIGHT_PURPLE or PURPLE,
				0.15,
				"engine_pulse_" .. i
			)

			afterimage(character)

			task.wait(CONFIG.PHANTOM_PULSE_DELAY)
		end
	end)

	task.delay(duration, function()
		if hrp.Parent and token == SESSION.CharacterToken then
			burst(hrp.CFrame, 11, BRIGHT_PURPLE, 0.28, "engine_end")
			shockwave(hrp.CFrame, 4, 24, PURPLE, 0.4, "engine_end_ring")
		end
	end)

	return true
end

