local function createRunTool()
	destroyToolEverywhere("Dark Garou Run")

	local backpack = Player:WaitForChild("Backpack")

	local tool = Instance.new("Tool")
	tool.Name = "Dark Garou Run"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Phantom Run"
	tool.Parent = backpack

	local running = false
	local track

	local function stop()
		running = false

		if track then
			pcall(function()
				track:Stop(0.12)
				track:Destroy()
			end)

			track = nil
		end
	end

	tool.Equipped:Connect(function()
		if running then
			return
		end

		local character, humanoid, hrp = getCharacter()

		if not character or not humanoid or not hrp then
			return
		end

		running = true

		track = playAnimation(
			humanoid,
			"rbxassetid://18897115785",
			Enum.AnimationPriority.Action
		)

		burst(hrp.CFrame, 6, PURPLE, 0.2, "run_start")

		task.spawn(function()
			while running
				and tool.Parent
				and humanoid.Health > 0
				and character.Parent
			do
				local direction = humanoid.MoveDirection

				if direction.Magnitude < 0.05 then
					direction = hrp.CFrame.LookVector
				else
					direction = direction.Unit
				end

				hrp.AssemblyLinearVelocity = Vector3.new(
					direction.X * CONFIG.RUN_SPEED,
					hrp.AssemblyLinearVelocity.Y,
					direction.Z * CONFIG.RUN_SPEED
				)

				task.wait()
			end
		end)
	end)

	tool.Unequipped:Connect(stop)

	tool.AncestryChanged:Connect(function(_, parent)
		if not parent then
			stop()
		end
	end)
end

