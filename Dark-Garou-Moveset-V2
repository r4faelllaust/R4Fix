local function phantomEngine(duration, speed, token)
local character, humanoid, hrp = getCharacter()

if not character or not humanoid or not hrp then
	return false
end

if humanoid.Health <= 0 or token ~= S.Token then
	return false
end

local velocity = Instance.new("BodyVelocity")
velocity.Name = "DarkGarou_PhantomEngine"
velocity.MaxForce = Vector3.new(5000000, 0, 5000000)
velocity.P = 50000
velocity.Parent = hrp

local trail0 = Instance.new("Attachment")
trail0.Position = Vector3.new(-1, 0, 0)
trail0.Parent = hrp

local trail1 = Instance.new("Attachment")
trail1.Position = Vector3.new(1, 0, 0)
trail1.Parent = hrp

local trail = Instance.new("Trail")
trail.Attachment0 = trail0
trail.Attachment1 = trail1
trail.Lifetime = 0.28
trail.LightEmission = 1
trail.Color = ColorSequence.new(WHITE, BRIGHT_PURPLE)
trail.Transparency = NumberSequence.new(0.1, 1)
trail.Parent = hrp

local start = os.clock()

burst(hrp.CFrame, 7, PURPLE, 0.2, "phantom_start")
ring(hrp.CFrame, 2, 16, BRIGHT_PURPLE, 0.3, "phantom_ring")

while os.clock() - start < duration do
	if token ~= S.Token or not hrp.Parent or humanoid.Health <= 0 then
		break
	end

	local direction = hrp.CFrame.LookVector

	velocity.Velocity = Vector3.new(
		direction.X * speed,
		0,
		direction.Z * speed
	)

	task.wait()
end

pcall(function()
	velocity:Destroy()
end)

pcall(function()
	trail:Destroy()
	trail0:Destroy()
	trail1:Destroy()
end)

if hrp.Parent then
	burst(hrp.CFrame, 9, BRIGHT_PURPLE, 0.25, "phantom_end")
end

return true

end

-- ============================================================
-- MOVE 1 INSTANT KILL
-- ============================================================

local function instantKillMove(token)
if S.Busy.InstantKill then
return
end

local character, humanoid, hrp = getCharacter()

if not character or not humanoid or not hrp then
	return
end

S.Busy.InstantKill = true

local original = hrp.CFrame

playAnimation(
	humanoid,
	MOVE1_TRIGGER,
	Enum.AnimationPriority.Action4,
	1,
	0.75
)

phantomEngine(0.55, CFG.PHANTOM_SPEED, token)

task.delay(CFG.MOVE1_DELAY, function()
	if token ~= S.Token then
		S.Busy.InstantKill = nil
		return
	end

	if not hrp.Parent or humanoid.Health <= 0 then
		S.Busy.InstantKill = nil
		return
	end

	local flat = Vector3.new(
		hrp.CFrame.LookVector.X,
		0,
		hrp.CFrame.LookVector.Z
	)

	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end

	flat = flat.Unit

	local destination =
		hrp.Position
		+ flat * CFG.MOVE1_DISTANCE

	destination = Vector3.new(
		destination.X,
		hrp.Position.Y,
		destination.Z
	)

	local destinationCF = CFrame.lookAt(
		destination,
		destination + flat
	)

	hrp.CFrame = destinationCF
	hrp.AssemblyLinearVelocity = Vector3.zero

	burst(destinationCF, 16, Color3.fromRGB(4, 3, 8), 0.4, "kill_arrive")
	burst(destinationCF, 9, BRIGHT_PURPLE, 0.25, "kill_core")
	ring(destinationCF, 4, 35, PURPLE, 0.45, "kill_ring")
	particles(hrp, 45, BRIGHT_PURPLE, "kill_particles")
	playSound(hrp, 1.7, 0.72)

	task.delay(CFG.MOVE1_VOID_TIME, function()
		if token ~= S.Token then
			S.Busy.InstantKill = nil
			return
		end

		if hrp.Parent and humanoid.Health > 0 then
			burst(hrp.CFrame, 14, BRIGHT_PURPLE, 0.3, "kill_return")
			ring(hrp.CFrame, 3, 28, BRIGHT_PURPLE, 0.4, "kill_return_ring")

			hrp.CFrame = original
			hrp.AssemblyLinearVelocity = Vector3.zero

			burst(original, 13, BRIGHT_PURPLE, 0.3, "kill_reappear")
		end

		S.Busy.InstantKill = nil
	end)
end)

end

