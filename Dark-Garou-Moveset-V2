	ring.CanTouch = false
	ring.CanQuery = false
	ring.CastShadow = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = color or VOID_PURPLE
	ring.Transparency = 0.2

	ring.Size = Vector3.new(
		0.12,
		startSize,
		startSize
	)

	ring.CFrame =
		cframe
		* CFrame.Angles(
			0,
			0,
			math.rad(90)
		)

