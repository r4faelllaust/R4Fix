	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "DarkGarou_VFX"
		folder.Parent = workspace
	end

	return folder
end

local function vfxAllowed(
	key,
	cooldown
)
	local now = os.clock()

	local previous =
		SESSION.VFX[key] or 0

	if now - previous < cooldown then
		return false
	end

	SESSION.VFX[key] = now

	return true
end

