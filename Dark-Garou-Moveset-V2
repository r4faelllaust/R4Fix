local function styleUltimateBar()
local gui = Player:FindFirstChild("PlayerGui")

if not gui then
	return
end

local bar = gui:FindFirstChild("Bar")

if not bar then
	return
end

local magicHealth = bar:FindFirstChild("MagicHealth")

if not magicHealth then
	return
end

local textLabel = magicHealth:FindFirstChild("TextLabel")

if textLabel and textLabel:IsA("TextLabel") then
	textLabel.Text = "DARK GAROU"
	textLabel.TextColor3 = ULT_TEXT
	textLabel.TextSize = 26
end

local nestedText = textLabel and textLabel:FindFirstChild("TextLabel")

if nestedText and nestedText:IsA("TextLabel") then
	nestedText.Text = "DARK GAROU"
	nestedText.TextColor3 = ULT_TEXT
	nestedText.TextSize = 26
end

local health = magicHealth:FindFirstChild("Health")

if not health then
	return
end

local barHolder = health:FindFirstChild("Bar")

if not barHolder then
	return
end

local fill = barHolder:FindFirstChild("Bar")

if fill then
	if fill:IsA("ImageLabel") or fill:IsA("ImageButton") then
		fill.ImageColor3 = ULT_BLUE_BRIGHT
		fill.ImageTransparency = 0
	elseif fill:IsA("Frame") then
		fill.BackgroundColor3 = ULT_BLUE_BRIGHT
		fill.BackgroundTransparency = 0
	end

	local gradient = fill:FindFirstChildOfClass("UIGradient")

	if gradient then
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, ULT_BLUE_BRIGHT),
			ColorSequenceKeypoint.new(0.5, ULT_BLUE),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(7, 15, 45)),
		})
	end
end

local glow = health:FindFirstChild("Glow")

if glow and (glow:IsA("ImageLabel") or glow:IsA("ImageButton")) then
	glow.ImageColor3 = ULT_BLUE_BRIGHT
	glow.ImageTransparency = 0.2
end

end

