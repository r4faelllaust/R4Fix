-- ================================================================
-- MOVE 1 INSTANT-KILL / VOID
-- ================================================================

local function executeVoidKill(character, humanoid, hrp, token)
	if SESSION.Busy.Void then
		return
	end

	SESSION.Busy.Void = true

	local originalCFrame = hrp.CFrame

	task.delay(CONFIG.VOID_DELAY, function()
		if token ~= SESSION.CharacterToken then
			SESSION.Busy.Void = nil
			return
		end

		if not character.Parent
			or humanoid.Health <= 0
			or not hrp.Parent
		then
			SESSION.Busy.Void = nil
			return
		end

		local forward = Vector3.new(
			hrp.CFrame.LookVector.X,
			0,
			hrp.CFrame.LookVector.Z
		)

		if forward.Magnitude < 0.01 then
			forward = Vector3.new(0, 0, -1)
		else
			forward = forward.Unit
		end

		local destination =
			hrp.Position
			+ forward * (
				CONFIG.VOID_HORIZONTAL_DISTANCE
				+ CONFIG.VOID_FORWARD_DISTANCE
			)

		destination = Vector3.new(
			destination.X,
			hrp.Position.Y,
			destination.Z
		)

		local voidCFrame =
			CFrame.lookAt(
				destination,
				destination + forward
			)

		local platform = Instance.new("Part")
		platform.Name = "DarkGarouVoidPlatform"
		platform.Anchored = true
		platform.CanCollide = true
		platform.CanTouch = false
		platform.CanQuery = false
		platform.Transparency = 1
		platform.Size = Vector3.new(80, 2, 80)
		platform.CFrame = voidCFrame * CFrame.new(0, -3, 0)
		platform.Parent = getVFXFolder()

		Debris:AddItem(
			platform,
			CONFIG.VOID_STAY_TIME + 0.5
		)

		hrp.CFrame = voidCFrame
		hrp.AssemblyLinearVelocity = Vector3.zero

		burst(voidCFrame, 18, BLACK, 0.45, "void_arrival")
		burst(voidCFrame, 9, BRIGHT_PURPLE, 0.3, "void_core")
		shockwave(voidCFrame, 4, 35, PURPLE, 0.5, "void_ring")
		particles(hrp, 55, BRIGHT_PURPLE, "void_particles")

		playSound(hrp, SOUND.Void, 2, 0.7)

		task.delay(CONFIG.VOID_STAY_TIME, function()
			if token ~= SESSION.CharacterToken then
				SESSION.Busy.Void = nil
				return
			end

			if not hrp.Parent then
				SESSION.Busy.Void = nil
				return
			end

			burst(hrp.CFrame, 14, BLACK, 0.3, "void_return")
			shockwave(hrp.CFrame, 3, 28, BRIGHT_PURPLE, 0.4, "void_return_ring")

			hrp.CFrame = originalCFrame
			hrp.AssemblyLinearVelocity = Vector3.zero

			burst(originalCFrame, 16, BRIGHT_PURPLE, 0.35, "void_reappear")
			shockwave(originalCFrame, 4, 30, PURPLE, 0.45, "void_reappear_ring")
			particles(hrp, 40, BRIGHT_PURPLE, "void_reappear_particles")

			playSound(hrp, SOUND.Impact, 1.8, 0.8)

			SESSION.Busy.Void = nil
		end)
	end)
end

-- ================================================================
-- MOVE HANDLER
-- ================================================================

local function setupMoveHandler(character, humanoid, hrp, token)
	table.insert(
		SESSION.CharacterConnections,
		humanoid.AnimationPlayed:Connect(function(animationTrack)
			if token ~= SESSION.CharacterToken then
				return
			end

			if not animationTrack
				or not animationTrack.Animation
			then
				return
			end

			local id = normalizeAnimationId(
				animationTrack.Animation.AnimationId
			)

			-- M1.
			local replacement =
				M1_CHAIN[id]
				or DOWNSLAM[id]

			if replacement then
				pcall(function()
					animationTrack:Stop()
				end)

				playAnimation(
					humanoid,
					replacement,
					Enum.AnimationPriority.Action
				)

				return
			end

			-- ====================================================
			-- MOVE 1
			-- PHANTOM ENGINE ENABLED
			-- ====================================================

			if id == normalizeAnimationId(SLOT1_ID) then
				pcall(function()
					animationTrack:Stop()
				end)

				PhantomEngine(
					0.8,
					CONFIG.PHANTOM_SPEED,
					token
				)

				burst(hrp.CFrame, 8, PURPLE, 0.25, "m1")
				shockwave(hrp.CFrame, 2, 17, BRIGHT_PURPLE, 0.3, "m1_ring")
				particles(hrp, 30, BRIGHT_PURPLE, "m1_particles")

				executeVoidKill(
					character,
					humanoid,
					hrp,
					token
				)

				return
			end

			-- ====================================================
			-- MOVE 2
			-- PHANTOM ENGINE ENABLED
			-- ====================================================

			if id == normalizeAnimationId(SLOT2_ID) then
				pcall(function()
					animationTrack:Stop()
				end)

				-- Explicitly preserved.
				PhantomEngine(
					CONFIG.MOVE2_DURATION,
					CONFIG.MOVE2_SPEED,
					token
				)

				burst(hrp.CFrame, 9, PURPLE, 0.25, "m2")
				shockwave(hrp.CFrame, 2, 20, BRIGHT_PURPLE, 0.35, "m2_ring")
				particles(hrp, 28, BRIGHT_PURPLE, "m2_particles")

				return
			end

			-- ====================================================
			-- MOVE 3
			-- NO PHANTOM ENGINE
			-- ====================================================

			if id == normalizeAnimationId(SLOT3_ID) then
				pcall(function()
					animationTrack:Stop()
				end)

				local state = humanoid:GetState()

				local airborne =
					state == Enum.HumanoidStateType.Jumping
					or state == Enum.HumanoidStateType.Freefall

				if airborne then
					playAnimation(
						humanoid,
						PHANTOM_SWEEP_AIR,
						Enum.AnimationPriority.Action
					)
				else
					playAnimation(
						humanoid,
						PHANTOM_SWEEP_GROUND,
						Enum.AnimationPriority.Action
					)
				end

				-- IMPORTANT:
				-- NO PhantomEngine call here.

				burst(hrp.CFrame, 12, BLACK, 0.35, "m3")
				shockwave(hrp.CFrame, 3, 28, BRIGHT_PURPLE, 0.5, "m3_ring")
				particles(hrp, 40, BRIGHT_PURPLE, "m3_particles")

				return
			end

			-- ====================================================
			-- MOVE 4
			-- ====================================================

			if id == normalizeAnimationId(SLOT4_ID) then
				pcall(function()
					animationTrack:Stop()
				end)

				local moveTrack = playAnimation(
					humanoid,
					MOVE4_ANIMATION,
					Enum.AnimationPriority.Action4
				)

				burst(hrp.CFrame, 14, BLACK, 0.35, "m4")
				burst(hrp.CFrame, 8, BRIGHT_PURPLE, 0.25, "m4_core")
				shockwave(hrp.CFrame, 4, 38, PURPLE, 0.55, "m4_ring")
				particles(hrp, 50, BRIGHT_PURPLE, "m4_particles")

				playSound(hrp, SOUND.Void, 1.8, 0.7)

				if moveTrack then
					task.delay(CONFIG.MOVE4_DURATION, function()
						if moveTrack.Parent then
							pcall(function()
								moveTrack:Stop(0.1)
								moveTrack:Destroy()
							end)
						end
					end)
				end

				return
			end

			-- ====================================================
			-- SPECIAL
			-- ====================================================

			if id == normalizeAnimationId(SPECIAL_ID) then
				pcall(function()
					animationTrack:Stop()
				end)

				playAnimation(
					humanoid,
					SPECIAL_ANIMATION,
					Enum.AnimationPriority.Action
				)

				return
			end

			-- ====================================================
			-- ULT 1
			-- ====================================================

			if id == normalizeAnimationId(ULT_EXECUTION_TRIGGER) then
				pcall(function()
					animationTrack:Stop()
				end)

				playAnimation(
					humanoid,
					ULT_EXECUTION_ANIMATION,
					Enum.AnimationPriority.Action4
				)

				burst(hrp.CFrame, 20, BLACK, 0.5, "ult1")
				shockwave(hrp.CFrame, 5, 42, BRIGHT_PURPLE, 0.65, "ult1_ring")
				particles(hrp, 75, BRIGHT_PURPLE, "ult1_particles")

				refreshUltimateNames()

				return
			end

			-- ====================================================
			-- ULT 4
			-- ====================================================

			if id == normalizeAnimationId(ULT_SILENT_TRIGGER) then
				pcall(function()
					animationTrack:Stop()
				end)

				playAnimation(
					humanoid,
					ULT_SILENT_ANIMATION,
					Enum.AnimationPriority.Action4
				)

				burst(hrp.CFrame, 23, BLACK, 0.55, "ult4")
				shockwave(hrp.CFrame, 5, 46, PURPLE, 0.7, "ult4_ring")
				particles(hrp, 85, BRIGHT_PURPLE, "ult4_particles")

				refreshUltimateNames()

				return
			end
		end)
	)
end

