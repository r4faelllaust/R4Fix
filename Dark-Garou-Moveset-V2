local function destroyTool(name)
	local backpack = Player:FindFirstChild("Backpack")

	if backpack then
		for _, x in ipairs(backpack:GetChildren()) do
			if x:IsA("Tool") and x.Name == name then
				x:Destroy()
			end
		end
	end

	local character = Player.Character

	if character then
		for _, x in ipairs(character:GetChildren()) do
			if x:IsA("Tool") and x.Name == name then
				x:Destroy()
			end
		end
	end
end

local function createRunTool()
	local name = "Dark Garou Run"

	destroyTool(name)

	local backpack = Player:WaitForChild("Backpack")

	local tool = Instance.new("Tool")
	tool.Name = name
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Phantom Run"
	tool.Parent = backpack

	local active = false
	local runTrack = nil

	local function stop()
		active = false

		if runTrack then
			stopTrack(runTrack)
			runTrack = nil
		end
	end

	tool.Equipped:Connect(function()
		if active then
			return
		end

		local _, humanoid, hrp = getCharacter()

		if not humanoid or not hrp then
			return
		end

		active = true

		runTrack = playAnim(
			humanoid,
			ANIM.Run,
			Enum.AnimationPriority.Action,
			0.08,
			1
		)

		burst(
			hrp.CFrame,
			5,
			COLORS.Purple,
			0.2,
			"run_start"
		)

		task.spawn(function()
			while active
				and tool.Parent
				and humanoid.Health > 0
			do
				local direction = hrp.CFrame.LookVector

				hrp.AssemblyLinearVelocity =
					Vector3.new(
						direction.X * CFG.RunSpeed,
						hrp.AssemblyLinearVelocity.Y,
						direction.Z * CFG.RunSpeed
					)

				task.wait()
			end
		end)
	end)

	tool.Unequipped:Connect(stop)

	tool.AncestryChanged:Connect(function(_, parent)
		if not parent then
			stop()
		end
	end)
end

local function createTeleportTool()
	local name = "Dark Garou Teleport"

	destroyTool(name)

	local backpack = Player:WaitForChild("Backpack")

	local tool = Instance.new("Tool")
	tool.Name = name
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Void Step"
	tool.Parent = backpack

	tool.Activated:Connect(function()
		local _, humanoid, hrp = getCharacter()

		if not humanoid or not hrp or humanoid.Health <= 0 then
			return
		end

		local mouse = Player:GetMouse()

		if not mouse or not mouse.Hit then
			return
		end

		local destination = mouse.Hit.Position
		local rotation = hrp.CFrame - hrp.Position

		burst(
			hrp.CFrame,
			7,
			COLORS.Purple,
			0.2,
			"tp_start"
		)

		particles(
			hrp,
			15,
			COLORS.BrightPurple,
			"tp_start_particles"
		)

		hrp.CFrame =
			CFrame.new(destination + Vector3.new(0, 3, 0))
			* rotation

		burst(
			hrp.CFrame,
			9,
			COLORS.BrightPurple,
			0.25,
			"tp_end"
		)

		ring(
			hrp.CFrame,
			2,
			16,
			COLORS.Purple,
			0.3,
			"tp_end_ring"
		)

		particles(
			hrp,
			20,
			COLORS.BrightPurple,
			"tp_end_particles"
		)
	end)
end

local function setupTools()
	createRunTool()
	createTeleportTool()
end

