local function disconnectAll(list)
for _, connection in ipairs(list) do
pcall(function()
connection:Disconnect()
end)
end

table.clear(list)

end

local function track(connection)
if connection then
table.insert(SESSION.CharacterConnections, connection)
end

return connection

end

local function characterData()
local character = Player.Character

if not character then
	return nil, nil, nil
end

local humanoid = character:FindFirstChildOfClass("Humanoid")
local hrp = character:FindFirstChild("HumanoidRootPart")

if not humanoid or not hrp then
	return nil, nil, nil
end

return character, humanoid, hrp

end

local function animatorOf(humanoid)
local animator = humanoid:FindFirstChildOfClass("Animator")

if not animator then
	animator = Instance.new("Animator")
	animator.Parent = humanoid
end

return animator

end

local function loadAnim(humanoid, id, priority)
if not humanoid or humanoid.Health <= 0 then
return nil
end

local animation = Instance.new("Animation")
animation.AnimationId = id

local success, result = pcall(function()
	return animatorOf(humanoid):LoadAnimation(animation)
end)

animation:Destroy()

if not success or not result then
	return nil
end

result.Priority = priority or Enum.AnimationPriority.Action

return result

end

local function playAnim(humanoid, id, priority, speed)
local trackResult = loadAnim(humanoid, id, priority)

if not trackResult then
	return nil
end

pcall(function()
	trackResult:Play(0.035, 1, speed or 1)
end)

return trackResult

end

local function vfxAllowed(key)
local now = os.clock()
local previous = SESSION.LastVFX[key] or 0

if now - previous < CONFIG.VFX_COOLDOWN then
	return false
end

SESSION.LastVFX[key] = now

return true

end

local function vfxFolder()
local folder = workspace:FindFirstChild("DarkGarou_VFX")

if not folder then
	folder = Instance.new("Folder")
	folder.Name = "DarkGarou_VFX"
	folder.Parent = workspace
end

return folder

end

local function burst(cf, size, color, duration, key)
if key and not vfxAllowed(key) then
return
end

local part = Instance.new("Part")
part.Name = "DarkGarouBurst"
part.Anchored = true
part.CanCollide = false
part.CanTouch = false
part.CanQuery = false
part.CastShadow = false
part.Shape = Enum.PartType.Ball
part.Material = Enum.Material.Neon
part.Color = color
part.Transparency = 0.12
part.Size = Vector3.one
part.CFrame = cf
part.Parent = vfxFolder()

TweenService:Create(
	part,
	TweenInfo.new(
		duration,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out
	),
	{
		Size = Vector3.new(size, size, size),
		Transparency = 1,
	}
):Play()

Debris:AddItem(part, duration + 0.1)

end

local function ring(cf, startSize, endSize, color, duration, key)
if key and not vfxAllowed(key) then
return
end

local part = Instance.new("Part")
part.Name = "DarkGarouRing"
part.Anchored = true
part.CanCollide = false
part.CanTouch = false
part.CanQuery = false
part.CastShadow = false
part.Shape = Enum.PartType.Cylinder
part.Material = Enum.Material.Neon
part.Color = color
part.Transparency = 0.18

part.Size = Vector3.new(0.12, startSize, startSize)
part.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
part.Parent = vfxFolder()

TweenService:Create(
	part,
	TweenInfo.new(
		duration,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out
	),
	{
		Size = Vector3.new(0.12, endSize, endSize),
		Transparency = 1,
	}
):Play()

Debris:AddItem(part, duration + 0.1)

end

local function particles(parent, amount, color, key)
if not parent or not parent.Parent then
return
end

if key and not vfxAllowed(key) then
	return
end

local attachment = Instance.new("Attachment")
attachment.Parent = parent

local emitter = Instance.new("ParticleEmitter")
emitter.Color = ColorSequence.new(color)
emitter.LightEmission = 0.8
emitter.Rate = 0
emitter.Lifetime = NumberRange.new(0.2, 0.5)
emitter.Speed = NumberRange.new(4, 14)
emitter.Drag = 4
emitter.SpreadAngle = Vector2.new(360, 360)

emitter.Size = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.7),
	NumberSequenceKeypoint.new(0.4, 1.8),
	NumberSequenceKeypoint.new(1, 0),
})

emitter.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.15),
	NumberSequenceKeypoint.new(1, 1),
})

emitter.Parent = attachment

pcall(function()
	emitter:Emit(amount)
end)

Debris:AddItem(attachment, 0.8)

end

-- ================================================================
-- PHANTOM ENGINE
-- ================================================================

local function phantomEngine(duration, speed, token)
local character, humanoid, hrp = characterData()

if not character or not humanoid or not hrp then
	return
end

if token ~= SESSION.Token then
	return
end

local velocity = Instance.new("BodyVelocity")
velocity.Name = "DarkGarou_PhantomEngine"
velocity.MaxForce = Vector3.new(5000000, 5000000, 5000000)
velocity.P = 50000
velocity.Velocity = hrp.CFrame.LookVector * speed
velocity.Parent = hrp

local gyro = Instance.new("BodyGyro")
gyro.Name = "DarkGarou_PhantomGyro"
gyro.MaxTorque = Vector3.new(1000000, 1000000, 1000000)
gyro.P = 50000
gyro.D = 1000
gyro.CFrame = hrp.CFrame
gyro.Parent = hrp

local started = os.clock()

task.spawn(function()
	while velocity.Parent
		and gyro.Parent
		and humanoid.Health > 0
		and token == SESSION.Token
		and os.clock() - started < duration
	do
		local direction = hrp.CFrame.LookVector

		velocity.Velocity =
			direction
			* (
				speed
				* (1 + math.sin(
					((os.clock() - started) / duration)
					* math.pi
				) * 0.35)
			)

		gyro.CFrame = CFrame.lookAt(
			hrp.Position,
			hrp.Position + direction
		)

		task.wait()
	end

	pcall(function()
		velocity:Destroy()
	end)

	pcall(function()
		gyro:Destroy()
	end)
end)

burst(
	hrp.CFrame,
	8,
	COLOR.Purple,
	0.22,
	"phantom_start"
)

ring(
	hrp.CFrame,
	2,
	18,
	COLOR.BrightPurple,
	0.3,
	"phantom_ring"
)

end

-- ================================================================
-- MOVE 1
-- ================================================================

local function move1(character, humanoid, hrp, token)
if SESSION.Busy.Move1 then
return
end

SESSION.Busy.Move1 = true

local original = hrp.CFrame

phantomEngine(0.8, CONFIG.PHANTOM_SPEED, token)

burst(hrp.CFrame, 10, COLOR.Purple, 0.25, "m1")
particles(hrp, 28, COLOR.BrightPurple, "m1_particles")

task.delay(CONFIG.VOID_DELAY, function()
	if token ~= SESSION.Token then
		SESSION.Busy.Move1 = nil
		return
	end

	if not hrp.Parent or humanoid.Health <= 0 then
		SESSION.Busy.Move1 = nil
		return
	end

	local forward = Vector3.new(
		hrp.CFrame.LookVector.X,
		0,
		hrp.CFrame.LookVector.Z
	)

	if forward.Magnitude < 0.01 then
		forward = Vector3.new(0, 0, -1)
	end

	forward = forward.Unit

	local destination =
		hrp.Position
		+ forward * CONFIG.VOID_DISTANCE

	destination = Vector3.new(
		destination.X,
		hrp.Position.Y,
		destination.Z
	)

	hrp.CFrame = CFrame.lookAt(
		destination,
		destination + forward
	)

	hrp.AssemblyLinearVelocity = Vector3.zero

	burst(hrp.CFrame, 18, COLOR.Black, 0.35, "void_arrive")
	ring(hrp.CFrame, 4, 35, COLOR.BrightPurple, 0.45, "void_ring")
	particles(hrp, 50, COLOR.BrightPurple, "void_particles")

	task.delay(CONFIG.VOID_STAY, function()
		if token ~= SESSION.Token then
			SESSION.Busy.Move1 = nil
			return
		end

		if hrp.Parent then
			burst(hrp.CFrame, 14, COLOR.Black, 0.3, "void_return")

			hrp.CFrame = original
			hrp.AssemblyLinearVelocity = Vector3.zero

			burst(original, 16, COLOR.BrightPurple, 0.35, "void_reappear")
			ring(original, 4, 30, COLOR.Purple, 0.4, "void_reappear_ring")
		end

		SESSION.Busy.Move1 = nil
	end)
end)

end

