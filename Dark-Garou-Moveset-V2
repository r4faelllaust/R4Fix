-- ================================================================

local function executeVoidKill(
	character,
	humanoid,
	hrp,
	token
)
	if SESSION.Busy.Void then
		return
	end

	SESSION.Busy.Void = true

	local originalCFrame = hrp.CFrame

	task.delay(
		CONFIG.VOID_DELAY,
		function()
			if token ~= SESSION.CharacterToken
				or not character.Parent
				or humanoid.Health <= 0
				or not hrp.Parent
			then
				SESSION.Busy.Void = nil
				return
			end

			local forward =
				Vector3.new(
					hrp.CFrame.LookVector.X,
					0,
					hrp.CFrame.LookVector.Z
				)

			if forward.Magnitude < 0.01 then
				forward =
					Vector3.new(
						0,
						0,
						-1
					)
			end

			forward = forward.Unit

			local position =
				hrp.Position
				+ forward
				* (
					CONFIG.VOID_HORIZONTAL_DISTANCE
					+ CONFIG.VOID_FORWARD_DISTANCE
				)

			position = Vector3.new(
				position.X,
				hrp.Position.Y,
				position.Z
			)

			local voidCFrame =
				CFrame.lookAt(
					position,
					position + forward
				)

			local platform =
				Instance.new("Part")

			platform.Name =
				"DarkGarouVoidPlatform"

			platform.Anchored = true
			platform.CanCollide = true
			platform.CanTouch = false
			platform.CanQuery = false
			platform.Transparency = 1
			platform.Size =
				Vector3.new(
					80,
					2,
					80
				)

			platform.CFrame =
				voidCFrame
				* CFrame.new(
					0,
					-3,
					0
				)

			platform.Parent =
				getVFXFolder()

			Debris:AddItem(
				platform,
				CONFIG.VOID_STAY_TIME + 1
			)

			hrp.CFrame =
				voidCFrame

			hrp.AssemblyLinearVelocity =
				Vector3.zero

			burst(
				hrp.CFrame,
				18,
				PURPLE_DARK,
				0.45,
				"void_arrival"
			)

			burst(
				hrp.CFrame,
				9,
				PURPLE_BRIGHT,
				0.3,
				"void_core"
			)

			shockwave(
				hrp.CFrame,
				4,
				36,
				PURPLE,
				0.5,
				"void_ring"
			)

			particles(
				hrp,
				55,
				PURPLE_BRIGHT,
				"void_particles"
			)

			playSound(
				hrp,
				2,
				0.7
			)

			task.delay(
				CONFIG.VOID_STAY_TIME,
				function()
					if token ~= SESSION.CharacterToken
						or not hrp.Parent
					then
						SESSION.Busy.Void = nil
						return
					end

					burst(
						hrp.CFrame,
						14,
						PURPLE_DARK,
						0.3,
						"void_exit"
					)

					shockwave(
						hrp.CFrame,
						3,
						30,
						PURPLE_BRIGHT,
						0.4,
						"void_exit_ring"
					)

					hrp.CFrame =
						originalCFrame

					hrp.AssemblyLinearVelocity =
						Vector3.zero

					burst(
						originalCFrame,
						16,
						PURPLE_BRIGHT,
						0.35,
						"void_return"
					)

					shockwave(
						originalCFrame,
						4,
						32,
						PURPLE,
						0.45,
						"void_return_ring"
					)

					particles(
						hrp,
						35,
						PURPLE_BRIGHT,
						"void_return_particles"
					)

					playSound(
						hrp,
						1.8,
						0.8
					)

					SESSION.Busy.Void = nil
				end
			)
		end
	)
end

