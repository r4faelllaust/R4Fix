local function voidExecution(
	character,
	humanoid,
	hrp,
	token
)
	if SESSION.Busy.Void then
		return
	end

	SESSION.Busy.Void = true

	local original = hrp.CFrame

	task.delay(CFG.VoidDelay, function()
		if token ~= SESSION.CharacterToken
			or not character.Parent
			or humanoid.Health <= 0
			or not hrp.Parent
		then
			SESSION.Busy.Void = nil
			return
		end

		local direction = Vector3.new(
			original.LookVector.X,
			0,
			original.LookVector.Z
		)

		if direction.Magnitude < 0.01 then
			direction = Vector3.new(0, 0, -1)
		end

		direction = direction.Unit

		local targetPosition =
			original.Position
			+ direction * CFG.VoidDistance

		targetPosition = Vector3.new(
			targetPosition.X,
			original.Position.Y,
			targetPosition.Z
		)

		local voidCF =
			CFrame.lookAt(
				targetPosition,
				targetPosition + direction
			)

		local platform = Instance.new("Part")
		platform.Name = "DarkGarouVoidPlatform"
		platform.Anchored = true
		platform.CanCollide = true
		platform.CanTouch = false
		platform.CanQuery = false
		platform.Transparency = 1
		platform.Size = Vector3.new(80, 2, 80)
		platform.CFrame =
			voidCF * CFrame.new(0, -3, 0)
		platform.Parent = folder()

		Debris:AddItem(
			platform,
			CFG.VoidStay + 0.5
		)

		hrp.CFrame = voidCF
		hrp.AssemblyLinearVelocity = Vector3.zero

		burst(
			voidCF,
			16,
			COLORS.Black,
			0.4,
			"void_arrive"
		)

		burst(
			voidCF,
			8,
			COLORS.BrightPurple,
			0.28,
			"void_core"
		)

		ring(
			voidCF,
			4,
			34,
			COLORS.Purple,
			0.5,
			"void_ring"
		)

		particles(
			hrp,
			45,
			COLORS.BrightPurple,
			"void_particles"
		)

		task.delay(CFG.VoidStay, function()
			if token ~= SESSION.CharacterToken
				or not hrp.Parent
			then
				SESSION.Busy.Void = nil
				return
			end

			burst(
				hrp.CFrame,
				12,
				COLORS.Black,
				0.3,
				"void_return"
			)

			hrp.CFrame = original
			hrp.AssemblyLinearVelocity = Vector3.zero

			burst(
				original,
				15,
				COLORS.BrightPurple,
				0.35,
				"void_reappear"
			)

			ring(
				original,
				3,
				28,
