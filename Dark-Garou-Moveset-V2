local function setupMoveListener(
character,
humanoid,
hrp,
token
)
track(
humanoid.AnimationPlayed:Connect(
function(animationTrack)
if token ~= SESSION.Token then
return
end

			if not animationTrack
				or not animationTrack.Animation
			then
				return
			end

			local id =
				animationTrack.Animation.AnimationId

			local replacement =
				M1_CHAIN[id]
				or DOWNSLAM[id]

			if replacement then
				animationTrack:Stop()

				playAnimation(
					humanoid,
					replacement,
					Enum.AnimationPriority.Action,
					1
				)

				return
			end

			-- MOVE 1
			if id == SLOT1_ID then
				animationTrack:Stop()

				move1(
					character,
					humanoid,
					hrp,
					token
				)

				return
			end

			-- MOVE 2
			if id == SLOT2_ID then
				animationTrack:Stop()

				move2(
					humanoid,
					hrp,
					token
				)

				return
			end

			-- MOVE 3
			if id == SLOT3_ID then
				animationTrack:Stop()

				move3(
					humanoid,
					hrp
				)

				return
			end

			-- MOVE 4
			if id == SLOT4_ID then
				animationTrack:Stop()

				move4(
					humanoid,
					hrp
				)

				return
			end

			-- ULT 1
			if id == ULT_TRIGGER_1 then
				animationTrack:Stop()

				ultMove1(
					humanoid,
					hrp
				)

				return
			end

			-- ULT 2
			if id == ULT_TRIGGER_2 then
				animationTrack:Stop()

				ultMove2(
					humanoid,
					hrp
				)

				return
			end
		end
	)
)

end

