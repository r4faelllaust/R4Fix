-- ================================================================
-- IDLE
-- ================================================================

local function setupIdle(
	character,
	humanoid,
	token
)
	local motors = {}

	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("Motor6D") then
			local name = string.lower(obj.Name)

			if string.find(name, "waist")
				or string.find(name, "shoulder")
				or string.find(name, "neck")
			then
				table.insert(motors, {
					Motor = obj,
					Base = obj.Transform,
				})
			end
		end
	end

	local start = os.clock()

	track(
		RunService.RenderStepped:Connect(function()
			if token ~= SESSION.CharacterToken
				or not character.Parent
				or humanoid.Health <= 0
			then
				return
			end

			if humanoid.MoveDirection.Magnitude > 0.05 then
				return
			end

			local state = humanoid:GetState()

			if state == Enum.HumanoidStateType.Jumping
				or state == Enum.HumanoidStateType.Freefall
			then
				return
			end

			local t = os.clock() - start
			local breathe = math.sin(t * CFG.IdleSpeed)
			local sway = math.sin(t * CFG.IdleSpeed * 0.55)

			for _, data in ipairs(motors) do
				if data.Motor.Parent then
					data.Motor.Transform =
						data.Base
						* CFrame.Angles(
							breathe * CFG.IdleStrength,
							sway * 0.018,
							0
						)
				end
			end
		end)
	)
end

-- ================================================================
-- MOVEMENT VFX
-- ================================================================

local function setupMovement(
	humanoid,
	hrp,
	token
)
	local last = 0

	track(
		RunService.Heartbeat:Connect(function()
			if token ~= SESSION.CharacterToken
				or humanoid.Health <= 0
			then
				return
			end

			if humanoid.MoveDirection.Magnitude < 0.1 then
				return
			end

			local now = os.clock()

			if now - last < CFG.MovementVFXCooldown then
				return
			end

			if hrp.AssemblyLinearVelocity.Magnitude < 80 then
				return
			end

			last = now

			particles(
				hrp,
				1,
				COLORS.Purple,
				"movement"
			)
		end)
	)
end

