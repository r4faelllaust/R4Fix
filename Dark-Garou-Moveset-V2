local function setupHandGlow(character)
for _, limbName in ipairs({
"Left Arm",
"Right Arm",
"LeftHand",
"RightHand",
"LeftLowerArm",
"RightLowerArm",
}) do
local limb = character:FindFirstChild(limbName)

	if limb and limb:IsA("BasePart") then
		local old = limb:FindFirstChild("DarkGarouHandGlow")

		if old then
			old:Destroy()
		end

		local attachment = Instance.new("Attachment")
		attachment.Name = "DarkGarouHandGlow"
		attachment.Parent = limb

		local emitter = Instance.new("ParticleEmitter")
		emitter.Color = ColorSequence.new(WHITE, BRIGHT_PURPLE)
		emitter.LightEmission = 1
		emitter.Rate = 2
		emitter.Lifetime = NumberRange.new(0.2, 0.4)
		emitter.Speed = NumberRange.new(0.1, 0.8)
		emitter.SpreadAngle = Vector2.new(180, 180)

		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(1, 0),
		})

		emitter.Parent = attachment
	end
end

end

