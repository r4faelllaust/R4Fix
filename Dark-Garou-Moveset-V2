local function getVFXFolder()
	local folder = workspace:FindFirstChild("DarkGarou_VFX")

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "DarkGarou_VFX"
		folder.Parent = workspace
	end

	return folder
end

local function vfxAllowed(key, cooldown)
	local now = os.clock()
	local last = SESSION.LastVFX[key] or 0

	if now - last < cooldown then
		return false
	end

	SESSION.LastVFX[key] = now
	return true
end

