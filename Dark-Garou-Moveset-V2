function SESSION.Destroy()
	if SESSION.Destroyed then
		return
	end

	SESSION.Destroyed = true

	for _, c in ipairs(SESSION.Connections) do
		pcall(function()
			c:Disconnect()
		end)
	end

	for _, c in ipairs(SESSION.CharacterConnections) do
		pcall(function()
			c:Disconnect()
		end)
	end

	for _, tool in ipairs(SESSION.Tools) do
		pcall(function()
			tool:Destroy()
		end)
	end

	table.clear(SESSION.Connections)
	table.clear(SESSION.CharacterConnections)
	table.clear(SESSION.Tools)
end

local function track(list, connection)
	if connection then
		table.insert(list, connection)
	end

	return connection
end

local function disconnectList(list)
	for _, c in ipairs(list) do
		pcall(function()
			c:Disconnect()
		end)
	end

	table.clear(list)
end

