local function findFirstDescendant(
	parent,
	name
)
	if not parent then
		return nil
	end

	for _, object in ipairs(
		parent:GetDescendants()
	) do
		if object.Name == name then
			return object
		end
	end

	return nil
end

local function setTextIfExists(
	object,
	text
)
	if object and (
		object:IsA("TextLabel")
		or object:IsA("TextButton")
		or object:IsA("TextBox")
	) then
		object.Text = text
	end
end

