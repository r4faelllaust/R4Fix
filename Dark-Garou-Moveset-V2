-- ================================================================
-- AFTERIMAGE
-- ================================================================

local function createAfterimage(character)
	if not character or not character.Parent then
		return
	end

	local clone

	pcall(function()
		clone = character:Clone()
	end)

	if not clone then
		return
	end

	for _, obj in ipairs(clone:GetDescendants()) do
		if obj:IsA("Script")
			or obj:IsA("LocalScript")
			or obj:IsA("ModuleScript")
			or obj:IsA("Humanoid")
			or obj:IsA("Tool")
		then
			obj:Destroy()

		elseif obj:IsA("BasePart") then
			obj.Anchored = true
			obj.CanCollide = false
			obj.CanTouch = false
			obj.CanQuery = false
			obj.CastShadow = false
			obj.Material = Enum.Material.Neon
			obj.Color = VOID_PURPLE
			obj.Transparency = 0.6

		elseif obj:IsA("Decal") then
			obj.Transparency = 0.8

		elseif obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam")
		then
			obj.Enabled = false
		end
	end

	clone.Name = "PhantomAfterimage"
	clone.Parent = getVFXFolder()

	task.spawn(function()
		for i = 1, 8 do
			for _, obj in ipairs(clone:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.Transparency = math.clamp(
						obj.Transparency + 0.05,
						0,
						1
					)
				end
			end

			task.wait(0.025)
		end

		pcall(function()
			clone:Destroy()
		end)
	end)

	Debris:AddItem(clone, 1)
end

-- ================================================================
-- PHANTOM ENGINE
-- ================================================================

local function PhantomEngine(
	duration,
	speed,
	ownerToken
)
	local character, humanoid, hrp = getCharacter()

	if not character
		or not humanoid
		or not hrp
	then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if ownerToken
		and ownerToken ~= SESSION.CharacterToken
	then
		return false
	end

	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "DarkGarou_PhantomEngine"
	bodyVelocity.MaxForce = Vector3.new(
		CONFIG.PHANTOM_MAX_FORCE,
		CONFIG.PHANTOM_MAX_FORCE,
		CONFIG.PHANTOM_MAX_FORCE
	)

	bodyVelocity.P = 50000
	bodyVelocity.Velocity =
		hrp.CFrame.LookVector * speed
	bodyVelocity.Parent = hrp

	local bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "DarkGarou_PhantomGyro"
	bodyGyro.MaxTorque = Vector3.new(
		1e6,
		1e6,
		1e6
	)

	bodyGyro.P = 50000
	bodyGyro.D = 1000
	bodyGyro.CFrame = hrp.CFrame
	bodyGyro.Parent = hrp

	local trail = createPhantomTrail(hrp)
	local aura = createAura(hrp)

	spawnBurst(
		hrp.CFrame,
		8,
		VOID_PURPLE,
		0.25,
		"engine_start"
	)

	spawnShockwave(
		hrp.CFrame,
		3,
		17,
		VOID_PURPLE,
		0.35,
		"engine_ring"
	)

	spawnDarkParticles(
		hrp,
		22,
		VOID_PURPLE_2,
		"engine_particles"
	)

	playSound(
		hrp,
		SOUND.Phantom,
		1.4,
		0.85
	)

	local alive = true
	local started = os.clock()

	task.spawn(function()
		while alive
			and hrp.Parent
			and humanoid.Health > 0
			and os.clock() - started < duration
		do
			if ownerToken
				and ownerToken ~= SESSION.CharacterToken
			then
				break
			end

			local alpha = math.clamp(
				(os.clock() - started) / duration,
				0,
				1
			)

			local direction = hrp.CFrame.LookVector

			local acceleration =
				speed
				* (
					1.05
					+ math.sin(alpha * math.pi) * 0.7
				)

			bodyVelocity.Velocity =
				direction * acceleration

			bodyGyro.CFrame =
				CFrame.lookAt(
					hrp.Position,
					hrp.Position + direction
				)

			task.wait(0.025)
		end
	end)

	task.spawn(function()
		for i = 1, CONFIG.PHANTOM_PULSES do
			if not alive
				or not hrp.Parent
				or humanoid.Health <= 0
			then
				break
			end

			local direction = hrp.CFrame.LookVector

			bodyVelocity.Velocity =
				direction
				* (
					speed + i * 65
				)

			spawnBurst(
				hrp.CFrame * CFrame.new(0, 0, 1.5),
				4 + i,
				i % 2 == 0
					and VOID_PURPLE_2
					or VOID_PURPLE,
				0.18,
				"engine_pulse_" .. tostring(i)
			)

			task.wait(
				CONFIG.PHANTOM_PULSE_DELAY
			)
		end
	end)

	task.spawn(function()
		for i = 1, 6 do
			if not alive then
				break
			end

			createAfterimage(character)
			task.wait(0.055)
		end
	end)

	task.delay(duration, function()
		alive = false

		pcall(function()
			bodyVelocity:Destroy()
		end)

		pcall(function()
			bodyGyro:Destroy()
		end)

		if trail then
			pcall(function()
				trail.Trail.Enabled = false
			end)

			Debris:AddItem(trail.A0, 0.6)
			Debris:AddItem(trail.A1, 0.6)
			Debris:AddItem(trail.Trail, 0.6)
		end

		if aura then
			pcall(function()
				aura:Destroy()
			end)
		end

		if hrp.Parent then
			spawnBurst(
				hrp.CFrame,
				12,
				VOID_PURPLE_2,
				0.3,
				"engine_end"
			)

			spawnShockwave(
				hrp.CFrame,
				4,
				25,
				VOID_PURPLE,
				0.45,
				"engine_end_ring"
			)

			spawnDarkParticles(
				hrp,
				30,
				VOID_PURPLE_2,
				"engine_end_particles"
			)
		end
	end)

	return true
end

