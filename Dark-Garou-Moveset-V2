local function findTextObjects(root)
	local result = {}

	if not root then
		return result
	end

	for _, obj in ipairs(
		root:GetDescendants()
	) do
		if obj:IsA("TextLabel")
			or obj:IsA("TextButton")
		then
			table.insert(
				result,
				obj
			)
		end
	end

	return result
end

local function setTextIfFound(
	root,
	names,
	text
)
	if not root then
		return false
	end

	for _, name in ipairs(names) do
		local obj =
			root:FindFirstChild(
				name,
				true
			)

		if obj
			and (
				obj:IsA("TextLabel")
				or obj:IsA("TextButton")
				or obj:IsA("TextBox")
			)
		then
			obj.Text = text
			return true
		end
	end

	return false
end

