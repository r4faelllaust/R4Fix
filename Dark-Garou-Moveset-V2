local function setupUIWatcher()
	local gui = Player:FindFirstChild("PlayerGui")

	if not gui then
		return
	end

	table.insert(
		SESSION.Connections,
		gui.DescendantAdded:Connect(function(obj)
			task.defer(function()
				if not Player.Parent then
					return
				end

				pcall(function()
					fixCharacterTab()
					refreshMoves()
					refreshUltimate()

					-- If a newly-created UI object belongs to
					-- the ultimate system, style it immediately.
					if isUltimateObject(obj) then
						styleUltimateObject(obj)

						for _, child in ipairs(obj:GetDescendants()) do
							styleUltimateObject(child)
						end
					end
				end)
			end)
		end)
	)
end

