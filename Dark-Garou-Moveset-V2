local function getCharacter()
local character = Player.Character

if not character then
	return nil, nil, nil
end

local humanoid = character:FindFirstChildOfClass("Humanoid")
local hrp = character:FindFirstChild("HumanoidRootPart")

if not humanoid or not hrp then
	return nil, nil, nil
end

return character, humanoid, hrp

end

local function getAnimator(humanoid)
local animator = humanoid:FindFirstChildOfClass("Animator")

if not animator then
	animator = Instance.new("Animator")
	animator.Parent = humanoid
end

return animator

end

local function stopOurAnimations()
for _, track in ipairs(S.AnimationTracks) do
pcall(function()
if track.IsPlaying then
track:Stop(0.08)
end
track:Destroy()
end)
end

table.clear(S.AnimationTracks)

end

local function playAnimation(humanoid, id, priority, speed, duration)
if not humanoid or humanoid.Health <= 0 then
return nil
end

local animator = getAnimator(humanoid)

local animation = Instance.new("Animation")
animation.AnimationId = id

local ok, track = pcall(function()
	return animator:LoadAnimation(animation)
end)

animation:Destroy()

if not ok or not track then
	return nil
end

track.Priority = priority or Enum.AnimationPriority.Action
track.Looped = false

table.insert(S.AnimationTracks, track)

pcall(function()
	track:Play(0.05, 1, speed or 1)
end)

if duration then
	task.delay(duration, function()
		pcall(function()
			if track.IsPlaying then
				track:Stop(0.08)
			end
			track:Destroy()
		end)

		for i = #S.AnimationTracks, 1, -1 do
			if S.AnimationTracks[i] == track then
				table.remove(S.AnimationTracks, i)
				break
			end
		end
	end)
end

return track

end

