-- ================================================================
-- IDLE
-- ================================================================

local function startIdle(character, humanoid)
	if not CONFIG.IDLE_ENABLED then
		return
	end

	local motors = {}

	for _, obj in ipairs(
		character:GetDescendants()
	) do
		if obj:IsA("Motor6D") then
			local lower = string.lower(
				obj.Name
			)

			if string.find(lower, "waist")
				or string.find(lower, "shoulder")
				or string.find(lower, "neck")
			then
				table.insert(
					motors,
					{
						Motor = obj,
						Base = obj.Transform,
						Name = lower,
					}
				)
			end
		end
	end

	local start = os.clock()

	track(
		RunService.RenderStepped:Connect(
			function()
				if not character.Parent
					or humanoid.Health <= 0
				then
					return
				end

				local moving =
					humanoid.MoveDirection.Magnitude
					> 0.05

				local state =
					humanoid:GetState()

				if moving
					or state == Enum.HumanoidStateType.Jumping
					or state == Enum.HumanoidStateType.Freefall
				then
					for _, data in ipairs(motors) do
						pcall(function()
							data.Motor.Transform =
								data.Motor.Transform:Lerp(
									data.Base,
									0.18
								)
						end)
					end

					return
				end

				local t = os.clock() - start

				local breathe =
					math.sin(
						t * CONFIG.IDLE_SPEED
					)

				local sway =
					math.sin(
						t * CONFIG.IDLE_SPEED * 0.55
					)

				for _, data in ipairs(motors) do
					pcall(function()
						local motor = data.Motor

						if string.find(
							data.Name,
							"waist"
						) then
							motor.Transform =
								data.Base
								* CFrame.Angles(
									0,
									breathe
										* CONFIG.IDLE_STRENGTH,
									sway * 0.02
								)

						elseif string.find(
							data.Name,
							"shoulder"
						) then
							motor.Transform =
								data.Base
								* CFrame.Angles(
									breathe * 0.02,
									0,
									sway * 0.018
								)

						elseif string.find(
							data.Name,
							"neck"
						) then
							motor.Transform =
								data.Base
								* CFrame.Angles(
									breathe * 0.018,
									sway * 0.03,
									0
								)
						end
					end)
				end
			end
		)
	)
end

