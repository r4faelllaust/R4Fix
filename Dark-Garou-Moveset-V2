local function getHotbar()
	local gui = Player:FindFirstChild("PlayerGui")
	if not gui then
		return nil
	end

	local hotbar = gui:FindFirstChild("Hotbar")
	if not hotbar then
		return nil
	end

	local backpack = hotbar:FindFirstChild("Backpack")
	if not backpack then
		return nil
	end

	return backpack:FindFirstChild("Hotbar")
end

local function slotName(slotNumber, name, subtext)
	local hotbar = getHotbar()
	if not hotbar then
		return
	end

	local slot = hotbar:FindFirstChild(tostring(slotNumber))
	if not slot then
		return
	end

	local base = slot:FindFirstChild("Base")
	if not base then
		return
	end

	local text = base:FindFirstChild("ToolName")

	if text and text:IsA("TextLabel") then
		text.Text = name
	end

	if subtext then
		local reuse = base:FindFirstChild("Reuse")

		if reuse and reuse:IsA("TextLabel") then
			reuse.Text = subtext
			reuse.Visible = true
		end
	end
end

