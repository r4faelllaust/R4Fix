local function cleanupCharacter()
disconnectAll(S.CharacterConnections)
stopOurAnimations()

for _, object in ipairs(workspace:GetChildren()) do
	if object.Name == "DarkGarou_VFX" then
		pcall(function()
			object:Destroy()
		end)
	end
end

S.Busy = {}
table.clear(S.LastVFX)

end

local function setupCharacter(character)
S.Token += 1
local token = S.Token

cleanupCharacter()

local humanoid = character:WaitForChild("Humanoid", 10)
local hrp = character:WaitForChild("HumanoidRootPart", 10)

if not humanoid or not hrp then
	return
end

applyNight()

spawnEffect(character, hrp)
setupHandGlow(character)

setupMoveHandler(
	character,
	humanoid,
	hrp,
	token
)

task.spawn(function()
	for _ = 1, 15 do
		if token ~= S.Token then
			return
		end

		fixCharacterTab()
		refreshMoveBar()
		styleUltimateBar()

		task.wait(0.2)
	end
end)

task.delay(0.65, function()
	if token == S.Token then
		setupTools()
	end
end)

addConnection(
	humanoid.Died:Connect(function()
		S.Busy = {}
		stopOurAnimations()
	end)
)

addConnection(
	Player.PlayerGui.DescendantAdded:Connect(function()
		task.defer(function()
			if token == S.Token then
				fixCharacterTab()
				refreshMoveBar()
				styleUltimateBar()
			end
		end)
	end)
)

end

