-- ================================================================
-- TOOLS
-- ================================================================

local function destroyToolByName(
	name
)
	local backpack =
		Player:FindFirstChild(
			"Backpack"
		)

	if backpack then
		for _, obj in ipairs(
			backpack:GetChildren()
		) do
			if obj:IsA("Tool")
				and obj.Name == name
			then
				obj:Destroy()
			end
		end
	end

	local character =
		Player.Character

	if character then
		for _, obj in ipairs(
			character:GetChildren()
		) do
			if obj:IsA("Tool")
				and obj.Name == name
			then
				obj:Destroy()
			end
		end
	end
end

local function createRunTool()
	destroyToolByName(
		"Dark Garou Run"
	)

	local backpack =
		Player:WaitForChild(
			"Backpack"
		)

	local tool =
		Instance.new("Tool")

	tool.Name =
		"Dark Garou Run"

	tool.RequiresHandle =
		false

	tool.CanBeDropped =
		false

	tool.ToolTip =
		"PHANTOM RUN"

	tool.Parent =
		backpack

	local running = false
	local animationTrack

	local function stop()
		running = false

		stopTrack(
			animationTrack
		)

		animationTrack = nil
	end

	track(
		SESSION.CharacterConnections,
		tool.Equipped:Connect(
			function()
				local character,
					humanoid,
					hrp =
					getCharacter()

				if not character
					or not humanoid
					or not hrp
				then
					return
				end

				if running then
					return
				end

				running = true

				animationTrack =
					playAnimation(
						humanoid,
						RUN_ANIMATION,
						Enum.AnimationPriority.Action
					)

				burst(
					hrp.CFrame,
					6,
					PURPLE,
					0.2,
					"run_start"
				)

				task.spawn(
					function()
						while running
							and tool.Parent
							and humanoid.Health > 0
						do
							local direction =
								humanoid.MoveDirection

							if direction.Magnitude
								< 0.05
							then
								direction =
									hrp.CFrame.LookVector
							else
								direction =
									direction.Unit
							end

							hrp.AssemblyLinearVelocity =
								Vector3.new(
									direction.X
										* CONFIG.RUN_SPEED,

									hrp.AssemblyLinearVelocity.Y,

									direction.Z
										* CONFIG.RUN_SPEED
								)

							RunService.Heartbeat:Wait()
						end
					end
				)
			end
		)
	)

	track(
		SESSION.CharacterConnections,
		tool.Unequipped:Connect(
			stop
		)
	)

	table.insert(
		SESSION.Tools,
		tool
	)
end

local function createTeleportTool()
	destroyToolByName(
		"Dark Garou Teleport"
	)

	local backpack =
		Player:WaitForChild(
			"Backpack"
		)

	local tool =
		Instance.new("Tool")

	tool.Name =
		"Dark Garou Teleport"

	tool.RequiresHandle =
		false

	tool.CanBeDropped =
		false

	tool.ToolTip =
		"VOID STEP"

	tool.Parent =
		backpack

	track(
		SESSION.CharacterConnections,
		tool.Activated:Connect(
			function()
				local character,
					humanoid,
					hrp =
					getCharacter()

				if not character
					or not humanoid
					or not hrp
				then
					return
				end

				local mouse =
					Player:GetMouse()

				if not mouse
					or not mouse.Hit
				then
					return
				end

				local old =
					hrp.CFrame

				local destination =
					mouse.Hit.Position

				burst(
					old,
					7,
					PURPLE,
					0.2,
					"tp_depart"
				)

				particles(
					hrp,
					16,
					PURPLE_2,
					"tp_depart_particles"
				)

				task.wait(0.035)

				local _, h, root =
					getCharacter()

				if not h
					or not root
					or h.Health <= 0
				then
					return
				end

				root.CFrame =
					CFrame.new(
						destination
					)
					* CFrame.Angles(
						0,
						select(
							2,
							old:ToEulerAnglesYXZ()
						),
						0
					)

				burst(
					root.CFrame,
					9,
					PURPLE_2,
					0.28,
					"tp_arrive"
				)

				ring(
					root.CFrame,
					2,
					15,
					PURPLE,
					0.35,
					"tp_arrive_ring"
				)

				particles(
					root,
					24,
					PURPLE_2,
					"tp_arrive_particles"
				)
			end
		)
	)

	table.insert(
		SESSION.Tools,
		tool
	)
end

local function setupTools()
	for _, tool in ipairs(
		SESSION.Tools
	) do
		pcall(function()
			tool:Destroy()
		end)
	end

	table.clear(
		SESSION.Tools
	)

	createRunTool()
	createTeleportTool()
end

-- ================================================================
-- MOVE 1 INSTANT KILL
-- ================================================================

local function executeVoidKill(
	character,
	humanoid,
	hrp,
	token
)
	if SESSION.Busy.Void then
		return
	end

	SESSION.Busy.Void = true

	local original =
		hrp.CFrame

	local function finish()
		SESSION.Busy.Void = nil
	end

	task.delay(
		CONFIG.VOID_DELAY,
		function()
			if token ~= SESSION.CharacterToken
				or not character.Parent
				or humanoid.Health <= 0
				or not hrp.Parent
			then
				finish()
				return
			end

			local horizontal =
				Vector3.new(
					hrp.CFrame.LookVector.X,
					0,
					hrp.CFrame.LookVector.Z
				)

			if horizontal.Magnitude
				< 0.01
			then
				horizontal =
					Vector3.new(
						0,
						0,
						-1
					)
			end

			horizontal =
				horizontal.Unit

			local destination =
				hrp.Position
				+ horizontal
					* (
						CONFIG.VOID_HORIZONTAL_DISTANCE
						+ CONFIG.VOID_FORWARD_DISTANCE
					)

			destination =
				Vector3.new(
					destination.X,
					hrp.Position.Y,
					destination.Z
				)

			local voidCF =
				CFrame.lookAt(
					destination,
					destination
						+ horizontal
				)

			local platform =
				Instance.new("Part")

			platform.Name =
				"DarkGarouVoidPlatform"

			platform.Anchored =
				true

			platform.CanCollide =
				true

			platform.CanTouch =
				false

			platform.CanQuery =
				false

			platform.Transparency =
				1

			platform.Size =
				Vector3.new(
					80,
					2,
					80
				)

			platform.CFrame =
				voidCF
				* CFrame.new(
					0,
					-3,
					0
				)

			platform.Parent =
				getVFXFolder()

			Debris:AddItem(
				platform,
				CONFIG.VOID_STAY_TIME + 1
			)

			hrp.CFrame =
				voidCF

			hrp.AssemblyLinearVelocity =
				Vector3.zero

			burst(
				voidCF,
				18,
				BLACK,
				0.45,
				"void_arrival"
			)

			burst(
				voidCF,
				9,
				PURPLE_2,
				0.3,
				"void_core"
			)

			ring(
				voidCF,
				4,
				35,
				PURPLE,
				0.5,
				"void_ring"
			)

			particles(
				hrp,
				55,
				PURPLE_2,
				"void_particles"
			)

			playSound(
				hrp,
				SOUND.Void,
				2,
				0.7
			)

			task.delay(
				CONFIG.VOID_STAY_TIME,
				function()
					if token ~= SESSION.CharacterToken
						or not hrp.Parent
					then
						finish()
						return
					end

					burst(
						hrp.CFrame,
						14,
						BLACK,
						0.3,
						"void_return"
					)

					ring(
						hrp.CFrame,
						3,
						28,
						PURPLE_2,
						0.4,
						"void_return_ring"
					)

					hrp.CFrame =
						original

					hrp.AssemblyLinearVelocity =
						Vector3.zero

					burst(
						original,
						16,
						PURPLE_2,
						0.35,
						"void_reappear"
					)

					ring(
						original,
						4,
						30,
						PURPLE,
						0.45,
						"void_reappear_ring"
					)

					particles(
						hrp,
						40,
						PURPLE_2,
						"void_reappear_particles"
					)

					playSound(
						hrp,
						SOUND.Impact,
						1.8,
						0.8
					)

					finish()
				end
			)
		end
	)
end

-- ================================================================
-- MOVE HANDLER
-- ================================================================

local function setupMoveHandler(
	character,
	humanoid,
	hrp,
	token
)
	track(
		SESSION.CharacterConnections,
		humanoid.AnimationPlayed:Connect(
			function(animationTrack)
				if token ~= SESSION.CharacterToken
					or not animationTrack
				then
					return
				end

				local animation =
					animationTrack.Animation

				if not animation then
					return
				end

				local id =
					normalizeAnimationId(
						animation.AnimationId
					)

				-- M1
				local replacement =
					M1_CHAIN[id]
					or DOWNSLAM[id]

				if replacement then
					stopTrack(
						animationTrack
					)

					playAnimation(
						humanoid,
						replacement,
						Enum.AnimationPriority.Action
					)

					return
				end

				-- MOVE 1
				if id == SLOT1_ID then
					if SESSION.Busy.Void then
						stopTrack(
							animationTrack
						)

						return
					end

					stopTrack(
						animationTrack
					)

					playAnimation(
						humanoid,
						MOVE1_ANIMATION,
						Enum.AnimationPriority.Action
					)

					PhantomEngine(
						CONFIG.PHANTOM_DURATION_1,
						260,
						token
					)

					executeVoidKill(
						character,
						humanoid,
						hrp,
						token
					)

					return
				end

				-- MOVE 2
				if id == SLOT2_ID then
					stopTrack(
						animationTrack
					)

					playAnimation(
						humanoid,
						MOVE2_ANIMATION,
						Enum.AnimationPriority.Action
					)

					PhantomEngine(
						CONFIG.PHANTOM_DURATION_2,
						285,
						token
					)

					burst(
						hrp.CFrame,
						9,
						PURPLE,
						0.25,
						"m2"
					)

					ring(
						hrp.CFrame,
						2,
						20,
						PURPLE_2,
						0.35,
						"m2ring"
					)

					particles(
						hrp,
						28,
						PURPLE_2,
						"m2particles"
					)

					return
				end

				-- MOVE 3
				-- ABSOLUTELY NO PHANTOM ENGINE.
				if id == SLOT3_ID then
					stopTrack(
						animationTrack
					)

					local state =
						humanoid:GetState()

					local airborne =
						state ==
						Enum.HumanoidStateType.Jumping
						or state ==
						Enum.HumanoidStateType.Freefall

					playAnimation(
						humanoid,
						airborne
							and MOVE3_AIR
							or MOVE3_GROUND,
						Enum.AnimationPriority.Action
					)

					burst(
						hrp.CFrame,
						11,
						BLACK,
						0.3,
						"m3"
					)

					ring(
						hrp.CFrame,
						3,
						27,
						PURPLE_2,
						0.45,
						"m3ring"
					)

					particles(
						hrp,
						35,
						PURPLE_2,
						"m3particles"
					)

					return
				end

				-- MOVE 4
				if id == SLOT4_ID then
					stopTrack(
						animationTrack
					)

					playAnimation(
						humanoid,
						MOVE4_ANIMATION,
						Enum.AnimationPriority.Action
					)

					burst(
						hrp.CFrame,
						14,
						BLACK,
						0.35,
						"m4"
					)

					burst(
						hrp.CFrame,
						8,
						PURPLE_2,
						0.25,
						"m4core"
					)

					ring(
						hrp.CFrame,
						4,
						38,
						PURPLE,
						0.55,
						"m4ring"
					)

					particles(
						hrp,
						50,
						PURPLE_2,
						"m4particles"
					)

					return
				end

				-- SPECIAL
				if id == SPECIAL_ID then
					stopTrack(
						animationTrack
					)

					playAnimation(
						humanoid,
						SPECIAL_ANIMATION,
						Enum.AnimationPriority.Action
					)

					return
				end

				-- ULT 1
				if id ==
					ULT_EXECUTION_TRIGGER
				then
					stopTrack(
						animationTrack
					)

					playAnimation(
						humanoid,
						ULT_EXECUTION_ANIMATION,
						Enum.AnimationPriority.Action4
					)

					burst(
						hrp.CFrame,
						20,
						BLACK,
						0.5,
						"ult1"
					)

					ring(
						hrp.CFrame,
						5,
						44,
						DARK_BLUE_2,
						0.7,
						"ult1ring"
					)

					particles(
						hrp,
						75,
						BLUE_GLOW,
						"ult1particles"
					)

					return
				end

				-- ULT 4
				if id ==
					ULT_SILENT_TRIGGER
				then
					stopTrack(
						animationTrack
					)

					playAnimation(
						humanoid,
						ULT_SILENT_ANIMATION,
						Enum.AnimationPriority.Action4
					)

					burst(
						hrp.CFrame,
						23,
						BLACK,
						0.55,
						"ult4"
					)

					ring(
						hrp.CFrame,
						5,
						48,
						DARK_BLUE,
						0.75,
						"ult4ring"
					)

					particles(
						hrp,
						85,
						BLUE_GLOW,
						"ult4particles"
					)

					return
				end
			end
		)
	)
end

-- ================================================================
-- IDLE
-- ================================================================

local function setupIdle(
	character,
	humanoid,
	token
)
	local motors = {}

	for _, obj in ipairs(
		character:GetDescendants()
	) do
		if obj:IsA("Motor6D") then
			local name =
				string.lower(
					obj.Name
				)

			if string.find(
				name,
				"waist"
			)
			or string.find(
				name,
				"shoulder"
			)
			or string.find(
				name,
				"neck"
			)
			then
				table.insert(
					motors,
					{
						Motor = obj,
						Base = obj.Transform,
						Name = name,
					}
				)
			end
		end
	end

	local start =
		os.clock()

	track(
		SESSION.CharacterConnections,
		RunService.RenderStepped:Connect(
			function()
				if token ~= SESSION.CharacterToken
					or not character.Parent
					or humanoid.Health <= 0
				then
					return
				end

				if humanoid.MoveDirection.Magnitude
					> 0.05
				then
					return
				end

				local state =
					humanoid:GetState()

				if state ==
					Enum.HumanoidStateType.Jumping
					or state ==
					Enum.HumanoidStateType.Freefall
				then
					return
				end

				local t =
					os.clock() - start

				local breath =
					math.sin(
						t * 1.7
					)

				local sway =
					math.sin(
						t * 0.9
					)

				for _, data in ipairs(
					motors
				) do
					pcall(function()
						data.Motor.Transform =
							data.Base
							* CFrame.Angles(
								breath * 0.018,
								sway * 0.012,
								0
							)
					end)
				end
			end
		)
	)
end

