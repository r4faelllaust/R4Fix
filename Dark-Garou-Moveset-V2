-- ================================================================
-- MOVE LISTENER
-- ================================================================

local function setupMoves(character, humanoid, hrp, token)
track(
humanoid.AnimationPlayed:Connect(function(animation)
if token ~= SESSION.Token then
return
end

		if not animation.Animation then
			return
		end

		local id = animation.Animation.AnimationId

		local replacement =
			M1_CHAIN[id]
			or DOWNSLAM[id]

		if replacement then
			animation:Stop()
			playAnim(
				humanoid,
				replacement,
				Enum.AnimationPriority.Action
			)
			return
		end

		if id == SLOT1 then
			animation:Stop()
			move1(character, humanoid, hrp, token)
			return
		end

		if id == SLOT2 then
			animation:Stop()
			move2(humanoid, hrp, token)
			return
		end

		if id == SLOT3 then
			animation:Stop()
			move3(humanoid, hrp)
			return
		end

		if id == SLOT4 then
			animation:Stop()
			move4(humanoid, hrp)
			return
		end

		if id == ULT_TRIGGER_1 then
			animation:Stop()
			ultimate(humanoid, hrp, ULT_ANIMATION_1)
			return
		end

		if id == ULT_TRIGGER_2 then
			animation:Stop()
			ultimate(humanoid, hrp, ULT_ANIMATION_2)
			return
		end
	end)
)

end

-- ================================================================
-- CHARACTER SETUP
-- ================================================================

local function setupCharacter(character)
SESSION.Token += 1
local token = SESSION.Token

disconnectAll(SESSION.CharacterConnections)

for _, object in ipairs(workspace:GetChildren()) do
	if object.Name == "DarkGarou_VFX" then
		pcall(function()
			object:Destroy()
		end)
	end
end

local humanoid = character:WaitForChild("Humanoid", 10)
local hrp = character:WaitForChild("HumanoidRootPart", 10)

if not humanoid or not hrp then
	return
end

SESSION.Busy = {}

nighttime()
handGlow(character)

burst(hrp.CFrame, 10, COLOR.Purple, 0.35, "spawn")
ring(hrp.CFrame, 2, 18, COLOR.BrightPurple, 0.4, "spawn_ring")
particles(hrp, 30, COLOR.BrightPurple, "spawn_particles")

setupMoves(
	character,
	humanoid,
	hrp,
	token
)

task.spawn(function()
	for _ = 1, 15 do
		if token ~= SESSION.Token then
			return
		end

		characterTab()
		refreshMoves()

		task.wait(0.2)
	end
end)

end

-- ================================================================
-- RESPAWN
-- ================================================================

if not SESSION.Initialized then
SESSION.Initialized = true

table.insert(
	SESSION.Connections,
	Player.CharacterAdded:Connect(function(character)
		task.wait(0.25)
		setupCharacter(character)
	end)
)

table.insert(
	SESSION.Connections,
	RunService.Heartbeat:Connect(function()
		characterTab()
	end)
)

end

if Player.Character then
task.spawn(function()
setupCharacter(Player.Character)
end)
end

-- ================================================================
-- CONTINUOUS UI RECOVERY
-- ================================================================

task.spawn(function()
while Player.Parent do
pcall(function()
characterTab()
refreshMoves()
end)

	task.wait(0.75)
end

end)
