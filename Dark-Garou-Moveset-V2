local function setupMoves(char, hum, root)
	connect(hum.AnimationPlayed, function(track)
		if not validCharacter(char) then
			return
		end

		local animation = track.Animation

		if not animation then
			return
		end

		local id = animation.AnimationId

		if id == SLOT1 then
			track:Stop()

			playAnimation(
				hum,
				"rbxassetid://15259161390",
				1
			)

			task.spawn(VoidExecution)

		elseif id == SLOT2 then
			track:Stop()

			playAnimation(
				hum,
				"rbxassetid://15240216931",
				1
			)

			PhantomEngine(
				1.05,
				PHANTOM_SPEED + 40
			)

			burst(root.CFrame, 10, PURPLE, 0.25)
			ring(root.CFrame, 3, 22, PURPLE2, 0.35)
			particles(root, 45, PURPLE2)

		elseif id == SLOT3 then
			track:Stop()

			local airborne =
				hum:GetState()
				== Enum.HumanoidStateType.Freefall
				or hum:GetState()
				== Enum.HumanoidStateType.Jumping

			playAnimation(
				hum,
				airborne and ANIM.Move3Air or ANIM.Move3Ground,
				1
			)

			-- MOVE 3 ONLY, NO PHANTOM ENGINE.

			burst(root.CFrame, 12, PURPLE, 0.3)
			ring(root.CFrame, 3, 30, PURPLE2, 0.45)
			particles(root, 60, PURPLE2)

		elseif id == SLOT4 then
			track:Stop()

			playAnimation(
				hum,
				"rbxassetid://15162694192",
				1
			)

			burst(root.CFrame, 15, DARK, 0.4)
			ring(root.CFrame, 4, 40, PURPLE, 0.55)
			particles(root, 75, PURPLE2)

		elseif id == ULT1 then
			track:Stop()

			playAnimation(hum, ANIM.Ult1, 1)

			burst(root.CFrame, 23, DARK, 0.5)
			ring(root.CFrame, 5, 50, PURPLE2, 0.65)
			particles(root, 110, PURPLE2)

			task.spawn(VoidExecution)

		elseif id == ULT2 then
			track:Stop()

			playAnimation(hum, ANIM.Ult2, 1)

			burst(root.CFrame, 28, DARK, 0.55)
			ring(root.CFrame, 5, 55, PURPLE, 0.75)
			particles(root, 130, PURPLE2)
		end
	end)
end

----------------------------------------------------------------
-- SPAWN
----------------------------------------------------------------

local function setupCharacter(char)
	if generation ~= session.Generation then
		return
	end

	disconnectAll()
	stopPhantom()

	session.Character = char

	local hum = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)

	if not hum or not root then
		return
	end

	----------------------------------------------------------------
	-- KEEP THE PLAYER IN HUNTER
	----------------------------------------------------------------

	if Player:GetAttribute("Character") ~= "Hunter" then
		pcall(function()
			local communicate = char:FindFirstChild("Communicate")

			if communicate then
				communicate:FireServer({
					Goal = "Change Character",
					Character = "Hunter",
				})
			end
		end)
	end

	----------------------------------------------------------------
	-- SPAWN
	----------------------------------------------------------------

	burst(root.CFrame, 12, DARK, 0.4)
	burst(root.CFrame, 7, PURPLE2, 0.3)
	ring(root.CFrame, 3, 25, PURPLE, 0.45)
	particles(root, 50, PURPLE2)

	----------------------------------------------------------------
	-- OUTLINE
	----------------------------------------------------------------

	setupHighlight(char)

	----------------------------------------------------------------
	-- ANIMATIONS
	----------------------------------------------------------------

	setupIdle(char, hum)
	setupMoves(char, hum, root)

	----------------------------------------------------------------
	-- TOOLS
	----------------------------------------------------------------

	task.defer(function()
		if validCharacter(char) then
			createTools(char)
		end
	end)

	----------------------------------------------------------------
	-- HOTBAR LOOP
	----------------------------------------------------------------

	task.spawn(function()
		local localGeneration = generation

		while localGeneration == session.Generation
			and validCharacter(char)
			and hum.Health > 0 do

			updateCharacterIcon()
			updateHotbar()

			if Player:GetAttribute("Ultimate") then
				updateUltBar()
			end

			task.wait(0.25)
		end
	end)

	----------------------------------------------------------------
	-- DEATH LOCATION
	----------------------------------------------------------------

	connect(hum.Died, function()
		if validCharacter(char) then
			session.DeathCFrame = root.CFrame
		end

		stopPhantom()
	end)
end

----------------------------------------------------------------
-- INITIAL CHARACTER
----------------------------------------------------------------

if Player.Character then
	task.spawn(function()
		setupCharacter(Player.Character)
	end)
end

connect(Player.CharacterAdded, function(char)
	session.Generation += 1
	generation = session.Generation

	task.wait(0.35)

	if Player.Character ~= char then
		return
	end

	setupCharacter(char)
end)

----------------------------------------------------------------
-- RESPAWN TOOL PROTECTION
----------------------------------------------------------------

task.spawn(function()
	while Player.Parent do
		task.wait(0.5)

		local char = Player.Character

		if char and char == session.Character then
			local backpack = Player:FindFirstChild("Backpack")

			if backpack then
				local tpCount = 0
				local runCount = 0

				for _, tool in ipairs(backpack:GetChildren()) do
					if tool:IsA("Tool")
						and tool:GetAttribute("DarkGarouTool")
					then
						if tool.Name == "VOID TP" then
							tpCount += 1
						elseif tool.Name == "PHANTOM RUN" then
							runCount += 1
						end
					end
				end

				if tpCount > 1 or runCount > 1 then
					removeOurTools()
					createTools(char)
				end
			end
		end
	end
end)

----------------------------------------------------------------
-- CHARACTER UI REFRESH
----------------------------------------------------------------

task.spawn(function()
	while Player.Parent do
		updateCharacterIcon()
		updateHotbar()
		task.wait(0.2)
	end
end)
