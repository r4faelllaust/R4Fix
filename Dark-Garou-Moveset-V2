-- ================================================================

local function findHotbar()
local gui = Player:FindFirstChild("PlayerGui")

if not gui then
	return nil
end

local hotbar = gui:FindFirstChild("Hotbar")

if not hotbar then
	return nil
end

local backpack = hotbar:FindFirstChild("Backpack")

if not backpack then
	return nil
end

return backpack:FindFirstChild("Hotbar")

end

local function slot(slotNumber)
local frame = findHotbar()

if not frame then
	return nil
end

local current = frame:FindFirstChild(tostring(slotNumber))

if not current then
	return nil
end

return current:FindFirstChild("Base")

end

local function setText(object, text)
if object and object:IsA("TextLabel") then
object.Text = text
end
end

local function setSlot(slotNumber, name, label)
local base = slot(slotNumber)

if not base then
	return
end

local toolName = base:FindFirstChild("ToolName")

if toolName then
	setText(toolName, name)
end

local reuse = base:FindFirstChild("Reuse")

if reuse then
	reuse.Visible = label ~= nil

	if reuse:IsA("TextLabel") and label then
		reuse.Text = label
	end

	local nested = reuse:FindFirstChild("Reuse")

	if nested and nested:IsA("TextLabel") and label then
		nested.Text = label
	end
end

end

local function setUltimateBar()
-- Do not replace the whole UI.
-- Only recolor existing ultimate UI objects.

local gui = Player:FindFirstChild("PlayerGui")

if not gui then
	return
end

for _, object in ipairs(gui:GetDescendants()) do
	local name = string.lower(object.Name)

	if string.find(name, "ult")
		or string.find(name, "ultimate")
	then
		if object:IsA("Frame")
			or object:IsA("TextButton")
			or object:IsA("ImageButton")
		then
			pcall(function()
				object.BackgroundColor3 = COLOR.DarkBlue
			end)
		elseif object:IsA("TextLabel") then
			pcall(function()
				object.TextColor3 = COLOR.White
			end)
		end
	end
end

end

