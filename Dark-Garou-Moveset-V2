local function getCharacter()
	local character = Player.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local hrp =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not hrp then
		return nil, nil, nil
	end

	return character, humanoid, hrp
end

local function getAnimator(humanoid)
	local animator =
		humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

-- ================================================================
-- ANIMATION LOADER
-- ================================================================

local function normalizeAnimationId(id)
	if not id then
		return ""
	end

	local numeric =
		string.match(id, "%d+")

	if numeric then
		return "rbxassetid://" .. numeric
	end

	return id
end

local function loadAnimation(
	humanoid,
	id,
	priority
)
	if not humanoid
		or humanoid.Health <= 0
	then
		return nil
	end

	id = normalizeAnimationId(id)

	local animator =
		getAnimator(humanoid)

	local animation =
		Instance.new("Animation")

	animation.AnimationId = id

	local ok, result =
		pcall(function()
			return animator:LoadAnimation(
				animation
			)
		end)

	animation:Destroy()

	if not ok or not result then
		return nil
	end

	if priority then
		result.Priority = priority
	end

	return result
end

local function playAnimation(
	humanoid,
	id,
	priority,
	fade,
	speed
)
	local trackResult =
		loadAnimation(
			humanoid,
			id,
			priority
		)

	if not trackResult then
		return nil
	end

	pcall(function()
		trackResult:Play(
			fade or 0.05,
			1,
			speed or 1
		)
	end)

	return trackResult
end

local function stopTrack(trackResult)
	if not trackResult then
		return
	end

	pcall(function()
		trackResult:Stop(0.08)
	end)
end

