}

local function getHotbar()
	local gui = Player:FindFirstChild("PlayerGui")
	if not gui then return nil end

	local hotbar = gui:FindFirstChild("Hotbar")
	if not hotbar then return nil end

	local backpack = hotbar:FindFirstChild("Backpack")
	if not backpack then return nil end

	return backpack:FindFirstChild("Hotbar")
end

local function setSlot(slotNumber, name, variant)
	local frame = getHotbar()

	if not frame then
		return
	end

	local slot = frame:FindFirstChild(tostring(slotNumber))

	if not slot then
		return
	end

	local base = slot:FindFirstChild("Base")

	if not base then
		return
	end

	local toolName = base:FindFirstChild("ToolName")

	if toolName then
		toolName.Text = name
	end

	local reuse = base:FindFirstChild("Reuse")

	if reuse then
		if variant then
			reuse.Visible = true
			reuse.Text = variant

			local nested = reuse:FindFirstChild("Reuse")
			if nested then
				nested.Text = variant
			end
		else
			reuse.Visible = false
		end
	end
end

local function updateHotbar()
	for slot, name in pairs(MOVE_NAMES) do
		setSlot(slot, name, slot == "1" and "|| INSTA KILL ||" or nil)
	end
end

local function updateUltBar()
	for slot, name in pairs(ULT_NAMES) do
		setSlot(slot, name)
	end

	local gui = Player:FindFirstChild("PlayerGui")
	if not gui then return end

	for _, object in ipairs(gui:GetDescendants()) do
		if object:IsA("ImageLabel") or object:IsA("ImageButton") then
			local n = string.lower(object.Name)

			if string.find(n, "ultimate")
				or string.find(n, "ult")
				or string.find(n, "magichealth")
			then
				pcall(function()
					object.ImageColor3 = DARK
				end)
			end
		end
	end
end

----------------------------------------------------------------
-- VOID EXECUTION
----------------------------------------------------------------

local instaBusy = false

local function VoidExecution()
	if instaBusy then
		return
	end

	local char, hum, root = getCharacter()

	if not char or hum.Health <= 0 then
		return
	end

	instaBusy = true

	local original = root.CFrame

	PhantomEngine(0.95, PHANTOM_SPEED + 55)

	burst(root.CFrame, 15, DARK, 0.3)
	ring(root.CFrame, 4, 30, PURPLE2, 0.4)
	particles(root, 60, PURPLE2)

	task.wait(INSTA_DELAY)

	if not validCharacter(char) or hum.Health <= 0 then
		instaBusy = false
		return
	end

	original = root.CFrame

	local direction = original.LookVector
	local horizontal =
		Vector3.new(direction.X, 0, direction.Z)

	if horizontal.Magnitude < 0.01 then
		horizontal = Vector3.new(0, 0, -1)
	else
		horizontal = horizontal.Unit
	end

	local voidPosition =
		original.Position
		+ horizontal * VOID_DISTANCE

	local voidCFrame =
		CFrame.lookAt(
			voidPosition,
			voidPosition + horizontal
		)

	local platform = Instance.new("Part")
	platform.Name = "DarkGarouVoidPlatform"
	platform.Anchored = true
	platform.CanCollide = true
	platform.CanTouch = false
	platform.CanQuery = false
	platform.Transparency = 1
	platform.Size = Vector3.new(30, 1, 30)
	platform.CFrame = voidCFrame * CFrame.new(0, -3.2, 0)
	platform.Parent = workspace

	Debris:AddItem(platform, VOID_STAY + 2)

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = voidCFrame

	burst(voidCFrame, 20, DARK, 0.45)
	burst(voidCFrame, 11, PURPLE2, 0.3)
	ring(voidCFrame, 4, 42, PURPLE, 0.5)
	particles(root, 80, PURPLE2)

	task.wait(VOID_STAY)

	if validCharacter(char) and hum.Health > 0 then
		burst(root.CFrame, 16, DARK, 0.25)
		ring(root.CFrame, 3, 35, PURPLE2, 0.4)

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = original

		burst(original, 20, PURPLE2, 0.4)
		ring(original, 5, 36, PURPLE, 0.5)
		particles(root, 65, PURPLE2)
	end

	instaBusy = false
end

