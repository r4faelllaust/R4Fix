-- ================================================================
-- MOVE 1, VOID EXECUTION
-- ================================================================

local function executeVoidKill(
	character,
	humanoid,
	hrp,
	token
)
	if SESSION.Busy.Void then
		return
	end

	SESSION.Busy.Void = true

	local originalCFrame = hrp.CFrame

	local function finish()
		SESSION.Busy.Void = nil
	end

	task.delay(
		CONFIG.VOID_DELAY,
		function()
			if token ~= SESSION.CharacterToken then
				finish()
				return
			end

			if not character.Parent
				or humanoid.Health <= 0
				or not hrp.Parent
			then
				finish()
				return
			end

			-- SAVE EXACT ORIGINAL LOCATION.
			local returnCFrame =
				originalCFrame

			-- Horizontal only.
			local horizontal =
				Vector3.new(
					hrp.CFrame.LookVector.X,
					0,
					hrp.CFrame.LookVector.Z
				)

			if horizontal.Magnitude < 0.01 then
				horizontal = Vector3.new(
					0,
					0,
					-1
				)
			end

			horizontal =
				horizontal.Unit

			local voidPosition =
				hrp.Position
				+ horizontal
				* CONFIG.VOID_HORIZONTAL_DISTANCE
				+ horizontal
				* CONFIG.VOID_FORWARD_DISTANCE

			-- SAME HEIGHT.
			voidPosition = Vector3.new(
				voidPosition.X,
				hrp.Position.Y
					+ CONFIG.VOID_VERTICAL_OFFSET,
				voidPosition.Z
			)

			local voidCFrame =
				CFrame.lookAt(
					voidPosition,
					voidPosition
						+ horizontal
				)

			-- Invisible local platform.
			local platform =
				Instance.new("Part")

			platform.Name =
				"DarkGarouVoidPlatform"

			platform.Anchored = true
			platform.CanCollide = true
			platform.CanTouch = false
			platform.CanQuery = false
			platform.Transparency = 1

			platform.Size =
				Vector3.new(
					80,
					2,
					80
				)

			platform.CFrame =
				voidCFrame
				* CFrame.new(
					0,
					-3,
					0
				)

			platform.Parent =
				getVFXFolder()

			Debris:AddItem(
				platform,
				CONFIG.VOID_STAY_TIME + 0.5
			)

			-- Displace only after the full delay.
			hrp.CFrame = voidCFrame

			-- Keep player alive and stable.
			hrp.AssemblyLinearVelocity =
				Vector3.zero

			spawnBurst(
				voidCFrame,
				18,
				VOID_BLACK,
				0.45,
				"void_arrival"
			)

			spawnBurst(
				voidCFrame,
				9,
				VOID_PURPLE_2,
				0.3,
				"void_arrival_core"
			)

			spawnShockwave(
				voidCFrame,
				4,
				35,
				VOID_PURPLE,
				0.5,
				"void_arrival_ring"
			)

			spawnDarkParticles(
				hrp,
				55,
				VOID_PURPLE_2,
				"void_arrival_particles"
			)

			playSound(
				hrp,
				SOUND.Void,
				2,
				0.7
			)

			-- Wait exactly the intended execution period.
			task.delay(
				CONFIG.VOID_STAY_TIME,
				function()
					if token ~= SESSION.CharacterToken then
						finish()
						return
					end

					if not hrp.Parent then
						finish()
						return
					end

					spawnBurst(
						hrp.CFrame,
						14,
						VOID_BLACK,
						0.3,
						"void_return"
					)

					spawnShockwave(
						hrp.CFrame,
						3,
						28,
						VOID_PURPLE_2,
						0.4,
						"void_return_ring"
					)

					spawnDarkParticles(
						hrp,
						35,
						VOID_PURPLE,
						"void_return_particles"
					)

					-- RETURN TO EXACT ORIGINAL LOCATION.
					hrp.CFrame =
						returnCFrame

					hrp.AssemblyLinearVelocity =
						Vector3.zero

					spawnBurst(
						returnCFrame,
						16,
						VOID_PURPLE_2,
						0.35,
						"void_reappear"
					)

					spawnShockwave(
						returnCFrame,
						4,
						30,
						VOID_PURPLE,
						0.45,
						"void_reappear_ring"
					)

					spawnDarkParticles(
						hrp,
						40,
						VOID_PURPLE_2,
						"void_reappear_particles"
					)

					playSound(
						hrp,
						SOUND.Impact,
						1.8,
						0.8
					)

					finish()
				end
			)
		end
	)
end

-- ================================================================
-- MOVE HANDLER
-- ================================================================

local function setupMoveHandler(
	character,
	humanoid,
	hrp,
	token
)
	track(
		humanoid.AnimationPlayed:Connect(
			function(animationTrack)
				if token ~= SESSION.CharacterToken then
					return
				end

				if not animationTrack
					or not animationTrack.Animation
				then
					return
				end

				local id =
					animationTrack.Animation.AnimationId

				-- M1 replacement.
				local replacement =
					M1_CHAIN[id]
					or DOWNSLAM[id]

				if replacement then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimation(
						humanoid,
						replacement,
						Enum.AnimationPriority.Action
					)

					return
				end

				-- ==================================================
				-- MOVE 1
				-- ==================================================

				if id == SLOT1_ID then
					pcall(function()
						animationTrack:Stop()
					end)

					if SESSION.Busy.Void then
						return
					end

					-- Phantom Engine remains on Move 1.
					PhantomEngine(
						0.8,
						CONFIG.PHANTOM_SPEED,
						token
					)

					local moveCFrame =
						hrp.CFrame

					spawnBurst(
						moveCFrame,
						8,
						VOID_PURPLE,
						0.25,
						"m1_start"
					)

					spawnShockwave(
						moveCFrame,
						2,
						17,
						VOID_PURPLE_2,
						0.3,
						"m1_start_ring"
					)

					spawnDarkParticles(
						hrp,
						30,
						VOID_PURPLE_2,
						"m1_start_particles"
					)

					executeVoidKill(
						character,
						humanoid,
						hrp,
						token
					)

					return
				end

				-- ==================================================
				-- MOVE 2
				-- ==================================================

				if id == SLOT2_ID then
					pcall(function()
						animationTrack:Stop()
					end)

					-- IMPORTANT:
					-- Move 2 gets Phantom Engine.
					-- Move 3 does not.
					PhantomEngine(
						CONFIG.MOVE2_DURATION,
						CONFIG.MOVE2_SPEED,
						token
					)

					spawnBurst(
						hrp.CFrame,
						9,
						VOID_PURPLE,
						0.25,
						"m2_start"
					)

					spawnShockwave(
						hrp.CFrame,
						2,
						20,
						VOID_PURPLE_2,
						0.35,
						"m2_ring"
					)

					spawnDarkParticles(
						hrp,
						28,
						VOID_PURPLE_2,
						"m2_particles"
					)

					playSound(
						hrp,
						SOUND.Phantom,
						1.5,
						1.05
					)

					return
				end

				-- ==================================================
				-- MOVE 3
				-- NO PHANTOM ENGINE.
				-- ==================================================

				if id == SLOT3_ID then
					pcall(function()
						animationTrack:Stop()
					end)

					local state =
						humanoid:GetState()

					local airborne =
						state == Enum.HumanoidStateType.Jumping
						or state == Enum.HumanoidStateType.Freefall

					local variant =
						airborne
						and PHANTOM_SWEEP_AIR
						or PHANTOM_SWEEP_GROUND

					playAnimation(
						humanoid,
						variant,
						Enum.AnimationPriority.Action
					)

					spawnBurst(
						hrp.CFrame,
						12,
						VOID_BLACK,
						0.35,
						"m3_start"
					)

					spawnShockwave(
						hrp.CFrame,
						3,
						28,
						VOID_PURPLE_2,
						0.5,
						"m3_ring"
					)

					spawnDarkParticles(
						hrp,
						40,
						VOID_PURPLE_2,
						"m3_particles"
					)

					setSlotName(
						3,
						"Phantom Sweep",
						airborne
						and "|| AIR VARIANT ||"
						or "|| GROUND VARIANT ||"
					)

					return
				end

				-- ==================================================
				-- MOVE 4
				-- ==================================================

				if id == SLOT4_ID then
					pcall(function()
						animationTrack:Stop()
					end)

					-- Only fires when the actual move trigger
					-- is received.
					playAnimation(
						humanoid,
						"rbxassetid://18897115785",
						Enum.AnimationPriority.Action
					)

					spawnBurst(
						hrp.CFrame,
						14,
						VOID_BLACK,
						0.35,
						"m4_start"
					)

					spawnBurst(
						hrp.CFrame,
						8,
						VOID_PURPLE_2,
						0.25,
						"m4_core"
					)

					spawnShockwave(
						hrp.CFrame,
						4,
						38,
						VOID_PURPLE,
						0.55,
						"m4_ring"
					)

					spawnDarkParticles(
						hrp,
						50,
						VOID_PURPLE_2,
						"m4_particles"
					)

					playSound(
						hrp,
						SOUND.Void,
						1.8,
						0.7
					)

					return
				end

				-- ==================================================
				-- SPECIAL
				-- ==================================================

				if id == SPECIAL_ID then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimation(
						humanoid,
						SPECIAL_ANIMATION,
						Enum.AnimationPriority.Action
					)

					return
				end

				-- ==================================================
				-- ULT 1
				-- ==================================================

				if id == ULT_EXECUTION_TRIGGER then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimation(
						humanoid,
						ULT_EXECUTION_ANIMATION,
						Enum.AnimationPriority.Action4
					)

					spawnBurst(
						hrp.CFrame,
						20,
						VOID_BLACK,
						0.5,
						"ult1"
					)

					spawnShockwave(
						hrp.CFrame,
						5,
						42,
						VOID_PURPLE_2,
						0.65,
						"ult1_ring"
					)

					spawnDarkParticles(
						hrp,
						75,
						VOID_PURPLE_2,
						"ult1_particles"
					)

					return
				end

				-- ==================================================
				-- ULT 4
				-- ==================================================

				if id == ULT_SILENT_TRIGGER then
					pcall(function()
						animationTrack:Stop()
					end)

					playAnimation(
						humanoid,
						ULT_SILENT_ANIMATION,
						Enum.AnimationPriority.Action4
					)

					spawnBurst(
						hrp.CFrame,
						23,
						VOID_BLACK,
						0.55,
						"ult4"
					)

					spawnShockwave(
						hrp.CFrame,
						5,
						46,
						VOID_PURPLE,
						0.7,
						"ult4_ring"
					)

					spawnDarkParticles(
						hrp,
						85,
						VOID_PURPLE_2,
						"ult4_particles"
					)

					return
				end
			end
		)
	)
end

-- ================================================================
-- MOVEMENT VFX
-- ================================================================

local function setupMovementVFX(
	character,
	humanoid,
	hrp,
	token
)
	local lastMovementVFX = 0

	track(
		RunService.Heartbeat:Connect(
			function()
				if token ~= SESSION.CharacterToken then
					return
				end

				if humanoid.Health <= 0 then
					return
				end

				if humanoid.MoveDirection.Magnitude < 0.1 then
					return
				end

				if os.clock() - lastMovementVFX
					< CONFIG.MOVEMENT_VFX_COOLDOWN
				then
					return
				end

				lastMovementVFX = os.clock()

				local velocity =
					hrp.AssemblyLinearVelocity.Magnitude

				if velocity > 80 then
					spawnDarkParticles(
						hrp,
						1,
						VOID_PURPLE,
						"movement"
					)
				end
			end
		)
	)
end

-- ================================================================
-- CHARACTER SETUP
-- ================================================================

local function setupCharacter(character)
	SESSION.CharacterToken += 1

	local token =
		SESSION.CharacterToken

	cleanupCharacter()

	SESSION.LastCharacter =
		character

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local hrp =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid or not hrp then
		return
	end

	applyNighttime()

	-- CHARACTER TAB.
	-- Does not change fonts.
	task.spawn(function()
		for i = 1, 20 do
			if token ~= SESSION.CharacterToken then
				return
			end

			fixCharacterTab()
			task.wait(0.15)
		end
	end)

	-- Spawn VFX.
	spawnAnimation(
		character,
		hrp
	)

	setupHandHighlight(
		character
	)

	startIdle(
		character,
		humanoid
	)

	setupMoveHandler(
		character,
		humanoid,
		hrp,
		token
	)

	setupMovementVFX(
		character,
		humanoid,
		hrp,
		token
	)

	-- Hotbar refresh.
	task.spawn(function()
		for i = 1, 20 do
			if token ~= SESSION.CharacterToken then
				return
			end

			refreshHotbarNames()
			fixCharacterTab()

			task.wait(0.2)
		end
	end)

	-- Keep the names after UI refreshes.
	track(
		Player.PlayerGui.DescendantAdded:Connect(
			function()
				task.defer(function()
					if token == SESSION.CharacterToken then
						fixCharacterTab()
						refreshHotbarNames()
					end
				end)
			end
		)
	)

	-- Restore tools after respawn.
	task.delay(0.5, function()
		if token == SESSION.CharacterToken then
			setupTools()
		end
	end)

	-- Character death.
	track(
		humanoid.Died:Connect(function()
			SESSION.Busy.Void = nil
		end)
	)
end

-- ================================================================
-- CHARACTER RESPAWN
-- ================================================================

if not SESSION.Initialized then
	SESSION.Initialized = true

	disconnectList(
		SESSION.Connections
	)

	table.insert(
		SESSION.Connections,
		Player.CharacterAdded:Connect(
			function(character)
				task.spawn(function()
					character:WaitForChild(
						"Humanoid",
						10
					)

					character:WaitForChild(
						"HumanoidRootPart",
						10
					)

					task.wait(0.2)

					setupCharacter(
						character
					)
				end)
			end
		)
	)

	-- Global character-tab updater.
	table.insert(
		SESSION.Connections,
		RunService.Heartbeat:Connect(
			function()
				fixCharacterTab()
			end
		)
	)
end

-- ================================================================
-- INITIAL CHARACTER
-- ================================================================

local initialCharacter =
	Player.Character

if initialCharacter then
	task.spawn(function()
		setupCharacter(
			initialCharacter
		)
	end)
else
	task.spawn(function()
		local character =
			Player.CharacterAdded:Wait()

		setupCharacter(
			character
		)
	end)
end

