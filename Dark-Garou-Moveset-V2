local function fixCharacterTab()
local gui = Player:FindFirstChild("PlayerGui")

if not gui then
	return
end

local topbar = gui:FindFirstChild("TopbarPlus")

if not topbar then
	return
end

for _, object in ipairs(topbar:GetDescendants()) do
	if object.Name ~= "IconButton" then
		continue
	end

	local label = object:FindFirstChild("IconLabel")
	local image = object:FindFirstChild("IconImage")

	if label and label:IsA("TextLabel") then
		local current = label.Text

		if current == "Garou"
			or current == "Hero Hunter"
			or current == "Dark Garou"
		then
			-- DO NOT modify font.
			label.Text = MOVESET_NAME

			if image and (image:IsA("ImageLabel") or image:IsA("ImageButton")) then
				image.Image = DECAL_ID
			end
		end
	end
end

end

