	return string.find(name, "ult") ~= nil
		or string.find(name, "ultimate") ~= nil
		or string.find(name, "awakening") ~= nil
end

local function looksLikeUltText(text)
	local lower = string.lower(text)

	return lower == "ultimate"
		or lower == "ult"
		or lower == "awakening"
		or lower == "awaken"
		or string.find(lower, "ultimate") ~= nil
end

local function isPercentText(text)
	return string.match(text, "^%d+%%$") ~= nil
end

local function styleUltimateObject(obj)
	if not obj:IsA("GuiObject") then
		return
	end

	local objectName = string.lower(obj.Name)
	local parentName = ""

	if obj.Parent then
		parentName = string.lower(obj.Parent.Name)
	end

	local ultimateContext =
		isUltimateObject(obj)
		or string.find(parentName, "ult") ~= nil
		or string.find(parentName, "ultimate") ~= nil
		or string.find(parentName, "awakening") ~= nil

	if not ultimateContext then
		return
	end

	-- Actual ultimate containers.
	if obj:IsA("Frame")
		or obj:IsA("ScrollingFrame")
	then
		obj.BackgroundColor3 = ULT_DARK_BLUE
	end

	-- UI strokes.
	for _, child in ipairs(obj:GetChildren()) do
		if child:IsA("UIStroke") then
			child.Color = ULT_BLUE_BRIGHT
			child.Transparency = 0.15
		end
	end

	-- Text.
	if obj:IsA("TextLabel")
		or obj:IsA("TextButton")
		or obj:IsA("TextBox")
	then
		local current = obj.Text

		if looksLikeUltText(current) then
			obj.Text = "TOTAL ECLIPSE"
		elseif isPercentText(current) then
			-- Keep percentage intact.
		end

		obj.TextColor3 = ULT_TEXT
		obj.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		obj.TextStrokeTransparency = 0.25
	end

	-- Image-backed bars.
	if obj:IsA("ImageLabel")
		or obj:IsA("ImageButton")
	then
		obj.ImageColor3 = ULT_BLUE
	end

	-- Bar/fill objects.
	if obj:IsA("Frame") then
		if string.find(objectName, "fill")
			or string.find(objectName, "bar")
			or string.find(objectName, "progress")
			or string.find(objectName, "charge")
			or string.find(objectName, "meter")
		then
			obj.BackgroundColor3 = ULT_BLUE_BRIGHT
		end
	end
end

local function findUltimateRoots()
	local gui = Player:FindFirstChild("PlayerGui")
	if not gui then
		return {}
	end

	local results = {}

	for _, obj in ipairs(gui:GetDescendants()) do
		local n = string.lower(obj.Name)

		if string.find(n, "ult")
			or string.find(n, "ultimate")
			or string.find(n, "awakening")
		then
			table.insert(results, obj)
		end
	end

	return results
end

local function refreshUltimate()
	local gui = Player:FindFirstChild("PlayerGui")
	if not gui then
		return
	end

	-- First pass, target all obvious ultimate descendants.
	for _, obj in ipairs(gui:GetDescendants()) do
		pcall(function()
			styleUltimateObject(obj)
		end)
	end

	-- Second pass, inspect ultimate roots and all descendants.
	for _, root in ipairs(findUltimateRoots()) do
		pcall(function()
			if root:IsA("Frame") then
				root.BackgroundColor3 = ULT_DARK_BLUE
			end

			for _, child in ipairs(root:GetDescendants()) do
				styleUltimateObject(child)
			end
		end)
	end
end

