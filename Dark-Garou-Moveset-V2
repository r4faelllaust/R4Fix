local function removeOurTools()
	for _, tool in ipairs(Player.Backpack:GetChildren()) do
		if tool:GetAttribute("DarkGarouTool") then
			tool:Destroy()
		end
	end

	local char = Player.Character

	if char then
		for _, tool in ipairs(char:GetChildren()) do
			if tool:IsA("Tool")
				and tool:GetAttribute("DarkGarouTool")
			then
				tool:Destroy()
			end
		end
	end
end

local function createTools(char)
	removeOurTools()

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")

	if not hum or not root then
		return
	end

	local tp = Instance.new("Tool")
	tp.Name = "VOID TP"
	tp.RequiresHandle = false
	tp.CanBeDropped = false
	tp:SetAttribute("DarkGarouTool", true)

	tp.Activated:Connect(function()
		if not validCharacter(char) then
			return
		end

		local mouse = Player:GetMouse()

		if not mouse or not mouse.Hit then
			return
		end

		local target = mouse.Hit.Position
		local old = root.CFrame

		burst(old, 9, PURPLE, 0.2)
		particles(root, 30, PURPLE2)

		root.CFrame =
			CFrame.lookAt(
				target + Vector3.new(0, 3, 0),
				target + Vector3.new(0, 3, 0) + old.LookVector
			)

		burst(root.CFrame, 12, PURPLE2, 0.25)
		ring(root.CFrame, 3, 18, PURPLE, 0.3)
		particles(root, 35, PURPLE2)
	end)

	tp.Parent = Player.Backpack

	local run = Instance.new("Tool")
	run.Name = "PHANTOM RUN"
	run.RequiresHandle = false
	run.CanBeDropped = false
	run:SetAttribute("DarkGarouTool", true)

	local running = false
	local runTrack

	run.Equipped:Connect(function()
		if running then return end

		running = true

		runTrack = playAnimation(hum, ANIM.Run, 1.2)

		PhantomEngine(9999, 125)
	end)

	run.Unequipped:Connect(function()
		running = false

		if runTrack then
			pcall(function()
				runTrack:Stop(0.1)
			end)
			runTrack = nil
		end

		stopPhantom()
	end)

	run.Parent = Player.Backpack

	table.insert(session.Tools, tp)
	table.insert(session.Tools, run)
end

