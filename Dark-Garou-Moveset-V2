local function fixCharacterTab()
	local gui = Player:FindFirstChild("PlayerGui")
	if not gui then
		return
	end

	local topbar = gui:FindFirstChild("TopbarPlus")
	if not topbar then
		return
	end

	for _, obj in ipairs(topbar:GetDescendants()) do
		if obj.Name ~= "IconButton" then
			continue
		end

		local label = obj:FindFirstChild("IconLabel")
		local image = obj:FindFirstChild("IconImage")

		if label and label:IsA("TextLabel") then
			local current = label.Text

			if current == "Garou"
				or current == "Hero Hunter"
				or current == MOVESET_NAME
			then
				label.Text = MOVESET_NAME

				if image and image:IsA("ImageLabel") then
					image.Image = DECAL_ID
				end
			end
		end
	end
end

