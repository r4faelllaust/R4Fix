local function createRunTool()
	removeOldTool("Dark Garou Run")

	local backpack = Player:WaitForChild(
		"Backpack"
	)

	local tool = Instance.new("Tool")
	tool.Name = "Dark Garou Run"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Phantom Run"
	tool.Parent = backpack

	local moving = false
	local animationTrack

	local function stop()
		moving = false

		local _, humanoid =
			getCharacter()

		if animationTrack then
			pcall(function()
				animationTrack:Stop(0.12)
			end)

			animationTrack = nil
		end

		if humanoid then
			humanoid.AutoRotate = true
		end
	end

	tool.Equipped:Connect(function()
		local character, humanoid, hrp =
			getCharacter()

		if not character
			or not humanoid
			or not hrp
		then
			return
		end

		moving = true

		animationTrack =
			playAnimation(
				humanoid,
				"rbxassetid://18897115785",
				Enum.AnimationPriority.Action
			)

		spawnBurst(
			hrp.CFrame,
			6,
			VOID_PURPLE,
			0.2,
			"run_start"
		)

		task.spawn(function()
			while moving
				and tool.Parent
				and humanoid.Health > 0
			do
				local direction =
					hrp.CFrame.LookVector

				hrp.AssemblyLinearVelocity =
					Vector3.new(
						direction.X
							* CONFIG.RUN_SPEED,
						hrp.AssemblyLinearVelocity.Y,
						direction.Z
							* CONFIG.RUN_SPEED
					)

				task.wait()
			end
		end)
	end)

	tool.Unequipped:Connect(stop)

	tool.AncestryChanged:Connect(
		function(_, parent)
			if not parent then
				stop()
			end
		end
	)

	table.insert(
		SESSION.Tools,
		tool
	)
end

