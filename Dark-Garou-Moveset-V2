local function setSlotName(slotNumber, name, variant)
	local frame = getHotbar()

	if not frame then
		return
	end

	local slot = frame:FindFirstChild(
		tostring(slotNumber)
	)

	local base = slot
		and slot:FindFirstChild("Base")

	if not base then
		return
	end

	local toolName = base:FindFirstChild(
		"ToolName"
	)

	if toolName then
		toolName.Text = name
	end

	local reuse = base:FindFirstChild(
		"Reuse"
	)

	if reuse and variant then
		reuse.Visible = true
		reuse.Text = variant

		local nested =
			reuse:FindFirstChild("Reuse")

		if nested then
			nested.Text = variant
		end
	end
