local function disconnectList(list)
	for _, connection in ipairs(list) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(list)
end

local function trackCharacter(connection)
	table.insert(SESSION.CharacterConnections, connection)
	return connection
end

local function getCharacter()
	local character = Player.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not hrp then
		return nil, nil, nil
	end

	return character, humanoid, hrp
end

local function getAnimator(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

local function loadAnimation(humanoid, id, priority)
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = id

	local ok, result = pcall(function()
		return getAnimator(humanoid):LoadAnimation(animation)
	end)

	animation:Destroy()

	if not ok or not result then
		return nil
	end

	result.Priority = priority or Enum.AnimationPriority.Action

	return result
end

local function playAnimation(
	humanoid,
	id,
	priority,
	speed,
	fade
)
	local track = loadAnimation(humanoid, id, priority)

	if not track then
		return nil
	end

	pcall(function()
		track:Play(
			fade or 0.04,
			1,
			speed or 1
		)
	end)

	return track
end

local function stopTrack(track, fade)
	if track then
		pcall(function()
			track:Stop(fade or 0.06)
		end)

		pcall(function()
			track:Destroy()
		end)
	end
end

local function vfxAllowed(key, cooldown)
	local now = os.clock()
	local last = SESSION.LastVFX[key] or 0

	if now - last < cooldown then
		return false
	end

	SESSION.LastVFX[key] = now
	return true
end

local function getVFXFolder()
	local folder = workspace:FindFirstChild("DarkGarou_VFX")

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "DarkGarou_VFX"
		folder.Parent = workspace
	end

	return folder
end

