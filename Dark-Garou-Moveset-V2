local function removeTool(name)
	local backpack =
		Player:FindFirstChild("Backpack")

	if backpack then
		for _, object in ipairs(
			backpack:GetChildren()
		) do
			if object:IsA("Tool")
				and object.Name == name
			then
				object:Destroy()
			end
		end
	end

	local character =
		Player.Character

	if character then
		for _, object in ipairs(
			character:GetChildren()
		) do
			if object:IsA("Tool")
				and object.Name == name
			then
				object:Destroy()
			end
		end
	end
end

local function createRunTool()
	removeTool(
		"Dark Garou Run"
	)

	local backpack =
		Player:WaitForChild(
			"Backpack"
		)

	local tool = Instance.new("Tool")
	tool.Name = "Dark Garou Run"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "PHANTOM RUN"
	tool.Parent = backpack

	local running = false
	local animationTrack

	tool.Equipped:Connect(
		function()
			local character, humanoid, hrp =
				getCharacter()

			if not character
				or not humanoid
				or not hrp
			then
				return
			end

			running = true

			animationTrack =
				playAnimation(
					humanoid,
					RUN_ANIMATION,
					Enum.AnimationPriority.Action,
					1,
					0.08
				)

			burst(
				hrp.CFrame,
				6,
				PURPLE,
				0.2,
				"run_start"
			)

			task.spawn(function()
				while running
					and tool.Parent
					and humanoid.Health > 0
				do
					local direction =
						humanoid.MoveDirection

					if direction.Magnitude
						< 0.05
					then
						direction =
							hrp.CFrame.LookVector
					end

					hrp.AssemblyLinearVelocity =
						Vector3.new(
							direction.X
								* CONFIG.RUN_SPEED,
							hrp.AssemblyLinearVelocity.Y,
							direction.Z
								* CONFIG.RUN_SPEED
						)

					task.wait()
				end
			end)
		end
	)

	local function stop()
		running = false

		stopTrack(
			animationTrack,
			0.1
		)

		animationTrack = nil
	end

	tool.Unequipped:Connect(stop)

	tool.AncestryChanged:Connect(
		function(_, parent)
			if not parent then
				stop()
			end
		end
	)
end

local function createTeleportTool()
	removeTool(
		"Dark Garou Teleport"
	)

	local backpack =
		Player:WaitForChild(
			"Backpack"
		)

	local tool = Instance.new("Tool")
	tool.Name = "Dark Garou Teleport"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "VOID STEP"
	tool.Parent = backpack

	tool.Activated:Connect(
		function()
			local character, humanoid, hrp =
				getCharacter()

			if not character
				or not humanoid
				or not hrp
			then
				return
			end

			local mouse =
				Player:GetMouse()

			if not mouse
				or not mouse.Hit
			then
				return
			end

			local oldCFrame =
				hrp.CFrame

			burst(
				oldCFrame,
				7,
				PURPLE,
				0.2,
				"tp_depart"
			)

			particles(
				hrp,
				18,
				PURPLE_BRIGHT,
				"tp_depart_particles"
			)

			task.wait(0.04)

			local _, newHumanoid, newHRP =
				getCharacter()

			if not newHumanoid
				or not newHRP
				or newHumanoid.Health <= 0
			then
				return
			end

			local destination =
				mouse.Hit.Position

			local _, y, _ =
				oldCFrame:ToOrientation()

			newHRP.CFrame =
				CFrame.new(
					destination
				)
				* CFrame.Angles(
					0,
					y,
					0
				)

			burst(
				newHRP.CFrame,
				9,
				PURPLE_BRIGHT,
				0.28,
				"tp_arrive"
			)

			shockwave(
				newHRP.CFrame,
				2,
				16,
				PURPLE,
				0.35,
				"tp_ring"
			)

			particles(
				newHRP,
				24,
				PURPLE_BRIGHT,
				"tp_arrive_particles"
			)
		end
	)
end

local function setupTools()
	createRunTool()
	createTeleportTool()
end

-- ================================================================
-- CHARACTER SETUP
-- ================================================================

local function setupCharacter(character)
	SESSION.CharacterToken += 1

	local token =
		SESSION.CharacterToken

	disconnectList(
		SESSION.CharacterConnections
	)

	SESSION.Busy = {}

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local hrp =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not hrp
	then
		return
	end

	applyNight()

	setupOutline(
		character
	)

	setupHands(
		character
	)

	spawnEffect(
		character,
		hrp
	)

	setupMoveHandler(
		character,
		humanoid,
		hrp,
		token
	)

	setupHitSounds()

	-- GUI may load after character.
	task.spawn(function()
		for _ = 1, 30 do
			if token ~= SESSION.CharacterToken then
				return
			end

			fixCharacterTab()
			updateNormalHotbar()
			styleUltimateBar()

			task.wait(0.15)
		end
	end)

	-- GUI refresh protection.
	trackCharacter(
		Player.PlayerGui.DescendantAdded:Connect(
			function()
				task.defer(function()
					if token == SESSION.CharacterToken then
						fixCharacterTab()
						updateNormalHotbar()
						styleUltimateBar()
					end
				end)
			end
		)
	)

	-- Tools are recreated cleanly for this character.
	task.delay(
		0.5,
		function()
			if token == SESSION.CharacterToken then
				setupTools()
			end
		end
	)

	trackCharacter(
		humanoid.Died:Connect(
			function()
				SESSION.Busy = {}
			end
		)
	)
end

