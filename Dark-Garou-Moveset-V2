-- ================================================================
-- CLEANUP
-- ================================================================

local function disconnectAll(list)
	for _, c in ipairs(list) do
		pcall(function()
			c:Disconnect()
		end)
	end

	table.clear(list)
end

local function cleanupCharacter()
	disconnectAll(SESSION.CharacterConnections)

	for _, obj in ipairs(workspace:GetChildren()) do
		if obj.Name == "DarkGarou_VFX" then
			pcall(function()
				obj:Destroy()
			end)
		end
	end
end

local function track(c)
	if c then
		table.insert(SESSION.CharacterConnections, c)
	end
	return c
end

-- ================================================================
-- CHARACTER
-- ================================================================

local function getCharacter()
	local character = Player.Character
	if not character then
		return nil, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not hrp then
		return nil, nil, nil
	end

	return character, humanoid, hrp
end

local function getAnimator(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

local function stopTrack(trackObject)
	if trackObject then
		pcall(function()
			trackObject:Stop(0.05)
			trackObject:Destroy()
		end)
	end
end

local function playAnim(
	humanoid,
	id,
	priority,
	fade,
	speed
)
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	local animator = getAnimator(humanoid)

	local animation = Instance.new("Animation")
	animation.AnimationId = id

	local ok, result = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	animation:Destroy()

	if not ok or not result then
		return nil
	end

	result.Priority = priority or Enum.AnimationPriority.Action
	result.Looped = false

	pcall(function()
		result:Play(fade or 0.06, 1, speed or 1)
	end)

	return result
end

