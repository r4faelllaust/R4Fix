local function setupHitSounds()
	local live = workspace:FindFirstChild("Live")
	if not live then return end
	local function connectTarget(model)
		if not model:IsA("Model") or model == Player.Character then return end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		local lastHealth = humanoid.Health
		track(humanoid.HealthChanged:Connect(function(newHealth)
			if newHealth < lastHealth and model:GetAttribute("LastHit") == Player.Name then
				local now = os.clock()
				local previous = SESSION.LastHit[model] or 0
				if now - previous >= CONFIG.HitSoundCooldown then
					SESSION.LastHit[model] = now
					playHitSound(model)
					local root = model:FindFirstChild("HumanoidRootPart")
					if root then
						heartBurst(root.CFrame, 5, "hit_" .. model.Name, 0.22)
						heartParticles(root, 8, "hitParticles_" .. model.Name, 7)
					end
				end
			end
			lastHealth = newHealth
		end))
	end
	for _, model in ipairs(live:GetChildren()) do connectTarget(model) end
	track(live.ChildAdded:Connect(function(model) task.wait(0.05); connectTarget(model) end))
end

local function fixCharacterTab()
	local topbar = PlayerGui:FindFirstChild("TopbarPlus")
	if not topbar then return end
	for _, descendant in ipairs(topbar:GetDescendants()) do
		if descendant.Name == "IconButton" then
			local label = descendant:FindFirstChild("IconLabel")
			local image = descendant:FindFirstChild("IconImage")
			if label then
				local current = label.Text
				if current == "Hero Hunter" or current == "Garou" or current == "Dark Garou" or current == MOVESET_NAME then
					label.Text = MOVESET_NAME
					if image then image.Image = DECAL_ID end
				end
			end
		end
	end
end

local function findSlot(number)
	local hotbar = PlayerGui:FindFirstChild("Hotbar")
	if not hotbar then return nil end
	local backpack = hotbar:FindFirstChild("Backpack")
	if not backpack then return nil end
	local frame = backpack:FindFirstChild("Hotbar")
	if not frame then return nil end
	local slot = frame:FindFirstChild(tostring(number))
	if not slot then return nil end
	return slot:FindFirstChild("Base") or slot
end

local function setMoveName(number, name, label)
	local slot = findSlot(number)
	if not slot then return end
	local toolName = slot:FindFirstChild("ToolName")
	if toolName then toolName.Text = name end
	if label then
		local reuse = slot:FindFirstChild("Reuse")
		if reuse then
			reuse.Visible = true
			if reuse:IsA("TextLabel") or reuse:IsA("TextButton") then reuse.Text = label end
			local nested = reuse:FindFirstChild("Reuse")
			if nested and (nested:IsA("TextLabel") or nested:IsA("TextButton")) then nested.Text = label end
		end
	end
end

