local function disconnect(list)
	for _, connection in ipairs(list) do pcall(function() connection:Disconnect() end) end
	table.clear(list)
end
local function track(connection)
	if connection then table.insert(SESSION.CharacterConnections, connection) end
	return connection
end

local function getCharacter()
	local character = Player.Character
	if not character then return nil, nil, nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then return nil, nil, nil end
	return character, humanoid, root
end

local function getAnimator(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then animator = Instance.new("Animator"); animator.Parent = humanoid end
	return animator
end

local function playAnimation(humanoid, id, priority, fade, speed)
	if not humanoid or humanoid.Health <= 0 then return nil end
	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local animator = getAnimator(humanoid)
	local success, result = pcall(function() return animator:LoadAnimation(animation) end)
	animation:Destroy()
	if not success or not result then return nil end
	result.Priority = priority or Enum.AnimationPriority.Action
	pcall(function() result:Play(fade or 0.05, 1, speed or 1) end)
	return result
end

local function getVFXFolder()
	local folder = workspace:FindFirstChild("MaiSakurajima_VFX")
	if not folder then folder = Instance.new("Folder"); folder.Name = "MaiSakurajima_VFX"; folder.Parent = workspace end
	return folder
end

local function allowed(key, cooldown)
	local now = os.clock()
	local last = SESSION.LastVFX[key] or 0
	if now - last < cooldown then return false end
	SESSION.LastVFX[key] = now
	return true
end

local function heartParticles(parent, amount, key, speed)
	if not parent or not parent.Parent then return end
	if key and not allowed(key, CONFIG.VFXCooldown) then return end
	local attachment = Instance.new("Attachment")
	attachment.Name = "MaiHeartParticles"
	attachment.Parent = parent
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, LIGHT_PINK), ColorSequenceKeypoint.new(0.35, PINK),
		ColorSequenceKeypoint.new(0.75, HOT_PINK), ColorSequenceKeypoint.new(1, RED),
	})
	emitter.LightEmission = 0.8
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.35, 0.85)
	emitter.Speed = NumberRange.new(speed or 4, (speed or 4) + 7)
	emitter.SpreadAngle = Vector2.new(360, 360)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(0.35, 0.75), NumberSequenceKeypoint.new(1, 0)})
	emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.7, 0.25), NumberSequenceKeypoint.new(1, 1)})
	emitter.Parent = attachment
	pcall(function() emitter:Emit(amount or 12) end)
	Debris:AddItem(attachment, 1.2)
end

local function heartBurst(cframe, size, key, duration)
	if key and not allowed(key, CONFIG.VFXCooldown) then return end
