			name
	end

	if label then

		local reuse =
			slot:FindFirstChild(
				"Reuse"
			)

		if reuse then

			reuse.Visible =
				true

			if
				reuse:IsA("TextLabel")
				or reuse:IsA("TextButton")
			then
				reuse.Text =
					label
			end

			local nested =
				reuse:FindFirstChild(
					"Reuse"
				)

			if nested
				and (
					nested:IsA("TextLabel")
					or nested:IsA("TextButton")
				)
			then
				nested.Text =
					label
			end
		end
	end
