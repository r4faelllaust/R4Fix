local function disconnect(list)
	for _, connection in ipairs(list) do pcall(function() connection:Disconnect() end) end
	table.clear(list)
end
local function track(connection)
	if connection then table.insert(SESSION.CharacterConnections, connection) end
	return connection
end

local function getAnimator(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then animator = Instance.new("Animator"); animator.Parent = humanoid end
	return animator
end

local function playAnimation(humanoid, id, priority, fade, speed)
	if not humanoid or humanoid.Health <= 0 then return nil end
	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local animator = getAnimator(humanoid)
	local success, result = pcall(function() return animator:LoadAnimation(animation) end)
	animation:Destroy()
	if not success or not result then return nil end
	result.Priority = priority or Enum.AnimationPriority.Action
	result.Looped = false -- FIX: never let these silently loop past their window
	pcall(function() result:Play(fade or 0.05, 1, speed or 1) end)
	return result
end

-- helper: play + guaranteed hard stop after `duration`
local function playAnimationCapped(humanoid, id, priority, duration, fade, speed)
	local trackResult = playAnimation(humanoid, id, priority, fade, speed)
	if trackResult and duration then
		task.delay(duration, function()
			pcall(function() if trackResult.IsPlaying then trackResult:Stop(0.08) end end)
		end)
	end
	return trackResult
end

local function getVFXFolder()
