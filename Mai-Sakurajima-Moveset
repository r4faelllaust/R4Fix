	if not hotbar then
		return nil
	end

	local backpack =
		hotbar:FindFirstChild(
			"Backpack"
		)

	if not backpack then
		return nil
	end

	local frame =
		backpack:FindFirstChild(
			"Hotbar"
		)

	if not frame then
		return nil
	end

	local slot =
		frame:FindFirstChild(
			tostring(number)
		)

	if not slot then
