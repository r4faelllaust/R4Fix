local function heartParticles(
	parent,
	amount,
	key,
	speed
)
	if not parent or not parent.Parent then
		return
	end

	if key and not allowed(
		key,
		CONFIG.VFXCooldown
	) then
		return
	end

	local comboMultiplier =
		1 + (SESSION.ComboCount * 0.15)

	local attachment = Instance.new("Attachment")
	attachment.Name = "MaiHeartParticles"
	attachment.Parent = parent

	local emitter = Instance.new("ParticleEmitter")

