-- FIXED music installer: binary-safer request() first, diagnostics added
local function getMusic()
	local existing = PlayerGui:FindFirstChild("MaiSakurajima_BGM")
	if existing and existing:IsA("Sound") then return existing end
	local sound = Instance.new("Sound")
	sound.Name = "MaiSakurajima_BGM"
	sound.Volume = MUSIC_VOLUME
	sound.Looped = true
	sound.Parent = PlayerGui
	return sound
end

local function looksLikeAudio(data)
	if not data or #data < 4 then return false end
	return data:sub(1, 3) == "ID3" or data:byte(1) == 0xFF
end

local function fetchBinary()
	-- Try request()/http_request()/syn.request first — some executors
	-- mangle binary through HttpGet specifically but not through these.
	local requestFn = (syn and syn.request) or (getgenv and getgenv().request) or (getgenv and getgenv().http_request)
	if requestFn then
		local ok, response = pcall(function()
			return requestFn({Url = MUSIC_URL, Method = "GET"})
		end)
		if ok and response and response.Body then
			print("[Mai Music] request() succeeded, body length:", #response.Body)
			return response.Body
		else
			print("[Mai Music] request() failed or returned no body, falling back to HttpGet")
		end
	else
		print("[Mai Music] no request()/http_request() available, using HttpGet")
	end

	local ok, data = pcall(function() return game:HttpGet(MUSIC_URL) end)
	if ok then
		print("[Mai Music] HttpGet succeeded, body length:", data and #data or 0)
		return data
	else
		print("[Mai Music] HttpGet failed:", tostring(data))
		return nil
	end
end

local function installMusic()
	local sound = getMusic()
	local asset

	if getcustomasset then
		local ok, existingAsset = pcall(getcustomasset, MUSIC_FILE)
		if ok then asset = existingAsset end
	end

	if not asset then
		local data = fetchBinary()
		if data then
			if #data > 5 * 1024 * 1024 then
				warn("[Mai Music] Downloaded file is over 5MB (" .. #data .. " bytes) — some executors cap HttpGet/request response size around here. If music still fails, this is likely why.")
			end
			if looksLikeAudio(data) then
				local writeSuccess = pcall(function() writefile(MUSIC_FILE, data) end)
				print("[Mai Music] writefile success:", writeSuccess)
				if writeSuccess and getcustomasset then
					local assetSuccess, assetResult = pcall(function() return getcustomasset(MUSIC_FILE) end)
					print("[Mai Music] getcustomasset success:", assetSuccess, "result:", tostring(assetResult))
					if assetSuccess then asset = assetResult end
				end
			else
				local firstBytes = ""
				for i = 1, math.min(8, #data) do firstBytes = firstBytes .. string.format("%02X ", data:byte(i)) end
				warn("[Mai Music] Downloaded data does NOT look like audio (first bytes: " .. firstBytes .. "). Likely got HTML/redirect page instead of the mp3. Music will not play.")
			end
		end
	end

	if asset then
		sound.SoundId = asset
		print("[Mai Music] SoundId set, attempting play")
	else
		warn("[Mai Music] Could not obtain a playable asset — see warnings above.")
		return
	end

	sound.Looped = true
	sound.Volume = MUSIC_VOLUME
	if not sound.IsPlaying then
		local playOk = pcall(function() sound:Play() end)
		print("[Mai Music] sound:Play() success:", playOk, "IsPlaying:", sound.IsPlaying)
	end
end

