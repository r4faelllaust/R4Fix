local function getMusic()
	local existing =
		PlayerGui:FindFirstChild(
			"MaiSakurajima_BGM"
		)

	if existing and existing:IsA("Sound") then
		existing.Volume = MUSIC_VOLUME
		existing.Looped = true

		return existing
	end

	local sound =
		Instance.new("Sound")

	sound.Name =
		"MaiSakurajima_BGM"

	sound.Volume =
		MUSIC_VOLUME

	sound.Looped = true

	sound.Parent =
		PlayerGui

	return sound
end

local function looksLikeAudio(data)
	if not data or #data < 4 then
		return false
	end

	return
		data:sub(1, 3) == "ID3"
		or data:byte(1) == 0xFF
end

local function fetchBinary()

	local requestFn =
		(syn and syn.request)
		or (getgenv and getgenv().request)
		or (getgenv and getgenv().http_request)

	if requestFn then

		local ok, response =
			pcall(function()
				return requestFn({
					Url = MUSIC_URL,
					Method = "GET",
				})
			end)

		if ok
			and response
			and response.Body then

			print(
				"[Mai Music] request() succeeded:",
				#response.Body
			)

			return response.Body
		end
	end

	local ok, data =
		pcall(function()
			return game:HttpGet(
				MUSIC_URL
			)
		end)

	if ok then
		print(
			"[Mai Music] HttpGet succeeded:",
			data and #data or 0
		)

		return data
	end

	warn(
		"[Mai Music] HttpGet failed:",
		tostring(data)
	)

	return nil
end

local function installMusic()

	local sound =
		getMusic()

	local asset

	if getcustomasset then

		local ok, existingAsset =
			pcall(
				getcustomasset,
				MUSIC_FILE
			)

		if ok then
			asset = existingAsset
		end
	end

	if not asset then

		local data =
			fetchBinary()

		if data
			and looksLikeAudio(data) then

			local writeSuccess =
				pcall(function()
					writefile(
						MUSIC_FILE,
						data
					)
				end)

			if writeSuccess
				and getcustomasset then

				local assetSuccess,
					assetResult =
					pcall(function()
						return getcustomasset(
							MUSIC_FILE
						)
					end)

				if assetSuccess then
					asset = assetResult
				end
			end
		else
			warn(
				"[Mai Music] Downloaded data is not valid MP3 data."
			)
		end
	end

	if not asset then
		warn(
			"[Mai Music] Could not obtain playable music asset."
		)

		return
	end

	sound.SoundId = asset
	sound.Looped = true
	sound.Volume = MUSIC_VOLUME

	pcall(function()
		if not sound.IsPlaying then
			sound:Play()
		end
	end)

	print(
		"[Mai Music] Playing at volume:",
		MUSIC_VOLUME
	)
end

