	return sound
end

local function looksLikeAudio(data)
	if not data or #data < 4 then return false end
	local head = data:sub(1, 3)
	-- ID3 tag (most mp3s) or raw MPEG frame sync bytes
	return head == "ID3" or data:byte(1) == 0xFF
end

local function installMusic()
	local sound = getMusic()
	local asset

	if getcustomasset then
		local ok, existingAsset = pcall(getcustomasset, MUSIC_FILE)
		if ok then asset = existingAsset end
	end

	if not asset then
		local success, data = pcall(function() return game:HttpGet(MUSIC_URL) end)
		if success and looksLikeAudio(data) then
			local writeSuccess = pcall(function() writefile(MUSIC_FILE, data) end)
			if writeSuccess and getcustomasset then
				local assetSuccess, assetResult = pcall(function() return getcustomasset(MUSIC_FILE) end)
				if assetSuccess then asset = assetResult end
			end
		elseif success and not looksLikeAudio(data) then
			warn("[Mai Sakurajima] Downloaded file doesn't look like audio (likely got HTML/redirect instead of the mp3). Music will not play.")
		end
	end

	if asset then
		sound.SoundId = asset
	else
		warn("[Mai Sakurajima] Music asset could not be loaded — see warning above if present.")
		return
	end

	sound.Looped = true
	sound.Volume = MUSIC_VOLUME
	if not sound.IsPlaying then pcall(function() sound:Play() end) end
end

