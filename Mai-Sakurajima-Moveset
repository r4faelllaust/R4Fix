	TweenService:Create(light, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Brightness = 0, Range = 0}):Play()
	Debris:AddItem(light, 1)
end

local function setupMoveHandler(character, humanoid, root, token)
	track(humanoid.AnimationPlayed:Connect(function(animationTrack)
		if token ~= SESSION.CharacterToken then return end
		if not animationTrack or not animationTrack.Animation then return end
		local id = animationTrack.Animation.AnimationId

		local m1Replacement = M1_TRIGGERS[id]
		if m1Replacement then
			pcall(function() animationTrack:Stop() end)
			playAnimation(humanoid, m1Replacement, Enum.AnimationPriority.Action)
			heartParticles(root, 4, "m1_" .. id, 4)
			return
		end

		if id == SLOT1_ID then
			pcall(function() animationTrack:Stop() end)
			playAnimation(humanoid, MOVE1_ANIMATION, Enum.AnimationPriority.Action)
			heartBurst(root.CFrame, 8, "move1", 0.3)
			loveRing(root.CFrame, 2, 20, "move1ring")
			heartParticles(root, 28, "move1particles", 7)
			return
		end

		if id == SLOT2_ID then
			pcall(function() animationTrack:Stop() end)
			playAnimationCapped(humanoid, MOVE2_ANIMATION, Enum.AnimationPriority.Action, CONFIG.Move2AnimationLength, 0.03, 1)
			heartBurst(root.CFrame, 9, "move2", 0.25)
			loveRing(root.CFrame, 2, 24, "move2ring")
			heartParticles(root, 35, "move2particles", 8)
			return
		end

		if id == SLOT3_ID then
			pcall(function() animationTrack:Stop() end)
			local state = humanoid:GetState()
			local airborne = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
			playAnimation(humanoid, airborne and MOVE3_AIR or MOVE3_GROUND, Enum.AnimationPriority.Action)
			heartBurst(root.CFrame, 11, "move3", 0.35)
			loveRing(root.CFrame, 3, 30, "move3ring")
			heartParticles(root, 45, "move3particles", 8)
			return
		end

		if id == SLOT4_ID then
			pcall(function() animationTrack:Stop() end)
			playAnimationCapped(humanoid, MOVE4_ANIMATION, Enum.AnimationPriority.Action, CONFIG.Move4AnimationLength)
			heartBurst(root.CFrame, 14, "move4", 0.4)
			loveRing(root.CFrame, 4, 38, "move4ring")
			heartParticles(root, 60, "move4particles", 10)
			chaosBurstSeries(root.CFrame, "move4")
			return
		end

		if id == SPECIAL_ID then
			pcall(function() animationTrack:Stop() end)
			playAnimationCapped(humanoid, SPECIAL_ANIMATION, Enum.AnimationPriority.Action, CONFIG.SpecialAnimationLength)
			heartParticles(root, 30, "specialParticles", 7)
			return
		end

		if id == ULT1_TRIGGER then
			pcall(function() animationTrack:Stop() end)
			SESSION.IsUlted = true
			playAnimationCapped(humanoid, ULT1_ANIMATION, Enum.AnimationPriority.Action4, CONFIG.UltAnimationLength)
			ultimateEffect(root, 22, 48, "ult1")
			return
		end

		if id == ULT2_TRIGGER then
			pcall(function() animationTrack:Stop() end)
			playAnimationCapped(humanoid, ULT2_ANIMATION, Enum.AnimationPriority.Action4, CONFIG.UltAnimationLength)
			ultimateEffect(root, 25, 50, "ult2")
			return
		end

		if id == ULT3_TRIGGER then
			pcall(function() animationTrack:Stop() end)
			playAnimationCapped(humanoid, ULT3_ANIMATION, Enum.AnimationPriority.Action4, CONFIG.UltAnimationLength)
			ultimateEffect(root, 28, 55, "ult3")
			return
		end
	end))

	-- FIX: detect actual ult state via the game's own attribute + tool,
	-- rather than guessing from animation triggers alone
	track(character:GetAttributeChangedSignal("Ulted"):Connect(function()
		SESSION.IsUlted = character:GetAttribute("Ulted") and true or false
	end))
	track(Player.Backpack.ChildAdded:Connect(function(tool)
		if tool.Name == "Death Counter" then SESSION.IsUlted = true end
	end))
end

local function setupIdle(character, humanoid, token)
	local started = os.clock()
	local idleTrack

	local anim = Instance.new("Animation")
	anim.AnimationId = IDLE_EMOTE
	local ok, loaded = pcall(function() return getAnimator(humanoid):LoadAnimation(anim) end)
	if ok then idleTrack = loaded; idleTrack.Priority = Enum.AnimationPriority.Idle; idleTrack.Looped = true end

	track(RunService.RenderStepped:Connect(function()
		if token ~= SESSION.CharacterToken then return end
		if not character.Parent or humanoid.Health <= 0 then return end
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local moving = humanoid.MoveDirection.Magnitude > 0.05
		local state = humanoid:GetState()
		local airborne = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall

		if idleTrack then
			if (moving or airborne) and idleTrack.IsPlaying then
				idleTrack:Stop(0.2)
			elseif not moving and not airborne and not idleTrack.IsPlaying then
				idleTrack:Play(0.2)
			end
		end

		if not moving and not airborne and os.clock() - started > 0.55 then
			heartParticles(root, 1, "idleHeart", 1)
		end
	end))
end

local function setupCharacter(character)
	SESSION.CharacterToken += 1
	local token = SESSION.CharacterToken
	SESSION.IsUlted = false
	SESSION.ComboCount = 0

	disconnect(SESSION.CharacterConnections)

	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then return end

	spawnEffect(character, root)
	createLoveAura(root)
	createSakuraTrail(character)
	setupHandGlow(character)

	for _, obj in ipairs(character:GetDescendants()) do neutralizeGarouTrail(obj) end
	track(character.DescendantAdded:Connect(function(obj) task.defer(function() neutralizeGarouTrail(obj) end) end))

	setupIdle(character, humanoid, token)
	setupMoveHandler(character, humanoid, root, token)
	setupHitSounds()

	humanoid.Died:Connect(function() SESSION.IsUlted = false end)

	task.spawn(function()
		for _ = 1, 25 do
			if token ~= SESSION.CharacterToken then return end
			fixCharacterTab()
			refreshHotbar() -- FIX: state-aware now
			styleUltimateBar()
			task.wait(0.15)
		end
	end)
end

