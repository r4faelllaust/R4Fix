-- NEW: neutralize Garou's own blue trail -> pink/red (fixes #2)
local function neutralizeGarouTrail(obj)
	local isOurs = string.match(obj.Name, "^Mai") or obj.Name == "MaiSakuraTrail"
	if isOurs then return end
	local isXd = obj.Name == "xd"
	local isEffectType = obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("ParticleEmitter")
	if not (isXd or isEffectType) then return end
	pcall(function()
		local grad = ColorSequence.new(HOT_PINK, RED)
		if obj:IsA("Trail") or obj:IsA("Beam") then
			obj.Color = grad
			if obj:IsA("Trail") then obj.LightEmission = 0.5 end
		elseif obj:IsA("ParticleEmitter") then
			obj.Color = grad
			obj.LightEmission = 0.5
		end
	end)
end

