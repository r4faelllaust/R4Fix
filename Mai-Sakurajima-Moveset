	local token = SESSION.CharacterToken

	disconnect(SESSION.CharacterConnections)

	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then return end

	spawnEffect(character, root)
	createLoveAura(root)
	setupHandGlow(character)
	setupIdle(character, humanoid, token)
	setupMoveHandler(character, humanoid, root, token)
	setupHitSounds()

	task.spawn(function()
		for _ = 1, 25 do
			if token ~= SESSION.CharacterToken then return end
			fixCharacterTab()
			refreshNormalHotbar()
			styleUltimateBar()
			task.wait(0.15)
		end
	end)
end

if not SESSION.Initialized then
	SESSION.Initialized = true

	table.insert(SESSION.Connections, Player.CharacterAdded:Connect(function(character)
		task.wait(0.2)
		setupCharacter(character)
		task.defer(function() installMusic() end) -- music intentionally survives death, not recreated
	end))

	table.insert(SESSION.Connections, RunService.Heartbeat:Connect(function()
		pcall(function()
			fixCharacterTab()
			refreshNormalHotbar()
			styleUltimateBar()
		end)
	end))

	PlayerGui.DescendantAdded:Connect(function()
		task.defer(function()
			fixCharacterTab()
			refreshNormalHotbar()
			styleUltimateBar()
		end)
	end)
end

if Player.Character then
	task.spawn(function() setupCharacter(Player.Character) end)
else
	task.spawn(function() setupCharacter(Player.CharacterAdded:Wait()) end)
end

task.spawn(function()
	task.wait(0.5)
	installMusic()
	while Player.Parent do
		task.wait(3)
		local sound = PlayerGui:FindFirstChild("MaiSakurajima_BGM")
		if sound and sound:IsA("Sound") and not sound.IsPlaying then
			pcall(function() sound:Play() end)
		end
	end
end)

task.spawn(function()
	while Player.Parent do
		pcall(function()
			fixCharacterTab()
			refreshNormalHotbar()
			styleUltimateBar()
		end)
		task.wait(0.75)
	end
end)

