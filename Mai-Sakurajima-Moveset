local function allowed(key, cooldown)
	local now = os.clock()
	local last = SESSION.LastVFX[key] or 0
	if now - last < cooldown then return false end
	SESSION.LastVFX[key] = now
	return true
end

-- combo escalation: more hearts / faster rings the more you're hitting in a row
local function registerCombo()
	local now = os.clock()
	if now - SESSION.LastHitTime <= CONFIG.ComboWindow then
		SESSION.ComboCount = math.min(SESSION.ComboCount + 1, 8)
	else
		SESSION.ComboCount = 1
	end
	SESSION.LastHitTime = now
	return SESSION.ComboCount
end

local function heartParticles(parent, amount, key, speed)
	if not parent or not parent.Parent then return end
	if key and not allowed(key, CONFIG.VFXCooldown) then return end
	local comboMultiplier = 1 + (SESSION.ComboCount * 0.15)
	local attachment = Instance.new("Attachment")
	attachment.Name = "MaiHeartParticles"
	attachment.Parent = parent
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, LIGHT_PINK), ColorSequenceKeypoint.new(0.35, PINK),
		ColorSequenceKeypoint.new(0.75, HOT_PINK), ColorSequenceKeypoint.new(1, RED),
	})
	emitter.LightEmission = 0.8
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.35, 0.85)
	emitter.Speed = NumberRange.new((speed or 4) * comboMultiplier, ((speed or 4) + 7) * comboMultiplier)
	emitter.SpreadAngle = Vector2.new(360, 360)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(0.35, 0.75), NumberSequenceKeypoint.new(1, 0)})
	emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.7, 0.25), NumberSequenceKeypoint.new(1, 1)})
	emitter.Parent = attachment
	pcall(function() emitter:Emit(math.floor((amount or 12) * comboMultiplier)) end)
	Debris:AddItem(attachment, 1.2)
end

local function heartBurst(cframe, size, key, duration)
	if key and not allowed(key, CONFIG.VFXCooldown) then return end
	local part = Instance.new("Part")
	part.Name = "MaiHeartBurst"
	part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false; part.CastShadow = false
	part.Material = Enum.Material.Neon; part.Shape = Enum.PartType.Ball
	part.Color = PINK; part.Transparency = 0.15; part.Size = Vector3.one; part.CFrame = cframe
	part.Parent = getVFXFolder()
	local light = Instance.new("PointLight")
	light.Color = PINK; light.Brightness = 4; light.Range = 12; light.Parent = part
	TweenService:Create(part, TweenInfo.new(duration or 0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{Size = Vector3.new(size, size, size), Transparency = 1}):Play()
	TweenService:Create(light, TweenInfo.new(duration or 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Brightness = 0}):Play()
	Debris:AddItem(part, (duration or 0.35) + 0.1)
