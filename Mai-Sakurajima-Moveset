local function setupIdle(
	character,
	humanoid,
	token
)

	local started =
		os.clock()

	local idleTrack

	local anim =
		Instance.new("Animation")

	anim.AnimationId =
		IDLE_EMOTE

	local ok, loaded =
		pcall(function()

			return getAnimator(
				humanoid
			):LoadAnimation(anim)

		end)

	anim:Destroy()

	if ok then

		idleTrack =
			loaded

		idleTrack.Priority =
			Enum.AnimationPriority.Idle

		idleTrack.Looped =
			true
	end

	track(
		RunService.RenderStepped:Connect(
			function()

				if
					token ~= SESSION.CharacterToken
				then
					return
				end

				if
					not character.Parent
					or humanoid.Health <= 0
				then
					return
				end

				local root =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if not root then
					return
				end

				local moving =
					humanoid.MoveDirection.Magnitude
					> 0.05

				local state =
					humanoid:GetState()

				local airborne =
					state ==
					Enum.HumanoidStateType.Jumping
					or state ==
					Enum.HumanoidStateType.Freefall

				if idleTrack then

					if
						(moving or airborne)
						and idleTrack.IsPlaying
					then

						idleTrack:Stop(
							0.2
						)

					elseif
						not moving
						and not airborne
						and not idleTrack.IsPlaying
					then

						idleTrack:Play(
							0.2
						)
					end
				end

				if
					not moving
					and not airborne
					and os.clock() - started > 0.55
				then

					heartParticles(
						root,
						1,
						"idleHeart",
						1
					)
				end
			end
		)
	)
end

-- ================================================================
-- HUNTER / GAROU FORCE
-- ================================================================

local function forceHunterCharacter(
	character
)

	-- Already Hunter, nothing to do.
	if Player:GetAttribute(
		"Character"
	) == "Hunter" then

		return character
	end

	local communicate =
		character:FindFirstChild(
			"Communicate"
		)

	if not communicate then

		communicate =
			character:WaitForChild(
				"Communicate",
				5
			)
	end

	if not communicate then
		warn(
			"[Mai] Communicate was not found. Could not force Hunter."
		)

		return character
	end

	-- ============================================================
	-- THIS IS THE IMPORTANT FIX
	-- ============================================================

	local fired = pcall(function()

		(communicate :: any):FireServer({
			Goal = "Change Character",
			Character = "Hunter",
		})

	end)

	if not fired then

		warn(
			"[Mai] Failed to request Hunter character."
		)

		return character
	end

	-- Give the game time to actually replace the character.
	local deadline =
		os.clock() + 3

	while
		os.clock() < deadline
	do

		if
			Player:GetAttribute(
				"Character"
			) == "Hunter"
		then

			break
		end

		task.wait(0.05)
	end

	-- Wait for Roblox/game to create the replacement.
	local newCharacter =
		Player.Character

	if
		newCharacter
		and newCharacter ~= character
	then

		local newHumanoid =
			newCharacter:FindFirstChild(
				"Humanoid"
			)

		local newRoot =
			newCharacter:FindFirstChild(
				"HumanoidRootPart"
			)

		if
			newHumanoid
			and newRoot
		then

			return newCharacter
		end
	end

	-- Sometimes the Character object is reused.
	return Player.Character or character
end

-- ================================================================
-- CHARACTER SETUP
-- ================================================================

local function setupCharacter(
	character
)

	SESSION.CharacterToken += 1

	local token =
		SESSION.CharacterToken

	SESSION.IsUlted =
		false

	SESSION.ComboCount =
		0

	disconnect(
		SESSION.CharacterConnections
	)

	-- ============================================================
	-- IMPORTANT:
	-- FORCE HUNTER BEFORE INSTALLING MOVESET HOOKS
	-- ============================================================

	local actualCharacter =
		forceHunterCharacter(
			character
		)

	-- Character may have changed.
	if
		actualCharacter ~= character
	then

		character =
			actualCharacter
	end

	-- Make sure we did not get replaced again
	-- while waiting for the Hunter swap.
	if token ~= SESSION.CharacterToken then
		return
	end

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if
		not humanoid
		or not root
	then

		warn(
			"[Mai] Character setup failed: Humanoid/Root missing."
		)

		return
	end

	-- ============================================================
	-- MAI SETUP
	-- ============================================================

	spawnEffect(
		character,
		root
	)

	createLoveAura(
		root
	)

	createSakuraTrail(
		character
	)

	setupHandGlow(
		character
	)

	for _, obj in ipairs(
		character:GetDescendants()
	) do

		neutralizeGarouTrail(
			obj
		)
	end

	track(
		character.DescendantAdded:Connect(
			function(obj)

				task.defer(
					function()
						neutralizeGarouTrail(
							obj
						)
					end
				)
			end
		)
	)

	setupIdle(
		character,
		humanoid,
		token
	)

	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)

	setupHitSounds()

	track(
		humanoid.Died:Connect(
			function()

				SESSION.IsUlted =
					false

			end
		)
	)

	task.spawn(function()

		for _ = 1, 25 do

			if
				token ~= SESSION.CharacterToken
			then
				return
			end

			fixCharacterTab()
			refreshHotbar()
			styleUltimateBar()

			task.wait(
				0.15
			)
		end
	end)
end

