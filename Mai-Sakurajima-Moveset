	part.Color = PINK; part.Transparency = 0.15; part.Size = Vector3.one; part.CFrame = cframe
	part.Parent = getVFXFolder()
	local light = Instance.new("PointLight")
	light.Color = PINK; light.Brightness = 4; light.Range = 12; light.Parent = part
	TweenService:Create(part, TweenInfo.new(duration or 0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{Size = Vector3.new(size, size, size), Transparency = 1}):Play()
