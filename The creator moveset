local function phantomEngine(
	duration,
	speed,
	token
)
	local character, humanoid, hrp =
		getCharacter()

	if not character
		or not humanoid
		or not hrp
	then
		return false
	end

	if token ~= S.Token
		or humanoid.Health <= 0
	then
		return false
	end

	local velocity =
		Instance.new("BodyVelocity")

	velocity.Name =
		"Creator_PhantomEngine"

	velocity.MaxForce =
		Vector3.new(
			5000000,
			0,
			5000000
		)

	velocity.P = 100000

	velocity.Parent = hrp

	local attachment0 =
		Instance.new("Attachment")

	attachment0.Position =
		Vector3.new(-1, 0, 0)

	attachment0.Parent = hrp

	local attachment1 =
		Instance.new("Attachment")

	attachment1.Position =
		Vector3.new(1, 0, 0)

	attachment1.Parent = hrp

	local trail =
		Instance.new("Trail")

	trail.Attachment0 =
		attachment0

	trail.Attachment1 =
		attachment1

	trail.Lifetime = 0.3

	trail.LightEmission = 1

	trail.Color =
		ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				BRIGHT_GREEN
			),

			ColorSequenceKeypoint.new(
				0.5,
				GREEN
			),

			ColorSequenceKeypoint.new(
				1,
				BLACK
			),
		})

	trail.Transparency =
		NumberSequence.new(
			0.05,
			1
		)

	trail.Parent = hrp

	local start =
		os.clock()

	createSphere(
		hrp.CFrame,
		3,
		12,
		BLACK,
		0.2,
		0.1
	)

	createRing(
		hrp.CFrame,
		2,
		23,
		BRIGHT_GREEN,
		0.3
	)

	while os.clock() - start < duration do
		if token ~= S.Token
			or not hrp.Parent
			or humanoid.Health <= 0
		then
			break
		end

		local direction =
			hrp.CFrame.LookVector

		velocity.Velocity =
			Vector3.new(
				direction.X * speed,
				0,
				direction.Z * speed
			)

		createAfterimage(character)

		task.wait()
	end

	pcall(function()
		velocity:Destroy()
		attachment0:Destroy()
		attachment1:Destroy()
		trail:Destroy()
	end)

	if hrp.Parent then
		createSphere(
