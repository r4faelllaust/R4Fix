-- ============================================================
-- TARGET VALIDATION
-- ============================================================

local function validTarget(model)
	if not model then
		return false
	end

	if model == Player.Character then
		return false
	end

	if not model:IsA("Model") then
		return false
	end

	local humanoid =
		model:FindFirstChildOfClass("Humanoid")

	local root =
		model:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return true
end

-- ============================================================
-- CLOSEST TARGET
-- ============================================================

local function getClosestTarget(maxDistance)
	local character, humanoid, root =
		getCharacter()

	if not character or not humanoid or not root then
		return nil
	end

	local closest = nil
	local closestDistance =
		maxDistance or CFG.TARGET_RANGE

	local live = workspace:FindFirstChild("Live")

	local searchRoot = live or workspace

	for _, object in ipairs(
		searchRoot:GetChildren()
	) do

		if validTarget(object) then

			local targetRoot =
				object:FindFirstChild(
					"HumanoidRootPart"
				)

			if targetRoot then

				local distance =
					(
						targetRoot.Position
						- root.Position
					).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closest = object
				end
			end
		end
	end

	return closest
end

-- ============================================================
-- VOID TP BEHIND TARGET
-- ============================================================

local function voidTeleportBehind(
	target,
	distance
)
	local character, humanoid, root =
		getCharacter()

	if not character or not humanoid or not root then
		return false
	end

	if not validTarget(target) then
		return false
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot then
		return false
	end

	local tpDistance =
		distance or CFG.M1_TP_DISTANCE

	-- Behind the enemy based on their current facing.
	local behindPosition =
		targetRoot.Position
		- targetRoot.CFrame.LookVector
		* tpDistance

	local destination =
		Vector3.new(
			behindPosition.X,
			targetRoot.Position.Y,
			behindPosition.Z
		)

	local lookAt =
		Vector3.new(
			targetRoot.Position.X,
			destination.Y,
			targetRoot.Position.Z
		)

	creatorBurst(
		root.CFrame,
		7,
		PURPLE,
		0.18,
		"void_depart"
	)

	creatorParticles(
		root,
		18,
		BRIGHT_PURPLE,
		"void_depart_particles"
	)

	-- Tiny delay makes the departure VFX visible.
	task.wait(0.025)

	if not root.Parent then
		return false
	end

	root.CFrame =
		CFrame.lookAt(
			destination,
			lookAt
		)

	root.AssemblyLinearVelocity =
		Vector3.zero

	creatorBurst(
		root.CFrame,
		9,
		BRIGHT_PURPLE,
		0.22,
		"void_arrive"
	)

	creatorRing(
		root.CFrame,
		1.5,
		15,
		PURPLE,
		0.25,
		"void_arrive_ring"
	)

	creatorParticles(
		root,
		25,
		GLITCH_GREEN,
		"void_arrive_particles"
	)

	return true
end

-- ============================================================
-- PHANTOM ENGINE
-- ============================================================

local function phantomEngine(
	duration,
	speed,
	token
)
	local character, humanoid, root =
		getCharacter()

	if not character or not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if token ~= S.Token then
		return false
	end

	local velocity =
		Instance.new("BodyVelocity")

	velocity.Name =
		"Creator_PhantomEngine"

	velocity.MaxForce =
		Vector3.new(
			5000000,
			0,
			5000000
		)

	velocity.P = 60000

	velocity.Parent = root

	local attachment0 =
		Instance.new("Attachment")

	attachment0.Position =
		Vector3.new(-1.15, 0, 0)

	attachment0.Parent = root

	local attachment1 =
		Instance.new("Attachment")

	attachment1.Position =
		Vector3.new(1.15, 0, 0)

	attachment1.Parent = root

	local trail =
		Instance.new("Trail")

	trail.Name =
		"CreatorPhantomTrail"

	trail.Attachment0 = attachment0
	trail.Attachment1 = attachment1

	trail.Lifetime = 0.3
	trail.LightEmission = 1

	trail.Color =
		ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				GLITCH_GREEN
			),

			ColorSequenceKeypoint.new(
				0.35,
				BRIGHT_BLUE
			),

			ColorSequenceKeypoint.new(
				0.7,
				BRIGHT_PURPLE
			),

			ColorSequenceKeypoint.new(
				1,
				VOID
			),
		})

	trail.Transparency =
		NumberSequence.new(
			0.05,
			1
		)

	trail.Parent = root

	local start = os.clock()

	creatorBurst(
		root.CFrame,
		8,
		PURPLE,
		0.2,
		"phantom_start"
	)

	creatorRing(
		root.CFrame,
		2,
		19,
		BRIGHT_BLUE,
		0.32,
		"phantom_ring"
	)

	while
		os.clock() - start < duration
	do

		if token ~= S.Token then
			break
		end

		if not root.Parent then
			break
		end

		if humanoid.Health <= 0 then
			break
		end

		local direction =
			root.CFrame.LookVector

		velocity.Velocity =
			Vector3.new(
				direction.X * speed,
				0,
				direction.Z * speed
			)

		-- Small corrupted afterimages.
		if math.random(1, 4) == 1 then
			creatorBurst(
				root.CFrame,
				math.random(2, 5),
				BRIGHT_PURPLE,
				0.12,
				nil
			)
		end

		RunService.Heartbeat:Wait()
	end

	pcall(function()
		velocity:Destroy()
	end)

	pcall(function()
		trail:Destroy()
	end)

	pcall(function()
		attachment0:Destroy()
	end)

	pcall(function()
		attachment1:Destroy()
	end)

	if root.Parent then
		creatorBurst(
			root.CFrame,
			10,
			BRIGHT_PURPLE,
			0.24,
			"phantom_end"
		)
	end

	return true
end

-- ============================================================
-- M1 SYSTEM
-- ============================================================

local M1_INDEX = 0
local LAST_M1 = 0

local function performCreatorM1()
	local now = os.clock()

	if now - LAST_M1 < 0.09 then
		return
	end

	LAST_M1 = now

	local character, humanoid, root =
		getCharacter()

	if not character or not humanoid or not root then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	local target =
		getClosestTarget(
			CFG.TARGET_RANGE
		)

	if not target then
		return
	end

	local targetHumanoid =
		target:FindFirstChildOfClass(
			"Humanoid"
		)

	if not targetHumanoid then
		return
	end

	-- --------------------------------------------------------
	-- THE IMPORTANT PART:
	-- M1 always attempts to Void TP behind the closest player.
	-- --------------------------------------------------------

	voidTeleportBehind(
		target,
		CFG.M1_TP_DISTANCE
	)

	-- Cycle through all 4 supplied Genos M1 animations.
	M1_INDEX += 1

	if M1_INDEX > #M1_ANIMATIONS then
		M1_INDEX = 1
	end

	playCreatorAnimation(
		humanoid,
		M1_ANIMATIONS[M1_INDEX],
		Enum.AnimationPriority.Action4,
		1,
		false,
		0.42
	)

	creatorBurst(
		root.CFrame,
		5,
		BRIGHT_PURPLE,
		0.15,
		nil
	)

	creatorParticles(
		root,
		12,
		GLITCH_GREEN,
		nil
	)

	playCreatorSound(
		root,
		0.65,
		1.05
	)
end

