-- MOVE 1
-- ============================================================

local function creatorMove1(token: number)
	if S.Busy.Move1 then
		return
	end

	local character, humanoid, hrp = getCharacter()

	if not character or not humanoid or not hrp then
		return
	end

	S.Busy.Move1 = true

	local track = playAnimation(
		humanoid,
		MOVE1_ANIMATION,
		Enum.AnimationPriority.Action4,
		1,
		0.9
	)

	-- Charge.
	burst(hrp.CFrame, 9, GREEN_DARK, 0.25, "move1_charge")
	ring(hrp.CFrame, 3, 20, GREEN_BRIGHT, 0.4, "move1_charge_ring")
	particles(hrp, 35, GREEN_BRIGHT, "move1_charge_particles")

	-- Phantom Engine.
	phantomEngine(0.58, CFG.PHANTOM_SPEED, token)

	if token ~= S.Token then
		S.Busy.Move1 = nil
		return
	end

	local target = getClosestPlayer(CFG.M1_TARGET_RANGE)

	if target and teleportBehindPlayer(target) then
		task.wait(0.06)
	end

	-- Void displacement.
	local oldCF = hrp.CFrame

	local direction = hrp.CFrame.LookVector

	local voidPosition =
		hrp.Position
		+ direction * CFG.VOID_DISTANCE
		+ Vector3.new(0, 500, 0)

	local voidCF = CFrame.lookAt(
		voidPosition,
		voidPosition + direction
	)

	burst(oldCF, 11, GREEN_BRIGHT, 0.2, "void_depart")
	ring(oldCF, 4, 30, GREEN_BRIGHT, 0.4, "void_depart_ring")

	hrp.CFrame = voidCF
	hrp.AssemblyLinearVelocity = Vector3.zero

	burst(voidCF, 16, BLACK, 0.4, "void_arrive")
	burst(voidCF, 10, GREEN_BRIGHT, 0.3, "void_core")
	ring(voidCF, 5, 40, GREEN_BRIGHT, 0.55, "void_ring")
	particles(hrp, 55, GREEN_BRIGHT, "void_particles")

	playSound(hrp, 1.7, 0.68)

	task.delay(CFG.VOID_DURATION, function()
		if token ~= S.Token then
			S.Busy.Move1 = nil
			return
		end

		if hrp.Parent and humanoid.Health > 0 then
			burst(hrp.CFrame, 15, GREEN_BRIGHT, 0.3, "void_return")
			hrp.CFrame = oldCF
			hrp.AssemblyLinearVelocity = Vector3.zero
			burst(oldCF, 13, GREEN_BRIGHT, 0.3, "void_reappear")
		end

		S.Busy.Move1 = nil
	end)

	if track then
		task.delay(0.9, function()
			pcall(function()
				track:Stop(0.06)
			end)
		end)
	end
end

