-- ============================================================
-- GLITCH EXISTING ULT BAR
-- ============================================================
-- This does NOT create a second bar.
--
-- It randomly corrupts:
--   * position
--   * rotation
--   * transparency
--   * colors
--   * gradient state
--
-- It intentionally has no predictable repeating pattern.
-- ============================================================

local function glitchExistingUltimate()
	local magicHealth =
		getExistingUltimate()

	if not magicHealth then
		return
	end

	local originalPositions = {}
	local originalRotations = {}
	local originalTransparency = {}
	local originalColor = {}

	for _, object in ipairs(
		magicHealth:GetDescendants()
	) do

		if object:IsA("GuiObject") then

			originalPositions[object] =
				object.Position

			originalRotations[object] =
				object.Rotation

			originalTransparency[object] =
				object.BackgroundTransparency

			if object:IsA("Frame") then
				originalColor[object] =
					object.BackgroundColor3
			end

		end
	end

	local duration =
		math.random(3, 11) / 100

	local start =
		os.clock()

	while
		magicHealth.Parent
		and os.clock() - start < duration
	do

		for _, object in ipairs(
			magicHealth:GetDescendants()
		) do

			if object:IsA("GuiObject") then

				local roll =
					math.random(1, 5)

				if roll == 1 then

					object.Position =
						object.Position
						+ UDim2.fromOffset(
							math.random(
								-9,
								9
							),

							math.random(
								-4,
								4
							)
						)

				elseif roll == 2 then

					object.Rotation =
						math.random(
							-4,
							4
						)

				elseif roll == 3 then

					object.BackgroundTransparency =
						math.random(
							0,
							75
						) / 100

				elseif roll == 4
					and object:IsA("Frame")
				then

					local colors = {
						PURPLE,
						BRIGHT_PURPLE,
						GLITCH_GREEN,
						BRIGHT_BLUE,
						BLACK,
					}

					object.BackgroundColor3 =
						colors[
							math.random(
								1,
								#colors
							)
						]

				else

					object.Position =
						object.Position
						+ UDim2.fromOffset(
							math.random(
								-3,
								3
							),

							0
						)
				end
			end
		end

		RunService.RenderStepped:Wait()
	end

	-- Restore the real UI.
	for object, position in pairs(
		originalPositions
	) do

		if object and object.Parent then
			object.Position =
				position
		end
	end

	for object, rotation in pairs(
		originalRotations
	) do

		if object and object.Parent then
			object.Rotation =
				rotation
		end
	end

	for object, transparency in pairs(
		originalTransparency
	) do

		if object and object.Parent then
			object.BackgroundTransparency =
				transparency
		end
	end

	for object, color in pairs(
		originalColor
	) do

		if object and object.Parent then
			object.BackgroundColor3 =
				color
		end
	end
end

-- ============================================================
-- RANDOM CREATOR UI CORRUPTION LOOP
-- ============================================================

local function startUIGlitchLoop(token)
	task.spawn(function()

		while token == S.Token
			and Player.Parent
		do

			local waitTime =
				CFG.UI_GLITCH_INTERVAL_MIN
				+
				math.random()
				*
				(
					CFG.UI_GLITCH_INTERVAL_MAX
					-
					CFG.UI_GLITCH_INTERVAL_MIN
				)

			task.wait(waitTime)

			if token ~= S.Token then
				break
			end

			if math.random(1, 3) <= 2 then
				task.spawn(
					glitchExistingUltimate
				)
			end
		end
	end)
end

