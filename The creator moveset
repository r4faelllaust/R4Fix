local function recolorObject(object: Instance)
	for _, descendant in ipairs(object:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			descendant.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, CREATOR_LIME),
				ColorSequenceKeypoint.new(0.5, CREATOR_GREEN),
				ColorSequenceKeypoint.new(1, CREATOR_GREEN_DARK),
			})

			descendant.LightEmission = math.max(
				descendant.LightEmission,
				0.45
			)

		elseif descendant:IsA("Beam") then
			descendant.Color = ColorSequence.new(
				CREATOR_GREEN,
				CREATOR_LIME
			)

		elseif descendant:IsA("Trail") then
			descendant.Color = ColorSequence.new(
				CREATOR_GREEN,
				CREATOR_LIME
			)

		elseif descendant:IsA("PointLight")
			or descendant:IsA("SpotLight")
			or descendant:IsA("SurfaceLight")
		then
			descendant.Color = CREATOR_GREEN
		end
	end
end

local function cloneResource(
	index: number,
	parent: Instance,
	amount: number?,
	lifetime: number?
)
	local template = getResource(index)

	if not template or not parent then
		return nil
	end

	local clone = template:Clone()

	recolorObject(clone)
	clone.Parent = parent

	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			descendant.Enabled = false

			pcall(function()
				descendant:Emit(amount or 8)
			end)
		end
	end

	Debris:AddItem(
		clone,
		lifetime or CFG.MaxVFXLifetime
	)

	return clone
end

