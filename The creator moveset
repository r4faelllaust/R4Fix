-- ================================================================

local function overrideEffect(
	object: Instance
)

	if not object.Parent then
		return
	end

	local name =
		string.lower(
			object.Name
		)

	local interesting =
		string.find(
			name,
			"garou",
			1,
			true
		)
		or string.find(
			name,
			"effect",
			1,
			true
		)
		or string.find(
			name,
			"aura",
			1,
			true
		)
		or string.find(
			name,
			"particle",
			1,
			true
		)
		or string.find(
			name,
			"vfx",
			1,
			true
		)

	if not interesting then
		return
	end

	if object:IsA("ParticleEmitter") then

		pcall(function()

			object.Color =
				ColorSequence.new({
					ColorSequenceKeypoint.new(
						0,
						BRIGHT_GREEN
					),

					ColorSequenceKeypoint.new(
						0.5,
						GREEN
					),

					ColorSequenceKeypoint.new(
						1,
						DARK_GREEN
					),
				})

			object.LightEmission =
				1

		end)

	elseif object:IsA("Beam") then

		pcall(function()

			object.Color =
				ColorSequence.new(
					GREEN
				)

			object.LightEmission =
				1

		end)

	elseif object:IsA("Trail") then

		pcall(function()

			object.Color =
				ColorSequence.new({
					ColorSequenceKeypoint.new(
						0,
						WHITE
					),

					ColorSequenceKeypoint.new(
						0.5,
						GREEN
					),

					ColorSequenceKeypoint.new(
						1,
						DARK_GREEN
					),
				})

			object.LightEmission =
				1

		end)

	elseif object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight")
	then

		pcall(function()
			object.Color =
				GREEN
		end)
	end
end

