-- ============================================================

local function styleExistingUltimateBar()
	local playerGui =
		LocalPlayer:FindFirstChildOfClass(
			"PlayerGui"
		)

	if not playerGui then
		return
	end

	local bar =
		playerGui:FindFirstChild(
			"Bar",
			true
		)

	if not bar then
		return
	end

	local magicHealth =
		bar:FindFirstChild(
			"MagicHealth",
			true
		)

	if not magicHealth then
		return
	end

	local function styleObject(
		object: Instance
	)
		if object:IsA("Frame") then
			object.BackgroundColor3 =
				GREEN
		elseif object:IsA("ImageLabel")
			or object:IsA("ImageButton")
		then
			object.ImageColor3 =
				GREEN
		end
	end

	for _, object in ipairs(
		magicHealth:GetDescendants()
	) do
		local name =
			string.lower(
				object.Name
			)

		if name == "bar"
			or name == "fill"
			or name == "health"
		then
			styleObject(object)
		end

		if object:IsA("TextLabel") then
			local textName =
				string.lower(
					object.Name
				)

			if textName == "textlabel"
				or textName == "title"
			then
				object.Text =
					"T̷H̷E̷  C̷R̷E̷A̷T̷O̷R̷"

				object.TextColor3 =
					GREEN_BRIGHT
			end
		end

		local gradient =
			object:FindFirstChildOfClass(
