local function fixCharacterTab()
	local gui = getGui()

	if not gui then
		return
	end

	local topbar =
		gui:FindFirstChild(
			"TopbarPlus"
		)

	if not topbar then
		return
	end

	for _, object in ipairs(
		topbar:GetDescendants()
	) do
		if object.Name ~= "IconButton" then
			continue
		end

		local label =
			object:FindFirstChild("IconLabel")

		local image =
			object:FindFirstChild("IconImage")

		if label and
			label:IsA("TextLabel")
		then
			local current = label.Text

			if current == "Garou"
				or current == "Hero Hunter"
				or current == "Dark Garou"
				or current == "The Creator"
			then
				label.Text = MOVESET_NAME

				if image and
					(image:IsA("ImageLabel") or
						image:IsA("ImageButton"))
				then
					image.Image = DECAL_ID
				end
			end
		end
	end
end

-- ============================================================
-- CREATOR AURA
-- ============================================================

local function setupAura(character)
	for _, limbName in ipairs({
		"Left Arm",
		"Right Arm",
		"LeftHand",
		"RightHand",
		"LeftLowerArm",
		"RightLowerArm",
	}) do
		local limb =
			character:FindFirstChild(
				limbName
			)

		if limb and
			limb:IsA("BasePart")
		then
			local old =
				limb:FindFirstChild(
					"CreatorAura"
				)

			if old then
				old:Destroy()
			end

			local attachment =
				Instance.new("Attachment")

			attachment.Name =
				"CreatorAura"

			attachment.Parent = limb

			local emitter =
				Instance.new("ParticleEmitter")

			emitter.Color =
				ColorSequence.new({
					ColorSequenceKeypoint.new(
						0,
						TOXIC_GREEN
					),

					ColorSequenceKeypoint.new(
						0.5,
						GREEN
					),

					ColorSequenceKeypoint.new(
						1,
						BLACK
					),
				})

			emitter.LightEmission = 1
			emitter.Rate = 4

			emitter.Lifetime =
				NumberRange.new(
					0.2,
					0.5
				)

			emitter.Speed =
				NumberRange.new(
					0.2,
					1.2
				)

			emitter.SpreadAngle =
				Vector2.new(
					180,
					180
				)

			emitter.Size =
				NumberSequence.new({
					NumberSequenceKeypoint.new(
						0,
						0.35
					),

					NumberSequenceKeypoint.new(
						0.6,
						0.2
					),

					NumberSequenceKeypoint.new(
						1,
						0
					),
				})

			emitter.Parent = attachment
		end
	end
end

