local function setupCharacter(
	character: Model
)
	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not root
		or not humanoid:IsA("Humanoid")
		or not root:IsA("BasePart")
	then
		return
	end

	creatorSpawn(
		character,
		root,
		humanoid
	)

	creatorAura(character)

	startCreatorIdle(
		root,
		humanoid
	)

	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)

	task.spawn(function()
		for _ = 1, 30 do
			if token ~= S.Token then
				return
			end

			pcall(function()
				fixCreatorSelection()
				styleUltimateBar()

				for i = 1, 4 do
					styleMoveSlot(i)
				end
			end)

			task.wait(0.12)
		end
	end)

	task.delay(
		0.4,
		function()
			if token == S.Token then
				setupTools()
			end
		end
	)

	addCharacterConnection(
		humanoid.Died:Connect(
			function()
				S.Busy = {}

				stopIdle()
				cleanupTracks()

				creatorHeadText(
					"CREATOR CONNECTION LOST"
				)
			end
		)
	)

	addCharacterConnection(
		character.AncestryChanged:Connect(
			function(_, parent)
				if not parent then
					S.Token += 1
				end
			end
		)
	)
end

