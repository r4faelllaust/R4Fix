-- ============================================================
-- FLIGHT TOOL
-- ============================================================

local function createFlightTool()
	destroyTool(
		"Creator Flight"
	)

	local backpack =
		Player:WaitForChild(
			"Backpack"
		)

	local tool =
		Instance.new("Tool")

	tool.Name =
		"Creator Flight"

	tool.RequiresHandle =
		false

	tool.CanBeDropped =
		false

	tool.ToolTip =
		"CREATOR FLIGHT"

	tool.Parent =
		backpack

	local flying = false
	local velocity = nil
	local gyro = nil
	local heartbeat = nil

	local function stopFlight()
		flying = false

		if heartbeat then
			heartbeat:Disconnect()
			heartbeat = nil
		end

		if velocity then
			velocity:Destroy()
			velocity = nil
		end

		if gyro then
			gyro:Destroy()
			gyro = nil
		end
	end

	tool.Activated:Connect(
		function()

			if flying then
				stopFlight()
				return
			end

			local character, humanoid, hrp =
				getCharacter()

			if not character
				or not humanoid
				or not hrp
			then
				return
			end

			flying = true

			velocity =
				Instance.new(
					"BodyVelocity"
				)

			velocity.MaxForce =
				Vector3.new(
					1000000,
					1000000,
					1000000
				)

			velocity.P =
				60000

			velocity.Parent =
				hrp

			gyro =
				Instance.new(
					"BodyGyro"
				)

			gyro.MaxTorque =
				Vector3.new(
					1000000,
					1000000,
					1000000
				)

			gyro.P =
				60000

			gyro.Parent =
				hrp

			playAnimation(
				humanoid,
				ANIM.Idle,
				Enum.AnimationPriority.Action,
				1,
				nil,
				true
			)

			heartbeat =
				RunService.Heartbeat:Connect(
					function()

						if not flying
							or not hrp.Parent
							or humanoid.Health <= 0
						then
							stopFlight()
							return
						end

						local camera =
							workspace.CurrentCamera

						if not camera then
							return
						end

						local move =
							humanoid.MoveDirection

						if move.Magnitude > 0.05 then
							velocity.Velocity =
								move.Unit
								* CFG.FLIGHT_SPEED
						else
							velocity.Velocity =
								Vector3.zero
						end

						gyro.CFrame =
							CFrame.lookAt(
								hrp.Position,
								hrp.Position
									+ camera.CFrame.LookVector
							)

						if math.random() < 0.07 then
							glitchShards(
								hrp.CFrame,
								2
							)
						end
					end
				)
		end
	)

	tool.Unequipped:Connect(
		stopFlight
	)

	tool.AncestryChanged:Connect(
		function(_, parent)
			if not parent then
				stopFlight()
			end
		end
	)

	S.Tools.Flight = tool
end

