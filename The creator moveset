	-- FIND TARGET BEFORE PLAYING THE ATTACK.
	-- ============================================================

	local target =
		findClosestTarget(
			root.Position
		)

	m1Index += 1

	if m1Index > 4 then
		m1Index = 1
	end

	local animations = {
		ANIM.M1_1,
		ANIM.M1_2,
		ANIM.M1_3,
		ANIM.M1_4,
	}

	-- ============================================================
	-- FIX:
	-- TP FIRST.
	-- ============================================================

	if target then

		local targetRoot =
			target:FindFirstChild(
				"HumanoidRootPart"
			)

		local teleported =
			teleportBehindTarget(
