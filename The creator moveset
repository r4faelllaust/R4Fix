local function createRunTool()
	destroyTool(
		"Creator Run"
	)

	local backpack =
		LocalPlayer:FindFirstChild(
			"Backpack"
		)

	if not backpack then
		return
	end

	local tool =
		Instance.new("Tool")

	tool.Name =
		"Creator Run"

	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip =
		"CREATOR // PHANTOM RUN"

	tool.Parent = backpack

	S.Tools.Run = tool

	local running = false
	local track: AnimationTrack? = nil

	local function stop()
		running = false
		S.Running = false

		if track then
			pcall(function()
				if track.IsPlaying then
					track:Stop(0.1)
				end
			end)

			removeTrackFromList(track)
			safeDestroy(track)

			track = nil
		end
	end

	addConnection(
		S.Connections,

		tool.Equipped:Connect(
			function()
				local _, humanoid, hrp =
					getCharacter()

				if not humanoid
					or not hrp
				then
					return
				end

				if running then
					return
				end

				running = true
				S.Running = true

				track =
					playAnimation(
						humanoid,
						RUN_ANIMATION,
						Enum.AnimationPriority.Action,
						1
					)

				task.spawn(function()
					while running
						and tool.Parent
						and humanoid.Health > 0
					do
						local direction =
							hrp.CFrame.LookVector

						hrp.AssemblyLinearVelocity =
							Vector3.new(
								direction.X
									* CFG.RUN_SPEED,

								hrp.AssemblyLinearVelocity.Y,

								direction.Z
									* CFG.RUN_SPEED
							)

						createDashEffect(hrp)

						RunService.Heartbeat:Wait()
					end
				end)
			end
		)
	)

	addConnection(
		S.Connections,

		tool.Unequipped:Connect(
			stop
		)
	)

	addConnection(
		S.Connections,

		tool.AncestryChanged:Connect(
			function(_, parent)
				if not parent then
					stop()
				end
			end
		)
	)
end

