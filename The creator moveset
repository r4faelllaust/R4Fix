end

local function createFlyTool()
	destroyTool("Creator Flight")

	local backpack = LocalPlayer:FindFirstChild("Backpack")

	if not backpack then
		return
	end

	local tool = Instance.new("Tool")
	tool.Name = "Creator Flight"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "THE CREATOR // FLIGHT"
	tool.Parent = backpack

	S.Tools.Flight = tool

	local flying = false
	local bodyVelocity: BodyVelocity? = nil
	local bodyGyro: BodyGyro? = nil

	local function stopFlight()
		flying = false
		S.Flying = false

		if bodyVelocity then
			pcall(function()
				bodyVelocity:Destroy()
			end)
			bodyVelocity = nil
		end

		if bodyGyro then
			pcall(function()
				bodyGyro:Destroy()
			end)
			bodyGyro = nil
		end

		local _, humanoid, hrp = getCharacter()

		if humanoid then
			humanoid.AutoRotate = true
		end

		if hrp then
			burst(hrp.CFrame, 9, GREEN_DARK, 0.2, "flight_end")
			ring(hrp.CFrame, 2, 18, GREEN_BRIGHT, 0.3, "flight_end_ring")
		end
	end

	local function startFlight()
		local _, humanoid, hrp = getCharacter()

		if not humanoid or not hrp then
			return
		end

		if flying then
			stopFlight()
			return
		end

		flying = true
		S.Flying = true

		humanoid.AutoRotate = false

		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.Name = "CreatorFlightVelocity"
		bodyVelocity.MaxForce = Vector3.new(
			1000000,
			1000000,
			1000000
		)
		bodyVelocity.P = 50000
		bodyVelocity.Velocity = Vector3.zero
		bodyVelocity.Parent = hrp

		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.Name = "CreatorFlightGyro"
		bodyGyro.MaxTorque = Vector3.new(
			1000000,
			1000000,
			1000000
		)
		bodyGyro.P = 50000
		bodyGyro.CFrame = hrp.CFrame
		bodyGyro.Parent = hrp

		burst(hrp.CFrame, 10, GREEN_DARK, 0.3, "flight_start")
		ring(hrp.CFrame, 3, 25, GREEN_BRIGHT, 0.4, "flight_start_ring")
		particles(hrp, 40, GREEN_BRIGHT, "flight_particles")

		task.spawn(function()
			while flying and tool.Parent do
				local characterNow, humanoidNow, hrpNow = getCharacter()

				if not characterNow
					or not humanoidNow
					or not hrpNow
					or humanoidNow.Health <= 0
				then
					break
				end

				local camera = workspace.CurrentCamera

				if not camera then
					break
				end

				local moveDirection =
					humanoidNow.MoveDirection

				local velocity = Vector3.zero

				if moveDirection.Magnitude > 0.01 then
					velocity =
						moveDirection.Unit
						* CFG.FLY_SPEED
				end

				local vertical = 0

				if UserInputService:IsKeyDown(
					Enum.KeyCode.Space
				) then
					vertical += CFG.FLY_VERTICAL_SPEED
				end

				if UserInputService:IsKeyDown(
					Enum.KeyCode.LeftControl
				) then
					vertical -= CFG.FLY_VERTICAL_SPEED
				end

				if moveDirection.Magnitude <= 0.01 then
					velocity =
						camera.CFrame.LookVector
						* 2
				end

				bodyVelocity.Velocity =
					Vector3.new(
						velocity.X,
						vertical,
						velocity.Z
					)

				bodyGyro.CFrame =
					CFrame.lookAt(
						hrpNow.Position,
						hrpNow.Position
							+ camera.CFrame.LookVector
					)

				if allowed("flight_tick", 0.09) then
					particles(
						hrpNow,
						3,
						GREEN_BRIGHT
					)
				end

				RunService.Heartbeat:Wait()
			end

			stopFlight()
		end)
	end

	tool.Activated:Connect(startFlight)

	tool.Unequipped:Connect(function()
		stopFlight()
	end)

	tool.AncestryChanged:Connect(function(_, parent)
		if not parent then
			stopFlight()
		end
	end)
end

