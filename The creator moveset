-- ============================================================
-- CLEANUP
-- ============================================================

local function disconnectList(list)
	for _, connection in ipairs(list) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(list)
end

local function addCharacterConnection(connection)
	if connection then
		table.insert(S.CharacterConnections, connection)
	end

	return connection
end

local function cleanupAnimations()
	for _, track in ipairs(S.AnimationTracks) do
		pcall(function()
			if track.IsPlaying then
				track:Stop(0.06)
			end

			track:Destroy()
		end)
	end

	table.clear(S.AnimationTracks)
end

local function cleanupCharacter()
	disconnectList(S.CharacterConnections)
	cleanupAnimations()

	S.Busy = {}
	table.clear(S.LastVFX)

	local folder = workspace:FindFirstChild("TheCreator_VFX")

	if folder then
		pcall(function()
			folder:Destroy()
		end)
	end
end

-- ============================================================
-- CHARACTER
-- ============================================================

local function getCharacter()
	local character = LocalPlayer.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return nil, nil, nil
	end

	return character, humanoid, root
end

local function getAnimator(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

local function playAnimation(
	humanoid,
	animationId,
	priority,
	speed,
	duration
)
	if not humanoid then
		return nil
	end

	if humanoid.Health <= 0 then
		return nil
	end

	if animationId == "" then
		return nil
	end

	if not animationId:find("rbxassetid://", 1, true) then
		animationId = "rbxassetid://" .. animationId
	end

	local animator = getAnimator(humanoid)

	local animation = Instance.new("Animation")
	animation.AnimationId = animationId

	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	animation:Destroy()

	if not ok or not track then
		return nil
	end

	track.Priority =
		priority or Enum.AnimationPriority.Action4

	track.Looped = false

	table.insert(S.AnimationTracks, track)

	pcall(function()
		track:Play(0.04, 1, speed or 1)
	end)

	if duration then
		task.delay(duration, function()
			pcall(function()
				if track.IsPlaying then
					track:Stop(0.06)
				end

				track:Destroy()
			end)

			for i = #S.AnimationTracks, 1, -1 do
				if S.AnimationTracks[i] == track then
					table.remove(S.AnimationTracks, i)
					break
				end
			end
		end)
	end

	return track
end

