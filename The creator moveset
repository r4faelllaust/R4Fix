local function glitchPart(
	cframe: CFrame,
	size: Vector3,
	duration: number,
	transparency: number?
): Part

	local part = Instance.new("Part")

	part.Name = "CREATOR_GLITCH"

	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
