local function setupMoveHandler(
	character,
	humanoid,
	hrp,
	token
)

	addCharacterConnection(
		humanoid.AnimationPlayed:Connect(
			function(track)

				if token ~= S.Token then
					return
				end

				if not track.Animation then
					return
				end

				local id =
					normalizeAnimationId(
						track.Animation.AnimationId
					)

				if id ==
					normalizeAnimationId(
						ANIM.Move1Trigger
					)
				then

					pcall(function()
						track:Stop()
					end)

					move1(token)

					return
				end

				if id ==
					normalizeAnimationId(
						ANIM.Move2Trigger
					)
				then

					pcall(function()
						track:Stop()
					end)

					move2(token)

					return
				end

				if id ==
					normalizeAnimationId(
						ANIM.Move3Trigger
					)
				then

					pcall(function()
						track:Stop()
					end)

					move3()

					return
				end

				if id ==
					normalizeAnimationId(
						ANIM.Move4Trigger
					)
				then

					pcall(function()
						track:Stop()
					end)

					move4()

					return
				end

				if id ==
					normalizeAnimationId(
						ANIM.SpecialTrigger
					)
				then

					pcall(function()
						track:Stop()
					end)

					playAnimation(
						humanoid,
						ANIM.Special,
						Enum.AnimationPriority.Action4,
						1,
						0.9
					)

					randomResourceVFX(
						hrp,
						25
					)

					return
				end

				for index, data in ipairs(
					ANIM.Ult
				) do

					if id ==
						normalizeAnimationId(
							data.Trigger
						)
					then

						pcall(function()
							track:Stop()
						end)

						playUlt(
							index
						)

						return
					end
				end
			end
		)
	)
end

