local function burst(
	cframe,
	size,
	color,
	duration,
	key
)
	if key and not allowed(key) then
		return
	end

	local part = Instance.new("Part")

	part.Name = "CreatorBurst"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false

	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon

	part.Color = color or BRIGHT_GREEN
	part.Transparency = 0.12

	part.Size = Vector3.one
	part.CFrame = cframe

	part.Parent = getVFXFolder()

	TweenService:Create(
		part,
		TweenInfo.new(
			duration or 0.3,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(size, size, size),
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(
		part,
		(duration or 0.3) + 0.15
	)
end

local function ring(
	cframe,
	startSize,
	endSize,
	color,
	duration,
	key
)
	if key and not allowed(key) then
		return
	end

	local part = Instance.new("Part")

	part.Name = "CreatorRing"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false

	part.Shape = Enum.PartType.Cylinder
	part.Material = Enum.Material.Neon

	part.Color = color or GREEN
