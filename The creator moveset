-- ============================================================
-- TARGETING
-- ============================================================

local function getLiveFolder()
	return workspace:FindFirstChild("Live")
end

local function isValidTarget(
	model: Instance,
	character: Model
)
	if not model:IsA("Model") then
		return false
	end

	if model == character then
		return false
	end

	local humanoid =
		model:FindFirstChildOfClass(
			"Humanoid"
		)

	local hrp =
		model:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid or not hrp then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return true
end

local function getClosestTarget()
	local character, humanoid, hrp =
		getCharacter()

	if not character or not humanoid or not hrp then
		return nil
	end

	local live =
		getLiveFolder()

	if not live then
		return nil
	end

	local bestTarget = nil
	local bestDistance = math.huge

	for _, model in ipairs(live:GetChildren()) do
		if isValidTarget(model, character) then

			local targetHRP =
				model:FindFirstChild(
					"HumanoidRootPart"
				)

			if targetHRP and targetHRP:IsA("BasePart") then

				local offset =
					targetHRP.Position
					- hrp.Position

				local horizontal =
					Vector3.new(
						offset.X,
						0,
						offset.Z
					)

				local distance =
					horizontal.Magnitude

				local vertical =
					math.abs(offset.Y)

				if
					distance <= CFG.M1_MAX_RANGE
					and vertical <= CFG.TARGET_MAX_VERTICAL
					and distance < bestDistance
				then
					bestDistance = distance
					bestTarget = model
				end
			end
		end
	end

	return bestTarget
end

-- ============================================================
-- TP BEHIND TARGET
-- ============================================================

local function teleportBehindTarget(
	target: Model
)
	if not CFG.M1_TP_ENABLED then
		return false
	end

	local character, humanoid, hrp =
		getCharacter()

	if not character or not humanoid or not hrp then
		return false
	end

	if not target or not target.Parent then
		return false
	end

	local targetHumanoid =
		target:FindFirstChildOfClass(
			"Humanoid"
		)

	local targetHRP =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if
		not targetHumanoid
		or not targetHRP
		or targetHumanoid.Health <= 0
	then
		return false
	end

	local now = os.clock()

	if now - S.LastM1TP < CFG.M1_TP_COOLDOWN then
		return false
	end

	S.LastM1TP = now
	S.Target = target

	-- Behind target relative to their facing direction.
	local destination =
		targetHRP.Position
		- targetHRP.CFrame.LookVector
		* CFG.M1_TP_DISTANCE

	-- Keep the player's current vertical level close to
	-- the target instead of launching them upward/downward.
	destination = Vector3.new(
		destination.X,
		targetHRP.Position.Y,
		destination.Z
	)

	local lookAt =
		targetHRP.Position

	hrp.CFrame =
		CFrame.lookAt(
			destination,
			lookAt
		)

	hrp.AssemblyLinearVelocity =
		Vector3.zero

	burst(
		hrp.CFrame,
		5,
		PURPLE,
		0.16,
		"m1_tp_depart"
	)

	ring(
		hrp.CFrame,
		1,
		8,
		BRIGHT_PURPLE,
		0.18,
		"m1_tp_ring"
	)

	particles(
		hrp,
		10,
		BRIGHT_PURPLE,
		"m1_tp_particles"
	)

	return true
end

-- ============================================================
-- PHANTOM ENGINE
-- ============================================================

local function phantomEngine(
	duration: number,
	speed: number,
	token: number
)
	local character, humanoid, hrp =
		getCharacter()

	if not character or not humanoid or not hrp then
		return false
	end

	if
		humanoid.Health <= 0
		or token ~= S.Token
	then
		return false
	end

	local velocity =
		Instance.new("BodyVelocity")

	velocity.Name =
		"DarkGarou_PhantomEngine"

	velocity.MaxForce =
		Vector3.new(
			5000000,
			0,
			5000000
		)

	velocity.P =
		75000

	velocity.Parent =
		hrp

	local a0 =
		Instance.new("Attachment")

	a0.Position =
		Vector3.new(-1.1, 0, 0)

	a0.Parent = hrp

	local a1 =
		Instance.new("Attachment")

	a1.Position =
		Vector3.new(1.1, 0, 0)

	a1.Parent = hrp

	local trail =
		Instance.new("Trail")

	trail.Name =
		"DarkGarouPhantomTrail"

	trail.Attachment0 = a0
	trail.Attachment1 = a1

	trail.Lifetime =
		0.35

	trail.LightEmission =
		1

	trail.Color =
		ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				BRIGHT_BLUE
			),

			ColorSequenceKeypoint.new(
				0.35,
				BRIGHT_PURPLE
			),

			ColorSequenceKeypoint.new(
				1,
				DEEP_PURPLE
			),
		})

	trail.Transparency =
		NumberSequence.new(
			0.05,
			1
		)

	trail.Parent = hrp

	local start =
		os.clock()

	burst(
		hrp.CFrame,
		7,
		VOID_BLUE,
		0.2,
		"phantom_start"
	)

	ring(
		hrp.CFrame,
		2,
		17,
		BRIGHT_BLUE,
		0.25,
		"phantom_ring"
	)

	while
		os.clock() - start < duration
	do
		if
			token ~= S.Token
			or not hrp.Parent
			or humanoid.Health <= 0
		then
			break
		end

		local direction =
			hrp.CFrame.LookVector

		velocity.Velocity =
			Vector3.new(
				direction.X * speed,
				0,
				direction.Z * speed
			)

		particles(
			hrp,
			2,
			BRIGHT_PURPLE,
			"phantom_tick"
		)

		RunService.Heartbeat:Wait()
	end

	pcall(function()
		velocity:Destroy()
	end)

	pcall(function()
		trail:Destroy()
		a0:Destroy()
		a1:Destroy()
	end)

	if hrp.Parent then
		burst(
			hrp.CFrame,
			9,
			BRIGHT_PURPLE,
			0.22,
			"phantom_end"
		)
	end

	return true
end

