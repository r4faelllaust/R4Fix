-- ============================================================
-- TARGET VALIDATION
-- ============================================================

local function isValidTarget(character: Model?): boolean
	if not character then
		return false
	end

	if character == LocalPlayer.Character then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return true
end

-- ============================================================
-- CLOSEST TARGET
-- ============================================================

local function getClosestTarget(
	maxDistance: number?
): Model?
	local _, _, myRoot =
		getCharacter()

	if not myRoot then
		return nil
	end

	local limit =
		maxDistance or CFG.TARGET_RADIUS

	local closest: Model? = nil
	local closestDistance = limit

	local live =
		workspace:FindFirstChild("Live")

	if live then
		for _, object in ipairs(
			live:GetChildren()
		) do
			if object:IsA("Model") and
				isValidTarget(object)
			then
				local targetRoot =
					object:FindFirstChild(
						"HumanoidRootPart"
					)

				if targetRoot then
					local distance =
						(
							targetRoot.Position -
							myRoot.Position
						).Magnitude

					if distance <
						closestDistance
					then
						closestDistance = distance
						closest = object
					end
				end
			end
		end
	end

	if closest then
		return closest
	end

	for _, player in ipairs(
		Players:GetPlayers()
	) do
		if player ~= LocalPlayer then
			local character =
				player.Character

			if isValidTarget(character) then
				local targetRoot =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if targetRoot then
					local distance =
						(
							targetRoot.Position -
							myRoot.Position
						).Magnitude

					if distance <
						closestDistance
					then
						closestDistance = distance
						closest = character
					end
				end
			end
		end
	end

	return closest
end

-- ============================================================
-- TELEPORT BEHIND
-- ============================================================

local function teleportBehind(
	target: Model
): boolean
	local _, _, myRoot =
		getCharacter()

	if not myRoot then
		return false
	end

	if not isValidTarget(target) then
		return false
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot then
		return false
	end

	local destinationPosition =
		targetRoot.Position -
		targetRoot.CFrame.LookVector *
		CFG.BEHIND_DISTANCE

	destinationPosition +=
		Vector3.new(
			0,
			CFG.BEHIND_HEIGHT,
			0
		)

	local destination =
		CFrame.lookAt(
			destinationPosition,
			targetRoot.Position
		)

	-- Departure
	burst(
		myRoot.CFrame,
		7,
		GREEN,
		0.18,
		"tp_depart"
	)

	glitchShards(
		myRoot.CFrame,
		8,
		2.2,
		"tp_depart_glitch"
	)

	particles(
		myRoot,
		22,
		BRIGHT_GREEN,
		"tp_depart_particles"
	)

	playSound(
		myRoot,
		SOUND.TELEPORT,
		0.8,
		1.15
	)

	-- Actual local teleport
	myRoot.CFrame = destination

	myRoot.AssemblyLinearVelocity =
		Vector3.zero

	-- Arrival
	burst(
		destination,
		9,
		BRIGHT_GREEN,
		0.2,
		"tp_arrive"
	)

	ring(
		destination,
		2,
		20,
		GREEN,
		0.3,
		"tp_ring"
	)

	glitchShards(
		destination,
		9,
		2.5,
		"tp_arrive_glitch"
	)

	return true
end

-- ============================================================
-- FACE TARGET
-- ============================================================

local function faceTarget(target: Model)
	local _, _, root =
		getCharacter()

	if not root then
		return
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot then
		return
	end

	local targetPosition =
		Vector3.new(
			targetRoot.Position.X,
			root.Position.Y,
			targetRoot.Position.Z
		)

	if (targetPosition - root.Position).Magnitude
		> 0.01
	then
		root.CFrame =
			CFrame.lookAt(
				root.Position,
				targetPosition
			)
	end
end

-- ============================================================
-- PROCEDURAL ARM ANIMATION
-- ============================================================

local function proceduralPunch(
	humanoid: Humanoid,
	root: BasePart,
	duration: number
)
	if not CFG.PROCEDURAL_ANIMATIONS then
		return
	end

	local torso =
		humanoid.Parent:FindFirstChild(
			"UpperTorso"
		)
		or humanoid.Parent:FindFirstChild(
			"Torso"
		)

	if not torso or not torso:IsA("BasePart") then
		return
	end

	local rightShoulder =
		torso:FindFirstChild(
			"RightShoulder"
		)

	local leftShoulder =
		torso:FindFirstChild(
			"LeftShoulder"
		)

	if not rightShoulder or
		not leftShoulder
	then
		return
	end

	if not rightShoulder:IsA("Motor6D") or
		not leftShoulder:IsA("Motor6D")
	then
		return
	end

	local rightStart =
		rightShoulder.C0

	local leftStart =
		leftShoulder.C0

	local forward =
		CFrame.Angles(
			math.rad(-55),
			math.rad(15),
			math.rad(-20)
		)

	local windup =
		CFrame.Angles(
			math.rad(35),
			math.rad(-30),
			math.rad(45)
		)

	local tweenInfo =
		TweenInfo.new(
			duration * 0.25,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		)

	local tweenBack =
		TweenInfo.new(
			duration * 0.35,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.In
		)

	rightShoulder.C0 =
		rightStart *
		windup

	leftShoulder.C0 =
		leftStart *
		CFrame.Angles(
			math.rad(-15),
			0,
			math.rad(-15)
		)

	task.delay(
		duration * 0.2,
		function()
			if rightShoulder.Parent then
				TweenService:Create(
					rightShoulder,
					tweenInfo,
					{
						C0 =
							rightStart *
							forward,
					}
				):Play()

				TweenService:Create(
					leftShoulder,
					tweenInfo,
					{
						C0 =
							leftStart *
							CFrame.Angles(
								math.rad(15),
								0,
								math.rad(10)
							),
					}
				):Play()
			end
		end
	)

	task.delay(
		duration * 0.55,
		function()
			if rightShoulder.Parent then
				TweenService:Create(
					rightShoulder,
					tweenBack,
					{
						C0 = rightStart,
					}
				):Play()

				TweenService:Create(
					leftShoulder,
					tweenBack,
					{
						C0 = leftStart,
					}
				):Play()
			end
		end
	)
end

