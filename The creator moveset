local function getCharacter()
	local character = LocalPlayer.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return nil, nil, nil
	end

	return character, humanoid, root
end

local function getAnimator(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

local function playAnimation(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority?,
	speed: number?,
	looped: boolean?,
	duration: number?
): AnimationTrack?
	if humanoid.Health <= 0 then
		return nil
	end

	local animator = getAnimator(humanoid)

	local animation = Instance.new("Animation")
	animation.AnimationId = id

	local success, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	animation:Destroy()

	if not success or not track then
		return nil
	end

	track.Priority = priority or Enum.AnimationPriority.Action4
	track.Looped = looped == true

	table.insert(S.Tracks, track)

	pcall(function()
		track:Play(0.035, 1, speed or 1)
	end)

	if duration then
		task.delay(duration, function()
			pcall(function()
				if track.IsPlaying then
					track:Stop(0.055)
				end
			end)
		end)
	end

	return track
end

-- ================================================================
-- TARGETING
-- ================================================================

local function isValidTarget(model: Model, ownCharacter: Model)
	if model == ownCharacter then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if model.Parent == nil then
		return false
	end

	return true
end

local function findClosestTarget(origin: Vector3): Model?
	local ownCharacter = LocalPlayer.Character

	if not ownCharacter then
		return nil
	end

	local live = Workspace:FindFirstChild("Live")

	local container = live or Workspace

	local closest: Model? = nil
	local closestDistance = CFG.TargetRange

	for _, object in ipairs(container:GetChildren()) do
		if object:IsA("Model") and isValidTarget(object, ownCharacter) then
			local targetRoot = object:FindFirstChild("HumanoidRootPart")

			if targetRoot and targetRoot:IsA("BasePart") then
				local distance = (targetRoot.Position - origin).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closest = object
				end
			end
		end
	end

	return closest
end

-- ================================================================
-- M1 TARGET LOCK
-- ================================================================

local function teleportBehindTarget(target: Model): boolean
	local character, humanoid, root = getCharacter()

	if not character or not humanoid or not root then
		return false
	end

	local targetRoot = target:FindFirstChild("HumanoidRootPart")

	if not targetRoot or not targetRoot:IsA("BasePart") then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	local behindPosition =
		targetRoot.Position
		- targetRoot.CFrame.LookVector * CFG.M1BehindDistance

	behindPosition += Vector3.new(0, 0.08, 0)

	root.CFrame = CFrame.lookAt(
		behindPosition,
		targetRoot.Position
	)

	root.AssemblyLinearVelocity = Vector3.zero

	return true
end

