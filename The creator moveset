-- ============================================================
-- RUN TOOL
-- ============================================================

local function createRunTool()
	destroyTool(
		"Creator Run"
	)

	local backpack =
		Player:WaitForChild(
			"Backpack"
		)

	local tool =
		Instance.new("Tool")

	tool.Name =
		"Creator Run"

	tool.RequiresHandle =
		false

	tool.CanBeDropped =
		false

	tool.ToolTip =
		"CREATOR PHANTOM RUN"

	tool.Parent =
		backpack

	local running = false
	local track = nil

	tool.Equipped:Connect(
		function()

			local character, humanoid, hrp =
				getCharacter()

			if not character
				or not humanoid
				or not hrp
			then
				return
			end

			running = true

			track =
				playAnimation(
					humanoid,
					ANIM.Run,
					Enum.AnimationPriority.Action,
					1.15,
					nil,
					true
				)

			while
				running
				and tool.Parent
				and humanoid.Health > 0
			do

				local direction =
					hrp.CFrame.LookVector

				hrp.AssemblyLinearVelocity =
					Vector3.new(
						direction.X
							* CFG.RUN_SPEED,

						hrp.AssemblyLinearVelocity.Y,

						direction.Z
							* CFG.RUN_SPEED
					)

				if math.random() < 0.08 then
					glitchShards(
						hrp.CFrame,
						2
					)
				end

				RunService.Heartbeat:Wait()
			end
		end
	)

	local function stop()
		running = false

		if track then
			pcall(function()
				track:Stop(0.1)
			end)

			track = nil
		end
	end

	tool.Unequipped:Connect(stop)

	tool.AncestryChanged:Connect(
		function(_, parent)
			if not parent then
				stop()
			end
		end
	)

	S.Tools.Run = tool
end

