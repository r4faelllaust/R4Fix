local function startUltimateGlitch()
	task.spawn(function()
		while Player.Parent do

			local magic =
				findUltimateObjects()

			if magic then

				local barParent =
					magic:IsA("GuiObject")
					and magic
					or nil

				if barParent then

					local roll =
						math.random(
							1,
							100
						)

					if roll <= 38 then
						createGlitchPixel(
							barParent,
							true
						)

						if math.random(1, 3) == 1 then
							createGlitchPixel(
								barParent,
								true
							)
						end
					end

					if roll <= 18 then
						randomizeGuiPosition(
							barParent
						)
					end

					local text =
						magic:FindFirstChild(
							"TextLabel"
						)

					if text
						and text:IsA("TextLabel")
						and roll <= 12
					then
						glitchText(
							text,
							"THE CREATOR"
						)
					end
				end
			end

			task.wait(
				math.random(
					CFG.GLITCH_ULT_INTERVAL_MIN * 1000,
					CFG.GLITCH_ULT_INTERVAL_MAX * 1000
				) / 1000
			)
		end
