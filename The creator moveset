			creatorBurst(
				root,
				3.8,
				0.1
			)

			creatorRing(
				root,
				1,
				6,
				0.09
			)

			cloneResource(
				13,
				targetRoot,
				6,
				0.28
			)

			playImpactSound(
				targetRoot,
				0.8,
				0.92
					+ math.random()
					* 0.12
			)
		end
	end

	-- ============================================================
	-- ATTACK STARTS AFTER TP.
	-- ============================================================

	playAnimation(
		humanoid,
		animations[m1Index],
		Enum.AnimationPriority.Action4,
		1.08,
		false,
		0.42
	)

	if target
		and target.Parent
	then

		local targetRoot =
			target:FindFirstChild(
				"HumanoidRootPart"
			)

		if targetRoot
			and targetRoot:IsA("BasePart")
		then

			directionalSlash(
				root
			)

			cloneResource(
