local function randomGlitchString(
	text: string
)
	local chars = {
		"#",
		"%",
		"/",
		"0",
		"1",
		"X",
		"!",
		"?",
		"█",
		"░",
		"▒",
	}

	local output = ""

	for i = 1, #text do

		local char =
			text:sub(i, i)

		if math.random() < 0.12 then
			char =
				chars[
					math.random(
						1,
						#chars
					)
				]
		end

		output ..= char
	end

	return output
end

