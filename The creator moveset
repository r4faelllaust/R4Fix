						ULT_BLUE
					),

					ColorSequenceKeypoint.new(
						1,
						Color3.fromRGB(
							5,
							12,
							40
						)
					),
				})
		end
	end

	local glow =
		health:FindFirstChild(
			"Glow"
		)

	if glow and
		(
			glow:IsA("ImageLabel")
			or glow:IsA("ImageButton")
		)
	then
		glow.ImageColor3 =
			ULT_BLUE_BRIGHT

		glow.ImageTransparency =
			0.15
	end
end

-- ============================================================
-- UI GLITCH EFFECT
-- ============================================================
--
-- This does NOT create a second Ultimate Bar.
-- It attaches tiny temporary glitch objects to the
-- EXISTING MagicHealth UI and destroys them immediately.
--
-- The actual bar remains the original TSB bar.
-- ============================================================

local function createGlitchPixel()
	if not CFG.UI_GLITCH_ENABLED then
		return
	end

	local magic =
		S.UI.UltBar

	if not magic or not magic.Parent then
		styleUltimateBar()
		magic = S.UI.UltBar
	end

	if not magic then
		return
	end

	local pixel =
		Instance.new("Frame")

	pixel.Name =
		"R4FixGlitchPixel"

	pixel.BorderSizePixel = 0

	local colors = {
		BLACK,
		BRIGHT_PURPLE,
		GLITCH_GREEN,
		BRIGHT_BLUE,
	}

	pixel.BackgroundColor3 =
		colors[
			math.random(
				1,
				#colors
			)
		]

	pixel.BackgroundTransparency =
		math.random(0, 25) / 100

	pixel.Size =
		UDim2.fromOffset(
			math.random(2, 12),
			math.random(2, 7)
		)

	pixel.Position =
		UDim2.new(
			math.random(-10, 110) / 100,
			math.random(-10, 10),
			math.random(-40, 140) / 100,
			math.random(-6, 6)
		)

	pixel.ZIndex = 999

	pixel.Parent =
		magic

	local rotation =
		math.random(
			-30,
			30
		)

	pixel.Rotation =
		rotation

	task.delay(
		math.random(
			3,
			11
		) / 100,
		function()
			pcall(function()
				pixel:Destroy()
			end)
		end
	)
end

local function glitchUltimateBar()
	if not CFG.UI_GLITCH_ENABLED then
		return
	end

	local magic =
		S.UI.UltBar

	if not magic or not magic.Parent then
		styleUltimateBar()
		magic = S.UI.UltBar
	end

	if not magic then
		return
	end

	-- Random number of pixels, never a fixed pattern.
	local amount =
		math.random(
			1,
			CFG.UI_GLITCH_AMOUNT
		)

	for _ = 1, amount do
		createGlitchPixel()
	end

	-- Occasionally distort the actual existing bar itself.
	if math.random() < 0.22 then
		local oldPosition =
			magic.Position

		local offsetX =
			math.random(
				-5,
				5
			)

		local offsetY =
			math.random(
				-2,
				2
			)

		magic.Position =
			oldPosition
			+ UDim2.fromOffset(
				offsetX,
				offsetY
			)

		task.delay(
			math.random(
				2,
				6
			) / 100,
			function()
				if magic and magic.Parent then
					magic.Position =
						oldPosition
				end
			end
		)
	end
end

local function startGlitchLoop()
	task.spawn(function()
		while Player.Parent do
			if CFG.UI_GLITCH_ENABLED then
				pcall(function()
					glitchUltimateBar()
				end)
			end

			task.wait(
				math.random(
					CFG.UI_GLITCH_INTERVAL_MIN * 1000,
					CFG.UI_GLITCH_INTERVAL_MAX * 1000
				) / 1000
			)
		end
	end)
end

-- ============================================================
-- CHARACTER TAB
-- ============================================================

local function fixCharacterTab()
	local gui =
		Player:FindFirstChild(
			"PlayerGui"
		)

	if not gui then
		return
	end

	local topbar =
		gui:FindFirstChild(
			"TopbarPlus"
		)

	if not topbar then
		return
	end

	for _, object in ipairs(
		topbar:GetDescendants()
	) do

		if object.Name ~= "IconButton" then
			continue
		end

		local label =
			object:FindFirstChild(
				"IconLabel"
			)

		local image =
			object:FindFirstChild(
				"IconImage"
			)

		if label and
			label:IsA("TextLabel")
		then

			local current =
				label.Text

			if
				current == "Garou"
				or current == "Hero Hunter"
				or current == "Dark Garou"
			then

				label.Text =
					MOVESET_NAME

				if image and
					(
						image:IsA("ImageLabel")
						or image:IsA("ImageButton")
					)
				then
					image.Image =
						DECAL_ID
				end
			end
		end
	end
end

