-- ================================================================
-- ANIMATION HANDLER
-- ================================================================

local function setupAnimationHandler(
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	token: number
)

	track(
		humanoid.AnimationPlayed:Connect(
			function(animationTrack)

				if token
					~= SESSION.CharacterToken
				then
					return
				end

				local animation =
					animationTrack.Animation

				if not animation then
					return
				end

				local id =
					normalizeAnimationId(
						animation.AnimationId
					)

				-- =================================================
				-- M1
				-- =================================================

				if M1_TRIGGERS[id] then

					pcall(function()
						animationTrack:Stop(0)
					end)

					performM1()

					return
				end

				-- =================================================
				-- MOVES
				-- =================================================

				local move =
					MOVE_TRIGGERS[id]

				if move then

					pcall(function()
						animationTrack:Stop(0)
					end)

					if move == 1 then

						phantomEngine(1)

					elseif move == 2 then

						voidTeleport()

					elseif move == 3 then

						creatorRush()

					elseif move == 4 then

						creatorExecution()

					end

					return
				end

				-- =================================================
				-- ULT
				-- =================================================

				local ult =
					ULT_TRIGGERS[id]

				if ult then

					pcall(function()
						animationTrack:Stop(0)
					end)

					creatorUltimate(
						ult
					)

					return
				end
			end
		),
		SESSION.CharacterConnections
	)
end

