-- ============================================================
-- VFX COLOR OVERRIDE
-- ============================================================

local function greenColorSequence()
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, CREATOR_GREEN),
		ColorSequenceKeypoint.new(0.35, GLITCH_GREEN),
		ColorSequenceKeypoint.new(0.72, CREATOR_GREEN_2),
		ColorSequenceKeypoint.new(1, CREATOR_GREEN_DARK),
	})
end

local function recolorVFX(root)
	if not root then
		return
	end

	for _, object in ipairs(root:GetDescendants()) do

		if object:IsA("ParticleEmitter") then
			object.Color = greenColorSequence()
			object.LightEmission = math.max(object.LightEmission, 0.75)

		elseif object:IsA("Trail") then
			object.Color = greenColorSequence()
			object.LightEmission = 1

		elseif object:IsA("Beam") then
			object.Color = greenColorSequence()
			object.LightEmission = 1

		elseif object:IsA("PointLight") then
			object.Color = CREATOR_GREEN
			object.Brightness = math.max(object.Brightness, 1)

		elseif object:IsA("SpotLight") then
			object.Color = CREATOR_GREEN

		elseif object:IsA("SurfaceLight") then
			object.Color = CREATOR_GREEN

		elseif object:IsA("Highlight") then
			object.FillColor = CREATOR_GREEN_DARK
			object.OutlineColor = GLITCH_GREEN

		elseif object:IsA("BasePart") then
			if object.Material == Enum.Material.Neon then
				object.Color = CREATOR_GREEN
			end
		end
	end

	if root:IsA("ParticleEmitter") then
		root.Color = greenColorSequence()
	end
end

-- ============================================================
-- RESOURCE PATH RESOLVER
-- ============================================================

local function resolvePath(root, path)
	local current = root

	for segment in string.gmatch(path, "[^%.]+") do
		current = current:FindFirstChild(segment)

		if not current then
			return nil
		end
	end

	return current
end

-- ============================================================
-- RESOURCE VFX CLONER
-- ============================================================

local function spawnResourceVFX(path, parent, emitAmount, lifetime)
	if not parent or not parent.Parent then
		return nil
	end

	local source = resolvePath(ReplicatedStorage, path)

	if not source then
		return nil
	end

	local clone = source:Clone()

	clone.Name = "CreatorGreenVFX"

	if clone:IsA("Attachment")
		or clone:IsA("Folder")
		or clone:IsA("Model")
		or clone:IsA("BasePart") then

		clone.Parent = parent
	else
		clone.Parent = parent
	end

	recolorVFX(clone)

	local amount = emitAmount or 15

	for _, child in ipairs(clone:GetDescendants()) do
		if child:IsA("ParticleEmitter") then
			child:Emit(amount)
			child.Enabled = true
		end
	end

	if clone:IsA("ParticleEmitter") then
		clone:Emit(amount)
		clone.Enabled = true
	end

	Debris:AddItem(clone, lifetime or 2.5)

	return clone
end

local function randomResourceVFX(parent, amount)
	if #VFX_PATHS <= 0 then
		return
	end

	local path = VFX_PATHS[math.random(1, #VFX_PATHS)]

	spawnResourceVFX(
		path,
		parent,
		amount or 15,
		2.5
	)
end

-- ============================================================
-- VFX RATE LIMIT
-- ============================================================

local function allowedVFX(key, cooldown)
	local now = os.clock()

	local previous = S.LastVFX[key] or 0

	if now - previous < (cooldown or CFG.VFX_COOLDOWN) then
		return false
	end

	S.LastVFX[key] = now

	return true
end

