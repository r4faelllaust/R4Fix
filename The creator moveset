local function burst(
	cframe: CFrame,
	size: number,
	color: Color3,
	duration: number?,
	key: string?
)
	if key and not allowed(key) then
		return
	end

	local part = Instance.new("Part")

	part.Name = "CreatorBurst"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false

	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon

	part.Color = color
	part.Transparency = 0.08

	part.Size = Vector3.one
	part.CFrame = cframe

	part.Parent = getVFXFolder()

	local tween = TweenService:Create(
		part,
		TweenInfo.new(
			duration or 0.3,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(size, size, size),
			Transparency = 1,
		}
	)

	tween:Play()

	Debris:AddItem(
		part,
		(duration or 0.3) + 0.1
	)
end

