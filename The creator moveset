	local attachment = Instance.new("Attachment")
	attachment.Parent = parent

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color or GREEN_BRIGHT)
	emitter.LightEmission = 1
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.18, 0.6)
	emitter.Speed = NumberRange.new(7, 22)
	emitter.Drag = 5
