-- ============================================================
-- TARGET VALIDATION
-- ============================================================

local function validTarget(character)
	if not character then
		return false
	end

	if character == LP.Character then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return true
end

-- ============================================================
-- TARGET SEARCH
-- ============================================================

local function getClosestTarget()
	local _, _, myRoot =
		getCharacter()

	if not myRoot then
		return nil
	end

	local closest = nil

	local closestDistance =
		CFG.TARGET_RADIUS

	-- First search workspace.Live.
	local live =
		workspace:FindFirstChild("Live")

	if live then
		for _, object in
			ipairs(live:GetChildren())
		do
			if validTarget(object) then
				local root =
					object:FindFirstChild(
						"HumanoidRootPart"
					)

				if root then
					local distance =
						(
							root.Position -
							myRoot.Position
						).Magnitude

					if distance <
						closestDistance
					then
						closestDistance =
							distance

						closest = object
					end
				end
			end
		end
	end

	-- Then player characters.
	for _, player in
		ipairs(Players:GetPlayers())
	do
		if player ~= LP then
			local character =
				player.Character

			if validTarget(character) then
				local root =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if root then
					local distance =
						(
							root.Position -
							myRoot.Position
						).Magnitude

					if distance <
						closestDistance
					then
						closestDistance =
							distance

						closest = character
					end
				end
			end
		end
	end

	return closest
end

-- ============================================================
-- TELEPORT BEHIND TARGET
-- ============================================================

local function teleportBehind(target)
	local _, _, myRoot =
		getCharacter()

	if not myRoot then
		return false
	end

	if not validTarget(target) then
		return false
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot then
		return false
	end

	local destination =
		targetRoot.Position -
		targetRoot.CFrame.LookVector *
		CFG.BEHIND_DISTANCE

	local newCFrame =
		CFrame.lookAt(
			destination,
			targetRoot.Position
		)

	-- Departure.
	burst(
		myRoot.Position,
		6,
		GREEN,
		0.16
	)

	glitchShards(
		myRoot.Position,
		8,
		2.2
	)

	-- Teleport.
	myRoot.CFrame = newCFrame

	myRoot.AssemblyLinearVelocity =
		Vector3.zero

	myRoot.AssemblyAngularVelocity =
		Vector3.zero

	-- Arrival.
	burst(
		destination,
		8,
		BRIGHT_GREEN,
		0.18
	)

	ring(
		destination,
		2,
		22,
		GREEN,
		0.3
	)

	particles(
		myRoot,
		25,
		TOXIC_GREEN
	)

	return true
end

-- ============================================================
-- FACE TARGET
-- ============================================================

local function faceTarget(target)
	local character, _, root =
		getCharacter()

	if not character or not root then
		return
	end

	if not validTarget(target) then
		return
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot then
		return
	end

	local position = root.Position

	root.CFrame =
		CFrame.lookAt(
			position,
			Vector3.new(
				targetRoot.Position.X,
				position.Y,
				targetRoot.Position.Z
			)
		)

	root.AssemblyLinearVelocity =
		Vector3.zero
end

-- ============================================================
-- PHANTOM ENGINE
-- ============================================================

local function phantomEngine(
	duration,
	speed,
	token
)
	local character, humanoid, root =
		getCharacter()

	if not character or
		not humanoid or
		not root
	then
		return
	end

	local velocity =
		Instance.new("BodyVelocity")

	velocity.Name =
		"R4Fix_Creator_PhantomEngine"

	velocity.MaxForce =
		Vector3.new(
			10000000,
			0,
			10000000
		)

	velocity.P = 100000

	velocity.Parent = root

	local leftAttachment =
		Instance.new("Attachment")

	leftAttachment.Position =
		Vector3.new(
			-1.15,
			0,
			0
		)

	leftAttachment.Parent =
		root

	local rightAttachment =
		Instance.new("Attachment")

	rightAttachment.Position =
		Vector3.new(
			1.15,
			0,
			0
		)

	rightAttachment.Parent =
		root

	local trail =
		Instance.new("Trail")

	trail.Name =
		"Creator_PhantomTrail"

	trail.Attachment0 =
		leftAttachment

	trail.Attachment1 =
		rightAttachment

	trail.Lifetime = 0.28

	trail.LightEmission = 1

	trail.Color =
		ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				BRIGHT_GREEN
			),

			ColorSequenceKeypoint.new(
				0.5,
				GREEN
			),

			ColorSequenceKeypoint.new(
				1,
				BLACK
			),
		})

	trail.Transparency =
		NumberSequence.new(
			0.05,
			1
		)

	trail.Parent = root

	burst(
		root.Position,
		7,
		GREEN,
		0.18
	)

	ring(
		root.Position,
		2,
		19,
		BRIGHT_GREEN,
		0.25
	)

	local start =
		os.clock()

	while
		S.Alive
		and token == S.Token
		and root.Parent
		and humanoid.Health > 0
		and os.clock() - start < duration
	do
		local direction =
			root.CFrame.LookVector

		velocity.Velocity =
			Vector3.new(
				direction.X * speed,
				0,
				direction.Z * speed
			)

		RunService.Heartbeat:Wait()
	end

	pcall(function()
		velocity:Destroy()
	end)

	pcall(function()
		trail:Destroy()
		leftAttachment:Destroy()
		rightAttachment:Destroy()
	end)

	if root.Parent then
		burst(
			root.Position,
			9,
			BRIGHT_GREEN,
			0.2
		)
	end
end

-- ============================================================
-- M1
-- ============================================================

local function creatorM1()
	if not S.Alive then
		return
	end

	local now = os.clock()

	if now - (S.LastM1 or 0) <
		CFG.M1_COOLDOWN
	then
		return
	end

	S.LastM1 = now

	local character, humanoid, root =
		getCharacter()

	if not character or
		not humanoid or
		not root
	then
		return
	end

	local target =
		getClosestTarget()

	-- Target acquisition happens FIRST.
	if target then
		local success =
			teleportBehind(target)

		if success then
			task.wait()

			faceTarget(target)

			local targetRoot =
				target:FindFirstChild(
					"HumanoidRootPart"
				)

			if targetRoot then
				flash(
					targetRoot.Position,
					BRIGHT_GREEN
				)

				burst(
					targetRoot.Position,
					7,
					TOXIC_GREEN,
					0.15
				)

				ring(
					targetRoot.Position,
					2,
					18,
					GREEN,
					0.23
				)

				glitchShards(
					targetRoot.Position,
					10,
					2
				)
			end
		end
	else
		burst(
			root.Position,
			5,
			GREEN,
			0.15
		)
	end

	playAnimation(
		humanoid,
		ANIM.M1,
		1,
		0.03
	)

	particles(
		root,
		20,
		TOXIC_GREEN
	)

	-- Local impact effect.
	task.delay(
		0.08,
		function()
			if root.Parent then
