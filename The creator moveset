			fill.ImageTransparency = 0

		elseif fill:IsA("Frame") then

			fill.BackgroundColor3 =
				ULT_GREEN_BRIGHT

			fill.BackgroundTransparency = 0
		end

		local gradient =
			fill:FindFirstChildOfClass(
				"UIGradient"
			)

		if gradient then
			gradient.Color =
				ColorSequence.new({
					ColorSequenceKeypoint.new(
						0,
						ULT_GREEN_BRIGHT
					),

					ColorSequenceKeypoint.new(
						0.35,
						ULT_GREEN
					),

					ColorSequenceKeypoint.new(
