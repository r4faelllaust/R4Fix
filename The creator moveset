local function teleportBehindPlayer(
	target: Player
)
	local _, humanoid, hrp =
		getCharacter()

	if not humanoid
		or not hrp
		or humanoid.Health <= 0
	then
		return false
	end

	if not target
		or not isAlivePlayer(target)
	then
		return false
	end

	local targetCharacter =
		target.Character

	if not targetCharacter then
		return false
	end

	local targetHumanoid =
		targetCharacter:FindFirstChildOfClass(
			"Humanoid"
		)

	local targetHRP =
		targetCharacter:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetHumanoid
		or not targetHRP
		or not targetHRP:IsA("BasePart")
		or targetHumanoid.Health <= 0
	then
		return false
	end

	local targetPosition =
		targetHRP.Position
		- targetHRP.CFrame.LookVector
		* CFG.M1_BEHIND_DISTANCE

	targetPosition += Vector3.new(
		0,
		CFG.M1_VERTICAL_OFFSET,
		0
	)

	local destination =
		CFrame.lookAt(
			targetPosition,
			targetHRP.Position
		)

	-- Departure
	burst(
		hrp.CFrame,
		5,
		GREEN_DARK,
		0.12,
		"m1_depart"
	)

	particles(
		hrp,
		10,
		GREEN_DARK,
		"m1_depart_particles"
	)

	-- Teleport
	hrp.CFrame = destination

	hrp.AssemblyLinearVelocity =
		Vector3.zero

	-- Arrival
	burst(
		hrp.CFrame,
		7,
		GREEN_BRIGHT,
		0.16,
		"m1_arrive"
	)

	ring(
		hrp.CFrame,
		1,
		9,
		GREEN_BRIGHT,
		0.16,
		"m1_arrive_ring"
	)

	particles(
		hrp,
		18,
		GREEN_BRIGHT,
		"m1_arrive_particles"
	)

	slash(
		hrp.CFrame
			* CFrame.Angles(
				0,
				math.rad(90),
				math.rad(25)
			),

		7,
		0.45,
		GREEN_BRIGHT
	)

	playSound(
		hrp,
		0.8,
		1.1
	)

	return true
end

-- ============================================================
-- M1
-- ============================================================

local function creatorM1()
	local now = os.clock()

	if now - S.LastM1
		< CFG.M1_COOLDOWN
	then
		return
	end

	S.LastM1 = now

	local target =
		getClosestPlayer(
			CFG.M1_TARGET_RANGE
		)

	-- IMPORTANT:
	-- This happens independently from the actual game's
	-- M1 hit detection.
	--
	-- Therefore, even if the M1 swing misses,
	-- the Creator still snaps behind the nearest target.

	if target then
		teleportBehindPlayer(target)
	end

	S.Ultimate = math.clamp(
		(S.Ultimate or 0)
			+ CFG.ULT_GAIN_M1,

		0,
		CFG.ULT_MAX
	)

	local _, _, hrp =
		getCharacter()

	if hrp then
		ring(
			hrp.CFrame,
			1.5,
			8,
			GREEN_BRIGHT,
			0.18,
			"m1_ring"
		)

		particles(
			hrp,
			8,
			GREEN_BRIGHT,
			"m1_flash_particles"
		)
	end
end

-- ============================================================
-- M1 INPUT
-- ============================================================

local function handleM1Input()
	local now = os.clock()

	-- Deduplicate MouseButton1 + UserInputService firing
	-- for the same physical click.

	if now - S.LastInputM1 < 0.025 then
		return
	end

	S.LastInputM1 = now

	if S.Token <= 0 then
		return
	end

	creatorM1()
end

addConnection(
	S.Connections,

	UserInputService.InputBegan:Connect(
		function(input, processed)
			if input.UserInputType
				== Enum.UserInputType.MouseButton1
			then
				-- We intentionally do NOT reject processed
				-- mouse input here. The Creator M1 must still
				-- work if the game's UI consumed the click.

				handleM1Input()
			end

			if input.KeyCode
				== Enum.KeyCode.G
			then
				S.Ultimate = CFG.ULT_MAX
			end
		end
	)
)

local mouse = LocalPlayer:GetMouse()

if mouse then
	addConnection(
		S.Connections,

		mouse.Button1Down:Connect(
			function()
				handleM1Input()
			end
		)
	)
end

-- ============================================================
-- PHANTOM ENGINE
-- ============================================================

local function phantomEngine(
	duration: number,
	speed: number,
	token: number
)
	local character, humanoid, hrp =
		getCharacter()

	if not character
		or not humanoid
		or not hrp
	then
		return false
	end

	if token ~= S.Token
		or humanoid.Health <= 0
	then
		return false
	end

	local velocity =
		Instance.new("BodyVelocity")

	velocity.Name =
		"Creator_PhantomEngine"

	velocity.MaxForce =
		Vector3.new(
			5000000,
			0,
			5000000
		)

	velocity.P = 75000
	velocity.Parent = hrp

	local a0 = Instance.new("Attachment")
	a0.Position =
		Vector3.new(
			-1.1,
			0,
			0
		)

	a0.Parent = hrp

	local a1 = Instance.new("Attachment")
	a1.Position =
		Vector3.new(
			1.1,
			0,
			0
		)

	a1.Parent = hrp

	local trail =
		Instance.new("Trail")

	trail.Name =
		"CreatorPhantomTrail"

	trail.Attachment0 = a0
	trail.Attachment1 = a1

	trail.Lifetime = 0.32
	trail.LightEmission = 1

	trail.Color =
		ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				GREEN_BRIGHT
			),

			ColorSequenceKeypoint.new(
				0.55,
				GREEN
			),

			ColorSequenceKeypoint.new(
				1,
				GREEN_DARK
			),
		})

	trail.Transparency =
		NumberSequence.new(
			0.02,
			1
		)

	trail.Parent = hrp

	-- Start burst
	burst(
		hrp.CFrame,
		7,
		GREEN_DARK,
		0.18,
		"phantom_start"
	)

	burst(
		hrp.CFrame,
		3.5,
		GREEN_BRIGHT,
		0.14,
		"phantom_core"
	)

	ring(
		hrp.CFrame,
		2,
		17,
		GREEN_BRIGHT,
		0.3,
		"phantom_ring"
	)

	local start = os.clock()

	while
		os.clock() - start < duration
	do
		if token ~= S.Token then
			break
		end

		if not hrp.Parent
			or humanoid.Health <= 0
		then
			break
		end

		local direction =
			hrp.CFrame.LookVector

		velocity.Velocity =
			Vector3.new(
				direction.X * speed,
				0,
				direction.Z * speed
			)

		if allowed(
			"phantom_tick",
			0.055
		) then
			particles(
				hrp,
				6,
				GREEN_BRIGHT
			)

			ring(
				hrp.CFrame,
				1,
				5,
				GREEN_DARK,
				0.12
			)
		end

		RunService.Heartbeat:Wait()
	end

	safeDestroy(velocity)
	safeDestroy(trail)
	safeDestroy(a0)
	safeDestroy(a1)

	if hrp.Parent then
		burst(
			hrp.CFrame,
			9,
			GREEN_BRIGHT,
			0.25,
			"phantom_end"
		)

		ring(
			hrp.CFrame,
			2,
			20,
			GREEN_BRIGHT,
			0.28,
			"phantom_end_ring"
		)
	end

	return true
end

