-- ============================================================
-- CLEANUP
-- ============================================================

local function disconnectList(list: {RBXScriptConnection})
	for _, connection in ipairs(list) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(list)
end

local function cleanupAnimations()
	for _, track in ipairs(S.AnimationTracks) do
		pcall(function()
			if track.IsPlaying then
				track:Stop(0.05)
			end

			track:Destroy()
		end)
	end

	table.clear(S.AnimationTracks)
end

local function destroyVFXFolder()
	if S.EffectsFolder then
		pcall(function()
			S.EffectsFolder:Destroy()
		end)

		S.EffectsFolder = nil
	end

	local old = workspace:FindFirstChild("TheCreator_VFX")

	if old then
		pcall(function()
			old:Destroy()
		end)
	end
end

local function cleanupCharacter()
	disconnectList(S.CharacterConnections)
	cleanupAnimations()

	S.Busy = {}
	table.clear(S.LastVFX)

	destroyVFXFolder()
end

-- ============================================================
-- CHARACTER
-- ============================================================

local function getCharacter()
	local character = LocalPlayer.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return nil, nil, nil
	end

	return character, humanoid, root
end

-- ============================================================
-- VFX FOLDER
-- ============================================================

local function getVFXFolder()
	if S.EffectsFolder and S.EffectsFolder.Parent then
		return S.EffectsFolder
	end

	local folder = workspace:FindFirstChild("TheCreator_VFX")

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "TheCreator_VFX"
		folder.Parent = workspace
	end

	S.EffectsFolder = folder

	return folder
end

-- ============================================================
-- VFX RATE LIMIT
-- ============================================================

local function allowed(key: string, cooldown: number?): boolean
	local now = os.clock()

	local last = S.LastVFX[key] or 0

	if now - last < (cooldown or CFG.VFX_COOLDOWN) then
		return false
	end

	S.LastVFX[key] = now

	return true
end

