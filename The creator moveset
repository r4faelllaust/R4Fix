-- ================================================================
-- TARGETING
-- ================================================================

local function getLiveFolder(): Instance?
	return workspace:FindFirstChild("Live")
end

local function validTarget(
	model: Model,
	ownCharacter: Model
): boolean

	if model == ownCharacter then
		return false
	end

	local humanoid =
		model:FindFirstChildOfClass("Humanoid")

	local root =
		model:FindFirstChild("HumanoidRootPart")

	if not humanoid
		or not root
		or not root:IsA("BasePart")
	then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return true
end

local function getClosestTarget(): Model?

	local character, _, root =
		getCharacter()

	if not character or not root then
		return nil
	end

	local live =
		getLiveFolder()

	if not live then
		return nil
	end

	local closest: Model? = nil
	local closestDistance =
		CONFIG.M1Range

	for _, object in ipairs(
		live:GetChildren()
	) do

		if object:IsA("Model")
			and validTarget(
				object,
				character
			)
		then

			local targetRoot =
				object:FindFirstChild(
					"HumanoidRootPart"
				)

			if targetRoot
				and targetRoot:IsA("BasePart")
			then

				local distance =
					(
						targetRoot.Position
						- root.Position
					).Magnitude

				if distance <
					closestDistance
				then

					closestDistance =
						distance

					closest =
						object
				end
			end
		end
	end

	return closest
end

-- ================================================================
-- REAL M1 BLINK
-- ================================================================

local function blinkBehindTarget(
	target: Model
): boolean

	local character, _, root =
		getCharacter()

	if not character
		or not root
		or not target
	then
		return false
	end

	if not validTarget(
		target,
		character
	) then
		return false
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot
		or not targetRoot:IsA("BasePart")
	then
		return false
	end

	local targetPosition =
		targetRoot.Position

	local behindPosition =
		targetPosition
		- targetRoot.CFrame.LookVector
		* CONFIG.M1BehindDistance

	behindPosition +=
		Vector3.new(
			0,
			0.15,
			0
		)

	local destination =
		CFrame.lookAt(
			behindPosition,
			targetPosition
		)

	-- DEPARTURE
	chaoticBurst(
		root.CFrame,
		2.2,
		"m1_depart"
	)

	afterimage(
		character,
		root.CFrame
	)

	-- ACTUAL BLINK
	local success =
		pcall(function()
			character:PivotTo(
				destination
			)
		end)

	if not success then
		return false
	end

	root.AssemblyLinearVelocity =
		Vector3.zero

	root.AssemblyAngularVelocity =
		Vector3.zero

	-- ARRIVAL
	chaoticBurst(
		destination,
		2.7,
		"m1_arrive"
	)

	glitchParticles(
		root,
		30,
		"m1_arrive_particles"
	)

	SESSION.LastTarget =
		target

	return true
end

-- ================================================================
-- M1
-- ================================================================

local function performM1()

	local now =
		os.clock()

	if now - SESSION.LastM1
		< CONFIG.M1Cooldown
	then
		return
	end

	SESSION.LastM1 =
		now

	local character, humanoid, root =
		getCharacter()

	if not character
		or not humanoid
		or not root
	then
		return
	end

	local target =
		getClosestTarget()

	-- IMPORTANT:
	-- BLINK FIRST.
	-- ANIMATION SECOND.
	if target then
		blinkBehindTarget(
			target
		)
	end

	local animation =
		M1_ANIMATIONS[
			math.random(
				1,
				#M1_ANIMATIONS
			)
		]

	playAnimation(
		humanoid,
		animation,
		Enum.AnimationPriority.Action4,
		1.45
	)

	glitchParticles(
		root,
		18,
		"m1_hand_particles"
	)

	glitchBlocks(
		root.CFrame,
		6,
		"m1_blocks"
	)
end

