-- ============================================================
-- DESTROY
-- ============================================================

S.Destroy = function()
	if not S.Started then
		return
	end

	S.Started = false

	S.Token += 1

	disconnectList(
		S.CharacterConnections
	)

	disconnectList(
		S.Connections
	)

	stopAnimations()

	for _, tool in pairs(
		S.Tools
	) do
		if tool then
			safeDestroy(tool)
		end
	end

	table.clear(
		S.Tools
	)

	if S.Music then
		safeDestroy(S.Music)
		S.Music = nil
	end

	local audio =
		workspace:FindFirstChild(
			"TheCreator_Audio"
		)

	if audio then
		safeDestroy(audio)
	end

	local vfx =
		workspace:FindFirstChild(
			"TheCreator_VFX"
		)

	if vfx then
		safeDestroy(vfx)
	end

	local playerGui =
		LocalPlayer:FindFirstChildOfClass(
			"PlayerGui"
		)

	if playerGui then
		-- Only remove our own UI if one exists.
		-- The updated version does not create a custom
		-- bottom Ultimate UI.
		local oldUI =
			playerGui:FindFirstChild(
				"TheCreatorUltimateUI"
			)

		if oldUI then
			safeDestroy(oldUI)
		end
	end
end

