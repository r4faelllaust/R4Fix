local function isCreatorName(
	text: string
): boolean
	local lowered =
		string.lower(
			text
		)

	return
		lowered == "dark garou"
		or lowered == "garou"
		or lowered == "hero hunter"
		or lowered == "the creator"
		or lowered == "t̷h̷e̷ ̷c̷r̷e̷a̷t̷o̷r̷"
end

local function applyCreatorIcon(
	icon: Instance
)
	if icon.Name ~= "IconButton" then
		return
	end

	local label =
		icon:FindFirstChild(
			"IconLabel",
			true
		)

	local image =
		icon:FindFirstChild(
			"IconImage",
			true
		)

	if not label
		or not label:IsA("TextLabel")
	then
		return
	end

	if not isCreatorName(
		label.Text
	) then
		return
	end

	label.Text =
		CREATOR_GLITCH_NAME

	label.TextColor3 =
		CREATOR_GREEN

	label.TextStrokeColor3 =
		BLACK

	label.TextStrokeTransparency =
		0.1

	if image then

		if image:IsA("ImageLabel")
			or image:IsA("ImageButton")
		then

			image.Image =
				DECAL_ID

			image.ImageColor3 =
				Color3.new(
					1,
					1,
					1
				)
		end
	end

	icon.Visible =
		true
end

local function fixCreatorSelection()
	local gui =
		getPlayerGui()

	if not gui then
		return
	end

	-- First specifically search TopbarPlus.
	local topbar =
		gui:FindFirstChild(
			"TopbarPlus"
		)

	if topbar then

		for _, object in ipairs(
			topbar:GetDescendants()
		) do

			if object.Name ==
				"IconButton"
			then

				applyCreatorIcon(
					object
				)
			end
		end
	end

	-- Then scan the complete GUI.
	-- This catches TopbarPlus rebuilds.
	for _, object in ipairs(
		gui:GetDescendants()
	) do

		if object.Name ==
			"IconButton"
		then

			applyCreatorIcon(
				object
			)
		end
	end
