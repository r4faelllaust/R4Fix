local function disconnectList(list)
	for i = #list, 1, -1 do
		pcall(function() list[i]:Disconnect() end)
		table.remove(list, i)
	end
end
local function addConnection(list, connection)
	if connection then table.insert(list, connection) end
	return connection
end
local function safeDestroy(object)
