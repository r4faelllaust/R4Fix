-- ================================================================
-- IDLE EFFECT
-- ================================================================

local idleConnection:
	RBXScriptConnection? = nil

local function startCreatorIdle(
	root: BasePart,
	humanoid: Humanoid
)
	if idleConnection then

		pcall(function()
			idleConnection:Disconnect()
		end)

		idleConnection =
			nil
	end

	local started =
		os.clock()

	local baseCFrame =
		root.CFrame

	idleConnection =
		RunService.RenderStepped:Connect(
			function()

				if not root.Parent
					or humanoid.Health <= 0
				then

					return
				end

				-- Only bob while actually idle.
				-- Do not fight TSB movement.
				if humanoid.MoveDirection.Magnitude
					> 0.05
				then

					baseCFrame =
						root.CFrame

					return
				end

				local t =
					os.clock()
					- started

				local offset =
					math.sin(
						t * CFG.IdleBobSpeed
					)
					* CFG.IdleBobAmount

				-- Very small visual movement.
				-- Preserve current orientation.
				local current =
					root.CFrame

				root.CFrame =
					CFrame.new(
						current.Position
							+ Vector3.new(
								0,
								offset,
								0
							)
					)
					* CFrame.fromMatrix(
						Vector3.zero,
						current.RightVector,
						current.UpVector
					)
			end
		)

	addCharacterConnection(
		idleConnection
	)
end

