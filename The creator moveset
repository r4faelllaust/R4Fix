local function phantomEngine(duration, speed, token)
	local character, humanoid, hrp = getCharacter()
	if not character or not humanoid or not hrp then return false end
	if token ~= S.Token or humanoid.Health <= 0 then return false end

	local velocity = Instance.new("BodyVelocity")
	velocity.Name = "Creator_PhantomEngine"
	velocity.MaxForce = Vector3.new(5000000, 0, 5000000)
	velocity.P = 75000
	velocity.Parent = hrp

	local a0 = Instance.new("Attachment"); a0.Position = Vector3.new(-1.1, 0, 0); a0.Parent = hrp
	local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(1.1, 0, 0); a1.Parent = hrp
	local trail = Instance.new("Trail")
	trail.Name = "CreatorPhantomTrail"
	trail.Attachment0 = a0; trail.Attachment1 = a1
	trail.Lifetime = 0.32; trail.LightEmission = 1
	trail.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, GREEN_BRIGHT), ColorSequenceKeypoint.new(0.55, GREEN), ColorSequenceKeypoint.new(1, GREEN_DARK)})
	trail.Transparency = NumberSequence.new(0.02, 1)
	trail.Parent = hrp

	burst(hrp.CFrame, 7, GREEN_DARK, 0.18, "phantom_start")
	burst(hrp.CFrame, 3.5, GREEN_BRIGHT, 0.14, "phantom_core")
	ring(hrp.CFrame, 2, 17, GREEN_BRIGHT, 0.3, "phantom_ring")

	local start = os.clock()
	while os.clock() - start < duration do
		if token ~= S.Token then break end
		if not hrp.Parent or humanoid.Health <= 0 then break end
		local direction = hrp.CFrame.LookVector
		velocity.Velocity = Vector3.new(direction.X * speed, 0, direction.Z * speed)
		if allowed("phantom_tick", 0.055) then
			particles(hrp, 6, GREEN_BRIGHT)
			ring(hrp.CFrame, 1, 5, GREEN_DARK, 0.12)
		end
		RunService.Heartbeat:Wait()
	end

	safeDestroy(velocity); safeDestroy(trail); safeDestroy(a0); safeDestroy(a1)

	if hrp.Parent then
		burst(hrp.CFrame, 9, GREEN_BRIGHT, 0.25, "phantom_end")
		ring(hrp.CFrame, 2, 20, GREEN_BRIGHT, 0.28, "phantom_end_ring")
	end
	return true
end

local function creatorMove1(token)
	if S.Busy.Move1 then return end
	local character, humanoid, hrp = getCharacter()
	if not character or not humanoid or not hrp then return end
	S.Busy.Move1 = true

	local track = playAnimation(humanoid, MOVE1_ANIMATION, Enum.AnimationPriority.Action4, 1, 1)

	burst(hrp.CFrame, 9, GREEN_DARK, 0.25, "move1_charge")
	burst(hrp.CFrame, 4, GREEN_BRIGHT, 0.18, "move1_core")
	ring(hrp.CFrame, 3, 20, GREEN_BRIGHT, 0.4, "move1_charge_ring")
	particles(hrp, 35, GREEN_BRIGHT, "move1_charge_particles")
	playSound(hrp, 1.1, 0.9)

	phantomEngine(0.58, CFG.PHANTOM_SPEED, token)
	if token ~= S.Token then S.Busy.Move1 = nil; return end

	local oldCF = hrp.CFrame
	local direction = hrp.CFrame.LookVector
	local voidPosition = hrp.Position + direction * CFG.VOID_DISTANCE + Vector3.new(0, CFG.VOID_HEIGHT, 0)
	local voidCF = CFrame.lookAt(voidPosition, voidPosition + direction)

	burst(oldCF, 11, GREEN_BRIGHT, 0.2, "void_depart")
	burst(oldCF, 5, BLACK, 0.3, "void_depart_black")
	ring(oldCF, 4, 30, GREEN_BRIGHT, 0.4, "void_depart_ring")

	hrp.CFrame = voidCF
	hrp.AssemblyLinearVelocity = Vector3.zero

	burst(voidCF, 16, BLACK, 0.4, "void_arrive")
	burst(voidCF, 10, GREEN_BRIGHT, 0.3, "void_core")
	ring(voidCF, 5, 40, GREEN_BRIGHT, 0.55, "void_ring")
	particles(hrp, 55, GREEN_BRIGHT, "void_particles")
	playSound(hrp, 1.7, 0.68)

	task.delay(CFG.VOID_DURATION, function()
		if token ~= S.Token then S.Busy.Move1 = nil; return end
		if hrp.Parent and humanoid.Health > 0 then
			burst(hrp.CFrame, 15, GREEN_BRIGHT, 0.3, "void_return")
			hrp.CFrame = oldCF
			hrp.AssemblyLinearVelocity = Vector3.zero
			burst(oldCF, 13, GREEN_BRIGHT, 0.3, "void_reappear")
			ring(oldCF, 3, 34, GREEN_BRIGHT, 0.42)
			particles(hrp, 50, GREEN_BRIGHT)
		end
		S.Busy.Move1 = nil
	end)

	if track then
		task.delay(1, function()
			pcall(function() if track.IsPlaying then track:Stop(0.06) end end)
		end)
	end
end

