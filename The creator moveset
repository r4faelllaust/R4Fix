local function getCharacter()
	local character = Player.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not hrp then
		return nil, nil, nil
	end

	return character, humanoid, hrp
end

local function getAnimator(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

local function normalizeAnimationId(id)
	if not id then
		return ""
	end

	return tostring(id):gsub("rbxassetid://", "")
end

local function isAliveCharacter(model)
	if not model or not model:IsA("Model") then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local hrp = model:FindFirstChild("HumanoidRootPart")

	return humanoid ~= nil
		and hrp ~= nil
		and humanoid.Health > 0
end

-- ============================================================
-- TARGET SEARCH
-- ============================================================

local function getNearestTarget(maxDistance)
	local _, _, myHRP = getCharacter()

	if not myHRP then
		return nil, math.huge
	end

	local live = workspace:FindFirstChild("Live")

	local container = live or workspace

	local nearest = nil
	local nearestDistance = maxDistance or CFG.TARGET_RANGE

	for _, model in ipairs(container:GetChildren()) do
		if model ~= Player.Character and isAliveCharacter(model) then

			local targetHRP = model:FindFirstChild("HumanoidRootPart")

			if targetHRP then
				local distance = (targetHRP.Position - myHRP.Position).Magnitude

				if distance < nearestDistance then
					nearestDistance = distance
					nearest = model
				end
			end
		end
	end

	return nearest, nearestDistance
end

-- ============================================================
-- BEHIND TARGET SNAP
-- ============================================================

local function snapBehindTarget(target, distance)
	local character, humanoid, hrp = getCharacter()

	if not character or not humanoid or not hrp then
		return false
	end

	if not target or not isAliveCharacter(target) then
		return false
	end

	local targetHRP = target:FindFirstChild("HumanoidRootPart")

	if not targetHRP then
		return false
	end

	local offset = distance or 3.25

	local behind =
		targetHRP.Position
		- targetHRP.CFrame.LookVector * offset

	local position = Vector3.new(
		behind.X,
		targetHRP.Position.Y,
		behind.Z
	)

	local lookAt = Vector3.new(
		targetHRP.Position.X,
		position.Y,
		targetHRP.Position.Z
	)

	hrp.CFrame = CFrame.lookAt(position, lookAt)
	hrp.AssemblyLinearVelocity = Vector3.zero

	return true
end

