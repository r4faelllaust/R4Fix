-- ============================================================
-- MOVE HANDLER
-- ============================================================

local function setupMoveHandler(
	character,
	humanoid,
	hrp,
	token
)
	addCharacterConnection(
		humanoid.AnimationPlayed:Connect(
			function(track)
				if token ~= S.Token then
					return
				end

				local animation =
					track.Animation

				if not animation then
					return
				end

				local id =
					animation.AnimationId

				local numeric =
					id:match("%d+")

				if not numeric then
					return
				end

				-- =================================================
				-- M1
				-- =================================================

				if M1_TRIGGERS[numeric] then
					-- Do NOT stop the actual M1.
					-- The teleport occurs while the underlying
					-- attack remains alive.
					creatorM1(token)
					return
				end

				-- =================================================
				-- MOVE 1
				-- =================================================

				if numeric ==
					MOVE1_TRIGGER
				then
					pcall(function()
						track:Stop()
					end)

					move1(token)
					return
				end

				-- =================================================
				-- MOVE 2
				-- =================================================

				if numeric ==
					MOVE2_TRIGGER
				then
					pcall(function()
						track:Stop()
					end)

					move2(token)
					return
				end

				-- =================================================
				-- MOVE 3
				-- =================================================

				if numeric ==
					MOVE3_TRIGGER
				then
					pcall(function()
						track:Stop()
					end)

					move3(token)
					return
				end

				-- =================================================
				-- MOVE 4
				-- =================================================

				if numeric ==
					MOVE4_TRIGGER
				then
					pcall(function()
						track:Stop()
					end)

					move4(token)
					return
				end

				-- =================================================
				-- ULTIMATE ACTIVATION
				-- =================================================

				if ULT_ACTIVATION_TRIGGERS[numeric] then
					pcall(function()
						track:Stop()
					end)

					ultimateIntro()
					return
				end

				-- =================================================
				-- ULTIMATE MOVES
				-- =================================================

				for index, data in ipairs(
					ULT_MOVES
				) do
					if numeric ==
						data.Trigger
					then
						pcall(function()
							track:Stop()
						end)

						playUltimate(index)
						return
					end
				end
			end
		)
	)
end

-- ============================================================
-- CHARACTER CLEANUP
-- ============================================================

local function cleanupCharacter()
	disconnectList(
		S.CharacterConnections
	)

	stopCreatorAnimations()

	S.Busy = {}
	S.Target = nil

	table.clear(
		S.LastVFX
	)

	local folder =
		workspace:FindFirstChild(
			"R4Fix_TheCreator_VFX"
		)

	if folder then
		pcall(function()
			folder:Destroy()
		end)
	end
end

-- ============================================================
-- CHARACTER SETUP
-- ============================================================

local function setupCharacter(character)
	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local hrp =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not hrp
	then
		return
	end

	applyNight()

	spawnEffect(
		character,
		hrp
	)

	setupMoveHandler(
		character,
		humanoid,
		hrp,
		token
	)

	addCharacterConnection(
		humanoid.Died:Connect(
			function()
				S.Busy = {}

				stopCreatorAnimations()
			end
		)
	)

	task.spawn(function()
		for _ = 1, 25 do
			if token ~= S.Token then
				return
			end

			pcall(function()
				updateCharacterTab()
				styleUltimateBar()
			end)

			task.wait(0.12)
		end
	end)
end

