local function cloneResource(index: number, parent: Instance, amount: number?, lifetime: number?)
	local template = getResource(index)

	if not template or not parent then
		return nil
	end

	local clone = template:Clone()

	recolorObject(clone)

	clone.Parent = parent

	for _, child in ipairs(clone:GetDescendants()) do
		if child:IsA("ParticleEmitter") then

			child.Enabled = false

			pcall(function()
				child:Emit(amount or 8)
			end)
		end
	end

	local life = lifetime or 0.38

	Debris:AddItem(clone, life)

	return clone
end

