-- ============================================================

local function stopCreatorAnimations()
	for i = #S.AnimationTracks, 1, -1 do
		local track = S.AnimationTracks[i]

		pcall(function()
			if track.IsPlaying then
				track:Stop(0.08)
			end

			track:Destroy()
		end)

		S.AnimationTracks[i] = nil
	end
end

local function playAnimation(
	humanoid,
	id,
	priority,
	speed,
	duration,
	looped
)
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	local animator = getAnimator(humanoid)

	local animation = Instance.new("Animation")

	animation.AnimationId = id

	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	animation:Destroy()

	if not ok or not track then
		return nil
	end

	track.Priority =
		priority
		or Enum.AnimationPriority.Action

	track.Looped =
		looped == true

	table.insert(
		S.AnimationTracks,
		track
	)

	pcall(function()
		track:Play(
			0.045,
			1,
			speed or 1
		)
	end)

	if duration then
		task.delay(
			duration,
			function()
				pcall(function()
					if track.IsPlaying then
						track:Stop(0.08)
					end

					track:Destroy()
				end)

				for i = #S.AnimationTracks, 1, -1 do
					if S.AnimationTracks[i] == track then
						table.remove(
							S.AnimationTracks,
							i
						)

						break
					end
				end
			end
		)
	end

	return track
end

