local function findHotbarSlot(
	number: number
): Instance?

	local hotbar =
		PlayerGui:FindFirstChild(
			"Hotbar"
		)

	if not hotbar then
		return nil
	end

	local backpack =
		hotbar:FindFirstChild(
			"Backpack"
		)

	if not backpack then
		return nil
	end

	local frame =
		backpack:FindFirstChild(
			"Hotbar"
		)

	if not frame then
		return nil
	end

	return frame:FindFirstChild(
		tostring(number)
	)
end

-- ================================================================
-- GLITCH TEXT
-- ================================================================

local GLITCH_CHARS = {
	"█",
	"▓",
	"▒",
	"░",
	"X",
	"0",
	"1",
	"/",
	"\\",
	"<",
	">",
	"!",
	"#",
	"%",
	"?",
}

local function glitchString(
	text: string
): string

	local result = {}

	for i = 1, #text do

		local character =
			string.sub(
				text,
				i,
				i
			)

		if math.random() < 0.17 then

			character =
				GLITCH_CHARS[
					math.random(
						1,
						#GLITCH_CHARS
					)
				]

		end

		table.insert(
			result,
			character
		)
	end

	return table.concat(
		result
	)
end

local function styleSlot(
	number: number,
	name: string
)

	local slot =
		findHotbarSlot(number)

	if not slot then
		return
	end

	local base =
		slot:FindFirstChild("Base")

	if base then
		slot = base
	end

	for _, descendant in ipairs(
		slot:GetDescendants()
	) do

		if descendant:IsA("TextLabel")
			or descendant:IsA("TextButton")
		then

			local lower =
				string.lower(
					descendant.Name
				)

			if string.find(
				lower,
				"name",
				1,
				true
			)
				or string.find(
					lower,
					"reuse",
					1,
					true
				)
			then

				pcall(function()

					descendant.Text =
						glitchString(name)

					descendant.TextColor3 =
						GREEN

					descendant.TextStrokeColor3 =
						BLACK

					descendant.TextStrokeTransparency =
						0

				end)
			end
		end
	end

	for _, descendant in ipairs(
		slot:GetDescendants()
	) do

		if descendant:IsA("UIStroke") then

			pcall(function()

				descendant.Color =
					GREEN

				descendant.Transparency =
					0.1

			end)

		elseif descendant:IsA("ImageLabel")
			or descendant:IsA("ImageButton")
		then

			pcall(function()

				descendant.ImageColor3 =
					GREEN

			end)
		end
	end
end

