-- ============================================================
-- VFX LIMITER
-- ============================================================

local function allowed(key, cooldown)
	local now = os.clock()

	local last = S.LastVFX[key] or 0

	if now - last < (cooldown or CFG.VFX_COOLDOWN) then
		return false
	end

	S.LastVFX[key] = now

	return true
end

-- ============================================================
-- VFX: BURST
-- ============================================================

local function creatorBurst(
	cframe,
	size,
	color,
	duration,
	key
)
	if key and not allowed(key) then
		return
	end

	local part = Instance.new("Part")

	part.Name = "CreatorVoidBurst"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false

	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon

	part.Color = color or PURPLE
	part.Transparency = 0.1

	part.Size = Vector3.one
	part.CFrame = cframe

	part.Parent = getVFXFolder()

	local tween = TweenService:Create(
		part,
		TweenInfo.new(
			duration or 0.3,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(
				size,
				size,
				size
			),

			Transparency = 1,
		}
	)

	tween:Play()

	Debris:AddItem(
		part,
		(duration or 0.3) + 0.1
	)
end

