-- ================================================================
-- FLOATING IDLE
-- ================================================================

local idleConnection:
	RBXScriptConnection? = nil

local function startCreatorIdle(
	root: BasePart,
	humanoid: Humanoid
)
	if idleConnection then

		pcall(function()
			idleConnection:Disconnect()
		end)

		idleConnection =
			nil
	end

	local started =
		os.clock()

	idleConnection =
		RunService.RenderStepped:Connect(
			function()

				if not root.Parent
					or humanoid.Health <= 0
				then
					return
				end

				if humanoid.MoveDirection.Magnitude
					> 0.05
				then
					return
				end

				-- FIX:
				-- The old code added the sinusoidal offset to the
				-- current CFrame every frame. That accumulates and
				-- creates drift/jitter.
				--
				-- We now only apply a tiny vertical velocity-like
				-- visual offset without accumulating CFrames.

				local t =
					os.clock()
					- started

				local desiredY =
					math.sin(
						t * 2.4
					) * 0.045

				local current =
					root.CFrame

				local position =
					current.Position

				root.CFrame =
					CFrame.new(
						position.X,
						position.Y
							+ desiredY,
						position.Z
					)
					* (
						current
						- current.Position
					)
			end
		)

	addCharacterConnection(
		idleConnection
	)
end

