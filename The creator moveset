	if not CFG.PROCEDURAL_ANIMATIONS then
		return
	end

	local character =
		humanoid.Parent

	if not character then
		return
	end

	local torso =
		character:FindFirstChild(
			"UpperTorso"
		)
		or character:FindFirstChild(
			"Torso"
		)

	if not torso or not torso:IsA("BasePart") then
		return
	end

	local right =
		torso:FindFirstChild(
			"RightShoulder"
		)

	local left =
		torso:FindFirstChild(
			"LeftShoulder"
		)

	if not right or not left then
		return
	end

	if not right:IsA("Motor6D") or
		not left:IsA("Motor6D")
	then
		return
	end

	local r0 = right.C0
	local l0 = left.C0

	local intensity = 1

	if kind == "ULT" then
		intensity = 1.5
	elseif kind == "HEAVY" then
		intensity = 1.25
	end

	right.C0 =
		r0 *
		CFrame.Angles(
			math.rad(45 * intensity),
			math.rad(-30),
			math.rad(35)
		)

	left.C0 =
		l0 *
		CFrame.Angles(
			math.rad(-25),
			math.rad(20),
			math.rad(-15)
		)

	task.delay(
		0.13,
		function()
			if not right.Parent then
				return
			end

			TweenService:Create(
				right,
				TweenInfo.new(
					0.14,
					Enum.EasingStyle.Quart,
					Enum.EasingDirection.Out
				),
				{
					C0 =
						r0 *
						CFrame.Angles(
							math.rad(-65 * intensity),
							math.rad(10),
							math.rad(-20)
						),
				}
			):Play()
		end
	)

	task.delay(
		0.35,
		function()
			if not right.Parent then
				return
			end

			TweenService:Create(
				right,
				TweenInfo.new(
					0.25,
					Enum.EasingStyle.Quart,
					Enum.EasingDirection.InOut
				),
				{
					C0 = r0,
				}
			):Play()

			TweenService:Create(
				left,
				TweenInfo.new(
					0.25,
					Enum.EasingStyle.Quart,
					Enum.EasingDirection.InOut
				),
				{
					C0 = l0,
				}
			):Play()
		end
	)
end

-- ============================================================
-- PHANTOM ENGINE
-- ============================================================

local function phantomEngine(
	duration: number,
	speed: number,
	token: number
)
	local character, humanoid, root =
		getCharacter()

	if not character or
		not humanoid or
		not root
	then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if token ~= S.Token then
		return false
	end

	local velocity =
		Instance.new("BodyVelocity")

	velocity.Name =
		"TheCreator_PhantomEngine"

	velocity.MaxForce =
		Vector3.new(
			5000000,
			0,
			5000000
		)

	velocity.P = 70000
	velocity.Parent = root

	local a0 =
		Instance.new("Attachment")

	a0.Position =
		Vector3.new(
			-1.2,
			0,
			0
		)

	a0.Parent = root

	local a1 =
		Instance.new("Attachment")

	a1.Position =
		Vector3.new(
			1.2,
			0,
			0
		)

	a1.Parent = root

	local trail =
		Instance.new("Trail")

	trail.Attachment0 = a0
	trail.Attachment1 = a1

	trail.Lifetime = 0.3
	trail.LightEmission = 1

	trail.Color =
		ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				BRIGHT_GREEN
			),

			ColorSequenceKeypoint.new(
				0.5,
				GREEN
			),

			ColorSequenceKeypoint.new(
				1,
				BLACK
			),
		})

	trail.Transparency =
		NumberSequence.new(
			0.05,
			1
		)

	trail.Parent = root

	burst(
		root.CFrame,
		8,
		GREEN,
		0.2,
		"phantom_start"
	)

	ring(
		root.CFrame,
		2,
		18,
		BRIGHT_GREEN,
		0.25,
		"phantom_ring"
	)

	local started = os.clock()

	while
		os.clock() - started < duration
	do
		if token ~= S.Token then
			break
		end

		if not root.Parent then
			break
		end

		if humanoid.Health <= 0 then
			break
		end

		local direction =
			root.CFrame.LookVector

		velocity.Velocity =
			Vector3.new(
				direction.X * speed,
				0,
				direction.Z * speed
			)

		task.wait()
	end

	pcall(function()
		velocity:Destroy()
	end)

	pcall(function()
		trail:Destroy()
		a0:Destroy()
		a1:Destroy()
	end)

	if root.Parent then
		burst(
			root.CFrame,
			10,
			BRIGHT_GREEN,
			0.22,
			"phantom_end"
		)
	end

	return true
end

