local function disconnectList(list)
	for i = #list, 1, -1 do
		local connection = list[i]

		pcall(function()
			connection:Disconnect()
		end)

		table.remove(list, i)
	end
end

local function addCharacterConnection(connection)
	if connection then
		table.insert(S.CharacterConnections, connection)
	end

	return connection
end

local function destroyOurObject(name: string)
	for _, object in ipairs(workspace:GetDescendants()) do
		if object.Name == name then
			pcall(function()
				object:Destroy()
			end)
		end
	end
end

