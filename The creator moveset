local function findChildChain(
	root: Instance,
	...: string
): Instance?
	local current: Instance? =
		root

	local names = {
		...
	}

	for _, name in ipairs(names) do
		if not current then
			return nil
		end

		current =
			current:FindFirstChild(
				name
			)
	end

	return current
end

local function resolveResource(
	paths: {{string}}
): Instance?
	for _, path in ipairs(paths) do

		local current: Instance? =
			ReplicatedStorage

		local valid = true

		for _, segment in ipairs(path) do

			if not current then
				valid = false
				break
			end

			current =
				current:FindFirstChild(
					segment
				)

			if not current then
				valid = false
				break
			end
		end

		if valid and current then
			return current
		end
	end

	return nil
end

