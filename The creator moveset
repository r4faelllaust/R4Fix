-- ============================================================
-- TARGETING
-- ============================================================

local function isValidTarget(character)
	if not character then
		return false
	end

	if character == LocalPlayer.Character then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return true
end

local function getClosestTarget(maxDistance)
	local _, _, myRoot = getCharacter()

	if not myRoot then
		return nil
	end

	local closest = nil
	local closestDistance =
		maxDistance or CFG.TARGET_RADIUS

	-- Prefer Live because that is where TSB-style
	-- character models commonly live.
	local live = workspace:FindFirstChild("Live")

	if live then
		for _, character in ipairs(live:GetChildren()) do
			if isValidTarget(character) then
				local root =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if root then
					local distance =
						(root.Position - myRoot.Position).Magnitude

					if distance < closestDistance then
						closestDistance = distance
						closest = character
					end
				end
			end
		end
	end

	-- Fallback for games where player characters
	-- are not inside Live.
	if not closest then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local character = player.Character

				if isValidTarget(character) then
					local root =
						character:FindFirstChild(
							"HumanoidRootPart"
						)

					if root then
						local distance =
							(root.Position - myRoot.Position).Magnitude

						if distance < closestDistance then
							closestDistance = distance
							closest = character
						end
					end
				end
			end
		end
	end

	return closest
end

-- ============================================================
-- TELEPORT BEHIND
-- ============================================================

local function teleportBehind(target)
	local _, _, myRoot = getCharacter()

	if not myRoot then
		return false
	end

	if not isValidTarget(target) then
		return false
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot then
		return false
	end

	local behindPosition =
		targetRoot.Position -
		targetRoot.CFrame.LookVector *
		CFG.BEHIND_DISTANCE

	behindPosition +=
		Vector3.new(
			0,
			CFG.BEHIND_HEIGHT,
			0
		)

	local destination =
		CFrame.lookAt(
			behindPosition,
			targetRoot.Position
		)

	-- Departure corruption
	burst(
		myRoot.CFrame,
		7,
		GREEN,
		0.18,
		"tp_depart"
	)

	glitchShards(
		myRoot.CFrame,
		7,
		2,
		"tp_depart_glitch"
	)

	-- Actual teleport
	myRoot.CFrame = destination
	myRoot.AssemblyLinearVelocity =
		Vector3.zero

	-- Arrival corruption
	burst(
		destination,
		9,
		BRIGHT_GREEN,
		0.2,
		"tp_arrive"
	)

	ring(
		destination,
		2,
		20,
		GREEN,
		0.3,
		"tp_ring"
	)

	particles(
		myRoot,
		28,
		BRIGHT_GREEN,
		"tp_particles"
	)

	return true
end

-- ============================================================
-- PHANTOM ENGINE
-- ============================================================

local function phantomEngine(
	duration,
	speed,
	token
)
	local character, humanoid, root =
		getCharacter()

	if not character or
		not humanoid or
		not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if token ~= S.Token then
		return false
	end

	local velocity =
		Instance.new("BodyVelocity")

	velocity.Name =
		"TheCreator_PhantomEngine"

	velocity.MaxForce =
		Vector3.new(
			5000000,
			0,
			5000000
		)

	velocity.P = 70000

	velocity.Parent = root

	local a0 =
		Instance.new("Attachment")

	a0.Position =
		Vector3.new(-1.2, 0, 0)

	a0.Parent = root

	local a1 =
		Instance.new("Attachment")

	a1.Position =
		Vector3.new(1.2, 0, 0)

	a1.Parent = root

	local trail =
		Instance.new("Trail")

	trail.Attachment0 = a0
	trail.Attachment1 = a1

	trail.Lifetime = 0.32
	trail.LightEmission = 1

	trail.Color =
		ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				BRIGHT_GREEN
			),

			ColorSequenceKeypoint.new(
				0.45,
				GREEN
			),

			ColorSequenceKeypoint.new(
				1,
				BLACK
			),
		})

	trail.Transparency =
		NumberSequence.new(0.05, 1)

	trail.Parent = root

	burst(
		root.CFrame,
		8,
		GREEN,
		0.2,
		"phantom_start"
	)

	ring(
		root.CFrame,
		2,
		18,
		BRIGHT_GREEN,
		0.25,
		"phantom_ring"
	)

	local started = os.clock()

	while
		os.clock() - started < duration
	do
		if token ~= S.Token then
			break
		end

		if not root.Parent then
			break
		end

		if humanoid.Health <= 0 then
			break
		end

		local direction =
			root.CFrame.LookVector

		velocity.Velocity =
			Vector3.new(
				direction.X * speed,
				0,
				direction.Z * speed
			)

		task.wait()
	end

	pcall(function()
		velocity:Destroy()
	end)

	pcall(function()
		trail:Destroy()
		a0:Destroy()
		a1:Destroy()
	end)

	if root.Parent then
		burst(
			root.CFrame,
			10,
			BRIGHT_GREEN,
			0.22,
			"phantom_end"
		)
	end

	return true
end

-- ============================================================
-- M1
-- ============================================================

local function creatorM1()
	local now = os.clock()

	if now - S.LastM1 < CFG.M1_COOLDOWN then
		return
	end

	S.LastM1 = now

	if S.Busy.M1 then
		return
	end

	local character, humanoid, root =
		getCharacter()

	if not character or
		not humanoid or
		not root then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	S.Busy.M1 = true

	-- IMPORTANT:
	-- Target acquisition happens regardless of whether the
	-- original M1 would have connected.
	local target =
		getClosestTarget(
			CFG.TARGET_RADIUS
		)

	if target then
		teleportBehind(target)

		local targetRoot =
			target:FindFirstChild(
				"HumanoidRootPart"
			)

		if targetRoot then
			-- Make the local character face the target.
			root.CFrame =
				CFrame.lookAt(
					root.Position,
					Vector3.new(
						targetRoot.Position.X,
						root.Position.Y,
						targetRoot.Position.Z
					)
				)

			burst(
				targetRoot.CFrame,
				CFG.M1_FLASH_SIZE,
				BRIGHT_GREEN,
				0.16,
				"m1_target"
			)

			ring(
				targetRoot.CFrame,
				2,
				CFG.M1_RING_SIZE,
				GREEN,
				0.24,
				"m1_ring"
			)

			glitchShards(
				targetRoot.CFrame,
				8,
				2,
				"m1_glitch"
			)

			particles(
				root,
				20,
				TOXIC_GREEN,
				"m1_particles"
			)
		end
	else
		-- No target:
		-- still create a local corrupted M1 effect.
		burst(
			root.CFrame,
			5,
			GREEN,
			0.14,
			"m1_empty"
		)

		particles(
			root,
			10,
			GREEN,
			"m1_empty_particles"
		)
	end

	-- If the supplied animation is available, play it.
	if ANIM.M1 ~= "" then
		playAnimation(
			humanoid,
			ANIM.M1,
			Enum.AnimationPriority.Action4,
			1,
			0.45
		)
	end

	task.delay(0.08, function()
		S.Busy.M1 = nil
	end)
end

-- ============================================================
-- MOVE 1
-- VOID EXECUTION
-- ============================================================

local function move1(token)
	if S.Busy.Move1 then
		return
	end

	local character, humanoid, root =
		getCharacter()

	if not character or
		not humanoid or
		not root then
		return
	end

	S.Busy.Move1 = true

	-- Target first.
	local target =
		getClosestTarget(
			CFG.TARGET_RADIUS
		)

	if target then
		teleportBehind(target)
	end

	if ANIM.MOVE1 ~= "" then
		playAnimation(
			humanoid,
			ANIM.MOVE1,
			Enum.AnimationPriority.Action4,
			1,
			CFG.MOVE1_TIME
		)
	end

	-- Phantom Engine
	task.spawn(function()
		phantomEngine(
			CFG.PHANTOM_TIME,
			CFG.PHANTOM_SPEED,
			token
		)
	end)

	burst(
		root.CFrame,
		14,
		DARK_GREEN,
		0.3,
		"move1_dark"
	)

	burst(
		root.CFrame,
		8,
		BRIGHT_GREEN,
		0.22,
		"move1_core"
	)

	ring(
		root.CFrame,
		3,
		35,
		GREEN,
		0.4,
		"move1_ring"
	)

	glitchShards(
		root.CFrame,
		18,
		5,
		"move1_glitch"
	)

	-- The actual server-side kill is intentionally not faked.
