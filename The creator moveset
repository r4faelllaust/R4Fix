local function setupM1()
	table.insert(
		S.Connections,
		UserInputService.InputBegan:Connect(
			function(input, processed)
				if processed then
					return
				end

				if input.UserInputType ==
					Enum.UserInputType.MouseButton1
				then
					creatorM1()
				end
			end
		)
	)

	-- Mobile / touch equivalent.
	table.insert(
		S.Connections,
		UserInputService.TouchTap:Connect(
			function(_, processed)
				if processed then
					return
				end

				creatorM1()
			end
		)
	)
end

