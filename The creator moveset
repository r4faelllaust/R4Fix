-- ============================================================

local function cleanupCharacter()
	disconnectList(
		S.CharacterConnections
	)

	stopOurAnimations()

	S.Busy = {}

	S.Target = nil

	table.clear(
		S.LastVFX
	)

	local folder =
		workspace:FindFirstChild(
			"DarkGarou_VFX"
		)

	if folder then
		pcall(function()
			folder:Destroy()
		end)
	end
end

-- ============================================================
-- CHARACTER SETUP
-- ============================================================

local function setupCharacter(
	character: Model
)
	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local hrp =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if
		not humanoid
		or not hrp
	then
		return
	end

	applyNight()

	createAura(
		character
	)

	setupHandGlow(
		character
	)

	spawnEffect(
		character,
		hrp
	)

	-- Initial floating idle.
	playAnimation(
		humanoid,
		ANIMS.Idle,
		Enum.AnimationPriority.Idle,
		0.65,
		true
	)

	setupMovementAnimations(
		character,
		humanoid,
		token
	)

	setupMoveHandler(
		character,
		humanoid,
		hrp,
		token
	)

	setupBackgroundMusic()

	task.spawn(function()
		for _ = 1, 25 do
			if token ~= S.Token then
				return
			end

			pcall(function()
				fixCharacterTab()
				refreshMoveBar()
				styleUltimateBar()
			end)

			task.wait(0.15)
		end
	end)

	addCharacterConnection(
		humanoid.Died:Connect(
			function()
				S.Busy = {}
				stopOurAnimations()
			end
		)
	)

	addCharacterConnection(
		Player.PlayerGui.DescendantAdded:Connect(
			function()
				task.defer(function()
					if token ~= S.Token then
						return
					end

					pcall(function()
						fixCharacterTab()
						refreshMoveBar()
						styleUltimateBar()
					end)
				end)
			end
		)
	)

	setupTargetHitEffects()
end

