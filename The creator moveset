-- ============================================================
-- CORRUPTED ULTIMATE BAR
-- ============================================================

local function styleUltimateBar()
	local gui = getGui()

	if not gui then
		return
	end

	local bar = gui:FindFirstChild("Bar")

	if not bar then
		return
	end

	local magicHealth =
		bar:FindFirstChild("MagicHealth")

	if not magicHealth then
		return
	end

	local text =
		magicHealth:FindFirstChild("TextLabel")

	if text and text:IsA("TextLabel") then
		text.Text = "ＴＨＥ  C R E A T O R"
		text.TextColor3 = BRIGHT_GREEN

		-- Do not modify the font.
		text.TextSize = 25
	end

	local health =
		magicHealth:FindFirstChild("Health")

	if not health then
		return
	end

	local holder =
		health:FindFirstChild("Bar")

	if not holder then
		return
	end

	local fill =
		holder:FindFirstChild("Bar")

	if fill then
		if fill:IsA("Frame") then
			fill.BackgroundColor3 = GREEN
			fill.BackgroundTransparency = 0
		elseif
			fill:IsA("ImageLabel") or
			fill:IsA("ImageButton")
		then
			fill.ImageColor3 = GREEN
			fill.ImageTransparency = 0
		end

		local gradient =
			fill:FindFirstChildOfClass(
				"UIGradient"
			)

		if gradient then
			gradient.Color =
				ColorSequence.new({
					ColorSequenceKeypoint.new(
						0,
						BRIGHT_GREEN
					),

					ColorSequenceKeypoint.new(
						0.35,
						GREEN
					),

					ColorSequenceKeypoint.new(
						0.7,
						DARK_GREEN
					),

					ColorSequenceKeypoint.new(
						1,
						BLACK
					),
				})
		end
	end

	-- Green corruption pulse
	local glow =
		health:FindFirstChild("Glow")

	if glow and
		(glow:IsA("ImageLabel") or
			glow:IsA("ImageButton"))
	then
		glow.ImageColor3 = BRIGHT_GREEN
		glow.ImageTransparency = 0.15
	end
end

