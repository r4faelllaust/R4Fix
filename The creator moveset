local function disconnectList(list)
	for i = #list, 1, -1, -1 do
		local connection = list[i]

		pcall(function()
			connection:Disconnect()
		end)

		list[i] = nil
	end
end

local function addCharacterConnection(connection: RBXScriptConnection?)
	if connection then
		table.insert(S.CharacterConnections, connection)
	end

	return connection
end

local function cleanupTracks()
	for i = #S.Tracks, 1, -1 do
		local track = S.Tracks[i]

		pcall(function()
			if track.IsPlaying then
				track:Stop(0.05)
			end
		end)

		pcall(function()
			track:Destroy()
		end)

		S.Tracks[i] = nil
	end
end

local function cleanupCharacter()
	disconnectList(S.CharacterConnections)
	cleanupTracks()

	S.Busy = {}
	table.clear(S.LastFX)

	if idleConnection then
