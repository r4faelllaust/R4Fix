local function createAura(character: Model)
	local old =
		character:FindFirstChild(
			"DarkGarouAura"
		)

	if old then
		old:Destroy()
	end

	local folder =
		Instance.new("Folder")

	folder.Name =
		"DarkGarouAura"

	folder.Parent =
		character

	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"GarouVoidHighlight"

	highlight.FillColor =
		DEEP_PURPLE

	highlight.OutlineColor =
		BRIGHT_BLUE

	highlight.FillTransparency =
		0.88

	highlight.OutlineTransparency =
		0.25

	highlight.DepthMode =
		Enum.HighlightDepthMode.Occluded

	highlight.Parent =
		folder

