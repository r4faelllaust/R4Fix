-- ================================================================

local function allowed(
	key: string,
	cooldown: number
): boolean

	local now = os.clock()

	local previous =
		SESSION.LastVFX[key] or 0

	if now - previous < cooldown then
		return false
	end

	SESSION.LastVFX[key] = now

	return true
end

