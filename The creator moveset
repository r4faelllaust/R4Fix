	end)

	task.delay(1.05, function()
		if track then pcall(function() if track.IsPlaying then track:Stop(0.06) end end) end
		local _, _, currentHRP = getCharacter()
		if currentHRP then
			burst(currentHRP.CFrame, 20, GREEN_BRIGHT, 0.35)
			ring(currentHRP.CFrame, 4, 50, GREEN_BRIGHT, 0.5)
		end
		S.Busy.Move4 = nil
	end)
end

local function creatorUltimate(index)
	local data = ULT_MOVES[index]
	if not data or not data.Trigger then return end -- label-only slot 4 can't fire
	if S.Busy.Ult then return end
	if (S.Ultimate or 0) < CFG.ULT_MAX then return end

	local character, humanoid, hrp = getCharacter()
	if not character or not humanoid or not hrp then return end

	S.Busy.Ult = true
	S.Ultimate = 0
	stopAnimations()

	local track = playAnimation(humanoid, data.Animation, Enum.AnimationPriority.Action4, 1, 1.4)

	if index == 1 then
		burst(hrp.CFrame, 20, BLACK, 0.5, "ult1_black")
		burst(hrp.CFrame, 11, GREEN_BRIGHT, 0.4, "ult1_green")
		ring(hrp.CFrame, 5, 50, GREEN_BRIGHT, 0.65, "ult1_ring")
		particles(hrp, 90, GREEN_BRIGHT, "ult1_particles")
		playSound(hrp, 2, 0.58)
		for i = 1, 14 do
			task.delay(i * 0.03, function()
				local _, _, currentHRP = getCharacter()
				if currentHRP then
					slash(currentHRP.CFrame * CFrame.Angles(math.rad(i * 15), math.rad(i * 31), math.rad(i * 19)),
						16 + i, 0.45, i % 2 == 0 and GREEN_BRIGHT or GREEN)
				end
			end)
		end
	elseif index == 2 then
		burst(hrp.CFrame, 22, BLACK, 0.45, "ult2_black")
		ring(hrp.CFrame, 5, 65, GREEN_DARK, 0.75, "ult2_ring")
		particles(hrp, 110, GREEN_BRIGHT, "ult2_particles")
		playSound(hrp, 2, 0.5)
	elseif index == 3 then
		burst(hrp.CFrame, 28, BLACK, 0.6, "ult3_black")
		burst(hrp.CFrame, 14, GREEN_BRIGHT, 0.45, "ult3_green")
		ring(hrp.CFrame, 7, 75, GREEN_BRIGHT, 0.8, "ult3_ring")
		particles(hrp, 120, GREEN_BRIGHT, "ult3_particles")
		for i = 1, 22 do
			task.delay(i * 0.035, function()
				local _, _, currentHRP = getCharacter()
				if currentHRP then
					slash(currentHRP.CFrame * CFrame.Angles(math.rad(i * 20), math.rad(i * 37), math.rad(i * 13)), 20 + i, 0.5 + i * 0.01, GREEN_BRIGHT)
				end
			end)
		end
		playSound(hrp, 2.3, 0.46)
	end

	task.delay(1.4, function()
		if track then
			pcall(function() if track.IsPlaying then track:Stop(0.08) end end)
			removeTrackFromList(track)
			safeDestroy(track)
		end
		S.Busy.Ult = nil
	end)
end

local function setupMoveHandler(character, humanoid, hrp, token)
	addConnection(S.CharacterConnections, humanoid.AnimationPlayed:Connect(function(track)
		if token ~= S.Token then return end
		if not track.Animation then return end
		local id = track.Animation.AnimationId

		if id == MOVE1_TRIGGER then pcall(function() track:Stop() end); creatorMove1(token); return end
		if id == MOVE2_TRIGGER then pcall(function() track:Stop() end); creatorMove2(token); return end
		if id == MOVE3_TRIGGER then pcall(function() track:Stop() end); creatorMove3(); return end
		if id == MOVE4_TRIGGER then pcall(function() track:Stop() end); creatorMove4(); return end

		if id == SPECIAL_TRIGGER then
			pcall(function() track:Stop() end)
			playAnimation(humanoid, SPECIAL_ANIMATION, Enum.AnimationPriority.Action4, 1, 0.9)
			burst(hrp.CFrame, 10, GREEN_BRIGHT, 0.25)
			particles(hrp, 35, GREEN_BRIGHT)
			return
		end

		for index, data in ipairs(ULT_MOVES) do
			if data.Trigger and id == data.Trigger then
				pcall(function() track:Stop() end)
				creatorUltimate(index)
				return
			end
		end
	end))
end

local function styleExistingUltimateBar()
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return end
	local bar = playerGui:FindFirstChild("Bar", true)
	if not bar then return end
	local magicHealth = bar:FindFirstChild("MagicHealth", true)
	if not magicHealth then return end

	for _, object in ipairs(magicHealth:GetDescendants()) do
		local name = string.lower(object.Name)
		if name == "bar" or name == "fill" or name == "health" then
			if object:IsA("Frame") then
				object.BackgroundColor3 = Color3.fromRGB(3, 12, 6)
			elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
				object.ImageColor3 = GREEN_BRIGHT
			end
			local gradient = object:FindFirstChildOfClass("UIGradient")
			if not gradient and (object:IsA("Frame") or object:IsA("ImageLabel")) then
				gradient = Instance.new("UIGradient")
				gradient.Parent = object
			end
			if gradient then
				gradient.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, BLACK),
					ColorSequenceKeypoint.new(0.5, GREEN_BRIGHT),
					ColorSequenceKeypoint.new(1, GREEN_DARK),
				})
			end
		end
		if object:IsA("TextLabel") then
			local textName = string.lower(object.Name)
			if textName == "textlabel" or textName == "title" then
				object.Text = "T̷H̷E̷  C̷R̷E̷A̷T̷O̷R̷"
				object.TextColor3 = GREEN_BRIGHT
				local stroke = object:FindFirstChildOfClass("UIStroke")
				if not stroke then stroke = Instance.new("UIStroke"); stroke.Parent = object end
				stroke.Color = BLACK
				stroke.Thickness = 1.5
			end
		end
	end
end

local function fixCharacterTab()
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return end
	for _, object in ipairs(playerGui:GetDescendants()) do
		if object:IsA("TextLabel") then
			local text = object.Text
			if text == "Garou" or text == "Hero Hunter" or text == "Dark Garou" or text == "The Creator" then
				object.Text = MOVESET_NAME
				local parent = object.Parent
				if parent then
					for _, imageObject in ipairs(parent:GetDescendants()) do
						if imageObject:IsA("ImageLabel") or imageObject:IsA("ImageButton") then
							local imageName = string.lower(imageObject.Name)
							if string.find(imageName, "image") or string.find(imageName, "icon") then
								imageObject.Image = DECAL_THUMB
							end
						end
					end
				end
			end
		end
	end
end

local function setHotbarSlot(slotNumber, name, reuseText)
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return end
	local hotbar = playerGui:FindFirstChild("Hotbar", true)
	if not hotbar then return end
	local container = hotbar:FindFirstChild("Hotbar", true)
	if not container then return end
	local slot = container:FindFirstChild(tostring(slotNumber), true)
	if not slot then return end
	local toolName = slot:FindFirstChild("ToolName", true)
	if toolName and toolName:IsA("TextLabel") then toolName.Text = name end
	local reuse = slot:FindFirstChild("Reuse", true)
	if reuse and reuse:IsA("TextLabel") then reuse.Text = reuseText; reuse.Visible = true end
end

