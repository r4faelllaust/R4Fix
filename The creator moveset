-- VOID TP
-- ============================================================

local function voidTeleport(
	target: Model?,
	token: number
)
	if token ~= S.Token then
		return false
	end

	local character, humanoid, hrp =
		getCharacter()

	if not character or not humanoid or not hrp then
		return false
	end

	if target and target.Parent then
		local targetHRP =
			target:FindFirstChild(
				"HumanoidRootPart"
			)

		if targetHRP and targetHRP:IsA("BasePart") then

			local destination =
				targetHRP.Position
				- targetHRP.CFrame.LookVector
				* 3.2

			destination =
				Vector3.new(
					destination.X,
					targetHRP.Position.Y,
					destination.Z
				)

			burst(
				hrp.CFrame,
				8,
				DARK_BLACK,
				0.22,
				"void_depart"
			)

			particles(
				hrp,
				18,
				BRIGHT_PURPLE,
				"void_depart_particles"
			)

			hrp.CFrame =
				CFrame.lookAt(
					destination,
					targetHRP.Position
				)

			hrp.AssemblyLinearVelocity =
				Vector3.zero

			burst(
				hrp.CFrame,
				11,
				BRIGHT_PURPLE,
				0.25,
				"void_arrive"
			)

			ring(
				hrp.CFrame,
				2,
				20,
				BRIGHT_BLUE,
				0.3,
				"void_arrive_ring"
			)

			return true
		end
	end

	return false
end

