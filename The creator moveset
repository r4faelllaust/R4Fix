local function allowed(key: string, cooldown: number?)
	local now = os.clock()
	local previous = S.LastVFX[key] or 0

	local cd = cooldown or CFG.VFX_COOLDOWN

	if now - previous < cd then
		return false
	end

	S.LastVFX[key] = now

	return true
end

