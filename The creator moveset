-- ================================================================

local idleConnection: RBXScriptConnection? = nil

local function startCreatorIdle(root: BasePart, humanoid: Humanoid)
	if idleConnection then
		pcall(function()
			idleConnection:Disconnect()
		end)

		idleConnection = nil
	end

	local baseY = root.Position.Y
	local started = os.clock()

	idleConnection = RunService.RenderStepped:Connect(function()

		if not root.Parent
			or humanoid.Health <= 0
			or humanoid.MoveDirection.Magnitude > 0.05
		then
			return
		end

		local t = os.clock() - started

		local offset =
			math.sin(t * 2.4)
			* 0.045

		root.CFrame =
			root.CFrame
			+ Vector3.new(0, offset, 0)
	end)

	addCharacterConnection(idleConnection)
end

