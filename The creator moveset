			ULT_GREEN_BRIGHT

		-- Deliberately do not change Font.
	end

	local health =
		magic:FindFirstChild(
			"Health"
		)

	if not health then
		return
	end

	local barHolder =
		health:FindFirstChild(
			"Bar"
		)

	if not barHolder then
		return
	end

