local function createTeleportTool()
	local name = "Creator Void TP"

	destroyTool(name)

	local backpack =
		LocalPlayer:WaitForChild("Backpack")

	local tool =
		Instance.new("Tool")

	tool.Name = name
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "VOID TELEPORT"

	tool.Parent = backpack

	tool.Activated:Connect(function()

		local character, humanoid, root =
			getCharacter()

		if not character
			or not humanoid
			or not root
		then
			return
		end

		local mouse =
			LocalPlayer:GetMouse()

		if not mouse or not mouse.Hit then
			return
		end

		local old =
			root.CFrame

		creatorBurst(root, 5, 0.13)

		cloneResource(
			3,
			root,
			6,
			0.25
		)

		task.wait(0.035)

		local destination =
			mouse.Hit.Position

		root.CFrame =
			CFrame.lookAt(
				destination + Vector3.new(0, 2.5, 0),
				destination
			)

		root.AssemblyLinearVelocity =
			Vector3.zero

		creatorBurst(root, 6, 0.16)

		cloneResource(
			3,
			root,
			7,
			0.28
		)

		glitchBurst()
	end)
end

