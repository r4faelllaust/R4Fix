local function disconnectList(list: {RBXScriptConnection})
	for i = #list, 1, -1 do
		local connection = list[i]

		pcall(function()
			connection:Disconnect()
		end)

		table.remove(list, i)
	end
end

local function addConnection(
	list: {RBXScriptConnection},
	connection: RBXScriptConnection?
)
	if connection then
		table.insert(list, connection)
	end

	return connection
end

local function safeDestroy(object: Instance?)
	if object then
		pcall(function()
			object:Destroy()
		end)
	end
end

