end

local function getAnimator(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

-- ============================================================
-- ANIMATION MANAGEMENT
-- ============================================================

local function removeTrackFromList(track: AnimationTrack)
	for i = #S.AnimationTracks, 1, -1 do
		if S.AnimationTracks[i] == track then
			table.remove(S.AnimationTracks, i)
			break
		end
	end
end

local function stopAnimations()
	for i = #S.AnimationTracks, 1, -1 do
		local track = S.AnimationTracks[i]

		pcall(function()
			if track.IsPlaying then
				track:Stop(0.06)
			end

			track:Destroy()
		end)

		table.remove(S.AnimationTracks, i)
	end
end

local function playAnimation(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority?,
	speed: number?,
	duration: number?
)
	if humanoid.Health <= 0 then
		return nil
	end

	local animator = getAnimator(humanoid)

	local animation = Instance.new("Animation")
	animation.AnimationId = id

	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	safeDestroy(animation)

	if not ok or not track then
		return nil
	end

	track.Priority = priority or Enum.AnimationPriority.Action4
	track.Looped = false

	table.insert(S.AnimationTracks, track)

	local played = pcall(function()
		track:Play(0.035, 1, speed or 1)
	end)

	if not played then
		removeTrackFromList(track)
		safeDestroy(track)
		return nil
	end

	if duration then
		task.delay(duration, function()
			pcall(function()
				if track.IsPlaying then
					track:Stop(0.07)
				end

				track:Destroy()
			end)

			removeTrackFromList(track)
		end)
	end

	return track
end

