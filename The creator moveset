local function playSound(parent: Instance?, volume: number?, speed: number?)
	if not parent or not parent.Parent then
		return
	end

	local now = os.clock()

	if now - S.LastSound < CFG.SOUND_COOLDOWN then
		return
	end

	S.LastSound = now

	local sound = Instance.new("Sound")
	sound.Name = "DarkGarouImpact"
	sound.SoundId = SOUND_IDS[math.random(1, #SOUND_IDS)]
	sound.Volume = volume or 1
	sound.PlaybackSpeed = speed or 1
	sound.RollOffMaxDistance = 120
	sound.Parent = parent

	pcall(function()
		sound:Play()
	end)

	Debris:AddItem(sound, 4)
end

