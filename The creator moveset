-- ================================================================
-- ANIMATION TRIGGER HANDLER
-- ================================================================

local TRIGGERS = {
	["12273188754"] = 1,
	["12296113986"] = 2,
	["12309835105"] = 3,
	["12351854556"] = 4,

	["12460977270"] = 3,
}

local ULT_TRIGGERS = {
	["12467789963"] = 1,
	["14057231976"] = 2,
}

local function animationIdNumber(
	track: AnimationTrack
)
	if not track.Animation then
		return nil
	end

	local id =
		track.Animation.AnimationId

	return id:match("%d+")
end

local function setupMoveHandler(
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	token: number
)
	addCharacterConnection(
		humanoid.AnimationPlayed:Connect(
			function(track)

				if token ~= S.Token then
					return
				end

				local id =
					animationIdNumber(
						track
					)

				if not id then
					return
				end

				local move =
					TRIGGERS[id]

				if move then

					pcall(function()
						track:Stop()
					end)

					if move == 1 then

						task.spawn(
							move1,
							token
						)

					elseif move == 2 then

						task.spawn(
							move2,
							token
						)

					elseif move == 3 then

						move3()

					elseif move == 4 then

						move4()
					end

					return
				end

				local ult =
					ULT_TRIGGERS[id]

				if ult then

					pcall(function()
						track:Stop()
					end)

					playUltimate(
						ult
					)

					return
				end
			end
		)
	)
end

-- ================================================================
-- M1 INPUT
-- ================================================================
--
-- FIX:
-- The previous:
--
--     if processed then return end
--
-- could kill M1 because TSB itself can mark mouse input
-- as processed.
--
-- We ONLY care about MouseButton1 here, so processed input
-- is deliberately accepted.
-- ================================================================

local m1Connection:
	RBXScriptConnection? = nil

local function setupM1()

	if m1Connection then

		pcall(function()
			m1Connection:Disconnect()
		end)

		m1Connection =
			nil
	end

	m1Connection =
		UserInputService.InputBegan:Connect(
			function(input, _processed)

				if input.UserInputType
					== Enum.UserInputType.MouseButton1
				then

					creatorM1()
				end
			end
		)

	table.insert(
		S.Connections,
		m1Connection
	)
end

-- ================================================================
-- GLOBAL GLITCH LOOP
-- ================================================================

local function startGlitchLoop()

	task.spawn(function()

		while LocalPlayer.Parent do

			pcall(function()

				fixCreatorSelection()

				styleUltimateBar()

				for i = 1, 4 do
					styleMoveSlot(i)
				end

				-- ONLY TSB UI corruption.
				--
				-- No screen GUI.
				-- No bottom bar.
				-- No fake overlay.

				if math.random()
					< 0.32
				then

					glitchHotbar()
				end

				if math.random()
					< 0.42
				then

					glitchUltimateBar()
				end
			end)

			task.wait(
				math.random(
					14,
					31
				) / 100
			)
		end
	end)
end

-- ================================================================
-- CHARACTER SETUP
-- ================================================================

local function setupCharacter(
	character: Model
)

	-- Invalidate everything belonging to the previous character.
	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not root
	then
		return
	end

	creatorSpawn(
		character,
		root
	)

	creatorAura(
		character
	)

	startCreatorIdle(
		root,
		humanoid
	)

	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)

	-- UI rebuild protection.
	task.spawn(function()

		for _ = 1, 30 do

			if token ~= S.Token then
				return
			end

			pcall(function()

				fixCreatorSelection()

				styleUltimateBar()

				for i = 1, 4 do
					styleMoveSlot(i)
				end
			end)

			task.wait(
				0.12
			)
		end
	end)

	task.delay(
		0.4,
		function()

			if token ~= S.Token then
				return
			end

			setupTools()
		end
	)

	addCharacterConnection(
		humanoid.Died:Connect(
			function()

				S.Busy = {}

				cleanupTracks()

				creatorHeadText(
					"CREATOR CONNECTION LOST"
				)
			end
		)
	)

	addCharacterConnection(
		character.AncestryChanged:Connect(
			function(_, parent)

				if not parent then
					S.Token += 1
				end
			end
		)
	)
end

-- ================================================================
-- START
-- ================================================================

if not S.Started then

	S.Started =
		true

	disconnectList(
		S.Connections
	)

	setupM1()

	table.insert(
		S.Connections,

		LocalPlayer.CharacterAdded:Connect(
			function(character)

				task.spawn(function()

					character:WaitForChild(
						"Humanoid",
						10
					)

					character:WaitForChild(
						"HumanoidRootPart",
						10
					)

					task.wait(
						0.18
					)

					setupCharacter(
						character
					)
				end)
			end
		)
	)

	startGlitchLoop()
end

-- ================================================================
-- CURRENT CHARACTER
-- ================================================================

local current =
	LocalPlayer.Character

if current then

	task.spawn(function()
		setupCharacter(
			current
		)
	end)

else

	task.spawn(function()

		local character =
			LocalPlayer.CharacterAdded:Wait()

		setupCharacter(
			character
		)
	end)
end

