-- ================================================================
-- RECOLOR
-- ================================================================

local function recolorObject(
	object: Instance
)
	for _, descendant in ipairs(
		object:GetDescendants()
	) do

		if descendant:IsA(
			"ParticleEmitter"
		) then

			local keypoints =
				descendant.Color.Keypoints

			if #keypoints > 0 then

				local rebuilt = {}

				for i, keypoint in ipairs(
					keypoints
				) do

					local alpha =
						(i - 1)
						/ math.max(
							#keypoints - 1,
							1
						)

					table.insert(
						rebuilt,
						ColorSequenceKeypoint.new(
							keypoint.Time,
							CREATOR_GREEN:Lerp(
								CREATOR_LIME,
								alpha
							)
						)
					)
				end

				descendant.Color =
					ColorSequence.new(
						rebuilt
					)

			else
				descendant.Color =
					ColorSequence.new(
						CREATOR_GREEN
					)
			end

			descendant.LightEmission =
				math.max(
					descendant.LightEmission,
					0.35
				)

		elseif descendant:IsA("Beam") then

			descendant.Color =
				ColorSequence.new(
					CREATOR_GREEN,
					CREATOR_LIME
				)

		elseif descendant:IsA("Trail") then

			descendant.Color =
				ColorSequence.new(
					CREATOR_GREEN,
					CREATOR_LIME
				)

		elseif descendant:IsA("PointLight")
			or descendant:IsA("SpotLight")
			or descendant:IsA("SurfaceLight")
		then

			descendant.Color =
				CREATOR_GREEN
		end
	end
end

-- ================================================================
-- CLONE RESOURCE
-- ================================================================

local function cloneResource(
	index: number,
	parent: Instance,
	amount: number?,
	lifetime: number?
): Instance?
	local template =
		getResource(index)

	if not template
		or not parent
		or not parent.Parent
	then
		return nil
	end

	local success, clone =
		pcall(function()
			return template:Clone()
		end)

	if not success
		or not clone
	then
		return nil
	end

	recolorObject(
		clone
	)

	clone.Parent =
		parent

	for _, child in ipairs(
		clone:GetDescendants()
	) do

		if child:IsA(
			"ParticleEmitter"
		) then

			child.Enabled =
				false

			pcall(function()
				child:Emit(
					amount or 8
				)
			end)
		end
	end

	Debris:AddItem(
		clone,
		lifetime
		or CFG.MaxVFXLifetime
	)

	return clone
end

