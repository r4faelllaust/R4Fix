local function loadCreatorSong(): string?
	local writeFile: any = nil
	local getCustomAsset: any = nil

	pcall(function()
		writeFile = writefile
	end)

	pcall(function()
		getCustomAsset = getcustomasset
	end)

	if not writeFile or not getCustomAsset then
		return nil
	end

	local fileName =
		"R4Fix_Creator_Soviet_Anthem.mp3"

	local downloaded = pcall(function()
		writeFile(
			fileName,
			game:HttpGet(SONG_URL)
		)
	end)

	if not downloaded then
		return nil
	end

	local asset: any = nil

	pcall(function()
		asset = getCustomAsset(fileName)
	end)

	if typeof(asset) ~= "string" then
		return nil
	end

	return asset
end

local function startCreatorSong(character: Model)
