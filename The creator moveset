local function creatorUltimate(index: number)
	local data = ULT_MOVES[index]

	if not data then
		return
	end

	if S.Busy.Ult then
		return
	end

	if (S.Ultimate or 0) < CFG.ULT_MAX then
		return
	end

	local character, humanoid, hrp = getCharacter()

	if not character or not humanoid or not hrp then
		return
	end

	S.Busy.Ult = true
	S.Ultimate = 0
	updateUltimateUI()

	-- Stop normal animation clutter.
	stopAnimations()

	local track = playAnimation(
		humanoid,
		data.Animation,
		Enum.AnimationPriority.Action4,
		1,
		1.25
	)

	-- ========================================================
	-- ULT 1
	-- CREATOR'S DECREE
	-- ========================================================

	if index == 1 then
		burst(hrp.CFrame, 20, BLACK, 0.5, "ult1_black")
		burst(hrp.CFrame, 11, GREEN_BRIGHT, 0.4, "ult1_green")
		ring(hrp.CFrame, 5, 50, GREEN_BRIGHT, 0.65, "ult1_ring")
		particles(hrp, 90, GREEN_BRIGHT, "ult1_particles")

		local target = getClosestPlayer(500)

		if target then
			task.delay(0.25, function()
				teleportBehindPlayer(target)

				local _, _, currentHRP = getCharacter()

				if currentHRP then
					burst(currentHRP.CFrame, 22, GREEN_BRIGHT, 0.4)
					ring(currentHRP.CFrame, 6, 55, GREEN_BRIGHT, 0.6)

					for i = 1, 12 do
						slash(
							currentHRP.CFrame
								* CFrame.Angles(
									math.rad(i * 15),
									math.rad(i * 31),
									math.rad(i * 19)
								),
							16 + i,
							0.5,
							GREEN_BRIGHT
						)
					end
				end
			end)
		end

		playSound(hrp, 2, 0.58)
	end

	-- ========================================================
	-- ULT 2
	-- NULL WORLD
	-- ========================================================

	if index == 2 then
		local oldCF = hrp.CFrame

		burst(oldCF, 22, BLACK, 0.45, "ult2_black")
		ring(oldCF, 5, 65, GREEN_DARK, 0.75, "ult2_ring")

		local target = getClosestPlayer(600)

		if target and target.Character then
			local targetHRP =
				target.Character:FindFirstChild("HumanoidRootPart")

			if targetHRP and targetHRP:IsA("BasePart") then
				local targetPosition =
					targetHRP.Position
					- targetHRP.CFrame.LookVector * 4

				hrp.CFrame =
					CFrame.lookAt(
						targetPosition,
						targetHRP.Position
					)

				burst(hrp.CFrame, 15, GREEN_BRIGHT, 0.35)
				particles(hrp, 75, GREEN_BRIGHT)
			end
		end

		playSound(hrp, 2, 0.5)
	end

	-- ========================================================
	-- ULT 3
	-- ABSOLUTE OVERRIDE
	-- ========================================================

	if index == 3 then
		burst(hrp.CFrame, 28, BLACK, 0.6, "ult3_black")
		burst(hrp.CFrame, 14, GREEN_BRIGHT, 0.45, "ult3_green")
		ring(hrp.CFrame, 7, 75, GREEN_BRIGHT, 0.8, "ult3_ring")
		particles(hrp, 120, GREEN_BRIGHT, "ult3_particles")

		for i = 1, 18 do
			task.delay(i * 0.035, function()
				local _, _, currentHRP = getCharacter()

				if currentHRP then
					slash(
						currentHRP.CFrame
							* CFrame.Angles(
								math.rad(i * 20),
								math.rad(i * 37),
								math.rad(i * 13)
							),
						20 + i,
						0.6,
						GREEN_BRIGHT
					)
				end
			end)
		end

		playSound(hrp, 2.3, 0.46)
	end

	-- ========================================================
	-- ULT 4
	-- THE END OF EVERYTHING
	-- ========================================================

	if index == 4 then
		local oldCF = hrp.CFrame

		-- Huge black-green collapse.
		burst(oldCF, 35, BLACK, 0.8, "ult4_black")
		burst(oldCF, 18, GREEN_BRIGHT, 0.65, "ult4_green")
		ring(oldCF, 8, 100, GREEN_BRIGHT, 1, "ult4_ring")
		ring(oldCF, 12, 140, GREEN_DARK, 1.15, "ult4_ring2")
		particles(hrp, 180, GREEN_BRIGHT, "ult4_particles")

		local target = getClosestPlayer(1000)

		if target then
			task.delay(0.3, function()
				teleportBehindPlayer(target)

				local _, _, currentHRP = getCharacter()

				if currentHRP then
					local targetPosition = currentHRP.Position

					for i = 1, 24 do
						task.delay(i * 0.025, function()
							if not currentHRP.Parent then
								return
							end

							local angle =
								math.rad(i * 15)

							local offset =
								Vector3.new(
									math.cos(angle) * (5 + i * 0.4),
									math.sin(angle) * 3,
									math.sin(angle) * (5 + i * 0.4)
								)

							local effectCF =
								CFrame.lookAt(
									targetPosition + offset,
									targetPosition
								)

							slash(
								effectCF,
								12 + i,
								0.55,
								GREEN_BRIGHT
							)
						end)
					end
				end
			end)
		end

		task.delay(0.75, function()
			local _, _, currentHRP = getCharacter()

			if currentHRP then
				burst(
					currentHRP.CFrame,
					35,
					GREEN_BRIGHT,
					0.8
				)

				ring(
					currentHRP.CFrame,
					10,
					150,
					GREEN_BRIGHT,
					1
				)
			end
		end)

		playSound(hrp, 3, 0.4)
	end

	task.delay(1.25, function()
		if track then
			pcall(function()
				track:Stop(0.08)
			end)
		end

		S.Busy.Ult = nil
		updateUltimateUI()
	end)
end

-- ============================================================
-- MOVE TRIGGER HANDLER
-- ============================================================

local function setupMoveHandler(
	character: Model,
	humanoid: Humanoid,
	hrp: BasePart,
	token: number
)
	addCharacterConnection(
		humanoid.AnimationPlayed:Connect(function(track)
			if token ~= S.Token then
				return
			end

			if not track.Animation then
				return
			end

			local id = track.Animation.AnimationId

			if id == MOVE1_TRIGGER then
				pcall(function()
					track:Stop()
				end)

				creatorMove1(token)
				return
			end

			if id == MOVE2_TRIGGER then
				pcall(function()
					track:Stop()
				end)

				creatorMove2(token)
				return
			end

			if id == MOVE3_TRIGGER then
				pcall(function()
					track:Stop()
				end)

				creatorMove3()
				return
			end

			if id == MOVE4_TRIGGER then
				pcall(function()
					track:Stop()
				end)

				creatorMove4()
				return
			end

			if id == SPECIAL_TRIGGER then
				pcall(function()
					track:Stop()
				end)

				playAnimation(
					humanoid,
					SPECIAL_ANIMATION,
					Enum.AnimationPriority.Action4,
					1,
					0.9
				)

				return
			end

			for index, data in ipairs(ULT_MOVES) do
				if id == data.Trigger then
					pcall(function()
						track:Stop()
					end)

					creatorUltimate(index)
					return
				end
			end
		end)
	)
end

-- ============================================================
-- SPAWN VFX
-- ============================================================

local function spawnEffect(character: Model, hrp: BasePart)
	burst(hrp.CFrame, 11, BLACK, 0.35, "spawn_black")
	burst(hrp.CFrame, 8, GREEN_BRIGHT, 0.3, "spawn_green")
	ring(hrp.CFrame, 2, 25, GREEN_BRIGHT, 0.45, "spawn_ring")
	particles(hrp, 50, GREEN_BRIGHT, "spawn_particles")

	local highlight = Instance.new("Highlight")
	highlight.Name = "CreatorSpawnHighlight"
	highlight.FillColor = GREEN_DARK
	highlight.OutlineColor = GREEN_BRIGHT
	highlight.FillTransparency = 0.75
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = character

	TweenService:Create(
		highlight,
		TweenInfo.new(0.8, Enum.EasingStyle.Quint),
		{
			FillTransparency = 1,
			OutlineTransparency = 1,
		}
	):Play()

	Debris:AddItem(highlight, 0.9)
end

-- ============================================================
-- HAND GLOW
-- ============================================================

local function setupHandGlow(character: Model)
	local limbNames = {
		"Left Arm",
		"Right Arm",
		"LeftHand",
		"RightHand",
		"LeftLowerArm",
		"RightLowerArm",
	}

	for _, limbName in ipairs(limbNames) do
		local limb = character:FindFirstChild(limbName)

		if limb and limb:IsA("BasePart") then
			local old = limb:FindFirstChild("CreatorHandGlow")

			if old then
				old:Destroy()
			end

			local attachment = Instance.new("Attachment")
			attachment.Name = "CreatorHandGlow"
			attachment.Parent = limb

			local emitter = Instance.new("ParticleEmitter")
			emitter.Color = ColorSequence.new(
				GREEN_WHITE,
				GREEN_BRIGHT
			)
			emitter.LightEmission = 1
			emitter.Rate = 2
			emitter.Lifetime = NumberRange.new(0.2, 0.45)
			emitter.Speed = NumberRange.new(0.2, 1)
			emitter.SpreadAngle = Vector2.new(180, 180)

			emitter.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.35),
				NumberSequenceKeypoint.new(1, 0),
			})

			emitter.Parent = attachment
		end
	end
end

-- ============================================================
-- CHARACTER CLEANUP
-- ============================================================

local function cleanupCharacter()
	disconnectList(S.CharacterConnections)
	stopAnimations()

	S.Busy = {}
	S.Flying = false

	table.clear(S.LastVFX)

	local vfx = workspace:FindFirstChild("TheCreator_VFX")

	if vfx then
		pcall(function()
			vfx:Destroy()
		end)
	end
end

-- ============================================================
-- CHARACTER SETUP
-- ============================================================

local function setupCharacter(character: Model)
	S.Token += 1

	local token = S.Token

	cleanupCharacter()

	S.Ultimate = 0

	local humanoid = character:WaitForChild(
		"Humanoid",
		10
	) :: Humanoid?

	local hrp = character:WaitForChild(
		"HumanoidRootPart",
		10
	) :: BasePart?

	if not humanoid or not hrp then
		return
	end

	spawnEffect(character, hrp)
	setupHandGlow(character)

	setupMoveHandler(
		character,
		humanoid,
		hrp,
		token
	)

	createCreatorUltimateUI()
	updateUltimateUI()

	task.spawn(function()
		for _ = 1, 20 do
			if token ~= S.Token then
				return
			end

			fixCharacterTab()
			refreshMoveBar()
			styleExistingUltimateBar()
			updateUltimateUI()

			task.wait(0.15)
		end
	end)

	task.delay(0.5, function()
		if token == S.Token then
			createFlyTool()
			createRunTool()
			createTeleportTool()
		end
	end)

	addCharacterConnection(
		humanoid.Died:Connect(function()
			S.Busy = {}
			S.Flying = false
			stopAnimations()
		end)
	)
end

