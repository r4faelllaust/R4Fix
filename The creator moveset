local function getAssetFunction()
	local custom = getcustomasset

	if custom then
		return custom
	end

	local synAsset = getsynasset

	if synAsset then
		return synAsset
	end

	return nil
end

local function downloadMusic()
	local assetFunction = getAssetFunction()

	if not assetFunction then
		return nil
	end

	local fileName =
		"R4Fix_TheCreator_Soviet_Anthem.mp3"

	local body

	local requestFunction =
		request
		or http_request
		or (syn and syn.request)

	if requestFunction then
		local ok, response = pcall(function()
			return requestFunction({
				Url = MUSIC_URL,
				Method = "GET",
			})
		end)

		if ok and response then
			if response.StatusCode == 200 then
				body = response.Body
			end
		end
	end

	if not body then
		local ok, result = pcall(function()
			return game:HttpGet(MUSIC_URL)
		end)

		if ok then
			body = result
		end
	end

	if not body then
		return nil
	end

	local wrote = pcall(function()
		writefile(fileName, body)
	end)

	if not wrote then
		return nil
	end

	local ok, asset = pcall(function()
		return assetFunction(fileName)
	end)

	if not ok then
		return nil
	end

	return asset
end

local function startMusic()
	if S.Music and S.Music.Parent then
		S.Music:Stop()
		S.Music:Destroy()
	end

	local asset = downloadMusic()

	if not asset then
		return
	end

	local sound = Instance.new("Sound")
	sound.Name = "THE_CREATOR_BACKGROUND"
	sound.SoundId = asset
	sound.Volume = CFG.MusicVolume
	sound.Looped = true
	sound.PlaybackSpeed = 1
	sound.Parent = game:GetService("SoundService")

	S.Music = sound

	pcall(function()
		sound:Play()
	end)
end

