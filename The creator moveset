-- ============================================================
-- CHARACTER SETUP
-- ============================================================

local function setupCharacter(character)
	S.Token += 1

	local token = S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid or not root then
		warn(
			"[THE CREATOR] Character setup failed."
		)

		return
	end

	if CFG.USE_NIGHT_LIGHTING then
		pcall(function()
			Lighting.ClockTime =
				CFG.NIGHT_TIME
		end)
	end

	setupAura(character)

	spawnEffect(
		character,
		root
	)

	addCharacterConnection(
		humanoid.Died:Connect(
			function()
				S.Busy = {}
				cleanupTracks()
			end
		)
	)

	print(
		"[THE CREATOR] Character loaded."
	)
end

-- ============================================================
-- INPUT
-- ============================================================

local function bindInput()
	-- MOUSE / KEYBOARD
	addConnection(
		UIS.InputBegan:Connect(
			function(input, processed)
				if processed then
					return
				end

				if not S.Alive then
					return
				end

				if input.UserInputType ==
					Enum.UserInputType.MouseButton1
				then
					creatorM1()

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.One
				then
					move1()

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.Two
				then
					move2()

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.Three
				then
					move3()

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.Four
				then
					move4()

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.G
				then
					ultimate()

					return
				end
			end
		)
	)

	-- TOUCH / MOBILE M1
	addConnection(
		UIS.TouchTap:Connect(
			function(_, processed)
				if processed then
					return
				end

				if not S.Alive then
					return
				end

				creatorM1()
			end
		)
	)
end

