-- ============================================================
-- PHANTOM ENGINE
-- ============================================================

local function phantomEngine(
	duration,
	speed,
	token
)
	local character, humanoid, hrp =
		getCharacter()

	if not character
		or not humanoid
		or not hrp
	then
		return false
	end

	if humanoid.Health <= 0
		or token ~= S.Token
	then
		return false
	end

	local velocity =
		Instance.new("BodyVelocity")

	velocity.Name =
		"Creator_PhantomEngine"

	velocity.MaxForce =
		Vector3.new(
			5000000,
			0,
			5000000
		)

	velocity.P = 70000
	velocity.Parent = hrp

	local a0 =
		Instance.new("Attachment")

	a0.Position =
		Vector3.new(
			-1.15,
			0,
			0
		)

	a0.Parent = hrp

	local a1 =
		Instance.new("Attachment")

	a1.Position =
		Vector3.new(
			1.15,
			0,
			0
		)

	a1.Parent = hrp

	local trail =
		Instance.new("Trail")

	trail.Attachment0 = a0
	trail.Attachment1 = a1

	trail.Lifetime = 0.3
	trail.LightEmission = 1

	trail.Color =
		ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				CREATOR_GREEN
			),

			ColorSequenceKeypoint.new(
				0.55,
				GLITCH_GREEN
			),

			ColorSequenceKeypoint.new(
				1,
				GLITCH_PURPLE
			),
		})

	trail.Transparency =
		NumberSequence.new(
			0.05,
			1
		)

	trail.Parent = hrp

	local started = os.clock()

	burst(
		hrp.CFrame,
		8,
		CREATOR_GREEN,
		0.22,
		"phantom_start"
	)

	randomResourceVFX(
		hrp,
		18
	)

	while
		os.clock() - started < duration
	do

		if token ~= S.Token
			or not hrp.Parent
			or humanoid.Health <= 0
		then
			break
		end

		local look =
			hrp.CFrame.LookVector

		velocity.Velocity =
			Vector3.new(
				look.X * speed,
				0,
				look.Z * speed
			)

		if math.random() < 0.18 then
			glitchShards(
				hrp.CFrame,
				3
			)
		end

		RunService.Heartbeat:Wait()
	end

	pcall(function()
		velocity:Destroy()
		a0:Destroy()
		a1:Destroy()
		trail:Destroy()
	end)

	if hrp.Parent then
		burst(
			hrp.CFrame,
			10,
			CREATOR_GREEN,
			0.25,
			"phantom_end"
		)

		randomResourceVFX(
			hrp,
			18
		)
	end

	return true
end

