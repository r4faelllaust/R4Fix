-- ============================================================
-- HIT DETECTION
-- ============================================================

local hitConnections = {}
local lastHealth = {}

local function setupTargetHitFX(target)
	if not target
		or not target:IsA("Model")
	then
		return
	end

	local humanoid =
		target:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid then
		return
	end

	if hitConnections[target] then
		return
	end

	lastHealth[target] =
		humanoid.Health

	hitConnections[target] =
		humanoid.HealthChanged:Connect(
			function(newHealth)

				local oldHealth =
					lastHealth[target]
					or humanoid.MaxHealth

				if newHealth < oldHealth then

					if target:GetAttribute(
						"LastHit"
					) == Player.Name
					then
						createM1HitFX(
							target
						)
					end
				end

				lastHealth[target] =
					newHealth
			end
		)
end

local function setupHitFX()
	local live =
		workspace:FindFirstChild(
			"Live"
		)

	if not live then
		return
	end

	for _, object in ipairs(
		live:GetChildren()
	) do
		setupTargetHitFX(
			object
		)
	end

	table.insert(
		S.Connections,
		live.ChildAdded:Connect(
			function(object)
				task.defer(
					function()
						setupTargetHitFX(
							object
						)
					end
				)
			end
		)
	)
end

