	sound.Parent = root

	pcall(function()
		sound:Play()
	end)
end

-- ================================================================
-- PHANTOM ENGINE
-- ================================================================

local function phantomEngine(
	duration: number,
	speed: number,
	token: number
)
	local character, humanoid, root = getCharacter()

	if not character or not humanoid or not root then
		return false
	end

	if token ~= S.Token then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = "CreatorPhantomAttachment"
	attachment.Parent = root

	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "CreatorPhantomEngine"
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VectorVelocity =
		root.CFrame.LookVector * speed
	velocity.Parent = root

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-1.05, 0, 0)
	a0.Parent = root

	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(1.05, 0, 0)
	a1.Parent = root

	local trail = Instance.new("Trail")
	trail.Name = "CreatorPhantomTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.16
	trail.MinLength = 0.05
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(
		CREATOR_LIME,
		CREATOR_GREEN
	)
	trail.Transparency = NumberSequence.new(
		0.05,
		1
	)
	trail.Parent = root

	creatorBurst(root, 4.5, 0.11)
	cloneResource(3, root, 6, 0.22)

	local started = os.clock()

	while os.clock() - started < duration do
		if token ~= S.Token then
			break
		end

		if not root.Parent then
			break
		end

		if humanoid.Health <= 0 then
			break
		end

		local direction = root.CFrame.LookVector

		velocity.VectorVelocity = Vector3.new(
			direction.X * speed,
			0,
			direction.Z * speed
		)

		RunService.Heartbeat:Wait()
	end

	pcall(function()
		velocity:Destroy()
	end)

	pcall(function()
		attachment:Destroy()
	end)

	pcall(function()
		a0:Destroy()
	end)

	pcall(function()
		a1:Destroy()
	end)

	pcall(function()
		trail:Destroy()
	end)

	if root.Parent then
		creatorBurst(root, 5.5, 0.14)
	end

	return true
end

-- ================================================================
-- VOID EXECUTION
-- ================================================================

local function voidSequence(
	target: Model,
	token: number,
	strong: boolean?
)
	local character, humanoid, root = getCharacter()

	if not character or not humanoid or not root then
		return
	end

	if token ~= S.Token then
		return
	end

	local targetRoot =
		target:FindFirstChild("HumanoidRootPart")

	if not targetRoot or not targetRoot:IsA("BasePart") then
		return
	end

	local original = root.CFrame

	-- FIRST: get behind target
	if not teleportBehindTarget(target) then
		return
	end

	creatorBurst(root, strong and 8 or 6, 0.12)
	creatorRing(root, 2, strong and 15 or 11, 0.2)

	cloneResource(3, root, strong and 10 or 7, 0.3)
	cloneResource(6, root, 6, 0.28)

	playImpactSound(root, 1.2, 0.78)

	task.wait(0.055)

	if token ~= S.Token then
		return
	end

	-- SECOND phase, cross through target
	local phasePosition =
		targetRoot.Position
		- targetRoot.CFrame.LookVector * 2.4

	root.CFrame = CFrame.lookAt(
		phasePosition,
		targetRoot.Position
	)

	creatorSlash(
		root,
		strong and 11 or 8,
		strong and 0.2 or 0.14
	)

	creatorShockwave(root)

	cloneResource(5, root, 9, 0.3)
	cloneResource(10, root, 8, 0.28)

	task.wait(0.07)

	if token ~= S.Token then
		return
	end

	-- THIRD phase, void displacement
	local forward =
		targetRoot.CFrame.LookVector

	local distance =
		strong
		and CFG.VoidDistance * 1.15
		or CFG.VoidDistance

	local destination =
		targetRoot.Position
		+ forward * distance

	destination = Vector3.new(
		destination.X,
		targetRoot.Position.Y,
		destination.Z
	)

	root.CFrame = CFrame.lookAt(
		destination,
		destination + forward
	)

	root.AssemblyLinearVelocity = Vector3.zero

	creatorBurst(root, strong and 15 or 11, 0.25)
	creatorRing(root, 4, strong and 42 or 30, 0.34)

	cloneResource(5, root, 11, 0.38)
	cloneResource(10, root, 10, 0.32)

	playImpactSound(root, 1.65, 0.68)

	task.wait(
		strong
		and CFG.VoidDuration * 0.75
		or CFG.VoidDuration
	)

	if token ~= S.Token then
		return
	end

	if root.Parent and humanoid.Health > 0 then
		root.CFrame = original
		root.AssemblyLinearVelocity = Vector3.zero

		creatorBurst(root, 8, 0.18)
		creatorRing(root, 3, 20, 0.25)
		cloneResource(4, root, 7, 0.3)
	end
end

-- ================================================================
-- M1
-- ================================================================

local lastM1 = 0
local m1Index = 0

local M1_ANIMATIONS = {
	ANIM.M1_1,
	ANIM.M1_2,
	ANIM.M1_3,
	ANIM.M1_4,
}

local function creatorM1()
	local now = os.clock()

	if now - lastM1 < CFG.M1Cooldown then
		return
	end

	lastM1 = now

	local character, humanoid, root = getCharacter()

	if not character or not humanoid or not root then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	-- IMPORTANT:
	-- Target is acquired BEFORE the attack animation.
	-- This prevents the old behavior where the M1 could
	-- start and only then decide where to teleport.
	local target =
		findClosestTarget(root.Position)

	m1Index += 1

	if m1Index > #M1_ANIMATIONS then
		m1Index = 1
	end

	if target then
		local targetRoot =
			target:FindFirstChild("HumanoidRootPart")

		if targetRoot and targetRoot:IsA("BasePart") then
			-- Snap behind target FIRST.
			local success =
				teleportBehindTarget(target)

			if success then
				creatorBurst(root, 3.8, 0.08)
				cloneResource(3, root, 5, 0.2)

				-- Then play the actual M1.
				playAnimation(
					humanoid,
					M1_ANIMATIONS[m1Index],
					Enum.AnimationPriority.Action4,
					1.12,
					false,
					0.38
				)

				-- Micro pause gives the animation the feeling
				-- of starting directly from behind the target.
				task.wait(0.035)

				if not root.Parent then
					return
				end

				creatorSlash(
					root,
					7 + m1Index,
					0.12
				)

				cloneResource(
					13,
					targetRoot,
					6,
					0.28
				)

				creatorBurst(
					root,
					3.5 + m1Index,
					0.1
				)

				playImpactSound(
					targetRoot,
					0.8,
					0.92 + math.random() * 0.12
				)

				glitchBurst()

				return
			end
		end
	end

	-- No target, still perform the animation locally.
	playAnimation(
		humanoid,
		M1_ANIMATIONS[m1Index],
		Enum.AnimationPriority.Action4,
		1.08,
		false,
		0.38
	)

	creatorSlash(root, 7, 0.12)
end

