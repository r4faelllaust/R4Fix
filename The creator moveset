local function glitchBurst(cf, intensity)
	intensity = intensity or 1

	if not allowedVFX(
		"glitch_" .. tostring(math.floor(cf.Position.X)),
		0.025
	) then
		return
	end

	for i = 1, math.clamp(
		math.floor(5 * intensity),
		3,
		15
	) do
		local offset =
			Vector3.new(
				math.random(-8, 8),
				math.random(-5, 8),
				math.random(-8, 8)
			)

		local size =
			math.random(1, 4) * intensity

		local color

		if i % 3 == 0 then
			color = BLACK
		elseif i % 3 == 1 then
			color = GREEN
		else
			color = BRIGHT_GREEN
		end

		createSphere(
			CFrame.new(
				cf.Position + offset
			),

			0.1,
			size,

			color,

			0.12,

			0.1
		)
	end
end

