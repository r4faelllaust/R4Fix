	setHotbarSlot(1, "Creator's Decree", "VOID EXECUTION")
	setHotbarSlot(2, "Reality Breaker", "PHANTOM ENGINE")
	setHotbarSlot(3, "Creator's Grasp", "NULL GRASP")
	setHotbarSlot(4, "Absolute Override", "THE CREATOR")
end

local function createDashEffect(hrp)
	if not allowed("movement_dash", 0.08) then return end
	local look = hrp.CFrame.LookVector
	local cf = CFrame.lookAt(hrp.Position, hrp.Position + look)
	ring(cf, 1, 8, GREEN_DARK, 0.18)
	particles(hrp, 5, GREEN_BRIGHT)
	slash(cf * CFrame.new(0, 0, 2), 7, 0.22, GREEN_BRIGHT)
end

local function destroyTool(name)
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, object in ipairs(backpack:GetChildren()) do
			if object:IsA("Tool") and object.Name == name then safeDestroy(object) end
		end
	end
	local character = LocalPlayer.Character
	if character then
		for _, object in ipairs(character:GetChildren()) do
			if object:IsA("Tool") and object.Name == name then safeDestroy(object) end
		end
	end
end

-- Run tool: ground-speed boost only, no vertical/flight component
local function createRunTool()
	destroyTool("Creator Run")
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if not backpack then return end

	local tool = Instance.new("Tool")
	tool.Name = "Creator Run"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "CREATOR // PHANTOM RUN"
	tool.Parent = backpack
	S.Tools.Run = tool

	local running = false
	local track = nil

	local function stop()
		running = false
		S.Running = false
		if track then
			pcall(function() if track.IsPlaying then track:Stop(0.1) end end)
			removeTrackFromList(track)
			safeDestroy(track)
			track = nil
		end
	end

	addConnection(S.Connections, tool.Equipped:Connect(function()
		local _, humanoid, hrp = getCharacter()
		if not humanoid or not hrp then return end
		if running then return end
		running = true
		S.Running = true
		track = playAnimation(humanoid, RUN_ANIMATION, Enum.AnimationPriority.Action, 1)
		task.spawn(function()
			while running and tool.Parent and humanoid.Health > 0 do
				local direction = hrp.CFrame.LookVector
				hrp.AssemblyLinearVelocity = Vector3.new(
					direction.X * CFG.RUN_SPEED,
					hrp.AssemblyLinearVelocity.Y, -- vertical left alone, gravity still applies normally
					direction.Z * CFG.RUN_SPEED
				)
				createDashEffect(hrp)
				RunService.Heartbeat:Wait()
			end
		end)
	end))

	addConnection(S.Connections, tool.Unequipped:Connect(stop))
	addConnection(S.Connections, tool.AncestryChanged:Connect(function(_, parent)
		if not parent then stop() end
	end))
end

local function spawnEffect(character, hrp)
	burst(hrp.CFrame, 11, BLACK, 0.35, "spawn_black")
	burst(hrp.CFrame, 8, GREEN_BRIGHT, 0.3, "spawn_green")
	ring(hrp.CFrame * CFrame.Angles(0, 0, math.rad(90)), 2, 25, GREEN_BRIGHT, 0.45, "spawn_ring")
	particles(hrp, 50, GREEN_BRIGHT, "spawn_particles")

	local highlight = Instance.new("Highlight")
	highlight.Name = "CreatorSpawnHighlight"
	highlight.FillColor = GREEN_DARK; highlight.OutlineColor = GREEN_BRIGHT
	highlight.FillTransparency = 0.72; highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = character
	TweenService:Create(highlight, TweenInfo.new(0.85, Enum.EasingStyle.Quint), {FillTransparency = 1, OutlineTransparency = 1}):Play()
	Debris:AddItem(highlight, 1)

	playSound(hrp, 1.25, 0.75)
end

local function setupMovementEffects(humanoid, hrp, token)
	local lastPosition = hrp.Position
	local lastDash = 0
	addConnection(S.CharacterConnections, RunService.Heartbeat:Connect(function()
		if token ~= S.Token then return end
		if not hrp.Parent or humanoid.Health <= 0 then return end
		local current = hrp.Position
		local delta = current - lastPosition
		local speed = delta.Magnitude / math.max(RunService.Heartbeat:Wait(), 0.016)
		lastPosition = current
		if speed > 75 and os.clock() - lastDash > 0.13 then
			lastDash = os.clock()
			createDashEffect(hrp)
		end
	end))
end

local function cleanupCharacter()
	disconnectList(S.CharacterConnections)
	stopAnimations()
	S.Busy = {}
	S.Running = false
	table.clear(S.LastVFX)
	table.clear(lastHit)
	local vfx = workspace:FindFirstChild("TheCreator_VFX")
	if vfx then safeDestroy(vfx) end
	for _, tool in pairs(S.Tools) do
		if tool and tool:IsA("Tool") then safeDestroy(tool) end
	end
	table.clear(S.Tools)
end

local function setupCharacter(character)
	S.Token += 1
	local token = S.Token
	cleanupCharacter()
	S.Ultimate = 0

	local humanoid = character:WaitForChild("Humanoid", 10)
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not hrp then return end

	spawnEffect(character, hrp)
	setupHandGlow(character)
	setupCreatorAura(character)
	setupMoveHandler(character, humanoid, hrp, token)
	setupMovementEffects(humanoid, hrp, token)
	setupHitReactions()

	task.spawn(function()
		for _ = 1, 30 do
			if token ~= S.Token then return end
			pcall(function()
				fixCharacterTab()
				refreshMoveBar()
				styleExistingUltimateBar()
			end)
			task.wait(0.15)
		end
	end)

	task.delay(0.35, function()
		if token ~= S.Token then return end
		createRunTool()
	end)

	addConnection(S.CharacterConnections, humanoid.Died:Connect(function()
		S.Busy = {}
		S.Running = false
		stopAnimations()
	end))
end

task.spawn(function()
	while LocalPlayer.Parent and S.Started do
		pcall(function()
			fixCharacterTab()
			refreshMoveBar()
			styleExistingUltimateBar()
		end)
		task.wait(0.3)
	end
end)

addConnection(S.Connections, LocalPlayer.CharacterAdded:Connect(function(character)
	task.spawn(function()
		character:WaitForChild("Humanoid", 10)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.15)
		if S.Started then setupCharacter(character) end
	end)
end))

local currentCharacter = LocalPlayer.Character
if currentCharacter then
