		then

			pcall(function()
				object:Destroy()
			end)
		end
	end
end

-- ============================================================
-- CHARACTER SETUP
-- ============================================================

local function setupCharacter(character)
	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local hrp =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not hrp
	then
		return
	end

	if CFG.NIGHTTIME then
		Lighting.ClockTime =
			0
	end

	creatorSpawn(
		character,
		humanoid,
		hrp
	)

	setupHandGlow(
		character
	)

	setupCreatorMovement(
		character,
		humanoid
	)

	setupMoveHandler(
		character,
		humanoid,
		hrp,
		token
	)

	setupM1Handler(
		humanoid
	)

	-- UI becomes available a little after respawn.
	task.spawn(function()

		for _ = 1, 20 do

			if token ~= S.Token then
				return
			end

			pcall(function()
				fixCharacterTab()
				refreshMoveBar()
				refreshUltBar()
				styleUltimateBar()
			end)

			task.wait(0.15)
		end
	end)

	task.delay(
		0.65,
		function()

			if token ~= S.Token then
				return
			end

			setupTools()
		end
	)

	addCharacterConnection(
		humanoid.Died:Connect(
			function()

				S.Busy = {}

				stopCreatorAnimations()
				stopMovementAnimation()
			end
		)
	)

	local gui =
		getPlayerGui()

	if gui then

		addUIConnection(
			gui.DescendantAdded:Connect(
				function()

					task.defer(
						function()

							if token
								~= S.Token
							then
								return
							end

							pcall(function()
								fixCharacterTab()
								refreshMoveBar()
								refreshUltBar()
								styleUltimateBar()
							end)
						end
					)
				end
			)
		)
	end
end

-- ============================================================
-- STARTUP
-- ============================================================

if not S.Started then

	S.Started = true

	disconnectList(
		S.Connections
	)

	table.insert(
		S.Connections,
		Player.CharacterAdded:Connect(
			function(character)

				task.spawn(function()

					character:WaitForChild(
						"Humanoid",
						10
					)

					character:WaitForChild(
						"HumanoidRootPart",
						10
					)

					task.wait(0.2)

					setupCharacter(
						character
					)
				end)
			end
		)
	)

	setupHitFX()

	startGlobalVFXOverride()

	startUltimateGlitch()

	startHotbarGlitch()

	task.spawn(function()

		while Player.Parent do

			pcall(function()
				fixCharacterTab()
				refreshMoveBar()
				refreshUltBar()
				styleUltimateBar()
			end)

			task.wait(0.35)
		end
	end)
end

