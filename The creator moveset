local function disconnectList(list)
	for i = #list, 1, -1 do
		local connection = list[i]

		pcall(function()
			connection:Disconnect()
		end)

		list[i] = nil
	end
end

local function addCharacterConnection(connection)
	if connection then
		table.insert(S.CharacterConnections, connection)
	end

	return connection
end

local function addUIConnection(connection)
	if connection then
		table.insert(S.UIConnections, connection)
