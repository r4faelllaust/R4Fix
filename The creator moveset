										math.cos(angle)
											* radius,

										math.sin(angle)
											* 3,

										math.sin(angle)
											* radius
									)

								local effectCF =
									CFrame.lookAt(
										targetPosition
											+ offset,

										targetPosition
									)

								slash(
									effectCF,
									12 + i,
									0.5,
									GREEN_BRIGHT
								)
							end
						)
					end
				end
			)
		end

		task.delay(
			0.78,
			function()
				local _, _, currentHRP =
					getCharacter()

				if currentHRP then
					burst(
						currentHRP.CFrame,
						35,
						GREEN_BRIGHT,
						0.8
					)

					burst(
						currentHRP.CFrame,
						18,
						BLACK,
						0.65
					)

					ring(
						currentHRP.CFrame,
						10,
						150,
						GREEN_BRIGHT,
						1
					)

					particles(
						currentHRP,
						150,
						GREEN_BRIGHT
					)
				end
			end
		)
	end

	task.delay(
		1.4,
		function()
			if track then
				pcall(function()
					if track.IsPlaying then
						track:Stop(0.08)
					end
				end)

				removeTrackFromList(track)
				safeDestroy(track)
			end

			S.Busy.Ult = nil
		end
	)
end

-- ============================================================
-- MOVE TRIGGER HANDLER
-- ============================================================

local function setupMoveHandler(
	character: Model,
	humanoid: Humanoid,
	hrp: BasePart,
	token: number
)
	addConnection(
		S.CharacterConnections,

		humanoid.AnimationPlayed:Connect(
			function(track)
				if token ~= S.Token then
					return
				end

				if not track.Animation then
					return
				end

				local id =
					track.Animation.AnimationId

				if id == MOVE1_TRIGGER then
					pcall(function()
						track:Stop()
					end)

					creatorMove1(token)
					return
				end

				if id == MOVE2_TRIGGER then
					pcall(function()
						track:Stop()
					end)

					creatorMove2(token)
					return
				end

				if id == MOVE3_TRIGGER then
					pcall(function()
						track:Stop()
					end)

					creatorMove3()
					return
				end

				if id == MOVE4_TRIGGER then
					pcall(function()
						track:Stop()
					end)

					creatorMove4()
					return
				end

				if id == SPECIAL_TRIGGER then
					pcall(function()
						track:Stop()
					end)

					playAnimation(
						humanoid,
						SPECIAL_ANIMATION,
						Enum.AnimationPriority.Action4,
						1,
						0.9
					)

					burst(
						hrp.CFrame,
						10,
						GREEN_BRIGHT,
						0.25
					)

					particles(
						hrp,
						35,
						GREEN_BRIGHT
					)

					return
				end

				for index, data in ipairs(
					ULT_MOVES
				) do
					if id == data.Trigger then
						pcall(function()
							track:Stop()
						end)

						creatorUltimate(index)
						return
					end
				end
			end
		)
	)
end

-- ============================================================
-- SPAWN EFFECT
-- ============================================================

local function spawnEffect(
	character: Model,
	hrp: BasePart
)
	-- Initial black collapse
	burst(
		hrp.CFrame,
		11,
		BLACK,
		0.35,
		"spawn_black"
	)

	-- Green core
	burst(
		hrp.CFrame,
		8,
		GREEN_BRIGHT,
		0.3,
		"spawn_green"
	)

	-- Ground shockwave
	ring(
		hrp.CFrame
			* CFrame.Angles(
				0,
				0,
				math.rad(90)
			),

		2,
		25,
		GREEN_BRIGHT,
		0.45,
		"spawn_ring"
	)

	ring(
		hrp.CFrame
			* CFrame.Angles(
				math.rad(90),
				0,
				0
			),

		2,
		20,
		GREEN_DARK,
		0.5
	)

	particles(
		hrp,
		50,
		GREEN_BRIGHT,
		"spawn_particles"
	)

	-- Character flash
	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"CreatorSpawnHighlight"

	highlight.FillColor =
		GREEN_DARK

	highlight.OutlineColor =
		GREEN_BRIGHT

	highlight.FillTransparency =
		0.72

	highlight.OutlineTransparency =
		0

	highlight.DepthMode =
		Enum.HighlightDepthMode.Occluded

	highlight.Parent =
		character

	TweenService:Create(
		highlight,
		TweenInfo.new(
			0.85,
			Enum.EasingStyle.Quint
		),
		{
			FillTransparency = 1,
			OutlineTransparency = 1,
		}
	):Play()

	Debris:AddItem(
		highlight,
		1
	)

	playSound(
		hrp,
		1.25,
		0.75
	)
end

-- ============================================================
-- MOVEMENT MONITOR
-- ============================================================

local function setupMovementEffects(
	humanoid: Humanoid,
	hrp: BasePart,
	token: number
)
	local lastPosition =
		hrp.Position

	local lastDash =
		0

	addConnection(
		S.CharacterConnections,

		RunService.Heartbeat:Connect(
			function()
				if token ~= S.Token then
					return
				end

				if not hrp.Parent
					or humanoid.Health <= 0
				then
					return
				end

				local current =
					hrp.Position

				local delta =
					current - lastPosition

				local speed =
					delta.Magnitude
					/ math.max(
						RunService.Heartbeat:Wait(),
						0.016
					)

				lastPosition = current

				-- Only trigger the effect when actual
				-- movement is fast enough.
				if speed > 75
					and os.clock() - lastDash > 0.13
				then
					lastDash = os.clock()

					createDashEffect(hrp)
				end
			end
		)
	)
end

-- ============================================================
-- CHARACTER CLEANUP
-- ============================================================

local function cleanupCharacter()
	disconnectList(
		S.CharacterConnections
	)

	stopAnimations()

	S.Busy = {}
	S.Flying = false
	S.Running = false

	table.clear(
		S.LastVFX
	)

	local vfx =
		workspace:FindFirstChild(
			"TheCreator_VFX"
		)

	if vfx then
		safeDestroy(vfx)
	end

	for _, tool in pairs(
		S.Tools
	) do
		if tool
			and tool:IsA("Tool")
		then
			safeDestroy(tool)
		end
	end

	table.clear(S.Tools)
end

-- ============================================================
-- CHARACTER SETUP
-- ============================================================

local function setupCharacter(
	character: Model
)
	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	S.Ultimate = 0

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		) :: Humanoid?

	local hrp =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		) :: BasePart?

	if not humanoid
		or not hrp
	then
		return
	end

	-- Spawn
	spawnEffect(
		character,
		hrp
	)

	-- Permanent Creator visuals
	setupHandGlow(
		character
	)

	setupCreatorAura(
		character
	)

	-- Move triggers
	setupMoveHandler(
		character,
		humanoid,
		hrp,
		token
	)

	-- Movement visuals
	setupMovementEffects(
		humanoid,
		hrp,
		token
	)

	-- Refresh the game's own UI.
	task.spawn(function()
		for _ = 1, 30 do
			if token ~= S.Token then
				return
			end

			pcall(function()
				fixCharacterTab()
				refreshMoveBar()
				styleExistingUltimateBar()
			end)

			task.wait(0.15)
		end
	end)

	-- Tools
	task.delay(
		0.35,
		function()
			if token ~= S.Token then
				return
			end

			createFlyTool()
			createRunTool()
			createTeleportTool()
		end
	)

	addConnection(
		S.CharacterConnections,

		humanoid.Died:Connect(
			function()
				S.Busy = {}
				S.Flying = false
				S.Running = false

				stopAnimations()
			end
		)
	)
end

