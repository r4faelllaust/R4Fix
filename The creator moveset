-- ================================================================
-- RUN TOOL
-- ================================================================

local function createRunTool()
	local name =
		"Creator Run"

	destroyTool(
		name
	)

	local backpack =
		LocalPlayer:WaitForChild(
			"Backpack"
		)

	local tool =
		Instance.new("Tool")

	tool.Name =
		name

	tool.RequiresHandle =
		false

	tool.CanBeDropped =
		false

	tool.ToolTip =
		"CREATOR RUN"

	tool.Parent =
		backpack

	local active =
		false

	local connection:
		RBXScriptConnection? =
		nil

	local track:
		AnimationTrack? =
		nil

	local function stop()

		active =
			false

		if connection then

			pcall(function()
				connection:Disconnect()
			end)

			connection =
				nil
		end

		if track then

			pcall(function()
				track:Stop(
					0.08
				)
			end)

			track =
				nil
		end
	end

	tool.Equipped:Connect(
		function()

			if active then
				return
			end

			local character, humanoid, root =
				getCharacter()

			if not character
				or not humanoid
				or not root
			then
				return
			end

			active =
				true

			track =
				playAnimation(
					humanoid,
					ANIM.Run,
					Enum.AnimationPriority.Movement,
					1.12,
					true
				)

			connection =
				RunService.RenderStepped:Connect(
					function()

						if not active
							or not root.Parent
							or humanoid.Health <= 0
						then

							stop()

							return
						end

						if humanoid.MoveDirection.Magnitude
							> 0.05
						then

							local direction =
								root.CFrame.LookVector

							root.AssemblyLinearVelocity =
								Vector3.new(
									direction.X
										* CFG.RunSpeed,

									root.AssemblyLinearVelocity.Y,

									direction.Z
										* CFG.RunSpeed
								)
						end
					end
				)
		end
	)

	tool.Unequipped:Connect(
		stop
	)
end

local function setupTools()
	pcall(createFlightTool)
	pcall(createTeleportTool)
	pcall(createRunTool)
end

-- ================================================================
-- ANIMATION TRIGGERS
-- ================================================================

local TRIGGERS = {
	["12273188754"] = 1,
	["12296113986"] = 2,
	["12309835105"] = 3,
	["12351854556"] = 4,

	["12460977270"] = 3,
}

local ULT_TRIGGERS = {
	["12467789963"] = 1,
	["14057231976"] = 2,
}

local function animationIdNumber(
	track: AnimationTrack
): string?
	if not track.Animation then
		return nil
	end

	local id =
		track.Animation.AnimationId

	return id:match(
		"%d+"
	)
end

local function setupMoveHandler(
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	token: number
)
	addCharacterConnection(
		humanoid.AnimationPlayed:Connect(
			function(track)

				if token ~= S.Token then
					return
				end

				local id =
					animationIdNumber(
						track
					)

				if not id then
					return
				end

				local move =
					TRIGGERS[id]

				if move then

					pcall(function()
						track:Stop()
					end)

					if move == 1 then

						task.spawn(
							move1,
							token
						)

					elseif move == 2 then

						task.spawn(
							move2,
							token
						)

					elseif move == 3 then

						move3()

					elseif move == 4 then

						move4()
					end

					return
				end

				local ult =
					ULT_TRIGGERS[id]

				if ult then

					pcall(function()
						track:Stop()
					end)

					playUltimate(
						ult
					)

					return
				end
			end
		)
	)
end

