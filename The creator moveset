local function createSphere(
	cf,
	startSize,
	endSize,
	color,
	duration,
	transparency
)
	local part = Instance.new("Part")

	part.Name = "CreatorSphere"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false

	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = color or GREEN

	part.Transparency =
		transparency or 0.15

	part.Size =
		Vector3.new(
			startSize,
			startSize,
			startSize
		)

	part.CFrame = cf
	part.Parent = getVFXFolder()

	TweenService:Create(
		part,
		TweenInfo.new(
			duration or 0.3,
			Enum.EasingStyle.Quint,
