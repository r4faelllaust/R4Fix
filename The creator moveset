local function disconnect(list: {RBXScriptConnection})
	for _, connection in ipairs(list) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(list)
end

local function track(
	connection: RBXScriptConnection,
	list: {RBXScriptConnection}
): RBXScriptConnection
	table.insert(list, connection)
	return connection
end

local function destroyObject(object: Instance?)
	if object then
		pcall(function()
			object:Destroy()
		end)
	end
end

local function cleanupObjects()
	for _, object in ipairs(SESSION.Objects) do
		destroyObject(object)
	end

	table.clear(SESSION.Objects)
end

