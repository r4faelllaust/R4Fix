-- ============================================================
-- CUSTOM MOVEMENT ANIMATIONS
-- ============================================================

local function setupMovementAnimations(
	character: Model,
	humanoid: Humanoid,
	token: number
)
	local activeMovementTrack: AnimationTrack? = nil
	local currentState = ""

	local function stopMovement()
		if activeMovementTrack then
			pcall(function()
				activeMovementTrack:Stop(0.12)
			end)

			activeMovementTrack = nil
		end
	end

	local function playMovement(
		id: string,
		looped: boolean,
		speed: number
	)
		if token ~= S.Token then
			return
		end

		stopMovement()

		activeMovementTrack =
			playAnimation(
				humanoid,
				id,
				Enum.AnimationPriority.Movement,
				speed,
				looped
			)
	end

	addCharacterConnection(
		humanoid.Running:Connect(
			function(speed)
				if token ~= S.Token then
					return
				end

				if speed > 1 then
					if speed > 24 then
						if currentState ~= "run" then
							currentState = "run"

							playMovement(
								ANIMS.Run,
								true,
								1.15
							)
						end
					else
						if currentState ~= "walk" then
							currentState = "walk"

							playMovement(
								ANIMS.Walk,
								true,
								1
							)
						end
					end
				else
					if currentState ~= "idle" then
						currentState = "idle"

						-- Atomic spawn animation is used as
						-- the distorted floating idle reference.
						playMovement(
							ANIMS.Idle,
							true,
							0.65
						)
					end
				end
			end
		)
	)

	addCharacterConnection(
		humanoid.StateChanged:Connect(
			function(_, newState)
				if token ~= S.Token then
					return
				end

				if
					newState ==
						Enum.HumanoidStateType.Jumping
					or newState ==
						Enum.HumanoidStateType.Freefall
				then
					currentState = "air"

					playMovement(
						ANIMS.Air,
						false,
						1
					)
				end
			end
		)
	)
end

-- ============================================================
-- M1 AUTO TP DETECTION
-- ============================================================

local function isM1Animation(id: string)
	for _, animationId in ipairs(
		ANIMS.M1
	) do
		if id == animationId then
			return true
		end
	end

	return false
end

local function handleM1(
	humanoid: Humanoid
)
	if not CFG.M1_TP_ENABLED then
		return
	end

	if S.Busy.Move1
		or S.Busy.Move2
		or S.Busy.Move3
		or S.Busy.Move4
	then
		return
	end

	local target =
		getClosestTarget()

	if not target then
		return
	end

	teleportBehindTarget(
		target
	)
end

-- ============================================================
-- MOVE HANDLER
-- ============================================================

local function setupMoveHandler(
	character: Model,
	humanoid: Humanoid,
	hrp: BasePart,
	token: number
)
	addCharacterConnection(
		humanoid.AnimationPlayed:Connect(
			function(track)
				if token ~= S.Token then
					return
				end

				if not track.Animation then
					return
				end

				local id =
					track.Animation.AnimationId

				-- M1 AUTO TP
				if isM1Animation(id) then
					task.spawn(function()
						handleM1(
							humanoid
						)
					end)

					return
				end

				-- MOVE 1
				if id == MOVE1_TRIGGER then
					pcall(function()
						track:Stop()
					end)

					move1(token)

					return
				end

				-- MOVE 2
				if id == MOVE2_TRIGGER then
					pcall(function()
						track:Stop()
					end)

					move2(token)

					return
				end

				-- MOVE 3
				if id == MOVE3_TRIGGER then
					pcall(function()
						track:Stop()
					end)

					move3()

					return
				end

				-- MOVE 4
				if id == MOVE4_TRIGGER then
					pcall(function()
						track:Stop()
					end)

					move4()

					return
				end

				-- SPECIAL
				if id == SPECIAL_TRIGGER then
					pcall(function()
						track:Stop()
					end)

					playAnimation(
						humanoid,
						ANIMS.Move4,
						Enum.AnimationPriority.Action4,
						1,
						false,
						0.9
					)

					return
				end

				-- ULTIMATE
				for index, data in ipairs(
					ULT_MOVES
				) do

					if id == data.Trigger then

						pcall(function()
							track:Stop()
						end)

						playUlt(index)

						return
					end
				end
			end
		)
	)
end

-- ============================================================
-- TARGET HIT VFX
-- ============================================================

local function setupTargetHitEffects()
	local live =
		getLiveFolder()

	if not live then
		return
	end

	for _, target in ipairs(
		live:GetChildren()
	) do

		if not target:IsA("Model") then
			continue
		end

		local humanoid =
			target:FindFirstChildOfClass(
				"Humanoid"
			)

		local hrp =
			target:FindFirstChild(
				"HumanoidRootPart"
			)

		if not humanoid or not hrp then
			continue
		end

		if target:GetAttribute(
			"R4FixHitConnected"
		) then
			continue
		end

		target:SetAttribute(
			"R4FixHitConnected",
			true
		)

		local lastHealth =
			humanoid.Health

		addCharacterConnection(
			humanoid.HealthChanged:Connect(
				function(newHealth)
					if newHealth < lastHealth then
						if
							hrp
							and hrp.Parent
						then
							burst(
								hrp.CFrame,
								4,
								BRIGHT_PURPLE,
								0.16,
								"target_hit"
							)

							particles(
								hrp,
								8,
								BRIGHT_BLUE,
								"target_hit_particles"
							)
						end
					end

					lastHealth = newHealth
				end
			)
		)
	end
end

