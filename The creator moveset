		hrp.Position
		+ direction
		* CFG.VOID_DISTANCE
		+ Vector3.new(
			0,
			CFG.VOID_HEIGHT,
			0
		)

	local voidCF =
		CFrame.lookAt(
			voidPosition,
			voidPosition + direction
		)

