-- ============================================================
-- BACKGROUND MUSIC
-- ============================================================
--
-- Roblox Sound.SoundId does NOT accept arbitrary GitHub URLs.
--
-- The supplied file:
-- https://github.com/r4faelllaust/R4Fix/raw/refs/heads/main/Soviet_Anthem_Instrumental_1955.ogg.mp3
--
-- If the executor exposes a REAL local-asset API, the script:
-- 1. Downloads the file using the executor HTTP request function.
-- 2. Writes it locally.
-- 3. Loads it with getcustomasset / getsynasset.
--
-- If those capabilities do not exist, the music is simply skipped.
-- Nothing fake is inserted into SoundId.

local MUSIC_URL =
	"https://github.com/r4faelllaust/R4Fix/raw/refs/heads/main/Soviet_Anthem_Instrumental_1955.ogg.mp3"

local MUSIC_FILE =
	"TheCreator_Soviet_Anthem_Instrumental_1955.mp3"

local MUSIC_VOLUME = 0.24

local function getRequestFunction()
	if type(request) == "function" then
		return request
	end

	if type(http_request) == "function" then
		return http_request
	end

	if type(syn) == "table" and type(syn.request) == "function" then
		return syn.request
	end

	return nil
end

local function getAssetFunction()
	if type(getcustomasset) == "function" then
		return getcustomasset
	end

	if type(getsynasset) == "function" then
		return getsynasset
	end

	return nil
end

local function setupCreatorMusic()
	local requestFunction = getRequestFunction()
	local assetFunction = getAssetFunction()

	if not requestFunction or not assetFunction then
		return
	end

	local localFile = MUSIC_FILE

	local alreadyExists = false

	if type(isfile) == "function" then
		local ok, result = pcall(function()
			return isfile(localFile)
		end)

		if ok and result == true then
			alreadyExists = true
		end
	end

	if not alreadyExists then
		local ok, response = pcall(function()
			return requestFunction({
				Url = MUSIC_URL,
				Method = "GET",
			})
		end)

		if not ok or type(response) ~= "table" then
			return
		end

		if tonumber(response.StatusCode) ~= 200 then
			return
		end

		if type(response.Body) ~= "string" then
			return
		end

		if type(writefile) ~= "function" then
			return
		end

		local writeOK = pcall(function()
			writefile(localFile, response.Body)
		end)

		if not writeOK then
			return
		end
	end

	local assetOK, asset = pcall(function()
		return assetFunction(localFile)
	end)

	if not assetOK or type(asset) ~= "string" or asset == "" then
		return
	end

	local soundParent = workspace:FindFirstChild("TheCreator_Audio")

	if soundParent then
		safeDestroy(soundParent)
	end

	local folder = Instance.new("Folder")
	folder.Name = "TheCreator_Audio"
	folder.Parent = workspace

	local sound = Instance.new("Sound")
	sound.Name = "TheCreator_BackgroundMusic"
	sound.SoundId = asset
	sound.Volume = MUSIC_VOLUME
	sound.Looped = true
	sound.PlaybackSpeed = 1
	sound.RollOffMaxDistance = 100000
	sound.Parent = folder

	local ok = pcall(function()
		sound:Play()
	end)

	if ok then
		S.Music = sound
	else
		safeDestroy(folder)
	end
end

