-- ============================================================

local function setupAura(character)
	for _, limbName in ipairs({
		"Left Arm",
		"Right Arm",
		"LeftHand",
		"RightHand",
		"LeftLowerArm",
		"RightLowerArm",
		"LeftUpperArm",
		"RightUpperArm",
	}) do
		local limb =
			character:FindFirstChild(
				limbName
			)

		if limb and
			limb:IsA("BasePart")
		then
			local attachment =
				Instance.new("Attachment")

			attachment.Name =
				"R4FixCreatorAura"

			attachment.Parent =
				limb

			local emitter =
				Instance.new("ParticleEmitter")

			emitter.Name =
				"CreatorGreenCorruption"

			emitter.Color =
				ColorSequence.new({
					ColorSequenceKeypoint.new(
						0,
						TOXIC_GREEN
					),

					ColorSequenceKeypoint.new(
						0.5,
						GREEN
					),

					ColorSequenceKeypoint.new(
						1,
						BLACK
					),
				})

			emitter.LightEmission = 1

			emitter.Rate = 3

			emitter.Lifetime =
				NumberRange.new(
					0.2,
					0.5
				)

			emitter.Speed =
				NumberRange.new(
					0.3,
					1.5
				)

			emitter.SpreadAngle =
				Vector2.new(
					180,
					180
				)

			emitter.Size =
				NumberSequence.new({
					NumberSequenceKeypoint.new(
						0,
						0.35
					),

					NumberSequenceKeypoint.new(
						0.6,
						0.2
					),

					NumberSequenceKeypoint.new(
						1,
						0
					),
				})

			emitter.Parent =
				attachment
		end
	end
end

