-- ============================================================
-- ANIMATION TRIGGERS
-- ============================================================

local function setupAnimationHandler(
	character,
	humanoid,
	root,
	token
)
	addCharacterConnection(
		humanoid.AnimationPlayed:Connect(
			function(track)
				if token ~= S.Token then
					return
				end

				if not track.Animation then
					return
				end

				local id =
					track.Animation.AnimationId

				if id == ANIM.MOVE1_TRIGGER
					and id ~= ""
				then
					pcall(function()
						track:Stop()
					end)

					move1(token)

					return
				end

				if id == ANIM.MOVE2_TRIGGER
					and id ~= ""
				then
					pcall(function()
						track:Stop()
					end)

					move2(token)

					return
				end

				if id == ANIM.MOVE3_TRIGGER
					and id ~= ""
				then
					pcall(function()
						track:Stop()
					end)

					move3()

					return
				end

				if id == ANIM.MOVE4_TRIGGER
					and id ~= ""
				then
					pcall(function()
						track:Stop()
					end)

					move4()

					return
				end

				for index, data in ipairs(
					ULT_MOVES
				) do
					if data.Trigger ~= ""
						and id == data.Trigger
					then
						pcall(function()
							track:Stop()
						end)

						ultimateMove(index)

						return
					end
				end
			end
		)
	)
end

-- ============================================================
-- CHARACTER SETUP
-- ============================================================

local function setupCharacter(character)
	S.Token += 1

	local token = S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid or not root then
		return
	end

	Lighting.ClockTime =
		CFG.NIGHT_TIME

	setupAura(character)

	spawnEffect(
		character,
		root
	)

	setupAnimationHandler(
		character,
		humanoid,
		root,
		token
	)

	addCharacterConnection(
		humanoid.Died:Connect(
			function()
				S.Busy = {}
				cleanupAnimations()
			end
		)
	)

	task.spawn(function()
		for _ = 1, 25 do
			if token ~= S.Token then
				return
			end

			pcall(function()
				fixCharacterTab()
				refreshHotbar()
				styleUltimateBar()
			end)

			task.wait(0.15)
		end
	end)
end

