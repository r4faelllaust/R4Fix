local function allowed(key: string, cooldown: number?)
	local now = os.clock()
	local previous = S.LastVFX[key] or 0

	if now - previous < (cooldown or CFG.VFX_COOLDOWN) then
		return false
	end

	S.LastVFX[key] = now
	return true
end

-- ============================================================
-- VFX: BURST
-- ============================================================

local function burst(
	cf: CFrame,
	size: number,
	color: Color3?,
	duration: number?,
	key: string?
)
	if key and not allowed(key) then
		return
	end

	local part = Instance.new("Part")
	part.Name = "CreatorBurst"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = color or GREEN
	part.Transparency = 0.1
	part.Size = Vector3.one
	part.CFrame = cf
	part.Parent = getVFXFolder()

	TweenService:Create(
		part,
		TweenInfo.new(
			duration or 0.3,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(size, size, size),
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(part, (duration or 0.3) + 0.15)
end

