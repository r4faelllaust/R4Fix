-- ================================================================
-- ANIMATION TRIGGER HANDLER
-- ================================================================

local TRIGGERS = {
	["12273188754"] = 1,
	["12296113986"] = 2,
	["12309835105"] = 3,
	["12351854556"] = 4,

	["12460977270"] = 3,
}

local ULT_TRIGGERS = {
	["12467789963"] = 1,
	["14057231976"] = 2,
}

local function animationIdNumber(track: AnimationTrack)
	if not track.Animation then
		return nil
	end

	local id =
		track.Animation.AnimationId

	return id:match("%d+")
end

local function setupMoveHandler(
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	token: number
)
	addCharacterConnection(
		humanoid.AnimationPlayed:Connect(
			function(track)

				if token ~= S.Token then
					return
				end

				local id =
					animationIdNumber(track)

				if not id then
					return
				end

				local move =
					TRIGGERS[id]

				if move then

					pcall(function()
						track:Stop()
					end)

					if move == 1 then
						task.spawn(
							move1,
							token
						)

					elseif move == 2 then
						task.spawn(
							move2,
							token
						)

					elseif move == 3 then
						move3()

					elseif move == 4 then
						move4()
					end

					return
				end

				local ult =
					ULT_TRIGGERS[id]

				if ult then

					pcall(function()
						track:Stop()
					end)

					playUltimate(ult)

					return
				end
			end
		)
	)
end

