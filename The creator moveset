		"TH3 CREATOR",
		"THE CREATOR //",
		"// CREATOR",
		"CREATOR.exe",
		"CR_ERROR",
		"THE CREATOR",
	}

	textObject.Text =
		variants[
			math.random(
				1,
				#variants
