local lastM1 = 0
local m1Index = 0

local function creatorM1()
	local now = os.clock()

	if now - lastM1 < CFG.M1Cooldown then
		return
	end

	lastM1 = now

	local character, humanoid, root = getCharacter()

	if not character or not humanoid or not root then
		return
	end

	local target = findClosestTarget(root.Position)

	m1Index += 1

	if m1Index > 4 then
		m1Index = 1
	end

	local animations = {
		ANIM.M1_1,
		ANIM.M1_2,
		ANIM.M1_3,
		ANIM.M1_4,
	}

	local track = playAnimation(
		humanoid,
		animations[m1Index],
		Enum.AnimationPriority.Action4,
		1.08,
		false,
		0.42
	)

	if target then
		voidTeleportBehind(target)

		local targetRoot = target:FindFirstChild("HumanoidRootPart")

		if targetRoot then
			local targetAttachment = targetRoot:FindFirstChild("CreatorHitFX")

			if not targetAttachment then
				targetAttachment = Instance.new("Attachment")
				targetAttachment.Name = "CreatorHitFX"
				targetAttachment.Parent = targetRoot
			end

			cloneResource(
				13,
				targetAttachment,
				6,
				0.28
