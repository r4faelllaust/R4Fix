----------------------------------------------------------------
-- COSMETIC HIT REACTIONS (replaces the removed M1 aimbot) —
-- fires off real HealthChanged events on things you actually hit
-- through the game's own combat, same pattern as every other
-- moveset in this thread.
----------------------------------------------------------------
local lastHit = {}
local function setupHitReactions()
	local live = workspace:FindFirstChild("Live")
	if not live then return end
	local function connectTarget(model)
		if not model:IsA("Model") or model == LocalPlayer.Character then return end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		local lastHealth = humanoid.Health
		addConnection(S.CharacterConnections, humanoid.HealthChanged:Connect(function(newHealth)
			if newHealth < lastHealth and model:GetAttribute("LastHit") == LocalPlayer.Name then
				local now = os.clock()
				if now - (lastHit[model] or 0) >= CFG.HIT_COOLDOWN then
					lastHit[model] = now
					S.Ultimate = math.clamp((S.Ultimate or 0) + CFG.ULT_GAIN_HIT, 0, CFG.ULT_MAX)
					local root = model:FindFirstChild("HumanoidRootPart")
					if root then
						burst(root.CFrame, 6, GREEN_BRIGHT, 0.2, "hit_" .. model.Name)
						ring(root.CFrame, 1.5, 10, GREEN_DARK, 0.25)
						particles(root, 12, GREEN_BRIGHT)
						playSound(root, 0.7, 1.05)
					end
				end
			end
			lastHealth = newHealth
		end))
	end
	for _, model in ipairs(live:GetChildren()) do connectTarget(model) end
	addConnection(S.CharacterConnections, live.ChildAdded:Connect(function(model)
		task.wait(0.05)
		connectTarget(model)
	end))
end

