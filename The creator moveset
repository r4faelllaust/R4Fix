local function phantomEngine(
	level: number
)

	local character, humanoid, root =
		getCharacter()

	if not character
		or not humanoid
		or not root
	then
		return
	end

	local target =
		getClosestTarget()

	if target then
		blinkBehindTarget(
			target
		)
	end

	playCapped(
		humanoid,
		MOVE1_ANIMATION,
		Enum.AnimationPriority.Action4,
		CONFIG.Move1Duration,
		1.65
	)

	for i = 1, 7 do

		task.delay(
			i * 0.045,
			function()

				local _, _, currentRoot =
					getCharacter()

				if currentRoot then

					chaoticBurst(
						currentRoot.CFrame
							* CFrame.new(
								math.random(-5, 5) / 10,
								math.random(-5, 5) / 10,
								math.random(-5, 5) / 10
							),
						1.5 + level * 0.3,
						"phantom_" .. i
					)

				end
			end
		)
	end
end

