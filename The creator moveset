local function getCharacter()
	local character = LocalPlayer.Character
	if not character then return nil, nil, nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then return nil, nil, nil end
	return character, humanoid, hrp
end

local function getAnimator(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then animator = Instance.new("Animator"); animator.Parent = humanoid end
	return animator
end

local function removeTrackFromList(track)
	for i = #S.AnimationTracks, 1, -1 do
		if S.AnimationTracks[i] == track then table.remove(S.AnimationTracks, i); break end
	end
end

local function stopAnimations()
	for i = #S.AnimationTracks, 1, -1 do
		local track = S.AnimationTracks[i]
		pcall(function()
			if track.IsPlaying then track:Stop(0.06) end
			track:Destroy()
		end)
		table.remove(S.AnimationTracks, i)
	end
end

local function playAnimation(humanoid, id, priority, speed, duration)
	if humanoid.Health <= 0 then return nil end
	local animator = getAnimator(humanoid)
	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local ok, track = pcall(function() return animator:LoadAnimation(animation) end)
	safeDestroy(animation)
	if not ok or not track then return nil end
	track.Priority = priority or Enum.AnimationPriority.Action4
	track.Looped = false
	table.insert(S.AnimationTracks, track)
	local played = pcall(function() track:Play(0.035, 1, speed or 1) end)
	if not played then removeTrackFromList(track); safeDestroy(track); return nil end
	if duration then
		task.delay(duration, function()
			pcall(function()
				if track.IsPlaying then track:Stop(0.07) end
				track:Destroy()
			end)
			removeTrackFromList(track)
		end)
	end
	return track
end

local function getVFXFolder()
	local folder = workspace:FindFirstChild("TheCreator_VFX")
	if folder and folder:IsA("Folder") then return folder end
	if folder then safeDestroy(folder) end
	local newFolder = Instance.new("Folder")
	newFolder.Name = "TheCreator_VFX"
	newFolder.Parent = workspace
	return newFolder
end

local function allowed(key, cooldown)
	local now = os.clock()
	local previous = S.LastVFX[key] or 0
	local cd = cooldown or CFG.VFX_COOLDOWN
	if now - previous < cd then return false end
	S.LastVFX[key] = now
	return true
end

local function burst(cf, size, color, duration, key)
	if key and not allowed(key) then return end
	local part = Instance.new("Part")
	part.Name = "CreatorBurst"
	part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false; part.CastShadow = false
	part.Shape = Enum.PartType.Ball; part.Material = Enum.Material.Neon
	part.Color = color or GREEN_BRIGHT
	part.Transparency = 0.08; part.Size = Vector3.new(0.25, 0.25, 0.25); part.CFrame = cf
	part.Parent = getVFXFolder()
	TweenService:Create(part, TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{Size = Vector3.new(size, size, size), Transparency = 1}):Play()
	Debris:AddItem(part, (duration or 0.3) + 0.2)
end

