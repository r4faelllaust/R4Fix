local function setupCreatorMovement(character, humanoid)
	local animator = getAnimator(humanoid)

	addCharacterConnection(
		humanoid.Running:Connect(
			function(speed)
				if humanoid.Health <= 0 then
					return
				end

				if speed < 1 then
					if not movementTracks.Idle then
						stopMovementAnimation()

						movementTracks.Idle =
							playAnimation(
								humanoid,
								ANIM.Idle,
								Enum.AnimationPriority.Idle,
								1,
								nil,
								true
							)
					end

					return
				end

				if speed > 75 then
					if not movementTracks.Run then
						stopMovementAnimation()

						movementTracks.Run =
							playAnimation(
								humanoid,
								ANIM.Run,
								Enum.AnimationPriority.Movement,
								1.15,
								nil,
								true
							)
					end
				else
					if not movementTracks.Walk then
						stopMovementAnimation()

						movementTracks.Walk =
							playAnimation(
								humanoid,
								ANIM.Walk,
								Enum.AnimationPriority.Movement,
								1,
								nil,
								true
							)
					end
				end
			end
		)
	)

	addCharacterConnection(
		humanoid.StateChanged:Connect(
			function(_, newState)
				if newState ==
					Enum.HumanoidStateType.Jumping
					or newState ==
					Enum.HumanoidStateType.Freefall
				then

					stopMovementAnimation()
				end
			end
		)
	)

	-- Prevent the default animation controller from
	-- permanently taking back Creator's custom idle.
	task.spawn(function()
		while character.Parent
			and humanoid.Parent
			and humanoid.Health > 0
		do

			if humanoid.MoveDirection.Magnitude < 0.03
				and humanoid:GetState()
					~= Enum.HumanoidStateType.Freefall
				and humanoid:GetState()
					~= Enum.HumanoidStateType.Jumping
			then

				if not movementTracks.Idle then
					stopMovementAnimation()

					movementTracks.Idle =
						playAnimation(
							humanoid,
							ANIM.Idle,
							Enum.AnimationPriority.Idle,
							1,
							nil,
							true
						)
				end
			end

			task.wait(0.35)
		end
	end)
end

