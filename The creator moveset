-- ============================================================

local function isAlivePlayer(player: Player)
	if player == LocalPlayer then
		return false
	end

	local character = player.Character

	if not character then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	local hrp =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	return humanoid ~= nil
		and hrp ~= nil
		and humanoid.Health > 0
end

local function getClosestPlayer(
	maxDistance: number?
)
	local _, _, myHRP = getCharacter()

	if not myHRP then
		return nil, math.huge
	end

	local closestPlayer: Player? = nil
	local closestDistance =
		maxDistance or math.huge

	for _, player in ipairs(
		Players:GetPlayers()
	) do
		if isAlivePlayer(player) then
			local character =
				player.Character

			if character then
				local targetHRP =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if targetHRP
					and targetHRP:IsA("BasePart")
				then
					local distance =
						(
							targetHRP.Position
							- myHRP.Position
						).Magnitude

					if distance < closestDistance then
						closestDistance = distance
						closestPlayer = player
					end
				end
			end
		end
	end

	return closestPlayer, closestDistance
end

