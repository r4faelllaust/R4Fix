function S.Destroy()
	S.Alive = false

	disconnectAll(S.Connections)
	disconnectAll(S.CharacterConnections)

	cleanupTracks()

	local folder =
		workspace:FindFirstChild(
			"R4Fix_TheCreator_VFX"
		)

	if folder then
		pcall(function()
			folder:Destroy()
		end)
	end

	local character =
		LP.Character

	if character then
		for _, object in ipairs(
			character:GetDescendants()
		) do
			if object.Name ==
				"R4FixCreatorAura"
			then
				pcall(function()
					object:Destroy()
				end)
			elseif object.Name ==
				"R4FixCreatorHighlight"
			then
				pcall(function()
					object:Destroy()
				end)
			end
		end
	end

	S.Busy = {}
end

