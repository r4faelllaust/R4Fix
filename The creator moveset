-- ============================================================
-- ULTIMATE BAR
-- ============================================================

local function styleUltimateBar()
	local gui = getGui()

	if not gui then
		return
	end

	local bar =
		gui:FindFirstChild(
			"Bar"
		)

	if not bar then
		return
	end

	local magicHealth =
		bar:FindFirstChild(
			"MagicHealth"
		)

	if not magicHealth then
		return
	end

	local text =
		magicHealth:FindFirstChild(
			"TextLabel"
		)

	if text and
		text:IsA("TextLabel")
	then
		text.Text =
			"ＴＨＥ  C R E A T O R"

		text.TextColor3 =
			BRIGHT_GREEN

		text.TextSize = 25
	end

	local health =
		magicHealth:FindFirstChild(
			"Health"
		)

	if not health then
		return
	end

	local holder =
		health:FindFirstChild(
			"Bar"
		)

	if not holder then
		return
	end

	local fill =
		holder:FindFirstChild(
			"Bar"
		)

	if fill then
		if fill:IsA("Frame") then
			fill.BackgroundColor3 =
				GREEN

			fill.BackgroundTransparency = 0
		elseif
			fill:IsA("ImageLabel")
			or fill:IsA("ImageButton")
		then
			fill.ImageColor3 =
				GREEN

			fill.ImageTransparency = 0
		end

		local gradient =
			fill:FindFirstChildOfClass(
				"UIGradient"
			)

		if gradient then
			gradient.Color =
				ColorSequence.new({
					ColorSequenceKeypoint.new(
						0,
						BRIGHT_GREEN
					),

					ColorSequenceKeypoint.new(
						0.35,
						GREEN
					),

					ColorSequenceKeypoint.new(
						0.7,
						DARK_GREEN
					),

					ColorSequenceKeypoint.new(
						1,
						BLACK
					),
				})
		end
	end
end

-- ============================================================
-- CHARACTER TAB
-- ============================================================

local function fixCharacterTab()
	local gui = getGui()

	if not gui then
		return
	end

	local topbar =
		gui:FindFirstChild(
			"TopbarPlus"
		)

	if not topbar then
		return
	end

	for _, object in ipairs(
		topbar:GetDescendants()
	) do
		if object.Name ~= "IconButton" then
			continue
		end

		local label =
			object:FindFirstChild(
				"IconLabel"
			)

		local image =
			object:FindFirstChild(
				"IconImage"
			)

		if label and
			label:IsA("TextLabel")
		then
			local current =
				label.Text

			if current == "Garou"
				or current == "Hero Hunter"
				or current == "Dark Garou"
				or current == "The Creator"
			then
				label.Text =
					MOVESET_NAME

				if image and
					(
						image:IsA("ImageLabel")
						or image:IsA("ImageButton")
					)
				then
					image.Image =
						DECAL_ID
				end
			end
		end
	end
end

