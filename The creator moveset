		return
	end

	local hotbar =
		playerGui:FindFirstChild(
			"Hotbar",
			true
		)

	if not hotbar then
		return
	end

	local container =
		hotbar:FindFirstChild(
			"Hotbar",
			true
		)

	if not container then
		return
	end

	local slot =
		container:FindFirstChild(
			tostring(slotNumber),
			true
		)

	if not slot then
		return
	end

	local toolName =
		slot:FindFirstChild(
			"ToolName",
			true
		)

