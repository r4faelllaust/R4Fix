-- ================================================================
-- IDLE
-- ================================================================

local idleConnection:
	RBXScriptConnection? = nil

local function stopIdle()
	if idleConnection then
		pcall(function()
			idleConnection:Disconnect()
		end)

		idleConnection = nil
	end
end

local function startCreatorIdle(
	root: BasePart,
	humanoid: Humanoid
)
	stopIdle()

	local started =
		os.clock()

	local baseCFrame =
		root.CFrame

	idleConnection =
		RunService.RenderStepped:Connect(
			function()
				if not root.Parent
					or humanoid.Health <= 0
				then
					stopIdle()
					return
				end

				if humanoid.MoveDirection.Magnitude
					> 0.05
				then
					baseCFrame =
						root.CFrame

					return
				end

				-- FIX:
				-- Do not add sine offsets to the current CFrame.
				-- That caused the old script to accumulate/jitter.
				local elapsed =
					os.clock() - started

				local bob =
					math.sin(
						elapsed * 2.4
					) * 0.045

				local rotation =
					math.sin(
						elapsed * 1.7
					) * 0.006

				local position =
					root.Position

				root.CFrame =
					CFrame.new(
						position.X,
						position.Y + bob,
						position.Z
					)
					* CFrame.Angles(
						0,
						rotation,
						0
					)
			end
		)

	addCharacterConnection(
		idleConnection
	)
end

