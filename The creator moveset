-- ================================================================

local function startGlitchLoop()

	task.spawn(function()

		while LocalPlayer.Parent do

			pcall(function()
				fixCreatorSelection()
				styleUltimateBar()

				for i = 1, 4 do
					styleMoveSlot(i)
				end

				if math.random() < 0.32 then
					glitchHotbar()
				end

				if math.random() < 0.42 then
					glitchUltimateBar()
				end

				if math.random() < 0.2 then
					glitchBurst()
				end
			end)

			task.wait(
				math.random(14, 31) / 100
			)
		end
	end)
end

-- ================================================================
-- CHARACTER SETUP
-- ================================================================

local function setupCharacter(character: Model)

	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not root
	then
		return
	end

	-- Creator spawn
	creatorSpawn(
		character,
		root
	)

	-- Green aura
	creatorAura(character)

	-- Custom idle floating effect
	startCreatorIdle(
		root,
		humanoid
	)

	-- Move handler
	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)

	-- UI needs multiple passes because TSB can rebuild
	-- character UI after character selection.
	task.spawn(function()

		for _ = 1, 30 do

			if token ~= S.Token then
				return
			end

			pcall(function()
				fixCreatorSelection()
				styleUltimateBar()

				for i = 1, 4 do
					styleMoveSlot(i)
				end
			end)

			task.wait(0.12)
		end
	end)

	task.delay(
		0.4,
		function()

			if token ~= S.Token then
				return
			end

			setupTools()
		end
	)

	addCharacterConnection(
		humanoid.Died:Connect(
			function()

				S.Busy = {}

				cleanupTracks()

				creatorHeadText(
					"CREATOR CONNECTION LOST"
				)
			end
		)
	)

	addCharacterConnection(
		character.AncestryChanged:Connect(
			function(_, parent)

				if not parent then
					S.Token += 1
				end
			end
		)
	)
end

