local function getVFXFolder()
	local folder = workspace:FindFirstChild("TheCreator_VFX")

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "TheCreator_VFX"
		folder.Parent = workspace
	end

	return folder
end

local function allowed(key, cooldown)
	local now = os.clock()

	local last = S.LastVFX[key] or 0

	if now - last < (cooldown or CFG.VFX_COOLDOWN) then
		return false
	end

	S.LastVFX[key] = now

	return true
end

