local function getCharacter():
	(Model?, Humanoid?, BasePart?)

	local character = Player.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid
		or not root
		or not root:IsA("BasePart")
		or humanoid.Health <= 0
	then
		return nil, nil, nil
	end

	return character, humanoid, root
end

-- ================================================================
-- ANIMATION
-- ================================================================

local function getAnimator(humanoid: Humanoid): Animator
	local animator =
		humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

local function normalizeAnimationId(id: string): string
	local numeric = string.match(id, "%d+")

	if numeric then
		return numeric
	end

	return id
end

local function animationMatches(
	actual: string,
	expected: string
): boolean
	return normalizeAnimationId(actual)
		== normalizeAnimationId(expected)
end

local function playAnimation(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority?,
	speed: number?
): AnimationTrack?

	if humanoid.Health <= 0 then
		return nil
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = id

	local animator = getAnimator(humanoid)

	local success, result = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	animation:Destroy()

	if not success or not result then
		return nil
	end

	local animationTrack = result :: AnimationTrack

	animationTrack.Priority =
		priority or Enum.AnimationPriority.Action

	animationTrack.Looped = false

	pcall(function()
		animationTrack:Play(
			0.025,
			1,
			speed or 1
		)
	end)

	return animationTrack
end

local function playCapped(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority?,
	duration: number,
	speed: number?
): AnimationTrack?

	local animationTrack =
		playAnimation(
			humanoid,
			id,
			priority,
			speed
		)

	if animationTrack then
		task.delay(duration, function()
			pcall(function()
				if animationTrack.IsPlaying then
					animationTrack:Stop(0.04)
				end

				animationTrack:Destroy()
			end)
		end)
	end

	return animationTrack
end

