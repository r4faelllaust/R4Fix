		oldCF,
		11,
		GREEN_BRIGHT,
		0.2,
		"void_depart"
	)

	burst(
		oldCF,
		5,
		BLACK,
		0.3,
		"void_depart_black"
	)

	ring(
		oldCF,
		4,
		30,
		GREEN_BRIGHT,
		0.4,
		"void_depart_ring"
	)

	hrp.CFrame = voidCF
	hrp.AssemblyLinearVelocity =
		Vector3.zero

	-- Void arrival
	burst(
		voidCF,
		16,
		BLACK,
		0.4,
		"void_arrive"
	)

	burst(
		voidCF,
		10,
		GREEN_BRIGHT,
		0.3,
		"void_core"
	)

	ring(
		voidCF,
		5,
		40,
		GREEN_BRIGHT,
		0.55,
		"void_ring"
	)

	ring(
		voidCF
			* CFrame.Angles(
				math.rad(90),
				0,
				0
			),

		4,
		32,
		GREEN_DARK,
		0.5
	)

	particles(
		hrp,
		55,
		GREEN_BRIGHT,
		"void_particles"
	)

	playSound(
		hrp,
		1.7,
		0.68
	)

	task.delay(
		CFG.VOID_DURATION,
		function()
			if token ~= S.Token then
				S.Busy.Move1 = nil
				return
			end

			if hrp.Parent
				and humanoid.Health > 0
			then
				burst(
					hrp.CFrame,
					15,
					GREEN_BRIGHT,
					0.3,
					"void_return"
				)

				hrp.CFrame = oldCF

				hrp.AssemblyLinearVelocity =
					Vector3.zero

				burst(
					oldCF,
					13,
					GREEN_BRIGHT,
					0.3,
					"void_reappear"
				)

				ring(
					oldCF,
					3,
					34,
					GREEN_BRIGHT,
					0.42
				)

				particles(
					hrp,
					50,
					GREEN_BRIGHT
				)
			end

			S.Busy.Move1 = nil
		end
	)

	if track then
		task.delay(
			1,
			function()
				pcall(function()
					if track.IsPlaying then
						track:Stop(0.06)
					end
				end)
			end
		)
	end
end

