	)
end

local function getSlot(number)
	local container =
		getHotbar()

	if not container then
		return nil
	end

	return container:FindFirstChild(
		tostring(number)
	)
end

local function setSlot(number, name, label)
	local slot =
		getSlot(number)

	if not slot then
		return
	end

	local base =
		slot:FindFirstChild("Base")

	if not base then
		return
	end

	local toolName =
		base:FindFirstChild(
			"ToolName"
		)

	if toolName
		and toolName:IsA("TextLabel")
	then
		toolName.Text = name
	end

	local reuse =
		base:FindFirstChild(
			"Reuse"
		)

	if reuse
		and reuse:IsA("TextLabel")
	then
		reuse.Visible = true
		reuse.Text = label
	end
end

