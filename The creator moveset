	part.CanQuery =
		false

	part.CastShadow =
		false

	part.Shape =
		Enum.PartType.Ball

	part.Material =
		Enum.Material.Neon

	part.Color =
		CREATOR_GREEN

	part.Transparency =
		0.2

	part.Size =
		Vector3.one

	part.CFrame =
		root.CFrame

	part.Parent =
		getFXFolder()

