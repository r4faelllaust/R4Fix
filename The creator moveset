local function createRunTool()
	local name = "Creator Run"

	destroyTool(name)

	local backpack =
		LocalPlayer:WaitForChild("Backpack")

	local tool =
		Instance.new("Tool")

	tool.Name = name
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "CREATOR RUN"

	tool.Parent = backpack

	local active = false
	local connection: RBXScriptConnection? = nil
	local track: AnimationTrack? = nil

	local function stop()
		active = false

		if connection then
			pcall(function()
				connection:Disconnect()
			end)

			connection = nil
		end

		if track then
			pcall(function()
				track:Stop(0.08)
			end)

			track = nil
		end
	end

	tool.Equipped:Connect(function()

		if active then
			return
		end

		local character, humanoid, root =
			getCharacter()

		if not character
			or not humanoid
			or not root
		then
			return
		end

		active = true

		track =
			playAnimation(
				humanoid,
				ANIM.Run,
				Enum.AnimationPriority.Movement,
				1.12,
				true
			)

		connection =
			RunService.RenderStepped:Connect(function()

				if not active
					or not root.Parent
					or humanoid.Health <= 0
				then
					stop()
					return
				end

				if humanoid.MoveDirection.Magnitude > 0.05 then

					local direction =
						root.CFrame.LookVector

					root.AssemblyLinearVelocity =
						Vector3.new(
							direction.X
								* CFG.RunSpeed,

							root.AssemblyLinearVelocity.Y,

							direction.Z
								* CFG.RunSpeed
						)
				end
			end)
	end)

	tool.Unequipped:Connect(stop)
end

