-- ============================================================
-- VFX CLEANUP
-- ============================================================

local function tweenDestroy(
	object,
	info,
	properties
)
	if not object then
		return
	end

	local success, tween =
		pcall(function()
			return TweenService:Create(
				object,
				info,
				properties
			)
		end)

	if success and tween then
		tween:Play()
	end

	Debris:AddItem(
		object,
		info.Time + 0.2
	)
end

