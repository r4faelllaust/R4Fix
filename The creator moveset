local function isAliveModel(model: Model)
	local humanoid =
		model:FindFirstChildOfClass("Humanoid")

	local root =
		model:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return true
end

local function isValidTarget(
	model: Model,
	ownCharacter: Model
)
	if model == ownCharacter then
		return false
	end

	if not isAliveModel(model) then
		return false
	end

	local humanoid =
		model:FindFirstChildOfClass("Humanoid")

	local root =
		model:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return false
	end

	if root:IsA("BasePart") == false then
		return false
	end

	return true
end

-- ================================================================
-- TARGET SEARCH
-- ================================================================
-- FIX:
-- The old version only checked direct children of Workspace.Live.
-- That can miss valid characters depending on how TSB structures
-- them.
--
-- This version:
--   1. Checks Live descendants.
--   2. Checks Workspace descendants.
--   3. De-duplicates models.
--   4. Rejects our own character.
--   5. Rejects dead characters.
--   6. Uses the closest HumanoidRootPart.
-- ================================================================

local function collectTargetModels()
	local models = {}
	local seen = {}

	local function consider(object: Instance)
		if not object:IsA("Model") then
			return
		end

		if seen[object] then
			return
		end

		seen[object] = true

		local ownCharacter =
			LocalPlayer.Character

		if not ownCharacter then
			return
		end

		if isValidTarget(
			object,
			ownCharacter
		) then
			table.insert(models, object)
		end
	end

	local live =
		Workspace:FindFirstChild("Live")

	if live then
		for _, object in ipairs(live:GetDescendants()) do
			consider(object)
		end
	end

	-- Fallback / secondary search.
	--
	-- We intentionally only consider models that actually have
	-- Humanoid + HumanoidRootPart, so normal map models are ignored.
	for _, object in ipairs(Workspace:GetDescendants()) do
		if object:IsA("Model") then
			consider(object)
		end
	end

	return models
end

local function findClosestTarget(origin: Vector3)
	local ownCharacter =
		LocalPlayer.Character

	if not ownCharacter then
		return nil
	end

	local best: Model? = nil
	local bestDistance =
		CFG.TargetRange

	for _, model in ipairs(
		collectTargetModels()
	) do

		local root =
			model:FindFirstChild(
				"HumanoidRootPart"
			)

		if root
			and root:IsA("BasePart")
		then

			local distance =
				(root.Position - origin).Magnitude

			if distance <= bestDistance then
				bestDistance = distance
				best = model
			end
		end
	end

	return best
end

-- ================================================================
-- M1 TELEPORT
-- ================================================================
-- THIS IS THE MAIN FIX.
--
-- The old M1 did:
--
--     play animation
--     teleport
--
-- That creates the visual impression that the TP is late.
--
-- New order:
--
--     find target
--     calculate behind position
--     teleport
--     face target
--     correct position
--     THEN play attack animation
--
-- This also handles target movement during the tiny teleport window.
-- ================================================================

local function teleportBehindTarget(
	target: Model,
	distance: number?
)
	local character, humanoid, root =
		getCharacter()

	if not character
		or not humanoid
		or not root
	then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if not target
		or not target.Parent
	then
		return false
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot
		or not targetRoot:IsA("BasePart")
	then
		return false
	end

	local targetPosition =
		targetRoot.Position

	local targetLook =
		targetRoot.CFrame.LookVector

	-- Force the TP to stay horizontal.
	-- This avoids the player being launched above/below
	-- the target if the target is airborne.
	local horizontalLook =
		Vector3.new(
			targetLook.X,
			0,
			targetLook.Z
		)

	if horizontalLook.Magnitude < 0.001 then
		horizontalLook =
			Vector3.new(
				0,
				0,
				-1
			)
	else
		horizontalLook =
			horizontalLook.Unit
	end

	local behindDistance =
		distance or CFG.M1BehindDistance

	local behindPosition =
		targetPosition
		- horizontalLook * behindDistance

	behindPosition = Vector3.new(
		behindPosition.X,
		targetPosition.Y + 0.05,
		behindPosition.Z
	)

	-- Kill existing momentum before teleport.
	root.AssemblyLinearVelocity =
		Vector3.zero

	root.AssemblyAngularVelocity =
		Vector3.zero

	-- Teleport and face the enemy.
	root.CFrame =
		CFrame.lookAt(
			behindPosition,
			targetPosition
		)

	-- Second correction.
	--
	-- This makes M1 much more reliable against targets that
	-- move during the same frame.
	RunService.Heartbeat:Wait()

	if not root.Parent
		or humanoid.Health <= 0
	then
		return false
	end

	if not target.Parent then
		return true
	end

	local newTargetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not newTargetRoot
		or not newTargetRoot:IsA("BasePart")
	then
		return true
	end

	local newTargetPosition =
		newTargetRoot.Position

	local newLook =
		newTargetRoot.CFrame.LookVector

	local newHorizontalLook =
		Vector3.new(
			newLook.X,
			0,
			newLook.Z
		)

	if newHorizontalLook.Magnitude < 0.001 then
		newHorizontalLook =
			horizontalLook
	else
		newHorizontalLook =
			newHorizontalLook.Unit
	end

	local correctedPosition =
		newTargetPosition
		- newHorizontalLook
			* CFG.M1CorrectionDistance

	correctedPosition =
		Vector3.new(
			correctedPosition.X,
			newTargetPosition.Y + 0.05,
			correctedPosition.Z
		)

	-- Only correct if the target did not suddenly move
	-- an absurd distance away.
	if (
		root.Position
		- correctedPosition
	).Magnitude <= CFG.M1MaxCorrectionDelta
	then

		root.CFrame =
			CFrame.lookAt(
				correctedPosition,
				newTargetPosition
			)

		root.AssemblyLinearVelocity =
			Vector3.zero

		root.AssemblyAngularVelocity =
			Vector3.zero
	end

	return true
end

local function voidTeleportBehind(target: Model)
	return teleportBehindTarget(
		target,
		CFG.M1BehindDistance
	)
end

