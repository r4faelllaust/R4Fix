local function disconnectAll(list)
	for i = #list, 1, -1 do
		local connection = list[i]

		pcall(function()
			connection:Disconnect()
		end)

		list[i] = nil
	end
end

local function addConnection(connection)
	if connection then
		table.insert(S.Connections, connection)
	end

	return connection
end

local function addCharacterConnection(connection)
	if connection then
		table.insert(S.CharacterConnections, connection)
	end

	return connection
end

local function cleanupTracks()
	for i = #S.Tracks, 1, -1 do
		local track = S.Tracks[i]

		pcall(function()
			if track.IsPlaying then
				track:Stop(0.05)
			end

			track:Destroy()
		end)

		S.Tracks[i] = nil
	end
end

local function cleanupCharacter()
	disconnectAll(S.CharacterConnections)
	cleanupTracks()

	S.Busy = {}

	local folder = workspace:FindFirstChild("R4Fix_TheCreator_VFX")

	if folder then
		pcall(function()
			folder:Destroy()
		end)
	end

	local character = LP.Character

	if character then
		local highlight =
			character:FindFirstChild("R4FixCreatorHighlight")

		if highlight then
			pcall(function()
				highlight:Destroy()
			end)
		end

		for _, object in ipairs(character:GetDescendants()) do
			if object.Name == "R4FixCreatorAura" then
				pcall(function()
					object:Destroy()
				end)
			end
		end
	end
end

-- ============================================================
-- CHARACTER
-- ============================================================

local function getCharacter()
	local character = LP.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return nil, nil, nil
	end

	if humanoid.Health <= 0 then
		return nil, nil, nil
	end

	return character, humanoid, root
end

-- ============================================================
-- ANIMATION
-- ============================================================

local function getAnimator(humanoid)
	local animator =
		humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

local function playAnimation(
	humanoid,
	id,
	speed,
	fadeTime
)
	if not humanoid then
		return nil
	end

	if humanoid.Health <= 0 then
		return nil
	end

	if not id or id == "" then
		return nil
	end

	local cleanID = tostring(id)

	if not cleanID:find("rbxassetid://", 1, true) then
		cleanID = "rbxassetid://" .. cleanID
	end

	local animation = Instance.new("Animation")

	animation.AnimationId = cleanID

	local animator = getAnimator(humanoid)

	local success, track =
		pcall(function()
			return animator:LoadAnimation(animation)
		end)

	animation:Destroy()

	if not success or not track then
		warn(
			"[THE CREATOR] Animation failed: "
				.. cleanID
		)

		return nil
	end

	track.Priority =
		Enum.AnimationPriority.Action4

	track.Looped = false

	table.insert(S.Tracks, track)

	pcall(function()
		track:Play(
			fadeTime or 0.04,
			1,
			speed or 1
		)
	end)

	return track
end

