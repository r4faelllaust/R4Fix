local function allowedFX(
	key: string,
	cooldown: number?
): boolean
	local now =
		os.clock()

	local previous =
		S.LastFX[key] or 0

	if now - previous <
		(cooldown or CFG.VFXCooldown)
	then
		return false
	end

	S.LastFX[key] =
		now

	return true
end

