		NumberSequenceKeypoint.new(0, 0.8),
		NumberSequenceKeypoint.new(0.45, 1.5),
		NumberSequenceKeypoint.new(1, 0),
	})

	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(1, 1),
	})

	emitter.Parent = attachment

	pcall(function()
		emitter:Emit(amount)
	end)

	Debris:AddItem(attachment, 1)
end

-- ============================================================
-- PHANTOM ENGINE
-- ============================================================

local function phantomEngine(
	duration: number,
	speed: number,
	token: number
)
	local character, humanoid, hrp = getCharacter()

	if not character or not humanoid or not hrp then
		return false
	end

	if token ~= S.Token or humanoid.Health <= 0 then
		return false
	end

	local velocity = Instance.new("BodyVelocity")
	velocity.Name = "Creator_PhantomEngine"
	velocity.MaxForce = Vector3.new(5000000, 0, 5000000)
	velocity.P = 75000
	velocity.Parent = hrp

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-1.1, 0, 0)
	a0.Parent = hrp

	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(1.1, 0, 0)
	a1.Parent = hrp

	local trail = Instance.new("Trail")
	trail.Name = "CreatorPhantomTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.3
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(
		GREEN_BRIGHT,
		GREEN_DARK
	)
	trail.Transparency = NumberSequence.new(0.05, 1)
	trail.Parent = hrp

	burst(hrp.CFrame, 7, GREEN_DARK, 0.18, "phantom_start")
	ring(hrp.CFrame, 2, 17, GREEN_BRIGHT, 0.3, "phantom_ring")

	local start = os.clock()

	while os.clock() - start < duration do
		if token ~= S.Token then
			break
		end

		if not hrp.Parent or humanoid.Health <= 0 then
			break
		end

		local direction = hrp.CFrame.LookVector

		velocity.Velocity = Vector3.new(
			direction.X * speed,
			0,
			direction.Z * speed
		)

		if allowed("phantom_tick", 0.08) then
			particles(hrp, 5, GREEN_BRIGHT, nil)
		end

		RunService.Heartbeat:Wait()
	end

	pcall(function()
		velocity:Destroy()
	end)

	pcall(function()
		trail:Destroy()
		a0:Destroy()
		a1:Destroy()
	end)

	if hrp.Parent then
		burst(hrp.CFrame, 9, GREEN_BRIGHT, 0.25, "phantom_end")
	end

	return true
end

-- ============================================================
-- TARGETING
-- ============================================================

local function isAlivePlayer(player: Player)
	if player == LocalPlayer then
		return false
	end

	local character = player.Character

	if not character then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")

	return humanoid ~= nil
		and hrp ~= nil
		and humanoid.Health > 0
end

local function getClosestPlayer(maxDistance: number?)
	local _, _, myHRP = getCharacter()

	if not myHRP then
		return nil, math.huge
	end

	local closestPlayer = nil
	local closestDistance = maxDistance or math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if isAlivePlayer(player) then
			local character = player.Character

			if character then
				local targetHRP = character:FindFirstChild("HumanoidRootPart")

				if targetHRP and targetHRP:IsA("BasePart") then
					local distance = (
						targetHRP.Position - myHRP.Position
					).Magnitude

					if distance < closestDistance then
						closestDistance = distance
						closestPlayer = player
					end
				end
			end
		end
	end

	return closestPlayer, closestDistance
end

-- ============================================================
-- BEHIND TARGET
-- ============================================================

local function teleportBehindPlayer(target: Player)
	local _, humanoid, hrp = getCharacter()

	if not humanoid or not hrp or humanoid.Health <= 0 then
		return false
	end

	if not target or not isAlivePlayer(target) then
		return false
	end

	local targetCharacter = target.Character

	if not targetCharacter then
		return false
	end

	local targetHRP = targetCharacter:FindFirstChild("HumanoidRootPart")

	if not targetHRP or not targetHRP:IsA("BasePart") then
		return false
	end

	local targetPosition =
		targetHRP.Position
		- targetHRP.CFrame.LookVector * CFG.M1_BEHIND_DISTANCE

	targetPosition += Vector3.new(
		0,
		CFG.M1_VERTICAL_OFFSET,
		0
	)

	local destination = CFrame.lookAt(
		targetPosition,
		targetHRP.Position
	)

	burst(hrp.CFrame, 5, GREEN_DARK, 0.12, "m1_depart")

	hrp.CFrame = destination
	hrp.AssemblyLinearVelocity = Vector3.zero

	burst(hrp.CFrame, 7, GREEN_BRIGHT, 0.16, "m1_arrive")
	particles(hrp, 14, GREEN_BRIGHT, "m1_particles")

	slash(
		hrp.CFrame * CFrame.Angles(0, math.rad(90), math.rad(25)),
		7,
		0.45,
		GREEN_BRIGHT
	)

	playSound(hrp, 0.8, 1.1)

	return true
end

-- ============================================================
-- M1 AUTO SNAP
-- ============================================================

local function creatorM1()
	local now = os.clock()

	if now - S.LastM1 < CFG.M1_COOLDOWN then
		return
	end

	S.LastM1 = now

	local target = getClosestPlayer(CFG.M1_TARGET_RANGE)

	-- This happens even if the original M1 hit absolutely nothing.
	if target then
		teleportBehindPlayer(target)
	end

	-- M1 builds ultimate.
	S.Ultimate = math.clamp(
		(S.Ultimate or 0) + CFG.ULT_GAIN_M1,
		0,
		CFG.ULT_MAX
	)

	-- M1 flash around the player.
	local _, _, hrp = getCharacter()

	if hrp then
		ring(
			hrp.CFrame,
			1.5,
			8,
			GREEN_BRIGHT,
			0.18,
			"m1_ring"
		)
	end
end

