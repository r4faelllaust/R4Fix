-- ============================================================
-- GLITCH SHARDS
-- ============================================================

local function glitchShards(
	position,
	count,
	radius
)
	local folder = getVFXFolder()

	for i = 1, count do
		local shard =
			Instance.new("Part")

		shard.Name =
			"Creator_GlitchShard"

		shard.Anchored = true

		shard.CanCollide = false
		shard.CanTouch = false
		shard.CanQuery = false

		shard.CastShadow = false

		shard.Material =
			Enum.Material.Neon

		local mode = i % 3

		if mode == 0 then
			shard.Color = BLACK
		elseif mode == 1 then
			shard.Color = GREEN
		else
			shard.Color = BRIGHT_GREEN
		end

		shard.Transparency = 0.1

		local angle =
			(i / count) *
			math.pi *
			2

		local distance =
			radius *
			(0.55 + math.random() * 0.8)

		local offset =
			Vector3.new(
				math.cos(angle) * distance,
				math.sin(angle * 3) *
					radius *
					0.6,
				math.sin(angle) * distance
			)

		shard.Size =
			Vector3.new(
				math.random(3, 10) / 10,
				math.random(5, 20) / 10,
				math.random(3, 10) / 10
			)

		shard.CFrame =
			CFrame.new(
				position + offset
			) *
			CFrame.Angles(
				math.random(),
				math.random(),
				math.random()
			)

		shard.Parent = folder

		local destination =
			shard.CFrame *
			CFrame.new(
				math.random(-10, 10),
				math.random(-7, 10),
				math.random(-10, 10)
			)

		tweenDestroy(
			shard,
			TweenInfo.new(
				0.35 +
					math.random() * 0.3,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out
			),
			{
				CFrame = destination,
				Transparency = 1,
			}
		)
	end
end

