-- ================================================================

local lastM1 =
	0

local m1Index =
	0

local function creatorM1()
	local now =
		os.clock()

	if now - lastM1
		< CFG.M1Cooldown
	then
		return
	end

	lastM1 =
		now

	local character, humanoid, root =
		getCharacter()

	if not character
		or not humanoid
		or not root
	then
		return
	end

	-- ============================================================
	-- FIND TARGET FIRST
	-- ============================================================

	local target =
		findClosestTarget(
			root.Position,
			CFG.M1TargetRange
		)

	m1Index += 1

	if m1Index > 4 then
		m1Index = 1
	end

	local animations = {
		ANIM.M1_1,
		ANIM.M1_2,
		ANIM.M1_3,
		ANIM.M1_4,
	}

	-- ============================================================
	-- TP BEFORE ANIMATION
	-- ============================================================

	if target then

		local targetRoot =
			target:FindFirstChild(
				"HumanoidRootPart"
			)

		if targetRoot
			and targetRoot:IsA("BasePart")
		then

			local targetPosition =
				targetRoot.Position

			local behindPosition =
				targetPosition
				- targetRoot.CFrame.LookVector
					* CFG.M1BehindDistance

			behindPosition +=
				Vector3.new(
					0,
					0.1,
					0
				)

			-- This is deliberately BEFORE
			-- the attack animation.
			root.CFrame =
				CFrame.lookAt(
					behindPosition,
					targetPosition
				)

			root.AssemblyLinearVelocity =
				Vector3.zero

			root.AssemblyAngularVelocity =
				Vector3.zero

			creatorBurst(
				root,
				4.5,
				0.09
			)

			cloneResource(
				3,
				root,
				6,
				0.22
			)
		end
	end

	-- ============================================================
	-- ATTACK
	-- ============================================================

	playAnimation(
		humanoid,
		animations[m1Index],
		Enum.AnimationPriority.Action4,
		1.08,
		false,
		0.42
	)

	-- ============================================================
	-- HIT VFX
	-- ============================================================

	if target then

		local targetRoot =
			target:FindFirstChild(
				"HumanoidRootPart"
			)

		if targetRoot
			and targetRoot:IsA("BasePart")
		then

			local targetAttachment =
				targetRoot:FindFirstChild(
					"CreatorHitFX"
				)

			if not targetAttachment then

				targetAttachment =
					Instance.new(
						"Attachment"
					)

				targetAttachment.Name =
					"CreatorHitFX"

				targetAttachment.Parent =
					targetRoot
			end

			cloneResource(
				13,
				targetAttachment,
				8,
				0.28
			)

			creatorBurst(
				root,
				3.8,
				0.1
			)

			directionalSlash(
				root
			)

			playImpactSound(
				targetRoot,
				0.8,
				0.92
					+ math.random()
					* 0.12
			)
		end
	else
		directionalSlash(
			root
		)
	end
end

