-- ============================================================

local function voidExecution(
	target,
	distance,
	token
)
	if token ~= S.Token then
		return
	end

	local character, humanoid, hrp =
		getCharacter()

	if not character
		or not humanoid
		or not hrp
	then
		return
	end

	if not target
		or not isAliveCharacter(target)
	then
		return
	end

	local targetHRP =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetHRP then
		return
	end

	local targetHumanoid =
		target:FindFirstChildOfClass(
			"Humanoid"
		)

	if not targetHumanoid
		or targetHumanoid.Health <= 0
	then
		return
	end

	local targetPosition =
		targetHRP.Position

	local behind =
		targetPosition
		- targetHRP.CFrame.LookVector
		* (distance or 3.2)

	hrp.CFrame =
		CFrame.lookAt(
			behind,
			targetPosition
		)

	hrp.AssemblyLinearVelocity =
		Vector3.zero

	burst(
		hrp.CFrame,
		10,
		CREATOR_GREEN,
		0.25,
		"void_arrive"
	)

	ring(
		hrp.CFrame,
		3,
		30,
		GLITCH_GREEN,
		0.4,
		"void_ring"
	)

	randomResourceVFX(
		hrp,
		25
	)

	randomResourceVFX(
		targetHRP,
		20
	)

	glitchShards(
		targetHRP.CFrame,
		14
	)

	playSound(
		targetHRP,
		1.6,
		0.72
	)

	-- The actual server-side health state is deliberately
	-- untouched. This is a client-side execution sequence.
end

