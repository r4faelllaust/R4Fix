local function getVFXFolder()
	local folder =
		workspace:FindFirstChild("DarkGarou_VFX")

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "DarkGarou_VFX"
		folder.Parent = workspace
	end

	return folder
end

local function allowed(key: string, cooldown: number?)
	local now = os.clock()

	local previous =
		S.LastVFX[key] or 0

	local cd =
		cooldown or CFG.VFX_COOLDOWN

	if now - previous < cd then
		return false
	end

	S.LastVFX[key] = now

	return true
end

-- ============================================================
-- SPHERE BURST
-- ============================================================

local function burst(
	cf: CFrame,
	size: number,
	color: Color3?,
	duration: number?,
	key: string?
)
	if key and not allowed(key) then
		return
	end

	local part = Instance.new("Part")

	part.Name = "DarkGarouBurst"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false

	part.Shape =
		Enum.PartType.Ball

	part.Material =
		Enum.Material.Neon

	part.Color =
		color or BRIGHT_PURPLE

	part.Transparency = 0.1
	part.Size = Vector3.one
	part.CFrame = cf
	part.Parent = getVFXFolder()

	local tween = TweenService:Create(
		part,
		TweenInfo.new(
			duration or 0.3,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size =
				Vector3.new(
					size,
					size,
					size
				),

			Transparency = 1,
		}
	)

	tween:Play()

	Debris:AddItem(
		part,
		(duration or 0.3) + 0.1
	)
end

