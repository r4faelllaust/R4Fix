-- ============================================================
-- GLITCH SHARDS
-- ============================================================

local function glitchShards(
	cframe: CFrame,
	count: number,
	radius: number,
	key: string?
)
	if key and not allowed(key) then
		return
	end

	local folder = getVFXFolder()

	for i = 1, count do
		local shard = Instance.new("Part")

		shard.Name = "CreatorGlitch"

		shard.Anchored = true
		shard.CanCollide = false
		shard.CanTouch = false
		shard.CanQuery = false
		shard.CastShadow = false

		shard.Material = Enum.Material.Neon

		if i % 4 == 0 then
			shard.Color = TOXIC_GREEN
		elseif i % 2 == 0 then
			shard.Color = GREEN
		else
			shard.Color = BLACK
		end

		shard.Transparency = 0.12

		local angle =
			(i / count) *
			math.pi *
			2

		local position =
			cframe.Position +
			Vector3.new(
				math.cos(angle) * radius,
				math.sin(angle * 3) *
					radius *
					0.5,
				math.sin(angle) * radius
			)

		shard.Size =
			Vector3.new(
				math.random(2, 8) / 10,
				math.random(5, 18) / 10,
				math.random(2, 8) / 10
			)

		shard.CFrame =
			CFrame.new(position) *
			CFrame.Angles(
				math.random(),
				math.random(),
				math.random()
			)

		shard.Parent = folder

		TweenService:Create(
			shard,
			TweenInfo.new(
				0.3 + math.random() * 0.25,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out
			),
			{
				CFrame =
					shard.CFrame *
					CFrame.new(
						math.random(-8, 8),
						math.random(-8, 8),
						math.random(-8, 8)
					),

				Transparency = 1,
			}
		):Play()

		Debris:AddItem(
			shard,
			0.75
		)
	end
end

