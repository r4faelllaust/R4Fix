-- ============================================================

local function createAfterimage(character)
	if not character then
		return
	end

	local clone

	local ok = pcall(function()
		clone = character:Clone()
	end)

	if not ok or not clone then
		return
	end

	for _, object in ipairs(
		clone:GetDescendants()
	) do
		if object:IsA("Script")
			or object:IsA("LocalScript")
			or object:IsA("ModuleScript")
		then
			object:Destroy()

		elseif object:IsA("BasePart") then
			object.Anchored = true
			object.CanCollide = false
			object.CanTouch = false
			object.CanQuery = false
			object.Material = Enum.Material.Neon
			object.Color = DARK_GREEN
			object.Transparency = 0.55

		elseif object:IsA("Decal") then
			object.Transparency = 1
		end
	end

	clone.Name = "CreatorAfterimage"
	clone.Parent = getVFXFolder()

	task.delay(
		CFG.AfterimageLifetime,
		function()
			if clone.Parent then
				for _, object in ipairs(
					clone:GetDescendants()
				) do
					if object:IsA("BasePart") then
						TweenService:Create(
							object,
							TweenInfo.new(0.25),
							{
								Transparency = 1
							}
						):Play()
					end
				end

				Debris:AddItem(
					clone,
					0.3
				)
			end
		end
	)
end

