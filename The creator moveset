-- ================================================================

local function voidSequence(
	target: Model,
	token: number
)
	local character, humanoid, root =
		getCharacter()

	if not character
		or not humanoid
		or not root
	then
		return
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot
		or not targetRoot:IsA("BasePart")
	then
		return
	end

	if token ~= S.Token then
		return
	end

	local original =
		root.CFrame

	-- First position.
	teleportBehindTarget(
		target,
		CFG.M1BehindDistance
	)

	if not root.Parent then
		return
	end

	creatorBurst(
		root,
		7,
		0.13
	)

	creatorRing(
		root,
		2,
		12,
		0.2
	)

	cloneResource(
		3,
		root,
		6,
		0.3
	)

	cloneResource(
		6,
		root,
		6,
		0.28
	)

	playImpactSound(
		root,
		1.2,
		0.78
	)

	local phasePosition =
		targetRoot.Position
		- targetRoot.CFrame.LookVector
		* 2.4

	root.CFrame =
		CFrame.lookAt(
			phasePosition,
			targetRoot.Position
		)

	creatorBurst(
		root,
		5.5,
		0.1
	)

	directionalSlash(
		root
	)

	task.wait(0.08)

	if token ~= S.Token then
		return
	end

	local forward =
		targetRoot.CFrame.LookVector

	local destination =
		targetRoot.Position
		+ forward
		* CFG.VoidDistance

	destination =
		Vector3.new(
			destination.X,
			targetRoot.Position.Y,
			destination.Z
		)

	root.CFrame =
		CFrame.lookAt(
			destination,
			destination + forward
		)

	root.AssemblyLinearVelocity =
		Vector3.zero

	creatorBurst(
		root,
		11,
		0.25
	)

	creatorRing(
		root,
		4,
		30,
		0.32
	)

	cloneResource(
		5,
		root,
		8,
		0.34
	)

	cloneResource(
		10,
		root,
		8,
		0.3
	)

	playImpactSound(
		root,
		1.65,
		0.68
	)

	task.wait(
		CFG.VoidDuration
	)

	if token ~= S.Token then
		return
	end

	if root.Parent
		and humanoid.Health > 0
	then

		root.CFrame =
			original

		root.AssemblyLinearVelocity =
			Vector3.zero

		creatorBurst(
			root,
			8,
			0.18
		)

		creatorRing(
			root,
			3,
			20,
			0.25
		)

		cloneResource(
			4,
			root,
			7,
			0.3
		)
	end
end

