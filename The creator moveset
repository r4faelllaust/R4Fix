	if gradient then
		gradient.Color =
			sequence

		gradient.Rotation = 0
	else
		if fill:IsA("Frame") then
			fill.BackgroundColor3 =
				GREEN
		elseif fill:IsA("ImageLabel")
			or fill:IsA("ImageButton")
		then
			fill.ImageColor3 =
				GREEN
		end
	end

	-- ========================================================
	-- REAL GLOW
	-- ========================================================

	local glow =
		health:FindFirstChild(
			"Glow"
		)

	if glow
		and (
			glow:IsA("ImageLabel")
			or glow:IsA("ImageButton")
		)
	then
		glow.ImageColor3 =
			BRIGHT_GREEN

		glow.ImageTransparency =
			0.18
	end
end

-- ============================================================
-- GLITCH TEXT LOOP
-- ============================================================

local GLITCH_TEXT = {
	"// T H E  C R E A T O R //",
	"// TH3 CR3AT0R //",
	"// C R E A T O R //",
	"// 0X000000 //",
	"// CREATE // DESTROY //",
	"// SYSTEM OVERRIDE //",
	"// █R█E█A█T█E█ //",
	"// THE CREATOR //",
}

local function startGlitchText()
	task.spawn(function()
		while LocalPlayer.Parent do
			local magicHealth =
				findUltimateBar()

			if magicHealth then
				for _, object in ipairs(
					magicHealth:GetDescendants()
				) do
					if object:IsA("TextLabel") then
						local name =
							string.lower(
								object.Name
							)

						if name == "textlabel"
							or name == "text"
							or name == "ulttext"
						then
							object.Text =
								GLITCH_TEXT[
									math.random(
										1,
										#GLITCH_TEXT
									)
								]

							object.TextColor3 =
								math.random() > 0.2
								and BRIGHT_GREEN
								or ACID_GREEN

							object.TextStrokeColor3 =
								BLACK
						end
					end
				end
			end

			task.wait(
				math.random(7, 18) / 100
			)
		end
	end)
end

