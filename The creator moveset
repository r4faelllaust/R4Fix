local function disconnectList(list)
	for i = #list, 1, -1 do
		local connection = list[i]

		pcall(function()
			connection:Disconnect()
		end)

		list[i] = nil
	end
end

local function addCharacterConnection(connection)
	if connection then
		table.insert(S.CharacterConnections, connection)
	end

	return connection
end

local function cleanupTracks()
	for i = #S.Tracks, 1, -1 do
		local track = S.Tracks[i]

		pcall(function()
			if track.IsPlaying then
				track:Stop(0.05)
			end
		end)

		pcall(function()
			track:Destroy()
		end)

		S.Tracks[i] = nil
	end
end

local function cleanupCharacter()
	disconnectList(S.CharacterConnections)
	cleanupTracks()

	S.Busy = {}
	table.clear(S.LastFX)

	local old = Workspace:FindFirstChild("R4Fix_CreatorFX")

	if old then
		pcall(function()
			old:Destroy()
		end)
	end

	local oldText = Workspace:FindFirstChild("R4Fix_CreatorText")

	if oldText then
		pcall(function()
			oldText:Destroy()
		end)
	end
end

