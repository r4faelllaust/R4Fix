-- ============================================================
-- PLAYER TARGETING
-- ============================================================

local function getNearestPlayer(
	maxDistance
)
	local _, _, myHRP =
		getCharacter()

	if not myHRP then
		return nil, nil, nil
	end

	local closestPlayer = nil
	local closestCharacter = nil
	local closestHRP = nil

	local closestDistance =
		maxDistance or CFG.MaxTargetDistance

	for _, player in ipairs(
		Players:GetPlayers()
	) do
		if player ~= LocalPlayer then
			local character =
				player.Character

			if character then
				local humanoid =
					character:FindFirstChildOfClass(
						"Humanoid"
					)

				local hrp =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if humanoid
					and hrp
					and humanoid.Health > 0
				then
					local distance =
						(
							hrp.Position
							- myHRP.Position
						).Magnitude

					if distance <
						closestDistance
					then
						closestDistance =
							distance

						closestPlayer =
							player

						closestCharacter =
							character

						closestHRP =
							hrp
					end
				end
			end
		end
	end

	return closestPlayer,
		closestCharacter,
		closestHRP
end

-- ============================================================
-- TELEPORT BEHIND
-- ============================================================

local function teleportBehindTarget(
	targetHRP,
	distance
)
	local _, humanoid, myHRP =
		getCharacter()

	if not humanoid
		or not myHRP
		or not targetHRP
		or not targetHRP.Parent
	then
		return false
	end

	local targetPosition =
		targetHRP.Position

	local behindPosition =
		targetPosition
		- targetHRP.CFrame.LookVector
		* (distance or CFG.M1BehindDistance)

	local destination =
		CFrame.lookAt(
			behindPosition,
			targetPosition
		)

	myHRP.CFrame = destination

	myHRP.AssemblyLinearVelocity =
		Vector3.zero

	return true
end

-- ============================================================
-- VOID TECHNIQUE
-- ============================================================

local function voidTechnique(
	targetHRP,
	token
)
	if not targetHRP
		or not targetHRP.Parent
	then
		return
	end

	local character, humanoid, myHRP =
		getCharacter()

	if not character
		or not humanoid
		or not myHRP
	then
		return
	end

	if token ~= S.Token then
		return
	end

	local originalSelf =
		myHRP.CFrame

	local originalTarget =
		targetHRP.CFrame

	-- Local visual void displacement.
	-- The underlying attack still belongs to TSB's own combat
	-- system, rather than inventing a nonexistent damage remote.

	local voidTarget =
		originalTarget
		+ Vector3.new(
			0,
			-CFG.VoidDistance,
			0
		)

	createSphere(
		originalTarget,
		4,
		18,
		BLACK,
		0.18,
		0.05
	)

	createRing(
		originalTarget,
		3,
		36,
		BRIGHT_GREEN,
		0.4
	)

	glitchBurst(
		originalTarget,
		2
	)

	playImpact(
		myHRP,
		1.8,
		0.62
	)

	pcall(function()
		targetHRP.CFrame = voidTarget
	end)

	task.delay(
		CFG.VoidDuration,
		function()
			if token ~= S.Token then
				return
			end

			if myHRP.Parent
				and humanoid.Health > 0
			then
				createSphere(
					myHRP.CFrame,
					4,
					17,
					BRIGHT_GREEN,
					0.25,
					0
				)

				createRing(
					myHRP.CFrame,
					4,
					35,
					GREEN,
					0.4
				)

				myHRP.CFrame =
					originalSelf

				myHRP.AssemblyLinearVelocity =
					Vector3.zero
			end

			-- Restore local target view position.
			if targetHRP.Parent then
				pcall(function()
					targetHRP.CFrame =
						originalTarget
				end)
			end
		end
	)
end

-- ============================================================
-- M1 HANDLER
-- ============================================================

local function creatorM1(token)
	if token ~= S.Token then
		return
	end

	local now = os.clock()

	if now -
		(S.LastM1.Global or 0)
		< CFG.M1Cooldown
	then
		return
	end

	S.LastM1.Global = now

	local character, humanoid, hrp =
		getCharacter()

	if not character
		or not humanoid
		or not hrp
		or humanoid.Health <= 0
	then
		return
	end

	local targetPlayer,
		targetCharacter,
		targetHRP =
		getNearestPlayer()

	if not targetPlayer
		or not targetCharacter
		or not targetHRP
	then
		-- Even when no target exists, give the M1 a Creator
		-- corruption burst rather than doing nothing.
		glitchBurst(
			hrp.CFrame,
			0.8
		)

		return
	end

	S.Target = targetPlayer

	teleportBehindTarget(
		targetHRP,
		CFG.M1BehindDistance
	)

	createSphere(
		hrp.CFrame,
		2,
		8,
		BLACK,
		0.14,
		0
	)

	createRing(
		hrp.CFrame,
		1,
		12,
		BRIGHT_GREEN,
		0.18
	)

	createParticles(
		hrp,
		18,
		BRIGHT_GREEN,
		7
	)

	-- Do NOT cancel the game's underlying M1 attack.
	-- This is important because the actual game's combat logic
	-- should remain responsible for the hit.
	--
	-- We layer the Creator animation over it.

	local index =
		((S.LastM1.Index or 0) % #CREATOR_M1) + 1

	S.LastM1.Index = index

	playCreatorAnimation(
		humanoid,
		CREATOR_M1[index],
		Enum.AnimationPriority.Action4,
		1.08,
		0.32
	)

	glitchBurst(
		targetHRP.CFrame,
		0.65
	)
end

