-- ============================================================
-- VFX: CORRUPTED CREATOR
-- ============================================================

local function creatorCorruption(
	character,
	duration
)
	if not character then
		return
	end

	local highlight = Instance.new("Highlight")

	highlight.Name = "CreatorCorruption"
	highlight.FillColor = PURPLE
	highlight.OutlineColor = GLITCH_GREEN

	highlight.FillTransparency = 0.86
	highlight.OutlineTransparency = 0.1

	highlight.DepthMode =
		Enum.HighlightDepthMode.Occluded

	highlight.Parent = character

	local start = os.clock()

	task.spawn(function()
		while
			highlight.Parent
			and os.clock() - start < duration
		do
			local randomColor = math.random(1, 4)

			if randomColor == 1 then
				highlight.OutlineColor = GLITCH_GREEN
				highlight.FillColor = PURPLE

			elseif randomColor == 2 then
				highlight.OutlineColor = BRIGHT_BLUE
				highlight.FillColor = VOID

			elseif randomColor == 3 then
				highlight.OutlineColor = BRIGHT_PURPLE
				highlight.FillColor = BLACK

			else
				highlight.OutlineColor = WHITE
				highlight.FillColor = BLUE
			end

			task.wait(
				math.random(3, 8) / 100
			)
		end

		pcall(function()
			highlight:Destroy()
		end)
	end)
end

