-- ============================================================
-- INPUT
-- ============================================================

local function setupInput()
	table.insert(
		S.Connections,
		UserInputService.InputBegan:Connect(
			function(
				input,
				processed
			)
				if processed then
					return
				end

				if input.UserInputType ==
					Enum.UserInputType.MouseButton1
				then
					creatorM1()

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.One
				then
					move1()

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.Two
				then
					move2()

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.Three
				then
					move3()

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.Four
				then
					move4()

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.G
				then
					ultimateMove(1)

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.H
				then
					ultimateMove(2)

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.J
				then
					ultimateMove(3)

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.K
				then
					ultimateMove(4)

					return
				end
			end
		)
	)

	table.insert(
		S.Connections,
		UserInputService.TouchTap:Connect(
			function(
				_,
				processed
			)
				if processed then
					return
				end

				-- Touching empty screen performs M1.
				creatorM1()
			end
		)
	)
end

-- ============================================================
-- CHARACTER SETUP
-- ============================================================

local function setupCharacter(
	character: Model
)
	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid or
		not root
	then
		return
	end

	Lighting.ClockTime =
		CFG.NIGHT_TIME

	setupAura(
		character
	)

	spawnEffect(
		character,
		root
	)

	pcall(function()
		humanoid.WalkSpeed =
			CFG.RUN_SPEED
	end)

	table.insert(
		S.CharacterConnections,
		humanoid.Died:Connect(
			function()
				S.Busy = {}

				cleanupAnimations()
			end
		)
	)

	task.spawn(function()
		task.wait(0.2)

		if token ~= S.Token then
			return
		end

		createMobileGui()

		for _ = 1, 20 do
			if token ~= S.Token then
				return
			end

			pcall(function()
				fixCharacterTab()
				refreshHotbar()
				styleUltimateBar()
			end)

			task.wait(0.15)
		end
	end)
end

-- ============================================================
-- UI LOOP
-- ============================================================

local function startUIUpdater()
	task.spawn(function()
		while LocalPlayer.Parent do
			pcall(function()
				fixCharacterTab()
				refreshHotbar()
				styleUltimateBar()
			end)

			task.wait(0.35)
		end
	end)
end

-- ============================================================
-- START / RESTART
-- ============================================================

if S.Started then
	-- Prevent duplicate execution if the script is run again.
	S.Token += 1

	disconnectList(
		S.Connections
	)

	disconnectList(
		S.CharacterConnections
	)

	cleanupAnimations()
	destroyVFXFolder()

	if S.MobileGui then
		pcall(function()
			S.MobileGui:Destroy()
		end)

		S.MobileGui = nil
	end

	S.Started = false
end

S.Started = true

