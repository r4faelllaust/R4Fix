local function setupCharacter(
	character: Model
)
	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not root
		or not root:IsA("BasePart")
	then
		return
	end

	-- ============================================================
	-- CREATOR SPAWN
	-- ============================================================

	pcall(function()
		creatorSpawn(
			character,
			root
		)
	end)

	-- ============================================================
	-- GREEN AURA
	-- ============================================================

	pcall(function()
		creatorAura(
			character
		)
	end)

	-- ============================================================
	-- IDLE
	-- ============================================================

	pcall(function()
		startCreatorIdle(
			root,
			humanoid
		)
	end)

	-- ============================================================
	-- MOVE HANDLER
	-- ============================================================

	pcall(function()
		setupMoveHandler(
			character,
			humanoid,
			root,
			token
		)
	end)

	-- ============================================================
	-- UI PASSES
	-- ============================================================

	task.spawn(function()

		for _ = 1, 30 do

			if token ~= S.Token then
				return
			end

			pcall(function()

				fixCreatorSelection()

				styleUltimateBar()

				for i = 1, 4 do

					styleMoveSlot(
						i
					)
				end
			end)

			task.wait(
				0.12
			)
		end
	end)

	-- ============================================================
	-- TOOLS
	-- ============================================================

	task.delay(
		0.4,
		function()

			if token ~= S.Token then
				return
			end

			pcall(
				setupTools
			)
		end
	)

	-- ============================================================
	-- DEATH
	-- ============================================================

	addCharacterConnection(
		humanoid.Died:Connect(
			function()

				S.Busy =
					{}

				cleanupTracks()

				pcall(function()
					creatorHeadText(
						"CREATOR CONNECTION LOST"
					)
				end)
			end
		)
	)

	-- ============================================================
	-- CHARACTER REMOVAL
	-- ============================================================

	addCharacterConnection(
		character.AncestryChanged:Connect(
			function(
				_,
				parent
			)

				if not parent then
					S.Token += 1
				end
			end
		)
	)
end

