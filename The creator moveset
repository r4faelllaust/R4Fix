local function fixCharacterTab()
	local playerGui =
		LocalPlayer:FindFirstChildOfClass(
			"PlayerGui"
		)

	if not playerGui then
		return
	end

	for _, object in ipairs(
		playerGui:GetDescendants()
	) do
		if object:IsA("TextLabel") then
			local text = object.Text

			if text == "Garou"
				or text == "Hero Hunter"
				or text == "Dark Garou"
				or text == "The Creator"
			then
				object.Text =
					MOVESET_NAME

				local parent =
					object.Parent

				if parent then
					for _, imageObject in ipairs(
						parent:GetDescendants()
					) do
						if imageObject:IsA("ImageLabel")
							or imageObject:IsA("ImageButton")
						then
							local imageName =
								string.lower(
									imageObject.Name
								)

							if string.find(
								imageName,
								"image"
							)
							or string.find(
								imageName,
								"icon"
							)
							then
								imageObject.Image =
									DECAL_THUMB
							end
						end
					end
				end
			end
		end
	end
end

