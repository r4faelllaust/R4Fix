local function allowedVFX(key, cooldown)
	local now = os.clock()

	local previous =
		S.LastVFX[key] or 0

	if now - previous <
		(cooldown or CFG.VFXCooldown)
	then
		return false
	end

	S.LastVFX[key] = now

	return true
end

