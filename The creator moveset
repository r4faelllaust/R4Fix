-- ============================================================

local movementTrack = nil

local function stopMovementTrack()
	if movementTrack then

		pcall(function()
			movementTrack:Stop(0.1)
			movementTrack:Destroy()
		end)

		movementTrack = nil
	end
end

local function setupMovementAnimations(
	character,
	humanoid,
	root,
	token
)

	addCharacterConnection(
		humanoid.Running:Connect(
			function(speed)

				if token ~= S.Token then
					return
				end

				if speed <= 1 then
					stopMovementTrack()
					return
				end

				if speed >= 55 then

					if not movementTrack
						or not movementTrack.IsPlaying
					then

						stopMovementTrack()

						movementTrack =
							playCreatorAnimation(
								humanoid,
								DASH_ANIMATION,
								Enum.AnimationPriority.Movement,
								1,
								true
							)
					end

				else

					if not movementTrack
						or not movementTrack.IsPlaying
					then

						stopMovementTrack()

						movementTrack =
							playCreatorAnimation(
								humanoid,
								WALK_ANIMATION,
								Enum.AnimationPriority.Movement,
								1,
								true
							)
					end
				end
			end
		)
	)

end

-- ============================================================
-- ANIMATION TRIGGER HANDLER
-- ============================================================

local function setupAnimationTriggers(
	character,
	humanoid,
	root,
	token
)

	addCharacterConnection(
		humanoid.AnimationPlayed:Connect(
			function(track)

				if token ~= S.Token then
					return
				end

				if not track.Animation then
					return
				end

				local id =
					track.Animation.AnimationId

				-- ------------------------------------------------
				-- M1
				-- ------------------------------------------------

				for _, m1Id in ipairs(
					M1_ANIMATIONS
				) do

					if id == m1Id then
						performCreatorM1()
						return
					end
				end

				-- ------------------------------------------------
				-- Move 1
				-- ------------------------------------------------

				if id
					== "rbxassetid://18716871856"
				then

					pcall(function()
						track:Stop()
					end)

					move1(token)
					return
				end

				-- ------------------------------------------------
				-- Move 2
				-- ------------------------------------------------

				if id
					== "rbxassetid://15145462680"
				then

					pcall(function()
						track:Stop()
					end)

					move2(token)
					return
				end

				-- ------------------------------------------------
				-- Move 3
				-- ------------------------------------------------

				if id
					== "rbxassetid://18716184869"
				then

					pcall(function()
						track:Stop()
					end)

					move3()
					return
				end

				-- ------------------------------------------------
				-- Move 4
				-- ------------------------------------------------

				if id
					== "rbxassetid://16737255386"
				then

					pcall(function()
						track:Stop()
					end)

					move4()
					return
				end

				-- ------------------------------------------------
				-- Ultimates
				-- ------------------------------------------------

				for index, animationId in ipairs(
					ULT_ANIMATIONS
				) do

					if id == animationId then

						pcall(function()
							track:Stop()
						end)

						playUltimate(index)

						return
					end
				end
			end
		)
	)

end

-- ============================================================
-- INPUT M1 BACKUP
-- ============================================================
-- The animation trigger remains the main method.
-- This click listener also makes Creator M1 responsive when
-- the underlying game does not expose the expected animation
-- immediately.
-- ============================================================

local inputConnection = nil

local function setupM1Input(token)
	if inputConnection then
		pcall(function()
			inputConnection:Disconnect()
		end)

		inputConnection = nil
	end

	inputConnection =
		UserInputService.InputBegan:Connect(
			function(input, processed)

				if processed then
					return
				end

				if token ~= S.Token then
					return
				end

				if input.UserInputType
					== Enum.UserInputType.MouseButton1
				then

					-- Do not fire if a move key is being
					-- processed by the underlying game.
					if not S.Busy.Move1
						and not S.Busy.Move2
						and not S.Busy.Move3
						and not S.Busy.Move4
						and not S.Busy.Ult
					then

						performCreatorM1()
					end
				end
			end
		)

	table.insert(
		S.CharacterConnections,
		inputConnection
	)
end

-- ============================================================
-- CLEAN CHARACTER
-- ============================================================

local function cleanupCharacter()
	disconnectList(
		S.CharacterConnections
	)

	stopCreatorAnimations()
	stopMovementTrack()

	S.Busy = {}

	table.clear(
		S.LastVFX
	)
end

-- ============================================================
-- CHARACTER SETUP
-- ============================================================

local function setupCharacter(character)

	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid or not root then
		return
	end

	-- --------------------------------------------------------
	-- Character movement
	-- --------------------------------------------------------

	pcall(function()
		humanoid.WalkSpeed =
			CFG.WALK_SPEED
	end)

	-- --------------------------------------------------------
	-- Spawn
	-- --------------------------------------------------------

	task.defer(function()

		if token ~= S.Token then
			return
		end

		creatorSpawn(
			character,
			root,
			humanoid
		)
	end)

	-- --------------------------------------------------------
	-- Passive Creator effects
	-- --------------------------------------------------------

	setupCreatorIdle(
		character,
		humanoid,
		root,
		token
	)

	setupMovementAnimations(
		character,
		humanoid,
		root,
		token
	)

	-- --------------------------------------------------------
	-- Move / ult triggers
	-- --------------------------------------------------------

	setupAnimationTriggers(
		character,
		humanoid,
		root,
		token
	)

	setupM1Input(token)

	-- --------------------------------------------------------
	-- Existing UI
	-- --------------------------------------------------------

	task.spawn(function()

		for _ = 1, 25 do

			if token ~= S.Token then
				return
			end

			pcall(function()

				refreshCharacterTab()
				refreshCreatorHotbar()
				styleExistingUltimate()

			end)

			task.wait(0.15)
		end
	end)

	-- --------------------------------------------------------
	-- UI glitch
	-- --------------------------------------------------------

	startUIGlitchLoop(token)

	-- --------------------------------------------------------
	-- Death
	-- --------------------------------------------------------

	addCharacterConnection(
		humanoid.Died:Connect(
			function()

				S.Busy = {}

				stopCreatorAnimations()
				stopMovementTrack()

			end
		)
	)

	-- --------------------------------------------------------
	-- Existing UI reloading protection
	-- --------------------------------------------------------

	local gui =
		getPlayerGui()

	if gui then

		addCharacterConnection(
			gui.DescendantAdded:Connect(
				function()

					task.defer(function()

						if token ~= S.Token then
							return
						end

						pcall(function()

							refreshCharacterTab()
							refreshCreatorHotbar()
							styleExistingUltimate()

						end)
					end)
				end
			)
		)
	end
end

-- ============================================================
-- GLOBAL UI REFRESH
-- ============================================================

local function startUIRefresh()
	task.spawn(function()

		while Player.Parent do

			pcall(function()

				refreshCharacterTab()
				refreshCreatorHotbar()
				styleExistingUltimate()

			end)

			task.wait(0.35)
		end
	end)
end

-- ============================================================
-- RESPAWN
-- ============================================================

local function setupRespawn()
	table.insert(
		S.Connections,

		Player.CharacterAdded:Connect(
			function(character)

				task.spawn(function()

					character:WaitForChild(
						"Humanoid",
						10
					)

					character:WaitForChild(
						"HumanoidRootPart",
						10
					)

					task.wait(0.2)

					setupCharacter(
						character
					)
				end)
			end
		)
	)
end

