local function renameExistingHotbar()
	local playerGui =
		LP:FindFirstChildOfClass(
			"PlayerGui"
		)

	if not playerGui then
		return
	end

	-- Only modify existing elements.
	-- No custom bottom UI is created.

	local hotbar =
		playerGui:FindFirstChild(
			"Hotbar",
			true
		)

	if not hotbar then
		return
	end

	local names = {
		["1"] = "NULL CREATION",
		["2"] = "CREATOR'S COLLAPSE",
		["3"] = "REALITY BREAK",
		["4"] = "ABSOLUTE NULL",
	}

	for number, name in pairs(names) do
		local slot =
			hotbar:FindFirstChild(
				number,
				true
			)

		if slot then
			local toolName =
				slot:FindFirstChild(
					"ToolName",
					true
				)

			if toolName and
				toolName:IsA("TextLabel")
			then
				toolName.Text = name
			end
		end
	end
end

