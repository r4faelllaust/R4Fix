--==============================================================


local function SetupAetherUltimate()


	local gui =
	Player:FindFirstChild(
		"PlayerGui"
	)


	if not gui then
		return
	end



	local bar =
	gui:FindFirstChild(
		"Bar",
		true
	)



	if not bar then
		return
	end



	for _,obj in ipairs(
		bar:GetDescendants()
	) do



		-- MAIN BAR

		if obj:IsA(
			"Frame"
		)
		or obj:IsA(
			"ImageLabel"
		)
		then


			local gradient =
			obj:FindFirstChildOfClass(
				"UIGradient"
			)



			if not gradient then


				gradient =
				Instance.new(
					"UIGradient"
				)


				gradient.Parent =
				obj


			end



			gradient.Color =
			ColorSequence.new({

				ColorSequenceKeypoint.new(
					0,
					FIRE_RED
				),


				ColorSequenceKeypoint.new(
					0.45,
					FIRE_ORANGE
				),


				ColorSequenceKeypoint.new(
					0.5,
					THUNDER_WHITE
				),


				ColorSequenceKeypoint.new(
					0.55,
					THUNDER_BLUE
				),


				ColorSequenceKeypoint.new(
					1,
					THUNDER_BLUE
				)

			})



			-- smooth energy movement

			task.spawn(function()


				while obj.Parent do


					for i=-1,1,0.01 do


						gradient.Offset =
						Vector2.new(
							i,
							0
						)


						task.wait(
							0.025
						)


					end


				end


			end)



		end




		-- TEXT


		if obj:IsA(
			"TextLabel"
		)
		then


			obj.Text =
			"AETHER ASCENSION"


			obj.TextColor3 =
			THUNDER_WHITE



			obj.TextStrokeColor3 =
			DARK


			obj.TextStrokeTransparency =
			0.2



		end



	end


end




