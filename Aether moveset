	char:FindFirstChild(
		"AETHER_AURA"
	)

	if old then
		old:Destroy()
	end



	local highlight =
	Instance.new(
		"Highlight"
	)

	highlight.Name =
	"AETHER_AURA"

	highlight.FillColor =
	COLORS.Blue

	highlight.OutlineColor =
	COLORS.Red

	highlight.FillTransparency =
	0.75

	highlight.Parent =
	char



	local root =
	char:FindFirstChild(
		"HumanoidRootPart"
	)


	if root then


		local fire =
		Instance.new(
			"ParticleEmitter"
		)


		fire.Name =
		"AetherParticles"


		fire.Color =
		ColorSequence.new(
