--==============================================================

local function SpawnRandomThunder()

	local char,hum,root =
	GetCharacter()

	if not root then
		return
	end


	local choices =
	{

		VFX_MODELS.MoonThunder,

		VFX_MODELS.BlueThunder,

		VFX_MODELS.ThunderBlade

	}


	local chosen =
	choices[
		math.random(
			1,
			#choices
		)
	]


	local cf =
	root.CFrame *
	CFrame.new(
		0,
		1,
		-6
	)


	SpawnVFX(
		chosen,
		cf *
		CFrame.Angles(
			0,
			math.rad(
				math.random(
					0,
					360
				)
			),
			0
		),
		1.4,
		0.8
	)

end



