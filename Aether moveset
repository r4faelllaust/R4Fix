	Instance.new(
		BodyVelocity
	)


	bv.MaxForce =
	Vector3.new(
		500000,
		0,
		500000
	)


	bv.Velocity =
	root.CFrame.LookVector *
	180


	bv.Parent =
	root



	local start =
	os.clock()


	while os.clock()-start < 0.45 do


		AfterImage()


		if math.random(
			1,
			3
		)==1 then

			SpawnRandomThunder()

		end


		task.wait(
			0.08
		)

	end



	bv:Destroy()



	ThunderSlash()


	SpawnVFX(
		VFX_MODELS.FireImpact,

		root.CFrame *
		CFrame.new(
			0,
			0,
			-4
		),

		2,

		0.8
	)



end




