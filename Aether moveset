local text = Instance.new("TextLabel")
text.Size = UDim2.new(1,0,1,0)
text.BackgroundTransparency = 1
text.TextColor3 = Color3.new(1,1,1)
text.Text = "AETHER ULTIMATE 0%"
text.Parent = frame


--------------------------------------------------
-- AURA VFX
--------------------------------------------------

local function RemoveAura()

	if Aura then
		Aura:Destroy()
		Aura = nil
	end

end


local function LoadAura()

	RemoveAura()

	local objects = game:GetObjects(VFX_ASSET)

	if #objects > 0 then

		local m = objects[1]
		m.Name = "AetherAura"
		m.Parent = workspace

		local character = Player.Character
			or Player.CharacterAdded:Wait()

		local root = character:WaitForChild("HumanoidRootPart")

		if m.PrimaryPart then
			m:SetPrimaryPartCFrame(root.CFrame)
		else
			m:PivotTo(root.CFrame)
		end


		Aura = m


		RunService.RenderStepped:Connect(function()

			if Aura and root then

				if Aura.PrimaryPart then
					Aura:SetPrimaryPartCFrame(root.CFrame)
				else
					Aura:PivotTo(root.CFrame)
				end

			end

		end)

	end

end


--------------------------------------------------
-- ULTIMATE SYSTEM
--------------------------------------------------

local function ActivateUltimate()

	if Ultimate then return end

	Ultimate = true
	UltCharge = 0

	text.Text = "AETHER AWAKENED"

	LoadAura()

	task.delay(30,function()

		Ultimate = false

		text.Text = "AETHER ULTIMATE READY"

		RemoveAura()

	end)

end



--------------------------------------------------
-- CHARGE SYSTEM
--------------------------------------------------

RunService.Heartbeat:Connect(function()

	if not Ultimate then

		UltCharge += .15

		if UltCharge >= UltMax then

			UltCharge = UltMax

			ActivateUltimate()

		end

	end


	bar.Size = UDim2.new(
		UltCharge/UltMax,
		0,
		1,
		0
	)


	if not Ultimate then

		text.Text =
			"AETHER ULTIMATE "
			..math.floor(UltCharge)
			.."%"

	end

end)


--------------------------------------------------
-- RESPAWN CLEANUP
--------------------------------------------------

Player.CharacterAdded:Connect(function()

	RemoveAura()

	UltCharge = 0
	Ultimate = false

end)
