local UIS = game:GetService("UserInputService")


local Cooldowns = {}

local function Cooldown(name,time)

	if Cooldowns[name] then
		return false
	end


	Cooldowns[name] = true


	task.delay(
		time,
		function()
			Cooldowns[name] = nil
		end
	)


	return true

end



--==============================================================
-- AFTERIMAGE
--==============================================================

local function AfterImage()

	local char =
	Player.Character

	if not char then
		return
	end


	local clone =
	char:Clone()


	clone.Name =
	"AetherAfterimage"


	for _,v in ipairs(
		clone:GetDescendants()
	) do


		if v:IsA(
			"BasePart"
		) then

			v.Anchored =
			true

			v.CanCollide =
			false

			v.Material =
			Enum.Material.Neon


			v.Color =
			Color3.fromRGB(
				80,
				120,
				255
			)


			v.Transparency =
			0.45


		elseif v:IsA(
			"Humanoid"
		) then

			v:Destroy()

		end

	end


	clone.Parent =
	workspace



	local root =
	clone:FindFirstChild(
		"HumanoidRootPart"
	)


	local original =
	char:FindFirstChild(
		"HumanoidRootPart"
	)


	if root and original then

		root.CFrame =
		original.CFrame

	end



	for _,v in ipairs(
		clone:GetDescendants()
	) do

		if v:IsA(
			"BasePart"
		) then


			TweenService:Create(
				v,
				TweenInfo.new(
					0.35
				),
				{
					Transparency = 1
				}
			):Play()


		end

	end



	Debris:AddItem(
		clone,
		0.5
	)

end



