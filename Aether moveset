-- ================================================================
-- AETHER PUNCH VFX
-- ================================================================

local function SpawnPunchVFX()

	local character =
		LocalPlayer.Character

	if not character then return end


	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then return end



	local success,objects =
		pcall(function()

			return game:GetObjects(
				PUNCH_VFX
			)

		end)


	if not success
	or not objects
	or #objects == 0
	then
		warn(
			"[R4FIX] Punch VFX failed loading"
		)
		return
	end



	local effect =
		objects[1]


	effect.Parent =
		Workspace



	if effect:IsA("Model") then


		if not effect.PrimaryPart then

			effect.PrimaryPart =
				effect:FindFirstChildWhichIsA(
					"BasePart"
				)

		end


		if effect.PrimaryPart then

			effect:SetPrimaryPartCFrame(
				root.CFrame *
				CFrame.new(
					0,
					0,
					-3
				)
			)

		else

			effect:PivotTo(
				root.CFrame
			)

		end


	elseif effect:IsA("BasePart") then

		effect.CFrame =
			root.CFrame *
			CFrame.new(
				0,
				0,
				-3
			)

	end



	-- recolor possible effects

	for _,v in ipairs(
		effect:GetDescendants()
	) do


		if v:IsA("ParticleEmitter") then

			v.Color =
				ColorSequence.new(
					Color3.fromRGB(
						170,
						80,
						255
					)
				)

		elseif v:IsA("Trail")
		or v:IsA("Beam") then

			v.Color =
				ColorSequence.new(
					Color3.fromRGB(
						170,
						80,
						255
					)
				)

		end

	end



	task.delay(
		3,
		function()

			if effect then
				effect:Destroy()
			end

		end
	)

end



