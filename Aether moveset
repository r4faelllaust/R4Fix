--==============================================================
-- CHARACTER
--==============================================================

local function GetCharacter()

	local char = Player.Character
	if not char then
		return
	end

	local hum =
		char:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not hum or not root then
		return
	end

	return char,hum,root

end



--==============================================================
-- VFX FOLDER
--==============================================================

local function GetFolder()

	local folder =
	workspace:FindFirstChild(
		"AETHER_VFX"
	)

	if not folder then

		folder =
		Instance.new(
			"Folder"
		)

		folder.Name =
		"AETHER_VFX"

		folder.Parent =
		workspace

	end


	return folder

end



--==============================================================
-- LOAD MODEL
--==============================================================

local function SpawnVFX(
	id,
	cframe,
	scale,
	lifetime
)


	local objects

	local success =
	pcall(function()

		objects =
		game:GetObjects(id)

	end)


	if not success then
		return
	end


	for _,obj in ipairs(objects) do


		obj.Parent =
		GetFolder()



		if obj:IsA("Model") then


			local primary =
			obj.PrimaryPart


			if not primary then

				primary =
				obj:FindFirstChildWhichIsA(
					"BasePart",
					true
				)

			end



			if primary then

				obj.PrimaryPart =
				primary


				obj:PivotTo(
					cframe
				)


				for _,p in ipairs(
					obj:GetDescendants()
				) do

					if p:IsA(
						"BasePart"
					) then

						p.Transparency =
						1


						p.Size =
						p.Size *
						0.2


						TweenService:Create(
							p,
							TweenInfo.new(
								0.12,
								Enum.EasingStyle.Back
							),
							{

								Transparency = 0,

								Size =
								p.Size /
								0.2 *
								scale

							}
						):Play()

					end


				end



				task.delay(
					lifetime - 0.25,
					function()


						for _,p in ipairs(
							obj:GetDescendants()
						) do


							if p:IsA(
								"BasePart"
							) then


								TweenService:Create(
									p,
									TweenInfo.new(
										0.25
									),
									{
										Transparency = 1
									}
								):Play()


							end

						end


					end
				)


			end

		end



		Debris:AddItem(
			obj,
			lifetime
		)


	end


end



--==============================================================
