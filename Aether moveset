-- ============================================================
-- AETHER ULTIMATE BAR OVERRIDE
-- Uses the game's existing Ultimate bar
-- Blue Flame + Red Flame theme
-- ============================================================

local function styleUltimateBar()

	local gui = Player:FindFirstChild("PlayerGui")

	if not gui then
		return
	end


	local bar = gui:FindFirstChild("Bar")

	if not bar then
		return
	end


	local magicHealth = bar:FindFirstChild("MagicHealth")

	if not magicHealth then
		return
	end


	--============================================================
	-- TITLE
	--============================================================

	local textLabel = magicHealth:FindFirstChild("TextLabel")

	if textLabel and textLabel:IsA("TextLabel") then

		textLabel.Text = "AETHER'S ASCENSION"
		textLabel.TextColor3 = Color3.fromRGB(170,220,255)
		textLabel.TextStrokeColor3 = Color3.fromRGB(255,60,30)
		textLabel.TextStrokeTransparency = 0
		textLabel.TextSize = 26

	end


	-- Some versions have another nested label

	local nested = textLabel and textLabel:FindFirstChild("TextLabel")

	if nested and nested:IsA("TextLabel") then

		nested.Text = "AETHER'S ASCENSION"
		nested.TextColor3 = Color3.fromRGB(170,220,255)
		nested.TextStrokeColor3 = Color3.fromRGB(255,60,30)
		nested.TextStrokeTransparency = 0

	end



	--============================================================
	-- BAR COLORS
	--============================================================

	local health = magicHealth:FindFirstChild("Health")

	if not health then
		return
	end


	local holder = health:FindFirstChild("Bar")

	if not holder then
		return
	end


	local fill = holder:FindFirstChild("Bar")


	if fill then


		-- Image based bar

		if fill:IsA("ImageLabel") 
		or fill:IsA("ImageButton") then


			fill.ImageColor3 =
				Color3.fromRGB(60,180,255)


			fill.ImageTransparency = 0


		-- Frame based bar

		elseif fill:IsA("Frame") then


			fill.BackgroundColor3 =
				Color3.fromRGB(60,180,255)


			fill.BackgroundTransparency = 0

		end



		-- Dual flame gradient

		local gradient =
			fill:FindFirstChildOfClass("UIGradient")


		if gradient then

			gradient.Color =
				ColorSequence.new({

					ColorSequenceKeypoint.new(
						0,
						Color3.fromRGB(30,120,255)
					),


					ColorSequenceKeypoint.new(
						0.5,
						Color3.fromRGB(255,60,35)
					),


					ColorSequenceKeypoint.new(
						1,
						Color3.fromRGB(120,40,255)
					)

				})

		end

	end



	--============================================================
	-- GLOW
	--============================================================

	local glow =
		health:FindFirstChild("Glow")


	if glow and
		(glow:IsA("ImageLabel")
		or glow:IsA("ImageButton")) then


		glow.ImageColor3 =
			Color3.fromRGB(255,80,40)


		glow.ImageTransparency = 0.15

	end

end
