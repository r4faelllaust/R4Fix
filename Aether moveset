--------------------------------------------------
-- AETHER AURA LOADER
--------------------------------------------------

local function RemoveAura()

	if AuraModel then

		AuraModel:Destroy()
		AuraModel = nil

	end

end



local function LoadAura()

	RemoveAura()

	local character = GetCharacter()
	local root = character:WaitForChild("HumanoidRootPart")


	local success,objects = pcall(function()

		return game:GetObjects(VFX_ID)

	end)


	if not success or not objects or #objects == 0 then
		warn("Aether VFX failed loading")
		return
	end


	local model = objects[1]


	if not model then
		return
	end


	model.Name = "Aether_Aura"
	model.Parent = workspace


	if model:IsA("Model") then


		if not model.PrimaryPart then

			model.PrimaryPart =
				model:FindFirstChild("HumanoidRootPart")
				or model:FindFirstChildWhichIsA("BasePart")

		end


		if model.PrimaryPart then

			model:SetPrimaryPartCFrame(root.CFrame)

		else

			model:PivotTo(root.CFrame)

		end


	elseif model:IsA("BasePart") then

		model.CFrame = root.CFrame

	end


	AuraModel = model



	RunService.RenderStepped:Connect(function()

		if AuraModel and root and root.Parent then


			if AuraModel:IsA("Model") then

				if AuraModel.PrimaryPart then

					AuraModel:SetPrimaryPartCFrame(root.CFrame)

				else

					AuraModel:PivotTo(root.CFrame)

				end


			elseif AuraModel:IsA("BasePart") then

				AuraModel.CFrame = root.CFrame

			end


		end

	end)

end



