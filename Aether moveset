local function UpdateCharacterTab()


	local gui =
	Player:FindFirstChild(
		"PlayerGui"
	)


	if not gui then
		return
	end



	for _,obj in ipairs(
		gui:GetDescendants()
	) do


		if obj:IsA(
			"TextLabel"
		) then


			if obj.Text ==
			"Garou"
			or obj.Text ==
			"Hero Hunter"
			then


				obj.Text =
				MOVESET_NAME


			end


		end



		if obj:IsA(
			"ImageLabel"
		)
		or obj:IsA(
			"ImageButton"
		)
		then


			if obj.Name:
			lower():find(
				"icon"
			)
			then


				obj.Image =
				DECAL


			end


		end


	end


end




