local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local AETHER_NAME = "Aether"
local DECAL_ID = "rbxthumb://type=Asset&id=13394302362&w=150&h=150"

local M1_VFX_ID = "rbxassetid://133060042063817"

local VFX_FOLDER_NAME = "Aether_Local_VFX"

local Purple =
	Color3.fromRGB(170,80,255)


local VFXFolder =
	workspace:FindFirstChild(VFX_FOLDER_NAME)

if not VFXFolder then

	VFXFolder = Instance.new("Folder")
	VFXFolder.Name = VFX_FOLDER_NAME
	VFXFolder.Parent = workspace

end


local function GetCharacter()

	return Player.Character
		or Player.CharacterAdded:Wait()

end



-- ================================================================
-- CHARACTER UI
-- ================================================================

local function UpdateAetherUI()

	pcall(function()

		for _,obj in ipairs(
			PlayerGui:GetDescendants()
		) do


			if obj:IsA("TextLabel") then

				if obj.Text == "Hunter"
				or obj.Text == "Hero Hunter" then

					obj.Text = AETHER_NAME

				end

			end


			if obj:IsA("ImageLabel")
			or obj:IsA("ImageButton") then

				if obj.Name:lower():find("icon")
				or obj.Name:lower():find("image") then

					obj.Image = DECAL_ID

				end

			end

		end

	end)

end



task.spawn(function()

	while task.wait(0.5) do

		UpdateAetherUI()

	end

end)



-- ================================================================
-- AETHER M1 VFX SPAWNER
-- ================================================================

local function FadeRemove(effect)

	for _,v in ipairs(
		effect:GetDescendants()
	) do


		if v:IsA("BasePart") then

			TweenService:Create(
				v,
				TweenInfo.new(
					0.25,
					Enum.EasingStyle.Quad
				),
				{
					Transparency = 1
				}
			):Play()


		elseif v:IsA("ParticleEmitter") then

			v.Enabled = false


		elseif v:IsA("Trail")
		or v:IsA("Beam") then

			v.Enabled = false

		end

	end


	task.delay(0.3,function()

		if effect then
			effect:Destroy()
		end

	end)

end



local function SpawnAetherM1()

	local character =
		GetCharacter()

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end


	local success,objects =
		pcall(function()

			return game:GetObjects(
				M1_VFX_ID
			)

		end)


	if not success
	or not objects
	or not objects[1]
	then

		warn(
			"Aether M1 VFX failed"
		)

		return

	end


	local effect =
		objects[1]


	effect.Name =
		"Aether_M1"


	effect.Parent =
		VFXFolder


	local position =
		root.CFrame *
		CFrame.new(
			0,
			0,
			-3
		)


	if effect:IsA("Model") then

		effect:PivotTo(
			position
		)

	elseif effect:IsA("BasePart") then

		effect.CFrame =
			position

	end


	for _,v in ipairs(
		effect:GetDescendants()
	) do

		if v:IsA("ParticleEmitter") then

			v.Color =
				ColorSequence.new(
					Purple
				)

			v:Emit(25)

		elseif v:IsA("Trail")
		or v:IsA("Beam") then

			v.Color =
				ColorSequence.new(
					Purple
				)

		end

	end


	task.delay(
		0.45,
		function()

			FadeRemove(effect)

		end
	)

end

