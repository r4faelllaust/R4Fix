-- ================================================================
-- CHARACTER RESET CLEANUP
-- ================================================================

Player.CharacterAdded:Connect(function()

	for _,v in ipairs(
		VFXFolder:GetChildren()
	) do

		v:Destroy()

	end


	task.wait(1)

	SetupCharacter()

end)



-- ================================================================
