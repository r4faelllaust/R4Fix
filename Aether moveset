--==============================================================
-- AETHER AURA
--==============================================================

local function CreateAura()

	local char =
	Player.Character

	if not char then
		return
	end



	local old =
	char:FindFirstChild(
		"AETHER_AURA"
	)

	if old then
		old:Destroy()
	end



	local highlight =
	Instance.new(
		"Highlight"
	)

	highlight.Name =
	"AETHER_AURA"

	highlight.FillColor =
	COLORS.Blue

	highlight.OutlineColor =
	COLORS.Red

	highlight.FillTransparency =
	0.75

	highlight.Parent =
	char



	local root =
	char:FindFirstChild(
		"HumanoidRootPart"
	)


	if root then


		local fire =
		Instance.new(
			"ParticleEmitter"
		)


		fire.Name =
		"AetherParticles"


		fire.Color =
		ColorSequence.new(
		{
			ColorSequenceKeypoint.new(
				0,
				COLORS.Red
			),

			ColorSequenceKeypoint.new(
				1,
				COLORS.Blue
			)
		})


		fire.Rate =
		25

		fire.Lifetime =
		NumberRange.new(
			0.4,
			0.8
		)


		fire.Speed =
		NumberRange.new(
			2,
			6
		)


		fire.Parent =
		root


	end

end



