local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local MOVESET_NAME = "Aether"

local DECAL_ID = "rbxthumb://type=Asset&id=13394302362&w=150&h=150"

local VFX_ASSET = "rbxassetid://95183267034317"

local Ultimate = false
local UltCharge = 0
local UltMax = 100

local Aura

--------------------------------------------------
-- CHARACTER TAB OVERRIDE
--------------------------------------------------

RunService.Heartbeat:Connect(function()

	pcall(function()

		local topbar = PlayerGui:FindFirstChild("TopbarPlus")

		if topbar then

			for _,v in ipairs(topbar:GetDescendants()) do

				if v.Name == "IconButton" then

					local label = v:FindFirstChild("IconLabel")
					local image = v:FindFirstChild("IconImage")

					if label then

						if label.Text == "Hero Hunter"
						or label.Text == "Hunter"
						or label.Text == MOVESET_NAME then

							label.Text = MOVESET_NAME

							if image then
								image.Image = DECAL_ID
							end

						end
					end
				end
			end
		end

	end)

end)


--------------------------------------------------
-- ULTIMATE BAR
--------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "AetherUltimateGui"
gui.ResetOnSpawn = false
