--========================================================--
-- BAR UPDATE
--========================================================--

local function UpdateBar()

	local Percent = math.clamp(
		Ultimate.Charge / Ultimate.MaxCharge,
		0,
		1
	)


	TweenService:Create(
		Fill,
		TweenInfo.new(
			0.25,
			Enum.EasingStyle.Quint
		),
		{
			Size = UDim2.new(
				Percent,
				0,
				1,
				0
			)
		}
	):Play()



	if Percent >= 1 then

		Activate.Text = "[G] READY"

		Glow.Color = CONFIG.Colors.Red

	else

		Activate.Text = CONFIG.ActivateText

		Glow.Color = CONFIG.Colors.Blue

	end

end



--========================================================--
-- CHARGE API
--========================================================--

function Ultimate:Add(amount)

	Ultimate.Charge = math.clamp(
		Ultimate.Charge + amount,
		0,
		Ultimate.MaxCharge
	)

	UpdateBar()

end



function Ultimate:Reset()

	Ultimate.Charge = 0
	UpdateBar()

end



function Ultimate:SetState(state)

	Ultimate.IsUlted = state


	if state then

		Title.Text = "AETHER'S ASCENSION"

		Glow.Color = CONFIG.Colors.Red

	else

		Title.Text = CONFIG.BarName

		Glow.Color = CONFIG.Colors.Blue

	end

end



