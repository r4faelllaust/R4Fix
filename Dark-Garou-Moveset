local function cleanupConnections()
	for _, conn in pairs(SESSION.Connections) do
		pcall(function()
			if conn then
				conn:Disconnect()
			end
		end)
	end

	SESSION.Connections = {}

	if SESSION.IdleConn then
		pcall(function()
			SESSION.IdleConn:Disconnect()
		end)

		SESSION.IdleConn = nil
	end
end

local function track(conn)
	if conn then
		table.insert(SESSION.Connections, conn)
	end

	return conn
end

