local function createAfterimage(character)
	if not character then
		return
	end

	local clone

	pcall(function()
		clone = character:Clone()
	end)

	if not clone then
		return
	end

	for _, obj in ipairs(clone:GetDescendants()) do

		if obj:IsA("Script")
			or obj:IsA("LocalScript")
			or obj:IsA("ModuleScript")
			or obj:IsA("Humanoid")
			or obj:IsA("Tool") then

			obj:Destroy()

		elseif obj:IsA("BasePart") then

			obj.Anchored = true
			obj.CanCollide = false
			obj.CanTouch = false
			obj.CanQuery = false

			obj.Material = Enum.Material.Neon

			obj.Color = VOID_PURPLE

			obj.Transparency = 0.55

		elseif obj:IsA("Decal") then

			obj.Transparency = 0.75

		elseif obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam") then

			obj.Enabled = false
		end
	end

	clone.Name = "PhantomAfterimage"

	clone.Parent = workspace

	task.spawn(function()

		local parts = {}

		for _, obj in ipairs(clone:GetDescendants()) do
			if obj:IsA("BasePart") then
				table.insert(parts, obj)
			end
		end

		for i = 1, 8 do

			for _, part in ipairs(parts) do

				pcall(function()
					part.Transparency =
						math.clamp(
							part.Transparency + 0.055,
							0,
							1
						)
				end)

			end

			task.wait(0.025)
		end

		pcall(function()
			clone:Destroy()
		end)

	end)

	Debris:AddItem(clone, 1)
end

