--------------------------------------------------------------------
-- FIND CLOSEST ENEMY
--------------------------------------------------------------------

local function getClosestEnemy(maxDistance)

	local character =
		getCharacter()

	local root =
		getRoot()

	if not character or not root then
		return nil
	end

	local live =
		workspace:FindFirstChild("Live")

	if not live then
		return nil
	end

	local closest = nil
	local closestDistance = maxDistance

	for _, model in ipairs(live:GetChildren()) do

		if model ~= character then

			local enemyHumanoid =
				model:FindFirstChildOfClass("Humanoid")

			local enemyRoot =
				model:FindFirstChild("HumanoidRootPart")

			if enemyHumanoid
				and enemyRoot
				and enemyHumanoid.Health > 0 then

				local distance =
					(
						root.Position
						-
						enemyRoot.Position
					).Magnitude

				if distance <= closestDistance then

					closest =
						model

					closestDistance =
						distance

				end

			end

		end

	end

	return closest

end

--------------------------------------------------------------------
-- BLINK BEHIND ENEMY
--------------------------------------------------------------------

local M1_BLINK_DISTANCE = 45
local M1_BLINK_COOLDOWN = 0.12

local lastM1Blink = 0

local function blinkBehindEnemy(enemy)

	if not enemy then
		return false
	end

	local character =
		getCharacter()

	local root =
		getRoot()

	local enemyRoot =
		enemy:FindFirstChild("HumanoidRootPart")

	local enemyHumanoid =
		enemy:FindFirstChildOfClass("Humanoid")

	if not character
		or not root
		or not enemyRoot
		or not enemyHumanoid
		or enemyHumanoid.Health <= 0 then

		return false

	end

	local now =
		os.clock()

	if now - lastM1Blink <
		M1_BLINK_COOLDOWN then

		return false

	end

	lastM1Blink =
		now

	-- Leave an afterimage at the original location.
	createAfterimage(
		character
	)

	teleportVFX(
		root.Position
	)

	-- Positive Z is behind a Roblox character relative
	-- to its LookVector.
	local destination =
		enemyRoot.CFrame
		*
		CFrame.new(
			0,
			0,
			4.5
		)

	root.CFrame =
		CFrame.lookAt(
			destination.Position,
			enemyRoot.Position
		)

	teleportVFX(
		root.Position
	)

	return true

end

