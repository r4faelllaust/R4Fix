							-- OLD:
							-- CFrame.new(60, 400, -20)
							--
							-- That was the reason it went WAY UP.
							--
							-- NEW:
							-- horizontal only.
							--
							-- X = huge horizontal displacement
							-- Y = almost zero
							-- Z = small forward displacement
							------------------------------------------------

							local horizontalOffset =
								CFrame.new(
									CONFIG.VOID_HORIZONTAL_DISTANCE,
									CONFIG.VOID_VERTICAL_OFFSET,
									-CONFIG.VOID_FORWARD_DISTANCE
								)

