----------------------------------------------------------------
-- REQUEST PROTECTION
----------------------------------------------------------------

local requestNames = {
	"request",
	"http_request",
	"http.request",
}

for _, name in ipairs(
	requestNames
) do

	local original =
		getgenv()[name]

	if original then

		getgenv()[name] =
			function(data)

				local url =
					data.Url
					or "Unknown"

				local decision

				local bindable =
					Instance.new(
						"BindableFunction"
					)

				bindable.OnInvoke =
					function(response)

						decision =
							response
							== "Accept"

					end

				StarterGui:SetCore(
					"SendNotification",
					{
						Title =
							"Request Pending",

						Text =
							tostring(
								url
							),

						Duration =
							math.huge,

						Callback =
							bindable,

						Button1 =
							"Accept",

						Button2 =
							"Reject",
					}
				)

				repeat
					task.wait()
				until decision ~= nil

				if decision then
					return original(data)
				end

			end

	end

end

