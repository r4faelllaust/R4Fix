--
-- Instant-kill move presentation.
--------------------------------------------------------------------

local function abyssalDrag()

	local character =
		getCharacter()

	local humanoid =
		getHumanoid()

	local root =
		getRoot()

	if not character
		or not humanoid
		or not root then

		return

	end

	----------------------------------------------------------------
	-- INITIAL VANISH
	----------------------------------------------------------------

	createAfterimage(
		character
	)

	teleportVFX(
		root.Position
	)

	----------------------------------------------------------------
	-- FIND TARGET
	----------------------------------------------------------------

	local target =
		getClosestEnemy(90)

	if target then

		local targetRoot =
			target:FindFirstChild(
				"HumanoidRootPart"
			)

		if targetRoot then

			----------------------------------------------------------------
			-- DARK GAROU APPEARS BEHIND TARGET
			----------------------------------------------------------------

			task.wait(0.08)

			local destination =
				targetRoot.CFrame
				*
				CFrame.new(
					0,
					0,
					6
				)

			root.CFrame =
				CFrame.lookAt(
					destination.Position,
					targetRoot.Position
				)

			teleportVFX(
				root.Position
			)

			----------------------------------------------------------------
			-- EXECUTION PAUSE
			----------------------------------------------------------------

			task.wait(0.12)

			----------------------------------------------------------------
			-- CUSTOM EXECUTION ANIMATION
			----------------------------------------------------------------

			local execution =
				playAnimation(
					humanoid,
					ANIMS.AtomicPinpointFinish,
					0.8
				)

			spawnSlash(
				root,
				1.8
			)

			task.wait(0.28)

			----------------------------------------------------------------
			-- TARGET IMPACT
			----------------------------------------------------------------

			if targetRoot.Parent then

				impactVFX(
					targetRoot.Position,
					1.8
				)

				spawnSlash(
					targetRoot,
					2.2
				)

			end

			task.wait(0.1)

			----------------------------------------------------------------
			-- THE VOID "SWALLOWS" THE AREA
			----------------------------------------------------------------

			if targetRoot.Parent then

				voidImplosion(
					targetRoot.Position,
					1.6
				)

			end

			----------------------------------------------------------------
			-- ACTUAL GAME-SIDE RESULT
			--
			-- We deliberately do NOT fake a server-side kill here.
			-- If the game exposes its legitimate move event, the
			-- existing Hunter move system is responsible for the
			-- actual hit.
			----------------------------------------------------------------

			if execution then

				pcall(function()
					execution:AdjustSpeed(0.7)
				end)

			end

			return

		end

	end

	----------------------------------------------------------------
	-- NO TARGET
	----------------------------------------------------------------

	voidImplosion(
		root.Position,
		0.8
	)

end

