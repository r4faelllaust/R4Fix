local function setupMovementVFX(
	character,
	humanoid,
	root
)

	----------------------------------------------------------------
	-- LIMB TRAILS
	----------------------------------------------------------------

	for _, limbName in ipairs({

		"Left Arm",
		"Right Arm",
		"Left Leg",
		"Right Leg",

	}) do

		local limb =
			character:FindFirstChild(
				limbName
			)

		if limb then

			local a0 =
				Instance.new("Attachment")

			a0.Position =
				Vector3.new(
					0,
					0.2,
					0
				)

			a0.Parent =
				limb

			local a1 =
				Instance.new("Attachment")

			a1.Position =
				Vector3.new(
					0,
					-0.9,
					0
				)

			a1.Parent =
				limb

			local trail =
				Instance.new("Trail")

			trail.Name =
				"DarkGarouTrail"

			trail.Attachment0 =
				a0

			trail.Attachment1 =
				a1

			trail.Lifetime =
				0.25

			trail.Color =
				ColorSequence.new({

					ColorSequenceKeypoint.new(
						0,
						VOID_BRIGHT
					),

					ColorSequenceKeypoint.new(
						0.5,
						VOID_PURPLE
					),

					ColorSequenceKeypoint.new(
						1,
						VOID_BLACK
					),

				})

			trail.Transparency =
				NumberSequence.new({

					NumberSequenceKeypoint.new(
						0,
						0.3
					),

					NumberSequenceKeypoint.new(
						1,
						1
					),

				})

			trail.WidthScale =
				NumberSequence.new({

					NumberSequenceKeypoint.new(
						0,
						0.7
					),

					NumberSequenceKeypoint.new(
						1,
						0
					),

				})

			trail.LightEmission =
				0.8

			trail.Parent =
				limb

			trackEffect(
				trail
			)

		end

	end

	----------------------------------------------------------------
	-- MOVEMENT LOOP
	----------------------------------------------------------------

	local lastAfterimage =
		0

	local lastParticle =
		0

	local wasMoving =
		false

	local wasAirborne =
		false

	track(

		RunService.Heartbeat:Connect(

			function()

				if not humanoid.Parent
					or humanoid.Health <= 0 then

					return

				end

				local moveMagnitude =
					humanoid.MoveDirection.Magnitude

				local state =
					humanoid:GetState()

				local airborne =
					state == Enum.HumanoidStateType.Jumping
					or state == Enum.HumanoidStateType.Freefall

				----------------------------------------------------------------
				-- WALK/RUN
				----------------------------------------------------------------

				if moveMagnitude > 0.1
					and not airborne then

					if not wasMoving then

						spawnVoidRing(
							root.Position,
							7,
							0.25
						)

					end

					wasMoving =
						true

					local now =
						os.clock()

					----------------------------------------------------------------
					-- RUNNING AFTERIMAGE
					----------------------------------------------------------------

					if now - lastAfterimage >
						0.18 then

						lastAfterimage =
							now

						createAfterimage(
							character
						)

					end

					----------------------------------------------------------------
					-- FOOTSTEP PARTICLES
					----------------------------------------------------------------

					if now - lastParticle >
						0.11 then

						lastParticle =
							now

						spawnParticleBurst(
							root.Position
								-
								Vector3.new(
									0,
									2.6,
									0
								),

							2,
							0.35,
							2

						)

					end

				else

					wasMoving =
						false

				end

				----------------------------------------------------------------
				-- AIRBORNE
				----------------------------------------------------------------

				if airborne and not wasAirborne then

					spawnVoidRing(
						root.Position,
						8,
						0.25
					)

					spawnParticleBurst(
						root.Position,
						12,
						0.7,
						7
					)

				end

				----------------------------------------------------------------
				-- LANDING
				----------------------------------------------------------------

				if not airborne and wasAirborne then

					impactVFX(
						root.Position,
						0.65
					)

				end

				wasAirborne =
					airborne

			end

		)

	)

end

