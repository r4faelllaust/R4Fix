--------------------------------------------------------------------

local function setupCharacter(character)

	cleanupConnections()
	cleanupEffects()

	local humanoid =
		character:WaitForChild(
			"Humanoid"
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart"
		)

	local gui =
		lp:WaitForChild(
			"PlayerGui"
		)

	----------------------------------------------------------------
	-- CHANGE TO HUNTER
	----------------------------------------------------------------

	if lp:GetAttribute("Character")
		~= "Hunter" then

		pcall(function()

			local communicate =
				character:FindFirstChild(
					"Communicate"
				)

			if communicate then

				communicate:FireServer({

					Goal =
						"Change Character",

					Character =
						"Hunter",

				})

			end

		end)

		task.wait(1)

	end

	----------------------------------------------------------------
	-- RESTORE DEATH LOCATION
	----------------------------------------------------------------

	if SESSION.LastDeathCFrame then

		task.wait(
			0.15
		)

		pcall(function()

			root.CFrame =
				SESSION.LastDeathCFrame

		end)

	end

	----------------------------------------------------------------
	-- DARK CHARACTER DATA
	----------------------------------------------------------------

	character:SetAttribute(
		"UltimateName",
		string.upper(
			"... FROM THE VOID, NOTHING RETURNS ..."
		)
	)

	lp:SetAttribute(
		"S_UltMusic",
		false
	)

	----------------------------------------------------------------
	-- SPAWN
	----------------------------------------------------------------

	darkSpawnSequence(
		character,
		humanoid,
		root
	)

	----------------------------------------------------------------
	-- IDLE AURA
	----------------------------------------------------------------

	setupIdleAura(
		character,
		humanoid,
		root
	)

	----------------------------------------------------------------
	-- MOVEMENT
	----------------------------------------------------------------

	setupMovementVFX(
		character,
		humanoid,
		root
	)

	----------------------------------------------------------------
	-- GUI
	----------------------------------------------------------------

	applyNames(
		gui,
		baseNames
	)

	----------------------------------------------------------------
	-- HOTBAR WATCHER
	----------------------------------------------------------------

	track(

		task.spawn(

			function()

				while humanoid.Parent
					and humanoid.Health > 0 do

					task.wait(
						0.2
					)

					applyNames(
						gui,
						baseNames
					)

				end

			end

		)

	)

	----------------------------------------------------------------
	-- ULT NAMES
	----------------------------------------------------------------

	track(

		lp.Backpack.ChildAdded:Connect(

			function(tool)

				if tool.Name
					~= "Death Counter" then

					return

				end

				task.wait()

				local hotbar =
					gui:FindFirstChild(
						"Hotbar"
					)

				if not hotbar then
					return
				end

				local backpack =
					hotbar:FindFirstChild(
						"Backpack"
					)

				if not backpack then
					return
				end

				local frame =
					backpack:FindFirstChild(
						"Hotbar"
					)

				if not frame then
					return
				end

				for slot, name in pairs(ultNames) do

					local slotObject =
						frame:FindFirstChild(
							slot
						)

					local base =
						slotObject
						and slotObject:FindFirstChild(
							"Base"
						)

					if base then

						local label =
							base:FindFirstChild(
								"ToolName"
							)

						if label then

							label.Text =
								name

						end

					end

				end

			end

		)

	)

	----------------------------------------------------------------
	-- M1 / ANIMATION REPLACEMENT
	----------------------------------------------------------------

	track(

		humanoid.AnimationPlayed:Connect(

			function(animationTrack)

				local animation =
					animationTrack.Animation

				if not animation then
					return
				end

				local id =
					animation.AnimationId

				----------------------------------------------------------------
				-- M1
				----------------------------------------------------------------

				if ORIGINAL_M1[id] then

					handleM1(
						humanoid,
						animationTrack
					)

					return

				end

				----------------------------------------------------------------
				-- SLOT 1
				----------------------------------------------------------------

				if id == SLOT1_ID then

					pcall(function()
						animationTrack:Stop(0)
					end)

					abyssalDrag()

					return

				end

				----------------------------------------------------------------
				-- SLOT 2
				----------------------------------------------------------------

				if id == SLOT2_ID then

					pcall(function()
						animationTrack:Stop(0)
					end)

					shadowStrike()

					return

				end

				----------------------------------------------------------------
				-- SLOT 3
				----------------------------------------------------------------

				if id == SLOT3_ID then

					pcall(function()
						animationTrack:Stop(0)
					end)

					phantomSweep()

					return

				end

				----------------------------------------------------------------
				-- SLOT 4
				----------------------------------------------------------------

				if id == SLOT4_ID then

					pcall(function()
						animationTrack:Stop(0)
					end)

					totalEclipse()

					return

				end

				----------------------------------------------------------------
				-- EXISTING WATER STREAM TRIGGER
				----------------------------------------------------------------

				if id ==
					ANIMS.WaterStreamRockSmashing then

					pcall(function()
						animationTrack:Stop(0)
					end)

					playAnimation(
						humanoid,
						ANIMS.AtomicQuickSlice,
						1
					)

					spawnSlash(
						root,
						1.5
					)

					return

				end

				----------------------------------------------------------------
				-- FINAL HUNT
				----------------------------------------------------------------

				if id ==
					ANIMS.FinalHunt then

					pcall(function()
						animationTrack:Stop(0)
					end)

					playAnimation(
						humanoid,
						ANIMS.FinalHunt,
						0.85
					)

					voidImplosion(
						root.Position,
						1.2
					)

					return

				end

			end

		)

	)

	----------------------------------------------------------------
	-- HIT VFX
	----------------------------------------------------------------

	local lastHitTime = {}

	local function spawnHitVFX(target)

		if not target then
			return
		end

		local targetRoot =
			target:FindFirstChild(
				"HumanoidRootPart"
			)

		if not targetRoot then
			return
		end

		local now =
			os.clock()

		if now -
			(lastHitTime[target] or 0)
			< 0.18 then

			return

		end

		lastHitTime[target] =
			now

		impactVFX(
			targetRoot.Position,
			0.8
		)

		spawnSlash(
			targetRoot,
			0.9
		)

	end

	----------------------------------------------------------------
	-- LIVE CHARACTER HIT WATCH
	----------------------------------------------------------------

	local live =
		workspace:FindFirstChild(
			"Live"
		)

	if live then

		local function watchTarget(model)

			if model == character then
				return
			end

			local targetHumanoid =
				model:FindFirstChildOfClass(
					"Humanoid"
				)

			if not targetHumanoid then

				targetHumanoid =
					model:WaitForChild(
						"Humanoid",
						5
					)

			end

			if not targetHumanoid then
				return
			end

			track(

				targetHumanoid.HealthChanged:Connect(

					function()

						if model:GetAttribute(
							"LastHit"
						) == lp.Name then

							spawnHitVFX(
								model
							)

						end

					end

				)

			)

		end

		for _, model in ipairs(
			live:GetChildren()
		) do

			watchTarget(
				model
			)

		end

		track(

			live.ChildAdded:Connect(

				function(model)

					task.defer(function()

						watchTarget(
							model
						)

					end)

				end

			)

		)

	end

	----------------------------------------------------------------
	-- DEATH
	----------------------------------------------------------------

	track(

		humanoid.Died:Once(

			function()

				pcall(function()

					SESSION.LastDeathCFrame =
						root.CFrame

				end)

				----------------------------------------------------------------
				-- DEATH EFFECT
				----------------------------------------------------------------

				voidImplosion(
					root.Position,
					1.4
				)

			end

		)

	)

end

