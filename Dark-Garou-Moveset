----------------------------------------------------------------
-- PHANTOM ENGINE
----------------------------------------------------------------

local function PhantomEngine(duration, speed)

	local charC = lp.Character

	if not charC then
		return
	end

	local humanoid =
		charC:FindFirstChildOfClass("Humanoid")

	local hrp =
		charC:FindFirstChild("HumanoidRootPart")

	if not humanoid or not hrp then
		return
	end

	------------------------------------------------------------
	-- START VFX
	------------------------------------------------------------

	spawnBurst(
		hrp.CFrame,
		8,
		VOID_PURPLE,
		0.25
	)

	spawnShockwave(
		hrp.CFrame,
		3,
		18,
		VOID_PURPLE,
		0.4
	)

	spawnDarkParticles(
		hrp,
		30,
		VOID_PURPLE_2
	)

	playSound(
		hrp,
		SOUND.PhantomStart,
		1.5,
		0.8
	)

	------------------------------------------------------------
	-- AURA
	------------------------------------------------------------

	local aura =
		createPhantomAura(hrp)

	------------------------------------------------------------
	-- TRAIL
	------------------------------------------------------------

	local trailData =
		createPhantomTrail(hrp)

	------------------------------------------------------------
	-- BODY VELOCITY
	------------------------------------------------------------

	local bv = Instance.new("BodyVelocity")

	bv.Name = "PhantomEngineBV"

	bv.MaxForce =
		Vector3.new(
			CONFIG.PHANTOM_MAX_FORCE,
			CONFIG.PHANTOM_MAX_FORCE,
			CONFIG.PHANTOM_MAX_FORCE
		)

	bv.P = 50000

	bv.Velocity =
		hrp.CFrame.LookVector
		* speed

	bv.Parent = hrp

	------------------------------------------------------------
	-- EXTRA BODY GYRO
	------------------------------------------------------------

	local bg = Instance.new("BodyGyro")

	bg.Name = "PhantomEngineGyro"

	bg.MaxTorque =
		Vector3.new(
			1e6,
			1e6,
			1e6
		)

	bg.P = 50000

	bg.D = 1000

	bg.CFrame = hrp.CFrame

	bg.Parent = hrp

	------------------------------------------------------------
	-- MULTI-STAGE ACCELERATION
	------------------------------------------------------------

	local alive = true

	task.spawn(function()

		local startTime = tick()

		while alive
			and hrp
			and hrp.Parent
			and tick() - startTime < duration do

			local elapsed =
				tick() - startTime

			local alpha =
				math.clamp(
					elapsed / duration,
					0,
					1
				)

			local direction =
				hrp.CFrame.LookVector

			----------------------------------------------------
			-- STRONGER START
			----------------------------------------------------

			local acceleration =
				speed
				* (
					1.15
					+ math.sin(alpha * math.pi)
					* 0.65
				)

			bv.Velocity =
				direction
				* acceleration

			bg.CFrame =
				CFrame.lookAt(
					hrp.Position,
					hrp.Position
					+ direction
				)

			----------------------------------------------------
			-- RANDOM PHANTOM PARTICLES
			----------------------------------------------------

			if math.random() < 0.45 then

				spawnDarkParticles(
					hrp,
					math.random(2, 5),
					VOID_PURPLE
				)

			end

			task.wait(0.025)

		end

	end)

	------------------------------------------------------------
	-- PROPULSION PULSES
	------------------------------------------------------------

	task.spawn(function()

		for i = 1, CONFIG.PHANTOM_PULSES do

			if not hrp or not hrp.Parent then
				break
			end

			local direction =
				hrp.CFrame.LookVector

			bv.Velocity =
				direction
				* (
					speed
					+ (i * 70)
				)

			spawnBurst(
				hrp.CFrame
				* CFrame.new(
					0,
					0,
					2
				),
				5 + i * 2,
				(i % 2 == 0)
					and VOID_PURPLE_2
					or VOID_PURPLE,
				0.2
			)

			spawnShockwave(
				hrp.CFrame,
				2,
				8 + i * 2,
				VOID_PURPLE,
				0.25
			)

			task.wait(
				CONFIG.PHANTOM_PULSE_DELAY
			)
		end

	end)

	------------------------------------------------------------
	-- AFTERIMAGE LOOP
	------------------------------------------------------------

	task.spawn(function()

		for i = 1, CONFIG.AFTERIMAGE_COUNT do

			if not hrp or not hrp.Parent then
				break
			end

			createAfterimage(charC)

			task.wait(
				CONFIG.AFTERIMAGE_DELAY
			)

		end

	end)

	------------------------------------------------------------
	-- FINAL IMPACT
	------------------------------------------------------------

	task.delay(
		duration,
		function()

			alive = false

			if bv then
				bv:Destroy()
			end

			if bg then
				bg:Destroy()
			end

			if trailData then

				if trailData.Trail then
					trailData.Trail.Enabled = false
				end

				Debris:AddItem(
					trailData.Attachment0,
					0.7
				)

				Debris:AddItem(
					trailData.Attachment1,
					0.7
				)

				Debris:AddItem(
					trailData.Trail,
					0.7
				)

			end

			if aura then

				pcall(function()
					aura.Parent = nil
				end)

				Debris:AddItem(
					aura,
					0.5
				)

			end

			if hrp and hrp.Parent then

				spawnBurst(
					hrp.CFrame,
					14,
					VOID_PURPLE_2,
					0.35
				)

				spawnShockwave(
					hrp.CFrame,
					5,
					28,
					VOID_PURPLE,
					0.5
				)

				spawnDarkParticles(
