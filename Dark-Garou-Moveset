--------------------------------------------------------------------
-- CLEANUP
--------------------------------------------------------------------

local function cleanupConnections()

	for _, connection in pairs(SESSION.Connections) do

		pcall(function()
			connection:Disconnect()
		end)

	end

	SESSION.Connections = {}

end

local function track(connection)

	table.insert(
		SESSION.Connections,
		connection
	)

	return connection

end

local function cleanupEffects()

	for _, object in pairs(SESSION.Effects) do

		pcall(function()

			if object and object.Parent then
				object:Destroy()
			end

		end)

	end

	SESSION.Effects = {}

end

local function trackEffect(object)

	table.insert(
		SESSION.Effects,
		object
	)

	return object

end

