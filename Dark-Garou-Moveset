----------------------------------------------------------------
-- PHANTOM IDLE ANIMATION
----------------------------------------------------------------
-- Procedural idle.
--
-- This does not require a separate animation asset.
-- It subtly moves the torso/arms while standing still.
----------------------------------------------------------------

local function StartPhantomIdle(character, humanoid)

	if not CONFIG.PHANTOM_IDLE_ENABLED then
		return
	end

	if SESSION.IdleConn then
		pcall(function()
			SESSION.IdleConn:Disconnect()
		end)

		SESSION.IdleConn = nil
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	local motors = {}

	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("Motor6D") then

			local n =
				string.lower(
					obj.Name
				)

			if
				string.find(n, "waist")
				or string.find(n, "root")
				or string.find(n, "shoulder")
				or string.find(n, "neck")
			then

				table.insert(
					motors,
					{
						Motor = obj,
						Original = obj.Transform,
						Name = n,
					}
				)

			end

		end

	end

	local idleStart = tick()

	SESSION.IdleConn =
		RunService.RenderStepped:Connect(
			function()

				if
					not character.Parent
					or humanoid.Health <= 0
				then

					if SESSION.IdleConn then
						SESSION.IdleConn:Disconnect()
						SESSION.IdleConn = nil
					end

					return
				end

				local moving =
					humanoid.MoveDirection.Magnitude > 0.05

				local state =
					humanoid:GetState()

				if moving
					or state == Enum.HumanoidStateType.Jumping
					or state == Enum.HumanoidStateType.Freefall
				then

					for _, data in ipairs(motors) do

						pcall(function()

							data.Motor.Transform =
								data.Motor.Transform:Lerp(
									data.Original,
									0.15
								)

						end)

					end

					return
				end

				local t =
					tick() - idleStart

				local breathe =
					math.sin(
						t * CONFIG.PHANTOM_IDLE_SPEED
					)

				local breathe2 =
					math.sin(
						t * CONFIG.PHANTOM_IDLE_SPEED * 0.5
					)

				for _, data in ipairs(motors) do

					local motor =
						data.Motor

					local transform =
						data.Original

					pcall(function()

						if string.find(
							data.Name,
							"waist"
						) then

							motor.Transform =
								transform
								* CFrame.Angles(
									0,
									breathe
										* CONFIG.PHANTOM_IDLE_STRENGTH,
									breathe2
										* 0.025
								)

						elseif string.find(
							data.Name,
							"shoulder"
						) then

							local side =
								string.find(
									data.Name,
									"left"
								)
								and -1
								or 1

							motor.Transform =
								transform
								* CFrame.Angles(
									breathe
										* 0.018
										* side,
									0,
									breathe2
										* 0.025
										* side
								)

						elseif string.find(
							data.Name,
							"neck"
						) then

							motor.Transform =
								transform
								* CFrame.Angles(
									breathe
										* 0.025,
									breathe2
										* 0.04,
									0
								)

						elseif string.find(
							data.Name,
							"root"
						) then

							motor.Transform =
								transform
								* CFrame.Angles(
									0,
									breathe2
										* 0.015,
									0
								)

						end

					end)

				end

			end
		)

end

