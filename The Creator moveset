-- ================================================================
-- CHARACTER SETUP
-- ================================================================

local function cleanupCharacter()
	stopCreatorRun()
	cleanupTracks()
	clearAura()

	disconnectList(
		State.CharacterConnections
	)

	State.M1Busy = false
	State.VoidBusy = false
end

local function setupCharacter(character: Model)
	State.Token += 1

	local token = State.Token

	cleanupCharacter()

	State.Character = character

	local humanoid = character:WaitForChild(
		"Humanoid",
		10
	)

	local root = character:WaitForChild(
		"HumanoidRootPart",
		10
	)

	if not humanoid
		or not root
		or not root:IsA("BasePart")
	then
		return
	end

	State.Humanoid = humanoid
	State.Root = root

	creatorAura(character)

	-- Spawn FX.
	task.delay(
		0.15,
		function()
			if token ~= State.Token then
				return
			end

			if not root.Parent then
				return
			end

			playAnimation(
				humanoid,
				ANIM.Spawn,
				Enum.AnimationPriority.Action4,
				1,
				false
			)

			creatorBurst(
				root.Position,
				8,
				0.25
			)

			creatorRing(
				root.Position,
				5,
				0.4
			)

			glitchBurst(12)

			creatorHeadText(
				"THE CREATOR HAS ARRIVED"
			)
		end
	)

	addConnection(
		humanoid.Died:Connect(function()
			State.Busy = false
			State.M1Busy = false
			State.VoidBusy = false

			stopCreatorRun()
			cleanupTracks()
			clearAura()

			creatorHeadText(
				"CREATOR CONNECTION LOST"
			)
		end),
		true
	)

	-- Keep Creator UI alive because TSB can rebuild it.
	task.spawn(function()
		for _ = 1, 80 do
			if token ~= State.Token then
				return
			end

			styleAllUI()

			task.wait(0.1)
		end
	end)

	createMobileM1()
	setupTools()
end

-- ================================================================
-- INPUT
-- ================================================================

local function setupInput()
	disconnectList(State.Connections)

	addConnection(
		UserInputService.InputBegan:Connect(
			function(input, processed)
				if processed then
					return
				end

				if input.UserInputType
					== Enum.UserInputType.MouseButton1
				then
					creatorM1()
					return
				end

				if input.UserInputType
					== Enum.UserInputType.Touch
				then
					-- Ignore touches landing on our GUI button.
					local position = input.Position

					local gui = getEffectGui()

					if gui then
						local button = gui:FindFirstChild(
							"CreatorM1Button"
						)

						if button
							and button:IsA("GuiObject")
						then
							local pos = button.AbsolutePosition
							local size = button.AbsoluteSize

							if position.X >= pos.X
								and position.X <= pos.X + size.X
								and position.Y >= pos.Y
								and position.Y <= pos.Y + size.Y
							then
								return
							end
						end
					end

					creatorM1()
				end

				if input.KeyCode
					== Enum.KeyCode.Q
				then
					task.spawn(creatorVoidTP)
				end
			end
		)
	)
end

