		)

	if not humanoid then
		return
	end

	playAnimation(
		humanoid,
		ANIM.Spawn,
		Enum.AnimationPriority.Action4,
		0.92,
		false,
		0.04
	)

	creatorBurst(
		root,
		9,
		0.23
	)

	creatorRing(
