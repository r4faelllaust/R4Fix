local GLITCH_CHARS = {
	"#",
	"%",
	"/",
	"0",
	"1",
	"X",
	"!",
	"?",
	"█",
	"░",
	"▒",
}

local function randomGlitchString(
	text: string
)
	local output = ""

	for i = 1, #text do
		local character =
			text:sub(i, i)

		if math.random() < 0.12 then
			character =
				GLITCH_CHARS[
					math.random(
						1,
						#GLITCH_CHARS
					)
				]
		end

		output ..= character
	end

	return output
end

