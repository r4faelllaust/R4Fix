local function styleTextObject(
	object: Instance?,
	text: string
)
	if object
		and object:IsA(
			"TextLabel"
		)
	then
		object.Text =
			text

		object.TextColor3 =
			CREATOR_GREEN

		object.TextStrokeColor3 =
			BLACK

		object.TextStrokeTransparency =
			0.15
	end
end

local function glitchSlot(
	index: number
)
	local slot =
		getSlot(index)

	if not slot then
		return
	end

	local base =
		slot:FindFirstChild(
			"Base"
		)

	if not base
		or not base:IsA(
			"GuiObject"
		)
	then
		return
	end

	local originalPosition =
		base.Position

	local originalRotation =
		base.Rotation

	base.Position =
		originalPosition
		+ UDim2.fromOffset(
			math.random(
				-3,
				3
			),
			math.random(
				-2,
				2
			)
		)

	base.Rotation =
		originalRotation
		+ math.random(
			-2,
			2
		)

	local pixel =
		Instance.new("Frame")

	pixel.Name =
		"CreatorHotbarCorruption"

	pixel.BorderSizePixel =
		0

	pixel.BackgroundColor3 =
		math.random() < 0.7
		and CREATOR_GREEN
		or BLACK

	pixel.BackgroundTransparency =
		0.1

	pixel.Size =
		UDim2.fromOffset(
			math.random(
				2,
				7
			),
			math.random(
				2,
				6
			)
		)

	pixel.Position =
		UDim2.fromScale(
			math.random(),
			math.random()
		)

	pixel.ZIndex =
		100

	pixel.Parent =
		base

	task.delay(
		math.random(
			3,
			8
		) / 100,
		function()
			if pixel.Parent then
				pixel:Destroy()
			end

			if base.Parent then
				base.Position =
					originalPosition

				base.Rotation =
					originalRotation
			end
		end
	)
end

local function styleMoveSlot(
	index: number
)
	local slot =
		getSlot(index)

	if not slot then
		return
	end

	local base =
		slot:FindFirstChild(
			"Base"
		)

	if not base then
		return
	end

	local toolName =
		base:FindFirstChild(
			"ToolName"
		)

	styleTextObject(
		toolName,
		MOVE_NAMES[index]
	)

	local reuse =
		base:FindFirstChild(
			"Reuse"
		)

	if reuse
		and reuse:IsA(
			"TextLabel"
		)
	then
		reuse.Visible =
			true

		reuse.Text =
			MOVE_LABELS[index]

		reuse.TextColor3 =
			CREATOR_GREEN

		reuse.TextStrokeColor3 =
			BLACK

		reuse.TextStrokeTransparency =
			0.15
	end

	local cooldown =
		base:FindFirstChild(
			"Cooldown"
		)

	if cooldown then
		for _, object in ipairs(
			cooldown:GetDescendants()
		) do
			if object:IsA(
				"Frame"
			) then
				object.BackgroundColor3 =
					CREATOR_GREEN

			elseif object:IsA(
				"ImageLabel"
			)
				or object:IsA(
					"ImageButton"
				)
			then
				object.ImageColor3 =
					CREATOR_GREEN
			end
		end
	end

	if base:IsA(
		"GuiObject"
	) then
		base.ClipsDescendants =
			false
	end
end

local function glitchHotbar()
	for i = 1, 4 do
		if math.random() < 0.42 then
			glitchSlot(i)
		end
	end
end

