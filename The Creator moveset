				0.25
			)

			task.wait(
				0.035
			)

			if not root.Parent
				or humanoid.Health <= 0
			then
				return
			end

			local destination =
				mouse.Hit.Position

			root.CFrame =
				CFrame.lookAt(
					destination
						+ Vector3.new(
							0,
							2.5,
							0
						),
					destination
				)

			root.AssemblyLinearVelocity =
				Vector3.zero

			creatorBurst(
				root,
				6,
				0.16
			)

			cloneResourceByName(
				"TP",
				root,
				7,
				0.28
			)

			glitchBurst()
		end
	)
end

