local function isOldCreatorName(
	text: string
)
	local lower =
		string.lower(
			text
		)

	return lower == "dark garou"
		or lower == "garou"
		or lower == "hero hunter"
		or lower == "the creator"
		or lower:find(
			"dark garou"
		) ~= nil
end

local function applyTopbarToContainer(
	container: Instance
)
	for _, descendant in ipairs(
		container:GetDescendants()
	) do
		if descendant.Name
			~= "IconButton"
		then
			continue
		end

		local label =
			descendant:FindFirstChild(
				"IconLabel"
			)

		local image =
			descendant:FindFirstChild(
				"IconImage"
			)

		if label
			and label:IsA(
				"TextLabel"
			)
		then
			local text =
				label.Text

			if isOldCreatorName(
				text
			)
			then

				-- The actual selector name.
				label.Text =
					getGlitchedCreatorName()

				label.TextColor3 =
					CREATOR_GREEN

				label.TextStrokeColor3 =
					BLACK

				label.TextStrokeTransparency =
					0

				if image
					and (
						image:IsA(
							"ImageLabel"
						)
						or image:IsA(
							"ImageButton"
						)
					)
				then

					image.Image =
						DECAL_ID

					image.ImageColor3 =
						WHITE
				end

				if descendant:IsA(
					"GuiObject"
				)
				then
					descendant.Visible =
						true
				end
			end
		end
	end
end

local function fixTopbarPlus()
	local playerGui =
		getPlayerGui()

	if not playerGui then
		return
	end

	-- Primary known container.
	local topbar =
		playerGui:FindFirstChild(
			"TopbarPlus"
		)

	if topbar then
		applyTopbarToContainer(
			topbar
		)
	end

	-- Also scan PlayerGui in case TopbarPlus
	-- is nested differently.
	for _, descendant in ipairs(
		playerGui:GetDescendants()
	) do

		if descendant.Name
			~= "IconButton"
		then
			continue
		end

		local label =
			descendant:FindFirstChild(
				"IconLabel"
			)

		if label
			and label:IsA(
				"TextLabel"
			)
			and isOldCreatorName(
				label.Text
			)
		then
			applyTopbarToContainer(
				descendant.Parent
					or playerGui
			)
		end
	end
end

