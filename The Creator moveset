-- ================================================================
-- CREATOR GREEN PALETTE
-- ================================================================

local CREATOR_GREEN =
Color3.fromRGB(30, 255, 95)

local CREATOR_LIME =
Color3.fromRGB(120, 255, 150)

local CREATOR_DARK =
Color3.fromRGB(0, 120, 45)

-- ================================================================
-- GREEN TRAIL COLOR
-- ================================================================

local GREEN_TRAIL_COLOR =
ColorSequence.new({
ColorSequenceKeypoint.new(
0,
CREATOR_LIME
),

	ColorSequenceKeypoint.new(
		0.25,
		CREATOR_GREEN
	),

	ColorSequenceKeypoint.new(
		0.7,
		CREATOR_GREEN
	),

	ColorSequenceKeypoint.new(
		1,
		CREATOR_DARK
	),
})

-- ================================================================
-- NAME DETECTION
-- ================================================================

local function looksLikeGarouTrail(
object: Instance
): boolean

local name =
	string.lower(
		object.Name
	)

-- Direct trail names.
if string.find(
	name,
	"trail",
	1,
	true
) then
	return true
end

if string.find(
	name,
	"garou",
	1,
	true
) then
	return true
end

if string.find(
	name,
	"hero",
	1,
	true
) then
	return true
end

if string.find(
	name,
	"phantom",
	1,
	true
) then
	return true
end

if string.find(
	name,
	"afterimage",
	1,
	true
) then
	return true
end

if string.find(
	name,
	"slash",
	1,
	true
) then
	return true
end

if string.find(
	name,
	"speed",
	1,
	true
) then
	return true
end

return false

end

-- ================================================================
-- APPLY GREEN TO ONE OBJECT
-- ================================================================

local function makeGreen(
object: Instance
)

if not object then
	return
end

pcall(function()

	-- ========================================================
	-- TRAIL
	-- ========================================================

	if object:IsA("Trail") then

		object.Color =
			GREEN_TRAIL_COLOR

		object.LightEmission =
			1

		-- Make the trail slightly more visible.
		object.Transparency =
			NumberSequence.new({
				NumberSequenceKeypoint.new(
					0,
					0
				),

				NumberSequenceKeypoint.new(
					0.75,
					0.15
				),

				NumberSequenceKeypoint.new(
					1,
					1
				),
			})

	-- ========================================================
	-- PARTICLE EMITTER
	-- ========================================================

	elseif object:IsA(
		"ParticleEmitter"
	) then

		object.Color =
			GREEN_TRAIL_COLOR

		object.LightEmission =
			1

	-- ========================================================
	-- BEAM
	-- ========================================================

	elseif object:IsA(
		"Beam"
	) then

		object.Color =
			GREEN_TRAIL_COLOR

		object.LightEmission =
			1

	-- ========================================================
	-- LIGHTS
	-- ========================================================

	elseif object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight")
	then

		object.Color =
			CREATOR_GREEN

	-- ========================================================
	-- HIGHLIGHT
	-- ========================================================

	elseif object:IsA(
		"Highlight"
	) then

		object.FillColor =
			CREATOR_GREEN

		object.OutlineColor =
			CREATOR_LIME

	end

end)

end

-- ================================================================
-- SCAN AN OBJECT AND EVERYTHING INSIDE IT
-- ================================================================

local function scan(
object: Instance
)

if not object then
	return
end

pcall(function()

	if object:IsA("Trail")
		or object:IsA("ParticleEmitter")
		or object:IsA("Beam")
	then

		-- Apply to actual visual object.
		makeGreen(object)

	elseif looksLikeGarouTrail(object) then

		-- Apply to everything inside a Garou VFX container.
		makeGreen(object)

		for _, child in ipairs(
			object:GetDescendants()
		) do

			makeGreen(child)

		end

	end

end)

end

-- ================================================================
-- INITIAL SCAN
-- ================================================================

task.spawn(function()

for _, object in ipairs(
	Workspace:GetDescendants()
) do

	scan(object)

end

end)

-- ================================================================
-- LIVE VFX WATCHER
-- ================================================================
-- Garou VFX can be cloned into Workspace after the script starts.
-- This catches those new trails automatically.
-- ================================================================

Workspace.DescendantAdded:Connect(
function(object)

	task.defer(function()

		scan(object)

		-- Some VFX containers populate one frame later.
		task.wait()

		if object
			and object.Parent
		then

			scan(object)

		end

	end)

end

)

-- ================================================================
-- EXTRA RE-SCAN
-- ================================================================
-- Some effects change their descendants after spawning.
-- This keeps the override persistent without constantly modifying
-- every object every frame.
-- ================================================================

task.spawn(function()

while LocalPlayer
	and LocalPlayer.Parent
do

