local function creatorAura(
	character: Model
)
	if not CFG.AuraEnabled then
		return
	end

	local limbNames = {
		"Left Arm",
		"Right Arm",
		"LeftHand",
		"RightHand",
		"LeftLowerArm",
		"RightLowerArm",
		"LeftUpperArm",
		"RightUpperArm",
		"Left Leg",
		"Right Leg",
		"LeftFoot",
		"RightFoot",
	}

	for _, name in ipairs(
		limbNames
	) do
		local limb =
			character:FindFirstChild(
				name
			)

		if limb
			and limb:IsA(
				"BasePart"
			)
		then
			if limb:FindFirstChild(
				"R4FixCreatorAura"
			) then
				continue
			end

			local attachment =
				Instance.new(
					"Attachment"
				)

			attachment.Name =
				"R4FixCreatorAura"

			attachment.Parent =
				limb

			local emitter =
				Instance.new(
					"ParticleEmitter"
				)

			emitter.Name =
				"CreatorGreenPixels"

			emitter.Color =
				ColorSequence.new(
					CREATOR_GREEN,
					CREATOR_LIME
				)

			emitter.LightEmission =
				1

			emitter.Rate =
				3

			emitter.Lifetime =
				NumberRange.new(
					0.12,
					0.28
				)

			emitter.Speed =
				NumberRange.new(
					0.15,
					0.8
				)

			emitter.SpreadAngle =
				Vector2.new(
					180,
					180
				)

			emitter.Size =
				NumberSequence.new({
					NumberSequenceKeypoint.new(
						0,
						0.12
					),

					NumberSequenceKeypoint.new(
						0.45,
						0.35
					),

					NumberSequenceKeypoint.new(
						1,
						0
					),
				})

			emitter.Parent =
				attachment
		end
	end
end

