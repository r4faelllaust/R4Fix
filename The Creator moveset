local function createTeleportTool()
	local name =
		"Creator Void TP"

	destroyTool(name)

	local backpack =
		LocalPlayer:WaitForChild(
			"Backpack"
		)

	local tool =
		Instance.new("Tool")

	tool.Name =
		name

