local GLITCH_CHARS = {
	"█",
	"▓",
	"▒",
	"░",
	"0",
	"1",
	"/",
	"\\",
	"|",
	"%",
	"#",
	"?",
}

local function randomGlitchString(text: string): string
	local chars = {}

	for i = 1, #text do
		local character = text:sub(i, i)

		if character == " " then
			table.insert(chars, " ")
		elseif math.random() < 0.25 then
			table.insert(
				chars,
				GLITCH_CHARS[
					math.random(1, #GLITCH_CHARS)
				]
			)
		else
			table.insert(chars, character)
		end
	end

	return table.concat(chars)
end

-- ================================================================
-- ANIMATION
-- ================================================================

local function playAnimation(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority,
	speed: number?,
	looped: boolean?
): AnimationTrack?

	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = id

	local track: AnimationTrack?

	local success = pcall(function()
		track = animator:LoadAnimation(animation)
	end)

	animation:Destroy()

	if not success or not track then
		return nil
	end

	track.Priority = priority
	track.Looped = looped == true

	pcall(function()
		track:Play(0.05, 1, speed or 1)
	end)

	table.insert(State.Tracks, track)

	return track
end

local function stopTrack(track: AnimationTrack?)
	if not track then
		return
	end

	pcall(function()
		track:Stop(0.08)
	end)
end

local function cleanupTracks()
	for i = #State.Tracks, 1, -1 do
		local track = State.Tracks[i]

		pcall(function()
			track:Stop(0.05)
			track:Destroy()
		end)

		table.remove(State.Tracks, i)
	end
end

