local function cleanupTracks()
	for i = #S.Tracks, 1, -1 do
		local track =
			S.Tracks[i]

		pcall(function()
			track:Stop(0.08)
		end)

		S.Tracks[i] = nil
	end
end

local function playAnimation(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority,
	speed: number?,
	looped: boolean?,
	fadeTime: number?
): AnimationTrack?

	if not humanoid.Parent then
		return nil
	end

	local animator =
		humanoid:FindFirstChildOfClass(
			"Animator"
		)

	if not animator then
		animator =
			Instance.new("Animator")

		animator.Parent =
			humanoid
	end

	local animation =
		Instance.new("Animation")

	animation.AnimationId =
		id

	local track: AnimationTrack?

	local success =
		pcall(function()
			track =
				animator:LoadAnimation(
					animation
				)
		end)

	animation:Destroy()

	if not success
		or not track
	then
		return nil
	end

	track.Priority =
		priority

	track.Looped =
		looped == true

	local speedValue =
		speed or 1

	track:Play(
		fadeTime or 0.08,
		1,
		speedValue
	)

	table.insert(
		S.Tracks,
		track
	)

	track.Stopped:Connect(
		function()
			for i = #S.Tracks, 1, -1 do
				if S.Tracks[i] == track then
					table.remove(
						S.Tracks,
						i
					)

					break
				end
			end
		end
	)

	return track
end

