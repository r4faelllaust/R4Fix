		false

	tool.CanBeDropped =
		false

	tool.ToolTip =
		"THE CREATOR // VOID TP"

	tool.Parent =
		backpack

	tool.Activated:Connect(
		function()

			local character,
				humanoid,
				root =
				getCharacter()

			if not character
				or not humanoid
				or not root
			then
				return
			end

			if humanoid.Health <= 0 then
				return
			end

			local mouse

			pcall(function()
				mouse =
					LocalPlayer:GetMouse()
			end)

			if not mouse
				or not mouse.Hit
			then
				return
			end

			creatorBurst(
