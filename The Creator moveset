		0.3
	)

	playAnimation(
		humanoid,
		ANIM.Void,
		Enum.AnimationPriority.Action4,
		1.35,
		false
	)

	-- ============================================================
	-- PHASE OUT
	-- ============================================================

	for _ = 1, 5 do
		if token ~= State.Token then
			State.VoidBusy = false
			return
		end

		if not root.Parent or humanoid.Health <= 0 then
			State.VoidBusy = false
			return
		end

		local direction = Vector3.new(
			math.random(-10, 10),
			math.random(-4, 5),
			math.random(-10, 10)
		)

		root.CFrame =
			originalCFrame
			+ direction

		glitchBurst(4)

		task.wait(0.025)
	end

	-- ============================================================
	-- ACTUAL VOID LOCATION
	-- ============================================================

	local voidPosition =
		originalCFrame.Position
		+ originalCFrame.LookVector
			* CFG.VoidDistance
		+ Vector3.new(
			0,
			CFG.VoidHeight,
			0
		)

	root.CFrame = CFrame.lookAt(
		voidPosition,
		voidPosition
			+ originalCFrame.LookVector
	)

	root.AssemblyLinearVelocity = Vector3.zero

	creatorBurst(
		voidPosition,
		10,
		0.3
	)

	creatorRing(
		voidPosition,
		8,
		0.45
	)

	creatorHeadText(
		"THE VOID SEES YOU"
	)

	-- ============================================================
	-- VOID HOLD
	-- ============================================================

	local finish = os.clock() + CFG.VoidDuration

	while os.clock() < finish do
		if token ~= State.Token then
			State.VoidBusy = false
			return
		end

		if not root.Parent or humanoid.Health <= 0 then
			State.VoidBusy = false
			return
		end

		root.AssemblyLinearVelocity = Vector3.zero

		if math.random() < 0.55 then
			glitchBurst(
				math.random(2, 5)
			)
		end

		task.wait(0.06)
	end

	-- ============================================================
	-- RETURN
	-- ============================================================

	playAnimation(
		humanoid,
		ANIM.Return,
		Enum.AnimationPriority.Action4,
		1.65,
		false
	)

	glitchBurst(18)

	creatorBurst(
		voidPosition,
		12,
		0.25
	)

	task.wait(0.06)

	if token ~= State.Token then
		State.VoidBusy = false
		return
	end

	if not root.Parent or humanoid.Health <= 0 then
		State.VoidBusy = false
		return
	end

	root.CFrame = originalCFrame
	root.AssemblyLinearVelocity = Vector3.zero

	creatorBurst(
		originalCFrame.Position,
		12,
		0.28
	)

	creatorRing(
		originalCFrame.Position,
		6,
		0.4
	)

	glitchBurst(20)

	creatorHeadText(
		"CREATOR RETURNED"
	)

	task.wait(0.15)

	State.VoidBusy = false
end

-- ================================================================
-- CREATOR RUN
-- ================================================================

local runConnection: RBXScriptConnection? = nil

local function stopCreatorRun()
	State.Running = false

	if runConnection then
		pcall(function()
			runConnection:Disconnect()
		end)

		runConnection = nil
	end
end

local function startCreatorRun()
	if State.Running then
		return
	end

	local character, humanoid, root = getCharacter()

	if not character or not humanoid or not root then
		return
	end

	State.Running = true

	local track = playAnimation(
		humanoid,
		ANIM.Run,
		Enum.AnimationPriority.Movement,
		1.3,
		true
	)

	runConnection = RunService.RenderStepped:Connect(
		function()
			if not State.Running then
				return
			end

			if not root.Parent or humanoid.Health <= 0 then
				stopCreatorRun()
				return
			end

			local direction = humanoid.MoveDirection

			if direction.Magnitude > 0.05 then
				local speed =
					CFG.RunSpeed
					* CFG.RunBoost

				root.AssemblyLinearVelocity =
					Vector3.new(
						direction.X * speed,
						root.AssemblyLinearVelocity.Y,
						direction.Z * speed
					)

				if math.random() < 0.08 then
					creatorBurst(
						root.Position,
						1.5,
						0.08
					)
				end

				if math.random() < 0.06 then
					glitchBurst(2)
				end
			end
		end
	)

	task.spawn(function()
		while State.Running do
			task.wait(0.12)

			if track and not track.IsPlaying then
				pcall(function()
					track:Play(
						0.04,
						1,
						1.3
					)
				end)
			end
		end

		if track then
			stopTrack(track)
		end
	end)
end

