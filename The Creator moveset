-- ================================================================
-- TOOL HOTBAR GLITCH
-- ================================================================

local function glitchToolHotbar()
	local hotbar =
		getHotbar()

	if not hotbar then
		return
	end

	for _, slot in ipairs(
		hotbar:GetChildren()
	) do
		if not slot:IsA(
			"GuiObject"
		)
		then
			continue
		end

		local base =
			slot:FindFirstChild(
				"Base"
			)

		if not base
			or not base:IsA(
				"GuiObject"
			)
		then
			continue
		end

		local toolName =
			base:FindFirstChild(
				"ToolName"
			)

		if toolName
			and toolName:IsA(
				"TextLabel"
			)
		then
			local lower =
				string.lower(
					toolName.Text
				)

			if lower:find(
				"creator"
			)
				or lower:find(
					"void tp"
				)
			then
				toolName.TextColor3 =
					CREATOR_GREEN

				toolName.TextStrokeColor3 =
					BLACK

				toolName.TextStrokeTransparency =
					0

				if math.random() < 0.35 then
					toolName.Text =
						randomGlitchString(
							toolName.Text
						)
				end

				local slotNumber =
					tonumber(
						slot.Name
					)

				if slotNumber then
					glitchSlot(
						slotNumber
					)
				end
			end
		end
	end
end

-- ================================================================
-- ANIMATION TRIGGERS
-- ================================================================

local TRIGGERS = {
	["12273188754"] = 1,
	["12296113986"] = 2,
	["12309835105"] = 3,
	["12351854556"] = 4,
	["12460977270"] = 3,
}

local ULT_TRIGGERS = {
	["12467789963"] = 1,
	["14057231976"] = 2,
}

local function animationIdNumber(
	track: AnimationTrack
): string?
	if not track.Animation then
		return nil
	end

	local id =
		track.Animation.AnimationId

	return id:match(
		"%d+"
	)
end

local function setupMoveHandler(
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	token: number
)
	addCharacterConnection(
		humanoid.AnimationPlayed:Connect(
			function(track)
				if token ~= S.Token then
					return
				end

				local id =
					animationIdNumber(
						track
					)

				if not id then
					return
				end

				local move =
					TRIGGERS[id]

				if move then
					if move == 1 then
						task.spawn(
							move1,
							token
						)

					elseif move == 2 then
						task.spawn(
							move2,
							token
						)

					elseif move == 3 then
						task.spawn(
							move3
						)

					elseif move == 4 then
						task.spawn(
							move4
						)
					end

					return
				end

				local ult =
					ULT_TRIGGERS[id]

				if ult then
					task.spawn(
						playUltimate,
						ult
					)
				end
			end
		)
	)
end

