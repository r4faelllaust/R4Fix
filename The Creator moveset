local function setupCharacter(
	character: Model
)
	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not root
	then
		return
	end

	creatorSpawn(
		character,
		root
	)

	creatorAura(
		character
	)

	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)

	-- UI can be rebuilt by TSB, so refresh repeatedly.
	task.spawn(function()

		for _ = 1, 50 do

			if token ~= S.Token then
				return
			end

			pcall(function()
				fixCreatorSelection()
				styleUltimateBar()

				for i = 1, 4 do
					styleMoveSlot(i)
				end

				glitchToolHotbar()
			end)

			task.wait(
				0.1
			)
		end
	end)

	task.delay(
		0.45,
		function()

			if token ~= S.Token then
				return
			end

			setupTools()
		end
	)

	addCharacterConnection(
		humanoid.Died:Connect(
			function()

				S.Busy = {}

				cleanupTracks()

				creatorHeadText(
					"CREATOR CONNECTION LOST"
				)
			end
		)
	)

	addCharacterConnection(
		character.AncestryChanged:Connect(
			function(_, parent)

				if not parent then
					S.Token += 1
				end
			end
		)
	)
end

