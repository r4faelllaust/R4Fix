local function getCharacter()
	local character = LocalPlayer.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid or not root then
		return nil, nil, nil
	end

	return character, humanoid, root
end

local function getAnimator(
	humanoid: Humanoid
)
	local animator =
		humanoid:FindFirstChildOfClass(
			"Animator"
		)

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	return animator
end

local function playAnimation(
	humanoid: Humanoid,
	id: string,
	priority: Enum.AnimationPriority?,
	speed: number?,
	looped: boolean?,
	duration: number?
)
	if humanoid.Health <= 0 then
		return nil
	end

	local animator =
		getAnimator(humanoid)

	local animation =
		Instance.new("Animation")

	animation.AnimationId = id

	local success, track =
		pcall(function()
			return animator:LoadAnimation(
				animation
			)
		end)

	animation:Destroy()

	if not success or not track then
		return nil
	end

	track.Priority =
		priority
		or Enum.AnimationPriority.Action4

	track.Looped =
		looped == true

	table.insert(
		S.Tracks,
		track
	)

	pcall(function()
		track:Play(
			0.035,
			1,
			speed or 1
		)
	end)

	if duration then
		task.delay(
			duration,
			function()
				pcall(function()
					if track.IsPlaying then
						track:Stop(0.055)
					end
				end)
			end
		)
	end

	return track
end

-- ================================================================
