local function validTarget(model: Model): boolean
	if model == State.Character then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return false
	end

	if not root:IsA("BasePart") then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return true
end

local function getNearestEnemy(
	maxDistance: number
): Model?
	local _, _, root = getCharacter()

	if not root then
		return nil
	end

	local closest: Model? = nil
	local closestDistance = maxDistance

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character

			if character and validTarget(character) then
				local targetRoot = character:FindFirstChild(
					"HumanoidRootPart"
				)

				if targetRoot and targetRoot:IsA("BasePart") then
					local distance = (
						targetRoot.Position - root.Position
					).Magnitude

					if distance < closestDistance then
						closestDistance = distance
						closest = character
					end
				end
			end
		end
	end

	return closest
end

