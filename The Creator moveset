-- ================================================================

local function destroyTool(
	name: string
)
	local backpack =
		LocalPlayer:FindFirstChild(
			"Backpack"
		)

	if backpack then
		for _, object in ipairs(
			backpack:GetChildren()
		) do
			if object:IsA("Tool")
				and object.Name == name
			then
				object:Destroy()
			end
		end
	end

	local character =
		LocalPlayer.Character

	if character then
		for _, object in ipairs(
			character:GetChildren()
		) do
			if object:IsA("Tool")
				and object.Name == name
			then
				object:Destroy()
			end
		end
	end
end

-- ================================================================
-- VOID TP TOOL
-- ================================================================

local function createTeleportTool()
	local name =
		"Creator Void TP"

	destroyTool(
		name
	)

	local backpack =
		LocalPlayer:WaitForChild(
			"Backpack"
		)

	local tool =
		Instance.new("Tool")

	tool.Name =
		name

	tool.RequiresHandle =
		false

	tool.CanBeDropped =
		false

	tool.ToolTip =
		"THE CREATOR // VOID TP"

	tool.TextureId =
		DECAL_ID

	tool.Parent =
		backpack

	tool.Activated:Connect(
		function()
			local character,
				humanoid,
				root =
				getCharacter()

			if not character
				or not humanoid
				or not root
				or humanoid.Health <= 0
			then
				return
			end

			local mouse

			pcall(function()
				mouse =
					LocalPlayer:GetMouse()
			end)

			if not mouse
				or not mouse.Hit
			then
				return
			end

			local destination =
				mouse.Hit.Position

			creatorBurst(
				root,
				5,
				0.13
			)

			playAnimation(
				humanoid,
				ANIM.Void,
				Enum.AnimationPriority.Action4,
				1.5,
				false,
				0.02
			)

			task.wait(
				0.035
			)

			if not root.Parent
				or humanoid.Health <= 0
			then
				return
			end

			root.CFrame =
				CFrame.lookAt(
					destination
					+ Vector3.new(
						0,
						2.5,
						0
					),
					destination
				)

			root.AssemblyLinearVelocity =
				Vector3.zero

			creatorBurst(
				root,
				7,
				0.2
			)

			cameraShake(
				0.35,
				0.1
			)

			glitchBurst(
				10
			)
		end
	)
end

-- ================================================================
-- RUN TOOL
-- ================================================================

local function createRunTool()
	local name =
		"Creator Run"

	destroyTool(
		name
	)

	local backpack =
		LocalPlayer:WaitForChild(
			"Backpack"
		)

	local tool =
		Instance.new("Tool")

	tool.Name =
		name

	tool.RequiresHandle =
		false

	tool.CanBeDropped =
		false

	tool.ToolTip =
		"THE CREATOR // RUN"

	tool.TextureId =
		DECAL_ID

	tool.Parent =
		backpack

	local active =
		false

	local connection:
		RBXScriptConnection? =
		nil

	local track:
		AnimationTrack? =
		nil

	local function stop()
		active =
			false

		if connection then
			pcall(function()
				connection:Disconnect()
			end)

			connection =
				nil
		end

		if track then
			pcall(function()
				track:Stop(
					0.08
				)
			end)

			track =
				nil
		end
	end

	tool.Equipped:Connect(
		function()
			if active then
				return
			end

			local character,
				humanoid,
				root =
				getCharacter()

			if not character
				or not humanoid
				or not root
			then
				return
			end

			active =
				true

			track =
				playAnimation(
					humanoid,
					ANIM.Run,
					Enum.AnimationPriority.Movement,
					1.15,
					true,
					0.08
				)

			connection =
				RunService.RenderStepped:Connect(
					function()
						if not active
							or not root.Parent
							or humanoid.Health <= 0
						then
							stop()
							return
						end

						local direction =
							humanoid.MoveDirection

						if direction.Magnitude
							> 0.05
						then
							root.AssemblyLinearVelocity =
								Vector3.new(
									direction.X
										* CFG.RunSpeed,

									root.AssemblyLinearVelocity.Y,

									direction.Z
										* CFG.RunSpeed
								)
						end
					end
				)
		end
	)

	tool.Unequipped:Connect(
		stop
	)

	tool.AncestryChanged:Connect(
		function(_, parent)
			if not parent then
				stop()
			end
		end
	)
end

