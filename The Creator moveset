local function disconnectList(
	list: {RBXScriptConnection}
)
	for i = #list, 1, -1 do
		local connection =
			list[i]

		pcall(function()
			connection:Disconnect()
		end)

		list[i] = nil
	end
end

local function addCharacterConnection(
	connection: RBXScriptConnection
)
	table.insert(
		S.CharacterConnections,
		connection
	)

	return connection
end

local function cleanupCharacter()
	disconnectList(
		S.CharacterConnections
	)
end

-- ================================================================
-- CHARACTER
