		2,
		23,
		0.35
	)

	creatorHeadText(
		"THE CREATOR HAS ARRIVED"
	)
end

-- ================================================================
-- CHARACTER SETUP
-- ================================================================

local function setupCharacter(
	character: Model
)
	S.Token += 1

	local token =
		S.Token

	cleanupCharacter()
	cleanupTracks()

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	local root =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not humanoid
		or not root
		or not root:IsA(
			"BasePart"
		)
	then
		return
	end

	S.Busy = {}

	creatorSpawn(
		character,
		root
	)

	creatorAura(
		character
	)

	setupMoveHandler(
		character,
		humanoid,
		root,
		token
	)

	-- ============================================================
	-- UI REFRESH
	-- ============================================================

	task.spawn(function()
		for _ = 1, 50 do
			if token ~= S.Token then
				return
			end

			pcall(function()
				fixCreatorSelection()
				styleUltimateBar()

				for i = 1, 4 do
					styleMoveSlot(i)
				end

				glitchToolHotbar()
			end)

			task.wait(
				0.1
			)
		end
	end)

	-- ============================================================
	-- TOOLS
	-- ============================================================

	task.delay(
		0.45,
		function()
			if token ~= S.Token then
				return
			end

			setupTools()
		end
	)

	-- ============================================================
	-- DEATH
	-- ============================================================

	addCharacterConnection(
		humanoid.Died:Connect(
			function()
				S.Busy = {}

				cleanupTracks()

				creatorHeadText(
					"CREATOR CONNECTION LOST"
				)
			end
		)
	)

	-- ============================================================
	-- CHARACTER REMOVAL
	-- ============================================================

	addCharacterConnection(
		character.AncestryChanged:Connect(
			function(_, parent)
				if not parent then
					S.Token += 1
				end
			end
		)
	)
end

