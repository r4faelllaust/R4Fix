local function isValidTarget(
	model: Model,
	ownCharacter: Model
)
	if model == ownCharacter then
		return false
	end

	local humanoid =
		model:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		model:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return true
end

local function findClosestTarget(
	origin: Vector3
)
	local ownCharacter =
		LocalPlayer.Character

	if not ownCharacter then
		return nil
	end

	local live =
		Workspace:FindFirstChild("Live")

	local candidates: Instance =
		live or Workspace

	local best: Model? = nil
	local bestDistance =
		CFG.TargetRange

	-- First search Live because TSB
	-- normally keeps combat characters there.
	for _, object in ipairs(
		candidates:GetChildren()
	) do
		if object:IsA("Model")
			and isValidTarget(
				object,
				ownCharacter
			)
		then
			local root =
				object:FindFirstChild(
					"HumanoidRootPart"
				)

			if root then
				local distance =
					(root.Position - origin).Magnitude

				if distance < bestDistance then
					bestDistance = distance
					best = object
				end
			end
		end
	end

	return best
end

-- ================================================================
-- FIXED M1 TELEPORT
-- ================================================================

local function teleportBehindTarget(
	target: Model
)
	local character, humanoid, root =
		getCharacter()

	if not character
		or not humanoid
		or not root
	then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	local targetHumanoid =
		target:FindFirstChildOfClass(
			"Humanoid"
		)

	if not targetRoot
		or not targetHumanoid
		or targetHumanoid.Health <= 0
	then
		return false
	end

	-- Recheck distance immediately before TP.
	local distance =
		(root.Position - targetRoot.Position).Magnitude

	if distance > CFG.TargetRange then
		return false
	end

	-- IMPORTANT:
	-- LookVector points toward the direction the enemy
	-- is facing. Subtracting it places us BEHIND them.
	local behindPosition =
		targetRoot.Position
		- targetRoot.CFrame.LookVector
			* CFG.M1BehindDistance

	-- Keep the player's current vertical level close to
	-- the target, preventing weird underground teleports.
	behindPosition = Vector3.new(
		behindPosition.X,
		targetRoot.Position.Y + 0.15,
		behindPosition.Z
	)

	root.CFrame =
		CFrame.lookAt(
			behindPosition,
			targetRoot.Position
		)

	root.AssemblyLinearVelocity =
		Vector3.zero

	return true
end

