-- ================================================================
-- CREATOR M1
-- ================================================================

local function creatorM1()
	if State.M1Busy then
		return
	end

	if not alive() then
		return
	end

	local now = os.clock()

	if now - State.LastM1 < CFG.M1Cooldown then
		return
	end

	State.LastM1 = now
	State.M1Busy = true

	local character, humanoid, root = getCharacter()

	if not character or not humanoid or not root then
		State.M1Busy = false
		return
	end

	local token = State.Token

	local target = getNearestEnemy(CFG.M1Range)

	-- ============================================================
	-- NO TARGET
	-- ============================================================

	if not target then
		creatorBurst(
			root.Position,
			3,
			0.15
		)

		glitchBurst(3)

		local track = playAnimation(
			humanoid,
			ANIM.M1,
			Enum.AnimationPriority.Action4,
			1.65,
			false
		)

		if track then
			task.delay(
				0.18,
				function()
					stopTrack(track)
				end
			)
		end

		task.delay(
			0.08,
			function()
				State.M1Busy = false
			end
		)

		return
	end

	local targetRoot = target:FindFirstChild(
		"HumanoidRootPart"
	)

	if not targetRoot or not targetRoot:IsA("BasePart") then
		State.M1Busy = false
		return
	end

	-- ============================================================
	-- TARGET LOCK
	-- ============================================================

	targetGlitch(target)

	local targetPosition = targetRoot.Position

	-- Behind target relative to target's facing direction.
	local behindPosition =
		targetPosition
		- targetRoot.CFrame.LookVector
			* CFG.M1BehindDistance

	behindPosition += Vector3.new(
		0,
		CFG.M1HeightOffset,
		0
	)

	-- ============================================================
	-- PRE-TP GLITCH
	-- ============================================================

	creatorBurst(
		root.Position,
		4,
		0.12
	)

	creatorRing(
		root.Position,
		3,
		0.18
	)

	glitchBurst(7)

	-- ============================================================
	-- TELEPORT BEHIND TARGET
	-- ============================================================

	root.CFrame = CFrame.lookAt(
		behindPosition,
		targetPosition
	)

	root.AssemblyLinearVelocity = Vector3.zero

	creatorBurst(
		behindPosition,
		4,
		0.12
	)

	creatorSlash(
		CFrame.lookAt(
			behindPosition,
			targetPosition
		)
		* CFrame.new(0, 0, -2),
		5
	)

	-- ============================================================
	-- M1 ANIMATION
	-- ============================================================

	local track = playAnimation(
		humanoid,
		ANIM.M1,
		Enum.AnimationPriority.Action4,
		1.75,
		false
	)

	-- Fast camera-facing glitch movement.
	task.spawn(function()
		local start = os.clock()

		while os.clock() - start < 0.22 do
			if token ~= State.Token then
				return
			end

			if not root.Parent or humanoid.Health <= 0 then
				return
			end

			if targetRoot.Parent then
				local offset =
					math.sin(
						(os.clock() - start) * 65
					) * 0.14

				root.CFrame =
					CFrame.lookAt(
						targetRoot.Position
						- targetRoot.CFrame.LookVector
							* CFG.M1BehindDistance
						+ Vector3.new(
							offset,
							0,
							0
						),
						targetRoot.Position
					)
			end

			RunService.RenderStepped:Wait()
		end
	end)

	task.delay(
		0.12,
		function()
			if token ~= State.Token then
				return
			end

			creatorBurst(
				targetPosition,
				5,
				0.18
			)

			creatorSlash(
				CFrame.lookAt(
					targetPosition,
					behindPosition
				),
				7
			)

			glitchBurst(8)
		end
	)

	task.delay(
		0.3,
		function()
			if track then
				stopTrack(track)
			end

			State.M1Busy = false
		end
	)
end

