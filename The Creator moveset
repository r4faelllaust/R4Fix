local MOVE_NAMES = {
	[1] = "VOID CREATION",
	[2] = "REALITY BREAKER",
	[3] = "CREATOR'S GRASP",
	[4] = "ABSOLUTE OVERRIDE",
}

local MOVE_LABELS = {
	[1] = "|| VOID TP ||",
	[2] = "|| PHANTOM ||",
	[3] = "|| CREATION ||",
	[4] = "|| OVERRIDE ||",
}

local function styleText(object: Instance?, text: string)
	if object and object:IsA("TextLabel") then
		object.Text = text
		object.TextColor3 = CREATOR_GREEN
		object.TextStrokeColor3 = BLACK
		object.TextStrokeTransparency = 0
	end
end

local function findHotbar(): Instance?
	local gui = getPlayerGui()

	if not gui then
		return nil
	end

	local hotbar = gui:FindFirstChild("Hotbar", true)

	if hotbar then
		return hotbar
	end

	local backpack = gui:FindFirstChild("Backpack", true)

	if backpack then
		return backpack:FindFirstChild("Hotbar", true)
	end

	return nil
end

local function styleMoveSlot(index: number)
	local hotbar = findHotbar()

	if not hotbar then
		return
	end

	local slot = hotbar:FindFirstChild(
		tostring(index),
		true
	)

	if not slot then
		return
	end

	local base = slot:FindFirstChild(
		"Base",
		true
	)

	if not base then
		return
	end

	local toolName = base:FindFirstChild(
		"ToolName",
		true
	)

	styleText(
		toolName,
		MOVE_NAMES[index]
	)

	local reuse = base:FindFirstChild(
		"Reuse",
		true
	)

	styleText(
		reuse,
		MOVE_LABELS[index]
	)

	for _, object in ipairs(
		base:GetDescendants()
	) do
		if object:IsA("Frame") then
			if object.Name == "Cooldown"
				or object.Name == "Bar"
				or object.Name == "Fill"
			then
				object.BackgroundColor3 =
					CREATOR_GREEN
			end
		elseif object:IsA("ImageLabel")
			or object:IsA("ImageButton")
		then
			if object.Name == "Cooldown"
				or object.Name == "Glow"
			then
				object.ImageColor3 =
					CREATOR_GREEN
			end
		end
	end
end

local function styleUltimateBar()
	local gui = getPlayerGui()

	if not gui then
		return
	end

	local magicHealth = gui:FindFirstChild(
		"MagicHealth",
		true
	)

	if not magicHealth then
		return
	end

	for _, object in ipairs(
		magicHealth:GetDescendants()
	) do
		if object:IsA("TextLabel") then
			local lower = string.lower(object.Text)

			if lower:find("garou")
				or lower:find("hero hunter")
				or lower:find("ultimate")
				or lower == ""
			then
				object.Text = "THE CREATOR"
			end

			object.TextColor3 = CREATOR_GREEN
			object.TextStrokeColor3 = BLACK
			object.TextStrokeTransparency = 0.1
		end

		if object:IsA("Frame") then
			if object.Name == "Bar"
				or object.Name == "Fill"
				or object.Name == "Health"
			then
				object.BackgroundColor3 =
					CREATOR_GREEN
			end
		end
	end
end

-- ================================================================
-- TOPBAR / GAROU REPLACEMENT
-- ================================================================

local function isOldName(text: string): boolean
	local lower = string.lower(text)

	return lower:find("dark garou") ~= nil
		or lower == "garou"
		or lower:find("hero hunter") ~= nil
end

local function styleTopbar()
	local gui = getPlayerGui()

	if not gui then
		return
	end

	for _, object in ipairs(
		gui:GetDescendants()
	) do
		if object:IsA("TextLabel") then
			if isOldName(object.Text) then
				object.Text = "THE CREATOR"
			end

			local lower = string.lower(object.Text)

			if lower:find("creator") then
				object.TextColor3 =
					CREATOR_GREEN

				object.TextStrokeColor3 =
					BLACK

				object.TextStrokeTransparency =
					0
			end
		end
	end
end

-- ================================================================
-- UI LOOP
-- ================================================================

local function styleAllUI()
	pcall(function()
		styleTopbar()
		styleUltimateBar()

		for i = 1, 4 do
			styleMoveSlot(i)
		end
	end)
end

