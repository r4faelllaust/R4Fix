local GLITCH_CHARS = {
	"█",
	"▓",
	"▒",
	"░",
	"╳",
	"X",
	"0",
	"1",
	"/",
	"\\",
	"!",
	"?",
	"#",
	"%",
}

local function randomGlitchString(
	text: string
): string
	local chars =
		string.split(
			text,
			""
		)

	for i = 1, #chars do
		if math.random() < 0.22 then
			chars[i] =
				GLITCH_CHARS[
					math.random(
						1,
						#GLITCH_CHARS
					)
				]
		end
	end

	return table.concat(chars)
end

