-- ================================================================
-- CAMERA SHAKE
-- ================================================================

local function cameraShake(
	strength: number,
	duration: number
)
	if not CFG.CameraShake then
		return
	end

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	local original =
		camera.CFrame

	local start =
		os.clock()

	while camera
		and camera.Parent
		and os.clock()
			- start
			< duration
	do
		local alpha =
			(
				os.clock()
				- start
			)
			/ duration

		local fade =
			1 - alpha

		local offset =
			Vector3.new(
				(
					math.random()
					* 2
					- 1
				)
				* strength
				* fade,

				(
					math.random()
					* 2
					- 1
				)
				* strength
				* fade,

				0
			)

		camera.CFrame =
			original
			* CFrame.new(
				offset
			)

		RunService.RenderStepped:Wait()
	end

	if camera then
		camera.CFrame =
			original
	end
end

-- ================================================================
-- TARGET VALIDATION
-- ================================================================

local function isValidTarget(
	model: Model,
	origin: Vector3
): boolean
	if model == LocalPlayer.Character then
		return false
	end

	local humanoid =
		model:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		model:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid
		or humanoid.Health <= 0
		or not root
		or not root:IsA("BasePart")
	then
		return false
	end

	local distance =
		(
			root.Position
			- origin
		).Magnitude

	if distance
		> CFG.TargetMaxDistance
	then
		return false
	end

	return true
end

-- ================================================================
-- NEAREST ENEMY
-- ================================================================

local function getNearestEnemy(
	origin: Vector3
): Model?
	local nearest: Model? =
		nil

	local nearestDistance =
		CFG.TargetMaxDistance

	for _, player in ipairs(
		Players:GetPlayers()
	) do
		if player ~= LocalPlayer then
			local character =
				player.Character

			if character
				and isValidTarget(
					character,
					origin
				)
			then
				local root =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if root
					and root:IsA(
						"BasePart"
					)
				then
					local distance =
						(
							root.Position
							- origin
						).Magnitude

					if distance
						< nearestDistance
					then
						nearestDistance =
							distance

						nearest =
							character
					end
				end
			end
		end
	end

	return nearest
end

-- ================================================================
-- BEST M1 TARGET
-- ================================================================

local function getM1Target(
	root: BasePart
): Model?
	local nearest =
		getNearestEnemy(
			root.Position
		)

	if nearest then
		return nearest
	end

	return nil
end

-- ================================================================
-- M1 POSITION
-- ================================================================

local function moveBehindTarget(
	root: BasePart,
	target: Model
): boolean
	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot
		or not targetRoot:IsA(
			"BasePart"
		)
	then
		return false
	end

	local targetCFrame =
		targetRoot.CFrame

	local behind =
		targetCFrame.Position
		- targetCFrame.LookVector
			* CFG.M1BehindDistance

	local destination =
		Vector3.new(
			behind.X,
			targetRoot.Position.Y,
			behind.Z
		)

	root.CFrame =
		CFrame.lookAt(
			destination,
			targetRoot.Position
		)

	root.AssemblyLinearVelocity =
		Vector3.zero

	return true
end

-- ================================================================
-- M1
-- ================================================================

local function creatorM1()
	local now =
		os.clock()

	if now - S.LastM1
		< CFG.M1Cooldown
	then
		return
	end

	S.LastM1 =
		now

	local character,
		humanoid,
		root =
		getCharacter()

	if not character
		or not humanoid
		or not root
	then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	local target =
		getM1Target(
			root
		)

	S.CurrentTarget =
		target

	if target then
		moveBehindTarget(
			root,
			target
		)
	end

	creatorBurst(
		root,
		4.5,
		0.1
	)

	playAnimation(
		humanoid,
		ANIM.M1,
		Enum.AnimationPriority.Action4,
		1.35,
		false,
		0.025
	)

	cameraShake(
		0.14,
		0.075
	)

	glitchBurst(
		5
	)

	task.delay(
		0.04,
		function()
			local currentCharacter,
				currentHumanoid,
				currentRoot =
				getCharacter()

			if not currentCharacter
				or not currentHumanoid
				or not currentRoot
			then
				return
			end

			if target
				and target.Parent
			then
				local targetRoot =
					target:FindFirstChild(
						"HumanoidRootPart"
					)

				if targetRoot
					and targetRoot:IsA(
						"BasePart"
					)
				then
					local distance =
						(
							targetRoot.Position
							- currentRoot.Position
						).Magnitude

					if distance
						<= CFG.M1Range
					then
						moveBehindTarget(
							currentRoot,
							target
						)
					end
				end
			end
		end
	)
end

