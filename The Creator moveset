local function creatorHeadText(message: string)
	local character, _, root = getCharacter()

	if not character or not root then
		return
	end

	local old = character:FindFirstChild("CreatorHeadMessage")

	if old then
		old:Destroy()
	end

	local billboard = Instance.new("BillboardGui")

	billboard.Name = "CreatorHeadMessage"
	billboard.Adornee = root
	billboard.Size = UDim2.fromOffset(420, 90)
	billboard.StudsOffset = Vector3.new(0, 4.2, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 150
	billboard.Parent = character

	local label = Instance.new("TextLabel")

	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)

	label.Font = Enum.Font.Code
	label.TextColor3 = CREATOR_GREEN
	label.TextStrokeColor3 = BLACK
	label.TextStrokeTransparency = 0

	label.TextScaled = true
	label.TextTransparency = 1
	label.Text = ""

	label.Parent = billboard

	TweenService:Create(
		label,
		TweenInfo.new(0.1),
		{
			TextTransparency = 0,
		}
	):Play()

	task.spawn(function()
		for i = 1, #message do
			if not label.Parent then
				return
			end

			local realText = message:sub(1, i)

			label.Text = realText

			if math.random() < 0.35 then
				label.Text = randomGlitchString(realText)
			end

			label.Rotation = math.random(-2, 2)

			task.wait(
				math.random(2, 5) / 100
			)

			if label.Parent then
				label.Text = realText
				label.Rotation = 0
			end
		end

		for _ = 1, 3 do
			if not label.Parent then
				return
			end

			label.Text = randomGlitchString(message)
			task.wait(0.04)

			label.Text = message
			task.wait(0.04)
		end

		task.wait(0.3)

		if label.Parent then
			TweenService:Create(
				label,
				TweenInfo.new(0.14),
				{
					TextTransparency = 1,
				}
			):Play()
		end

		task.wait(0.18)

		if billboard.Parent then
			billboard:Destroy()
		end
	end)
