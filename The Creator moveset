-- M1
-- ================================================================

local lastM1 = 0
local m1Index = 0

local function creatorM1()
	local now =
		os.clock()

	if now - lastM1
		< CFG.M1Cooldown
	then
		return
	end

	lastM1 = now

	local character, humanoid, root =
		getCharacter()

	if not character
		or not humanoid
		or not root
	then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	-- FIND TARGET BEFORE ANIMATION.
	local target =
		findClosestTarget(
			root.Position
		)

	m1Index += 1

	if m1Index > 4 then
		m1Index = 1
	end

	local animations = {
		ANIM.M1_1,
		ANIM.M1_2,
		ANIM.M1_3,
		ANIM.M1_4,
	}

	-- ============================================================
	-- FIX:
	-- TP FIRST, THEN START THE ATTACK.
	--
	-- The old version started the animation and then teleported.
	-- Depending on the TSB animation timing, that could make the
	-- M1 appear to miss or teleport after the hit window.
	-- ============================================================

	if target then
		local success =
			teleportBehindTarget(
				target
			)

		if success then
			creatorBurst(
				root,
				3.8,
				0.1
			)

			task.wait()

			playAnimation(
				humanoid,
				animations[m1Index],
				Enum.AnimationPriority.Action4,
				1.08,
				false,
				0.42
			)

			directionalSlash(
				root
			)

			local targetRoot =
				target:FindFirstChild(
					"HumanoidRootPart"
				)

			if targetRoot then
				local targetAttachment =
					targetRoot:FindFirstChild(
						"CreatorHitFX"
					)

				if not targetAttachment then
					targetAttachment =
						Instance.new(
							"Attachment"
						)

					targetAttachment.Name =
						"CreatorHitFX"

					targetAttachment.Parent =
						targetRoot
				end

				cloneResourceByName(
					"Shock",
					targetAttachment,
					6,
					0.28
				)

				playImpactSound(
					targetRoot,
					0.8,
					0.92
						+ math.random()
							* 0.12
				)
			end

			return
		end
	end

	-- No target, normal M1.
	playAnimation(
		humanoid,
		animations[m1Index],
		Enum.AnimationPriority.Action4,
		1.08,
		false,
		0.42
	)

	directionalSlash(
		root
	)
end

