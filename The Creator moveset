-- ================================================================

local function creatorRing(
	position: Vector3,
	radius: number,
	segments: number,
	lifetime: number
)
	local folder =
		Instance.new("Folder")

	folder.Name =
		"CreatorRing"

	folder.Parent =
		workspace

	for i = 1, segments do
		local angle =
			(i / segments)
			* math.pi
			* 2

		local part =
			Instance.new("Part")

		part.Name =
			"CreatorRingSegment"

		part.Anchored =
			true

		part.CanCollide =
			false

		part.CanQuery =
			false

		part.CanTouch =
			false

		part.Material =
			Enum.Material.Neon

		part.Color =
			CREATOR_GREEN

		part.Size =
			Vector3.new(
				0.16,
				0.16,
				0.7
			)

		part.CFrame =
			CFrame.new(
				position
				+ Vector3.new(
					math.cos(angle)
						* radius,
					0.12,
					math.sin(angle)
						* radius
				)
			)
			* CFrame.Angles(
				0,
				-angle,
				0
			)

		part.Transparency =
			0.15

		part.Parent =
			folder
	end

	task.spawn(function()
		local start =
			os.clock()

		while folder.Parent
			and os.clock()
				- start
				< lifetime
		do
			local alpha =
				(
					os.clock()
					- start
				)
				/ lifetime

			for _, object in ipairs(
				folder:GetChildren()
			) do
				if object:IsA(
					"BasePart"
				) then
					object.Transparency =
						0.15
						+ alpha
						* 0.85
				end
			end

			task.wait()
		end

		if folder.Parent then
			folder:Destroy()
		end
	end)
end

