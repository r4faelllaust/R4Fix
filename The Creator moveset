-- M1 INPUT
-- ================================================================

local m1Connection:
	RBXScriptConnection? =
	nil

local function setupM1()
	if m1Connection then
		pcall(function()
			m1Connection:Disconnect()
		end)
	end

	m1Connection =
		UserInputService.InputBegan:Connect(
			function(
				input,
				processed
			)
				if processed then
					return
				end

				if input.UserInputType
					== Enum.UserInputType.MouseButton1
				then
					creatorM1()

				elseif input.UserInputType
					== Enum.UserInputType.Touch
				then
					creatorM1()
				end
			end
		)

	table.insert(
		S.Connections,
		m1Connection
	)
end

