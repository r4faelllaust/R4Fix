-- ================================================================
-- PHANTOM ENGINE
-- ================================================================

local function phantomEngine(
	duration: number,
	speed: number,
	token: number
)
	local character, humanoid, root =
		getCharacter()

	if not character
		or not humanoid
		or not root
	then
		return false
	end

	if token ~= S.Token
		or humanoid.Health <= 0
	then
		return false
	end

	local attachment =
		Instance.new("Attachment")

	attachment.Name =
		"CreatorPhantomVelocity"

	attachment.Parent =
		root

	local velocity =
		Instance.new("LinearVelocity")

	velocity.Name =
		"CreatorPhantomEngine"

	velocity.Attachment0 =
		attachment

	velocity.MaxForce =
		math.huge

	velocity.RelativeTo =
		Enum.ActuatorRelativeTo.World

	velocity.VectorVelocity =
		root.CFrame.LookVector
		* speed

	velocity.Parent =
		root

	local a0 =
		Instance.new("Attachment")

	local a1 =
		Instance.new("Attachment")

	a0.Position =
		Vector3.new(-1.1, 0, 0)

	a1.Position =
		Vector3.new(1.1, 0, 0)

	a0.Parent =
		root

	a1.Parent =
		root

	local trail =
		Instance.new("Trail")

	trail.Name =
		"CreatorPhantomTrail"

	trail.Attachment0 =
		a0

	trail.Attachment1 =
		a1

	trail.Lifetime =
		0.12

	trail.MinLength =
		0.1

	trail.LightEmission =
		1

	trail.Color =
		ColorSequence.new(
			CREATOR_GREEN,
			CREATOR_LIME
		)

	trail.Transparency =
		NumberSequence.new(
			0.05,
			1
		)

	trail.Parent =
		root

	creatorBurst(
		root,
		4.5,
		0.12
	)

	local started =
		os.clock()

	while os.clock() - started
		< duration
	do
		if token ~= S.Token then
			break
		end

		if humanoid.Health <= 0
			or not root.Parent
		then
			break
		end

		local direction =
			root.CFrame.LookVector

		velocity.VectorVelocity =
			Vector3.new(
				direction.X * speed,
				0,
				direction.Z * speed
			)

		RunService.Heartbeat:Wait()
	end

	pcall(function()
		velocity:Destroy()
	end)

	pcall(function()
		attachment:Destroy()
	end)

	pcall(function()
		a0:Destroy()
	end)

	pcall(function()
		a1:Destroy()
	end)

	pcall(function()
		trail:Destroy()
	end)

	if root.Parent then
		creatorBurst(
			root,
			5.5,
			0.14
		)
	end

	return true
end

-- ================================================================
-- VOID SEQUENCE
-- ================================================================

local function voidSequence(
	target: Model,
	token: number
)
	local character, humanoid, root =
		getCharacter()

	if not character
		or not humanoid
		or not root
	then
		return
	end

	local targetRoot =
		target:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot then
		return
	end

	local original =
		root.CFrame

	-- Fixed target TP.
	if not teleportBehindTarget(
		target
	) then
		return
	end

	creatorBurst(
		root,
		7,
		0.13
	)

	creatorRing(
		root,
		2,
		12,
		0.2
	)

	cloneResourceByName(
		"TP",
		root,
		6,
		0.3
	)

	cloneResourceByName(
		"LastSlashFx",
		root,
		6,
		0.28
	)

	playImpactSound(
		root,
		1.2,
		0.78
	)

	local phasePosition =
		targetRoot.Position
		- targetRoot.CFrame.LookVector
			* 2.4

	root.CFrame =
		CFrame.lookAt(
			phasePosition,
			targetRoot.Position
		)

	creatorBurst(
		root,
		5.5,
		0.1
	)

	directionalSlash(
		root
	)

	task.wait(0.08)

	if token ~= S.Token then
		return
	end

	if not targetRoot.Parent
		or humanoid.Health <= 0
	then
		return
	end

	local forward =
		targetRoot.CFrame.LookVector

	local destination =
		targetRoot.Position
		+ forward
			* CFG.VoidDistance

	destination = Vector3.new(
		destination.X,
		targetRoot.Position.Y,
		destination.Z
	)

	root.CFrame =
		CFrame.lookAt(
			destination,
