					"void tp"
				) ~= nil

			if isCreatorTool then
				toolName.TextColor3 =
					CREATOR_GREEN

				toolName.TextStrokeColor3 =
					BLACK

				toolName.TextStrokeTransparency =
					0

				if math.random() < 0.45 then
					toolName.Text =
						randomGlitchString(
							toolName.Text
						)
				end

				glitchSlot(
					tonumber(
						slot.Name
					) or 1
				)
			end
		end
	end

	-- Fallback scan for tool names anywhere in the hotbar.
	for _, name in ipairs(names) do
		for _, object in ipairs(
			hotbar:GetDescendants()
		) do
			if object:IsA(
				"TextLabel"
			)
				and object.Text
					== name
			then

				object.TextColor3 =
					CREATOR_GREEN

				object.TextStrokeColor3 =
					BLACK

				object.TextStrokeTransparency =
					0
			end
		end
	end
end

