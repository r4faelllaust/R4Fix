local CREATOR_DISPLAY_TEXTS = {
	"ＴＨＥ ＣＲＥＡＴＯＲ",
	"THE CREATOR",
	"THE CREATOR",
	"T H E  C R E A T O R",
}

local function getGlitchedCreatorName()
	local base =
		CREATOR_DISPLAY_TEXTS[
			math.random(
				1,
				#CREATOR_DISPLAY_TEXTS
			)
		]

	local roll =
		math.random()

	if roll < 0.2 then
		return "T̷H̷E̷ ̷C̷R̷E̷A̷T̷O̷R̷"
	end

	if roll < 0.4 then
		return "T̸H̸E̸ ̸C̸R̸E̸A̸T̸O̸R̸"
	end

	if roll < 0.6 then
		return randomGlitchString(
			"THE CREATOR"
		)
	end

	return base
end

local function isCreatorName(
	text: string
): boolean
	local lower =
		string.lower(
			text
		)

	return lower == "dark garou"
		or lower == "garou"
		or lower == "hero hunter"
		or lower == "the creator"
		or lower:find(
			"dark garou"
		) ~= nil
end

local function applyTopbarToContainer(
	container: Instance
)
	for _, descendant in ipairs(
		container:GetDescendants()
	) do
		if descendant.Name
			~= "IconButton"
		then
			continue
		end

		local label =
			descendant:FindFirstChild(
				"IconLabel"
			)

		local image =
			descendant:FindFirstChild(
				"IconImage"
			)

		if label
			and label:IsA(
				"TextLabel"
			)
		then
			if isCreatorName(
				label.Text
			)
			then
				label.Text =
					getGlitchedCreatorName()

				label.TextColor3 =
					CREATOR_GREEN

				label.TextStrokeColor3 =
					BLACK

				label.TextStrokeTransparency =
					0

				if image
					and (
						image:IsA(
							"ImageLabel"
						)
						or image:IsA(
							"ImageButton"
						)
					)
					and DECAL_ID
						~= "rbxassetid://0"
				then
					image.Image =
						DECAL_ID

					image.ImageColor3 =
						WHITE
				end

				if descendant:IsA(
					"GuiObject"
				)
				then
					descendant.Visible =
						true
				end
			end
		end
	end
end

