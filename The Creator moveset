local function destroyTool(name: string)
	local backpack = LocalPlayer:FindFirstChildOfClass(
		"Backpack"
	)

	if backpack then
		for _, object in ipairs(
			backpack:GetChildren()
		) do
			if object:IsA("Tool")
				and object.Name == name
			then
				object:Destroy()
			end
		end
	end

	local character = LocalPlayer.Character

	if character then
		for _, object in ipairs(
			character:GetChildren()
		) do
			if object:IsA("Tool")
				and object.Name == name
			then
				object:Destroy()
			end
		end
	end
end

local function createVoidTool()
	local name = "Creator Void TP"

	destroyTool(name)

	local backpack = LocalPlayer:WaitForChild(
		"Backpack"
	)

	local tool = Instance.new("Tool")

	tool.Name = name
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "THE CREATOR // VOID TP"

	tool.Activated:Connect(function()
		task.spawn(creatorVoidTP)
	end)

	tool.Parent = backpack
end

local function createRunTool()
	local name = "Creator Run"

	destroyTool(name)

	local backpack = LocalPlayer:WaitForChild(
		"Backpack"
	)

	local tool = Instance.new("Tool")

	tool.Name = name
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "THE CREATOR // RUN"

	tool.Equipped:Connect(function()
		startCreatorRun()
	end)

	tool.Unequipped:Connect(function()
		stopCreatorRun()
	end)

	tool.AncestryChanged:Connect(function(_, parent)
		if not parent then
			stopCreatorRun()
		end
	end)

	tool.Parent = backpack
end

local function setupTools()
	task.spawn(function()
		pcall(createVoidTool)
	end)

	task.spawn(function()
		pcall(createRunTool)
	end)
end

