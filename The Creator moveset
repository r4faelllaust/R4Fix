local function getCharacter()
	local character =
		LocalPlayer.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid
		or not root
		or not root:IsA("BasePart")
	then
		return nil, nil, nil
	end

	return character, humanoid, root
end

