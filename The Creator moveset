local function startGlitchLoop()
	task.spawn(function()
		while LocalPlayer.Parent do
			pcall(function()
				fixCreatorSelection()
				styleUltimateBar()

				for i = 1, 4 do
					styleMoveSlot(i)
				end

				if math.random() < 0.38 then
					glitchHotbar()
				end

				if math.random() < 0.42 then
					glitchToolHotbar()
				end

				if math.random() < 0.2 then
					glitchBurst()
				end
			end)

			task.wait(
				math.random(
					10,
					22
				) / 100
			)
		end
	end)
end

