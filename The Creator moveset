local function findVFXTemplate(
	name: string
): Instance?
	local found: Instance? = nil

	pcall(function()
		found =
			ReplicatedStorage:FindFirstChild(
				name,
				true
			)
	end)

	return found
end

local function recolorObject(
	object: Instance
)
	pcall(function()
		for _, descendant in ipairs(
			object:GetDescendants()
		) do

			if descendant:IsA(
				"ParticleEmitter"
			) then

				descendant.Color =
					ColorSequence.new({
						ColorSequenceKeypoint.new(
							0,
							CREATOR_LIME
						),

						ColorSequenceKeypoint.new(
							0.45,
							CREATOR_GREEN
						),

						ColorSequenceKeypoint.new(
							1,
							CREATOR_GREEN_DARK
						),
					})

				descendant.LightEmission =
					math.max(
						descendant.LightEmission,
						0.35
					)

			elseif descendant:IsA(
				"Beam"
			) then

				descendant.Color =
					ColorSequence.new(
						CREATOR_GREEN,
						CREATOR_LIME
					)

			elseif descendant:IsA(
				"Trail"
			) then

				descendant.Color =
					ColorSequence.new(
						CREATOR_GREEN,
						CREATOR_LIME
					)

			elseif descendant:IsA(
				"PointLight"
			)
				or descendant:IsA(
					"SpotLight"
				)
				or descendant:IsA(
					"SurfaceLight"
				)
			then

				descendant.Color =
					CREATOR_GREEN
			end
		end
	end)
end

local function cloneResourceByName(
	name: string,
	parent: Instance,
	amount: number?,
	lifetime: number?
)
	if not parent then
		return nil
	end

	local template =
		findVFXTemplate(name)

	if not template then
		return nil
	end

	local clone: Instance? = nil

	pcall(function()
		clone = template:Clone()
	end)

	if not clone then
		return nil
	end

	recolorObject(clone)

	clone.Parent = parent

	for _, child in ipairs(
		clone:GetDescendants()
	) do
		if child:IsA(
			"ParticleEmitter"
		) then

			pcall(function()
				child.Enabled = false
				child:Emit(
					amount or 8
				)
			end)
		end
	end

	Debris:AddItem(
		clone,
		math.min(
			lifetime or 0.35,
			CFG.MaxVFXLifetime
		)
	)

	return clone
end

