-- ================================================================
-- MOVE 2
-- VOID SHADOW PROTOCOL
-- ================================================================

local function VoidProtocol()

	local Character,Humanoid,Root =
		GetCharacter()

	if not Root then
		return
	end


	local Target =
		ClosestTarget()


	ShadowBurst(
		Root.CFrame,
		25
	)


	if Target then

		local EnemyRoot =
			Target:FindFirstChild(
				"HumanoidRootPart"
			)

		if EnemyRoot then

			Root.CFrame =
				CFrame.lookAt(
					EnemyRoot.Position
					-
					EnemyRoot.CFrame.LookVector*6,

					EnemyRoot.Position
				)

		end

	end


	ShadowRing(
		Root.CFrame,
		25
	)


	PlayAnimation(
		Humanoid,
		MOVES.Void,
		1.6
	)


	for i=1,20 do

		task.delay(
			i*.04,
			function()

				if Root.Parent then

					ShadowPart(
						Root.CFrame,
						Vector3.new(
							1,
							math.random(2,8),
							1
						),
						.25
					)

				end

			end
		)

	end

end



