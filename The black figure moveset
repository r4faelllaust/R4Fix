-- CHARACTER SETUP
-- ================================================================

local function SetupCharacter(char)

	SESSION.Token += 1

	Cleanup()

	SESSION.Character =
		char


	local root =
		char:WaitForChild(
			"HumanoidRootPart"
		)


	-- Aura highlight

	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"BLACK_FIGURE_AURA"

	highlight.FillColor =
		SHADOW_BLACK

	highlight.OutlineColor =
		WHITE_GLOW

	highlight.FillTransparency =
		0.85

	highlight.OutlineTransparency =
		0.15

	highlight.Parent =
		char


	Track(highlight)


	ShadowParticles(
		root,
		25
	)


	PhantomBurst()

end



