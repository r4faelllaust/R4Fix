	ring.Size =
		Vector3.new(
			0.15,
			size,
			size
		)

	ring.Transparency =
		0.25


	ring.CFrame =
		cframe *
		CFrame.Angles(
			0,
			0,
			math.rad(90)
		)

	ring.Parent =
		GetFolder()

	Track(ring)


	TweenService:Create(
		ring,
		TweenInfo.new(
			0.45,
			Enum.EasingStyle.Exponential
		),
		{
			Size =
				Vector3.new(
					0.15,
					size*3,
					size*3
				),

			Transparency = 1
		}

	):Play()


	Debris:AddItem(
		ring,
		0.5
	)

end



-- ================================================================
-- SHADOW PARTICLES
-- ================================================================

local function ShadowParticles(
	part,
	amount
)

	local attachment =
		Instance.new("Attachment")

	attachment.Name =
		"ShadowAttachment"

	attachment.Parent =
		part


	local emitter =
		Instance.new("ParticleEmitter")


	emitter.Texture =
		"rbxasset://textures/particles/smoke_main.dds"


	emitter.Color =
		ColorSequence.new(
			{
				ColorSequenceKeypoint.new(
					0,
					SHADOW_GREY
				),

				ColorSequenceKeypoint.new(
					1,
					SHADOW_BLACK
				)
			}
		)


	emitter.Rate =
		0


	emitter.Lifetime =
		NumberRange.new(
			0.5,
			1
		)


	emitter.Speed =
		NumberRange.new(
			2,
			8
		)


	emitter.SpreadAngle =
		Vector2.new(
			360,
			360
		)


	emitter.Parent =
		attachment


	emitter:Emit(
		amount
	)


	Debris:AddItem(
		attachment,
		1.5
	)

end



