-- ================================================================

local function DarkenEffect(Object)

	pcall(function()

		if Object:IsA(
			"ParticleEmitter"
		)
		then

			Object.Color =
				ColorSequence.new(
					DARK_GREY
				)


			Object.LightEmission =
				0.2


		elseif Object:IsA(
			"Trail"
		)
		then

			Object.Color =
				ColorSequence.new(
					SHADOW
				)


		elseif Object:IsA(
			"Beam"
		)
		then

			Object.Color =
				ColorSequence.new(
					DARK_GREY
				)

		end


	end)

end



