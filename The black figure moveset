			if Object:IsA(
				"TextLabel"
			)
			or Object:IsA(
				"TextButton"
			)
			then


				local Name =
					string.lower(
						Object.Name
					)


				if string.find(
					Name,
					"ult"
				)
				or string.find(
					Name,
					"awak"
				)
				then

					Object.TextColor3 =
