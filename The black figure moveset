-- ================================================================
-- ANIMATION LISTENER
-- ================================================================

local function SetupMoves(Character)

	local Humanoid =
		Character:WaitForChild(
			"Humanoid"
		)


	Humanoid.AnimationPlayed:Connect(
		function(Track)

			local Animation =
				Track.Animation

			if not Animation then
				return
			end


			local ID =
				Animation.AnimationId


			for _,M1 in ipairs(
				M1_ANIMS
			) do

				if ID == M1 then

					Track:Stop()

					PlayAnimation(
						Humanoid,
						M1_ANIMS[
							math.random(
								1,
								#M1_ANIMS
							)
						],
						1.5
					)

					ShadowBurst(
						Character.HumanoidRootPart.CFrame,
						8
					)

				end

			end

		end
	)

end


