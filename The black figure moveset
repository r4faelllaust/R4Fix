local SHADOW_BLACK = Color3.fromRGB(5,5,8)
local SHADOW_GREY = Color3.fromRGB(45,45,55)
local DARK_GREY = Color3.fromRGB(15,15,20)
local WHITE_GLOW = Color3.fromRGB(220,220,230)

-- ================================================================
-- SESSION
-- ================================================================

getgenv().R4FIX_BLACK_FIGURE =
getgenv().R4FIX_BLACK_FIGURE or {

	Objects = {},
	Connections = {},
	Character = nil,
	Token = 0,

}

local SESSION = getgenv().R4FIX_BLACK_FIGURE


-- ================================================================
-- CLEANUP
-- ================================================================

local function Cleanup()

	for _,obj in ipairs(SESSION.Objects) do
		pcall(function()
			obj:Destroy()
		end)
	end

	table.clear(SESSION.Objects)

end


local function Track(obj)

	table.insert(
		SESSION.Objects,
		obj
	)

	return obj

end


-- ================================================================
-- CHARACTER
-- ================================================================

local function GetCharacter()

	local char = Player.Character

	if not char then
		return
	end

	local hum =
		char:FindFirstChildOfClass("Humanoid")

	local root =
		char:FindFirstChild("HumanoidRootPart")

	if not hum or not root then
		return
	end

	return char,hum,root

end


-- ================================================================
-- VFX FOLDER
-- ================================================================

local function GetFolder()

	local folder =
		workspace:FindFirstChild(
			"R4FIX_BLACK_FIGURE_VFX"
		)

	if not folder then

		folder =
			Instance.new("Folder")

		folder.Name =
			"R4FIX_BLACK_FIGURE_VFX"

		folder.Parent =
			workspace

	end

	return folder

end


-- ================================================================
-- SHADOW FLASH
-- ================================================================

local function ShadowFlash(
	cframe,
	size
)

	local part =
		Instance.new("Part")

	part.Name =
		"ShadowFlash"

	part.Anchored =
		true

	part.CanCollide =
		false

	part.CanTouch =
		false

	part.Material =
		Enum.Material.Neon

	part.Color =
		WHITE_GLOW

	part.Shape =
		Enum.PartType.Ball

	part.Size =
		Vector3.new(
			size,
			size,
			size
		)

	part.Transparency =
		0.15

	part.CFrame =
		cframe

	part.Parent =
		GetFolder()

	Track(part)


	TweenService:Create(
		part,
		TweenInfo.new(
			0.25,
			Enum.EasingStyle.Quint
		),
		{
			Size =
				Vector3.new(
					size*4,
					size*4,
					size*4
				),

			Transparency = 1
		}

	):Play()


	Debris:AddItem(
		part,
		0.3
	)

end



-- ================================================================
-- VOID RING
-- ================================================================

local function VoidRing(
	cframe,
	size
)

	local ring =
		Instance.new("Part")

	ring.Name =
		"VOID_RING"

	ring.Anchored =
		true

	ring.CanCollide =
		false

	ring.Material =
