-- ================================================================
-- PLAY ANIMATION
-- ================================================================

local function PlayAnim(
	id,
	speed
)

	if id ==
		"rbxassetid://0" then
		return
	end


	local char,hum =
		GetChar()


	if not hum then
		return
	end


	local animator =
		hum:FindFirstChildOfClass(
			"Animator"
		)


	if not animator then

		animator =
			Instance.new(
				"Animator"
			)

		animator.Parent =
			hum

	end



	local animation =
		Instance.new(
			"Animation"
		)


	animation.AnimationId =
		id


	local track

	pcall(function()

		track =
			animator:LoadAnimation(
				animation
			)

	end)


	animation:Destroy()


	if track then

		track.Priority =
			Enum.AnimationPriority.Action4

		track:Play(
			0.05,
			1,
			speed or 1
		)

	end

end



-- ================================================================
-- COOLDOWNS
-- ================================================================

local function CanUse(
	name,
	time
)

	if DATA.Cooldowns[name] then
		return false
	end


	DATA.Cooldowns[name] =
		true


	task.delay(
		time,
		function()

			DATA.Cooldowns[name] =
				nil

		end
	)


	return true

end



