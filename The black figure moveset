-- ================================================================
-- CLEANUP
-- ================================================================

local function Destroy(obj)
	if obj then
		pcall(function()
			obj:Destroy()
		end)
	end
end


local function Cleanup()

	for _,v in ipairs(SESSION.Objects) do
		Destroy(v)
	end

	table.clear(SESSION.Objects)

end


-- ================================================================
-- CHARACTER
-- ================================================================

local function GetCharacter()

	local Character = Player.Character

	if not Character then
		return nil
	end

	local Humanoid =
		Character:FindFirstChildOfClass("Humanoid")

	local Root =
		Character:FindFirstChild("HumanoidRootPart")

	if not Humanoid or not Root then
		return nil
	end

	return Character,Humanoid,Root

end


-- ================================================================
-- VFX FOLDER
-- ================================================================

local function GetFolder()

	local Folder =
		workspace:FindFirstChild(
			"R4FIX_BLACK_FIGURE_VFX"
		)

	if not Folder then

		Folder =
			Instance.new("Folder")

		Folder.Name =
			"R4FIX_BLACK_FIGURE_VFX"

		Folder.Parent =
			workspace

	end

	return Folder

end


-- ================================================================
-- SHADOW BLOCK
-- ================================================================

local function ShadowPart(
	CFrame,
	Size,
	Time
)

	local Part =
		Instance.new("Part")

	Part.Name =
		"BLACK_SHADOW_GLITCH"

	Part.Anchored =
		true

	Part.CanCollide =
		false

	Part.CanTouch =
		false

	Part.CanQuery =
		false

	Part.CastShadow =
		false

	Part.Material =
		Enum.Material.Neon

	Part.Color =
		SHADOW

	Part.Transparency =
		0.15

	Part.Size =
		Size

	Part.CFrame =
		CFrame

	Part.Parent =
		GetFolder()


	table.insert(
		SESSION.Objects,
		Part
	)


	TweenService:Create(
		Part,
		TweenInfo.new(
			Time,
			Enum.EasingStyle.Quint
		),
		{

			Size = Size * 2,
			Transparency = 1

		}

	):Play()


	Debris:AddItem(
		Part,
		Time + .1
	)

end



-- ================================================================
-- SHADOW BURST
-- ================================================================

local function ShadowBurst(
	CFrame,
	Power
)

	for i = 1,Power do

		local Offset =
			Vector3.new(
				math.random(-20,20)/10,
				math.random(-15,15)/10,
				math.random(-20,20)/10
			)


		ShadowPart(
			CFrame * CFrame.new(Offset),
			Vector3.new(
				0.3,
				math.random(2,8),
				0.3
			),
			0.25
		)

	end

end


-- ================================================================
-- SHADOW RING
-- ================================================================

local function ShadowRing(
	CFrame,
	Size
)

	local Ring =
		Instance.new("Part")

	Ring.Name =
		"VOID_SHADOW_RING"

	Ring.Anchored =
		true

	Ring.CanCollide =
		false

	Ring.CanTouch =
		false

	Ring.CanQuery =
		false

	Ring.Shape =
		Enum.PartType.Cylinder

	Ring.Material =
		Enum.Material.Neon

	Ring.Color =
		DARK_GREY

	Ring.Transparency =
		0.25

	Ring.Size =
		Vector3.new(
			0.1,
			Size,
			Size
		)

	Ring.CFrame =
		CFrame *
		CFrame.Angles(
			0,
			0,
			math.rad(90)
		)

	Ring.Parent =
		GetFolder()


	table.insert(
		SESSION.Objects,
		Ring
	)


	TweenService:Create(
		Ring,
		TweenInfo.new(
			0.4,
			Enum.EasingStyle.Quint
		),
		{

			Size =
				Vector3.new(
					0.1,
					Size*2,
					Size*2
				),

			Transparency = 1

		}

	):Play()


	Debris:AddItem(
		Ring,
		0.5
	)

end


