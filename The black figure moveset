local function ReplaceAnimation(
	oldTrack
)

	local id =
		oldTrack.Animation.AnimationId


	local new =
		AnimationReplacements[id]


	if new then


		oldTrack:Stop()


		local humanoid =
			GetHumanoid()


		if humanoid then

			local anim =
				Instance.new(
					"Animation"
				)

			anim.AnimationId =
				new


			local track =
				humanoid.Animator:LoadAnimation(
					anim
				)


			track.Priority =
				Enum.AnimationPriority.Action


			track:Play()


		end
	end

end



