local function Track(connection)

	table.insert(
		SESSION.Connections,
		connection
	)

	return connection

end



local function ClearConnections()

	for _,connection in ipairs(
		SESSION.Connections
	) do

		pcall(function()
			connection:Disconnect()
		end)

	end


	table.clear(
		SESSION.Connections
	)

end



-- ================================================================
-- VFX FOLDER
-- ================================================================

local function GetVFXFolder()

	local folder =
		workspace:FindFirstChild(
			"BlackFigure_VFX"
		)


	if not folder then

		folder =
			Instance.new("Folder")

		folder.Name =
			"BlackFigure_VFX"

		folder.Parent =
			workspace

	end


	return folder

end



-- ================================================================
-- COOLDOWN
-- ================================================================

local function Allowed(name)

	local now =
		os.clock()


	local last =
		SESSION.LastVFX[name]
		or 0


	if now-last <
		CONFIG.VFXCooldown
	then

		return false

	end


	SESSION.LastVFX[name] =
		now


	return true

end



-- ================================================================
-- ANIMATION SYSTEM
-- ================================================================

local function GetAnimator(humanoid)

	local animator =
		humanoid:FindFirstChildOfClass(
			"Animator"
		)


	if not animator then

		animator =
			Instance.new("Animator")

		animator.Parent =
			humanoid

	end


	return animator

end



local function PlayAnimation(
	humanoid,
	id,
	priority
)

	if humanoid.Health <= 0 then
		return
	end


	local animation =
		Instance.new("Animation")


	animation.AnimationId =
		id


	local track


	pcall(function()

		track =
			GetAnimator(humanoid)
			:LoadAnimation(animation)

	end)


	animation:Destroy()


	if track then

		track.Priority =
			priority
			or Enum.AnimationPriority.Action


		track.Looped =
			false


		track:Play(
			0.05,
			1,
			1
		)

	end


	return track

end



-- ================================================================
-- SHADOW PARTICLES
-- ================================================================

local function ShadowParticles(parent, amount)

	if not parent then
		return
	end


	local attachment =
		Instance.new("Attachment")


	attachment.Name =
		"BlackFigureShadow"


	attachment.Parent =
		parent



	local emitter =
		Instance.new("ParticleEmitter")


	emitter.Texture =
		"rbxasset://textures/particles/smoke_main.dds"


	emitter.Color =
		ColorSequence.new({

			ColorSequenceKeypoint.new(
				0,
				VOID_BLACK
			),

			ColorSequenceKeypoint.new(
				0.5,
				SHADOW_GREY
			),

			ColorSequenceKeypoint.new(
				1,
				DARK_GREY
			)

		})


	emitter.LightEmission =
		0


	emitter.Rate =
		0


	emitter.Lifetime =
		NumberRange.new(
			0.6,
			1.2
		)


	emitter.Speed =
		NumberRange.new(
			2,
			6
		)


	emitter.SpreadAngle =
		Vector2.new(
			360,
			360
		)


	emitter.Size =
		NumberSequence.new({

			NumberSequenceKeypoint.new(
				0,
				0.5
			),

			NumberSequenceKeypoint.new(
				1,
				0
			)

		})


	emitter.Parent =
		attachment



	emitter:Emit(
		amount or 20
	)


	Debris:AddItem(
		attachment,
		2
	)

end



-- ================================================================
-- VOID FLASH
-- ================================================================

local function VoidFlash(
	cframe,
	size
)

	if not Allowed("VoidFlash") then
		return
	end


	local part =
		Instance.new("Part")


	part.Anchored =
		true


	part.CanCollide =
		false


	part.Material =
		Enum.Material.Neon


	part.Shape =
		Enum.PartType.Ball


	part.Color =
		SHADOW_GREY


	part.Transparency =
		0.2


	part.Size =
		Vector3.new(
			1,
			1,
			1
		)


	part.CFrame =
		cframe


	part.Parent =
		GetVFXFolder()



	TweenService:Create(

		part,

		TweenInfo.new(
			0.4,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),

		{

			Size =
				Vector3.new(
					size,
					size,
					size
				),

			Transparency = 1

		}

	):Play()



	Debris:AddItem(
		part,
		0.5
	)

end



