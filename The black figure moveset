local function ChangeSlot(
	number,
	text
)

	local hotbar =
		PlayerGui:FindFirstChild(
			"Hotbar"
		)


	if not hotbar then
		return
	end


	local backpack =
		hotbar:FindFirstChild(
			"Backpack"
		)


	if not backpack then
		return
	end


	local frame =
		backpack:FindFirstChild(
			"Hotbar"
		)


	if not frame then
		return
	end


	local slot =
		frame:FindFirstChild(
			tostring(number)
		)


	if not slot then
		return
	end



	local base =
		slot:FindFirstChild(
			"Base"
		)
		or slot



	local label =
		base:FindFirstChild(
			"ToolName"
		)



	if label and label:IsA("TextLabel") then

		label.Text =
			text

	end

end



local function UpdateHotbar()

	for i,name in pairs(Moves) do

		ChangeSlot(
			i,
			name
		)

	end

end



