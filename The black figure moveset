-- ================================================================
-- TRACK OBJECTS
-- ================================================================

local function Track(obj)

	table.insert(
		DATA.Objects,
		obj
	)

	return obj

end



local function Cleanup()

	for _,obj in ipairs(DATA.Objects) do

		pcall(function()
			obj:Destroy()
		end)

	end

	table.clear(DATA.Objects)

end



