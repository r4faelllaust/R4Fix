-- ================================================================
-- SHADOW FLASH
-- ================================================================

function ShadowFlash(
	cframe,
	size
)

	local part =
		Instance.new("Part")


	part.Name =
		"BLACK_FLASH"


	part.Anchored =
		true


	part.CanCollide =
		false


	part.CanTouch =
		false


	part.CanQuery =
		false


	part.Shape =
		Enum.PartType.Ball


	part.Material =
		Enum.Material.Neon


	part.Color =
		WHITE


	part.Size =
		Vector3.new(
			size,
			size,
			size
		)


	part.Transparency =
		0.15


	part.CFrame =
		cframe


	part.Parent =
		GetVFXFolder()


	Track(part)


	TweenService:Create(
		part,
		TweenInfo.new(
			0.3,
			Enum.EasingStyle.Quint
		),
		{

			Size =
				Vector3.new(
					size*5,
					size*5,
					size*5
				),

			Transparency = 1

		}

	):Play()


	Debris:AddItem(
		part,
		0.35
	)

end



